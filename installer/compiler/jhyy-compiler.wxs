<?xml version="1.0" encoding="utf-8"?>
<!--
  compiler/jhyy-compiler.wxs : JHYY compiler MSI definition (v1.5.2)

  Sprint v1.5.2 — 装 jhyy.exe + qbe.exe 到 C:\Program Files\JHYY\bin\,
  写系统 PATH (HKLM, 要 admin), 检测 MSYS2 + gcc 没就 warn
  (不自动装, 自动装推到 v1.5.3 Burn bundle per `力度 1 检测+引导` 决策).

  Layout:
    C:\Program Files\JHYY\
    ├── bin\
    │   ├── jhyy.exe    (jhyy-side production binary, per v1.4.0 flip)
    │   └── qbe.exe     (vendored)
    └── common\
        └── license.rtf (双语)

  WiX 4 schema notes (跟 v3 不一样的地方):
    - <Package> 里直接 <Condition> 是 valid 但要在 <Package> 顶层, 顺序固定
    - <Component> 用 Bitness="always64" 代替 v3 的 Win64="yes"
    - <String> 必须用 Value 属性 (WIX0400)
    - <SetDirectory> 用 Condition attribute, 不能 inner text
    - <Property><RegistrySearch> 改用 <RegistrySearch> 直接 child of <Package>
    - <Directory> FileSource attribute 接受 !(bindpath.x) 形式

  Reference:
    - docs/plans/v1/v1.5.0任务清单 + 概要设计.md § Sprint v1.5.2
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="JHYY Compiler"
           Version="$(var.JHY_VERSION)"
           Manufacturer="JiHuiYiYou"
           UpgradeCode="FC3FC7FC-3479-43EB-A64D-490BAEB32066"
           Scope="perMachine"
           InstallerVersion="500">

    <!--
      Component GUIDs + UpgradeCode are real (v1.5.5 hotfix).
      See installer/GUIDS.md for the GUID ledger (stable across versions).

      UpgradeCode stays stable across versions — Component GUIDs should change
      only if Component content/structure changes. If you add/remove a Component,
      generate a new GUID via `python -c "import uuid; print(uuid.uuid4())"` and
      append to installer/GUIDS.md.
    -->

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Prereq check: MSYS2 ucrt64 + gcc must be installed for jhyy.exe to
      actually link .jhyy → .exe. We only WARN here (v1.5.2 单 MSI 不能
      自动装 MSYS2, 自动装推到 v1.5.3 Burn bundle).

      WiX 4 launch condition syntax: <Launch Condition="..." Message="..." />
      (跟 v3 <Condition Message="..."> 不同, per GitHub discussion #6304)

      Multi-source detection (W-031 fix, v1.5.6 hotfix):
      原 v1.5.2 只查 HKLM\Uninstall\ucrt64 GCC (Windows MSI installer 注册),
      但 MSYS2 ucrt64 GCC 是通过 pacman 装的, pacman 不写 Uninstall 注册表 →
      LaunchCondition 误报 → MSI 1603 fail.
      现在 4 源探测 (任一 true 即认为 GCC 装了):
        1. MSYS2_GCC_UNINSTALL : 原 HKLM Uninstall\ucrt64 GCC (保留 backward compat)
        2. MSYS2_GCC_PATH      : PATH 环境变量含 ucrt64\bin 或 mingw64\bin
        3. MSYS2_GCC_FILE      : C:\msys64\ucrt64\bin\gcc.exe 存在 (Windows 默认 MSYS2 install path)
        4. MSYS2_GCC_DIR       : C:\msys64 目录存在 (MSYS2 install 标志, 不强制 ucrt64 subdir)
      W-031 决策 (user 2026-08-15): 改探测, 不删 LaunchCondition — 没 GCC 装上
      也 OK (compiler 自身可用), 仅 jhyy run / jhyy compile 失败 (符合 v1.5.2 设计意图).
    -->
    <Launch Condition="Installed OR MSYS2_GCC_FOUND" Message="!(loc.MSYS2NotFound)" />

    <!-- Source 1: HKLM Uninstall\ucrt64 GCC (Windows installer registered) -->
    <Property Id="MSYS2_GCC_UNINSTALL">
      <RegistrySearch Id="MSYS2GccUninstallSearch"
                      Type="raw"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\ucrt64 GCC"
                      Name="DisplayVersion" />
    </Property>

    <!--
      Source 2: PATH environment variable contains ucrt64/bin or mingw64/bin.
      Type="raw" + Root=HKLM uses the system PATH (per-machine).
      Use Name="Path" (case sensitive — Windows registry uses "Path" key).
    -->
    <Property Id="MSYS2_GCC_PATH">
      <RegistrySearch Id="MSYS2GccPathSearch"
                      Type="raw"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                      Name="Path" />
    </Property>

    <!--
      Source 3: gcc.exe exists at default MSYS2 install location.
      WiX 4 DirectorySearch has no Type attribute — Path is the literal Windows
      path; child FileSearch checks file existence by Name (no Type attribute).
    -->
    <Property Id="MSYS2_GCC_FILE">
      <DirectorySearch Id="MSYS2UCRT64BinDir"
                       Path="C:\msys64\ucrt64\bin">
        <FileSearch Id="MSYS2GccExeSearch"
                    Name="gcc.exe" />
      </DirectorySearch>
    </Property>

    <!--
      Source 4: C:\msys64 directory exists (MSYS2 install marker — covers
      users who installed ucrt64 via pacman but PATH not propagated to
      Windows env yet, e.g. user opens fresh cmd without MSYS2 env init).
    -->
    <Property Id="MSYS2_GCC_DIR">
      <DirectorySearch Id="MSYS2RootDir"
                       Path="C:\msys64" />
    </Property>

    <!--
      Combined property: MSYS2_GCC_FOUND = any of the 4 sources found.
      WiX 4 SetProperty requires Before/After sequence attribute when Id is
      present. We schedule it After="AppSearch" so all 4 source properties are
      populated by then. AppSearch is the standard MSI sequence action that
      runs all <Property><RegistrySearch> + <Property><DirectorySearch>
      sources.
    -->
    <SetProperty Id="MSYS2_GCC_FOUND"
                 Value="1"
                 Before="LaunchConditions"
                 Condition="MSYS2_GCC_UNINSTALL OR MSYS2_GCC_PATH OR MSYS2_GCC_FILE OR MSYS2_GCC_DIR" />

    <!--
      W-031 fix: removed <Property><RegistrySearch> on INSTALLDIR + <SetDirectory>
      (WiX 4 emits SetINSTALLDIR type-51 CA with Condition="NOT INSTALLDIR" —
      but INSTALLDIR is pre-populated from <Directory> parent resolution to
      C:\JHYY\ before AppSearch runs, so NOT INSTALLDIR is always false → CA
      never fires → fresh installs land at C:\JHYY\ instead of C:\Program Files\).

      Fix: use <DirectoryRef> to put INSTALLDIR under ProgramFiles6432Folder
      directly. This way INSTALLDIR's default value is [ProgramFiles6432Folder]JHYY
      from directory table resolution — no CustomAction needed, no ICE12 issue.
      WiX's WixUI_Minimal InstallDir dialog still lets the user override at install time.

      For upgrade/repair, the registry-based INSTALLDIR_REG_FOUND property is
      unused at the default-install level — WixUI_Minimal will display the prior
      path via INSTALLDIR property resolution (WiX 4 sets INSTALLDIR from the
      registry during AppSearch when <Property><RegistrySearch> matches).
    -->
    <DirectoryRef Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="JHYY">
        <Directory Id="BinDir" Name="bin" FileSource="!(bindpath.bin)" />
        <Directory Id="CommonDir" Name="common" FileSource="!(bindpath.common)" />
        <Directory Id="VSCodeExtDir" Name="vscode-ext" FileSource="!(bindpath.vscode-ext)" />
      </Directory>
    </DirectoryRef>

    <Property Id="INSTALLDIR_REG_FOUND">
      <RegistrySearch Id="JHYYInstallDirSearch"
                      Type="directory"
                      Root="HKLM"
                      Key="SOFTWARE\JiHuiYiYou\JHYY"
                      Name="InstallDir" />
    </Property>

    <!--
      W-031 (2): <SetDirectory> removed. The DirectoryRef above replaces the
      old <Directory Id="INSTALLDIR"> under TARGETDIR, giving fresh installs
      C:\Program Files\JHYY\ as the default without any CustomAction.
    -->

    <Feature Id="JHYYCompilerFeature"
             Title="!(loc.FeatureJHYYTitle)"
             Description="!(loc.FeatureJHYYDescription)"
             Level="1"
             AllowAdvertise="no"
             TypicalDefault="install">

      <ComponentGroupRef Id="JHYYBinFiles" />
      <ComponentGroupRef Id="JHYYURLShortcuts" />
      <ComponentGroupRef Id="JHYYPathRegistry" />
      <ComponentGroupRef Id="JHYYShortcuts" />
      <ComponentGroupRef Id="JHYYVSCodeExt" />
      <ComponentGroupRef Id="JHYYFileAssoc" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="JhyyIconFile" />

    </Feature>

    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.common)\license.rtf" />

    <!--
      v1.5.8: recolor default WiX red+disc → mint, replace disc with J logo.
      Replaces rev 2 (navy bg + JHYY Compiler title text — too dark + duplicate
      brand name overlap). User feedback 2026-08-27: tight mint box (96x96) +
      80x80 J logo at upper-LEFT, no extra padding, square not rectangular.

      - jhyy-icon.ico     : multi-size (16+32+48+64+128+256) ARPPRODUCTICON
                            + Start Menu shortcut icon + .jhyy FileAssoc
      - jhyy-banner.bmp   : 493x58 MSI banner (default WiX recolored mint +
                            40x40 J logo replacing disc at right)
      - jhyy-welcome.bmp : 493x312 MSI welcome (default WiX recolored mint +
                            96x96 mint box + 80x80 J logo at upper-LEFT)

      Built by installer/build-jhyy-icons.ps1 from vscode-ext/icon.svg.
      Files NOT shipped (no <File> Component references them); embedded in
      MSI Binary table only. .ico IS shipped via JhyyIconFile Component.
    -->
    <WixVariable Id="WixUIBannerBmp"  Value="!(bindpath.bin)\jhyy-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp"  Value="!(bindpath.bin)\jhyy-welcome.bmp" />

    <Icon Id="JHYYIcon" SourceFile="!(bindpath.bin)\jhyy-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="JHYYIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/JiHuiYiYou/JiHuiYiYou-compiler" />

    <!--
      Post-install configuration (v1.5.7-rc1 rev 2):
      MSI deferred ExeCommand CustomActions systematically fail with error 1721
      on this system ("Windows Installer 程序包有问题。此安装需要的程序不能运行").
      Debugged over 3 MSI builds (2026-08-26) — root cause is CreateProcess argv
      parser mis-tokenizing cmd.exe /c chains with embedded escaped quotes when
      invoked from MSI deferred CA context (SYSTEM token, no interactive profile).
      Affects all 3 candidates:
        - InstallVSCodeExt (v1.5.4, latent bug — was always failing, Return=ignore saved install)
        - InstallEnvConfig + InstallVSCodeConfig (v1.5.7-rc1, new — even with .bat wrapper)

      Pivot: HKLM RunOnce registry entry pointing at install-configure-all.bat.
      RunOnce fires at next user logon in USER context (not SYSTEM), avoiding
      all deferred-CA issues:
        - HKCU writes work (user has write access to own hive)
        - child process spawning works (CreateProcess in user context, no MSI
          argv-parsing layer between us and Windows)
        - powershell.exe runs in user's interactive session

      Cost: requires ONE logoff/logon cycle after fresh install for config to
      take effect. Same UX as Defender exclusion requests anyway.

      The MSI ships:
        - install-configure-all.bat (orchestrator: sets MSYS2_PATH_TYPE,
          writes VSCode defaultProfile, auto-installs jhyy-lang .vsix via
          inline `code (dash-dash) install-extension`; non-fatal on each step)
        - install-configure-env.ps1, install-configure-vscode.ps1
      Then writes RunOnce value pointing at install-configure-all.bat.

      RunOnce lives in HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce.
      Windows deletes the value after first execution per user. Format:
        REG_SZ = "full path to .bat" (no args needed — orchestrator knows its paths)
      Quoting: literal " in REG_SZ is fine; Windows parses it via CreateProcess.
      "C:\Program Files\JHYY\bin\install-configure-all.bat" — outer quotes preserve
      the path-with-spaces as ONE arg to cmd.exe.

      On uninstall: <RemoveRegistryValue> clears the RunOnce entry to avoid stale
      references if user uninstalls before first logon.
    -->
    <InstallExecuteSequence>
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <!--
      Files in bin\ : jhyy.exe + qbe.exe (production binaries) + runtime.c
      + jhyy_helpers.c (v1.5.6 W-043) + runtime.h (v1.5.6 W-044).
      The C sources are needed because installer-layout jhyy.exe uses
      jh_paths_init layout (a) which builds "<bindir>\runtime.c" +
      "<bindir>\jhyy_helpers.c" paths from sibling qbe.exe. runtime.h
      is needed because runtime.c line 1 does #include "runtime.h"
      and gcc resolves it from runtime.c's dir. Regress uses
      source-tree layout (b), which is why these only manifest in
      fresh-install scenarios. See docs/internal/workarounds.md § W-043
      (RESOLVED) + § W-044 (RESOLVED).

      NOT included: GCC toolchain (per `力度 1 检测+引导` 决策, user 装 v1.5.2
      时已有 MSYS2 + gcc, 或 v1.5.3 Burn bundle 自动装 MSYS2).
    -->
    <ComponentGroup Id="JHYYBinFiles" Directory="BinDir">
      <!--
        JhyyExe: pure file component, no shortcut, per-machine KeyPath.
        Shortcut moved to separate Component "JhyyExeShortcut" below to fix
        ICE43/ICE57 (per-user shortcut + per-machine file in same Component
        with file KeyPath is invalid).
      -->
      <Component Id="JhyyExe" Bitness="always64" Guid="A76D4595-11CE-4F86-B70A-170A6FDA06B0">
        <File Id="JhyyExeFile"
              Source="!(bindpath.bin)\jhyy.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <Component Id="QbeExe" Bitness="always64" Guid="096E27A7-65E2-465C-BA58-399A02C0F000">
        <File Id="QbeExeFile"
              Source="!(bindpath.bin)\qbe.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <!--
        install-configure-env.ps1 (v1.5.7-rc1): sets MSYS2_PATH_TYPE=inherit
        at User scope (no admin needed) so MSYS2 bash picks up the JHYY bin
        entry the MSI just added to HKLM system PATH. Without this, MSYS2
        bash defaults to minimal PATH mode and ignores Windows PATH, so
        `jhyy` resolves to "command not found" from bash even though cmd/PS
        find it. Invoked via CustomAction InstallEnvConfig (deferred, no
        impersonate, Return=ignore — failure non-fatal).
      -->
      <Component Id="InstallConfigEnvPS1" Bitness="always64" Guid="0ADA340F-4463-466E-AFEE-302147CC0DD4">
        <File Id="InstallConfigEnvPS1File"
              Source="!(bindpath.common)\install-configure-env.ps1"
              KeyPath="yes" />
      </Component>

      <!--
        install-configure-all.bat (v1.5.7-rc1 rev 2): master post-install
        orchestrator invoked via HKLM RunOnce at next user logon. Runs:
          1. install-configure-env.ps1 (MSYS2_PATH_TYPE=inherit User env)
          2. install-configure-vscode.ps1 (terminal.integrated.defaultProfile)
          3. (v1.5.10) inline `where code` + `code (dash-dash) install-extension <vsix>`
        No MSI CustomAction — RunOnce fires in user context, avoiding the
        deferred-CA 1721 error that broke all 3 v1.5.6 CustomActions
        (cmd.exe /c chains in SYSTEM token).
      -->
      <Component Id="InstallConfigureAllBat" Bitness="always64" Guid="B7C4D5E9-2A1F-4E3B-9C8D-6F5A2E8B1C44">
        <File Id="InstallConfigureAllBatFile"
              Source="!(bindpath.common)\install-configure-all.bat"
              KeyPath="yes" />
      </Component>

      <!--
        install-configure-vscode.ps1 (v1.5.7-rc1): writes VSCode user
        settings.json to add `terminal.integrated.defaultProfile.windows =
        "bash (MSYS2)"` and ensures the profile entry exists. Conservative
        merge — if defaultProfile already set to anything else, leaves it
        alone (respects user choice). Invoked via CustomAction
        InstallVSCodeConfig (deferred, no impersonate, Return=ignore).
      -->
      <Component Id="InstallConfigVSCodePS1" Bitness="always64" Guid="0FA909A4-020F-4BEC-AACD-D9B3F5BB7A16">
        <File Id="InstallConfigVSCodePS1File"
              Source="!(bindpath.common)\install-configure-vscode.ps1"
              KeyPath="yes" />
      </Component>

      <!--
        RuntimeC (v1.5.6 W-043): ships compiler/runtime/runtime.c to
        INSTALLDIR\bin\ so installer-layout jhyy.exe link can find it.
        jhyy_helpers.c:184-198 (layout a) builds "<bindir>\runtime.c" path
        from sibling qbe.exe; without this file, gcc link fails because
        the path appears on the cmdline but the file is absent on disk.
      -->
      <Component Id="RuntimeC" Bitness="always64" Guid="B4A71F8C-9D32-4E6A-B5C8-7F1E3A92D104">
        <File Id="RuntimeCFile"
              Source="!(bindpath.bin)\runtime.c"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <!--
        RuntimeH (v1.5.6 W-044): ships compiler/runtime/runtime.h to
        INSTALLDIR\bin\. Companion to RuntimeC — runtime.c line 1 does
        #include "runtime.h" and gcc resolves it from runtime.c's dir.
        Without this, fresh-install gcc compile fails with
        "fatal error: runtime.h: No such file or directory" even after
        W-043 ships runtime.c. (jhyy_helpers.c has no local header deps
        so W-043 was complete for that file.)
      -->
      <Component Id="RuntimeH" Bitness="always64" Guid="D5C2880A-5AA4-4ED4-AAFC-8C18D1E650B8">
        <File Id="RuntimeHFile"
              Source="!(bindpath.bin)\runtime.h"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <!--
        HelpersC (v1.5.6 W-043): ships compiler/src0/jhyy_helpers.c to
        INSTALLDIR\bin\. Companion to RuntimeC. Provides
        jh_paths_init / jh_run / jh_gcc_path (CreateProcessA + quoting
        helpers) which jhyy.exe links statically.
      -->
      <Component Id="HelpersC" Bitness="always64" Guid="7C3D9E2A-4F1B-4A8E-9D6F-2B5E8C1A4F77">
        <File Id="HelpersCFile"
              Source="!(bindpath.bin)\jhyy_helpers.c"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <!--
        JhyyIconFile (v1.5.7-rc1 rev 2): ships jhyy-icon.ico to INSTALLDIR\bin\
        so FileAssoc DefaultIcon can reference the installed .ico (Windows
        shell displays .jhyy files with this icon in Explorer). Also serves as
        a stable source for any future shortcut icon updates without re-bundling
        jhyy.exe. Multi-size (16/32/48/64/128/256) ICO format, Vista+ compatible.
      -->
      <Component Id="JhyyIconFile" Bitness="always64" Guid="1C8B7A4D-3E2F-4B6D-9A5C-7E8F2D1B4A03">
        <File Id="JhyyIconFileFile"
              Source="!(bindpath.bin)\jhyy-icon.ico"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Internet Shortcut (.url) files (v1.5.4) — used by Start Menu shortcuts
      to open docs / quick-start URLs (MSI Shortcut.Target must be a file,
      not URL). Lives in INSTALLDIR\common\ alongside license.rtf.
    -->
    <ComponentGroup Id="JHYYURLShortcuts" Directory="CommonDir">
      <Component Id="JhyyDocsURL" Bitness="always64" Guid="4065743A-3D07-48DE-A0E3-7FF8D5FEFA79">
        <File Id="JhyyDocsURLFile"
              Source="!(bindpath.common)\JHYY Documentation.url"
              KeyPath="yes" />
      </Component>
      <Component Id="JhyyQuickStartURL" Bitness="always64" Guid="98BA5444-5A01-4FD4-9995-623AC6869020">
        <File Id="JhyyQuickStartURLFile"
              Source="!(bindpath.common)\JHYY Quick Start.url"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      PATH registry: write HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment
      PATH append C:\Program Files\JHYY\bin. Requires admin (Scope=perMachine).

      On uninstall, registry entry rolls back via standard MSI RemoveEnvironment.
    -->
    <ComponentGroup Id="JHYYPathRegistry" Directory="INSTALLDIR">
      <Component Id="JHYYPathReg" Bitness="always64">
        <Environment Id="JHYYBinPath"
                     Name="PATH"
                     Value="[INSTALLDIR]bin"
                     Permanent="no"
                     System="yes"
                     Action="set"
                     Part="last" />

        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\JiHuiYiYou\JHYY">
          <RegistryValue Type="string" Name="InstallDir" Value="[INSTALLDIR]" />
          <RegistryValue Type="string" Name="Version" Value="$(var.JHY_VERSION)" />
        </RegistryKey>

        <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\JiHuiYiYou\JHYY" Action="removeOnUninstall" />
      </Component>

      <!--
        JHYYRunOnce (v1.5.7-rc1 rev 2): HKLM RunOnce entry pointing at
        install-configure-all.bat. Windows fires RunOnce at next user logon
        in the user's context, which:
          - can write HKCU (env vars, VSCode settings.json)
          - can spawn child processes normally (no MSI deferred-CA argv parsing)
          - runs powershell.exe in interactive session (loads user profile)

        HKLM RunOnce fires for EACH user on their first logon after the entry
        is written. Windows deletes the entry after first execution. Format:
          HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce!JHYYPostInstall
          = "C:\Program Files\JHYY\bin\install-configure-all.bat"
        Outer quotes preserve the path-with-spaces as ONE arg to cmd.exe when
        RunOnce fires it via CreateProcess.

        On uninstall: RemoveRegistryValue clears the entry to avoid stale
        references if user uninstalls before first logon (RunOnce entries
        pointing to deleted binaries are harmless but noisy in event log).

        Component owns the binary InstallConfigureAllBat (via Feature reference
        to JHYYBinFiles ComponentGroup above) + this registry KeyPath. Per ICE43
        rules: registry KeyPath is valid for Component with no files, as long as
        it's referenced by a Feature.
      -->
      <Component Id="JHYYRunOnceReg" Bitness="always64" Guid="D9E2F4A1-5B7C-4A8E-9F1D-3B6C8A2E5F71">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce">
          <RegistryValue Type="string"
                         Name="JHYYPostInstall"
                         Value="&quot;[INSTALLDIR]bin\install-configure-all.bat&quot;"
                         KeyPath="yes" />
        </RegistryKey>
        <RemoveRegistryValue Root="HKLM"
                             Key="SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce"
                             Name="JHYYPostInstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      LicenseFile: 64-bit Bitness for consistency with other Components
      (ICE80: Package cannot mix 32-bit and 64-bit Components). jhyy.exe +
      qbe.exe are 64-bit, so all other Components in this MSI must also
      be 64-bit.
    -->
    <Component Id="LicenseFile" Directory="CommonDir" Bitness="always64" Guid="A4874A53-15B4-4010-8AF5-E6D47BD328CB">
      <File Id="LicenseFileRtf"
            Source="!(bindpath.common)\license.rtf"
            KeyPath="yes" />
    </Component>

    <!--
      VSCodeExt ComponentGroup (v1.5.4): install .vsix to INSTALLDIR\vscode-ext\
      so MSI owns the file. v1.5.10: install-configure-all.bat RunOnce step 3
      inlines `code (dash-dash) install-extension <vsix>` to register it in VSCode.
      (Earlier v1.5.7-rc1 rev 2 design used a separate install-vsix.bat CustomAction
      — superseded; see install-configure-all.bat comment for the RunOnce pivot.)

      VSIX file name 跟 compiler DISPLAY version 同步 (jhyy-lang-X.Y.Z[-rcN].vsix).
      For RC releases, file includes -rcN suffix (matches the MSI filename).
      build.ps1 负责 copy 到 bindpath/vscode-ext/.
    -->
    <ComponentGroup Id="JHYYVSCodeExt" Directory="VSCodeExtDir">
      <Component Id="VSCodeExtVSIX" Bitness="always64" Guid="2BD62503-5942-4364-8052-B86ABC43C5C8">
        <File Id="VSCodeExtVSIXFile"
              Source="!(bindpath.vscode-ext)\jhyy-lang-$(var.JHY_VERSION_DISPLAY).vsix"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      JhyyExeShortcut: Start Menu shortcut (per-user data) with HKCU
      registry key as KeyPath (per ICE43/ICE57 requirement: per-user
      data Component must have HKCU KeyPath, not file).
      Component resides under INSTALLDIR for structural placement but
      contains no per-machine data.
    -->
    <ComponentGroup Id="JHYYShortcuts" Directory="INSTALLDIR">
      <Component Id="JhyyExeShortcut"
                 Guid="9F008EC5-EF58-41B9-B6BE-8C4DD707E40A"
                 Bitness="always64">
        <RegistryKey Root="HKCU"
                     Key="Software\JiHuiYiYou\JHYY">
          <RegistryValue Type="string"
                         Name="ShortcutInstalled"
                         Value="[INSTALLDIR]bin\jhyy.exe"
                         KeyPath="yes" />
        </RegistryKey>
        <Shortcut Id="JhyyStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="JHYY Compiler"
                  Target="[INSTALLDIR]bin\jhyy.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="JHYYIcon" />
        <RemoveRegistryKey Root="HKCU"
                           Key="Software\JiHuiYiYou\JHYY"
                           Action="removeOnUninstall" />
      </Component>

      <!--
        DocsShortcut: opens JHYY wiki in default browser (v1.5.4).
        Target is Internet Shortcut (.url) file in INSTALLDIR\common\.
        MSI Shortcut.Target must be a file path (URL not allowed per ICE03).
      -->
      <Component Id="JhyyDocsShortcut"
                 Guid="32C375AD-328D-47CF-A422-8155A092CA04"
                 Bitness="always64">
        <RegistryKey Root="HKCU"
                     Key="Software\JiHuiYiYou\JHYY">
          <RegistryValue Type="string"
                         Name="DocsShortcutInstalled"
                         Value="1"
                         KeyPath="yes" />
        </RegistryKey>
        <Shortcut Id="JhyyDocsStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="JHYY Documentation"
                  Target="[INSTALLDIR]common\JHYY Documentation.url" />
        <RemoveRegistryValue Root="HKCU"
                              Key="Software\JiHuiYiYou\JHYY"
                              Name="DocsShortcutInstalled" />
      </Component>

      <!--
        QuickStartShortcut: opens spec/quick-start in default browser (v1.5.4).
        Target is Internet Shortcut (.url) file in INSTALLDIR\common\.
      -->
      <Component Id="JhyyQuickStartShortcut"
                 Guid="181ADF1A-21D7-40A0-BF9D-64695522D202"
                 Bitness="always64">
        <RegistryKey Root="HKCU"
                     Key="Software\JiHuiYiYou\JHYY">
          <RegistryValue Type="string"
                         Name="QuickStartShortcutInstalled"
                         Value="1"
                         KeyPath="yes" />
        </RegistryKey>
        <Shortcut Id="JhyyQuickStartStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="JHYY Quick Start"
                  Target="[INSTALLDIR]common\JHYY Quick Start.url" />
        <RemoveRegistryValue Root="HKCU"
                              Key="Software\JiHuiYiYou\JHYY"
                              Name="QuickStartShortcutInstalled" />
      </Component>
    </ComponentGroup>

    <!--
      FileAssoc Component (v1.5.4, v1.8.1 patch 真修): .jhyy file association
      via HKCR (per-machine install → HKLM\SOFTWARE\Classes).
      写 HKCR\JHYY.SourceFile ProgID + shell\open\command 让双击 .jhyy → jhyy.exe run.

      v1.8.1 patch:
      - HKCR\.jhyy\(default) 现在真的写到 "JHYY.SourceFile" (v1.5.4 当时误把
        ProgID 写到 named value "JHYYSourceFileMapping",但 Explorer 只读
        (default),所以 lookup 退到 MSYS2 HKCU shadow = "jhyy_auto_file",
        全白板图标 1.5.4 → 1.5.10 都中招,直至 1.8.1 真修).
      - DefaultIcon 改成 [INSTALLDIR]bin\jhyy.exe,0 (v1.8.1 之后 jhyy.exe 自己
        embed RT_ICON group via Makefile + compiler/src/jhyy.rc),去掉对独立
        jhyy-icon.ico 的运行时依赖.

      Layout:
        HKCR\.jhyy\             (default) = "JHYY.SourceFile"
        HKCR\JHYY.SourceFile\   (default) = "JHYY Source File"
                                  DefaultIcon\(default) = "[INSTALLDIR]bin\jhyy.exe,0"
                                  shell\open\(default) = "Run with JHYY"
                                  shell\open\command\(default) = '"[INSTALLDIR]bin\jhyy.exe" run "%1"'

      KeyPath 用 HKLM registry value (per ICE43: file KeyPath + per-machine data OK).

      Note: WiX HKCR 映射 — per-machine MSI 自动写 HKLM\SOFTWARE\Classes。
      用户没有 admin 装 MSI 时, 这 Component 装不了 (HKLM 要 admin). Already MSI 是
      Scope=perMachine + InstallerVersion=500 要求 admin.
    -->
    <ComponentGroup Id="JHYYFileAssoc" Directory="INSTALLDIR">
      <Component Id="JHYYFileAssocReg"
                 Bitness="always64"
                 Guid="C74ED968-E9D7-4061-AFC6-8FA37401F481">
        <RegistryKey Id="HKCR_JhyyExt"
                     Root="HKCR"
                     Key=".jhyy"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes">
          <!--
            v1.8.1 patch: drop Name="..." so this RegistryValue writes to the
            key's (default) slot, NOT a named value. Explorer walk for ProgID
            reads (default) only — the v1.5.4 named-value form silently
            failed to associate .jhyy with JHYY.SourceFile, leaving the
            default install to fall through to MSYS2's HKCU shadow.
          -->
          <RegistryValue Type="string"
                         Value="JHYY.SourceFile"
                         KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Id="HKCR_JhyyProgID"
                     Root="HKCR"
                     Key="JHYY.SourceFile"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string"
                         Value="JHYY Source File" />
          <RegistryKey Id="HKCR_JhyyDefaultIcon"
                       Key="DefaultIcon"
                       ForceCreateOnInstall="yes">
            <!--
              v1.8.1 patch: point DefaultIcon at jhyy.exe's embedded RT_ICON
              group (jhyy.exe,0). v1.5.7-rc1 rev 2 used the standalone
              [INSTALLDIR]bin\jhyy-icon.ico file (named value mapping then
              silently broken). jhyy.exe now embeds the same branded 6-frame
              Vista+ ICO via windres (Makefile + compiler/src/jhyy.rc +
              compiler/src/main.c), matching the brand asset and removing
              the 7491-byte .ico runtime dependency for FileAssoc.

              Python uses the same idiom: HKCR\Python.File\DefaultIcon =
              "C:\Python312\python.exe,0".
            -->
            <RegistryValue Type="string"
                           Value="[INSTALLDIR]bin\jhyy.exe,0" />
          </RegistryKey>
          <RegistryKey Id="HKCR_JhyyShell"
                       Key="shell"
                       ForceCreateOnInstall="yes">
            <RegistryKey Id="HKCR_JhyyShellOpen"
                         Key="open"
                         ForceCreateOnInstall="yes">
              <RegistryValue Type="string"
                             Value="Run with JHYY" />
              <RegistryKey Id="HKCR_JhyyShellOpenCommand"
                           Key="command"
                           ForceCreateOnInstall="yes">
                <RegistryValue Type="string"
                               Value="&quot;[INSTALLDIR]bin\jhyy.exe&quot; run &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
        <RemoveRegistryKey Root="HKCR"
                           Key="JHYY.SourceFile"
                           Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR"
                           Key=".jhyy"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>