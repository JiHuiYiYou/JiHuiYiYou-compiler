<?xml version="1.0" encoding="utf-8"?>
<!--
  compiler/Locale.zh-CN.wxl : 中文 UI string (v1.5.2)

  WiX 4 UI 默认英文, 这份 wxl 加中文 localization. 用户面 OS 是中文时
  Burn / MSI dialog 自动 pick 这个.

  WiX 4 语法: <String> 必须用 Value 属性 (不能 inner text, per WIX0400 error).
  &amp; &lt; &gt; 是 XML 保留字符转义.

  Reference:
    - docs/plans/v1/v1.5.0任务清单 + 概要设计.md § Sprint v1.5.2
-->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="zh-CN">

  <String Id="Language" Overridable="no" Value="2052" />

  <String Id="DowngradeErrorMessage"
          Value="[ProductName] 已经安装更新的版本。请先卸载现有版本, 再安装本版本。" />

  <!--
    v4.1.0: MSYS2NotFound 文案退役 —— 之前它挂在
    <Launch Condition="Installed OR MSYS2_GCC_FOUND"> 上 (没装 MSYS2 就装不上)。
    v4.1.0 起 installer 自带一份最小原生 ucrt64 工具链, 门槛已拆除,
    这条文案不再被引用。
  -->

  <String Id="FeatureJHYYTitle" Value="JHYY 编译器核心" />
  <String Id="FeatureJHYYDescription"
          Value="JHYY 编译器 (jhyy.exe), 自带自研 codegen 后端 (v4.0.0 起 QBE 完全移除)。v4.1.0 起自带链接用的 GCC 工具链, 无需另外安装 MSYS2。" />

  <String Id="WelcomeDlgTitle" Value="欢迎使用 [ProductName] 安装向导" />
  <String Id="WelcomeDlgDescription"
          Value="本安装向导将引导您完成 [ProductName] 在您的计算机上的安装。

JHYY 是一门自研静态类型编程语言, 配有自己的编译器 (含自研 codegen 后端, v4.0.0 起已移除 QBE)。安装程序会复制 jhyy.exe 到您的系统, 并配置 PATH。

按 下一步 继续。" />

  <String Id="InstallDirDlgTitle" Value="安装文件夹" />
  <String Id="InstallDirDlgDescription"
          Value="请选择安装文件夹。

默认: [INSTALLDIR]

按 下一步 继续。" />

  <String Id="ProgressDlgTitleInstalling" Value="正在安装 [ProductName]" />
  <String Id="ProgressDlgTitleRepairing" Value="正在修复 [ProductName]" />
  <String Id="ProgressDlgTitleRemoving" Value="正在卸载 [ProductName]" />

</WixLocalization>