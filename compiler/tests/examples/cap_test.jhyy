// Per spec supplement v3.1.0 § 3: sizeof(Cap<T>) == 8 on all targets.
fn main_jhyy() -> i32 {
    let s_cap: i64 = sizeof(Cap);
    if s_cap == 8 {
        return 42;
    }
    return s_cap as i32;
}
