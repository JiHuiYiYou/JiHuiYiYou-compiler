// EXPECT: 0
// W-185②: `u32 / u32` 与 `u32 % u32` 必须按**无符号**语义算。
//
// 修前:opcode 表把 `/` `%` 写死成有符号的 `div` / `rem`
//   ⇒ `2728898079u32 / 761116571u32` 得 `-2`(位模式 4294967294)而不是 `3`。
// 修后:按**左操作数**的符号性选 `udiv` / `urem`。
//
// ⚠️ 为什么这个缺陷「跑不出来」:u32 的加法/乘法都**不受影响**(位模式对)
//   ⇒ 只有**高位值参与除法/取模**才暴露。
//
// ⚠️ **两条路径都要验**:
//   · 运行期:值经**函数调用**进来 ⇒ 走 `udiv` / `urem` 指令;
//   · 编译期:模块级 `let` 的初始化器走常量折叠器(`cg_const_fold`)
//     ⇒ 折叠路径必须与运行期**逐位一致**。

fn mk(v: u32) -> u32 {
    return v;
}

// ── 编译期路径(常量折叠)────────────────────────────────────────
let mut g_q: u32 = 2728898079u32 / 761116571u32;
let mut g_r: u32 = 2728898079u32 % 761116571u32;
let mut g_q2: u32 = 4294967295u32 / 2u32;
let mut g_q3: i32 = -7 / 2;
let mut g_r3: i32 = -7 % 2;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // 高位被除数:无符号商 3 / 有符号商 -2
    let a: u32 = mk(2728898079u32);
    let b: u32 = mk(761116571u32);
    let q: u32 = a / b;
    if q != 3u32 { err = err + 1; }
    let r: u32 = a % b;
    if r != 445548366u32 { err = err + 2; }

    // u32::MAX / 2 ⇒ 2147483647(有符号语义会得 4294967295 = -1)
    let c: u32 = mk(4294967295u32);
    let d: u32 = mk(2u32);
    let q2: u32 = c / d;
    if q2 != 2147483647u32 { err = err + 4; }

    // u32::MAX % 3 ⇒ 0
    let e: u32 = mk(3u32);
    let r2: u32 = c % e;
    if r2 != 0u32 { err = err + 8; }

    // 有符号 i32 仍按**有符号**语义(向零截断)
    let f: i32 = -7;
    let g: i32 = 2;
    let q3: i32 = f / g;
    if q3 != -3 { err = err + 16; }
    let r3: i32 = f % g;
    if r3 != -1 { err = err + 32; }

    // ── 编译期路径(常量折叠)──
    if g_q != 3u32 { err = err + 64; }
    if g_r != 445548366u32 { err = err + 128; }
    if g_q2 != 2147483647u32 { err = err + 256; }
    if g_q3 != -3 { err = err + 512; }
    if g_r3 != -1 { err = err + 1024; }

    return err;
}
