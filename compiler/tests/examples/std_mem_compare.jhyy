// std_mem_compare.jhyy — v3.2.2 (3l.1) std::mem mem_compare test.
//EXPECT:0  (equal returns 0)
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}
fn mem_compare(a: *u8, b: *u8, n: i64) -> i32 {
    if n < (0 as i64) {
        return 0 as i32;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let av: i32 = *(ptr_add(a, i) as *i32) & (0xff as i32);
        let bv: i32 = *(ptr_add(b, i) as *i32) & (0xff as i32);
        if av != bv {
            if av < bv {
                return 0 - (1 as i32);
            }
            return 1;
        }
        i = i + (1 as i64);
    }
    return 0 as i32;
}
fn main_jhyy() -> i32 {
    let a: [i32; 4] = [0x41 as i32, 0x42 as i32, 0x43 as i32, 0x44 as i32];
    let b: [i32; 4] = [0x41 as i32, 0x42 as i32, 0x43 as i32, 0x44 as i32];
    let r = mem_compare(a as *u8, b as *u8, 4 as i64);
    if r != 0 {
        return 1;
    }
    return 0;
}
