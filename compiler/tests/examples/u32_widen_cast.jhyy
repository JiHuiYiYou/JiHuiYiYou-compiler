// EXPECT: 0
// W-185①: `u32 → i64` 的加宽必须**零扩展**(不是符号扩展)。
//
// 修前:codegen 的 w→l 分支**无条件**发 `extsw`
//   ⇒ `4000000000u32` 加宽成 `-294967296`(高 32 位全 1)。
// 修后:按**源类型**的 prim 选 `extuw` / `extsw`(指针仍走 `extsw`)。
//
// 断言强度:值经**函数参数**进来 ⇒ 走运行期路径
//   (纯字面量的常量折叠路径本来就是对的,直接写字面量测不出这条缺陷)。
//
// ⚠️ **两条路径都要验**:
//   · 运行期:值经函数参数进来 ⇒ 走 `extuw` 指令;
//   · 编译期:模块级 `let` 的初始化器走常量折叠器(`cg_const_fold`)
//     ⇒ 折叠路径必须与运行期**逐位一致**。

fn widen(v: u32) -> i64 {
    return v as i64;
}

// ── 编译期路径(常量折叠)────────────────────────────────────────
let mut g_w1: i64 = 4000000000u32 as i64;
let mut g_w2: i64 = 4294967295u32 as i64;
let mut g_w3: i64 = 42u32 as i64;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // 4000000000 > 2^31,符号扩展会变负
    let a: u32 = 4000000000u32;
    let w: i64 = widen(a);
    if w != 4000000000i64 { err = err + 1; }

    // u32::MAX:符号扩展会得 -1
    let b: u32 = 4294967295u32;
    let w2: i64 = widen(b);
    if w2 != 4294967295i64 { err = err + 2; }

    // 恰好 2^31
    let c: u32 = 2147483648u32;
    let w3: i64 = widen(c);
    if w3 != 2147483648i64 { err = err + 4; }

    // 小值:零扩展与符号扩展同值
    let d: u32 = 42u32;
    let w4: i64 = widen(d);
    if w4 != 42i64 { err = err + 8; }

    // 有符号 i32 → i64 仍是符号扩展(-7 ⇒ -7,不是别的)
    let e: i32 = -7;
    let w5: i64 = e as i64;
    if w5 != -7i64 { err = err + 16; }

    // ── 编译期路径(常量折叠)──
    if g_w1 != 4000000000i64 { err = err + 32; }
    if g_w2 != 4294967295i64 { err = err + 64; }
    if g_w3 != 42i64 { err = err + 128; }

    return err;
}
