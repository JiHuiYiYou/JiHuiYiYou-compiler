// float_cmp.jhyy — 回归测试 f64 / f32 比较 + 跨宽度的隐式转换（bug #9
// + v1.0.0 call-site convert）。
//
// 2026-10-15 改(W-109):本文件此前**无法失败** —— 没有 `// EXPECT:` 指令,
// main_jhyy 是无条件 `return 42`,而 printf 声明只收 1 个 i32 实参却传了
// 5 个 %d(撞 ABI § 11.2 B8 的变参限制),比较结果全喂给垃圾输出。
// regress 报 `PASS EXIT=42`,但这个 PASS 不携带任何信息 —— 浮点比较因此
// 坏了很久没人知道。
//
// 现在:printf 按实际用到的参数逐个声明(本编译器不支持变参),退出码由
// 比较结果推导,输出用 EXPECT-OUT 逐值断言。
//
// 期望值(逐项推):
//   cmp_d(1.0, 2.0) = 10 + 100 + 1000 + 10000 + 100000 = 111110
//   cmp_d(3.0, 2.0) = 10          (b>=a 即 2>=3 为假)
//   cmp_s(1.0, 2.0) = 1 + 2 + 4 + 8 = 15
//   take_d(2.5)     = 1           (2.5 > 1.0)
//   take_s(3.5)     = 1           (3.5 > 1.0)
//   总和 = 111137
//
// v4.0.9: W-109 已 RESOLVED(2026-10-17)。XFAIL 标记按其自身约定摘掉 ——
// 摘标记后本测试立刻 PASS,就是修好的验收标准。
// 根因:codegen_amd64_lexer.jhyy 的 `c*` 助记符 gate 第二字符只收 s/u/e/n/g,
// 漏了 'l' → cltd / clts / cled 落到 "unknown QBE IL mnemonic" → lex_il
// 跳 1 字节继续 → 吐垃圾指令。emit_binop 侧一直支持这 6 个 op,缺的只有 lexer。
// EXPECT: 111137
// EXPECT-OUT: "d=111110 d2=10 s=15 p=1 dem=1"
extern fn printf(fmt: *u8, a: i32, b: i32, c: i32, d: i32, e: i32) -> i32;

fn cmp_d(a: f64, b: f64) -> i32 {
    let mut n: i32 = 0;
    if a == b { n = n + 1; }
    if a != b { n = n + 10; }
    if a <  b { n = n + 100; }
    if a <= b { n = n + 1000; }
    if b >  a { n = n + 10000; }
    if b >= a { n = n + 100000; }
    return n;
}

fn cmp_s(a: f32, b: f32) -> i32 {
    let mut n: i32 = 0;
    if a <  b { n = n + 1; }
    if a <= b { n = n + 2; }
    if b >  a { n = n + 4; }
    if b >= a { n = n + 8; }
    return n;
}

/* f32 → f64 隐式提升在 call site：直接传 f32 字面量给 f64 参数 */
fn take_d(a: f64) -> i32 {
    if a > 1.0 { return 1; } else { return 0; }
}

/* f64 → f32 隐式截断在 call site：直接传 f64 字面量给 f32 参数 */
fn take_s(a: f32) -> i32 {
    if a > 1.0 { return 1; } else { return 0; }
}

fn main_jhyy() -> i32 {
    let r_d  = cmp_d(1.0, 2.0);          /* 111110 */
    let r_d2 = cmp_d(3.0, 2.0);          /* 10 */
    let r_s  = cmp_s(1.0, 2.0);          /* 15 */

    /* 2.5f32 → 2.5f64 via call-site exts → take_d 返回 1（>1.0） */
    let r_p  = take_d(2.5);
    /* 3.5f64 → 3.5f32 via call-site truncd → take_s 返回 1（>1.0） */
    let r_dem = take_s(3.5);

    /* 逐值打印(不是只打总和)—— 某个比较错位时要能定位到是哪一项 */
    printf("d=%d d2=%d s=%d p=%d dem=%d\n", r_d, r_d2, r_s, r_p, r_dem);
    /* 退出码由结果推导:111110 + 10 + 15 + 1 + 1 = 111137 */
    return r_d + r_d2 + r_s + r_p + r_dem;
}
