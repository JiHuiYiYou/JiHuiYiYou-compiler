fn main_jhyy() -> i32 {
    let s: [*]i32 = &[1, 2, 3, 4, 5];
    let mut sum_sugar: i32 = 0;
    for x in s {
        sum_sugar = sum_sugar + x;
    }
    let mut sum_manual: i32 = 0;
    for i in 0..s.len {
        let x: i32 = s[i];
        sum_manual = sum_manual + x;
    }
    return sum_sugar - sum_manual;
}
// 2026-10-15 补断言: `for x in s` 与 `for i in 0..s.len` 两条路径必须
// 逐元素等价 —— 各自都得 15,差值恒为 0(任一路径多算/漏算/越界都非 0)。
// EXPECT: 0