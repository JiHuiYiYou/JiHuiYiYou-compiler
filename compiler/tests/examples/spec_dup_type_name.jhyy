// spec_dup_type_name.jhyy — 同名 **type** ⇒ 编译期报错(不是编译器崩溃)
//
// 2026-10-27(W-150 真修):同 `spec_dup_fn_name.jhyy` 的根因 ——
// `symtab_insert` 对「同 scope 重名」返回 null ⇒ 调用方不检查 ⇒ null 进 AST ⇒
// sema 的 `(*td_sym).name` 解引用 null ⇒ **空指针写** ⇒ 编译器崩(0xC0000005)。
//
// 语义(user 2026-10-27 拍板):同名 type 是**错误** ⇒ 编译期报错,干净退出。
//
// EXPECT-ERROR: "is defined multiple times"
type P = struct {
    a: i32,
}

type P = struct {
    b: i32,
}

fn main_jhyy() -> i32 {
    return 0;
}
