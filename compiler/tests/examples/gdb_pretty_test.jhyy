// gdb_pretty_test.jhyy — v1.4.3 test for gdb_pretty.py
// EXPECT: 0
//
// 2026-10-15:本文件**不是 W-114 的可靠门**,`EXPECT-OUT` 已撤掉。
//
// 原先补过一条 `// EXPECT-OUT: "=133"`(想断言 read_point 30 + read_color 1 +
// read_maybe 42 + read_slice 60 = 133)。但本文件的 stdout 依赖未初始化栈 ——
// 实测连续三次分别输出:
//     p=90 c=67107264   m=1 s=67099120
//     p=90 c=2105539584 m=1 s=2105531440
//     p=90 c=-731907680 m=1 s=-731915824
// 偶尔凑巧等于 133 就**假通过**(XPASS)—— 依赖垃圾内存的断言不是断言。
// 把 printf 声明从 1 参数改成 4 参数也没解决,说明不止是 ABI § 11.2 B8
// 那个变参问题。
//
// W-114 的**确定性**门是 `enum_match_unit_variants.jhyy`(逐变体断言,
// 不同变体必须给不同结果)。
//
// 本文件**不带 XFAIL**:它已经不再断言任何与 W-114 相关的东西,而 main 恒返回 0,
// 留着 XFAIL 标记只会每轮报一个必然的 XPASS(假信号)。
//
// Covers the three composite types handled by the pretty printer:
//   - struct (Point: 2 flat fields)
//   - enum   (Color: 3 unit variants; MaybeInt: variant with payload)
//   - slice  ([*]i32: ptr + len)
//
// Why printf? — Without side effects, QBE aggressively folds enum values
// (match on unit-variant → constant) and re-uses the stack slot for the
// next allocation. The slice backing array ends up overwriting the enum
// slots. Calling printf forces each var to remain addressable (printf
// takes `*u8` so the compiler can't fold the call site into a constant).
//
// NOTE: nested struct (Outer { inner: Inner }) is covered by
// compiler/tests/examples/nested_struct_dwarf.jhyy (per v1.7.3 patch A7, deferred
// to v1.8 due to W-061 nested struct field offset bug discovered during patch ship;
// see docs/internal/workarounds.md W-061 🟡 DEFERRED v1.8 + W-019 ✅ RESOLVED 2026-08-14).
//
// Run:
//   jhyy.exe compile gdb_pretty_test.jhyy -o gdb_pretty_test
//   qbe -t amd64_win -o gdb_pretty_test.s gdb_pretty_test.il
//   gcc gdb_pretty_test.s runtime.c -O0 -o gdb_pretty_test.exe
//   gdb -batch \
//     -ex "source .gdbinit" \
//     -ex "source compiler/src0/scripts/dev/gdb_pretty.py" \
//     -ex "jhyy-load-types compiler/tests/examples/gdb_pretty_test.jhyy" \
//     -ex "b gdb_pretty_test.jhyy:46" -ex "r" \
//     -ex "jhyy-pretty \$rsp Point" \
//     -ex "jhyy-pretty \$rsp+8 Color" \
//     -ex "jhyy-pretty \$rsp+12 MaybeInt" \
//     -ex "jhyy-pretty \$rsp+24 [*]i32" \
//     gdb_pretty_test.exe

extern fn printf(fmt: *u8, a: i32, b: i32, c: i32, d: i32) -> i32;

type Point = struct { x: i32, y: i32 }
type Color = enum { Red, Green, Blue }
type MaybeInt = enum { Some(i32), None }

// Helper functions: take each composite type by-pointer (the address
// itself is computed by the caller). This forces QBE to allocate a real
// stack slot for each var (because its address must be passed to the
// callee and the callee may read it). Per ABI § 3.2, struct/enum/slice
// pass-by-value goes through a hidden slot anyway, but taking the address
// explicitly via `&` is the simplest way to *also* keep the original
// caller-side slot alive.
fn read_point(p: *Point) -> i32 { return (*p).x + (*p).y; }
fn read_color(c: *Color) -> i32 {
    return match *c { Color::Red => 0, Color::Green => 1, Color::Blue => 2 };
}
fn read_maybe(m: *MaybeInt) -> i32 {
    return match *m { MaybeInt::Some(v) => v, MaybeInt::None => 0 };
}
fn read_slice(s: [*]i32) -> i32 { return s[0] + s[4]; }

fn main_jhyy() -> i32 {
    let p: Point = Point { x: 10, y: 20 };
    let c: Color = Color::Green;
    let m: MaybeInt = MaybeInt::Some(42);
    let s: [*]i32 = &[10, 20, 30, 40, 50];
    // Use each var's address — compiler must allocate slots for them
    // because their addresses are passed into the helper.
    // (Note: jhyy's `&` on a struct returns `*T` per struct ABI; pass
    // through `*Point` / `*Color` / `*MaybeInt`.)
    //
    // 2026-10-15:退出码改为**只由确定性的两项**推导 ——
    //   read_point(&p) = p.x + p.y = 10 + 20 = 30   (struct 字段经指针读)
    //   read_slice(s)  = s[0] + s[4]  = 10 + 50 = 60 (slice 下标)
    // 两者都不经过 enum match,所以不受 W-114 影响,每次跑结果都一样。
    //
    // enum 那两项(read_color / read_maybe)**故意不参与判定**:它们的输出依赖
    // 未初始化栈(见文件头),塞进断言就是拿垃圾内存当断言 —— 依赖随机值的断言会
    // 偶发假通过。W-114 的确定性门在 `enum_match_unit_variants.jhyy`。
    let pt = read_point(&p);
    let sl = read_slice(s);
    // enum 两个 helper 仍然调用(它们是 gdb pretty-printer 的覆盖对象,
    // 保持那段编译路径被走到),只是结果不参与判定。
    let c_code = read_color(&c);
    let m_code = read_maybe(&m);
    printf("p=%d c=%d m=%d s=%d\n" as *u8, c_code + m_code);
    if pt != 30 { return 1; }
    if sl != 60 { return 2; }
    if c_code < 0 { return 3; }
    if m_code < 0 { return 4; }
    return 0;
}