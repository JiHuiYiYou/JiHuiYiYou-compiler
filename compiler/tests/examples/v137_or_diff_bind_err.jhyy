// v1.3.7: OR pattern `Some(x) | Some(y)` should be rejected — must use same binding name
// v1.7.0 Stage 1: EXPECT-ERROR replaces descriptive comment.
// EXPECT-ERROR: "OR pattern"

type Option = enum { Some(i32), None }

fn main_jhyy() -> i32 {
    match Option::Some(42) {
        Option::Some(x) | Option::Some(y) => x + y,
        Option::None => 0,
    }
}
