// w229_fn_value_crash.jhyy — 台账 W-229:把**函数名当值**用
// (`let p = f;` / `g(f)`)过了 sema,但 IR 里 call 的实参槽是空的
//
// 修前(2026-11-15 实测):**编译器崩** ——
//   codegen_amd64_lexer: unknown QBE IL mnemonic at byte offset 26059
//   ⇒ 产物二进制还会在运行时爆栈(0xC00000FD)。
//
// 修后:sema 报一条干净的「函数值未实装」错误(规范附录 B:「`fn(...)`
// 函数指针类型未实装」⇒ 正确行为就是一条编译错误)。
//
// EXPECT-ERROR: "not supported"
fn handler(x: i32) -> i32 {
    return x + 1;
}

fn take(p: *u8) -> i64 {
    return p as i64;
}

fn main_jhyy() -> i32 {
    // 函数名当值赋给局部变量
    let p = handler;
    // 再把它当实参传出去(这一句以前就是崩编译器的那句)
    let v = take(p);
    return v as i32;
}
