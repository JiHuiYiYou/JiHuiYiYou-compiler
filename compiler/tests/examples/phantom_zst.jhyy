// [SKIP 移除 2026-10-15] v1.4.4 把 jhyy.exe flip 成 jhyy-side binary 后本理由失效 —— 2026-10-15 去掉 SKIP,实测 PASS
// v3.1.1 (V3-C 3g.5) ship-gate: PhantomData<T> ZST, sizeof==0, struct 内字段不占 layout.
//   per spec supplement v3.1.1 § 3: sizeof(PhantomData<T>) == 0 on all targets;
//   Wrapper { _marker: PhantomData<i32>, val: i32 } → sizeof == 4 (PhantomData 不占).
type Wrapper = struct {
    _marker: PhantomData<i32>,
    val: i32
}

fn main_jhyy() -> i32 {
    let s_pd: i64 = sizeof(PhantomData<i32>);
    if s_pd != 0 {
        return 10;
    }
    let s_pd64: i64 = sizeof(PhantomData<u64>);
    if s_pd64 != 0 {
        return 11;
    }
    let s_w: i64 = sizeof(Wrapper);
    if s_w == 4 {
        return 42;
    }
    return s_w as i32;
}
//EXPECT:42