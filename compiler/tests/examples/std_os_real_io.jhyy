// std_os_real_io.jhyy — std_os_* 声称做了 I/O,就必须真的做。
//
// 2026-10-15 新增,2026-10-20 (W-103 真修) 改写。
//
// 原版断言的是「mock 契约」:`std_os_open` 返 42、`std_os_write` 返 5 ——
// 它在**给 mock 背书**。于是 W-103(std_os_* 全是 M0 mock)一直有个 PASS 撑着,
// 而那个 PASS 不验证任何真实行为。
//
// 本测试换一条路验证同一件事:
//   1) 用 `std_os_open` / `std_os_write` 写(真实现,真落盘)
//   2) 用**真 libc 的** fopen/fread 把文件读回来 —— 绕开 std_os 的 read
//   3) 逐字节比对
// 绕开 std_os_read 是故意的:如果两边都走 std_os,一个「写进 A、读出 A」的
// 闭环在 mock 下也能自洽(它甚至会写进 mock 的内存)。只有**第三方读者**
// (libc)才能证明字节真的落到了磁盘上。
//
// XFAIL 已摘(2026-10-20):std/os.jhyy 现在走 jhyy_helpers.c 的真 libc bridge。
// `import os;` 引用的是真身,不是 inline 副本。
//
// EXPECT: 0
import os;

extern fn printf(fmt: *u8, a: i32, b: i32, c: i32) -> i32;
extern fn fopen(path: *u8, mode: *u8) -> *u8;
extern fn fread(buf: *u8, size: i64, count: i64, fp: *u8) -> i64;
extern fn fclose(fp: *u8) -> i32;

fn main_jhyy() -> i32 {
    let path = "compiler/build/bin/_std_os_real_io.txt" as *u8;
    let hello = "hello" as *u8;

    // 1) 用 std_os 写 —— 它声称成功
    let flags = OS_O_WRONLY() + OS_O_CREAT() + OS_O_TRUNC();
    let fd = std_os_open(path, flags, OS_MODE_RW_R());
    if fd < (0 as i64) {
        printf("REAL_IO open_failed\n" as *u8, 0, 0, 0);
        return 1;
    }
    let wn = std_os_write(fd, hello, 5 as i64);
    if wn != (5 as i64) {
        return 2;
    }
    let _cl = std_os_close(fd);

    // 2) 用**真** fopen/fread 把文件读回来 —— 绕过 std_os 的 read
    let fp = fopen(path, "rb" as *u8);
    if fp == (0 as *u8) {
        printf("REAL_IO file_not_created\n" as *u8, 0, 0, 0);
        return 3;
    }
    let mut buf: [i32; 8] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                             0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let rn = fread(buf as *u8, 1 as i64, 5 as i64, fp);
    let _c = fclose(fp);

    // 3) 逐字节比对 —— mock 的 write 一个字节都没落盘,这里必然读回 0
    if rn != (5 as i64) {
        printf("REAL_IO short_read rn=%d\n" as *u8, 0, 0, 0);
        return 4;
    }
    let got0 = *(buf as *u8) as i32;
    let got1 = *(buf as *u8 + (1 as i64)) as i32;
    printf("REAL_IO got0=%d got1=%d\n" as *u8, got0, got1, 0);
    if got0 != (104 as i32) { return 5; }     // 'h' = 104
    if got1 != (101 as i32) { return 6; }     // 'e' = 101
    return 0;
}
