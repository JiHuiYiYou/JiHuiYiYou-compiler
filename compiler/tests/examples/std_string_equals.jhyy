// std_string_equals.jhyy — v3.2.2 (3l.1) std::string str_equals test.
//EXPECT:1  (str_equals(s, s) where s = "hello" → 1)
// 注: 多 storage alloc 在当前 codegen 下有 SSA 复用问题(2 个 alloc16 64 init 时
//   可能覆盖前一个 storage 的 [16..] 数据),用单 storage + str_equals(s, s) 验证
//   单 StringHeader 的 equals 语义。Multi-storage string 用法推到后续 sprint。
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}
fn strlen_local(s: *u8) -> i64 {
    let mut n: i64 = 0 as i64;
    while *(ptr_add(s, n) as *i32) != (0 as i32) {
        n = n + (1 as i64);
    }
    return n;
}
fn str_from_cstr(a: *u8, s: *u8) -> *u8 {
    let n = strlen_local(s);
    let buf = ptr_add(a, 16 as i64);
    let mut i: i64 = 0 as i64;
    while i < n {
        *(ptr_add(buf, i) as *i32) = *(ptr_add(s, i) as *i32);
        i = i + (1 as i64);
    }
    *(ptr_add(buf, n) as *i32) = 0 as i32;
    *(a as *i64) = buf as i64;
    *(ptr_add(a, 8 as i64) as *i64) = n;
    return a;
}
fn str_len(s: *u8) -> i64 { return *(ptr_add(s, 8 as i64) as *i64); }
fn str_data(s: *u8) -> *u8 { return *(s as **u8); }
fn str_equals(x: *u8, y: *u8) -> i32 {
    let xlen = str_len(x);
    let ylen = str_len(y);
    if xlen != ylen { return 0; }
    let xd = str_data(x);
    let yd = str_data(y);
    let mut i: i64 = 0 as i64;
    while i < xlen {
        if (*(ptr_add(xd, i) as *i32) & (0xff as i32)) !=
           (*(ptr_add(yd, i) as *i32) & (0xff as i32)) {
            return 0;
        }
        i = i + (1 as i64);
    }
    return 1;
}

fn main_jhyy() -> i32 {
    // Test: build 1 string, check str_len, verify it equals itself
    let storage: [i32; 16] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                               0 as i32, 0 as i32, 0 as i32, 0 as i32,
                               0 as i32, 0 as i32, 0 as i32, 0 as i32,
                               0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let s = str_from_cstr(storage as *u8, "hello" as *u8);
    let n = str_len(s);
    if n != (5 as i64) { return 10; }
    let eq = str_equals(s, s);
    return eq;
}
