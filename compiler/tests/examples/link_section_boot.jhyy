// EXPECT: 0
//
// V3-B 3e ship gate test: #[link_section("name")] puts a function in a custom
// ELF section. We don't actually boot a kernel here (no OVMF in regress), so
// the test verifies:
//   1. link_section-annotated fn compiles
//   2. readelf shows the symbol in the custom section   ← **这条本文件不验**(见文件头)
//   3. main_jhyy returns 0 (EXIT:0)
//
// ⚠️ 本文件**仍只断言 `_start()` 返回 42** —— 它验不到 section 归属。
//   (section 归属在 `.s` 层面验:门 `artifact_checks.sh` 的 `link_section`
//    与 `link_section_build`,它们 grep 产物 .s 里的 `.section .text.boot`
//    及其归属的函数名。)
//
//   属性本身**已打通**:W-112(2026-10-20)修好 `compile` 路径,
//   W-170(2026-11-02)修好 `build` 路径 ⇒ 两条路径的 .s 逐字节相同。
//   人工复核命令(看 .s 而不是 exe —— exe 里能不能看到 .text.boot 取决于
//   链接器,不可靠):
//     grep -A2 '\.section .text.boot' <产物>.s
//
// Verifiable via:
//   readelf -S build/link_section_boot.exe | grep "\.text\.boot"   # ≥ 1 hit
//   readelf -s build/link_section_boot.exe | grep "_start"          # in .text.boot

#[link_section(".text.boot")]
fn _start() -> i32 {
    return 42 as i32;
}

fn main_jhyy() -> i32 {
    // _start 直接调用(不 boot 内核);断言它的返回值 —— 推导:_start 体是
    // `return 42`,所以 _x 必须是 42。这条能验「带 link_section 属性的
    // 函数体本身编得对、调用约定对」,但**验不到 section 归属**(见文件头)。
    let _x: i32 = _start();
    if _x == 42 {
        return 0 as i32;
    }
    return 1 as i32;
}