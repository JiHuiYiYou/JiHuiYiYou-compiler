//
// 7.0_f32 % 2.0_f32 fold 成 user-space formula polymorphic by tok.qbe_type:
//   div = 3.5_f32
//   stosi (NOT dtosi — QBE IL f32→i32 用 stosi) = 3
//   swtof = 3.0_f32
//   mul = 6.0_f32
