//
// vs f64 版本: conv_op 选 `stosi` (i32 QBE IL) 不是 `dtosi` (i64 QBE IL);
// per `feedback_jhyy_brace_nesting`, is_f32 nested plain `if` 无 `&&`/`||`
// short-circuit。

fn main_jhyy() -> i32 {
    let a: f32 = 7.0;
    let b: f32 = 2.0;
    let r: f32 = a % b;
    r as i32
}