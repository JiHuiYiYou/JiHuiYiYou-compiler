// ptr_arith_diff.jhyy — v1.7.0 Stage 2: spec §9.5 pointer diff 形式
// 期望 PASS (Stage 2 完成后); 当前会 FAIL (sema type mismatch)。
// NOTE: `d + 100i64` 而不是 `d + 100` — i32+i64 promotion 不在 v1.7 scope
// (per workarounds.md 已知限制 — spec §9.5 pointer arith 已有此限制).

fn main_jhyy() -> i32 {
    let arr: [i32; 4] = [10, 20, 30, 40];
    let p: *i32 = &arr[0];
    let q: *i32 = &arr[2];
    let d: i64 = q - p;          // 期望 (q - p) / sizeof(i32) = 2 (i64)
    let d2: i64 = d + 100i64;    // 期望 102 (强断言 d != 0)
    return d2 as i32;
}
// 2026-10-15 补断言: q - p 跨 2 个 i32 元素 = 字节距离 8,按元素数语义 = 2
// (文件头注释的既定意图);d2 = 2 + 100 = 102 → as i32 = 102.
// NOTE: spec §9.5 只定义了 `ptr + n`,**没写 `ptr - ptr` 的结果语义**
// (是否除以 sizeof(T)、结果类型)。这里的 102 依据是本文件 10/11 行注释的
// 既定意图,不是 spec 条文 —— 语义缺口已另行登记。
// EXPECT: 102
