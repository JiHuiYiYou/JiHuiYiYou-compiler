// EXPECT: 99
// v2.13.8 (W-058 RESOLVED): float fmod negative dividend test
//
// 验证 trunc (toward 0) semantics 跟 C fmod() / QBE remd spec 严格一致:
//   -7.5 / 2.0 = -3.75
//   trunc(-3.75) = -3   (toward 0; C fmod 使用 trunc)
//   -7.5 - (-3) * 2.0 = -7.5 + 6.0 = -1.5
//   (-1.5) as i32 = -1  (trunc cast)
//   r as i32 + 100 = 99 → exit(99) (避免 -1 被 Windows 误判为 NTSTATUS_0xFFFFFFFF
//   runtime crash; regress.py W-028 mod-256 之前 ntstatus_name() 先拒 0xFFFFFFFF)
//
// 对比 floor (toward -inf) 版本:
//   floor(-3.75) = -4
//   -7.5 - (-4) * 2.0 = -7.5 + 8.0 = 0.5
//   (0.5) as i32 = 0
//   0 + 100 = 100
// 若误用 floor 此 test EXIT=100 (误判); EXIT=99 即可区分 trunc vs floor。

fn main_jhyy() -> i32 {
    let a: f64 = -7.5;
    let b: f64 = 2.0;
    let r: f64 = a % b;
    let r_int: i32 = r as i32;
    r_int + 100
}