// EXPECT-ERROR: "integer literal out of range"
// W-186 / W-188: 越界的整数字面量必须**编译报错**,不能静默饱和。
//
// 修前:`strtoll` 按 C 标准**饱和到 LLONG_MAX**(errno = ERANGE,但没人看)
//   ⇒ `0x10000000000000000u64`(= 2⁶⁴)静默变成 9223372036854775807
//   ⇒ 用户完全不知道自己写错了(而且 u64 后缀在**值解析之后**才读 ⇒ 救不回来)。
// 修后:量值按 u64 精确求值,越界(≥ 2⁶⁴,或 i64 装不下)⇒ 编译报错。
//
// 覆盖三种越界:
//   - 2⁶⁴(任何 64 位整型都装不下)
//   - 2⁶³ 当成 i64(超出 i64 上界)
//   - -2⁶³-1 当成 i64(取负后仍超出 i64 下界)
//
// ⚠️ 注意:32 位族(无后缀默认 i32)今天仍是静默截断 —— 突然改成报错会砸掉
//   一批「能编译的程序」⇒ 本轮只查 64 位族。

fn main_jhyy() -> i32 {
    // 2⁶⁴:装不下任何 64 位整型
    let a: u64 = 0x10000000000000000u64;
    // 2⁶³:i64 装不下
    let b: i64 = 9223372036854775808i64;
    // -2⁶³-1:取负后仍超出 i64 下界
    let c: i64 = -9223372036854775809i64;
    return 0;
}
