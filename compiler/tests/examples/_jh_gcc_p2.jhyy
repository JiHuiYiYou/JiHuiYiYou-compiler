// SETENV: JHYY_HOME=C:\Users\liuzhen\Desktop\coding\JiHuiYiYou\compiler\tests\examples\_tmp_jhyy_home
// EXPECT: 1
//
// _jh_gcc_p2.jhyy — v1.5.6 jh_gcc_path() Priority 2 验证
//
// 验证: 设 JHYY_HOME 后, jh_gcc_path() 读 $JHYY_HOME/env.txt 里的 JHY_GCC=
// (Priority 2 命中).
//
// 设计 note: regress.py SETENV directive 只支持 env var 注入, 不能创建
// 文件. p2 测试需要手动 setup (一次性):
//   mkdir -p compiler/tests/examples/_tmp_jhyy_home
//   printf 'JHY_GCC=C:\\msys64\\ucrt64\\bin\\gcc.exe\\n' > \
//     compiler/tests/examples/_tmp_jhyy_home/env.txt
//
// env.txt 含真实存在路径 (magic 第 1 项 = ucrt64), 让 link 阶段能调 gcc.
// Priority 2 vs Priority 3 在本机无法严格区分 (env.txt 值跟 magic 第 1 项相同),
// 但能验证 Priority 2 探测链不挂.

extern fn jh_gcc_path() -> *u8;
extern fn strcmp(a: *u8, b: *u8) -> i32;
extern fn jh_fputs_stderr(s: *u8) -> i32;

fn main_jhyy() -> i32 {
    let detected = jh_gcc_path();
    let expected = "C:\\msys64\\ucrt64\\bin\\gcc.exe" as *u8;
    if strcmp(detected, expected) == (0 as i32) {
        return 1 as i32;
    }
    let msg = "[priority2 FAIL] detected != expected (env.txt or magic fallback)\n" as *u8;
    jh_fputs_stderr(msg);
    return 2 as i32;
}