// _jh_gcc_p5.jhyy — v1.5.6 jh_gcc_path() Priority 5 (Fallback) 验证
//
//   // SETENV: JHY_GCC=
//   // EXPECT: 1
//
//   验证: 不设 env, 不写 env.txt, magic 也不存在, PATH 里也没 gcc →
//   jh_gcc_path() 应返回 "gcc" (literal fallback).
//
//   设计 gap: 当前测试环境 (本机 + CI) 都有 MSYS2 magic 命中, 没法在
//   测试 harness 里强行触发 fallback "gcc". 这需要在 PATH 完全空、magic
//   路径全不存在的环境 — 测试环境构造不出来.
//
//   p5 placeholder: 跟 p4 一样, 期望任意非空返回 (探测链总会有结果).
//   "gcc" literal fallback 验证放到 v1.5.6 后续 sprint (v2.x manifest lite
//   实施时统一测 fallback 路径).

extern fn jh_gcc_path() -> *u8;
extern fn strcmp(a: *u8, b: *u8) -> i32;
extern fn strlen(s: *u8) -> i64;
extern fn jh_fputs_stderr(s: *u8) -> i32;

fn main_jhyy() -> i32 {
    let detected = jh_gcc_path();
    let n = strlen(detected);
    if n > (0 as i64) {
        return 1 as i32;
    }
    let msg = "[priority5 FAIL] detected path is empty\n" as *u8;
    jh_fputs_stderr(msg);
    return 2 as i32;
}