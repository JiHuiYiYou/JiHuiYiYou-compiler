// spec_shadowing.jhyy — spec §3:同名 let 建立新绑定覆盖旧的(shadowing)
//
// 2026-10-27(W-142 真修):本用例原先是 **XFAIL** —— 同作用域同名 `let` 让编译器
// 在 sema 阶段**空指针写崩溃**(0xC0000005 / ACCESS_VIOLATION)。
//
// 崩溃链(已逐行复核):
//   ① compiler/src0/parser.jhyy 的 `parse_let` 调 `symtab_insert`
//   ② compiler/src0/symtab.jhyy 的「同 scope 重名」分支 **返回 null**
//   ③ 于是 AST 节点的 sym 字段是 null
//   ④ compiler/src0/sema.jhyy 的 `(*sym).type_ptr = ...` 解引用 null ⇒ 崩
//
// 修法:同作用域同名 `let` ⇒ **shadowing** —— 新建一个 Sym **原地替换**哈希槽里
// 的旧条目(不复用旧指针)⇒ 表里这条名字只剩一条 ⇒ 后续按名查找拿到的就是**新**
// 绑定 ⇒ 两个同名 let 是两个不同的局部(各自一个栈槽)。
//
// ⚠ 语义参照是**嵌套作用域**的 shadowing(它一直是对的):新绑定覆盖旧的,
//   且**可以改变可变性**(两个方向都成立)。
//
// EXPECT: 0
fn main_jhyy() -> i32 {
    let mut fails: i32 = 0;

    // ① 同作用域 shadowing:新绑定覆盖旧的(读到的是**新**值)
    let x = 1;
    let x = 2;
    if x != 2 { fails = fails + 1; }

    // ② 可变性可以**放宽**:不可变 → 可变(shadow 之后可赋值)
    let z = 1;
    let mut z = 2;
    z = 3;
    if z != 3 { fails = fails + 2; }

    // ③ 嵌套作用域的 shadowing 不受影响(外层绑定保持原值)
    let outer = 7;
    if true {
        let outer = 8;
        if outer != 8 { fails = fails + 4; }
    }
    if outer != 7 { fails = fails + 8; }

    // ④ shadow 之后,名字的类型以**新**绑定的为准
    let t: i64 = 5i64;
    let t: f64 = 2.5;
    if t != 2.5 { fails = fails + 16; }

    // ⑤ 旧的绑定仍然占着自己的槽(不影响新绑定,但也不该串味)
    let u = 10;
    let u = 20;
    let v = u + u;
    if v != 40 { fails = fails + 32; }

    return fails;
}
