// W-128 回归门 —— `0o`(八进制)/ `0b`(二进制)整数字面量。
//
// 修复前:lexer 正确认出了前缀并按对应 base 扫完了数字(base 只活在
// lex_scan_number 的局部变量里,出了函数就丢),但**求值**一律走
// strtoll(base=0) —— 那是 C 的自动识别,只认 "0x" 与前导零(八进制),
// 不认 "0o"/"0b"(C23 / GCC 扩展)⇒
//     "0o77"   → strtoll 消费掉 '0' 后遇到 'o' 停下 ⇒ 静默得到 0
//     "0b1010" → 同理 ⇒ 静默得到 0
// 零诊断、零警告,只是值错了。
//
// 覆盖:0o / 0O / 0b / 0B 四种前缀 + 0x 十六进制 + 前导零八进制(C 语义)。
fn main_jhyy() -> i32 {
    let a: i32 = 0o77;      // 63
    let b: i32 = 0b1010;    // 10
    let c: i32 = 0xFF;      // 255
    let d: i32 = 077;       // 63(前导零 = 八进制,C 语义)
    let e: i32 = 0O17;      // 15
    let f: i32 = 0B1101;    // 13
    return a + b + c + d + e + f;   // 419
}
//EXPECT:419
