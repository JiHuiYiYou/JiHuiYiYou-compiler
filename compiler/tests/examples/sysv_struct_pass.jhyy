// SKIP: sysv target requires Linux host (WSL/Docker) — v2.7.0 Phase 2b wires
//   emit_call target-tag split but regress.py --cross=auto probe falls through
//   to --cross=none on Windows host without WSL/Docker. Real cross-env wire
//   ships in v2.7.1 (Linux ELF runtime + --cross wsl/docker sub-process).

type Pair = struct {
    a: i32,
    b: i32,
}

extern fn printf(fmt: *u8, val: i32) -> i32;

fn sum_pair(p: Pair) -> i32 {
    p.a + p.b
}

fn main_jhyy() -> i32 {
    let p = Pair { a: 10, b: 25 };
    let result = sum_pair(p);
    result  // 35
}