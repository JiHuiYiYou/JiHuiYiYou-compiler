// EXPECT: 0
// W-187: 有符号右移必须**补符号**(算术右移 `sar`),不是逻辑右移(`shr`)。
//
// 修前:`>>` 的 opcode 写死 `shr`(零填充)
//   ⇒ `-16 >> 2` 得 `1073741820`(0x3FFFFFFC)而不是 `-4`。
// 修后:opcode 表按**左操作数**的符号性选 `sar` / `shr`。
//
// ⚠️ **两条路径都要验**:
//   · 运行期:值经**函数调用**进来 ⇒ 走 `sar` / `shr` 指令;
//   · 编译期:模块级 `let` 的初始化器走常量折叠器(`cg_const_fold`)
//     ⇒ 折叠路径必须与运行期**逐位一致**。

fn mk32(v: i32) -> i32 {
    return v;
}

fn mk64(v: i64) -> i64 {
    return v;
}

fn mku(v: u32) -> u32 {
    return v;
}

// ── 编译期路径(常量折叠)────────────────────────────────────────
let mut g_s1: i32 = -16 >> 2;
let mut g_s2: i32 = -1 >> 31;
let mut g_s3: i64 = -16i64 >> 2i64;
let mut g_s4: i64 = -1i64 >> 63i64;
let mut g_s5: u32 = 4294967280u32 >> 3u32;
// 移位计数按**操作数宽度**掩(x86 语义:32 位移位把计数掩到 5 位 = 31)
//   ⇒ 计数 40 ⇒ 40 & 31 = 8 ⇒ `1024 >> 40` = 1024 >> 8 = 4
let mut g_s6: i32 = 1024 >> 40;
let mut g_s7: i32 = 1024 << 40;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // i32 负数右移(运行期值)
    let a: i32 = mk32(-16);
    let s1: i32 = a >> 2;
    if s1 != -4 { err = err + 1; }

    // i32 -1 >> 31 ⇒ -1
    let b: i32 = mk32(-1);
    let s2: i32 = b >> 31;
    if s2 != -1 { err = err + 2; }

    // i64 负数右移(运行期值)
    let c: i64 = mk64(-16i64);
    let s3: i64 = c >> 2i64;
    if s3 != -4i64 { err = err + 4; }

    // i64 -1 >> 63 ⇒ -1
    let d: i64 = mk64(-1i64);
    let s4: i64 = d >> 63i64;
    if s4 != -1i64 { err = err + 8; }

    // 正数右移不变
    let e: i32 = mk32(64);
    let s5: i32 = e >> 3;
    if s5 != 8 { err = err + 16; }

    // u32 仍是逻辑右移:0xFFFFFFF0 >> 3 = 536870910
    let f: u32 = mku(4294967280u32);
    let s6: u32 = f >> 3u32;
    if s6 != 536870910u32 { err = err + 32; }

    // ── 编译期路径(常量折叠)──
    if g_s1 != -4 { err = err + 64; }
    if g_s2 != -1 { err = err + 128; }
    if g_s3 != -4i64 { err = err + 256; }
    if g_s4 != -1i64 { err = err + 512; }
    if g_s5 != 536870910u32 { err = err + 1024; }

    // ── 移位计数按**操作数宽度**掩(32 位 ⇒ 掩 5 位 = 31)──
    // 立即数计数
    let j1: i32 = mk32(1024);
    let w1: i32 = j1 >> 40;
    if w1 != 4 { err = err + 2048; }
    let w2: i32 = j1 << 40;
    if w2 != 262144 { err = err + 4096; }
    // 寄存器计数(变量移位量)—— 走 `movl …,%ecx` + `sarl %cl,…` 那条路
    let shamt: i32 = 40;
    let w3: i32 = j1 >> shamt;
    if w3 != 4 { err = err + 8192; }
    // 折叠路径必须给出**同一个**值
    if g_s6 != 4 { err = err + 16384; }
    if g_s7 != 262144 { err = err + 32768; }

    return err;
}
