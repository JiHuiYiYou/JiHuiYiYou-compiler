// SKIP: v3.2.0c — generic fn call-site inference (3i fn path; dropped after C5 verification)
// v3.2.0c (3i fn path) ship-gate test: call-site type inference `max(3, 5)`
// when generic fn max<T> defined; no turbofish required.
//
// Per spec supplement v3.2.0c § 3 (to be added):
//   - infer_type NODE_CALL 看到 callee 是 generic fn sym 时,触发
//     mono_expand_fn_call,根据 args 类型推断 T = i32 → monomorphize max<i32>
//   - Replaces (or supplements) turbofish path
//
// Expected: monomorphized max<i32> called, returns 5, EXIT=42.

fn max<T>(a: T, b: T) -> T {
    if a > b { return a; }
    return b;
}

fn main_jhyy() -> i32 {
    // call-site inference: T inferred as i32 from args (3, 5)
    let mi: i32 = max(3, 5);
    if mi != 5 {
        return 10;
    }
    // call-site inference: T inferred as i64 from args (10, 20)
    let ml: i64 = max(10 as i64, 20 as i64);
    if ml != 20 {
        return 20;
    }
    return 42;
}
//EXPECT:42
