// spec_argc_argv.jhyy — spec §1.1:入口可带 argc / argv
//
// 覆盖缺口(2026-10-26 lang-spec 覆盖审计):spec §1.1 明写「入口的真实签名是
// `main_jhyy(argc: i32, argv: *u8) -> i32`;argc / argv 是可选的」—— 但回归套件
// 里**所有**用例都写的是无参 `fn main_jhyy() -> i32`。带参入口这条路径
// (以及 harness 传参)零覆盖。
//
// 断言:argc ≥ 1(程序名本身算一个)、argv 非空。
//
// EXPECT: 0
fn main_jhyy(argc: i32, argv: *u8) -> i32 {
    let mut fails: i32 = 0;

    // argc ≥ 1(可执行文件名本身)
    if argc < 1 { fails = fails + 1; }

    // argv 指针非空
    if argv == (0 as *u8) { fails = fails + 1; }

    // argv[0](程序名)非空指针
    //
    // ⚠ 必须 cast 成 **u8 再解引用(2026-10-27 真修):
    //   argv 的类型是 `*u8`(spec §1.1 的入口签名),**直接 `*argv` 只 load 1 个字节**
    //   (生成的 IL 是 `loadub`)—— 那是 argv[0] **指针的最低字节**,不是指针本身。
    //   ⇒ 断言会退化成「堆地址最低字节 != 0」这种**跟堆布局绑定**的假信号:
    //   环境变量(PATH)一变 ⇒ 堆基址偏移 ⇒ 最低字节恰好为 0 ⇒ 假红。
    //   2026-10-27 CI 上就是这样炸的(PATH 追加了一段 ⇒ EXIT=1,本地复现)。
    //   正确写法:先 `argv as **u8`,再解引用 ⇒ 取满 8 字节的指针。
    let argv0 = *(argv as **u8);
    if argv0 == (0 as *u8) { fails = fails + 1; }

    return fails;
}
