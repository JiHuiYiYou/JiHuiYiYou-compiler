// null_ret.jhyy — v1.3.1 `return null` in pointer-returning function
// Tests NODE_RETURN context-fill: null fills from ctx->current_ret_type.

fn returns_null() -> *u8 {
    return null;           // fills *u8 from current_ret_type
}

fn main_jhyy() -> i32 {
    let p: *u8 = returns_null();
    if p == null {
        return 0;          // EXPECT: 0 (returns_null gives us null)
    }
    return 1;              // not reached
}