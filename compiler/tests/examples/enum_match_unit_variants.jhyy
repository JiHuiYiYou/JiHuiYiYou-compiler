// enum_match_unit_variants.jhyy — 全 unit-variant 的 enum 必须做真 tag dispatch。
//
// 2026-10-15 新增,作为 W-114 的**确定性**门。
//
// 为什么不拿 `gdb_pretty_test` 当那道门:它的输出依赖未初始化栈
// (printf 之外的若干值读的是垃圾寄存器),所以它在 XFAIL 与 XPASS 之间随机
// 摇摆 —— 实测连续三次输出分别是:
//     p=90 c=67107264   m=1 s=67099120
//     p=90 c=2105539584 m=1 s=2105531440
//     p=90 c=-731907680 m=1 s=-731915824
// 偶尔凑巧等于 133 就**假通过**。依赖垃圾内存的断言不是断言。
//
// 本测试只做确定性的 enum match,逐个变体断言,不同变体必须给出不同结果
// ——「恒取第一臂」恰好能骗过「只断言一个非第一臂的值」。
type Unit3 = enum { A, B, C }
type Pay1N = enum { S(i32), N }

fn u3(v: Unit3) -> i32 { return match v { Unit3::A => 0, Unit3::B => 1, Unit3::C => 2 }; }
fn pn(v: Pay1N) -> i32 { return match v { Pay1N::S(x) => 100 + x, Pay1N::N => 200 }; }
fn mx(v: Mix) -> i32 { return match v { Mix::X => 10, Mix::Y(y) => 20 + y, Mix::Z => 30 }; }
type Mix = enum { X, Y(i32), Z }

// 返回 enum 的函数 —— 2026-10-20 之前 enum 的返回是「callee 自己帧里那个
// 槽的地址」,函数一返回就悬垂(下一个函数的序言会盖掉它)。
// 现在走 sret(ABI § 3.3):caller 出目标槽,callee 拷 image 进去。
fn mk_u3() -> Unit3 { return Unit3::B; }
fn mk_pn() -> Pay1N { return Pay1N::S(7); }

// enum 存在 struct 字段里
type WithE = struct { e: Unit3, x: i32 }
fn get_e(s: WithE) -> i32 { return match s.e { Unit3::A => 0, Unit3::B => 1, Unit3::C => 2 }; }

fn main_jhyy() -> i32 {
    // 全 unit variant:三个必须给出三个不同的值
    if u3(Unit3::A) != 0 { return 1; }
    if u3(Unit3::B) != 1 { return 2; }
    if u3(Unit3::C) != 2 { return 3; }
    // 有 payload 的 enum:正常(用来证明 bug 只在「全 unit」时发生)
    if pn(Pay1N::N) != 200 { return 4; }
    if pn(Pay1N::S(5)) != 105 { return 5; }
    // 混合形状:第一个臂带 payload,后面两个 unit
    if mx(Mix::Z) != 30 { return 6; }
    // 跨函数返回的 enum:返回值不能悬垂
    if u3(mk_u3()) != 1 { return 7; }
    if pn(mk_pn()) != 107 { return 8; }
    // enum 存在 struct 字段里
    if get_e(WithE { e: Unit3::C, x: 7 }) != 2 { return 9; }
    return 0;
}

// 2026-10-20(W-114 真修):XFAIL 标记已摘 —— 全 unit-variant 的 enum `match`
//   现在做**真 tag dispatch**。
//
//   根因不是「match 不做 tag 检查」,而是 **enum 的 ABI 两侧不一致**:
//   jhyy 的 enum 值 = 「指向一个槽的地址」(槽里是 [tag|padding|payload],
//   ABI § 2.6 / § 4.1),caller 传的**就是那个地址**;而 callee 侧把
//   size ≤ 4 的 enum 按 **QBE_W(按值)** 收 → 两边对同一参数的寄存器归属
//   理解不一致 → tag 比较永远不成立 → 恒命中第一支。
//
//   修法(见台账 W-104 同款「先定表示、再统一两侧」的思路):
//   ① `abi_win_classify_arg` 对 enum 一律返回 QBE_L(地址)—— 参数与返回值
//      共用它,四处调用点(Win header / SysV header / 返回类型 / callee 的
//      param 局部)一次改齐。
//   ② enum 的**返回值改走 sret**(ABI § 3.3 明写「struct / enum → 隐式
//      sret 指针参数返回」)。之前是「返回 callee 自己帧里那个槽的地址」,
//      函数一返回就悬垂 —— 实测 `arm(mk())` 里 arm 的序言把 mk 的槽整个盖掉
//      → tag 读成 0。sret 由 caller 出目标槽,callee 拷 image 进去。
//   ③ enum 的**调用结果**是 8 字节指针,不是 4 字节 tag
//      (`cg_value_type_of`)—— 之前只存 %rax 的低 4 字节 → 地址被截断。
//
// EXPECT: 0
