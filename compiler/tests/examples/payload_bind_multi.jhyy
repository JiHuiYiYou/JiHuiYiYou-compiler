// EXPECT: 1234
// v1.7.3 patch A5: enum variant 不同 payload type variety
//
// spec §D.7 限制: enum variant 仅支持单 payload, multi-payload `P(T, T)` parser
// 拒绝 (推 v3.x); pattern 仅支持单 binding, multi binding `Pair(a, b)` parser
// 拒绝 (推 v3.x)。
//
// v1.7.3 ship 期间 fact-check 误判 W-060 (EXIT=210 vs EXPECT=1234): 实为 bash `$?`
// 8-bit truncation (1234 & 0xFF = 210) + Windows `subprocess.run` 同步 8-bit
// truncate → regress.py W-028 mod-256 fix (line 243-263) 已 equalize 比較.
// v1.8.0 Phase 1 调查确认 W-060 = ❌ INVALID (test artifact, 非真 bug).

type Mixed = enum { I(i32), S(*u8), B(bool) }

fn main_jhyy() -> i32 {
    let m: Mixed = Mixed::I(1234);
    return match m {
        Mixed::I(v) => v,
        Mixed::S(_) => -1,
        Mixed::B(_) => -2,
    };
}