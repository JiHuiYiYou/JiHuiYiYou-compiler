type Mixed = enum { I(i32), S(*u8), B(bool) }

fn main_jhyy() -> i32 {
    let m: Mixed = Mixed::I(1234);
    return match m {
        Mixed::I(v) => v,
        Mixed::S(_) => -1,
        Mixed::B(_) => -2,
    };
}