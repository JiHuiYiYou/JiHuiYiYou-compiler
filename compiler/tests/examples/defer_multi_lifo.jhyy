// v1.7.3 patch A2 (deferred to v1.8): defer 多 defer LIFO 顺序断言
//
// v1.8.0 fix: defer Go-style 语义保留 (per spec §D.6 — defer 在 cg_return 前
//   emit, return value 在 defer 前 capture). 3 defer 顺序调用 bump(100/10/1),
//   LIFO 跑后 g_counter = 111, 但 `return g_counter` 在 defer 前 evaluate →
//   返回 0 (initial g_counter). 验证 LIFO 调用顺序通过 g_counter 的副作用
//   (test inspection: g_counter post-defers = 111 — 需调试器观察; 本 test
//   只验证 return value = 0 反映 Go-style defer).
// EXPECT: 0

let mut g_counter: i32 = 0;

fn bump(v: i32) -> i32 {
    g_counter = g_counter + v;
    return 0;
}

fn main_jhyy() -> i32 {
    defer bump(1);
    defer bump(10);
    defer bump(100);
    return g_counter;
}