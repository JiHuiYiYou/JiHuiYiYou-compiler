// spec_ptr_float_cast.jhyy — spec §4.3:浮点 ↔ 指针的转换语义
//
// 2026-10-26:这是 lang-spec 覆盖审计挖出的**语义缺口**(台账 W-143)的回归门。
// XFAIL 标记已摘(留着会让 regress 报 XPASS)。
//
// 语义(用户 2026-10-26 拍板):**数值转换** —— 不是位重解释、不是解引用。
//   · `x as *T` ≡ **饱和**转成 64 位无符号整数 → 当地址
//     (NaN → 0;x < 0 → 0;x ≥ 2^64 → u64::MAX;区间内向 0 截断)
//   · `p as f64` ≡ 地址当 64 位**无符号**整数 → 数值转浮点
//     (整数→浮点是 roundTiesToEven,只可能丢精度;**不涉及饱和** ⇒ 不对称化)
//
// 修前的症状:浮点→指针走裸 cvttsd2si(数值截断);指针→浮点**一条指令都不发**
// ⇒ 结果 temp 的 qbe_type 仍是 'l' ⇒ 流进 f64 形参时 caller 放整数寄存器 /
// callee 读 XMM ⇒ **ABI 寄存器类错配**。
//
// EXPECT: 0
fn main_jhyy() -> i32 {
    let mut fails: i32 = 0;

    // ① 判定性往返:1.0 → 指针 → f64 ⇒ 1.0
    let one: f64 = 1.0;
    let p1: *i64 = one as *i64;
    let back1: f64 = p1 as f64;
    if back1 != 1.0 { fails = fails + 1; }

    // ② 区间内:1.5 → 1(向 0 截断)
    let half: f64 = 1.5;
    let p2: *i64 = half as *i64;
    if (p2 as i64) != 1 { fails = fails + 1; }

    // ③ 负数 → 0(饱和到下界)
    let neg: f64 = 0.0 - 1.5;
    let p3: *i64 = neg as *i64;
    if (p3 as i64) != 0 { fails = fails + 1; }

    // ④ NaN → 0(饱和)
    let zero: f64 = 0.0;
    let nan: f64 = zero / zero;
    let p4: *i64 = nan as *i64;
    if (p4 as i64) != 0 { fails = fails + 1; }

    // ⑤ 指针 → 浮点:地址当 u64 的数值(不是 0,也不是位重解释)
    let x: i64 = 12345;
    let q: *i64 = &x;
    let as_f: f64 = q as f64;
    if as_f <= 0.0 { fails = fails + 1; }
    // 同一个地址的两种读法应一致(u64 → f64)
    let addr: u64 = q as u64;
    let d: f64 = as_f - (addr as f64);
    if d > 1.0 { fails = fails + 1; }
    if d < 0.0 - 1.0 { fails = fails + 1; }

    return fails;
}
