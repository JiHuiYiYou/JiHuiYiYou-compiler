// spec_ptr_float_cast.jhyy — spec §4.3:浮点 ↔ 指针应当是**按位重解释**
//
// ⚠️ 这是 2026-10-26 lang-spec 覆盖审计挖出的**实现缺口**,不是普通缺口。
//
// spec §4.3 的转换表里写着「浮点 ↔ 指针 ✅(**按位重解释**)」,但实测两头都
// 不成立(2026-10-26):
//
//   浮点 → 指针:`let x: f64 = 1.5; let b: *i64 = x as *i64;`
//           实测 b == 1 ⇒ 走的是**数值截断**,不是位模式
//           (1.5 的 IEEE 754 位模式应是 0x3FF8000000000000)。
//
//   指针 → 浮点:`b as f64` 实测得 **0** —— 既不是地址(1.0)也不是位模式
//           回读的 1.5 ⇒ **静默算错值**(指针的值根本没被读到)。
//
// 本用例按 **spec 的承诺**(按位重解释)写断言,当前实现两条都达不到 ⇒ XFAIL。
// 修好后本用例 XPASS ⇒ suite 失败 ⇒ 强制有人摘标记。
//
// 台账:**W-143**
//
// EXPECT: 0
// XFAIL: W-143 浮点↔指针没按位重解释(浮点→指针走数值截断;指针→浮点得 0)
fn main_jhyy() -> i32 {
    let mut fails: i32 = 0;

    // 1.5 的 IEEE 754 double 位模式 = 0x3FF8000000000000
    let x: f64 = 1.5;
    let b: *i64 = x as *i64;

    // 浮点 → 指针:按位重解释 ⇒ 低 64 位就是 0x3FF8000000000000
    if (b as i64) != 0x3FF8000000000000 as i64 { fails = fails + 1; }

    // 指针 → 浮点:按位重解释 ⇒ 回读得到原来的 1.5
    let back: f64 = b as f64;
    if back != 1.5 { fails = fails + 1; }

    return fails;
}
