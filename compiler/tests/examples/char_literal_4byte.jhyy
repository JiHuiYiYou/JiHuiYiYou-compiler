// EXPECT: 0
// v3.0.6/Ph.1 W-057 真修 — UTF-8 4-byte emoji codepoint char literal fold
//
// `decode_char_literal` 加 4-byte UTF-8 decode 分支 (U+10000-U+10FFFF
// per RFC 3629) now ships. codegen 路径不变 — parser 把 char codepoint
// → ast_new_int(PRIM_I32), 走 NODE_INT emit.
//
// v1.7.0 Stage 3 显式 lex reject (workarounds.md W-057 DEFERRED since 2026-08-28).
// v3.0.6 真修: 4-byte `🎉` (U+1F389 = 127881), UTF-8 bytes: F0 9F 8E 89.

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 4-byte emoji codepoint ──
    let c_tada: i32 = '🎉';   // U+1F389 = 127881, UTF-8: F0 9F 8E 89
    if c_tada != 0x1F389 { err = err + 1; }

    // Verify it's distinct from 3-byte CJK range
    let c_ni: i32 = '你';        // U+4F60 = 20320
    if c_tada - c_ni != 127881 - 20320 { err = err + 1; }

    err
}