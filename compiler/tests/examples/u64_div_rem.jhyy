// EXPECT: 0
// W-185②(u64 面): `u64 / u64` 与 `u64 % u64` 必须按**无符号**语义算。
//
// 修前:opcode 表写死 `div` / `rem`(有符号)
//   ⇒ `u64::MAX / 2` 得 `-1`(位模式 0xFFFF...FFFF)而不是 9223372036854775807。
// 修后:按**左操作数**的符号性选 `udiv` / `urem`。
//
// ⚠️ **两条路径都要验**:
//   · 运行期:值经**函数调用**进来 ⇒ 走 `udiv` / `urem` 指令;
//   · 编译期:模块级 `let` 的初始化器走常量折叠器(`cg_const_fold`)
//     ⇒ 折叠路径必须与运行期**逐位一致**。

fn mk64(v: u64) -> u64 {
    return v;
}

// ── 编译期路径(常量折叠)────────────────────────────────────────
let mut g_q: u64 = 18446744073709551615u64 / 2u64;
let mut g_r: u64 = 18446744073709551615u64 % 2u64;
let mut g_r2: u64 = 12450903817181746015u64 % 1000u64;
let mut g_q3: i64 = -7i64 / 2i64;
let mut g_r3: i64 = -7i64 % 2i64;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // u64::MAX / 2 ⇒ 9223372036854775807(有符号语义会得 -1)
    let a: u64 = mk64(18446744073709551615u64);
    let b: u64 = mk64(2u64);
    let q: u64 = a / b;
    if q != 9223372036854775807u64 { err = err + 1; }
    let r: u64 = a % b;
    if r != 1u64 { err = err + 2; }

    // 高位非极限值:0xacca7f0dd3ac535f / 1000
    let c: u64 = mk64(12450903817181746015u64);
    let d: u64 = mk64(1000u64);
    let q2: u64 = c / d;
    if q2 != 12450903817181746u64 { err = err + 4; }
    let r2: u64 = c % d;
    if r2 != 15u64 { err = err + 8; }

    // 有符号 i64 仍按**有符号**语义(向零截断)
    let e: i64 = -7i64;
    let f: i64 = 2i64;
    let q3: i64 = e / f;
    if q3 != -3i64 { err = err + 16; }
    let r3: i64 = e % f;
    if r3 != -1i64 { err = err + 32; }

    // ── 编译期路径(常量折叠)──
    if g_q != 9223372036854775807u64 { err = err + 64; }
    if g_r != 1u64 { err = err + 128; }
    if g_r2 != 15u64 { err = err + 256; }
    if g_q3 != -3i64 { err = err + 512; }
    if g_r3 != -1i64 { err = err + 1024; }

    return err;
}
