// spec_int_to_float.jhyy — spec §4.3:整数 → 浮点 的**全部 8 个**组合
//
// 2026-10-26(W-149 真修):整数→浮点转换的矩阵门。
//
// 修前的症状(2026-10-26 实测,失败位掩码 = 234 = 2|8|32|64|128):
//
//   ① **u64 → f64 走的是有符号转换** —— 前端一律发 `sltof`(i64→f64 有符号)
//      ⇒ 值 ≥ 2^63 变**负数**。
//      (后端的 `ultof`(u64→f64)早就写好了,W-146 还把它的算法修对了,
//       但前端从来没发过它 ⇒ 那条修复对 u64→f64 是**死代码**。)
//
//   ② **f32 目标拿到的是 f64** —— 后端四个 tof op 里只有 `swtof` 会按目标槽
//      在 cvtsi2ss/cvtsi2sd 之间切,另外三个恒产 f64
//      (见 compiler/src0/codegen_amd64_state.jhyy 的 ILTOK_* 注释)
//      ⇒ 旧表给 f32 目标发 `ultof`/`uwtof` ⇒ **f64 的位模式塞进 f32 槽**
//      ⇒ 读出来是垃圾。⇒ i32→f32 / u32→f32 / i64→f32 / u64→f32 **四个全错**。
//
// 修法(compiler/src0/codegen.jhyy 的 cg_convert_arg):
//   · 按**源类型的 prim** 判符号性 ⇒ 无符号源发 `ultof`(u64→f64)/ `uwtof`(u32→f64)
//   · f32 目标统一「先转 f64,再 truncd」(那四个 op 在本后端恒产 f64)
//
// ⚠ `18446744073709551615u64` 字面量本身有**已知限制**(会被解析成 i64 max,
//   见 spec_int_suffix_i16_u64.jhyy 头部注释)⇒ ≥ 2^63 的 u64 值一律**运行时算**。
// ⚠ f32 尾数只有 24 位 ⇒ 2^24 以上的整数在 f32 里**不精确** ⇒ u32→f32 用
//   2^24 断言(4000000000 在 f32 里会被舍入 ⇒ 拿它断言会误判)。
//
// EXPECT: 0
fn main_jhyy() -> i32 {
    let mut fails: i32 = 0;

    // ── i32 → f64 ──
    let a1: i32 = -5;
    let b1: f64 = a1 as f64;
    if b1 != -5.0 { fails = fails + 1; }

    // ── i32 → f32 ──
    let a2: i32 = -5;
    let b2: f32 = a2 as f32;
    if b2 != -5.0 { fails = fails + 2; }

    // ── u32 → f64(4000000000 在 f64 里精确)──
    let a3: u32 = 4000000000u32;
    let b3: f64 = a3 as f64;
    if b3 != 4000000000.0 { fails = fails + 4; }

    // ── u32 → f32(2^24 = 16777216 是 f32 里精确的整数)──
    let a4: u32 = 16777216u32;
    let b4: f32 = a4 as f32;
    if b4 != 16777216.0 { fails = fails + 8; }

    // ── i64 → f64 ──
    let a5: i64 = -5i64;
    let b5: f64 = a5 as f64;
    if b5 != -5.0 { fails = fails + 16; }

    // ── i64 → f32 ──
    let a6: i64 = -5i64;
    let b6: f32 = a6 as f32;
    if b6 != -5.0 { fails = fails + 32; }

    // ── u64 → f64(2^63,运行时算)──
    let a7: u64 = 9223372036854775807u64 + 1u64;
    let b7: f64 = a7 as f64;
    if b7 != 9223372036854775808.0 { fails = fails + 64; }

    // ── u64 → f32(2^63 是 f32 里精确的整数)──
    let a8: u64 = 9223372036854775807u64 + 1u64;
    let b8: f32 = a8 as f32;
    if b8 != 9223372036854775808.0 { fails = fails + 128; }

    // ── f32 → f64 回读(exts 路径;顺带覆盖 f32 槽的读回)──
    let c1: f32 = 1.5;
    let c2: f64 = c1 as f64;
    if c2 != 1.5 { fails = fails + 256; }

    // ── 窄宽度(u8/u16/i8/i16)→ 浮点 ──
    //
    // 这四条走的是 **'w' 槽** 那条路(值是 loadub/loaduh 零扩展进 4 字节槽)
    // ⇒ 发的是 `swtof` / **`uwtof`** —— 而 `uwtof` 在 W-145 之前是**死 op**
    // (IL lexer 没有 'u' 分支)⇒ 这几条是 W-145 的**载荷覆盖**。
    let d1: u8 = 255u8;
    let e1: f64 = d1 as f64;
    if e1 != 255.0 { fails = fails + 512; }

    let d2: u16 = 65535u16;
    let e2: f64 = d2 as f64;
    if e2 != 65535.0 { fails = fails + 1024; }

    let d3: i8 = -5i8;
    let e3: f64 = d3 as f64;
    if e3 != -5.0 { fails = fails + 2048; }

    let d4: i16 = -5i16;
    let e4: f64 = d4 as f64;
    if e4 != -5.0 { fails = fails + 4096; }

    let d5: u8 = 255u8;
    let e5: f32 = d5 as f32;
    let e5d: f64 = e5 as f64;
    if e5d != 255.0 { fails = fails + 8192; }

    let d6: u16 = 65535u16;
    let e6: f32 = d6 as f32;
    let e6d: f64 = e6 as f64;
    if e6d != 65535.0 { fails = fails + 16384; }

    return fails;
}
