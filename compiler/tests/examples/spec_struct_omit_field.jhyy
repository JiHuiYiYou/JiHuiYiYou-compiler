// spec_struct_omit_field.jhyy — spec §8:构造 struct 时允许省略字段
//
// 覆盖缺口(2026-10-26 lang-spec 覆盖审计):spec §8 明写「构造时允许省略字段,
// 缺失字段静默取默认值(0)。编译器不报「缺字段」错误」—— 这条行为零覆盖。
// 哪天编译器开始报缺字段错误,没人知道。
//
// ⚠️ **审计同时发现 spec §8 的措辞与实现不符(2026-10-26)**:
//   spec 原文说「缺失字段静默取默认值(**0**)」,但实测省略字段拿到的是
//   **未初始化的栈垃圾**,不是 0。
//   证据:毒化栈(先用一个函数把栈槽填成 0xAA)之后,
//         `P { x: 1 }` 的 y 读到 0、z 读到 -850123392 —— 每次跑都可能不同。
//   ⇒ 「默认 0」这句是**未经实测的断言**(新栈帧恰好是 0 时会看起來正确)。
//   本用例因此**不断言省略字段的值**(那是未定义行为),只断言:
//     ① 省略字段**不报编译错误**(spec §8 的核心承诺)
//     ② **显式给出**的字段值正确
//   spec §8 的措辞已同步修正(见 docs/abis/jhyy-lang-spec-v4.0.0.md)。
//
// EXPECT: 0
type P = struct {
    x: i32,
    y: i32,
    z: i32,
}

fn main_jhyy() -> i32 {
    let mut fails: i32 = 0;

    // ── 省略 y / z:编译通过(不报「缺字段」错误)──
    // 本文件能编过本身就是断言①:哪天编译器开始拒绝省略字段,这里就红。
    let p = P { x: 1 };
    // 显式给出的字段必须正确
    if p.x != 1 { fails = fails + 1; }
    // 省略的字段**不检查值**(未定义读;spec 措辞已修正)

    // ── 省略全部字段:同样编译通过 ──
    let q = P { };
    // 全是省略字段 ⇒ 没有任何可断言的值;这里只保证不崩(走到下面即通过)

    // ── 全字段给定时不受影响 ──
    let r = P { x: 7, y: 8, z: 9 };
    if r.x != 7 { fails = fails + 1; }
    if r.y != 8 { fails = fails + 1; }
    if r.z != 9 { fails = fails + 1; }

    // ── 省略字段的 struct 仍可按值传递 / 比较布局 ──
    let s = p;
    if s.x != 1 { fails = fails + 1; }

    return fails;
}
