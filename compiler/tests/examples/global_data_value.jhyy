// EXPECT: 0
// W-191: 模块级整型全局的初值在 amd64 后端的 **IL 数据段**里被截断 / 拒绝。
//
// 修前两个洞(都在 `compiler/src0/codegen_amd64_lexer.jhyy` 的 `next_token_data_string`):
//
//   ① **位数上限 16** —— u64 的 19~20 位数值被切断:
//        data $g = { l 9223372036854775807 }
//        ⇒ .quad 9223372036854775, 807        ← **静默错值**
//      (全局拿到的是错的数,而且符号后还多出一个元素 —— 汇编器不报错!)
//
//   ② **负号** —— i64 / u64 全局**没有截断**(codegen 只截 i8/u8/i16/u16/i32/u32)
//      ⇒ 负值原样带 '-' 落地:
//        data $g = { l -5 }
//      ⇒ 数据段解析器只认「数字开头」⇒ '-' 落到「字符串形式」⇒
//        硬报错「unknown QBE IL mnemonic」⇒ **合法代码编译不过**。
//
// ⚠️ 这两条在 HEAD 上就能复现(**不是**本轮引入的)——
//   「模块级 u64 全局 + 大数值」这条路径一直没人走过;
//   本轮给 W-186 / W-188 补 64 位常量的回归用例时撞出来的。
//
// 覆盖:
//   · u64::MAX(20 位,位模式是 -1)
//   · 19 位的 u64 / 十六进制 u64
//   · 负的 i64 / i64::MIN
//   · 负的 i32(i32 全局走掩码 ⇒ 一直是正的 ⇒ 本来就没事,这里做对照)

let mut g_u64max: u64 = 18446744073709551615u64;
let mut g_u64big: u64 = 9223372036854775807u64;
let mut g_u64hex: u64 = 0xacca7f0dd3ac535fu64;
let mut g_i64neg: i64 = -5i64;
let mut g_i64min: i64 = -9223372036854775808i64;
let mut g_i32neg: i32 = -7;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // u64::MAX:20 位 + 位模式是负 ⇒ 同时踩中 ① 和 ②
    if g_u64max != 18446744073709551615u64 { err = err + 1; }

    // 19 位的 u64 ⇒ 只踩中 ①
    if g_u64big != 9223372036854775807u64 { err = err + 2; }

    // 十六进制的高位 u64
    if g_u64hex != 12450903817181746015u64 { err = err + 4; }

    // 负的 i64 ⇒ 只踩中 ②
    if g_i64neg != -5i64 { err = err + 8; }

    // i64::MIN
    if g_i64min != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 16; }

    // 负的 i32(i32 全局按掩码落地 ⇒ 本来就没事 —— 对照组)
    if g_i32neg != -7 { err = err + 32; }

    return err;
}
