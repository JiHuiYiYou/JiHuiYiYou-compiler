// std_os_basic.jhyy — v3.2.3 (3l.2) std::os basic test.
// 5 sub-test:open validation + close + read/write + exit + getenv
//EXPECT:0

// 注:per v3.2.2 W-076 + std lib plan,test inline 副本用 std_os_* 前缀 fn 名字
// 避免符号冲突。 std/os.jhyy public API 等价此 inline 副本。M0 stub 模式
// (per W-079):open / read / write / close 验证 args + 返 mock 值,不接 libc。
// jh_getenv 是唯一走的 extern(pointer return → QBE OK pattern)。

extern fn jh_getenv(name: *u8) -> *u8;

// ════════════════════════════════════════════════════
// ptr_add — 本地指针算术 helper
// ════════════════════════════════════════════════════
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}

// ════════════════════════════════════════════════════
// std_os_* — std/os.jhyy inline 副本 (M0 stub)
// ════════════════════════════════════════════════════

// POSIX open flag constants
fn OS_O_RDONLY() -> i32 { return 0 as i32; }
fn OS_O_WRONLY() -> i32 { return 1 as i32; }
fn OS_O_RDWR()   -> i32 { return 2 as i32; }
fn OS_O_CREAT()  -> i32 { return 64 as i32; }
fn OS_O_TRUNC()  -> i32 { return 512 as i32; }
fn OS_O_APPEND() -> i32 { return 1024 as i32; }

fn OS_MODE_RW_R() -> i32 { return 420 as i32; }

fn std_os_open(path: *u8, flags: i32, mode: i32) -> i64 {
    if path == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if flags < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode > (511 as i32) {
        return 0 as i64 - (1 as i64);
    }
    return 42 as i64;
}

fn std_os_close(fd: i64) -> i32 {
    if fd < (0 as i64) {
        return 0 as i32 - (1 as i32);
    }
    return 0;
}

fn std_os_read(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return n;
}

fn std_os_write(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return n;
}

fn std_os_getenv(name: *u8) -> *u8 {
    return jh_getenv(name);
}

// ════════════════════════════════════════════════════
// main_jhyy — 5 sub-test
//   1: std_os_open(合法) → 返 fd=42 (mock)
//   2: std_os_open(0 path) → -1
//   3: std_os_open(合法 flags, mode=-1) → -1
//   4: std_os_close(42) → 0; std_os_close(-1) → -1
//   5: std_os_write(42, "hello", 5) → 5; std_os_read(42, buf, 5) → 5
//   6: std_os_getenv("PATH") → 非空 cstr
// 总 EXIT:6 个 sub-test PASS (返回 0)。EXPECT:0
// ════════════════════════════════════════════════════

fn main_jhyy() -> i32 {
    let test_path = "compiler/build/bin/_std_os_basic_tmp.txt" as *u8;

    // ── Sub-test 1: std_os_open(合法) → fd=42 ──
    let flags_w = OS_O_WRONLY() + OS_O_CREAT() + OS_O_TRUNC();
    let fd1 = std_os_open(test_path, flags_w, OS_MODE_RW_R());
    if fd1 != (42 as i64) {
        return 1;
    }

    // ── Sub-test 2: std_os_open(0 path) → -1 ──
    let fd2 = std_os_open(0 as *u8, OS_O_RDONLY(), 0 as i32);
    if fd2 >= (0 as i64) {
        return 2;
    }

    // ── Sub-test 3: std_os_open(合法 flags, mode=-1) → -1 ──
    let fd3 = std_os_open(test_path, OS_O_RDONLY(), 0 as i32 - (1 as i32));
    if fd3 >= (0 as i64) {
        return 3;
    }

    // ── Sub-test 4: close(42) → 0; close(-1) → -1 ──
    let c1 = std_os_close(42 as i64);
    if c1 != (0 as i32) {
        return 4;
    }
    let c2 = std_os_close(0 as i64 - (1 as i64));
    if c2 != (0 as i32 - (1 as i32)) {
        return 5;
    }

    // ── Sub-test 5: write(42, "hello", 5) → 5; read(42, buf, 5) → 5 ──
    let hello = "hello" as *u8;
    let wn = std_os_write(42 as i64, hello, 5 as i64);
    if wn != (5 as i64) {
        return 6;
    }
    let mut buf1: [i32; 16] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                                0 as i32, 0 as i32, 0 as i32, 0 as i32,
                                0 as i32, 0 as i32, 0 as i32, 0 as i32,
                                0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let rn = std_os_read(42 as i64, buf1 as *u8, 5 as i64);
    if rn != (5 as i64) {
        return 7;
    }

    // ── Sub-test 6: getenv("PATH") → 非空 cstr ──
    let env_path = std_os_getenv("PATH" as *u8);
    if env_path == (0 as *u8) {
        return 8;
    }
    let first: i32 = *(env_path as *i32) & (0xff as i32);
    if first == (0 as i32) {
        return 9;
    }

    return 0;
}
