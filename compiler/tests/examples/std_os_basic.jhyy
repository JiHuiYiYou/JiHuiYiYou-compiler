// std_os_basic.jhyy — std::os basic test(import **真身**,不再 inline 副本)
//
// 2026-10-20 (W-103 真修):本文件之前是 std/os.jhyy 的 **inline 副本**,而那份
// 副本给 **mock 契约** 背书 —— 断言 `fd1 != 42` 就返回 1、`write` 返 5、
// `read` 返 5。一个**从不碰文件系统**的纯 mock 因此一直有个 PASS 撑着,
// 而那个 PASS 不验证任何真实行为(W-103 的根因之一)。
//
// 现在改成 `import os;` 引用真身(compiler/src0/std/os.jhyy),断言全部对着
// **真实行为**写:
//   · open 拿到的是**真 fd**(≥ 0 的真值),不是魔数 42
//   · write 的字节数是内核返回的,不是「我们说写了 n」
//   · read 读回来的是**文件里的内容**,不是「我们说读了 n」
//
// `import os;` 能找到 std lib 目录,靠的是 W-103 新增的 import 回落
// (main 文件旁边找不到 → <root>/compiler/src0/std/)。
//
// EXPECT: 0
import os;

extern fn printf(fmt: *u8, a: i32, b: i32) -> i32;

fn main_jhyy() -> i32 {
    let test_path = "compiler/build/bin/_std_os_basic_tmp.txt" as *u8;

    // ── Sub-test 1: open(合法路径) → 真 fd ──
    let flags_w = OS_O_WRONLY() + OS_O_CREAT() + OS_O_TRUNC();
    let fd1 = std_os_open(test_path, flags_w, OS_MODE_RW_R());
    if fd1 < (0 as i64) {
        return 1;
    }

    // ── Sub-test 2: open(0 path) → -1 ──
    let fd2 = std_os_open(0 as *u8, OS_O_RDONLY(), 0 as i32);
    if fd2 >= (0 as i64) {
        return 2;
    }

    // ── Sub-test 3: open(合法 flags, mode=-1) → -1 ──
    let fd3 = std_os_open(test_path, OS_O_RDONLY(), 0 as i32 - (1 as i32));
    if fd3 >= (0 as i64) {
        return 3;
    }

    // ── Sub-test 4: write 真落盘(返回值 = 内核实际写入量)──
    let hello = "hello" as *u8;
    let wn = std_os_write(fd1, hello, 5 as i64);
    if wn != (5 as i64) {
        return 4;
    }

    // ── Sub-test 5: close(真 fd) → 0;close(-1) → -1 ──
    let c1 = std_os_close(fd1);
    if c1 != (0 as i32) {
        return 5;
    }
    let c2 = std_os_close(0 as i64 - (1 as i64));
    if c2 != (0 as i32 - (1 as i32)) {
        return 6;
    }

    // ── Sub-test 6: 重新打开读回来 —— 内容必须是文件里的真实字节 ──
    let fd4 = std_os_open(test_path, OS_O_RDONLY(), 0 as i32);
    if fd4 < (0 as i64) {
        return 7;
    }
    let mut buf: [i32; 16] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let rn = std_os_read(fd4, buf as *u8, 5 as i64);
    if rn != (5 as i64) {
        return 8;
    }
    let b0 = *(buf as *u8) as i32;
    if b0 != (104 as i32) {          // 'h'
        return 9;
    }
    let b1 = *(buf as *u8 + (1 as i64)) as i32;
    if b1 != (101 as i32) {          // 'e'
        return 10;
    }
    let c3 = std_os_close(fd4);
    if c3 != (0 as i32) {
        return 11;
    }

    // ── Sub-test 7: getenv("PATH") → 非空 cstr ──
    let env_path = std_os_getenv("PATH" as *u8);
    if env_path == (0 as *u8) {
        return 12;
    }
    let first: i32 = *(env_path as *i32) & (0xff as i32);
    if first == (0 as i32) {
        return 13;
    }

    printf("STD_OS_BASIC ok\n" as *u8, 0, 0);
    return 0;
}
