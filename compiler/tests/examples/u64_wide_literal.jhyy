// EXPECT: 0
// W-186: ≥ 2⁶³ 的整数字面量必须**按 u64 精确求值**(不是饱和到 LLONG_MAX)。
//
// 修前:parser 用 `strtoll`(**有符号**)⇒ 量值 ≥ 2⁶³ 按 C 标准**饱和到 LLONG_MAX**
//   ⇒ 所有 ≥ 2⁶³ 的 u64 字面量都变成同一个数 9223372036854775807。
//
// ⚠️ **断言强度的关键**:期望值**不能**也写成同样形式的大字面量 ——
//   那样「两个字面量同时饱和」会互相抵消,测试变成零信号。
//   ⇒ 期望值一律用**小字面量**表达:
//     · `as i64` 的**位模式**(u64::MAX ⇒ -1)
//     · `% 小除数` 的**小余数**
//   这两种期望在「饱和」下都取不到正确的值 ⇒ 缺陷真的能被测出来。
//
// ⚠️ **两条路径都要验**:
//   · 运行期:局部 `let` 的值;
//   · 编译期:模块级 `let` 的初始化器走常量折叠器 ⇒ 折叠器拿到的是**位模式**
//     ⇒ 落进 .data 段后读回来仍须正确。

// ── 编译期路径(常量折叠 → .data 段)────────────────────────────
let mut g_a: u64 = 18446744073709551615u64;
let mut g_b: u64 = 0xffffffffffffffffu64;
let mut g_c: u64 = 9223372036854775808u64;
let mut g_d: u64 = 0xacca7f0dd3ac535fu64;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // u64::MAX:位模式上 u64::MAX 落进 i64 就是 -1
    let a: u64 = 18446744073709551615u64;
    if (a as i64) != -1i64 { err = err + 1; }
    if a % 10u64 != 5u64 { err = err + 2; }

    // 十六进制 u64::MAX
    let b: u64 = 0xffffffffffffffffu64;
    if (b as i64) != -1i64 { err = err + 4; }
    if b % 10u64 != 5u64 { err = err + 8; }

    // 恰好 2⁶³:位模式 = i64::MIN
    let c: u64 = 9223372036854775808u64;
    if (c as i64) != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 16; }
    if c % 10u64 != 8u64 { err = err + 32; }

    // 高位随机值:0xacca7f0dd3ac535f = 12450903817181746015
    let d: u64 = 0xacca7f0dd3ac535fu64;
    if (d as i64) != -5995840256527805601i64 { err = err + 64; }
    if d % 1000u64 != 15u64 { err = err + 128; }

    // 小字面量不受影响
    let e: u64 = 42u64;
    if e != 42u64 { err = err + 256; }

    // ── 编译期路径(常量折叠)──
    if (g_a as i64) != -1i64 { err = err + 512; }
    if (g_b as i64) != -1i64 { err = err + 1024; }
    if (g_c as i64) != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 2048; }
    if (g_d as i64) != -5995840256527805601i64 { err = err + 4096; }

    return err;
}
