// EXPECT: 0
// W-188: `-9223372036854775808i64`(= `i64::MIN`)必须**精确**,不是差 1。
//
// 修前:parser 用 `strtoll` ⇒ 量值 2⁶³ **饱和到 LLONG_MAX**,
//   而「取负」是**独立的 AST 节点** ⇒ 得到 `-9223372036854775807`(**差 1**)。
// 修后:量值按 u64 精确求值,负号在**解析期**按 u64 位模式折叠
//   (0 - 2⁶³ 在 u64 里回绕成 2⁶³ ⇒ 位模式正是 INT64_MIN)。
//
// ⚠️ 期望值一律用**小字面量**表达(「0 - MAX - 1」)⇒ 不受同一路径影响。
//
// ⚠️ **两条路径都要验**:运行期(局部 `let`)+ 编译期(模块级 `let` ⇒ 常量折叠)。

// ── 编译期路径(常量折叠 → .data 段)────────────────────────────
let mut g_min: i64 = -9223372036854775808i64;
let mut g_sh: i64 = (0i64 - 9223372036854775807i64 - 1i64) >> 63i64;
let mut g_add: i64 = (0i64 - 9223372036854775807i64 - 1i64) + 1i64;

fn main_jhyy() -> i32 {
    let mut err: i32 = 0;

    // ── 运行期路径 ──
    // i64::MIN 直接写
    let a: i64 = -9223372036854775808i64;
    if a != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 1; }

    // i64::MIN / 1 ⇒ 还是 i64::MIN
    let b: i64 = a / 1i64;
    if b != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 2; }

    // i64::MIN >> 63 ⇒ -1(算术右移补符号)
    let c: i64 = a >> 63i64;
    if c != -1i64 { err = err + 4; }

    // i64::MIN + 1 ⇒ -9223372036854775807
    let d: i64 = a + 1i64;
    if d != -9223372036854775807i64 { err = err + 8; }

    // i64::MAX 不受影响
    let e: i64 = 9223372036854775807i64;
    if e != 9223372036854775807i64 { err = err + 16; }

    // ── 编译期路径(常量折叠)──
    if g_min != (0i64 - 9223372036854775807i64 - 1i64) { err = err + 32; }
    if g_sh != -1i64 { err = err + 64; }
    if g_add != -9223372036854775807i64 { err = err + 128; }

    return err;
}
