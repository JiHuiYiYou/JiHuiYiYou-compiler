// 复现件 —— 对应台账 W-230（**故意不在回归套件里**，见本目录 README.md）
//
// 现状（2026-11-15 实测）：退出码 1 —— 栈位置（第 5 个）实参传 `null` 字面量时，
//   caller 只 `movl` 写 4 字节，callee 按 8 字节读 ⇒ 指针高 4 字节是残渣。
// 修好后：退出码 0（那个指针必须是干净的 0）。
//
// 断言（搬进 examples/ 时生效）：
//   EXPECT: 0
//
// 背景：MS x64 第 5 个及以后的实参走栈（槽宽 8 字节，实参落在 [rsp+32] 起）。
// `null` 字面量的类型在**调用实参这条路径上没有**被填（sema.jhyy:1045-1049 的
// 哨兵，填充点只有比较 / as / let 初始化 / 赋值那几处）⇒ IR 把它发成 32 位（w）
// ⇒ `emit_stack_arg_push` 只 `movl` 写 4 字节
// （codegen_amd64_xmm_argalloc.jhyy:279-287）⇒ 高 4 字节保留上次写这个槽的内容。
//
// ⇒ 本复现件用「先调一次带 ≥5 个实参的函数」把那 4 个字节**确定性地**填成非零
//    （不依赖进程启动残留 —— 残渣在不同环境下可能恰好是 0）。
fn probe5(a: i64, b: i64, c: i64, d: i64, e: *u8) -> i64 {
    return e as i64;
}

// 故意写一个栈参数（>4 个 ⇒ 第 5 个落栈）把 [rsp+32] 填成非零
fn poison(a: i64, b: i64, c: i64, d: i64, e: *u8) -> i64 {
    return e as i64;
}

fn main_jhyy() -> i32 {
    let local: [u8; 8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let p: *u8 = &local[0];

    // ① 先用非零指针占住栈参数槽（movq ⇒ 8 字节写满）
    let _poisoned = poison(1, 2, 3, 4, p);

    // ② ❌ 栈位置的 null 字面量 ⇒ 只写低 4 字节 ⇒ 高 4 字节是 ① 的残留
    let v = probe5(1, 2, 3, 4, null);

    // ③ ✅ 对照：先落到带类型的局部变量 ⇒ IR 是 64 位 ⇒ 槽写满
    let z: *u8 = null;
    let w = probe5(1, 2, 3, 4, z);

    let mut bad: i64 = 0;
    if v != 0i64 { bad = bad + 1i64; }
    if w != 0i64 { bad = bad + 2i64; }
    return bad as i32;
}
