// 复现件 —— 对应台账 W-231（**故意不在回归套件里**，见本目录 README.md）
//
// 现状（2026-11-15 实测）：编译期报 `field type mismatch` ×2
//   —— 而**同一个 `null` 字面量**写进 let 初始化是合法的（`let z: *u8 = null;` ✅）
// 修好后：编译通过（字段里的 null 应当能用）。
//
// 断言（搬进 examples/ 时生效）：
//   EXPECT: 0
//
// 背景：`null` 的类型靠「caller 上下文」填充（sema.jhyy:1045-1049 的哨兵），
// 而 **struct 字面量字段这条路径没有实现**（let 路径有：sema.jhyy:2312-2325）
// ⇒ 字段类型检查拿不到 null 的类型 ⇒ 报 `field type mismatch`（sema.jhyy:2632）
// ⇒ 报错措辞完全指不到真因。
//
// 一次就撞上 5 个字段的是 Win32 的 WNDCLASSEX（hIcon / hCursor / hbrBackground /
// lpszMenuName / hIconSm）。
type W = struct {
    a: *u8,
    b: *u8,
}

fn main_jhyy() -> i32 {
    let w = W { a: null, b: null };

    let mut bad: i32 = 0;
    if w.a != null { bad = bad + 1; }
    if w.b != null { bad = bad + 2; }
    return bad;
}
