// codegen_amd64_lexer.jhyy — v2.5.0 A1 agent: QBE IL lexer
//
// Module-split 设计 (per docs/plans/v2/v2.5.0详细实现方案.md § 4.1):
// 本模块只产 ILToken 数组,不 emit .s,不接触 CGState。emit 模块(A2/A3/A4)
// 拿到 tokens 后用 tok.text / tok.int_val / tok.qbe_type 字段组装 amd64 GAS。
//
// 替换路径 (per L4 § 1.1):
//   QBE IL emit (codegen.jhyy) → 写 .il
//                              ↓
//                  codegen_amd64_run() 读 .il
//                              ↓
//                  lex_il(buf, len, arena)  ← 本模块
//                              ↓
//                  parse_and_emit() dispatch 到 15 emit 函数 (A2/A3/A4)
//
// 接口契约 (L4 § 4.1 lock + A0 commit 729073c state.jhyy):
//   - ILToken / ILTOK_* / QBE_VOLATILE_MARKER 全部 import codegen_amd64_state
//   - emit 模块对 lexer 输出格式的依赖:
//     * tok.kind (ILTOK_*) 决定 dispatch 到哪个 emit 函数
//     * tok.text / tok.text_len 保留原始字符串 (function 名 / label 名 / data 名)
//     * tok.int_val numeric literal (alloc size 等)
//     * tok.qbe_type 'w'/'l'/'s'/'d' 或 QBE_VOLATILE_MARKER (-1)
//     * tok.line 用于 .loc 注释 / 错误诊断
//   - 最后一个 token 必为 ILTOK_EOF
//
// 关键约束 cross-link:
//   - D42 escape hatch: codegen_amd64_emit_raw_asm stub in A5 main, V3-B v3.0.1 填充
//     (per jhyy_OS/docs/coordination.md § 3 D42).本模块不涉及,但 emit_volatile (A4) 走 default 路径。
//   - 3c volatile token 优先 (per v2-v3-parallel-sprint-plan.md § 6.4):
//     lexer 必须识别 volatile keyword → tok.qbe_type = QBE_VOLATILE_MARKER (-1);
//     但 tok.kind 仍 = ILTOK_LOAD/ILTOK_STORE (per L4 § 2.4)。emit_volatile (A4) 默认按普通
//     load/store 处理, **不** emit memory barrier;V2-B 3c ship 后再 flip 行为。
//   - D43 self-equal baseline: 本模块不改 codegen.jhyy 主干,closure sha 51376ce5... 保持
//     (per jhyy_OS/docs/coordination.md § 3 D43)。
//
// Note: lives flat in compiler/src0/ (not in a subdir) — jhyy import syntax
// doesn't support paths with `/` (per parse_import_decl codegen.c:731 — same
// restriction as abi_amd64_win.jhyy / codegen_amd64_state.jhyy).

import codegen_amd64_state;
import arena;
import ffi;
import util;  // V2-B v2.6.0 Unit B: ptr_add_u8 (used at lex_advance + lex helpers)

// ════════════════════════════════════════════════════
// Lexer state(per-token local cursor,not 嵌套 struct)
// ════════════════════════════════════════════════════
//
// jhyy codegen v0.6 坑: *u8 deref → loadsb (1-byte). 解法用 *i32 aligned deref
// + shift+mask,跟 lexer.jhyy lex_peek_char / lex_next_char 一致。

type LexState = struct {
    buf:    *u8,
    end:    *u8,    // one-past-end sentinel (buf + len)
    cur:    *u8,    // cursor
    line:   i32,
    count:  i64,    // emitted tokens so far
    // v2.11.2 (W-074.6 T1-a):每个 instruction token 的起点。
    // Dispatcher 在每个 op branch 进入前 capture (*s).cur;helper 末尾通过
    // lex_finish_instr 用 [instr_start..cur) slice 填 tok.text/text_len。
    // recursive dispatch ('%' branch 含 '=w' 后跳 op dispatcher) 沿用 caller 设的值。
    instr_start: *u8,
}

// ════════════════════════════════════════════════════
// Byte I/O helpers(对齐 deref 防 loadsb codegen bug)
// ════════════════════════════════════════════════════

fn lex_peek_byte(s: *LexState) -> i32 {
    let p_addr = (*s).cur as i64;
    let aligned = p_addr & (~(3 as i64));
    let rem = (p_addr - aligned) as i32;
    let w = *((aligned) as *i32);
    let sh = rem * (8 as i32);
    let c = ((w >> sh) & (255 as i32)) as i64;
    return c as i32;
}

fn lex_peek_byte_at(s: *LexState, off: i64) -> i32 {
    let p_addr = ((*s).cur as i64) + off;
    let aligned = p_addr & (~(3 as i64));
    let rem = (p_addr - aligned) as i32;
    let w = *((aligned) as *i32);
    let sh = rem * (8 as i32);
    let c = ((w >> sh) & (255 as i32)) as i64;
    return c as i32;
}

// 读取并前进。EOF 返 0 且不前进。
fn lex_next_byte(s: *LexState) -> i32 {
    if (*s).cur >= (*s).end {
        return 0 as i32;
    }
    let c = lex_peek_byte(s);
    if c == 10 {
        (*s).line = (*s).line + (1 as i32);
    }
    (*s).cur = ptr_add_u8((*s).cur, 1 as i64);
    return c;
}

fn lex_match_byte(s: *LexState, expected: i32) -> i32 {
    if lex_peek_byte(s) == expected {
        (*s).cur = ptr_add_u8((*s).cur, 1 as i64);
        return 1 as i32;
    }
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// 跳过空白 + 注释
// ════════════════════════════════════════════════════
//
// QBE IL 注释:`#` 到行尾(L4 § 2.2 lexer 形态)。
// 空白:` ` `\t` `\r` 不增 line;`\n` 增 line(per L4 § 2.2)。

fn lex_skip_line_comment(s: *LexState) -> i32 {
    let mut done = 0 as i32;
    while done == (0 as i32) {
        let c = lex_peek_byte(s);
        if c == 0 {
            done = 1 as i32;
        } else {
            if c == 10 {
                done = 1 as i32;
            } else {
                let _x = lex_next_byte(s);
            }
        }
    }
    return 0 as i32;
}

fn lex_skip_ws_and_comments(s: *LexState) -> i32 {
    let mut done = 0 as i32;
    while done == (0 as i32) {
        let c = lex_peek_byte(s);
        if c == (32 as i32) || c == (9 as i32) || c == (13 as i32) || c == (10 as i32) {
            // space / tab / CR / LF — LF 已在 lex_next_byte 里 +1 line
            let _x = lex_next_byte(s);
        } else if c == (35 as i32) {  // '#' — QBE IL line comment
            let _x = lex_next_byte(s);
            let _y = lex_skip_line_comment(s);
        } else {
            done = 1 as i32;
        }
    }
    return 0 as i32;
}

// v2.11.2 (W-074.6 T1-a bug fix):lex_skip_ws — 跳 ws 但**不**跨 '\n'。
// Helper 在 lex_consume_to_eol 之前调这个,而不是 lex_skip_ws_and_comments,
// 否则会把 cursor 推到下一行,让 lex_finish_instr slice 跨越多行 IL。
fn lex_skip_ws(s: *LexState) -> i32 {
    let mut done = 0 as i32;
    while done == (0 as i32) {
        let c = lex_peek_byte(s);
        if c == (32 as i32) || c == (9 as i32) || c == (13 as i32) {
            // space / tab / CR — **不**跨 '\n'
            let _x = lex_next_byte(s);
        } else {
            done = 1 as i32;
        }
    }
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// 字面量 / 标识符 scanner
// ════════════════════════════════════════════════════
//
// IL 标识符:%t<id> / $name / @<label> / function name
// QBE IL 数字:十进制为主(int alloc size)

fn lex_scan_decimal_int(s: *LexState) -> i64 {
    let mut v: i64 = 0 as i64;
    let mut done = 0 as i32;
    while done == (0 as i32) {
        let c = lex_peek_byte(s);
        if c >= (48 as i32) && c <= (57 as i32) {
            v = v * (10 as i64) + ((c - (48 as i32)) as i64);
            let _x = lex_next_byte(s);
        } else {
            done = 1 as i32;
        }
    }
    return v;
}

// 读 identifier (= [A-Za-z_][A-Za-z0-9_.]*)。返回长度。
// start = (*s).cur at ident start (first char already consumed by caller if
// caller is dispatching; here we keep caller consumes first char then we scan rest).
fn lex_scan_ident_rest(s: *LexState) -> i64 {
    let mut n: i64 = 0 as i64;
    let mut done = 0 as i32;
    while done == (0 as i32) {
        let c = lex_peek_byte(s);
        let mut ok = 0 as i32;
        if c >= (97 as i32) && c <= (122 as i32) { ok = 1 as i32; }  // a-z
        if c >= (65 as i32) && c <= (90 as i32) { ok = 1 as i32; }   // A-Z
        if c >= (48 as i32) && c <= (57 as i32) { ok = 1 as i32; }   // 0-9
        if c == (95 as i32) { ok = 1 as i32; }  // '_'
        if c == (46 as i32) { ok = 1 as i32; }  // '.'
        if ok == (1 as i32) {
            let _x = lex_next_byte(s);
            n = n + (1 as i64);
        } else {
            done = 1 as i32;
        }
    }
    return n;
}

// lex_parse_temp_id_from_ident(start, len) — 从 ident text 提取 temp id N
//   期望 ident 形式: 't' + digits (e.g. "t1", "t42")
//   start = ident 起始 (已经 consume 后)
//   len = ident 长度
//   返回 N。如果 ident 不是 "tN" 形式 (e.g. 是其他 ident), 返回 0。
//
// v2.11.1 (W-074.5 真修延伸-3 配套 helper)。
fn lex_parse_temp_id_from_ident(start: *u8, len: i64) -> i64 {
    if start == (0 as *u8) || len < (2 as i64) {
        return 0 as i64;
    }
    let first = *start;
    if first != (116 as i32) {  // 't'
        return 0 as i64;
    }
    let mut val: i64 = 0 as i64;
    let mut i: i64 = 1 as i64;
    while i < len {
        let c = *(ptr_add_u8(start, i)) as i32;
        if c < (48 as i32) || c > (57 as i32) {
            return 0 as i64;
        }
        val = val * (10 as i64) + ((c - (48 as i32)) as i64);
        i = i + (1 as i64);
    }
    return val;
}

// lex_scan_decimal_int(s) — scan decimal integer starting at cursor, return value
//   cursor advances past digits. If first char is not digit, returns 0.
//   注:lex_scan_decimal_int 已在 line 153 定义 (per codegen_amd64_alloc.jhyy 同 pattern),
//   这里不重复定义。

// ════════════════════════════════════════════════════
// Token fill helper(写入 *ILToken 字段)
// ════════════════════════════════════════════════════

fn lex_init_token(t: *u8, kind: i32, line: i32) -> i32 {
    // t is *ILToken
    let tp = t as *i32;
    *tp = kind;
    let tp2 = ptr_add_u8(t, 8 as i64) as **u8;
    *tp2 = 0 as *u8;
    let tp3 = ptr_add_u8(t, 16 as i64) as *i64;
    *tp3 = 0 as i64;
    let tp4 = ptr_add_u8(t, 24 as i64) as *i64;
    *tp4 = 0 as i64;
    let tp5 = ptr_add_u8(t, 32 as i64) as *i32;
    *tp5 = 0 as i32;
    let tp6 = ptr_add_u8(t, 36 as i64) as *i32;
    *tp6 = line;
    return 0 as i32;
}

// 把 [start, start+len) 拷到 arena,返回 NUL-terminated 副本。
fn lex_dup_text(arena: *u8, start: *u8, len: i64) -> *u8 {
    return arena_strdup(arena, start, len);
}

// ════════════════════════════════════════════════════
// QBE type 字母解析 → QBE_*_LOCAL(import 自 state)
// ════════════════════════════════════════════════════
//
// 'w' / 'l' / 's' / 'd' / 'b' / 'h' (per L4 § 2.1)。

fn lex_qbe_type_from_byte(c: i32) -> i32 {
    if c == (119 as i32) { return QBE_W_LOCAL(); }  // 'w'
    if c == (108 as i32) { return QBE_L_LOCAL(); }  // 'l'
    if c == (115 as i32) { return QBE_S_LOCAL(); }  // 's'
    if c == (100 as i32) { return QBE_D_LOCAL(); }  // 'd'
    if c == (98 as i32)  { return QBE_B_LOCAL(); }  // 'b'
    if c == (104 as i32) { return QBE_H_LOCAL(); }  // 'h'
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// 16 个 next_token helper(per L4 § 2.1:EOF + 15 token type)
// ════════════════════════════════════════════════════
//
// 每个 helper 假定首字符已 consumed(by main dispatcher);写 *ILToken。
// 失败:不写,返 -1;成功:写完返 0。
//
// 主要形态(per L4 § 2.1 表 + ir.jhyy emit 反查):
//   1. EOF         字节 0 / 末尾
//   2. ILTOK_ALLOC        "alloc4|alloc8|alloc16 <size>"
//   3. ILTOK_STORE        "storew|storel|stores|stored <src>, <addr>"
//   4. ILTOK_LOADSUB      "loadsb|loadub|loadsh|loaduh <T> <addr>"
//   5. ILTOK_LOAD         "loadw|loadl|loads|loadd <addr>"
//   6. ILTOK_CALL         "<dst> =<qt> call $<name>(...)" | "call $<name>(...)"
//   7. ILTOK_PHI          "<dst> =<qt> phi @b1 %t1, @b2 %t2"
//   8. ILTOK_COPY         "<dst> =<qt> copy <src>"
//   9. ILTOK_BINOP        "add|sub|mul|div|mod"
//  10. ILTOK_RET          "ret <val>" | "ret"
//  11. ILTOK_JMP          "jmp @<label>"
//  12. ILTOK_JNZ          "jnz %<cond>, @<then>, @<else>"
//  13. ILTOK_LABEL        "@<name>:"
//  14. ILTOK_FUNC_HEADER  "export function [<qt>] $<name>(...) {"
//  15. ILTOK_DATA_STRING  "data $<name> = { b \"...\" }"
//  16. ILTOK_VOLATILE     "volatile" keyword before load/store
//
// volatile 处理 (per L4 § 2.4 + X.2):
//   main dispatcher peek next token after volatile → 若 kind==ILTOK_LOAD/ILTOK_STORE,
//   set tok.qbe_type = QBE_VOLATILE_MARKER (-1) and 改 tok.text = "volatile" 字面,
//   但 tok.kind 仍 = ILTOK_LOAD/ILTOK_STORE。emit_volatile (A4) 走 default load/store 路径。

// ── helper: peek 当前是不是 keyword(prefix match),不前进;若匹配,前进。──
// 用法:lex_match_kw(s, "loadw", 5) → match "loadw" 则前进,返 1。

fn lex_match_kw(s: *LexState, kw: *u8, kwlen: i64) -> i32 {
    let mut i: i64 = 0 as i64;
    while i < kwlen {
        let c = lex_peek_byte_at(s, i);
        let k = *(ptr_add_u8(kw, i)) as i32;
        if c != k { return 0 as i32; }
        i = i + (1 as i64);
    }
    // match:全 skip
    let mut j: i64 = 0 as i64;
    while j < kwlen {
        let _x = lex_next_byte(s);
        j = j + (1 as i64);
    }
    return 1 as i32;
}

// ════════════════════════════════════════════════════
// v2.11.2 (W-074.6 T1-a): lex_finish_instr + lex_consume_to_eol helpers
// ════════════════════════════════════════════════════
//
// T1-a 根因:next_token_{jnz/ret/jmp/call/copy/binop/load/store/alloc/loadsub/phi}
// 只 consume mnemonic,留 operands 在 buffer 让 lex_il 走 byte-skip 吃错位。
//
// 修复契约(per _emit_mem.jhyy:25-40 documented contract):
//   tok.text/text_len = 整条 QBE IL 指令原文 slice
//   tok.int_val = dst temp id,or -1 if no destination
//   tok.qbe_type = result QBE type,or 0 / QBE_VOLATILE_MARKER
//
// 每个 instruction helper 在 dispatcher 设 (*s).instr_start 之后调用 lex_consume_to_eol
// 把 cursor 推到行尾,再调 lex_finish_instr 用 [instr_start..cur) 右 trim + strdup。
//
// lex_finish_instr **不**重置 kind / int_val / qbe_type — caller 已设。

// lex_consume_to_eol — 把 cursor 推到 '\n' 或 EOF,**不**consume '\n'
// 让 lex_skip_ws_and_comments 处理(增 line)。
//
// v2.11.2 (W-074.6 T1-a bug fix):helpers 在 lex_consume_to_eol 之前调
// lex_skip_ws (新加,不跨 '\n' 的 ws skipper)。原 lex_skip_ws_and_comments
// 会跨过 '\n',把 cursor 推到下一行,让 lex_finish_instr slice 跨越多行 IL。
fn lex_consume_to_eol(s: *LexState) -> i32 {
    while (*s).cur < (*s).end {
        let c = lex_peek_byte(s);
        if c == (10 as i32) || c == (0 as i32) {
            return 0 as i32;
        }
        let _x = lex_next_byte(s);
    }
    return 0 as i32;
}

// lex_finish_instr — slice [instr_start..cur) → text/text_len
//
// 参数:
//   s: LexState (读 instr_start, cur)
//   arena: arena ptr (供 arena_strdup)
//   t: *ILToken (写 text / text_len;**不**改 kind / int_val / qbe_type — caller 已设)
//
// int_val + qbe_type 的设置规则:
//   - '%' branch dispatcher 递归后覆盖 int_val = dst_id + qbe_type = qt (per v2.11.1 行为,
//     v2.11.2 把 dst 从 text_len 改写 int_val)。
//   - direct dispatch (ret/jmp/jnz/store 没 '%' LHS):helper 自己写 int_val = -1 +
//     qbe_type = 适当值。
//
// 注:kind 由 caller 在 lex_init_token 设置;本函数不改 kind。
fn lex_finish_instr(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let start = (*s).instr_start;
    let end = (*s).cur;
    // Right-trim whitespace:从 end 往前走,直到非空白或到 start。
    let mut actual_end = end;
    let mut trim_done = 0 as i32;
    while trim_done == (0 as i32) {
        if actual_end <= start {
            trim_done = 1 as i32;
        } else {
            let c = *(ptr_add_u8(actual_end, -(1 as i64))) as i32;
            if c == (32 as i32) || c == (9 as i32) || c == (13 as i32) {
                actual_end = ptr_add_u8(actual_end, -(1 as i64));
            } else {
                trim_done = 1 as i32;
            }
        }
    }
    let final_len = actual_end - start;
    let mut buf: *u8 = 0 as *u8;
    if final_len > (0 as i64) {
        buf = arena_strdup(arena, start, final_len);
    }
    let tp_text = ptr_add_u8(t, 8 as i64) as **u8;
    *tp_text = buf;
    let tp_textlen = ptr_add_u8(t, 16 as i64) as *i64;
    *tp_textlen = final_len;
    // int_val + qbe_type preserve — caller 已设。
    let _a = arena;
    return 0 as i32;
}

// ── 1. EOF ──
fn next_token_eof(s: *LexState, t: *u8) -> i32 {
    lex_init_token(t, ILTOK_EOF(), (*s).line);
    let _x = s;
    let _y = t;
    return 0 as i32;
}

// ── 2. alloc4 / alloc8 / alloc16 ──
// 形态:`alloc<N> <size>`;N ∈ {4,8,16};size = 十进制 int。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr 填 text。
// v2.11.2 (T1-a):删 int_val = size (emit_alloc 已 parse size from text via mem_find_sub)。
fn next_token_alloc(s: *LexState, arena: *u8, t: *u8) -> i32 {
    // "alloc" 已 consumed;看 N
    let align_byte = lex_peek_byte(s);
    let mut align_n: i64 = 0 as i64;
    if align_byte == (52 as i32)  { align_n = 4 as i64; }   // '4'
    else if align_byte == (56 as i32) { align_n = 8 as i64; }  // '8'
    else if align_byte == (49 as i32) {  // '1' → "16"
        let n1 = lex_peek_byte_at(s, 1 as i64);
        if n1 == (54 as i32) {  // '6'
            align_n = 16 as i64;
            let _a = lex_next_byte(s);
        }
    }
    if align_n == (0 as i64) { return -1 as i32; }
    let _a = lex_next_byte(s);  // consume align digit (or '6' if "16")
    // 空白
    let _s = lex_skip_ws_and_comments(s);
    // size
    let size = lex_scan_decimal_int(s);
    let _x = arena;
    lex_init_token(t, ILTOK_ALLOC(), (*s).line);
    // v2.11.2 (T1-a):size 不再写 int_val;emit_alloc 用 mem_find_sub + mem_parse_int_from
    // 从 tok.text 读 "alloc8 16" 拿 size。int_val 由 '%' branch 预填 dst temp id (或 -1)。
    let _sz = size;
    let _align_n = align_n;
    // qbe_type 不用:emit_alloc 用 mem_find_sub 认 alloc + size,不用 qt byte。
    // consume 到行尾 + finish instr (set text/text_len,preserve int_val/qbe_type)
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 3. storew / storel / stores / stored ──
// 形态:`storeT <src>, <addr>`。dispatcher 已 consume 's' (1 char);
// helper consume "tore" 4 chars + qt letter = 5 chars total,6 chars = "storew"。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。store 没 dst,direct dispatch,
// helper 自己写 int_val = -1 + qbe_type = qt byte。
fn next_token_store(s: *LexState, arena: *u8, t: *u8, qt_byte: i32) -> i32 {
    let _x = arena;
    // consume "tore" 4 chars
    let mut i: i64 = 0 as i64;
    while i < (4 as i64) {
        let _x2 = lex_next_byte(s);
        i = i + (1 as i64);
    }
    // consume qt letter ('w'/'l'/'s'/'d')
    let _x3 = lex_next_byte(s);
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_STORE(), (*s).line);
    // v2.11.2 (T1-a):store 没 dst (QBE IL `storew %t2, %t1` 不返值) → int_val = -1。
    let tp_iv = ptr_add_u8(t, 24 as i64) as *i64;
    *tp_iv = -(1 as i64);
    // qbe_type = qt byte (per v2.11.2 contract,emit_store 用 qt 决定 mov suffix)。
    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
    *tp_qt = lex_qbe_type_from_byte(qt_byte);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 4. loadsb / loadub / loadsh / loaduh ──
// dispatcher 已 consume "load" (4 chars)。helper consume "sb|ub|sh|uh" 2 chars。
// QBE 实际是 `%tN =w loadsbl %tA`(loadsbl 是 loadsb + dst type 'l')— 但 lexer
// 这里只识别 token 头 "loadsb",后续 qt + addr 由 emit 二次 scan。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。loadsub 有 dst (via '%' branch),
// helper 不写 int_val / qbe_type (由 '%' branch 预填)。
fn next_token_loadsub(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    // cursor 在 's'/'u' (loadsb / loadub / loadsh / loaduh 起点)
    let b1 = lex_peek_byte(s);
    if b1 != (115 as i32) && b1 != (117 as i32) { return -1 as i32; }  // 's' or 'u'
    let b2 = lex_peek_byte_at(s, 1 as i64);
    let mut sub_type: i32 = 0 as i32;
    // V2-B v2.6.0 (Unit B Stub-Fill): refactor — early-return guard + set,
    // to avoid if/else type mismatch (was: 3 branches with mixed () vs i32).
    if b2 != (98 as i32) && b2 != (104 as i32) {
        return -1 as i32;
    }
    sub_type = b2;  // 98 ('b') or 104 ('h')
    // consume 2 chars
    let _x2 = lex_next_byte(s);
    let _x3 = lex_next_byte(s);
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_LOADSUB(), (*s).line);
    // qbe_type = sub_type (per v2.11.2 contract)。int_val 由 '%' branch 设 dst temp id。
    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
    *tp_qt = sub_type;
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 5. loadw / loadl / loads / loadd ──
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。load 有 dst (via '%' branch),
// helper 不写 int_val / qbe_type (由 '%' branch 预填)。
fn next_token_load(s: *LexState, arena: *u8, t: *u8, qt_byte: i32) -> i32 {
    let _x = arena;
    let _ = lex_next_byte(s);  // consume qt letter
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_LOAD(), (*s).line);
    // qbe_type = qt byte。int_val 由 '%' branch 设 dst temp id。
    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
    *tp_qt = lex_qbe_type_from_byte(qt_byte);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 6. call ──
// 形态:`<dst> =<qt> call $<name>(<args>)` 或 `call $<name>(...)`。
// main dispatcher 已 consume 'c' (1 char);helper consume "all" 3 chars + 整段
// `$<name>(<args>)` body — 否则 lexer 返 CALL 后 cursor 留在 `$name(...)`,下一
// 次 next_token 看到 `$` 不识别走 unknown-skip(per debug trace 2026-09-10
// 验证),多 func IL 全部 silent fail。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。call 有 dst (via '%' branch),
// helper 不写 int_val / qbe_type。
fn next_token_call(s: *LexState, arena: *u8, t: *u8) -> i32 {
    // consume "all"
    let mut i: i64 = 0 as i64;
    while i < (3 as i64) {
        let _x = lex_next_byte(s);
        i = i + (1 as i64);
    }
    let _s = lex_skip_ws_and_comments(s);
    // consume '$<name>'
    if lex_peek_byte(s) == (36 as i32) {
        let _d = lex_next_byte(s);
        let _x = lex_scan_ident_rest(s);
    }
    let _s2 = lex_skip_ws_and_comments(s);
    // consume '(args)' — 支持 nested parens
    if lex_peek_byte(s) == (40 as i32) {
        let _lp = lex_next_byte(s);
        let mut depth: i64 = 1 as i64;
        let mut pdone = 0 as i32;
        while pdone == (0 as i32) {
            let pc = lex_peek_byte(s);
            if pc == (0 as i32) { pdone = 1 as i32; }
            else if pc == (40 as i32) { let _pc1 = lex_next_byte(s); depth = depth + (1 as i64); }
            else if pc == (41 as i32) {
                let _pc2 = lex_next_byte(s);
                depth = depth - (1 as i64);
                if depth <= (0 as i64) { pdone = 1 as i32; }
            } else { let _pc3 = lex_next_byte(s); }
        }
    }
    let _s3 = lex_skip_ws(s);  // v2.11.2:不跨 '\n'(原 lex_skip_ws_and_comments 会跨)
    lex_init_token(t, ILTOK_CALL(), (*s).line);
    // int_val + qbe_type 由 '%' branch 预填。
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 7. phi ──
// dispatcher 已 consume "phi" (3 chars via lex_match_kw);helper 不再 consume。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。phi 有 dst (via '%' branch),
// helper 不写 int_val / qbe_type。
fn next_token_phi(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    lex_init_token(t, ILTOK_PHI(), (*s).line);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 8. copy ──
// 形态:`%tN =qt copy <src>`。dispatcher '%' 分支已 consume `%tN =qt` 并填 dst_id 到
// int_val + qbe_type (per v2.11.2 contract)。本 helper consume "copy" + parse <src>。
//
// v2.11.1 (W-074.5 真修延伸-4):原 next_token_copy 只 consume "copy" 后 lex_init_token
// 默认值,emit_copy 读 int_val (=0 默认) → src_int = 0 → emit `mov $0` 永远写 0。
// v2.11.2 (T4-c deferred):emit_copy src/dst 区分留 v2.11.3 真修(per-function scan text)。
// 本 helper 只 consume "copy" + 把 cursor 推到 EOL 让 text slice 含完整指令,emit_copy
// 暂继续走 v2.11.1 路径(read int_val = src,因为 '%' branch 设 dst 后 copy 不写 int_val,
// int_val 留 dst — 但 v2.11.2 emit_copy v2.11.1 path 仍 read int_val;这会读 dst 当 src,
// 这是 T4-c 已知 bug,v2.11.3 修)。
fn next_token_copy(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    let mut i: i64 = 0 as i64;
    while i < (4 as i64) {
        let _x = lex_next_byte(s);
        i = i + (1 as i64);
    }
    lex_init_token(t, ILTOK_COPY(), (*s).line);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 9. binop (add/sub/mul/div/mod) ──
// dispatcher 已 consume 首字母 (a/s/m/d),这里 consume 剩余 2 chars ("dd"/"ub"/"ul|od"/"iv")。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr (text 整条 slice)。int_val + qbe_type
// 由 '%' branch 设 (T4-a/T4-b 留 v2.11.3 修 emit_binop op/operand 真 scan text)。
fn next_token_binop(s: *LexState, arena: *u8, t: *u8, op_byte: i32) -> i32 {
    // v2.11.2 (T1-a 真修): dispatcher 已 consume 首字母 (a/s/m/d),进入本 fn 时
    // cursor 指向第 2 个字符(如 'a' → cursor at 'd' of "dd")。peek_byte_at(s, 1)
    // 是错位偏移 → 永远 fail。原 offset 1/2 应改为 0/1。
    let mut op_name: *u8 = 0 as *u8;
    if op_byte == (97 as i32) {
        // "add" — consume "dd"
        let n1 = lex_peek_byte_at(s, 0 as i64);
        let n2 = lex_peek_byte_at(s, 1 as i64);
        if n1 != (100 as i32) || n2 != (100 as i32) { return -1 as i32; }
        let mut i: i64 = 0 as i64;
        while i < (2 as i64) {
            let _x = lex_next_byte(s);
            i = i + (1 as i64);
        }
        op_name = "add" as *u8;
    } else if op_byte == (115 as i32) {
        // "sub" — consume "ub"
        let n1 = lex_peek_byte_at(s, 0 as i64);
        let n2 = lex_peek_byte_at(s, 1 as i64);
        if n1 != (117 as i32) || n2 != (98 as i32) { return -1 as i32; }
        let mut i: i64 = 0 as i64;
        while i < (2 as i64) {
            let _x = lex_next_byte(s);
            i = i + (1 as i64);
        }
        op_name = "sub" as *u8;
    } else if op_byte == (109 as i32) {
        // "mul" 或 "mod" — consume "ul" or "od" (dispatcher 只 consume 'm' 了 1 char)
        // V2-B v2.6.0 (Unit B Stub-Fill): refactor — early-return guards for
        // validity, then set op_name. Avoids if/else chain type mismatch
        // (was: 3 branches with mixed () vs i32).
        let n1 = lex_peek_byte_at(s, 0 as i64);
        let n2 = lex_peek_byte_at(s, 1 as i64);
        // validity: n1 ∈ {117='u', 111='o'} && n2 ∈ {108='l', 100='d'}
        if n1 != (117 as i32) && n1 != (111 as i32) {
            return -1 as i32;
        }
        if n2 != (108 as i32) && n2 != (100 as i32) {
            return -1 as i32;
        }
        // consume 2 bytes (only on valid path)
        let mut i: i64 = 0 as i64;
        while i < (2 as i64) {
            let _x = lex_next_byte(s);
            i = i + (1 as i64);
        }
        // map to op_name (both branches return ())
        if n1 == (117 as i32) {
            op_name = "mul" as *u8;
        } else {
            op_name = "mod" as *u8;
        }
    } else if op_byte == (100 as i32) {
        // "div" — consume "iv"
        let n1 = lex_peek_byte_at(s, 0 as i64);
        let n2 = lex_peek_byte_at(s, 1 as i64);
        if n1 != (105 as i32) || n2 != (118 as i32) { return -1 as i32; }
        let mut i: i64 = 0 as i64;
        while i < (2 as i64) {
            let _x = lex_next_byte(s);
            i = i + (1 as i64);
        }
        op_name = "div" as *u8;
    } else {
        // V2-B v2.6.0 (Unit B Stub-Fill): refactor — set sentinel (was
        // `return -1`), uniform type across chain branches. Check after.
        op_name = 0 as *u8;
    }
    // post-chain guard: op_name still 0 ⇒ no branch matched ⇒ error
    if op_name == (0 as *u8) {
        return -1 as i32;
    }
    let _s = lex_skip_ws(s);  // v2.11.2:不跨 '\n'
    lex_init_token(t, ILTOK_BINOP(), (*s).line);
    // consume 到行尾 + finish instr (text 整条 slice;op_name redundant 但保留 tp_text 给 T4-a 真修留路)
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    let _opname = op_name;
    let _arena = arena;
    return 0 as i32;
}

// ── 10. ret ──
// 形态:`ret <val>` 或 `ret`。dispatcher 已 consume "ret" (via lex_match_kw)。
// v2.11.2 (T1-a + T2-b):consume 到行尾 + lex_finish_instr。ret 没 dst → int_val = -1。
// qbe_type = QBE_W_LOCAL() (默认,per plan T2-b 默认值,emit_ret 读 qt 决定 mov suffix)。
fn next_token_ret(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    // peek 下一字符决定 ret vs ret <val>
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_RET(), (*s).line);
    // v2.11.2:ret 没 dst → int_val = -1。
    let tp_iv = ptr_add_u8(t, 24 as i64) as *i64;
    *tp_iv = -(1 as i64);
    // qbe_type 默认 'w' (per T2-b,emit_ret 不 load %eax 是因为 qbe_type == 0)。
    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
    *tp_qt = QBE_W_LOCAL();
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 11. jmp ──
// dispatcher 已 consume 'j' (1 char);helper 消费剩余 "mp" 2 chars。
// v2.11.2 (T1-a):consume 到行尾 + lex_finish_instr。jmp 没 dst → int_val = -1。
fn next_token_jmp(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    let mut i: i64 = 0 as i64;
    while i < (2 as i64) {
        let _x2 = lex_next_byte(s);
        i = i + (1 as i64);
    }
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_JMP(), (*s).line);
    // v2.11.2:jmp 没 dst → int_val = -1。
    let tp_iv = ptr_add_u8(t, 24 as i64) as *i64;
    *tp_iv = -(1 as i64);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 12. jnz ──
// v2.11.2 (T1-a + T1-d):consume 到行尾 + lex_finish_instr。jnz 没 dst → int_val = -1。
// emit_jnz 真修 (T1-d) 后从 tok.text parse cond + 两 labels,不再 NULL deref。
fn next_token_jnz(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let _x = arena;
    let mut i: i64 = 0 as i64;
    while i < (2 as i64) {
        let _x2 = lex_next_byte(s);
        i = i + (1 as i64);
    }
    let _s = lex_skip_ws_and_comments(s);
    lex_init_token(t, ILTOK_JNZ(), (*s).line);
    // v2.11.2:jnz 没 dst → int_val = -1。
    let tp_iv = ptr_add_u8(t, 24 as i64) as *i64;
    *tp_iv = -(1 as i64);
    // consume 到行尾 + finish instr
    let _eol = lex_consume_to_eol(s);
    let _fin = lex_finish_instr(s, arena, t);
    return 0 as i32;
}

// ── 13. label ──
// 形态:`@<name>:`。dispatcher 已 consume '@'。
fn next_token_label(s: *LexState, arena: *u8, t: *u8) -> i32 {
    let label_start = (*s).cur;  // 当前指向 name[0]
    let label_len = lex_scan_ident_rest(s);
    // skip optional whitespace + ':'
    let _s = lex_skip_ws_and_comments(s);
    let _c = lex_match_byte(s, 58 as i32);  // ':'
    lex_init_token(t, ILTOK_LABEL(), (*s).line);
    if label_len > (0 as i64) {
        let tp_text = ptr_add_u8(t, 8 as i64) as **u8;
        *tp_text = lex_dup_text(arena, label_start, label_len);
        let tp_textlen = ptr_add_u8(t, 16 as i64) as *i64;
        *tp_textlen = label_len;
    }
    return 0 as i32;
}

// ── 14. func_header ──
// 形态:`export function [<qt>] $<name>(...) {`(dispatcher 已 consume "export")。
// v2.11.1 (W-074.5):QBE IL output 实测 emit `export function w $name(...)` bare qt
// 不带 brackets;既支持 `[w]` 也支持 bare `w`。
fn next_token_func_header(s: *LexState, arena: *u8, t: *u8) -> i32 {
    // consume "export" (already done by dispatcher)
    let _s = lex_skip_ws_and_comments(s);
    // "function"
    if lex_match_kw(s, "function" as *u8, 8 as i64) == 0 { return -1 as i32; }
    let _s2 = lex_skip_ws_and_comments(s);
    // 先 init token,再 optional qt 覆盖 qbe_type
    lex_init_token(t, ILTOK_FUNC_HEADER(), (*s).line);
    // optional qt:[w] 格式 或 bare w/l/s/d/b/h 字符(QBE IL always bare form per codegen.jhyy)
    if lex_peek_byte(s) == (91 as i32) {  // '['
        let _x = lex_next_byte(s);
        let qt_byte = lex_next_byte(s);
        let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
        *tp_qt = lex_qbe_type_from_byte(qt_byte);
        let _c = lex_next_byte(s);  // ']'
        let _s3 = lex_skip_ws_and_comments(s);
    } else {
        // bare qt letter (QBE IL output `export function w $name(...)`)
        let qt_byte = lex_peek_byte(s);
        if qt_byte == (119 as i32) || qt_byte == (108 as i32) || qt_byte == (115 as i32)
            || qt_byte == (100 as i32) || qt_byte == (98 as i32) || qt_byte == (104 as i32) {
            let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
            *tp_qt = lex_qbe_type_from_byte(qt_byte);
            let _x = lex_next_byte(s);
            let _s3 = lex_skip_ws_and_comments(s);
        }
    }
    // '$<name>'
    if lex_peek_byte(s) != (36 as i32) { return -1 as i32; }  // '$'
    let _x = lex_next_byte(s);
    let name_start = (*s).cur;
    let name_len = lex_scan_ident_rest(s);
    if name_len > (0 as i64) {
        let tp_text = ptr_add_u8(t, 8 as i64) as **u8;
        *tp_text = lex_dup_text(arena, name_start, name_len);
        let tp_textlen = ptr_add_u8(t, 16 as i64) as *i64;
        *tp_textlen = name_len;
    }
    // v2.11.1 W-074.5 真修延伸-6:consume `(args) {` 部分 — QBE IL 函数头格式
    // `export function <qt> $<name>(<args>) {<body>}`,lexer 拿到 FUNC_HEADER 后必须
    // 跳过 `<args>` + `{`,否则 dispatcher 看到 `(`/`,` 走 unknown-skip 卡死。
    // 形式:`(` ws arg ws (`,` ws arg)* ws `)` ws `{`(直接调 next_token 一次会 lex `{` 为 DIRECTIVE)
    let _sa = lex_skip_ws_and_comments(s);
    if lex_peek_byte(s) == (40 as i32) {  // '('
        let _lp = lex_next_byte(s);
        // 扫描到匹配的 ')' — 支持嵌套括号
        let mut depth: i64 = 1 as i64;
        let mut pdone = 0 as i32;
        while pdone == (0 as i32) {
            let pc = lex_peek_byte(s);
            if pc == (0 as i32) { pdone = 1 as i32; }
            else if pc == (40 as i32) { let _pc1 = lex_next_byte(s); depth = depth + (1 as i64); }
            else if pc == (41 as i32) {
                let _pc2 = lex_next_byte(s);
                depth = depth - (1 as i64);
                if depth <= (0 as i64) { pdone = 1 as i32; }
            } else { let _pc3 = lex_next_byte(s); }
        }
    }
    let _sb = lex_skip_ws_and_comments(s);
    // `{` 由 main dispatcher 走 next_token 一次 lex 为 DIRECTIVE — 不在此处 consume
    // (保持 lex_il 看到 `{` 还能记一次 DIRECTIVE token,parse_and_emit 不卡)
    return 0 as i32;
}

// ── 15. data_string ──
// 形态:`data $<name> = { b "..." }`。dispatcher 已 consume "data"。
// v2.11.1 (W-074.5 真修延伸-5):必须 consume 整个 ` = { b "..." , b 0 }` body,
// 否则 dispatcher 拿 `=` / `{` / `b` / `"` 等字符走 unknown-char-skip 循环,
// parse_and_emit 看到 EOF 后只剩 3 tokens,emit 函数从未被调,产生 0 字节 .s。
// 内存布局:emit_data_string 读 (*t).text (name) + (text + text_len + 1) (content)。
// 所以 text 缓冲 = "name\0content\0"。
fn next_token_data_string(s: *LexState, arena: *u8, t: *u8) -> i32 {
    // consume "data"
    let mut i: i64 = 0 as i64;
    while i < (4 as i64) {
        let _x = lex_next_byte(s);
        i = i + (1 as i64);
    }
    let _s = lex_skip_ws_and_comments(s);
    // '$<name>'
    if lex_peek_byte(s) != (36 as i32) { return -1 as i32; }  // '$'
    let _x = lex_next_byte(s);
    let name_start = (*s).cur;
    let name_len = lex_scan_ident_rest(s);
    // ── consume ` = { b "<content>"` ──
    let _s2 = lex_skip_ws_and_comments(s);
    if lex_peek_byte(s) != (61 as i32) { return -1 as i32; }  // '='
    let _eq = lex_next_byte(s);
    let _s3 = lex_skip_ws_and_comments(s);
    if lex_peek_byte(s) != (123 as i32) { return -1 as i32; }  // '{'
    let _br = lex_next_byte(s);
    let _s4 = lex_skip_ws_and_comments(s);
    if lex_peek_byte(s) != (98 as i32) { return -1 as i32; }  // 'b' (byte type indicator)
    let _bt = lex_next_byte(s);
    let _s5 = lex_skip_ws_and_comments(s);
    if lex_peek_byte(s) != (34 as i32) { return -1 as i32; }  // '"'
    let _q1 = lex_next_byte(s);
    let content_start = (*s).cur;
    // scan content until matching '"' or EOF
    let mut content_len: i64 = 0 as i64;
    let mut cdone = 0 as i32;
    while cdone == (0 as i32) {
        let cc = lex_peek_byte(s);
        if cc == (34 as i32) || cc == (0 as i32) { cdone = 1 as i32; }
        else {
            let _cn = lex_next_byte(s);
            content_len = content_len + (1 as i64);
        }
    }
    // consume closing '"'
    if lex_peek_byte(s) == (34 as i32) { let _q2 = lex_next_byte(s); }
    // skip 直到 '}' (吞掉 `, b 0`)
    let mut bdone = 0 as i32;
    while bdone == (0 as i32) {
        let cc2 = lex_peek_byte(s);
        if cc2 == (125 as i32) || cc2 == (0 as i32) { bdone = 1 as i32; }
        else { let _bn = lex_next_byte(s); }
    }
    if lex_peek_byte(s) == (125 as i32) { let _cl = lex_next_byte(s); }
    // ── build text buffer: name\0content\0 ──
    let total: i64 = name_len + (1 as i64) + content_len + (1 as i64);
    let text_buf = arena_alloc(arena, total);
    if text_buf == (0 as *u8) { return -1 as i32; }
    if name_len > (0 as i64) {
        let _m1 = memcpy(text_buf, name_start, name_len);
    }
    let sep_ptr = ptr_add_u8(text_buf, name_len);
    let _m2 = memset(sep_ptr, 0 as i32, 1 as i64);
    if content_len > (0 as i64) {
        let content_dst = ptr_add_u8(text_buf, name_len + (1 as i64));
        let _m3 = memcpy(content_dst, content_start, content_len);
    }
    let term_ptr = ptr_add_u8(text_buf, name_len + (1 as i64) + content_len);
    let _m4 = memset(term_ptr, 0 as i32, 1 as i64);
    // ── write token fields ──
    lex_init_token(t, ILTOK_DATA_STRING(), (*s).line);
    let tp_text = ptr_add_u8(t, 8 as i64) as **u8;
    *tp_text = text_buf;
    let tp_textlen = ptr_add_u8(t, 16 as i64) as *i64;
    *tp_textlen = name_len;
    return 0 as i32;
}

// ── 16. volatile keyword ──
// 出现在 load/store 前;main dispatcher 看到 next token kind == ILTOK_LOAD/ILTOK_STORE
// 时,先回退 cursor → 二次调用 lex peek "volatile" → 若匹配,改 load/store tok 的 qbe_type
// = QBE_VOLATILE_MARKER (-1)。本 helper 只判 volatile 是否出现,不写 token。
//
// 返回:1 = matched volatile;0 = no match。
fn lex_match_volatile(s: *LexState) -> i32 {
    if lex_match_kw(s, "volatile" as *u8, 8 as i64) == 0 {
        return 0 as i32;
    }
    return 1 as i32;
}

// ════════════════════════════════════════════════════
// Main dispatcher:next_token
// ════════════════════════════════════════════════════
//
// 输入:s (*LexState), arena (*u8 = *Arena)
// 输出:t (*ILToken, caller 栈分配)
// 返回:0 成功;<0 错误(目前 lexer 不返错 — 不识别的字符停在 t.kind = EOF)

fn next_token(s: *LexState, arena: *u8, t: *u8) -> i32 {
    // skip ws + comments
    let _s = lex_skip_ws_and_comments(s);

    // EOF check
    if (*s).cur >= (*s).end {
        return next_token_eof(s, t);
    }
    let c0 = lex_peek_byte(s);

    // v2.11.2 (W-074.6 T1-a): capture instr_start at first non-ws char。
    // 所有 op branches (含 '%' recursive dispatch) 继承此值;helper 末尾通过
    // lex_finish_instr 用 [instr_start..cur) 填 tok.text/text_len。
    (*s).instr_start = (*s).cur;

    // ── '@' → label ──
    if c0 == (64 as i32) {  // '@'
        let _x = lex_next_byte(s);
        return next_token_label(s, arena, t);
    }

    // ── '%' → assignment LHS (e.g. "%t1 =w add ...")。
    // QBE IL 中每条具名 instruction 都以 `%tN =qt op` 起。dispatcher 不细化
    // LHS,直接 consume '%' + ident + 空白 + '=' + qt,然后回到主循环 dispatch op。
    // v2.11.1 (W-074.5 真修延伸-3):emit_copy / emit_binop / emit_call / emit_phi 等
    // 读 tok.text_len 当 dst temp id,必须从 ident "tN" 解析 N 后存 text_len。
    // v2.11.2 (W-074.6 T1-a):dst temp id 改存 int_val(text_len 留给 instruction slice 长度)。
    if c0 == (37 as i32) {  // '%'
        let _x = lex_next_byte(s);
        let ident_start = (*s).cur;
        let ident_len = lex_scan_ident_rest(s);
        let _s2 = lex_skip_ws_and_comments(s);
        // peek '='
        if lex_peek_byte(s) == (61 as i32) {
            let _x2 = lex_next_byte(s);
            let _s3 = lex_skip_ws_and_comments(s);
            // peek qt letter (w/l/s/d) — saved in tok.qbe_type
            let qt_byte = lex_peek_byte(s);
            let qt_val = lex_qbe_type_from_byte(qt_byte);
            let _x3 = lex_next_byte(s);
            let _s4 = lex_skip_ws_and_comments(s);
            // 现在 cursor 指向 op keyword;递归调 next_token,但预填 qbe_type。
            // 注:caller 在 dispatch 后会读 tok.qbe_type,所以我们写一个 inline dispatch。
            // 简化:emit 函数只看 tok.qbe_type(对有 dst 的 op),所以这里存 qbe_type 后
            // 调通用 dispatcher。
            let saved_cur = (*s).cur;
            let saved_line = (*s).line;
            let rc = next_token(s, arena, t);
            // overwrite qbe_type + fill int_val (= dst temp id, per v2.11.2 contract)
            if rc == (0 as i32) {
                let cur_kind_addr = t as *i32;
                let cur_kind = *cur_kind_addr;
                if cur_kind != ILTOK_EOF() {
                    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
                    *tp_qt = qt_val;
                    // v2.11.2: parse dst temp id from ident "tN" → N, store in int_val
                    // (was text_len per v2.11.1). Per _emit_mem.jhyy:34 documented contract,
                    // int_val = dst temp id; text_len = slice length.
                    // ident format: starts with 't' (QBE convention), followed by digits.
                    // If ident doesn't start with 't' or has no digits, dst_id = 0 (fallback).
                    let dst_id = lex_parse_temp_id_from_ident(ident_start, ident_len);
                    let tp_iv = ptr_add_u8(t, 24 as i64) as *i64;
                    *tp_iv = dst_id;
                }
            }
            return rc;
        }
        return -1 as i32;
    }

    // ── '$' → 通常是 func name / data name。emit 函数 (A4 call / A3 data_string)
    // 自己二次 scan。我们只看 '$' 起头决定 kind — 但 func/data 由 'export'/'data'
    // keyword 先行 dispatch,所以裸 '$' 是 phi/call/...里的 name,L4 emit 函数
    // 自己读 text。我们这里把 '$' 当作纯字符,emit 函数 (caller 路径) 配 L4
    // § 2.3 function-level parse loop 二次 scan 即可。
    // 当前 lexer dispatcher 对 '$' 不特别处理:留给 `call` / `data` / `func_header`
    // helper 内部自己 scan(它们的 dispatcher 路径已对应 `$` 起头)。

    // ── 'e' → 'export' (func_header) ──
    if c0 == (101 as i32) {
        if lex_match_kw(s, "export" as *u8, 6 as i64) == 0 { return -1 as i32; }
        return next_token_func_header(s, arena, t);
    }

    // ── 'd' → 'data' (data_string) / 'div' (binop) / 'dbgfile' / 'dbgloc' (DIRECTIVE) ──
    if c0 == (100 as i32) {
        let n1 = lex_peek_byte_at(s, 1 as i64);
        let n2 = lex_peek_byte_at(s, 2 as i64);
        let n3 = lex_peek_byte_at(s, 3 as i64);
        // "data"
        if n1 == (97 as i32) && n2 == (116 as i32) && n3 == (97 as i32) {
            return next_token_data_string(s, arena, t);
        }
        // "div"
        if n1 == (105 as i32) && n2 == (118 as i32) {
            let _x = lex_next_byte(s);  // 'd'
            return next_token_binop(s, arena, t, 100 as i32);
        }
        // v2.11.1 (W-074.5): "dbgfile" (7 chars) / "dbgloc" (6 chars) → ILTOK_DIRECTIVE
        // QBE IL output `dbgfile "path"` 和 `dbgloc N "file:line"` always at line head;
        // consume 关键字 + skip rest-of-line 让 parse_and_emit 下一个 token 直接是 export/data。
        // dbgfile prefix: d,b,g,f (n3='f'=102). dbgloc prefix: d,b,g,l (n3='l'=108).
        if n1 == (98 as i32) && n2 == (103 as i32) && n3 == (102 as i32) {
            // "dbgfile" — d,b,g,f,i,l,e (idx 0..6); need n4='i' n5='l' n6='e'
            let n4 = lex_peek_byte_at(s, 4 as i64);
            let n5 = lex_peek_byte_at(s, 5 as i64);
            let n6 = lex_peek_byte_at(s, 6 as i64);
            if n4 == (105 as i32) && n5 == (108 as i32) && n6 == (101 as i32) {
                let mut j: i64 = 0 as i64;
                while j < (7 as i64) {
                    let _x = lex_next_byte(s);
                    j = j + (1 as i64);
                }
                // skip 到行尾(\n 或 文件尾),不 consume \n 让 lex_skip_ws_and_comments 处理
                let mut done_skip = 0 as i32;
                while done_skip == (0 as i32) {
                    let cc = lex_peek_byte(s);
                    if cc == (10 as i32) || cc == (0 as i32) { done_skip = 1 as i32; }
                    else { let _x2 = lex_next_byte(s); }
                }
                lex_init_token(t, ILTOK_DIRECTIVE(), (*s).line);
                return 0 as i32;
            }
        }
        if n1 == (98 as i32) && n2 == (103 as i32) && n3 == (108 as i32) {
            // "dbgloc" — d,b,g,l,o,c (idx 0..5); need n4='o'=111 n5='c'=99
            let n4 = lex_peek_byte_at(s, 4 as i64);
            let n5 = lex_peek_byte_at(s, 5 as i64);
            if n4 == (111 as i32) && n5 == (99 as i32) {
                let mut j: i64 = 0 as i64;
                while j < (6 as i64) {
                    let _x = lex_next_byte(s);
                    j = j + (1 as i64);
                }
                let mut done_skip = 0 as i32;
                while done_skip == (0 as i32) {
                    let cc = lex_peek_byte(s);
                    if cc == (10 as i32) || cc == (0 as i32) { done_skip = 1 as i32; }
                    else { let _x2 = lex_next_byte(s); }
                }
                lex_init_token(t, ILTOK_DIRECTIVE(), (*s).line);
                return 0 as i32;
            }
        }
        return -1 as i32;
    }

    // ── 'r' → 'ret' ──
    if c0 == (114 as i32) {
        if lex_match_kw(s, "ret" as *u8, 3 as i64) == 0 { return -1 as i32; }
        return next_token_ret(s, arena, t);
    }

    // ── 'j' → 'jmp' / 'jnz' ──
    if c0 == (106 as i32) {
        let n1 = lex_peek_byte_at(s, 1 as i64);
        let n2 = lex_peek_byte_at(s, 2 as i64);
        if n1 == (109 as i32) && n2 == (112 as i32) {
            // "jmp"
            let _x = lex_next_byte(s);
            return next_token_jmp(s, arena, t);
        }
        if n1 == (110 as i32) && n2 == (122 as i32) {
            // "jnz"
            let _x = lex_next_byte(s);
            return next_token_jnz(s, arena, t);
        }
        return -1 as i32;
    }

    // ── 'c' → 'call' / 'copy' / compare ops (csltw, cslew, csgtw, csgew, ceqw, cnew, cultw, culew, cugtw, cugew) ──
    if c0 == (99 as i32) {
        let n1 = lex_peek_byte_at(s, 1 as i64);
        if n1 == (97 as i32) && lex_peek_byte_at(s, 2 as i64) == (108 as i32)
            && lex_peek_byte_at(s, 3 as i64) == (108 as i32) {
            // "call"
            let _x = lex_next_byte(s);
            return next_token_call(s, arena, t);
        }
        if n1 == (111 as i32) && lex_peek_byte_at(s, 2 as i64) == (112 as i32)
            && lex_peek_byte_at(s, 3 as i64) == (121 as i32) {
            // "copy"
            let _x = lex_next_byte(s);
            return next_token_copy(s, arena, t);
        }
        // v2.11.1 (W-074.5 真修延伸-7):QBE IL compare ops cXXX<suffix> 5-char keyword
        // starting with 'c'. QBE integer compare prefixes: 's' (signed) / 'u' (unsigned) /
        // 'e' (eq). Long/single/double variants 同 pattern with suffix 'l'/'s'/'d'.
        // Examples: csltw, cslew, csgtw, csgew, ceqw, cnew, cultw, culew, cugtw, cugew.
        // Boundary: 5th char (idx 4) must be a QBE type suffix 'w'/'l'/'s'/'d'.
        if n1 == (115 as i32) || n1 == (117 as i32) || n1 == (101 as i32) {
            let n2 = lex_peek_byte_at(s, 2 as i64);
            let n3 = lex_peek_byte_at(s, 3 as i64);
            let n4 = lex_peek_byte_at(s, 4 as i64);
            // QBE compare op: c + (s|u|e) + (lt|gt|le|ge|eq|ne) + (w|l|s|d)
            // 简化:5th char 必须是 type suffix
            if n4 == (119 as i32) || n4 == (108 as i32)
                || n4 == (115 as i32) || n4 == (100 as i32) {
                // consume 5 chars total (dispatcher 不 consume,这里全 consume)
                let mut j: i64 = 0 as i64;
                while j < (5 as i64) {
                    let _x = lex_next_byte(s);
                    j = j + (1 as i64);
                }
                let _s = lex_skip_ws(s);  // v2.11.2:不跨 '\n'
                lex_init_token(t, ILTOK_BINOP(), (*s).line);
                // text = "csltw" / "cslew" / "ceqw" / "cnew" / "cultw" / ... (5 chars)
                let mut op_str: *u8 = "csltw" as *u8;
                if n1 == (117 as i32) {
                    if n2 == (108 as i32) { op_str = "cultw" as *u8; }
                    else if n2 == (101 as i32) { op_str = "cueqw" as *u8; }
                    else if n2 == (110 as i32) { op_str = "cunew" as *u8; }
                    else if n2 == (103 as i32) && n3 == (116 as i32) { op_str = "cugtw" as *u8; }
                    else if n2 == (103 as i32) && n3 == (101 as i32) { op_str = "cugew" as *u8; }
                    else if n2 == (108 as i32) && n3 == (101 as i32) { op_str = "culew" as *u8; }
                } else if n1 == (101 as i32) {
                    if n2 == (113 as i32) { op_str = "ceqw" as *u8; }
                    else if n2 == (110 as i32) { op_str = "cnew" as *u8; }
                } else {
                    if n2 == (108 as i32) && n3 == (116 as i32) { op_str = "csltw" as *u8; }
                    else if n2 == (108 as i32) && n3 == (101 as i32) { op_str = "cslew" as *u8; }
                    else if n2 == (103 as i32) && n3 == (116 as i32) { op_str = "csgtw" as *u8; }
                    else if n2 == (103 as i32) && n3 == (101 as i32) { op_str = "csgew" as *u8; }
                }
                // v2.11.2 (W-074.6 T1-a 真修): csltw/cslew/.../cugew 比较 op dispatcher
                // 之前漏 lex_consume_to_eol + lex_finish_instr,留 "%t1, %t2" 在 buffer
                // → 下一次 next_token 把 "%t1" 误 tokenize,后续整个 QBE IL 对齐错位。
                // 现在 consume 到 EOL + finish instr 让 [c..eol) 整条 slice 进 tok.text,
                // emit_binop 能二次 scan operands。
                let _eol = lex_consume_to_eol(s);
                let _fin = lex_finish_instr(s, arena, t);
                let _opname = op_str;
                let _arena = arena;
                return 0 as i32;
            }
        }
        return -1 as i32;
    }

    // ── 'p' → 'phi' ──
    if c0 == (112 as i32) {
        if lex_match_kw(s, "phi" as *u8, 3 as i64) == 0 { return -1 as i32; }
        return next_token_phi(s, arena, t);
    }

    // ── 'a' → 'add' (binop) or 'alloc' (alloc) ──
    if c0 == (97 as i32) {
        let n1 = lex_peek_byte_at(s, 1 as i64);
        if n1 == (100 as i32) && lex_peek_byte_at(s, 2 as i64) == (100 as i32) {
            // "add"
            let _x = lex_next_byte(s);
            return next_token_binop(s, arena, t, 97 as i32);
        }
        if n1 == (108 as i32) {  // 'l' → alloc
            // match "alloc"
            if lex_match_kw(s, "alloc" as *u8, 5 as i64) == 0 { return -1 as i32; }
            return next_token_alloc(s, arena, t);
        }
        return -1 as i32;
    }

    // ── 's' → 'sub' (binop) or 'store*' ──
    if c0 == (115 as i32) {
        let n1 = lex_peek_byte_at(s, 1 as i64);
        if n1 == (117 as i32) && lex_peek_byte_at(s, 2 as i64) == (98 as i32) {
            // "sub"
            let _x = lex_next_byte(s);
            return next_token_binop(s, arena, t, 115 as i32);
        }
        // "storew" / "storel" / "stores" / "stored"
        if n1 == (116 as i32) {
            let n2 = lex_peek_byte_at(s, 2 as i64);
            let n3 = lex_peek_byte_at(s, 3 as i64);
            let n4 = lex_peek_byte_at(s, 4 as i64);
            let n5 = lex_peek_byte_at(s, 5 as i64);
            if n2 == (111 as i32) && n3 == (114 as i32) && n4 == (101 as i32) {
                if n5 == (119 as i32) || n5 == (108 as i32)
                    || n5 == (115 as i32) || n5 == (100 as i32) {
                    let _x = lex_next_byte(s);  // 's'
                    return next_token_store(s, arena, t, n5);
                }
            }
        }
        return -1 as i32;
    }

    // ── 'm' → 'mul' / 'mod' (binop) ──
    if c0 == (109 as i32) {
        let _x = lex_next_byte(s);
        return next_token_binop(s, arena, t, 109 as i32);
    }

    // ── 'l' → 'loadw'/'loadl'/'loads'/'loadd' or 'loadsb/ub/sh/uh' ──
    if c0 == (108 as i32) {
        // match "load" + 1 char
        if lex_match_kw(s, "load" as *u8, 4 as i64) == 0 { return -1 as i32; }
        let qt = lex_peek_byte(s);
        // 's' 'u' → loadsubword prefix;MUST check loadsb/ub/sh/uh FIRST
        //(loadsb 的 qt=='s' 也会落入下方 loadw/loads/loadd 检查导致误分类)
        if qt == (115 as i32) || qt == (117 as i32) {
            // need another letter to disambiguate from loads/loadu(?)
            // QBE loadsb/loadub/loadsh/loaduh: after "loads"/"loadu" come b/h
            let n1 = lex_peek_byte_at(s, 1 as i64);
            if n1 == (98 as i32) || n1 == (104 as i32) {
                // yes loadsb/loadub/loadsh/loaduh
                return next_token_loadsub(s, arena, t);
            }
        }
        if qt == (119 as i32) || qt == (108 as i32)
            || qt == (115 as i32) || qt == (100 as i32) {
            return next_token_load(s, arena, t, qt);
        }
        return -1 as i32;
    }

    // ── 'v' → 'volatile' keyword ──
    if c0 == (118 as i32) {
        if lex_match_kw(s, "volatile" as *u8, 8 as i64) == 0 { return -1 as i32; }
        let _s2 = lex_skip_ws_and_comments(s);
        // 必跟 load/store — peek next token kind 来判定
        // 简化:peek 第一个字符 'l' (load) 或 's' (store)
        let next_c = lex_peek_byte(s);
        if next_c == (108 as i32) {
            // load* family — 4 个变体: loadw/loadl/loads/loadd + loadsb/loadub/loadsh/loaduh
            // peek 第 5 字符(loadsb 的 's' 后是 'b','u' 后是 'b'/'h') 决定 ILTOK_LOAD vs ILTOK_LOADSUB
            let l1 = lex_peek_byte_at(s, 1 as i64);
            let l2 = lex_peek_byte_at(s, 2 as i64);
            let l3 = lex_peek_byte_at(s, 3 as i64);
            let l4 = lex_peek_byte_at(s, 4 as i64);
            let l5 = lex_peek_byte_at(s, 5 as i64);
            // check "loadsb|loadub|loadsh|loaduh" FIRST (more specific prefix)
            if (l1 == (111 as i32)) && (l2 == (97 as i32)) && (l3 == (100 as i32)) {
                if l4 == (115 as i32) || l4 == (117 as i32) {
                    if l5 == (98 as i32) || l5 == (104 as i32) {
                        // match "loadsb/ub/sh/uh" 6 chars total
                        let mut i: i64 = 0 as i64;
                        while i < (6 as i64) {
                            let _x = lex_next_byte(s);
                            i = i + (1 as i64);
                        }
                        let _a = arena;
                        lex_init_token(t, ILTOK_LOADSUB(), (*s).line);
                        let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
                        *tp_qt = QBE_VOLATILE_MARKER();
                        return 0 as i32;
                    }
                }
            }
            // check "loadw/loadl/loads/loadd"
            if (l1 == (111 as i32)) && (l2 == (97 as i32)) && (l3 == (100 as i32)) {
                if l4 == (119 as i32) || l4 == (108 as i32)
                    || l4 == (115 as i32) || l4 == (100 as i32) {
                    // match "load" 4 chars
                    let mut i: i64 = 0 as i64;
                    while i < (4 as i64) {
                        let _x = lex_next_byte(s);
                        i = i + (1 as i64);
                    }
                    let _x = lex_next_byte(s);  // consume qt byte
                    lex_init_token(t, ILTOK_LOAD(), (*s).line);
                    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
                    *tp_qt = QBE_VOLATILE_MARKER();
                    let _a = arena;
                    return 0 as i32;
                }
            }
            return -1 as i32;
        }
        if next_c == (115 as i32) {
            // store* family — storew/storel/stores/stored
            let s1 = lex_peek_byte_at(s, 1 as i64);
            let s2 = lex_peek_byte_at(s, 2 as i64);
            let s3 = lex_peek_byte_at(s, 3 as i64);
            let s4 = lex_peek_byte_at(s, 4 as i64);
            let s5 = lex_peek_byte_at(s, 5 as i64);
            if (s1 == (116 as i32)) && (s2 == (111 as i32)) && (s3 == (114 as i32))
                && (s4 == (101 as i32)) {
                if s5 == (119 as i32) || s5 == (108 as i32)
                    || s5 == (115 as i32) || s5 == (100 as i32) {
                    // match "store" 5 chars
                    let mut i: i64 = 0 as i64;
                    while i < (5 as i64) {
                        let _x = lex_next_byte(s);
                        i = i + (1 as i64);
                    }
                    let _x = lex_next_byte(s);  // consume qt byte
                    lex_init_token(t, ILTOK_STORE(), (*s).line);
                    let tp_qt = ptr_add_u8(t, 32 as i64) as *i32;
                    *tp_qt = QBE_VOLATILE_MARKER();
                    let _a = arena;
                    return 0 as i32;
                }
            }
            return -1 as i32;
        }
        return -1 as i32;
    }

    // ── '{' / '}' → ILTOK_DIRECTIVE ── (v2.11.1 W-074.5 真修)
    // QBE IL output 用 {} 包函数体 + data body;不 emit .s body,只是 lexer 哨兵让 parse_and_emit 不卡 cursor。
    if c0 == (123 as i32) {  // '{'
        let _x = lex_next_byte(s);
        lex_init_token(t, ILTOK_DIRECTIVE(), (*s).line);
        return 0 as i32;
    }
    if c0 == (125 as i32) {  // '}'
        let _x = lex_next_byte(s);
        lex_init_token(t, ILTOK_DIRECTIVE(), (*s).line);
        return 0 as i32;
    }

    // unknown char — caller 决定如何处理
    return -1 as i32;
}

// ════════════════════════════════════════════════════
// Public API
// ════════════════════════════════════════════════════
//
// lex_il — 全文件 lex,返回 *ILToken 数组 (arena-alloc)。
// 最后一个 token 必为 ILTOK_EOF(per L4 § 4.1 接口契约)。
//
// 大小预估:每条 IL instruction 平均 ~3 tokens (op + 2 operands)。
// 5 byte-equal test 用例最复杂 mixed.jhyy < 200 instructions;
// 用 1024 个 token slot (8 * 1024 = 8KB) 足够覆盖。不足则 abort 返 0。
//
// 输入:buf = 全 .il 字节;len = 字节长度;arena = arena 指针(供 strdup + alloc)。
// 返回:*ILToken 数组 (caller 通过 lex_il_count 拿长度)。

fn lex_il(buf: *u8, len: i64, arena: *u8) -> *u8 {
    // v2.11.2 (W-074.6 T5-a): slots 1024 → 16384。big_test.il ~3000+ tokens 截断;
    // 16384 × 40 bytes = 640 KB,arena 8 MB 充足。
    let slots: i64 = 16384 as i64;
    let arr = arena_alloc(arena, slots * (40 as i64));
    if arr == (0 as *u8) {
        return 0 as *u8;
    }
    // heap-allocated LexState (per main.jhyy pattern: malloc + cast)
    // LexState struct size: ptr+ptr+ptr+i32+i64+ptr = 8+8+8+4+8+8 = 44 → round up 64 (8-byte aligned)
    // v2.11.2: 加 instr_start 字段(6 字段 vs 原 5 字段)。
    let s_buf = malloc(64 as i64);
    memset(s_buf, 0 as i32, 64 as i64);
    let s = s_buf as *LexState;
    (*s).buf = buf;
    (*s).end = ptr_add_u8(buf, len);
    (*s).cur = buf;
    (*s).line = 1 as i32;
    (*s).count = 0 as i64;
    (*s).instr_start = buf;  // v2.11.2:init to buf, 任何 op 起点会 overwrite
    let mut i: i64 = 0 as i64;
    let mut done = 0 as i32;
    while done == (0 as i32) {
        if i >= slots { done = 1 as i32; }
        else {
            let tok = ptr_add_u8(arr, i * (40 as i64));
            let rc = next_token(s, arena, tok);
            if rc < (0 as i32) {
                // error: skip 1 byte,继续(避免死循环)
                let cc = lex_peek_byte(s);
                if cc == 0 { done = 1 as i32; }
                else { let _x = lex_next_byte(s); }
            } else {
                let kind_addr = tok as *i32;
                let kind = *kind_addr;
                if kind == ILTOK_EOF() { done = 1 as i32; }
                i = i + (1 as i64);
            }
        }
    }
    let _f = free(s_buf);
    return arr;
}

// lex_il_count — 返回 token 数(扫数组找第一个 ILTOK_EOF)。
// v2.11.2 (T5-a): cap 1024 → 16384,与 lex_il slots 一致。
fn lex_il_count(arr: *u8) -> i64 {
    if arr == (0 as *u8) { return 0 as i64; }
    let mut n: i64 = 0 as i64;
    let mut done = 0 as i32;
    while done == (0 as i32) {
        if n >= (16384 as i64) { done = 1 as i32; }
        else {
            let tok = ptr_add_u8(arr, n * (40 as i64));
            let kind_addr = tok as *i32;
            let kind = *kind_addr;
            if kind == ILTOK_EOF() { done = 1 as i32; }
            else { n = n + (1 as i64); }
        }
    }
    return n;
}

// main_jhyy — 编译验证入口(lexer 是 leaf module;本身无 main 行为)。
// 存在仅为让 jhyy_compile 通过(leaf module 无 fn main_jhyy 会 compile fail)。
// 实际功能由 codegen_amd64.jhyy main entry 通过 lex_il() 调用。
fn main_jhyy() -> i32 {
    return 0 as i32;
}
