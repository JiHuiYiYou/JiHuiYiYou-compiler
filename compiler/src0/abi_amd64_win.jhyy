// abi_amd64_win.jhyy — v2.1.0 Stage 1c mirror of compiler/src/target/abi_amd64_win.c
//
// Mirrors the C-side ABI extraction. All 5 ABI functions (classify_arg /
// emit_function_header / emit_return / emit_call_prelude /
// emit_struct_arg_slot + emit_struct_copy) live here.
//
// Note: lives flat in compiler/src0/ (not in a subdir) — jhyy import
// syntax doesn't support paths with `/` (parser only accepts flat
// module names per `parse_import_decl` codegen.c:731).
//
// Scope (per docs/plans/v2/v2.1.0详细实现方案.md § 1.4):
//   JHYY emits QBE IL, not raw x64. QBE handles rcx/rdx/r8/r9 register
//   allocation, 32-byte shadow space, frame layout, callee-saved register
//   save/restore. The compiler only owns signature construction +
//   struct-arg copy patterns.

import types;
import ir;
import ast;  // for Sym (used by emit_function_header)
import symtab;
import arena;  // for arena_alloc (used by emit_call_prelude)

// ════════════════════════════════════════════
// Stage 1c.1: abi_win_classify_arg
// ════════════════════════════════════════════
//
// Returns QBE type letter (i32) for a JHYY Type*. Behaviour byte-equal
// to the inline ternary previously in cg_func (codegen.jhyy:3701-3720,
// 3776-3780). Single source of truth for signature type-letter selection.
//
// Returns:
//   QBE_L() for KIND_STRUCT / KIND_ARRAY / KIND_ENUM with size > 4
//   QBE_W() for KIND_ENUM with size <= 4 (delegates to qbe_type_of)
//   0       for KIND_VOID (delegates)
//   qbe_type_of(t) for KIND_PRIMITIVE / POINTER / SLICE / FUNC / unknown

fn abi_win_classify_arg(t_raw: *u8) -> i32 {
    if t_raw == (0 as *u8) {
        return QBE_W();
    }
    let t = t_raw as *Type;
    let kind = (*t).kind;
    if kind == KIND_STRUCT() {
        return QBE_L();
    }
    if kind == KIND_ARRAY() {
        return QBE_L();
    }
    if kind == KIND_ENUM() {
        // W-007 fix: large enums (>4 bytes size) by slot pointer
        if (*t).size > (4 as i64) {
            return QBE_L();
        }
        return QBE_W();
    }
    // Delegate: KIND_PRIMITIVE / POINTER / SLICE / FUNC / VOID / unknown
    return qbe_type_of(t_raw);
}

// ════════════════════════════════════════════
// Stage 1c.2: abi_win_emit_function_header
// ════════════════════════════════════════════
//
// Emit QBE signature line + @start label. Replaces cg_func lines 3677-3723
// (the inline header block). Caller (cg_func) pre-computes ret_qt via
// abi_win_classify_arg and passes it in; this function only owns the
// `export function ... {` + `) {` + `@start` emission.
//
// Behaviour byte-equal to the prior inline block:
//   - `export function [<ret_qt>] $mod__name(l %ret, <pt1> %p1, ...) {`
//   - mangled name: "$mod__name" if sym has module, else "$name"
//   - sret prepends hidden `l %ret` as first parameter
//   - @start label follows `{` (QBE requires entry label)
//   - `%c %` sprintf workaround: 2 emits (qbe_type_letter + " " + "%" + name)

// Emit "$mod__name" if sym has module, else "$name". Equivalent to the
// (now-removed) `emit_mangled_name` in codegen.jhyy:478. Kept here as an
// abi-internal helper to avoid a circular codegen ↔ abi import.
fn abi_win_emit_mangled_name(ir: *IRBuf, sym_raw: *u8) -> i32 {
    let sym = sym_raw as *Sym;
    if (*sym).module != (0 as *u8) {
        ir_emit_str(ir, "$" as *u8);
        ir_emit_str(ir, (*sym).module);
        ir_emit_str(ir, "__" as *u8);
        ir_emit_str(ir, (*sym).name);
    } else {
        ir_emit_str(ir, "$" as *u8);
        if (*sym).name != (0 as *u8) {
            ir_emit_str(ir, (*sym).name);
        } else {
            ir_emit_str(ir, "?" as *u8);
        }
    }
    return 1;
}

fn abi_win_emit_function_header(
    ir: *IRBuf,
    fn_sym: *Sym,
    ret_qt: i32,
    is_sret: i32,
    params: *u8,    // *NodeFuncDeclParam
    nparams: i64
) -> i32 {
    ir_emit_str(ir, "export function " as *u8);
    if ret_qt != (0 as i32) {
        ir_emit_int(ir, "%c " as *u8, ret_qt);
    }
    abi_win_emit_mangled_name(ir, fn_sym as *u8);
    ir_emit_str(ir, "(" as *u8);
    let mut first: i32 = 1;
    if is_sret != 0 {
        ir_emit_str(ir, "l %ret" as *u8);
        first = 0;
    }
    let mut pi: i64 = 0 as i64;
    while pi < nparams {
        if first == 0 {
            ir_emit_str(ir, ", " as *u8);
        }
        first = 0;
        let param_slot = ptr_add_u8(params, pi * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
        let p_sym_raw = (*param_slot).sym;
        let p_sym = p_sym_raw as *Sym;
        let mut pt: *u8 = 0 as *u8;
        if (*p_sym).type_ptr != (0 as *u8) {
            pt = (*p_sym).type_ptr;
        }
        if pt != (0 as *u8) {
            let pqt = abi_win_classify_arg(pt);
            // v0 codegen bug workaround: 不能用 "%c %"（sprintf 把末尾 literal % 吃掉）
            // 拆成 2 个 emit：先 "<pqt> " + "%" + name
            ir_emit_int(ir, "%c " as *u8, pqt);
            ir_emit_str(ir, "%" as *u8);
        } else {
            ir_emit_str(ir, "w %" as *u8);
        }
        ir_emit_str(ir, (*p_sym).name);
        pi = pi + (1 as i64);
    }
    ir_emit_str(ir, ") {\n" as *u8);
    let start_block = *ir_new_block(ir, "start" as *u8);
    ir_emit_label(ir, start_block);
    return 1;
}

// v3.0.2 (3b naked): emit_naked_func_header — no QBE IR emitted at all.
// The naked fn lives only in the side-file (_inline_asm.buf). main.jhyy
// concatenates side-file to .s, so the .s has the full naked function
// (`.globl mangled\nmangled:\n<asm body>`).
// Body asm!() statements get appended via cg_expr NODE_ASM_BLOCK.
// We DON'T use QBE for naked fns — QBE would emit a `ret` and conflict with
// the side-file's raw `mangled:` label (multiple definition at link time).
fn emit_naked_func_header(ir: *IRBuf, fn_sym: *Sym) -> i32 {
    let buf_path = "compiler/build/obj/_inline_asm.buf" as *u8;
    let fp = fopen(buf_path, "ab" as *u8);
    if fp != (0 as *u8) {
        let _w1 = fwrite(".globl " as *u8, 1 as i64, 7 as i64, fp);
        let _w2 = fwrite((*fn_sym).name, 1 as i64, strlen((*fn_sym).name), fp);
        let _w3 = fwrite("\n" as *u8, 1 as i64, 1 as i64, fp);
        let _w4 = fwrite((*fn_sym).name, 1 as i64, strlen((*fn_sym).name), fp);
        let _w5 = fwrite(":\n" as *u8, 1 as i64, 2 as i64, fp);
        let _c = fclose(fp);
    }
    let _i = ir;  // unused (kept for symmetry with other emit_*_header fns)
    return 1 as i32;
}

// ════════════════════════════════════════════
// Stage 1c.3: abi_win_emit_return
// ════════════════════════════════════════════
//
// Emit QBE `ret` instruction per the 3-way decision (mirrors C-side
// Stage 1a.3):
//   - is_sret=1         → empty `ret` (caller already wrote struct to sret slot)
//   - val.qbe_type != 0 → `ret <val>` (non-void value return)
//   - val.qbe_type == 0 → empty `ret` (void / sentinel)
//
// Replaces 4 cg_stmt NODE_RETURN sites + 3 cg_func trailing sites in
// codegen.jhyy (note: 4 cg_stmt sites because jhyy split the sret+void
// branch into a separate ir_emit_str path; functionally identical to
// `ir_emit_ret(sentinel)` since sentinel.qbe_type=0 → empty ret).
//
// All 7 call sites byte-equal to prior inline emission.

fn abi_win_emit_return(ir: *IRBuf, val: IRVal, is_sret: i32) -> i32 {
    if is_sret != 0 {
        let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let _r = ir_emit_ret(ir, v);
    } else if val.qbe_type != (0 as i32) {
        let _r = ir_emit_ret(ir, val);
    } else {
        let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let _r = ir_emit_ret(ir, v);
    }
    return 1;
}

// ════════════════════════════════════════════
// Stage 1c.4: abi_win_emit_call_prelude
// ════════════════════════════════════════════
//
// Alloc args buffer + sret return slot (if struct return). Mirrors
// C-side abi_win_emit_call_prelude. Replaces 2 prelude blocks in
// cg_expr NODE_CALL (codegen.jhyy:2350-2363 + 2445-2460) and
// NODE_QUALIFIED_CALL (codegen.jhyy:2532-2545 + 2621-2635).
//
// Behaviour byte-equal to the prior inline code:
//   - is_sret=1: alloc ret_slot (`alloc8 <rsize>`), args buffer of
//     size nargs+1, args[0] = ret_slot
//   - is_sret=0: args buffer of size nargs (or NULL if nargs=0)
//   - non-sret returns ret_slot = sentinel IRVal{qbe_type=0}
//
// arena is *u8 (forward-declared); cast to *Arena inside.
//
// Returns the args buffer pointer. Caller reads ret_slot from
// out_ret_slot buffer (IRVal layout: kind(0)/id(4)/ival(8)/name(16)
// /qbe_type(24)). This two-output split avoids **u8 parameters,
// which jhyy codegen mishandles (segfault during src0 compile).

fn abi_win_emit_call_prelude(
    ir: *IRBuf,
    arena: *u8,        // *Arena
    n_user_args: i64,
    is_sret: i32,
    rsize: i32,
    out_ret_slot: *u8, // IRVal layout buffer (40 bytes)
) -> *u8 {            // returns args_arr pointer (or NULL)
    let extra: i64 = if is_sret != 0 { (1 as i64) } else { (0 as i64) };
    let total = n_user_args + extra;
    let mut args_arr: *u8 = 0 as *u8;
    if total > 0 {
        let arena_a = arena as *Arena;
        args_arr = arena_alloc(arena_a, total * IRVAL_SIZE());
    }
    let mut ret_slot: IRVal = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
    if is_sret != 0 {
        ret_slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, ret_slot, rsize);
        if total > 0 {
            let slot0 = args_arr as *i32;
            *slot0 = ret_slot.kind;
            *(ptr_add_u8(args_arr, 4 as i64) as *i32) = ret_slot.id;
            *(ptr_add_u8(args_arr, 8 as i64) as *i64) = ret_slot.ival;
            *(ptr_add_u8(args_arr, 16 as i64) as **u8) = ret_slot.name;
            *(ptr_add_u8(args_arr, 24 as i64) as *i32) = ret_slot.qbe_type;
        }
    }
    // Write ret_slot into out_ret_slot (IRVal layout: 0/4/8/16/24)
    if out_ret_slot != (0 as *u8) {
        let kind_p = out_ret_slot as *i32;
        let id_p = ptr_add_u8(out_ret_slot, 4 as i64) as *i32;
        let ival_p = ptr_add_u8(out_ret_slot, 8 as i64) as *i64;
        let name_p = ptr_add_u8(out_ret_slot, 16 as i64) as **u8;
        let qt_p = ptr_add_u8(out_ret_slot, 24 as i64) as *i32;
        *kind_p = ret_slot.kind;
        *id_p = ret_slot.id;
        *ival_p = ret_slot.ival;
        *name_p = ret_slot.name;
        *qt_p = ret_slot.qbe_type;
    }
    return args_arr;
}

// ════════════════════════════════════════════
// Stage 1c.5: abi_win_emit_struct_arg_slot
// ════════════════════════════════════════════
//
// Per ABI § 3 LOCKED: struct args are passed by slot pointer. Allocate
// a stack slot of `type_size(struct_type)` bytes (rounded up to 4) and
// return the slot address IRVal. Caller is responsible for copying the
// source struct into the slot via cg_copy_struct (which lives in
// codegen.jhyy and stays there — jhyy can't handle the circular import
// codegen ↔ abi_amd64_win that an inlined copy would create).
//
// Mirrors C-side abi_win_emit_struct_arg_slot at compiler/src/target/
// abi_amd64_win.c:289-296 in spirit (alloc + return slot) but NOT in
// surface (C-side inlines the struct copy into the abi module; jhyy
// can't import codegen without a circular import — see commit log).
//
// Replaces 2 sites in cg_expr NODE_CALL (~lines 2468-2474) and
// NODE_QUALIFIED_CALL (~lines 2635-2641) — 7 lines of inline struct
// alloc + cg_copy_struct call replaced with abi call + caller-side
// cg_copy_struct call.

fn abi_win_emit_struct_arg_slot(ir: *IRBuf, struct_type_raw: *u8) -> IRVal {
    let mut asize: i32 = 0;
    if struct_type_raw != (0 as *u8) {
        asize = type_size(struct_type_raw as *Type) as i32;
    }
    if asize < (4 as i32) {
        asize = 4;
    }
    let copy_slot = *ir_new_tmp(ir, QBE_L());
    ir_emit_alloc(ir, copy_slot, asize);
    return copy_slot;
}