    let _r6 = sb_append_cstr(arena, s, "\tmovsd %xmm0, " as *u8);
    let _r7 = sb_appendf_lld(arena, s, "%lld" as *u8, dst_off);
    let _r8 = sb_append_cstr(arena, s, "(%rbp)\n" as *u8);
    return 0;
}