// codegen_amd64_state.jhyy — v2.5.0 M1-A shared state + types
//
// Module-split 设计:codegen_amd64 主 entry 只放 state init + parse loop + D42 stub;
// 15 个 emit 函数拆到 3 个 sibling 模块(codegen_amd64_emit_{mem,ctrl,call}.jhyy);
// 本模块定义 shared state struct + QBE type 常量 + 辅助常量,emit 模块全部 import 此。
//
// 这是 v2.5.0 并行施工的接口契约(per V2-A batch plan,本 session /batch 拆 4 个并行 agent):
//   A1: codegen_amd64_lexer.jhyy        — QBE IL lexer (300 行,no state dep)
//   A2: codegen_amd64_emit_mem.jhyy     — alloc/store/load/loadsub (4 functions)
//   A3: codegen_amd64_emit_ctrl.jhyy    — jmp/jnz/label/ret/func_header/data_string (6 functions)
//   A4: codegen_amd64_emit_call.jhyy    — call/phi/copy/binop/volatile (5 functions)
//   A5: codegen_amd64.jhyy (main)       — state init + parse loop + D42 stub + file I/O
//
// 关键约束:
//   - D42 escape hatch:codegen_amd64_emit_raw_asm stub in A5 main,V3-B v3.0.1 填充
//   - 3c volatile token:emit_volatile 函数在 A4;lexer(A1)识别 volatile keyword
//   - D43 self-equal closure 维持 sha 51376ce5...(codegen.jhyy 主干不动)
//   - D26 byte-equal 三件套:.il / .s / .exe byte-equal
//
// Note: lives flat in compiler/src0/ (not in a subdir) — jhyy import
// syntax doesn't support paths with `/` (per `parse_import_decl`
// codegen.c:731 — same restriction as abi_amd64_win.jhyy).

// V2-B v2.6.0 Unit C Regalloc 集成(必须在文件顶部 — state.jhyy 的
// cg_offset_for_temp 在 line 132 调用 regalloc_query_spill_off_no_arr;
// jhyy 不支持 fn forward reference,import 必须先于 use site)
import codegen_amd64_regalloc;
// v2.11.2 (W-074.6 T1-a): cg_byte_at / cg_streq_n / cg_find_sub 用 ptr_add_u8
import util;
extern fn jh_fputs_stderr(s: *u8) -> i32;
// v3.4.2 W-089: cg_query_fn_returns_ptr 解析 *RetTypeMapEntry (ir.jhyy 定义)
import ir;

// ════════════════════════════════════════════════════
// QBE type constants(per ir.jhyy `QBE_W='w'=119` 等)
// ════════════════════════════════════════════════════

fn QBE_W_LOCAL() -> i32 { return 119 as i32; }  // 'w' — 32-bit word
fn QBE_L_LOCAL() -> i32 { return 108 as i32; }  // 'l' — 64-bit long
fn QBE_S_LOCAL() -> i32 { return 115 as i32; }  // 's' — 32-bit float
fn QBE_D_LOCAL() -> i32 { return 100 as i32; }  // 'd' — 64-bit double
fn QBE_B_LOCAL() -> i32 { return 98 as i32; }   // 'b' — 8-bit byte
fn QBE_H_LOCAL() -> i32 { return 104 as i32; }  // 'h' — 16-bit half
fn QBE_VOLATILE_MARKER() -> i32 { return -1 as i32; }  // volatile token marker
// v3.1.0 (V3-C 3g): borrowed var marker — 表示此 slot 是 `&T` / `&mut T` 借用。
// 区别 volatile (-1): volatile 每次 load fresh temp; borrowed 是单 ptr 复用。
// qbe_type 仍写 'l' (8-byte ptr),此 marker 供 codegen 阶段 metadata 区分。
fn QBE_BORROWED_MARKER() -> i32 { return -2 as i32; }  // v3.1.0: &T / &mut T marker

// ════════════════════════════════════════════════════
// IL token kind(per L4 § 2.1,15 个 token + EOF)
// ════════════════════════════════════════════════════

fn ILTOK_EOF()          -> i32 { return 0 as i32; }
fn ILTOK_ALLOC()        -> i32 { return 1 as i32; }
fn ILTOK_STORE()        -> i32 { return 2 as i32; }
fn ILTOK_LOADSUB()      -> i32 { return 3 as i32; }
fn ILTOK_LOAD()         -> i32 { return 4 as i32; }
fn ILTOK_CALL()         -> i32 { return 5 as i32; }
fn ILTOK_PHI()          -> i32 { return 6 as i32; }
fn ILTOK_COPY()         -> i32 { return 7 as i32; }
fn ILTOK_BINOP()        -> i32 { return 8 as i32; }
fn ILTOK_RET()          -> i32 { return 9 as i32; }
fn ILTOK_JMP()          -> i32 { return 10 as i32; }
fn ILTOK_JNZ()          -> i32 { return 11 as i32; }
fn ILTOK_LABEL()        -> i32 { return 12 as i32; }
fn ILTOK_FUNC_HEADER()  -> i32 { return 13 as i32; }
fn ILTOK_DATA_STRING()  -> i32 { return 14 as i32; }
fn ILTOK_VOLATILE()     -> i32 { return 15 as i32; }
fn ILTOK_DIRECTIVE()    -> i32 { return 16 as i32; }  // v2.11.1: dbgfile/dbgloc/{ / } 哨兵 (W-074.5 真修)
// v2.11.19: QBE float/i32 conversion op family (per codegen.jhyy:1012-1038 emit pattern)。
//   dtosi/dtosl/stosi/stosl/truncd/exts (f32→f64)/sltof/swtof/ultof/uwtof
//   8 个 enum,dtosi/stosi 涵盖 dtosl/stosl (dst 宽度由 tok.qbe_type 决定)。
//   exts with src=W/H/B 走原整数 ext 路径(emit_binop 已有的 extsw/extuw/extsh/extsb 路径),
//   exts with src=S 走 emit_conv_exts_f32_to_f64 新增浮点路径(cvttss2si/cvtss2sd 等)。
fn ILTOK_DTOSI()        -> i32 { return 50 as i32; }  // f64 → i32/i64 (cvttsd2si)
fn ILTOK_STOSI()        -> i32 { return 51 as i32; }  // f32 → i32/i64 (cvttss2si)
fn ILTOK_TRUNCD()       -> i32 { return 52 as i32; }  // f64 → f32 (cvtsd2ss)
fn ILTOK_EXTS()         -> i32 { return 53 as i32; }  // src=S 走 f32→f64 (cvtss2sd); src=W/H/B 整数 ext
fn ILTOK_SLTOF()        -> i32 { return 54 as i32; }  // i64 → f64 (cvtsi2sd, signed)
fn ILTOK_SWTOF()        -> i32 { return 55 as i32; }  // i32 → f64 (cvtsi2sd, sign-ext 32→64)
fn ILTOK_ULTOF()        -> i32 { return 56 as i32; }  // u64 → f64 (half trick 7 insn)
fn ILTOK_UWTOF()        -> i32 { return 57 as i32; }  // u32 → f64 (movl %eax, %eax zero-ext + cvtsi2sd)

// ════════════════════════════════════════════════════
// IL token struct(由 lexer.jhyy 构造,parse loop 消费)
// ════════════════════════════════════════════════════

type ILToken = struct {
    kind:     i32,     // ILTOK_*
    text:     *u8,     // token 字符串(filenames / block names / etc.)
    text_len: i64,
    int_val:  i64,     // numeric literals
    qbe_type: i32,     // 'w'/'l'/'s'/'d'/'b'/'h' 或 QBE_VOLATILE_MARKER
    line:     i32,
}

// ════════════════════════════════════════════════════
// CGState(per-function codegen state)
// ════════════════════════════════════════════════════
//
// 1-to-1 简化栈分配(per L4 § 4.3):每个 %tN 对应一个 stack offset。
// 32-byte shadow + %rbp save + locals。
// V2-B v2.6.0 加 regalloc 后,这一段会被 alloc pass 重构,emit 函数接口不变。

type CGState = struct {
    out:         *u8,   // *StringBuilder(util.sb_* API)
    arena:       *u8,   // *Arena(arena.jhyy)
    total_alloc: i64,   // sum of all allocN sizes(per function)
    cur_fn_name: *u8,   // 当前 emit 的函数名(QBE IL `export function ... $name`)

    // — MS x64 frame 固定字段(per L4 § 3.4)—
    shadow_space: i64,  // 32-byte shadow space (MS x64 calling convention)
    nparams:      i64,  // 当前函数的参数个数(影响 prologue size)

    // v2.11.2 (T4-d 真修延伸):cur_call_text / cur_call_text_len —
    // emit_call 在调 emit_amd64_arg_regs 前把 call 指令原文 slice 存这里,
    // emit_amd64_arg_regs 解析每个 arg 的 (qt, temp_id)。之前 emit_amd64_arg_regs
    // hardcode %t1..%t6, 错槽静默 wrong value(per W-074.6 T4-d)。
    cur_call_text:     *u8,    // call 指令原文 slice (lexer set, NO null-term)
    cur_call_text_len: i64,    // slice 长度

    // v2.7.0 Phase 2a: target tag threading through CGState.
    //   0 = TARGET_AMD64_WIN              (default; per Win ABI path)
    //   1 = TARGET_AMD64_WIN_FREESTANDING (per Win freestanding path)
    //   2 = TARGET_AMD64_SYSV             (per SysV path; Phase 2b emit_call split)
    //   3 = TARGET_AMD64_SYSV_FREESTANDING(v2.7.1 ship; placeholder)
    // Phase 2a 仅加字段 + 默认 0 (Win),emit_call refactor 留 Phase 2b 调此字段
    // 决定 arg-reg 序列 (Win 4 reg + 32B shadow / SysV 6 reg + 无 shadow)。
    target_tag:   i32,

    // v2.11.2 (W-074.6 T3-a): global max temp id seen across whole module。
    // Per-function pre-scan table 留 v2.11.3;v2.11.2 用 global-max fallback
    // (every function uses same frame size,浪费 stack 但 correctness 闭环)。
    frame_max_temp: i64,

    // v2.11.3 (W-074.7 T4-c SCOPE DOWN):defensive fields 保留以备 v2.11.4 真修。
    // emit_func_header 末尾 cg_state_set_fn_header 调用已移除 — 字段不再写。
    // 当前 emit_copy FN_ARG 路径仍 hardcode arg-1 = %rcx (Win) / %edi (SysV),
    // 跟 v2.11.2 baseline 行为一致。v2.11.4 真修需要 lexer 把 fn args dup 到
    // arena (currently lexer 只 dup name 不 dup args per codegen_amd64_lexer.jhyy
    // next_token_func_header),然后 emit_func_header 把 args 喂 cg_find_arg_idx。
    cur_fn_header_text: *u8,
    cur_fn_header_len:  i64,
    cur_fn_arg_count:   i64,   // 当前 function 的 arg 数量;emit_func_header 写

    // v2.11.3 (W-074.7 T4-h 真修):per-module fn 序号,emit_jnz + emit_jmp +
    // emit_label 在 `.L<name>` 后 append `_fn<N>` 后缀,避开 big_test 等多 fn 共享
    // `@then1` / `@loop_body` 静默 label 重定义 → wrong jumps。0-based,
    // cg_state_init init to 0,cg_state_bump_fn_idx 在 emit_func_header 末尾
    // 调 — reset_for_function **不** reset (跨 fn 累加保证唯一)。
    cur_fn_idx: i64,

    // v2.11.5 (W-074.7 alloc-tracking 真修):per-fn temp id → stack slot map。
    // emit_alloc 调 cg_record_temp_slot 写入,cg_offset_for_temp[t] 查询。
    // 修 nested_struct_deep / struct_val_pass pre-existing bug — alloc'd %tN
    // 之前走 formula `-(32 + t*8)` 跟 alloc 真分配的 slot 不一致 → read garbage。
    // 256 entries × 8 bytes = 2KB per compile,negligible。arena alloc + memset 0
    // 在 cg_state_init。reset_for_function 把 slot 数组 zero (per-fn 隔离)。
    // MAX_TEMP_SLOTS=256 留 5x safety margin over regress max (nested_struct_deep 51)。
    temp_slot_for_id: *u8,

    // W-120 (2026-10-20 真修):两张按 temp id 索引的表的**实际容量**。
    //
    // 为什么需要(而不是继续用常量):temp id 是 IL emitter **全局**编号的,
    // 一个文件里的 id 上限 = 该文件用过的最大 id。main.jhyy 已经到 60462 ——
    // 也就是说常量 65536 只剩 8% 余量,而**超限的后果是静默产出错代码**
    // (见 W-120 的 RCA:temp id 越界 → 查表被跳过 → 落到 formula 兜底路径
    //  → 同一个变量在两处解析成**不同的槽** → 值静默丢失)。
    //
    // 现在 pre-scan 数出全局最大 temp id,按它重新分配这两张表
    // (见 cg_resize_temp_tables)—— **没有上限了**。
    //
    // 初值 = 原来的常量(65536),保证小文件的行为跟以前逐字节一致。
    temp_slots_size: i64,

    // 同上 —— temp_holds_address bitmap 的实际容量。
    temp_holds_size: i64,

    // W-120:temp 表越界**粘滞标志**。
    //
    // 越界的后果是「静默产出错代码」(查表被跳过 → 落到 formula 兜底 → 同一个
    // temp 在两处解析成不同的槽 → 值静默丢失)。所以这里把它记下来,在编译
    // 结束时由 codegen_amd64.jhyy 检查 → **响亮失败**。
    //
    // 一个响亮的失败远好过一个静默产出错代码的编译器 ✓。
    temp_table_overflow: i32,
    // W-130:address-holder bitmap 越界 / C 桥哨兵的粘滞标志(编译末尾闸读它)
    holds_bitmap_overflow: i32,

    // v2.11.6 (W-074.7 big_test link error 真修 — scope DOWN):per-fn block-name
    // uniquify table。emit_label 在 `.L<name>_fn<N>` 后 append `_b<count>` suffix,
    // emit_jmp/jnz 用相同 lookup 保证 target 跟 def byte-equal。修 big_test 嵌套
    // loop 共享 `@loop_body` / `@loop_end` 等 label 静默重定义 → GAS link error。
    // 256 entries × 32 bytes = 8KB per compile,negligible。arena alloc + memset 0
    // 在 cg_state_init。reset_for_function 把 table zero (per-fn 隔离,同 fn 内
    // 多次同名 label 才 uniquify;跨 fn label 由 _fn<N> suffix 区分)。
    block_name_uniq: *u8,

    // v2.11.8 (W-074.7.8 derived-address tracking 真修 — FULL scope):bitmap 标
    // 任何 temp holding derived address (alloc-result, binop add/sub pointer-arith
    // 结果, copy of address-holder)。emit_load/store/loadsub 看 flag 决定 indirect
    // (mov<size> (%r8), %reg) vs slot (mov<size> -<off>(%rbp), %reg)。
    // 256 entries × 1 byte = 256 bytes per compile, negligible。emit_alloc /
    // emit_binop / emit_copy 写 flag; reset_for_function per-fn zero。
    // v2.11.7 attempt (commit reverted 11a7666) flag-named `temp_is_alloc_pointer`
    // 跟当前 `temp_holds_address` 是不同概念: 前者只 flag alloc-result (1 种
    // address-holder), 后者 flag 任何 derived address (真根因 = `add ptr, off`
    // 产生的 runtime address, 不只 alloc-result)。
    temp_holds_address: *u8,

    // v2.11.10 (W-074.6 T3-a closure):per-fn pre-scan table,替换 v2.11.2 global-max
    // frame variant。Three arena-alloc'd i64 arrays(按实际函数数分配,W-107)
    // = 8KB (24KB total negligible)。cg_compute_per_fn_max_temps (Phase A) 一次
    // pre-scan 写: Phase 1 扫 fn_starts,Phase 2 per-fn max temp id → per_fn_max +
    // per-fn alloc sum → per_fn_alloc。emit_func_header 读 per_fn_max[cur_fn_idx]
    // 算 frame_size,每个 fn 独立 frame
    // (递归 fn fact/fib/gcd 只用 5-10 temps → frame_size = 88 字节 vs 老 15488,
    // 修复递归函数 SIGSEGV,big_test 自-backend 跑通)。
    // 1024 entries 够 main.jhyy 997 fns (W-074.6 v4.0.2.1 bump 256→1024:原 256 cap
    // 触发 256+ fn 走 global-max fallback → frame over-reserve 484KB for trivial fn
    // like codegen_amd64_lexer__main_jhyy)。
    fn_starts: *u8,    // i64[1024]: 每个 fn start token idx;fn_starts[fn_count]=n 哨兵
    per_fn_max: *u8,   // i64[1024]: 每个 fn 的 max temp id;frame_size = (max+1)*8
    per_fn_alloc: *u8, // i64[1024]: 每个 fn 的 total allocN sum;W-087 alloc pool reserve
    // v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):per-fn temp base,
    // 让 cg_offset_for_temp 把 global %tN (QBE IL 跨 fn 累加) 翻译成本 fn 的
    // local t (从 0 起, frame_size = (local_max+1)*8)。per_fn_base_t[0]=0,
    // per_fn_base_t[i] = per_fn_max[i-1] + 1 for i>0。self-backend self path
    // regalloc_run skip (per codegen_amd64.jhyy:335) → 永远走 formula 路径
    // → 必须改 formula 用 local t,否则 frame_size 跟 slot offset 不一致。
    per_fn_base_t: *u8, // i64[1024]: 每个 fn 的 global t 起点;local_t = t - per_fn_base_t[cur_fn_idx]
    fn_count: i64,     // 实际 fn 数 (0 = 没跑 pre-scan → fall through global-max)

    // v2.11.15 Iter 2 (C.3 emit_phi 真修): pending phi resolution table。
    //   emit_phi 解析 `phi @armA %tN, @armB %tM` (target merge block 在 phi IL
    //   的下一行),把每个 (dst_slot, arm_label_text, arm_label_len, tN_id)
    //   append 到此 table。emit_jmp 在 emit `jmp` 之前扫描 table:若 current
    //   block name 跟某 entry 的 arm_label match,emit `mov -tN_off(%rbp), %rax;
    //   mov %rax, -dst_slot(%rbp)` (per L4 § 3.5 E6)。
    //   reset_for_function 在 fn 切换时清零(per-fn 隔离)。
    //   MAX_PHI_ENTRIES=128 够 ~10 个 phi × ~10 arms(3-12 arms 通常)。
    pending_phi_dsts: *u8,           // i64[128]: dst slot offset
    pending_phi_tN: *u8,             // i64[128]: %tN id (in source arm)
    pending_phi_arm_label_ptrs: *u8, // *u8[128]: pointer to arm label text (arena_alloc'd)
    pending_phi_arm_label_lens: *u8, // i64[128]: arm label text len
    pending_phi_count: i64,          // 当前 pending entries

    // v2.11.15 Iter 2 (C.3 emit_phi 真修): current block name (the @label of
    //   the block we're currently emitting into)。emit_label 在 emit `.L<text>:`
    //   后把 text + len 写到这两个字段;emit_jmp 用它来 match pending_phi entries。
    //   text 在 arena alloc'd(per fn,reset_for_function 不需要清零因为 emit_label
    //   每次都覆盖)。
    cur_block_name: *u8,
    cur_block_name_len: i64,

    // v2.13.0 (Phase 1 真 XMM regalloc): per-call arg allocation counters。
    //   emit_amd64_arg_regs 入口调 xmm_arg_reset 把两个 count 清零;每个 arg:
    //     - f32/f64 → xmm_arg_alloc → 返 xmm reg idx (0-7 SysV / 0-3 Win)
    //       或 -1 (XMM pool 满,caller 走 stack-arg fallback)
    //     - int    → int_arg_alloc → 返 GPR reg idx (0-5 SysV / 0-3 Win)
    //       或 -1 (GPR pool 满,同样 stack-arg)
    //   替换 v2.11.15 的 hard-coded `sse_xmm_reg_for_arg_idx(ri)` 静态 mapping
    //   (原 ri < 6 SysV XMM pool 是 bug — 实际 SysV 是 8 个 XMM arg reg)。
    //   stack-arg 计数也跟踪 — stack_arg_offset 每次 +8 (Win) / +16 (SysV 含
    //   16-byte align for f64) 递增。
    xmm_arg_count:    i32,  // 当前 call 已用 XMM arg reg 数 (per-call reset)
    int_arg_count:    i32,  // 当前 call 已用 int arg reg 数
    stack_arg_offset: i64,  // 当前 call 已用 stack-arg 字节偏移 (8 字节对齐)

    // v3.4.2 (W-089 真修):SymbolReturnTypeMap wire from sema Pass 1.6 → emit_call
    //   semantic lookup. Replaces v3.1.0 13-prefix byte-prefix whitelist (cg_query_fn
    //   _returns_ptr in codegen_amd64_state.jhyy). map=0 / n=0=fall through to
    //   cg_is_builtin_ptr_fn fallback only (link-only externs like ptr_add).
    ret_type_map:   *u8,    // *RetTypeMapEntry[] arena-alloc'd by sema
    ret_type_map_n: i64,    // entry count

    // v4.0.7 (W-097 真根因真修): alloc value pool + address-holder pool 各有独立
    // head pointer。v4.0.6 attempt #7 复用单一 next_offset + is_in_addr_pool 切回
    // 标记,cg_alloc_slot 切回 value pool 时无条件 reset 到 -8192 → 丢弃 value
    // pool 已推进的进度 → alloc offset 重发 → 两个 alloc 变量同 slot 互相覆盖
    // → SEGV(gdb: `mov %eax,(%r8)` r8 = code section address)。
    // 两 pool 独立 head 后 interleaving 无副作用。
    value_next_offset: i64,     // alloc value pool head (per-fn, 0 = 未初始化)
    addr_next_offset: i64,      // address-holder pool head (per-fn, 0 = 未初始化)
    alloc_init_off: i64,        // formula end + 64 gap (= -(32+(local_max+1)*8+64))
    addr_holder_init_off: i64,  // alloc end + 64 gap (= -(alloc_pool_end_off + 64))
    // v4.0.7 (W-097 sub-bug 2): address-holder pool lives at
    // addr_holder_init_off -(depth), i.e. BELOW frame_size — so `subq $n, %rsp`
    // must reserve frame_size + per_fn_addr_pool, not just frame_size. Pre-scan
    // upper-bounds pool depth by (#ALLOC + #LOAD + #BINOP)*8 + 64 gap: those are
    // exactly the token kinds whose emit_* path calls cg_alloc_slot(is_addr=1).
    per_fn_addr_pool: *u8,      // i64[1024]: per-fn address-holder pool bytes (incl. 64 gap)

    // ── v4.4.0 寄存器缓存(codegen_amd64_rcache.jhyy)─────────────────
    //
    // 让「同基本块 + 期间无 call + 整数类型」的 SSA temp 住在**寄存器**里,
    // 而不是每个值都走「load 栈槽 → 算 → store 栈槽」(机器码里 68% 是访存)。
    // 详见 codegen_amd64_rcache.jhyy 的文件头 + docs/plans/v4/self-backend-perf-plan.md。
    //
    // ⚠️ **默认关** —— v4.4.0 阶段一(基础设施)产物**逐字节不变**;
    //    打开是阶段二(emit 层改造),那时安全网会当场抓住漏改的调用点。
    rc_enabled:    i32,   // 0 = 关(默认);1 = 开
    rc_reg_flat:   *u8,   // u8[global_max_temp+1]: 255 = 未分配;0..4 = 寄存器 idx
    rc_fn_callee:  *u8,   // i64[fn_count+1]: per-fn 用到的 callee-saved 寄存器位掩码
    rc_temp_qt:    *u8,   // u8[global_max_temp+1]:每个 temp 的 qbe 类型('w'/'l')
                          // 寄存器里存的宽度必须跟当初存它的宽度一致
    rc_global_max: i64,   // 全模块最大 temp id(= per_fn_max[fn_count-1])
    rc_allocated:  i64,   // 实际分配到寄存器的 temp 数(统计用)
    rc_violation:  i32,   // 粘滞错误标志:分配了寄存器的 temp 被按**栈槽**访问
                          // ⇒ 漏改的 emit 调用点 ⇒ **编译失败**(不产出错代码)
}

// v2.11.5 (W-074.7 alloc-tracking 真修): extern bridge 装当前 CGState 的
// temp_slot_for_id 指针 (跟 regalloc jh_regalloc_get/set 同 pattern)。C-side
// static BSS-zero init; jhyy-side let mut module-level 会触发 stage0 segfault
// per codegen_amd64_regalloc.jhyy:76-87 注释。
extern fn memcmp(a: *u8, b: *u8, n: i64) -> i32;
extern fn jh_name_ends_with(name: *u8, len: i64, suffix: *u8, slen: i64) -> i32;
extern fn jh_byte_at(p: *u8, i: i64) -> i32;
extern fn jh_cgstate_get_temp_slots() -> *u8;
extern fn jh_cgstate_set_temp_slots(p: *u8) -> i32;

// v2.11.8 (W-074.7.8 derived-address tracking 真修): same pattern for
// temp_holds_address bitmap。query 走 (*s).temp_holds_address 直接读 (hot path),
// setter 是 forward-ref-safe no-op (跟 jh_cgstate_set_temp_slots 同 pattern)。
extern fn jh_cgstate_get_holds_address() -> *u8;
// W-130 (2026-10-24 真修):容量通道 —— bitmap 指针 + 实际容量**一起**装
// (单个 C 函数 ⇒ 没有「cap 已更新 / bitmap 还是旧的」窗口)。C 侧不再有硬编码
// 上界:65536 那条硬上限当年圈住了 main.jhyy 的 temp id(60462),后来源码长大
// 又撞上第二次(W-130)。
extern fn jh_cgstate_set_holds_table(p: *u8, cap: i64) -> i32;
extern fn jh_cgstate_get_holds_cap() -> i64;
// v2.11.8: byte-level access into the u8 bitmap (jhyy 没有 u8 direct deref)。
// W-130:越界 / 通道未初始化 / 指针不同步 → 返回哨兵 -1(不是 0 —— 返 0 会被
// jhyy 侧当成「不是 address-holder」⇒ 静默产出错代码)。
extern fn jh_cgstate_set_holds_flag(bitmap: *u8, idx: i64) -> i32;
extern fn jh_cgstate_get_holds_flag(bitmap: *u8, idx: i64) -> i32;

// v4.0.2.2 (W-096 emit-side per-fn-local counter 真修): expose current CGState
// pointer via C-bridge (per jh_cgstate_get_temp_slots pattern)。cg_local_t_from_global
// 跟 cg_offset_for_temp 不接 state 参数,需要从 C-side static 拿当前 state 才能
// 读 per_fn_base_t[cur_fn_idx]。cg_state_init 入口 set 一次(per-compile lifetime)。
extern fn jh_cgstate_get_state() -> *u8;
extern fn jh_cgstate_set_state(s: *u8) -> i32;

// v4.0.4 Step 1 (W-101 RCA 1-iter verification, per feedback_rca_first_root_cause):
// jh_dbg_log2 — 5-arg structured stderr logging bridge for jhyy-side codegen
// tracing. Captures W-101 smoking gun sites: cg_record_temp_slot /
// cg_offset_for_temp_with_target / cg_state_reset_for_function / emit_func_header
// / cg_state_bump_fn_idx 时序. 4 i64 values cover all sites:
//   (cur_fn_idx, temp_id, slot_off, recorded_or_offset_or_size).
// label disambiguates site via short tag (rcs_/rst_/ltg_/oftt_/bfi_/efh_).
// fflush ensures stderr buffer 真 flush before any SEGV (per v2.6.3 self-backend
// 0-byte emit 教训). Conditional on temp_id >= 1024 to limit noise — W-101
// trigger zone is high temp_id range per v4.0.4 plan RCA evidence.
extern fn jh_dbg_log2(label: *u8, a: i64, b: i64, c: i64, d: i64) -> i32;

// MAX_TEMP_SLOTS — alloc-tracking 数组大小。4096 (per W-094 2026-09-26
// 真修):256 太低,big_test max temp_id = 1932 跨过 256 → cg_record_temp_slot
// bounds-check no-op → temp_slot_for_id[t] 留 0 → cg_offset_for_temp_with_target
// fall through formula `-(32 + t*8)` 跟 cg_alloc_slot 真分配的 alloc pool offset
// 不一致 (公式 fall back 跟 alloc pool 同 offset 范围 → struct data 跟 formula
// slot 物理 collision)。具体 big_test t_triple case:alloc pool t1039 struct 在
// rbp-8272 (= -8192 - 80),formula fall back t1030 = -(32 + 1030*8) = -8272 —
// **完全 collision**。t1039 后续 struct field copy 写到 rbp-8272 (= t1039 struct)
// 时 实际写入 t1030 formula slot,t1030 ptr 被 overwrite 成 garbage (5) → 后续
// add+storew 走 [r8] (r8 = t1030+4 = 9) → SEGV 0x9。
//
// 65536 (per v4.0.2.1 W-074.6 sub-bug #3 真修):4096 不够 — main.jhyy 实际
// max temp_id = 60462+, 跨过 4096 bounds → cg_record_temp_slot no-op →
// temp_slot_for_id[t] 留 0 → cg_offset_for_temp fall through formula
// `-(32 + t*8)` 跟 cg_alloc_slot 真分配的 alloc pool offset 不一致 (write @
// alloc pool slot, read @ formula slot → 错字节 / segfault)。4096 cover
// big_test (max 1932, per W-094); 65536 cover main.jhyy (max 60462), 留 ~5K
// headroom 给未来 stdlib 大 temp_id test。Memory cost: 65536*8=512KB per
// compile arena, 跟 4096*8=32KB 比 16x, 可忽略。
//
// **W-094 (v3.2.4 真修 W-093 残留)**:bitmap bound bump 不够 — slot table
// 同步需要 bump。W-093 仅 bump 了 holds-address bitmap, alloc-tracking slot
// table 仍 256 → big_test 仍 SEGV。4096 后 cg_record_temp_slot 正常 record
// alloc pool offset → cg_offset_for_temp_with_target 返 alloc pool offset 而非
// formula fallback → struct data 跟 formula slot 物理分离,big_test exit 0。
// ── MAX_FN_ENTRIES 已删除(2026-10-20,W-107 终局)──────────────────────────
//
// 它曾是 per-fn pre-scan 表的项数上限:256 → 1024 → 4096,每次 bump 都只是
// **把悬崖推远**。跨过上限的后果不是「多几个函数没帧」这么简单:超出表的
// 函数被 pre-scan **丢弃** → per_fn_max 保持 0 → local_max 被钳成 0
// → frame_size = 8 → **局部变量冲出帧** → 踩坏调用者的帧 → 被编译程序的
// target 变成随机值(「Win 目标却按 SysV 出码」)+ 间歇性 SEGV。
//
// 现在五张表**按实际函数数分配**(见 cg_compute_per_fn_max_temps),
// 所以这个常量没有存在意义了 —— 留着它只会让人以为「还有个上限」。
//
// ⚠️ 顺带记一笔:动态分配**本身**在 a21c207 试过一次、当天就撤回了
//    (b7c4e6e)—— 原因是那次的动态分配与「查表越界真修」从未同时存在过:
//    上界判据当时还写死着表长 1024,idx ≥ 1024 时跳过查表 → local_t 变成
//    全局 temp id → 帧偏移 ≈ -518KB。b7c4e6e 把上界改成按 fn_count 判,
//    本次把分配改成按 fn_count —— 两半齐了。

// cg_max_temp_slots — temp_slot_for_id 表的**初始**容量(= 65536)。
//
// ⚠️ W-120 (2026-10-20):这**不再**是上限 —— pre-scan 会按实际最大 temp id
//    重新分配(见 cg_resize_temp_tables),实际容量存在 state.temp_slots_size。
//    这个函数只剩「初始值」的语义,读它的 bound check 全部改成读 state 字段。
fn cg_max_temp_slots() -> i64 {
    return 65536 as i64;
}

// cg_state_set_temp_slots — v2.11.5 setter,CGState 装 temp_slot_for_id 时调,
// 让 cg_offset_for_temp 无 state 参数也能查到当前 CGState 的 alloc 表。
// cg_state_get_temp_overflow — W-120:temp 表越界标志(编译结束时检查)。
fn cg_state_get_temp_overflow(state: *u8) -> i32 {
    if state == (0 as *u8) { return 0 as i32; }
    return ((state as *CGState)).temp_table_overflow;
}

// cg_state_get_holds_overflow — W-130:address-holder bitmap 越界标志
// (编译结束时检查 → 响亮的编译失败,而不是静默产出错代码)。
fn cg_state_get_holds_overflow(state: *u8) -> i32 {
    if state == (0 as *u8) { return 0 as i32; }
    return ((state as *CGState)).holds_bitmap_overflow;
}

fn cg_state_set_temp_slots(state: *u8) -> i32 {
    let s = state as *CGState;
    let _ = jh_cgstate_set_temp_slots((*s).temp_slot_for_id);
    return 0 as i32;
}

// cg_record_temp_slot — v2.11.5 setter,emit_alloc 调,把 alloc'd %tN 的 stack
// offset 写入当前 CGState 的 alloc-tracking 表。后续 cg_offset_for_temp[t]
// 查询时返回 recorded offset (跟 cg_alloc_slot 返回的一致)。
// bounds check: t < MAX_TEMP_SLOTS, 否则 no-op (formula fallback 仍走)。
fn cg_record_temp_slot(state: *u8, temp_id: i64, slot: i64) -> i32 {
    // v4.0.4 Step 1 (W-101 RCA, per feedback_rca_first_root_cause): log entry
    // for high temp_id (>= 1024, W-101 trigger zone) — captures record path
    // even when no-op (Option A diagnostic). post-write logs the actual write
    // so we can confirm recorded slot matches caller-provided slot.
    if temp_id >= (1024 as i64) {
    }
    let s = state as *CGState;
    // W-120:bound 用**实际容量**(state.temp_slots_size),不是常量。
    // 常量 65536 会在「大文件」上越界 → 静默不记录 → 读时落到 formula 兜底
    // → 同一个 temp 在两处解析成不同的槽 → 静默产出错代码。
    if temp_id < (0 as i64) || temp_id >= (*s).temp_slots_size {
        // W-120:越界 = 表不够大 → 读侧会跳过查表 → 静默错槽。
        // 所以这里**记下来并打印一次**,编译结束时 fail(见 codegen_amd64.jhyy)。
        if (*s).temp_table_overflow == (0 as i32) {
            (*s).temp_table_overflow = 1 as i32;
            jh_fputs_stderr("jhyy error: temp id exceeds the temp-slot table (W-120 guard) — the compiled output would be silently wrong" as *u8);
            jh_fputs_stderr("
" as *u8);
        }
        return 0 as i32;
    }
    if (*s).temp_slot_for_id == (0 as *u8) {
        if temp_id >= (1024 as i64) {
        }
        return 0 as i32;
    }
    let p = ptr_add_u8((*s).temp_slot_for_id, temp_id * (8 as i64)) as *i64;
    *p = slot;
    if temp_id >= (1024 as i64) {
    }
    return 0 as i32;
}

// MAX_TEMP_HOLDS_ADDR — derived-address bitmap 大小。65536 (per v4.0.2.1
// W-074.6 sub-bug #3 真修):4096 不够 — main.jhyy max temp_id = 60462+, 跨过
// 4096 → cg_is_address_holder bounds no-op → emit_load/store 走 slot direct
// path (treat l-typed address-holder as value temp) → 不 emit `mov (%r8),%reg`
// 间接 dispatch → argv[0] deref (`*argv_arr`) 实际退化成 copy argv_arr →
// argv0 持有 argv_arr (8 字节 ptr) 而非 `argv[0]` 字符串 ptr → jh_paths_init
// 接 garbage ptr → SEGV on `--help` 任何 input。
//
// 4096 (W-094 老 bump) cover big_test (max 1932, per W-093 RCA); 65536 cover
// main.jhyy (max 60462), 留 ~5K headroom。Memory cost: 65536 bytes per
// compile bitmap, 跟 4096 比 16x, 可忽略。
// cg_max_temp_holds_address — temp_holds_address bitmap 的**初始**容量(= 65536)。
// ⚠️ 同上(W-120):不再是上限,实际容量在 state.temp_holds_size。
fn cg_max_temp_holds_address() -> i64 {
    return 65536 as i64;
}

// cg_holds_bitmap_overflow — W-130:address-holder bitmap 越界 / C 桥哨兵的
// **响亮失败**。打印一次(第一次)并置粘滞标志 → 编译结束时 fail
// (见 codegen_amd64.jhyy / codegen_amd64_inmem.jhyy 的末尾闸)。
// 语义:标记被丢弃 ⇒ emit_loadsub 走 slot direct path ⇒ 静默产出错代码。
// 一个响亮的失败远好过静默的错代码 ✓(同 W-120 的处理方式)。
fn cg_holds_bitmap_overflow(state: *u8, temp_id: i64, cap: i64) -> i32 {
    let s = state as *CGState;
    if (*s).holds_bitmap_overflow == (0 as i32) {
        (*s).holds_bitmap_overflow = 1 as i32;
        jh_fputs_stderr("jhyy error: address-holder bitmap out of range (W-130 guard) — the compiled output would be silently wrong" as *u8);
        jh_fputs_stderr("
" as *u8);
    }
    return 0 as i32;
}

// cg_state_set_holds_address — v2.11.8 setter,CGState 装 temp_holds_address 时
// 调,跟 cg_state_set_temp_slots 同 pattern。
// W-130:指针 + 容量**一起**装(C 侧单函数 ⇒ 原子,没有中间窗口)。
fn cg_state_set_holds_address(state: *u8) -> i32 {
    let s = state as *CGState;
    let _ = jh_cgstate_set_holds_table((*s).temp_holds_address, (*s).temp_holds_size);
    return 0 as i32;
}

// cg_record_temp_holds_address — v2.11.8 setter,flag temp_id 是 address-holder
// (持有 derived address, 不是 VALUE)。emit_alloc / emit_binop (add/sub) / emit_copy
// 调。bounds check: t < 256, 否则 no-op。
fn cg_record_temp_holds_address(state: *u8, temp_id: i64) -> i32 {
    // W-120:bound 用实际容量(state.temp_holds_size),不是常量。
    let s = state as *CGState;
    let _cap0 = (*s).temp_holds_size;
    if temp_id < (0 as i64) || temp_id >= _cap0 {
        // W-130:越界 = 标记会被**丢弃** ⇒ emit_loadsub 走 slot direct path ⇒
        // 静默产出错代码。响亮失败(记下来 → 编译末尾 fail)。
        let _o = cg_holds_bitmap_overflow(state, temp_id, _cap0);
        return 0 as i32;
    }
    if (*s).temp_holds_address == (0 as *u8) {
        return 0 as i32;
    }
    let _r = jh_cgstate_set_holds_flag((*s).temp_holds_address, temp_id);
    if _r != (0 as i32) {
        // W-130:C 侧哨兵 -1 = 越界 / 容量通道没装 / 指针不同步。
        let _o2 = cg_holds_bitmap_overflow(state, temp_id, _cap0);
    }
    return 0 as i32;
}

// cg_is_address_holder — v2.11.8 query,emit_load/store/loadsub 调决定 indirect
// vs slot dispatch。1 = address-holder, 0 = value-temp (default; out-of-bounds 也 0)。
fn cg_is_address_holder(state: *u8, temp_id: i64) -> i32 {
    // W-120:bound 用实际容量(state.temp_holds_size),不是常量。
    let s = state as *CGState;
    let _cap1 = (*s).temp_holds_size;
    if temp_id < (0 as i64) || temp_id >= _cap1 {
        let _o = cg_holds_bitmap_overflow(state, temp_id, _cap1);
        return 0 as i32;
    }
    if (*s).temp_holds_address == (0 as *u8) {
        return 0 as i32;
    }
    let r = jh_cgstate_get_holds_flag((*s).temp_holds_address, temp_id);
    if r < (0 as i32) {
        // W-130:C 侧哨兵 -1。**不能**当成「不是 address-holder」——
        // 那正是 W-130 静默错代码的成因。返 0 + 置粘滞标志 + 编译末尾失败。
        let _o2 = cg_holds_bitmap_overflow(state, temp_id, _cap1);
        return 0 as i32;
    }
    return r;
}

// CGState 初始化 helper
// V2-B v2.6.0 (Unit B Stub-Fill): real impl — zero struct + init fields.
// Note: signature gained `state` first param (v2.5.0 stub lacked it; call
// site only existed as aspirational comment, so no callers to update).
fn cg_state_init(state: *u8, out: *u8, arena: *u8, fn_name: *u8) -> i32 {
    let s = state as *CGState;
    (*s).out = out;
    (*s).arena = arena;
    (*s).value_next_offset = 0 as i64;
    (*s).addr_next_offset = 0 as i64;
    (*s).total_alloc = 0 as i64;
    (*s).cur_fn_name = fn_name;
    (*s).shadow_space = 32 as i64;  // MS x64 calling convention
    (*s).nparams = 0 as i64;
    // v2.7.0 Phase 2a: target_tag 默认 0 (Win); Phase 2b 改 cg_state_init 签名 +
    // codegen_amd64_run 传 target_tag (target 来自 main.jhyy run_backend 的 `t` 参数)。
    (*s).target_tag = 0 as i32;
    // v2.11.2 (W-074.6 T3-a): frame_max_temp init to -1 (no temps seen yet)
    (*s).frame_max_temp = -(1 as i64);
    // v2.11.3 (W-074.7 T4-h 真修): cur_fn_idx 必须 init 为 0 — 不 init 会读到
    // arena 上残留字节 (e.g. "main.jhyy.exe\0" → 0x65002e00650063 ≈ 28429170222891107),
    // emit_jnz/emit_label 拼出 ".L<name>_fn28429170222891107" → GAS linker 不识别
    // 巨大 label offset → fib_renamed/big_test link 失败 (regression vs v2.11.2)。
    (*s).cur_fn_idx = 0 as i64;
    // v2.13.0 Phase 1: per-call arg allocation counters init。
    // emit_amd64_arg_regs 入口 xmm_arg_reset 会重置(per-call),这里是 init。
    (*s).xmm_arg_count    = 0 as i32;
    (*s).int_arg_count    = 0 as i32;
    (*s).stack_arg_offset = 0 as i64;
    // v3.4.2 W-089: ret_type_map / ret_type_map_n NOT zero-init in cg_state_init —
    //   codegen_amd64_run / run_text's cg_state_set_ret_type_map runs IMMEDIATELY
    //   after cg_state_init (per main.jhyy wire) and populates real sema map。
    //   reset_for_function also NOT clear (per-compile invariant, see below).
    // v2.11.5 (W-074.7 alloc-tracking 真修):alloc i64 数组 zero-init。
    // emit_alloc 调 cg_record_temp_slot 写 slot,reset_for_function 把数组 zero
    // (per-fn 隔离)。
    // **W-094 (v3.2.4 真修 W-093 残留)**:256 太低 — temp_id > 256 跨过 bounds check
    // → cg_record_temp_slot no-op → temp_slot_for_id[t] 留 0 → cg_offset_for_temp_with_target
    // fall through formula `-(32 + t*8)` 跟 cg_alloc_slot 真分配的 alloc pool offset
    // 不一致 (公式 fall back 跟 alloc pool 同 offset 范围 → struct data 跟 formula
    // slot 物理 collision)。4096 = 跟 cg_max_temp_holds_address bitmap 同步。
    // **v4.0.2.1 (W-074.6 sub-bug #3 真修)**:hardcoded `4096` 替换成
    // `cg_max_temp_slots()` 派生 — 之前 hardcoded literal 跟 function return
    // 漂移会导致 bounds check pass 但数组越界 write (corruption)。
    let slots_bytes = cg_max_temp_slots() * (8 as i64);
    let slots_ptr = arena_alloc(arena, slots_bytes);
    let _zero = memset(slots_ptr, 0 as i32, slots_bytes);
    (*s).temp_slot_for_id = slots_ptr;
    // W-120:记住初始容量 —— pre-scan 会按实际最大 temp id 重新分配
    // (见 cg_resize_temp_tables),届时这个字段被更新成新容量。
    (*s).temp_slots_size = cg_max_temp_slots();
    // W-120:越界粘滞标志初始为 0。
    (*s).temp_table_overflow = 0 as i32;
    (*s).holds_bitmap_overflow = 0 as i32;
    // v4.4.0 寄存器缓存:默认**关** ⇒ 产物逐字节不变
    (*s).rc_enabled = 0 as i32;
    (*s).rc_reg_flat = 0 as *u8;
    (*s).rc_fn_callee = 0 as *u8;
    (*s).rc_temp_qt = 0 as *u8;
    (*s).rc_global_max = -(1 as i64);
    (*s).rc_allocated = 0 as i64;
    (*s).rc_violation = 0 as i32;
    // v2.11.5 helper wire C-side static (forward ref-safe helper call):
    let _wr = cg_state_set_temp_slots(state);
    // v2.11.6 (W-074.7 big_test link error 真修 — scope DOWN):alloc block-name
    // uniquify table 256-entry (8KB) zero-init。emit_label 在每 fn 头调
    // cg_record_block_name 写 entry;emit_jmp/emit_jnz 调 cg_lookup_block_name
    // 拿 suffix。reset_for_function 把 table zero (per-fn 隔离,跟 alloc-tracking
    // 同 pattern)。
    // 注:cannot call cg_max_block_names (defined later) → inline literal 256。
    let bnu_bytes = (256 as i64) * (32 as i64);
    let bnu_ptr = arena_alloc(arena, bnu_bytes);
    let _zero_bnu = memset(bnu_ptr, 0 as i32, bnu_bytes);
    (*s).block_name_uniq = bnu_ptr;
    // v3.2.4 (W-093 真修 W-092): alloc temp_holds_address 4096-entry u8 bitmap
    // (4096 bytes) zero-init (per v2.11.8 W-074.7.8 初版 256,2026-09-26 W-090 bump
    // 1024 给 std_vec_basic test_with_cap v.cap 读 @ temp_id > 256 走 indirect dispatch,
    // 2026-09-26 W-093 真修 bump 4096 给 big_test max temp_id = 1932 走 indirect dispatch)。
    // emit_alloc / emit_binop (add/sub on address-holder src1) / emit_copy
    // (TEMP→TEMP of address-holder) 写 flag; emit_load/store/loadsub 读 flag
    // 决定 indirect (mov<size> (%r8), %reg) vs slot (mov<size> -<off>(%rbp),
    // %reg)。reset_for_function per-fn zero。
    // 4096 entries × 1 byte = 4096 bytes per compile, negligible in arena。
    // **W-092 假设错** — W-093 RCA:big_test max temp_id = 1932,跨过 1024 → emit_copy
    // 走 slot direct path (movl %eax, -<slot>(%rbp)) 而非 indirect dispatch → 错字节
    // / segfault。跟 W-085 ACTIVE trigger pattern `fn(*T,i32,i32)` 无关(point_scale
    // signature `(Point, i32)` 不是 *T+2i32 模式,W-085 描述也明确 point_scale 不
    // 触发 W-085)。真根因 = bitmap bound 不够,不是 W-085 latent。
    let ha_bytes = cg_max_temp_holds_address() as i64;
    let ha_ptr = arena_alloc(arena, ha_bytes);
    let _zero_ha = memset(ha_ptr, 0 as i32, ha_bytes);
    (*s).temp_holds_address = ha_ptr;
    // W-120:同上 —— bitmap 的实际容量。
    (*s).temp_holds_size = cg_max_temp_holds_address();
    // wire C-side static (跟 cg_state_set_temp_slots 同 pattern; setter 是
    // forward-ref-safe no-op, query 走 (*s).temp_holds_address 直接读)
    let _wr_ha = cg_state_set_holds_address(state);
    // v2.11.10 (W-074.6 T3-a closure):per-fn pre-scan table。
    // fn_starts + per_fn_max + per_fn_alloc + per_fn_addr_pool + per_fn_base_t,
    // 每张 i64[fn_count+1]。cg_compute_per_fn_max_temps (Phase A) 一次 pre-scan
    // 填,emit_func_header 读 per_fn_max[cur_fn_idx] 算 frame_size (替换 v2.11.2
    // global frame_max_temp → 跨 fn 共用 15488 字节 → 递归函数 SIGSEGV)。
    //
    // ⚠️ **W-107 (2026-10-20)终局:这五张表不再在这里按固定上限分配** ——
    // 改由 pre-scan **按实际函数数**分配(见 cg_compute_per_fn_max_temps)。
    //
    // 为什么固定上限是**正确性**问题而不只是「多留点余量」:
    // 溢出的函数在 pre-scan 里被**丢弃** → 它们的 per_fn_max 保持 0 →
    // W-096 的单调钳制把 local_max 压成 0 → frame_size = 8 → 那个函数的
    // **局部变量冲出帧** → 踩坏调用者的帧 → 被编译程序的 target 变成随机值
    // (表现为「Win 目标却按 SysV 出码」)+ 间歇性 SEGV。
    //
    // 历史:256(2026-09-26 W-074.6) → 1024(2026-10-15) → 4096(2026-10-20,
    // 越界改成响亮失败) → **按实际数分配**(本行)。每次 bump 都只是把
    // 「静默产出错代码」的悬崖往后推 —— 本仓自己的 main.jhyy 已经 1022 个函数,
    // 离 1024 只差 2 个。
    //
    // 这里只留 0 指针:pre-scan 会分配并覆盖它们 ✓。
    // (所有读者都带 `!= 0 as *u8` 守卫 —— codegen_amd64_emit_ctrl.jhyy:514
    //  的 use_per_fn、:562 的 per_fn_alloc、:591 的 per_fn_addr_pool、
    //  codegen_amd64_state.jhyy:844 的 per_fn_base_t。)
    (*s).fn_starts = 0 as *u8;
    (*s).per_fn_max = 0 as *u8;
    // v3.1.0 W-087 (alloc pool frame offset 真修,applied on top of V2 wholesale port):
    // per-fn alloc 总和 pre-scan table。emit_func_header 读 per_fn_alloc[cur_fn_idx]
    // 决定 alloc pool reserve size (= 8192 base + per_fn_alloc)。没有 pre-scan
    // → frame_size 不 cover alloc pool → alloc 写 -8200(%rbp) 越界 → 错数据 / crash
    // (V2 v4.0.0 self-backend 跟 V3 W-087 同一 bug,V2 regress 没 std_* test 触发)。
    (*s).per_fn_alloc = 0 as *u8;
    // v4.0.7 (W-097 sub-bug 2): per-fn address-holder pool byte budget。address-holder
    // pool 从 -(frame_size+64) 往下长,必须额外 reserve 进 `subq $n, %rsp`。
    (*s).per_fn_addr_pool = 0 as *u8;
    // v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):per_fn_base_t
    // cg_compute_per_fn_max_temps Phase 2 写 per_fn_base_t[i]
    // = per_fn_max[i-1] + 1 (i=0 用 0)。global t → local t 翻译表。
    (*s).per_fn_base_t = 0 as *u8;
    // wire C-side state pointer for cg_offset_for_temp / cg_local_t_from_global
    // (无 state 参数 hot path 通过 jh_cgstate_get_state 拿当前 state)
    let _wr_st = jh_cgstate_set_state(state);
    (*s).fn_count = 0 as i64;
    // v2.11.15 Iter 2 (C.3 emit_phi 真修):alloc pending phi resolution table。
    //   4 parallel i64 arrays × 128 entries × 8 bytes = 4KB total negligible。
    //   emit_phi append entries;emit_jmp scan entries for current arm;reset_for_function
    //   zero all 4 arrays per-fn(per-fn isolation)。
    let phi_dsts_bytes = (128 as i64) * (8 as i64);
    let phi_dsts_ptr = arena_alloc(arena, phi_dsts_bytes);
    let _zero_pd = memset(phi_dsts_ptr, 0 as i32, phi_dsts_bytes);
    (*s).pending_phi_dsts = phi_dsts_ptr;
    let phi_tn_bytes = (128 as i64) * (8 as i64);
    let phi_tn_ptr = arena_alloc(arena, phi_tn_bytes);
    let _zero_pt = memset(phi_tn_ptr, 0 as i32, phi_tn_bytes);
    (*s).pending_phi_tN = phi_tn_ptr;
    let phi_ap_bytes = (128 as i64) * (8 as i64);
    let phi_ap_ptr = arena_alloc(arena, phi_ap_bytes);
    let _zero_pap = memset(phi_ap_ptr, 0 as i32, phi_ap_bytes);
    (*s).pending_phi_arm_label_ptrs = phi_ap_ptr;
    let phi_al_bytes = (128 as i64) * (8 as i64);
    let phi_al_ptr = arena_alloc(arena, phi_al_bytes);
    let _zero_pal = memset(phi_al_ptr, 0 as i32, phi_al_bytes);
    (*s).pending_phi_arm_label_lens = phi_al_ptr;
    (*s).pending_phi_count = 0 as i64;
    (*s).cur_block_name = 0 as *u8;
    (*s).cur_block_name_len = 0 as i64;
    // v4.0.7 (W-097): init dual-pool fields. Both heads start 0 (meaning
    // "uninitialized for this function"); emit_func_header sets alloc_init_off
    // (formula end + 64 gap) and addr_holder_init_off (alloc end + 64 gap) once
    // it has computed alloc_pool_end_off. cg_alloc_slot lazily inits whichever
    // head it needs on first use.
    (*s).value_next_offset = 0 as i64;
    (*s).addr_next_offset = 0 as i64;
    (*s).alloc_init_off = 0 as i64;
    (*s).addr_holder_init_off = 0 as i64;
    return 0;
}

// CGState 重置(per function prologue)
// V2-B v2.6.0 (Unit B Stub-Fill): real impl — reset per-function fields.
// v2.7.0 Phase 2a: 保留 target_tag(per-compile,跨 function 共享)
// v2.11.2 (W-074.6 T3-a): 由 emit_func_header 调(per plan agent §5,关闭
//   emit_func_header:361-363 TODO "cur_fn_name 由 caller 负责")。
fn cg_state_reset_for_function(state: *u8, fn_name: *u8) -> i32 {
    let s = state as *CGState;
    // v4.0.4 Step 1 (W-101 RCA): log cur_fn_idx before reset + table sizes that
    // will be zeroed, to detect Option C (reset clobber between record/lookup).
    (*s).value_next_offset = 0 as i64;
    (*s).addr_next_offset = 0 as i64;
    (*s).total_alloc = 0 as i64;
    (*s).cur_fn_name = fn_name;
    (*s).nparams = 0 as i64;
    (*s).cur_call_text = 0 as *u8;
    (*s).cur_call_text_len = 0 as i64;
    // v2.11.3 (W-074.7 T4-c 真修):reset FN_ARG scan context。emit_func_header
    // 末尾调 cg_state_set_fn_header 覆盖这两个;此处只是 init defensive 0。
    (*s).cur_fn_header_text = 0 as *u8;
    (*s).cur_fn_header_len  = 0 as i64;
    (*s).cur_fn_arg_count   = 0 as i64;
    // v2.13.0 Phase 1: per-call arg allocation counters init。
    // emit_amd64_arg_regs 入口还会重置一次(per-call),这里是 defensive 0。
    (*s).xmm_arg_count    = 0 as i32;
    (*s).int_arg_count    = 0 as i32;
    (*s).stack_arg_offset = 0 as i64;
    // v3.4.2 W-089: ret_type_map 是 per-compile (sema 一次 populate),不随 fn 切换。
    //   这里必须 NOT reset — per-fn reset 会 wipe sema populate 的 map → 第二个
    //   fn 起 cg_query_fn_returns_ptr 拿不到 map → 返回 0 → W-089 bug 复发
    //   (v3.4.2 initial ship 6 std_* regress 100% 此 bug)。map = per-compile invariant
    //   across all functions。
    // v2.11.5 (W-074.7 alloc-tracking 真修):zero temp_slot_for_id 数组 per-fn。
    // 每个 fn 的 alloc slot 独立 — fn A 的 t17 != fn B 的 t17。重新 memset 0
    // 让 cg_offset_for_temp 在新 fn fall through formula fallback (recorded=0)
    // 直到 emit_alloc 重新写。
    if (*s).temp_slot_for_id != (0 as *u8) {
        // W-120:用实际容量 memset(常量会让大文件漏清尾部 → 上一轮的 slot 残留)。
        let slots_bytes2 = (*s).temp_slots_size * (8 as i64);
        let _zr = memset((*s).temp_slot_for_id, 0 as i32, slots_bytes2);
    }
    // v2.11.6 (W-074.7 big_test link error 真修 — scope DOWN):zero block-name
    // uniquify table per-fn。同 alloc-tracking 逻辑,per-fn 隔离。
    if (*s).block_name_uniq != (0 as *u8) {
        let bnu_bytes2 = (256 as i64) * (32 as i64);
        let _zr_bnu = memset((*s).block_name_uniq, 0 as i32, bnu_bytes2);
    }
    // v3.2.4 (W-093 真修 W-092):zero temp_holds_address bitmap per-fn (4096 bytes,
    // 跟 `ha_bytes` alloc size 一致)。fn A 的 t17 是 alloc-result address-holder,
    // fn B 的 t17 可能是 value-temp — 跨 fn flag 不 inherit。memset 0 让
    // emit_load/store/loadsub 在新 fn 头 fall through default slot path,直到
    // emit_alloc / emit_binop / emit_copy 重新写 flag。
    if (*s).temp_holds_address != (0 as *u8) {
        // W-120:用实际容量 memset。
        let ha_bytes2 = (*s).temp_holds_size as i64;
        let _zr_ha = memset((*s).temp_holds_address, 0 as i32, ha_bytes2);
    }
    // cur_fn_idx NOT reset — it grows across functions within a module
    // (per-module accumulator, inited to 0 in cg_state_init)。reset 让它归 0 会让
    // 每 fn 都从 _fn0 开始,反而破坏 T4-h 的跨 fn 唯一性设计 (fn 0 跟 fn 1 都
    // emit ".Lthen1_fn0" → GAS 仍报 label 重定义)。
    // cur_fn_idx 由 emit_func_header 末尾 bump (per-function 序号跨 module 累加)
    // frame_max_temp 不重置 — global max across module(per v2.11.2 fallback)
    // target_tag 不重置 — per-compile constant
    // v2.11.15 Iter 2 (C.3 emit_phi 真修): zero pending phi resolution tables per-fn。
    //   per-fn 隔离 — fn A 的 phi `@arm2 %t4` 跟 fn B 的 phi `@arm2 %t4` 是不同的。
    //   4 parallel i64 arrays × 128 entries × 8 bytes memset 0。
    if (*s).pending_phi_dsts != (0 as *u8) {
        let pd_bytes = (128 as i64) * (8 as i64);
        let _zr_pd = memset((*s).pending_phi_dsts, 0 as i32, pd_bytes);
    }
    if (*s).pending_phi_tN != (0 as *u8) {
        let pt_bytes = (128 as i64) * (8 as i64);
        let _zr_pt = memset((*s).pending_phi_tN, 0 as i32, pt_bytes);
    }
    if (*s).pending_phi_arm_label_ptrs != (0 as *u8) {
        let pap_bytes = (128 as i64) * (8 as i64);
        let _zr_pap = memset((*s).pending_phi_arm_label_ptrs, 0 as i32, pap_bytes);
    }
    if (*s).pending_phi_arm_label_lens != (0 as *u8) {
        let pal_bytes = (128 as i64) * (8 as i64);
        let _zr_pal = memset((*s).pending_phi_arm_label_lens, 0 as i32, pal_bytes);
    }
    (*s).pending_phi_count = 0 as i64;
    // cur_block_name NOT reset (emit_label 每次 emit 时覆盖,defer 到 emit_label call)
    // v4.0.4 Step 1 (W-101 RCA): log cur_fn_idx after reset (note: NOT bumped here,
    // bump is in emit_func_header tail). If pre/post log same idx, table zero is
    // intra-fn — fine. If different, reset races with emit_func_header bump.
    // alloc_init_off / addr_holder_init_off are NOT reset here — they are
    // per-fn-invariant (computed once by emit_func_header) and zeroed only in
    // cg_state_init. Both pool heads were already zeroed at the top of this fn.
    return 0;
}

// ════════════════════════════════════════════════════
// v2.11.15 Iter 2 (C.3 emit_phi 真修): phi resolution + cur_block_name helpers
// ════════════════════════════════════════════════════

// MAX_PHI_ENTRIES — pending phi table size。128 = ~12 phis × 10 arms avg safety。
// Out-of-bounds → no-op append (silently lose phi resolution;merge slot 保留
// stale 值,但不会 panic / crash — 退化但不恶化)。
fn cg_max_phi_entries() -> i64 {
    return 128 as i64;
}

// cg_state_set_cur_block_name — emit_label 调,把当前 block 名称写入 CGState。
// arena_alloc 字符串(per-fn 不需要清零,因为 emit_label 每次都覆盖 cur_block_name
// 指针)。
fn cg_state_set_cur_block_name(state: *u8, name: *u8, name_len: i64) -> i32 {
    if state == (0 as *u8) || name == (0 as *u8) || name_len <= (0 as i64) {
        return 0 as i32;
    }
    let s = state as *CGState;
    let arena = (*s).arena;
    let buf = arena_alloc(arena, name_len + (1 as i64));
    let mut i: i64 = 0 as i64;
    while i < name_len {
        let bp = ptr_add_u8(buf, i);
        let sp = ptr_add_u8(name, i);
        *bp = *sp;
        i = i + (1 as i64);
    }
    let np = ptr_add_u8(buf, name_len);
    *np = 0 as u8;
    (*s).cur_block_name = buf;
    (*s).cur_block_name_len = name_len;
    return 0 as i32;
}

// cg_append_phi_entry — emit_phi 调,把 (dst_slot, arm_label_text, arm_label_len,
// tN_id) append 到 pending phi table。bounds check: count < MAX_PHI_ENTRIES。
fn cg_append_phi_entry(state: *u8, dst_slot: i64, arm_text: *u8, arm_len: i64, tN_id: i64) -> i32 {
    let s = state as *CGState;
    let cnt = (*s).pending_phi_count;
    if cnt >= cg_max_phi_entries() {
        return 0 as i32;
    }
    // store dst_slot
    let pd = ptr_add_u8((*s).pending_phi_dsts, cnt * (8 as i64)) as *i64;
    *pd = dst_slot;
    // store tN
    let pt = ptr_add_u8((*s).pending_phi_tN, cnt * (8 as i64)) as *i64;
    *pt = tN_id;
    // store arm label text (arena_alloc copy)
    let arena = (*s).arena;
    let buf = arena_alloc(arena, arm_len + (1 as i64));
    let mut i: i64 = 0 as i64;
    while i < arm_len {
        let bp = ptr_add_u8(buf, i);
        let sp = ptr_add_u8(arm_text, i);
        *bp = *sp;
        i = i + (1 as i64);
    }
    let np = ptr_add_u8(buf, arm_len);
    *np = 0 as u8;
    let pap = ptr_add_u8((*s).pending_phi_arm_label_ptrs, cnt * (8 as i64)) as *i64;
    *pap = buf as i64;
    let pal = ptr_add_u8((*s).pending_phi_arm_label_lens, cnt * (8 as i64)) as *i64;
    *pal = arm_len;
    (*s).pending_phi_count = cnt + (1 as i64);
    return 0 as i32;
}

// cg_scan_pending_phi_for_arm — emit_jmp 调,scan pending_phi_* table for entry
// whose arm_label matches cur_block_name。Returns matched count (0 if no match,
// 1+ if multiple phis reference same arm — multi-phi-into-same-merge case)。
// For each match, emits `mov<size> -arm_tN_off(%rbp), %rax; mov<size> %rax, -dst_off(%rbp)`。
// Note: defined AFTER cg_streq_n (line ~907) due to jhyy no forward ref。

// cg_state_set_target — v2.7.0 Phase 2a setter
//
// 显式 setter 给 codegen_amd64_run 用(Phase 2b wire 时,从 main.jhyy 传 target `t` 进
// codegen_amd64_run,然后 codegen_amd64_run 调此 setter 写 CGState.target_tag)。
// Phase 2a 不调此 setter(target_tag 默认 0 = Win),仅为 Phase 2b 留 setter 接口。
fn cg_state_set_target(state: *u8, target_tag: i32) -> i32 {
    let s = state as *CGState;
    (*s).target_tag = target_tag;
    return 0;
}

// cg_state_set_frame_max_temp — v2.11.2 (T3-a) setter
//
// 显式 setter 给 codegen_amd64_run 在 cg_compute_global_max_temp 后调,
// 把 module-global max temp id 写进 state.frame_max_temp。
// emit_func_header 在 prologue 读 frame_max_temp 算 subq $N, %rsp 字节数。
fn cg_state_set_frame_max_temp(state: *u8, frame_max_temp: i64) -> i32 {
    let s = state as *CGState;
    (*s).frame_max_temp = frame_max_temp;
    return 0;
}

// ── v4.4.0 寄存器缓存的 setter / getter ───────────────────────────────

// cg_state_set_rc_enabled <state> <0|1>
fn cg_state_set_rc_enabled(state: *u8, v: i32) -> i32 {
    let s = state as *CGState;
    (*s).rc_enabled = v;
    return 0 as i32;
}

// cg_state_get_rc_violation <state> → 1 = 有 temp 被按栈槽访问(漏改)
fn cg_state_get_rc_violation(state: *u8) -> i32 {
    let s = state as *CGState;
    return (*s).rc_violation;
}

// cg_state_get_rc_allocated <state> → 分配到寄存器的 temp 数(统计)
fn cg_state_get_rc_allocated(state: *u8) -> i64 {
    let s = state as *CGState;
    return (*s).rc_allocated;
}

// target_is_win — v2.7.0 Phase 2b helper (moved here from emit_call in v2.8.0
// so emit_mem / emit_ctrl / peephole can also dispatch on target_tag).
//
// 返回 1 if target_tag 是 Win path (TARGET_AMD64_WIN 或 WIN_FREESTANDING),
// else 返回 0 (SysV path / SysV freestanding)。
fn target_is_win(target_tag: i32) -> i32 {
    if target_tag == (0 as i32) { return 1 as i32; }  // TARGET_AMD64_WIN
    if target_tag == (1 as i32) { return 1 as i32; }  // TARGET_AMD64_WIN_FREESTANDING
    return 0 as i32;  // TARGET_AMD64_SYSV (2) / SYSV_FREESTANDING (3) → SysV path
}

// ════════════════════════════════════════════════════
// Stack offset 计算 helpers(emit 模块共用)
// ════════════════════════════════════════════════════

// offset_for_temp(t: i64) -> i64
// 输入:%tN 编号(N),返回 stack offset(负方向)
// V2-B v2.6.0 (Unit C Regalloc): 委托给 regalloc 模块的 query。
//   - 若 regalloc 已对该函数跑过分析(regalloc_run 被调用),spill temp 返回
//     实际栈偏移(linear-scan spill 决策);register temp 返回 0(emit 函数 fallback)。
//   - 若 regalloc 未跑(默认),query 返回 0(emit 函数 fallback 到 v2.5.0 公式
//     `-(32 + t * 8)`,1-to-1 简化栈分配)。
//
// 注:Unit C 只交付 regalloc 模块本身;Unit E wire 时 codegen_amd64_run 会调
// regalloc_run 一次,然后 cg_offset_for_temp 才会返回非零值。当前 main.jhyy
// 不 import codegen_amd64,所以 emit_mem.jhyy 的 cg_offset_for_temp 永远走 fallback。
//
// v2.11.5 (W-074.7 alloc-tracking 真修):先查 alloc-tracking 表(emit_alloc
// 写入),recorded != 0 → 返回 recorded (跟 alloc 真分配的 slot 一致);
// recorded == 0 → fall through regalloc / formula。
// 这修 nested_struct_deep + struct_val_pass pre-existing bug: alloc'd %tN 之前
// 走 formula `-(32 + t*8)` 跟 alloc 真分配的 slot 不一致 → read garbage。
//
// v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):formula 路径的
// `-(32 + t*8)` 改 `-(32 + (t - per_fn_base_t[cur_fn_idx]) * 8)`。
// global t (QBE IL 跨 fn 累加, main.jhyy max=60656) 必须翻译成 local t
// (从 0 起, frame_size 用 local_max 算) 才能让 frame 跟 slot 一致
// (否则 frame 484KB → 9KB 后 slot offset -403000 越界 9KB frame)。
// helper `cg_local_t_from_global` 集中翻译,formula 路径用它。
fn cg_local_t_from_global(global_t: i64) -> i64 {
    // v4.0.4 Step 1 (W-101 RCA): log entry for high global_t to capture per-fn
    // base translation. (cur_fn_idx, idx, base_t, local_t) — extra param shows
    // whether (cur_fn_idx - 1) bounds check triggers off-by-one.
    if global_t >= (1024 as i64) {
        let st_p_e = jh_cgstate_get_state();
        if st_p_e != (0 as *u8) {
            let st_e = st_p_e as *CGState;
        }
    }
    if global_t < (0 as i64) {
        return 0 as i64;
    }
    // jh_cgstate_get_state() 拿到当前 CGState 指针(per C-bridge convention)
    let st_p = jh_cgstate_get_state();
    if st_p == (0 as *u8) {
        return global_t;
    }
    let st = st_p as *CGState;
    if (*st).per_fn_base_t == (0 as *u8) || (*st).cur_fn_idx < (1 as i64) {
        return global_t;
    }
    // v4.0.2.3 (W-096 fix 3 — fn_count off-by-one):cur_fn_idx = function_index + 1
    // (after cg_state_bump_fn_idx in emit_func_header 末尾)。Pre-scan 写
    // per_fn_base_t[fi] for fi=0..fn_count-1。所以 cur_fn_idx-1 必须 < fn_count,
    // 即 cur_fn_idx 必须 ≤ fn_count。Last function (fi=fn_count-1) →
    // cur_fn_idx = fn_count,被错误 reject 走 fallback → slot offset 越界。
    // Fix:用 idx = cur_fn_idx - 1 后 bounds check 0..fn_count-1,不要在 cur_fn_idx
    // 上早 reject。
    // v4.0.2.2 (W-096 fix 2 — cur_fn_idx off-by-one):cg_state_bump_fn_idx
    // 在 emit_func_header 末尾调(per v2.11.3 T4-h),所以 body emit 时
    // cur_fn_idx = function_index + 1。Pre-scan 写 per_fn_base_t[fi] 用
    // function_index (0..N-1)。所以读 per_fn_base_t 要用 (cur_fn_idx - 1)
    // 才匹配 pre-scan 索引。emit_func_header 自己 (cur_fn_idx = function_index
    // 时调) 读 per_fn_max[cur_fn_idx] 是 correct (因为 frame_size 在 bump 前算)。
    // **关键不变量**:cur_fn_idx 在 emit_func_header 入口 = function_index
    // (= pre-scan fi)。emit_func_header 末尾 bump → body emit 时
    // cur_fn_idx = function_index + 1。所以 body 路径 (cg_offset_for_temp
    // → cg_local_t_from_global) 要 (cur_fn_idx - 1) 才匹配 pre-scan。
    let idx = (*st).cur_fn_idx - (1 as i64);
    if idx < (0 as i64) {
        return global_t;
    }
    // v4.0.7 (W-097 剩余 SEGV):per_fn_base_t 是 1024 项表,原来只查 idx<0 没查
    // 上界。emit_func_header 每次 bump cur_fn_idx,而 pre-scan 只按它数到的
    // function header 填表 —— 两者不一致时(emit 次数 > 预扫描计数)idx 会越过
    // 表尾,`*bp` 读越界 → SIGSEGV。因为差值取决于当次跑到哪儿,所以表现为
    // **非确定性** SEGV(同一输入有时 0 有时 139)。
    // W-107 (2026-10-20):上界原本写死 **1024**(per_fn_base_t 当时的表长)。
    // 表长是 1024 ✓ —— 但 idx 越过表尾时**读越界** → 读到垃圾 base_t →
    // local_t 变成几万 → 局部变量的帧偏移 ≈ -518KB → 冲出帧 → 踩坏调用者的帧
    // → 编译器自己的 target 变成随机值 + 间歇性 SEGV。
    //
    // 修法:上界**只**用表长判 —— 下面那一行本来就是对的。
    if (*st).fn_count > (0 as i64) && idx >= (*st).fn_count {
        return global_t;
    }
    let bp = ptr_add_u8((*st).per_fn_base_t, idx * (8 as i64)) as *i64;
    let base_t = *bp;
    let local_t = global_t - base_t;
    if global_t < (64 as i64) {
    }
    if local_t < (0 as i64) {
        if global_t >= (1024 as i64) {
        }
        return 0 as i64;
    }
    if global_t >= (1024 as i64) {
    }
    return local_t;
}
// ════════════════════════════════════════════════════════════════════════
// cg_rc_check_slot_access — v4.4.0 寄存器缓存的**安全网**
// ════════════════════════════════════════════════════════════════════════
//
// 分配了寄存器的 temp 若仍被**按栈槽**访问(漏改的 emit 调用点)
// ⇒ 那个槽从来没被写过 ⇒ 静默读到垃圾 ⇒ **错代码**。
//
// ⇒ 这里置**粘滞错误标志** rc_violation;编译末尾(codegen_amd64_inmem /
//   codegen_amd64)检查它 ⇒ **编译失败** ⇒ 漏改的调用点被当场抓住。
//
// (沿用 W-120 / W-130 的「响亮失败远好过静默错代码」规矩)
//
// ⚠️ 默认**关**(rc_enabled = 0)⇒ 这条检查在阶段一完全不触发。

fn cg_rc_check_slot_access(state: *u8, t: i64) -> i32 {
    let cg = state as *CGState;
    if (*cg).rc_enabled == (0 as i32) { return 0 as i32; }
    if (*cg).rc_reg_flat == (0 as *u8) { return 0 as i32; }
    if t < (0 as i64) { return 0 as i32; }
    if t > (*cg).rc_global_max { return 0 as i32; }
    let p = ptr_add_u8((*cg).rc_reg_flat, t) as *u8;
    let v = *p as i64;
    if v >= (255 as i64) { return 0 as i32; }   // 未分配寄存器 ⇒ 走槽位是正常的
    if (*cg).rc_violation == (0 as i32) {
        (*cg).rc_violation = 1 as i32;
        jh_fputs_stderr("jhyy error: internal consistency violation — a register-allocated temp was accessed through its stack slot; the emitted code would be silently wrong (v4.4.0 register-cache guard)" as *u8);
        jh_fputs_stderr("\n" as *u8);
    }
    return 1 as i32;
}

fn cg_offset_for_temp(t: i64) -> i64 {
    if t < (0 as i64) {
        return 0 as i64;
    }
    // v4.4.0 安全网:这个 temp 若已分配寄存器,按槽位访问它就是漏改 ⇒ 标记失败
    let _st_rc = jh_cgstate_get_state();
    if _st_rc != (0 as *u8) {
        let _ = cg_rc_check_slot_access(_st_rc, t);
    }
    // v2.11.5 alloc-tracking:查询 alloc_slot 表 (per-fn CGState.temp_slot_for_id)。
    // v4.0.2.2 (W-096): temp_slot_for_id 表 keyed by global t (cross-fn累加)
    // 是 correct (alloc-result 是 unique by global t), 不变。
    let slots = jh_cgstate_get_temp_slots();
    // W-130:界用**实际容量**(state.temp_slots_size),不是常量 —— 常量
    // 65536 在大文件上会越界 → 静默不查表 → formula 兜底 → 同一个 temp 在
    // 两处解析成不同的槽 → 静默错代码(与 cg_offset_for_temp_with_target 对齐)。
    let _stp = jh_cgstate_get_state();
    let mut _cap_t: i64 = 0 as i64;
    if _stp != (0 as *u8) {
        _cap_t = ((_stp as *CGState)).temp_slots_size;
    }
    if slots != (0 as *u8) && _cap_t > (0 as i64) && t < _cap_t {
        let p = ptr_add_u8(slots, t * (8 as i64)) as *i64;
        let recorded = *p;
        if recorded != (0 as i64) {
            return recorded;
        }
    }
    // 委托 regalloc query(per Unit C 集成契约) — keyed by global t (不需改)
    let spill_off = regalloc_query_spill_off_no_arr(t);
    if spill_off != (0 as i64) {
        return spill_off;
    }
    // v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):formula 路径改用
    // local t (从 0 起, frame_size 用 local_max 算)。global t → local t
    // 翻译 per cg_local_t_from_global, 否则 frame 484KB → 9KB 后
    // global t * 8 = -485280 越界 9KB frame。
    let local_t = cg_local_t_from_global(t);
    return (0 as i64) - (32 as i64) - local_t * (8 as i64);
}

// cg_offset_for_temp_with_target — v2.8.0 target-aware variant
//
// Win path (TARGET_AMD64_WIN / WIN_FREESTANDING): per 1-to-1 formula
//   `-(32 + t*8)` — 32-byte shadow + 8 bytes per temp slot (matches MS x64 ABI
//   callee reserve + QBE 1-to-1 simplified stack layout)。
//
// SysV path (TARGET_AMD64_SYSV / SYSV_FREESTANDING): no shadow space,
//   `-(t*8)` — just per-temp slots。SysV ABI § 3.2.2 不要求 callee reserve
//   shadow,但 16-byte stack alignment 仍由 func_header prologue `andq $-16, %rsp`
//   保证 (per `runtime/linux_elf/crt0.S` + v2.8.0 SysV emit_func_header).
//
// 注: regalloc query 路径仍走 spill offset(由 codegen_amd64_run 内部调
// regalloc_run 后填),不受 target 影响。
fn cg_offset_for_temp_with_target(t: i64, target_tag: i32) -> i64 {
    // v4.4.0 安全网:这个 temp 若已分配寄存器,按槽位访问它就是漏改 ⇒ 标记失败
    let _st_rc = jh_cgstate_get_state();
    if _st_rc != (0 as *u8) {
        let _ = cg_rc_check_slot_access(_st_rc, t);
    }
    // v4.0.4 Step 1 (W-101 RCA): log entry for high t to capture lookup path.
    // Format: (cur_fn_idx, t, recorded_or_zero, formula_path) — extra param is
    // "1=recorded", "2=spill", "3=formula" disambiguator for lookup branch.
    let st_p_t = jh_cgstate_get_state();
    let cur_fni: i64 = if st_p_t != (0 as *u8) {
        ((st_p_t as *CGState)).cur_fn_idx
    } else {
        -(1 as i64)
    };
    if t < (0 as i64) {
        if t >= (1024 as i64) {
        }
        return 0 as i64;
    }
    // v2.11.5 alloc-tracking:同 cg_offset_for_temp 路径,target_tag 只影响 formula。
    let slots2 = jh_cgstate_get_temp_slots();
    // W-120:bound 用实际容量(state.temp_slots_size),不是常量 65536。
    // 越界时**跳过查表** → 落到下面的 formula 兜底 → 与记录时的槽不一致
    // → 同一个变量在两处解析成不同的槽 → 静默产出错代码(见 W-120 RCA)。
    let _slots_cap = if st_p_t != (0 as *u8) {
        ((st_p_t as *CGState)).temp_slots_size
    } else {
        cg_max_temp_slots()
    };
    if slots2 != (0 as *u8) && t < _slots_cap {
        let p2 = ptr_add_u8(slots2, t * (8 as i64)) as *i64;
        let recorded2 = *p2;
        if recorded2 != (0 as i64) {
            if t >= (1024 as i64) {
            }
            return recorded2;
        }
    } else if slots2 != (0 as *u8) && t >= _slots_cap {
        // W-120:读侧越界 → 跳过查表 → 落到下面的 formula 兜底 → 与记录时的槽
        // 不一致 → 同一个 temp 在两处解析成不同的槽 → 静默产出错代码。
        // 记下来,编译结束时 fail。
        if st_p_t != (0 as *u8) {
            let _stx = st_p_t as *CGState;
            if (*_stx).temp_table_overflow == (0 as i32) {
                (*_stx).temp_table_overflow = 1 as i32;
                jh_fputs_stderr("jhyy error: temp id exceeds the temp-slot table (W-120 guard) — the compiled output would be silently wrong" as *u8);
                jh_fputs_stderr("
" as *u8);
            }
        }
    }
    let spill_off = regalloc_query_spill_off_no_arr(t);
    if spill_off != (0 as i64) {
        if t >= (1024 as i64) {
        }
        return spill_off;
    }
    // v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):formula 路径
    // 改用 local t (跟 cg_offset_for_temp 同 per-fn-local 翻译)。
    let local_t2 = cg_local_t_from_global(t);
    let win_flag = target_is_win(target_tag);
    // Win:影子区 32 字节占了 [rbp-32, rbp) → 局部变量从 -32 起往下排。
    // SysV:没有影子区,但 **[rbp+0] 是 saveq %rbp 存回来的旧 rbp**,
    //      [rbp+8] 是返回地址 —— 局部变量**一个都不能占这两格**。
    //
    // ⚠️ W-118(2026-10-20 顺带挖出):SysV 分支原来写的是 `- local_t2*8`,
    //    于是 **local_t2 == 0 的那个局部落在 0(%rbp)** —— 直接把 saveq %rbp
    //    存回来的旧 rbp 覆盖掉。
    //    后果:该函数返回时 `popq %rbp` 弹出的是垃圾 → **rbp 寄存器被污染**
    //    (rbp 是 callee-saved)→ 它的调用者的 rbp 也跟着坏 → 调用者的
    //    序言/尾声按 rbp 算帧 → 踩飞 → SEGV。
    //    实测:`sysv_abi_test` 的 main_jhyy 里就有 `movl $1, 0(%rbp)`
    //    (它自己碰巧没崩,因为它是最外层,crt0 不在乎 rbp);
    //    同样的形状出现在**被别的函数调用**的函数里就直接 SEGV
    //    (W-114 的 enum sret 用例就是这么炸的)。
    //
    //    修法:SysV 也从 -8 起排(即 `-(local_t2+1)*8`)—— 与 Win 的语义对齐
    //    (Win 靠 -32 的影子区避开 [rbp+0..15],SysV 靠 -8 的偏移避开)。
    //    帧大小不变(frame_size = (local_max+1)*8):最低的局部变量正好落在
    //    帧底,alloc 池在再往下 32 字节 → 不重叠。
    let result_off: i64 = if win_flag == (1 as i32) {
        (0 as i64) - (32 as i64) - local_t2 * (8 as i64)
    } else {
        (0 as i64) - (local_t2 + (1 as i64)) * (8 as i64)
    };
    if t >= (1024 as i64) {
        let tag: i64 = if win_flag == (1 as i32) {
            (3 as i64)
        } else {
            (4 as i64)
        };
        let _ = tag;
    }
    return result_off;
}

// alloc_slot(size: i64) -> i64
// 输入:allocN size,返回对齐后的 slot offset(负方向,栈向下增长)
// V2-B v2.6.0 (Unit B Stub-Fill): real impl — align-up + advance offset.
//
// v2.11.23 Phase 2 (W-074.13 sub-bug 1+4 真修 — alloc pool 从 formula pool 物理分离):
// alloc pool 起始 offset = -8192 (公式 `-(32+t*8)` 在 t=255 = -2072), 留 8192-2072 = 6120 字节
// gap 给 formula pool + 任何后续 alloc 不 collision。alloc pool 自身 advance 8 字节/8B slot
// 或 aligned(alloc_size)。 Worst case:per-fn alloc ~50KB → -8192 - 50KB = -58800, 远在
// 32KB MSYS2 mingw 栈范围(2MB default)内,no overflow risk。
fn cg_alloc_slot(state: *u8, size: i64, is_addr: i32) -> i64 {
    let aligned = (size + (7 as i64)) & ((0 as i64) - (8 as i64));
    let s = state as *CGState;
    // v4.0.8 (W-097/W-098 池重叠 —— 结构性修):**单一池**。
    //
    // 原来 value(alloc)池和 address-holder 池各有一个 head,两者的深度都靠
    // pre-scan 估算(per_fn_alloc / per_fn_addr_pool)。只要估算偏小,两个池
    // 就共用槽位,而 AH 分配和 value 分配在指令流里是**交错**的 —— AH 的起点
    // 在函数头算好之后,后续的 value 分配仍可能长进 AH 区域,反过来也一样。
    // 没有任何「起点」能同时避开两者。
    //
    // address-holder 是**语义**属性(temp_holds_address bitmap),跟槽位无关:
    // 同一个槽被标记成 AH 只影响 emit_load/emit_store 走不走 indirect,
    // 不影响它存什么。合成一个单调递减的池之后,槽位天然互斥,这类重叠从
    // 结构上消失,也不再依赖任何 pre-scan 估算准不准。
    //
    // 实测危害(parser__parse_expr):AH 池 [-20584,-28824] 与 value 池
    // [-20024,-21608] 重叠 36 个槽,其中 -20592 同时是 %t7137 的指针 holder
    // 和 %t7778 的 alloc8 存储 → holder 被覆盖成 0 →
    // `mov (%r8),%rax` r8 = 0+24 = 24 → jhyy_v2.exe SEGV。
    // 泛型结构体字面量(`Box<i32> { v: 7 }`)必崩,非泛型正常 —— 因为只有那条
    // 路径的 AST 深度大到触发交叠。
    if (*s).value_next_offset == (0 as i64) {
        let mut vbase: i64 = (*s).alloc_init_off;
        if vbase == (0 as i64) {
            vbase = (0 as i64) - (8192 as i64);
        }
        (*s).value_next_offset = vbase;
    }
    let off = (*s).value_next_offset - aligned;
    (*s).value_next_offset = off;
    (*s).total_alloc = (*s).total_alloc + aligned;
    return off;
}

// cg_state_set_alloc_init_off / cg_state_set_addr_holder_init_off —
// v4.0.6 (W-101 attempt #7): emit_func_header 末尾调,在 alloc_pool_end_off
// 算完后 set addr_holder_init_off = alloc_pool_end_off - 64。alloc_init_off
// 保留记录 formula end (per audit trail,目前 unused by cg_alloc_slot —
// formula 路径 cg_offset_for_temp_with_target fall through 仍走 -8192 formula
// pool start 不变)。
fn cg_state_set_alloc_init_off(state: *u8, off: i64) -> i32 {
    let s = state as *CGState;
    (*s).alloc_init_off = off;
    return 0 as i32;
}

fn cg_state_set_addr_holder_init_off(state: *u8, off: i64) -> i32 {
    let s = state as *CGState;
    (*s).addr_holder_init_off = off;
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// v2.11.2 (W-074.6 T1-a): shared parse helpers for emit functions
// ════════════════════════════════════════════════════
//
// After W-074.5 (v2.11.1) 真修 + W-074.6 T1-a 真修,ILToken 的 text/text_len 字段
// 装整条 QBE IL 指令原文(per _emit_mem.jhyy:25-40 documented contract)。emit_*
// 函数需要 scanner 在 tok.text 内 parse operands (temp ids / labels / int literals)。
//
// emit_mem 自带 mem_* 私有 scanner (mem_parse_temp / mem_parse_int_from 等);
// v2.11.2 把这些 scanner lift 到 state 模块,emit_ctrl + emit_call 复用。
//
// emit_mem 保留自己的 mem_* 副本 — dedupe 留后续 sprint 清理。

// cg_byte_at(s: *u8, i: i64) -> i32 — 取 s[i] 字节值 as i32 (供 is_digit / scan 用)
// cg_byte_at — s[i],走 C 侧 jh_byte_at (v4.0.7 W-097 闭环根因)。
// 不能用 ptr_add_u8(s, i) 再解引用: 那依赖 ptr_add_u8 返回 temp 是否被标成
// address-holder, 而该标记来自 cg_query_fn_returns_ptr -> hash_string_n ->
// cg_byte_at, 构成循环依赖 —— 首次进入时标记尚未建立, 退化成"读指针值低字节",
// 哈希全错, 标记永远建不起来 (实测 self-backend 少标 ~1028 个 address-holder,
// 级联出 212/3084 个函数 emit 不同)。
fn cg_byte_at(s: *u8, i: i64) -> i32 {
    if s == (0 as *u8) { return 0 as i32; }
    return jh_byte_at(s, i);
}

// ════════════════════════════════════════════════════════════════════════
// v3.4.2 W-089 真修: SymbolReturnTypeMap (跨函数 call graph semantic lookup)
//
// Replaces v3.1.0 byte-prefix whitelist (emit_call L898-1091 194 LOC) which
//   was the last V3 self-backend workaround. Map populated by sema Pass 1.6
//   (sema.jhyy check_module_populate_ret_type_map) — fn sym name (FNV-1 hash,
//   util.hash_string) → ptr_kind flag. Query replaces heuristic with semantic
//   "does this fn return a pointer-equivalent type?".
//
// Wired from main.jhyy:compile() AFTER sema_check populates sema.ret_type_map.
//   Codegen reads from CGState directly (no extern bridge needed since both
//   sema and codegen live in same compile).
//
// Position: 放在 cg_byte_at 之后因为 cg_is_builtin_ptr_fn 调 cg_byte_at
//   取字节 — jhyy 单 pass 无 forward ref (per [[feedback_jhyy_no_forward_ref]])。
// ════════════════════════════════════════════════════════════════════════

// cg_state_set_ret_type_map — wire sema's SymbolReturnTypeMap into current
//   CGState. Called by codegen_amd64_run / codegen_amd64_run_text after
//   cg_state_init (per main.jhyy:compile() threading). map=0 / n=0 是合法空 map
//   → cg_is_builtin_ptr_fn fallback 仍生效 (link-only externs 走 hardcoded list)。
fn cg_state_set_ret_type_map(state: *u8, map: *u8, n: i64) -> i32 {
    let s = state as *CGState;
    (*s).ret_type_map = map;
    (*s).ret_type_map_n = n;
    return 0 as i32;
}

// cg_get_ret_type_map / cg_get_ret_type_map_n — query helpers (used by
//   cg_query_fn_returns_ptr; exposed for tests / external access).
fn cg_get_ret_type_map(state: *u8) -> *u8 {
    let s = state as *CGState;
    return (*s).ret_type_map;
}

fn cg_get_ret_type_map_n(state: *u8) -> i64 {
    let s = state as *CGState;
    return (*s).ret_type_map_n;
}

// cg_is_builtin_ptr_fn — fallback for link-only externs (functions that the
//   compiler emits `call $name` to but don't appear in user source as
//   `fn name(...)` declarations, so ret_type_map can't catch them). These
//   are the C runtime helpers + stage0 codegen intrinsics.
//
// Hardcoded because they're stable: ptr_add / ptr_add_u8 / ptr_sub / malloc /
//   __closure_<N> are core codegen / runtime primitives. Adding new entries
//   requires editing this function (no string-prefix match → no false positives).
//
// Returns 1 iff name (with len) matches one of the builtin pointer-returning
//   functions, 0 otherwise.
// cg_is_ptr_ret_extern - 返回指针的 extern 白名单(v4.0.8 W-097 根因 4)。
//
// emit_load 的 fallback 分支是「把 src 槽的值拷到 dst」,只有在 src temp 被
// 标成 address-holder 时才走 indirect 读(`movq -src(%rbp), %r8; mov (%r8), %rax`)。
// call 返回值的 address-holder 标记由 cg_query_fn_returns_ptr 决定,而它只查
//   (a) sema ret_type_map - 只装 module 内 NODE_FUNC_DECL,**extern 无函数体不装**
//   (b) cg_is_builtin_ptr_fn 白名单 - 只有 ptr_add/ptr_add_u8/ptr_sub/malloc
// `jh_cgstate_get_state` / `arena_alloc` 等 extern 两条路都落空 -> 返回 temp 没标记
// -> `%t447 =l add %t446, 104` 派生地址也没标记 -> `%t448 =l loadl %t447`
// 走 fallback 把**地址**当成值拷过去。
// 后果实测:cg_local_t_from_global 读到 `st+104` 而不是 1 -> cur_fn_idx 变 1.6e12
// -> `idx >= 1024` 提前 return -> per-fn 翻译全失效 -> 所有公式槽偏移错位。
// stage0(C 编译器)是独立实现不走这条路径,所以只有 jhyy_v2.exe 中招。
fn cg_is_ptr_ret_extern(name: *u8, name_len: i64) -> i32 {
    if name_len == (11 as i64) && memcmp(name, "arena_alloc" as *u8, 11 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (5 as i64) && memcmp(name, "fopen" as *u8, 5 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (28 as i64) && memcmp(name, "jh_cgstate_get_holds_address" as *u8, 28 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (20 as i64) && memcmp(name, "jh_cgstate_get_state" as *u8, 20 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (25 as i64) && memcmp(name, "jh_cgstate_get_temp_slots" as *u8, 25 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (11 as i64) && memcmp(name, "jh_fopen_wb" as *u8, 11 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (9 as i64) && memcmp(name, "jh_getenv" as *u8, 9 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (11 as i64) && memcmp(name, "jh_path_gcc" as *u8, 11 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (15 as i64) && memcmp(name, "jh_path_helpers" as *u8, 15 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (11 as i64) && memcmp(name, "jh_path_qbe" as *u8, 11 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (15 as i64) && memcmp(name, "jh_path_runtime" as *u8, 15 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (15 as i64) && memcmp(name, "jh_regalloc_get" as *u8, 15 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (17 as i64) && memcmp(name, "jh_run_get_output" as *u8, 17 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (6 as i64) && memcmp(name, "memcpy" as *u8, 6 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (6 as i64) && memcmp(name, "memset" as *u8, 6 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (7 as i64) && memcmp(name, "realloc" as *u8, 7 as i64) == (0 as i32) { return 1 as i32; }
    if name_len == (7 as i64) && memcmp(name, "strrchr" as *u8, 7 as i64) == (0 as i32) { return 1 as i32; }
    return 0 as i32;
}
fn cg_is_builtin_ptr_fn(name: *u8, name_len: i64) -> i32 {
    // v4.0.7 (W-097): 改用 memcmp,不再逐字节 cg_byte_at ——
    // 后者要求 ptr_add_u8 的返回 temp 已标 address-holder,与被查询对象循环依赖。
    //
    // 注:"ptr_add_u8" 是 **10** 字符 (p,t,r,_,a,d,d,_,u,8)。旧代码门限写 11,
    // 下面却只比较 10 个字节 —— 这个 off-by-one 让它永远匹配不上。
    if name == (0 as *u8) || name_len <= (0 as i64) {
        return 0 as i32;
    }
    if name_len == (7 as i64) {
        if memcmp(name, "ptr_add" as *u8, 7 as i64) == (0 as i32) { return 1 as i32; }
        if memcmp(name, "ptr_sub" as *u8, 7 as i64) == (0 as i32) { return 1 as i32; }
    }
    if name_len == (10 as i64) {
        if memcmp(name, "ptr_add_u8" as *u8, 10 as i64) == (0 as i32) { return 1 as i32; }
    }
    if name_len == (6 as i64) {
        if memcmp(name, "malloc" as *u8, 6 as i64) == (0 as i32) { return 1 as i32; }
    }
    if name_len >= (10 as i64) {
        if memcmp(name, "__closure_" as *u8, 10 as i64) == (0 as i32) { return 1 as i32; }
    }
    return 0 as i32;
}

// cg_query_fn_returns_ptr — semantic lookup. Returns 1 iff callee name (with
//   len) refers to a function whose return is pointer-equivalent (*T / Cap<T> /
//   &T / KIND_FUNC returning *T). Replaces v3.1.0 byte-prefix whitelist.
//
// Lookup order:
//   1. Map lookup: hash name → linear scan map (util.hash_string to match
//      sema's hash). Returns ptr_kind flag.
//   2. cg_is_builtin_ptr_fn fallback for link-only externs (ptr_add etc.)
fn cg_query_fn_returns_ptr(state: *u8, name: *u8, name_len: i64) -> i32 {
    if name == (0 as *u8) || name_len <= (0 as i64) {
        return 0 as i32;
    }
    let s = state as *CGState;
    // v4.0.7 (W-097): builtin + mangled 后缀 **先查**,map 哈希查找放后面。
    // 顺序不能反: 旧的 map-first 顺序构成循环依赖 ——
    //   cg_query_fn_returns_ptr("ptr_add_u8") -> hash_string_n -> cg_byte_at
    //     -> 该 temp 要间接加载 -> 需 address-holder 标记 -> 又调本函数
    // 嵌套进入时 hash_string_n 里的 cg_byte_at 尚未拿到标记,退化成"读指针值低
    // 字节",哈希全错,builtin 分支永远匹配不上 —— 标记也就永远建立不起来。
    // memcmp / C 后缀比较不经过 ptr_add_u8 + address-holder 机制,放最前即可切断。
    if cg_is_builtin_ptr_fn(name, name_len) != (0 as i32) {
        return 1 as i32;
    }
    if jh_name_ends_with(name, name_len, "ptr_add_u8" as *u8, 10 as i64) != (0 as i32) { return 1 as i32; }
    if jh_name_ends_with(name, name_len, "ptr_add" as *u8, 7 as i64) != (0 as i32) { return 1 as i32; }
    if jh_name_ends_with(name, name_len, "ptr_sub" as *u8, 7 as i64) != (0 as i32) { return 1 as i32; }
    if jh_name_ends_with(name, name_len, "malloc" as *u8, 6 as i64) != (0 as i32) { return 1 as i32; }
    if cg_is_ptr_ret_extern(name, name_len) != (0 as i32) { return 1 as i32; }
    let map = (*s).ret_type_map;
    let n = (*s).ret_type_map_n;
    // Map lookup — linear scan over RetTypeMapEntry array
    // v3.4.2 W-089 真修:用 hash_string_n(name, name_len) (跟 sema Pass 1.6 的
    //   hash_string 对齐)。hash_string 用 strlen 读到 NUL,但 emit_call 传入的
    //   name 是 tok text 子串 (e.g. "$std_arena_calloc" 中 "$" 之后) — 不在 right
    //   place NUL-terminate → strlen 读到 tok 末尾外乱字节 → hash 错配 →
    //   SymbolReturnTypeMap lookup 失败 → 返回 ptr_kind=0 → emit_call 不 flag
    //   address-holder → W-089 bug 复发 (v3.4.2 initial ship saw 6 std_* test
    //   regress: std_arena_calloc/std_fmt_*/std_vec_basic → 100% 因 hash miss)。
    if map != (0 as *u8) && n > (0 as i64) {
        let h = hash_string_n(name, name_len);
        let mut i: i64 = 0 as i64;
        while i < n {
            let entry = ptr_add_u8(map, i * (16 as i64)) as *RetTypeMapEntry;
            if (*entry).name_hash == h {
                return (*entry).ptr_kind;
            }
            i = i + (1 as i64);
        }
    }
    // Builtin fallback (link-only externs not in sema)
    return cg_is_builtin_ptr_fn(name, name_len);
}

// v2.11.6 (W-074.7 big_test link error 真修 — scope DOWN): block-name uniquify
// table entry。每 entry = (name_hash, name_len, count)。name_hash + name_len
// 用于 name 比对(避免 hash collision 错配)。放在 cg_byte_at 之后因为 record/lookup
// helpers 调 cg_byte_at 取 hash,jhyy 不支持 forward ref。
type BlockNameEntry = struct {
    name_hash: i64,    // name 字符串 hash (sum * 31 + byte, 简化 FNV-like)
    name_len:  i64,    // name 字符串长度
    count:     i64,    // next suffix to emit (0 = first def → _b0, 1 = second → _b1, ...)
}

// MAX_BLOCK_NAMES — block-name uniquify table 大小。256 = 4x big_test 实测 (~60 unique
// block names) safety margin。Out-of-bounds → linear search 跳过;emit_label 在
// table full 时 fall through 默认 `_b<count>` (preserves baseline behavior, 退化
// 静默重复但 link error 仍 report — 安全 net)。
fn cg_max_block_names() -> i64 {
    return 256 as i64;
}

// cg_record_block_name — v2.11.6 setter,emit_label 调,记录该 block name 在
// 当前 fn 的 def 序号 (返回 next suffix to emit)。第一次 def → 0,第二次 → 1, etc。
// Linear search 256-entry table;未找到空 slot → return -1 (emit_label fallback
// 用 `_b<0>`,preserves v2.11.5 behavior,table full 时 link error 仍会出)。
fn cg_record_block_name(state: *u8, name: *u8, name_len: i64) -> i64 {
    if state == (0 as *u8) || name == (0 as *u8) || name_len <= (0 as i64) {
        return -(1 as i64);
    }
    let s = state as *CGState;
    if (*s).block_name_uniq == (0 as *u8) {
        return -(1 as i64);
    }
    // hash name (FNV-like: h = h * 31 + byte)
    let mut h: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < name_len {
        let c = cg_byte_at(name, i) as i64;
        h = h * (31 as i64) + c;
        i = i + (1 as i64);
    }
    // linear search existing entry
    let table = (*s).block_name_uniq;
    let max_n = cg_max_block_names();
    let mut j: i64 = 0 as i64;
    while j < max_n {
        let e = ptr_add_u8(table, j * (32 as i64)) as *BlockNameEntry;
        if (*e).name_hash == h && (*e).name_len == name_len {
            // found: increment + return next count
            (*e).count = (*e).count + (1 as i64);
            return (*e).count;
        }
        j = j + (1 as i64);
    }
    // not found: find empty slot (name_hash == 0 → empty)
    let mut k: i64 = 0 as i64;
    while k < max_n {
        let e = ptr_add_u8(table, k * (32 as i64)) as *BlockNameEntry;
        if (*e).name_hash == (0 as i64) {
            (*e).name_hash = h;
            (*e).name_len = name_len;
            (*e).count = 0 as i64;
            return 0 as i64;
        }
        k = k + (1 as i64);
    }
    // table full
    return -(1 as i64);
}

// cg_lookup_block_name — v2.11.6 lookup,emit_jmp/emit_jnz 调,返回该 block name
// 在当前 fn 的 "last assigned suffix"。Loop back-edge (jmp 在 def 后) 命中;
// forward edge (jmp 在 def 前) miss → return 0 default _b0 (assumes first def,
// 对 nested loops 大多正确;后续 false 跳转留 v2.11.7+ 真修)。
fn cg_lookup_block_name(state: *u8, name: *u8, name_len: i64) -> i64 {
    if state == (0 as *u8) || name == (0 as *u8) || name_len <= (0 as i64) {
        return 0 as i64;
    }
    let s = state as *CGState;
    if (*s).block_name_uniq == (0 as *u8) {
        return 0 as i64;
    }
    // hash name
    let mut h: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < name_len {
        let c = cg_byte_at(name, i) as i64;
        h = h * (31 as i64) + c;
        i = i + (1 as i64);
    }
    // linear search
    let table = (*s).block_name_uniq;
    let max_n = cg_max_block_names();
    let mut j: i64 = 0 as i64;
    while j < max_n {
        let e = ptr_add_u8(table, j * (32 as i64)) as *BlockNameEntry;
        if (*e).name_hash == h && (*e).name_len == name_len {
            return (*e).count;
        }
        j = j + (1 as i64);
    }
    return 0 as i64;
}

// cg_is_digit(c: i32) -> i32 — 1 if c 是 '0'-'9',else 0
fn cg_is_digit(c: i32) -> i32 {
    if c >= (48 as i32) && c <= (57 as i32) {
        return 1 as i32;
    }
    return 0 as i32;
}

// cg_parse_temp(text: *u8, len: i64, idx: i64) -> i64
// 扫 text[0..len] 里第 idx 个(0-based)`%tN`,返回 N;不存在返回 -1。
// `%` 后必须紧跟 't' 才算 temp — 避开 `%rbp` 之类(防御性写)。
// 注:跟 _emit_mem.jhyy:96 mem_parse_temp 同样的 scan 规则,只是共用 cg_ 前缀。
fn cg_parse_temp(text: *u8, len: i64, idx: i64) -> i64 {
    if text == (0 as *u8) || len <= (0 as i64) {
        return -(1 as i64);
    }
    let mut seen: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i + (1 as i64) < len {
        if cg_byte_at(text, i) == (37 as i32) && cg_byte_at(text, i + (1 as i64)) == (116 as i32) {
            // 命中 "%t",往后收数字
            let mut k: i64 = i + (2 as i64);
            let mut val: i64 = 0 as i64;
            let mut ndig: i64 = 0 as i64;
            while k < len && cg_is_digit(cg_byte_at(text, k)) != (0 as i32) {
                val = val * (10 as i64) + ((cg_byte_at(text, k) - (48 as i32)) as i64);
                ndig = ndig + (1 as i64);
                k = k + (1 as i64);
            }
            if ndig > (0 as i64) {
                if seen == idx {
                    return val;
                }
                seen = seen + (1 as i64);
            }
            i = k;
        } else {
            i = i + (1 as i64);
        }
    }
    return -(1 as i64);
}

// cg_parse_int_from(text: *u8, len: i64, from: i64) -> i64
// 扫 text[from..len] 里第一个十进制整数;返回值,没有返回 -1。
// v2.11.20 RC-4: 支持 leading '-' 负数 prefix (e.g. `copy -3`)。
// 原 code 只 parse digit,负数返正数 → match_range bucket_neg 范围 -3..-1
// 解析成 3..1 → cslew 全 false → bucket_neg 全部 fallthrough 到 wildcard
// arm 返 -1 → 3 个 assert fail。
// (跟 mem_parse_int_from 同样的 scan 规则 — 共享 helper。)
fn cg_parse_int_from(text: *u8, len: i64, from: i64) -> i64 {
    if text == (0 as *u8) || from < (0 as i64) {
        return -(1 as i64);
    }
    let mut i: i64 = from;
    let mut neg = 0 as i32;
    while i < len {
        if cg_byte_at(text, i) == (45 as i32) {  // '-'
            neg = 1 as i32;
            i = i + (1 as i64);
            continue;
        }
        if cg_is_digit(cg_byte_at(text, i)) != (0 as i32) {
            let mut val: i64 = 0 as i64;
            while i < len && cg_is_digit(cg_byte_at(text, i)) != (0 as i32) {
                val = val * (10 as i64) + ((cg_byte_at(text, i) - (48 as i32)) as i64);
                i = i + (1 as i64);
            }
            if neg != (0 as i32) {
                return -val;
            }
            return val;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_find_byte(text: *u8, len: i64, c: i32, from: i64) -> i64
// 扫 text[from..len] 里第一个 byte 等于 c,返回 offset (相对 text 起);不存在返 -1。
// v2.11.4 (W-074.7 T4-b 真修):emit_binop src1/src2 parse 找 `,` 分隔符。
fn cg_find_byte(text: *u8, len: i64, c: i32, from: i64) -> i64 {
    if text == (0 as *u8) || from < (0 as i64) {
        return -(1 as i64);
    }
    let mut i: i64 = from;
    while i < len {
        if cg_byte_at(text, i) == c {
            return i;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_streq_n(a: *u8, b: *u8, n: i64) -> i32
// N 字节定长比较 (跟 memcmp 不同:不强求 NUL 终止,严格 N 截断)。
// 返 1 if a[0..n) == b[0..n),else 0。任一为 NULL → 0。
fn cg_streq_n(a: *u8, b: *u8, n: i64) -> i32 {
    if a == (0 as *u8) || b == (0 as *u8) {
        return 0 as i32;
    }
    if n <= (0 as i64) {
        return 1 as i32;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        if cg_byte_at(a, i) != cg_byte_at(b, i) {
            return 0 as i32;
        }
        i = i + (1 as i64);
    }
    return 1 as i32;
}

// cg_scan_pending_phi_for_arm — emit_jmp 调 (定义在 cg_streq_n 之后以满足
// jhyy 无 forward reference)。scan pending_phi_* table for entry whose arm_label
// matches cur_block_name。Returns matched count (0 if no match, 1+ if multiple
// phis reference same arm — multi-phi-into-same-merge case)。
// For each match, emits `movq -arm_tN_off(%rbp), %rax; movq %rax, -dst_off(%rbp)`
// (8-byte l suffix — QBE IL phi 默认 l type,即使 phi 标 w/s/d 也容错,因为
// slot 8 字节写满,l 读 OK;真正按 qt 分 W/L/S/D 留 v2.11.16 — 当前 Iter 2
// 优先 closure 数量)。
fn cg_scan_pending_phi_for_arm(state: *u8, out: *u8) -> i32 {
    let s = state as *CGState;
    let cnt = (*s).pending_phi_count;
    if cnt <= (0 as i64) {
        return 0 as i32;
    }
    let cur_name = (*s).cur_block_name;
    let cur_len = (*s).cur_block_name_len;
    if cur_name == (0 as *u8) || cur_len <= (0 as i64) {
        return 0 as i32;
    }
    let mut matched: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < cnt {
        let pap = ptr_add_u8((*s).pending_phi_arm_label_ptrs, i * (8 as i64)) as *i64;
        let arm_name_i: i64 = *pap;
        let arm_name = arm_name_i as *u8;
        let pal = ptr_add_u8((*s).pending_phi_arm_label_lens, i * (8 as i64)) as *i64;
        let arm_len = *pal;
        if cg_streq_n(cur_name, arm_name, cur_len) != (0 as i32) && cur_len == arm_len {
            // match: emit mov from arm_tN slot to dst_slot
            let pd = ptr_add_u8((*s).pending_phi_dsts, i * (8 as i64)) as *i64;
            let dst_off = *pd;
            let pt = ptr_add_u8((*s).pending_phi_tN, i * (8 as i64)) as *i64;
            let tN_id = *pt;
            let arm_tN_off = cg_offset_for_temp(tN_id);
            let _s2 = sb_appendf_lld((*s).arena, out, "  movq %lld(%%rbp), %%rax\n" as *u8, arm_tN_off);
            let _s3 = sb_appendf_lld((*s).arena, out, "  movq %%rax, %lld(%%rbp)\n" as *u8, dst_off);
            matched = matched + (1 as i64);
        }
        i = i + (1 as i64);
    }
    return matched as i32;
}

// cg_find_at(text: *u8, len: i64, from: i64) -> i64
// 扫 text[from..len] 第一个 '@' 的 offset;没有返 -1。
// emit_jnz / emit_jmp 用来定位 label (e.g. "@then1" → offset of '@')。
fn cg_find_at(text: *u8, len: i64, from: i64) -> i64 {
    if text == (0 as *u8) || from < (0 as i64) {
        return -(1 as i64);
    }
    let mut i: i64 = from;
    while i < len {
        if cg_byte_at(text, i) == (64 as i32) {  // '@' = 64
            return i;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_find_dollar(text: *u8, len: i64, from: i64) -> i64
// 扫 text[from..len] 第一个 '$' 的 offset;没有返 -1。
// emit_call 用:解析 "$name" callee name (e.g. "$fib")。
fn cg_find_dollar(text: *u8, len: i64, from: i64) -> i64 {
    if text == (0 as *u8) || from < (0 as i64) {
        return -(1 as i64);
    }
    let mut i: i64 = from;
    while i < len {
        if cg_byte_at(text, i) == (36 as i32) {  // '$' = 36
            return i;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_find_sub(text: *u8, len: i64, pat: *u8, pat_len: i64) -> i64
// 在 text[0..len) 中找 pat[0..pat_len) 首次出现的下标,找不到返 -1。
// 注:跟 _emit_mem.jhyy:66 mem_find_sub 区别 — mem_find_sub 要求 pat NUL-终止 +
// strlen(pat),cg_find_sub 显式接 pat_len,允许任意 byte slice。
fn cg_find_sub(text: *u8, len: i64, pat: *u8, pat_len: i64) -> i64 {
    if text == (0 as *u8) || pat == (0 as *u8) {
        return -(1 as i64);
    }
    if pat_len <= (0 as i64) || pat_len > len {
        return -(1 as i64);
    }
    let mut i: i64 = 0 as i64;
    while i + pat_len <= len {
        if cg_streq_n(ptr_add_u8(text, i), pat, pat_len) != (0 as i32) {
            return i;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// ════════════════════════════════════════════════════
// Emit function extern declarations(给 main entry import 时用)
// ════════════════════════════════════════════════════
//
// 实际定义在 sibling modules(A2/A3/A4 emit 模块):
//   codegen_amd64_emit_mem.jhyy   → emit_alloc / emit_store / emit_loadsub / emit_load
//   codegen_amd64_emit_ctrl.jhyy  → emit_jmp / emit_jnz / emit_label / emit_ret
//                                   emit_func_header / emit_data_string
//   codegen_amd64_emit_call.jhyy  → emit_call / emit_phi / emit_copy / emit_binop
//                                   emit_volatile
//
// 所有 emit 函数统一签名:(state: *u8, tok: *u8) -> i32
//   - state: *CGState
//   - tok: *ILToken
//   - return: 0 = success, non-zero = error

// emit_mem 系列(A2 写)— extern decl 给 main entry 用,实现去 codegen_amd64_emit_mem.jhyy
// emit_ctrl 系列(A3 写)— extern decl 给 main entry 用,实现去 codegen_amd64_emit_ctrl.jhyy
// emit_call 系列(A4 写)— extern decl 给 main entry 用,实现去 codegen_amd64_emit_call.jhyy
//
// 注意:jhyy 当前 extern 不支持多文件 forward decl,所有跨模块 import 的函数必须在 import 文件中
// 有 def(或 extern decl)。本模块定义所有 extern decl,emit 模块定义实现,main import 本模块即可。

// ════════════════════════════════════════════════════
// V2-B v2.6.0 Unit C Regalloc 集成
// ════════════════════════════════════════════════════
//
// codegen_amd64_regalloc 模块是线性扫描 regalloc pass。state 模块 import 它
// 是为了让 cg_offset_for_temp 能"调用 regalloc 模块"(per plan § v2.6.0 Unit C
// 第 2 条要求)。具体行为:
//   - cg_offset_for_temp(t) 调用 regalloc_query_spill_off_no_arr(t)
//   - 若 regalloc 已跑(由 codegen_amd64_run 调用 regalloc_run 设置 global):
//     返回 regalloc 算出的 spill 偏移(可能是 v2.5.0 fallback 公式,也可能不同)
//   - 若 regalloc 未跑:返回 0(emit_mem.jhyy 的 mem_temp_offset fallback 到
//     `-(32 + t * 8)`,即 v2.5.0 1-to-1 栈分配)
//
// Unit C 阶段 regalloc_run 不被自动调用(等 Unit E wire codegen_amd64_run);现在
// import 是为了把 regalloc 模块拉到 import graph 里,后续 Unit E 调用时不用再改
// state.jhyy 的 import。
// (import 已移到文件顶部 per jhyy 不支持 fn forward reference)

// ═══════════════════════════════════════════════════════════════════════════
// v2.11.2 (W-074.6 T3-a) global-max frame variant helpers
// ═══════════════════════════════════════════════════════════════════════════
//
// 全 module 扫一次,找最大的 %tN,用做 frame size = 32 + (max_temp+1)*8。
// Per-function pre-scan table 留 v2.11.3 EXIT exact (~60 LOC)。
//
// cg_token_max_temp_id(tok_p, tok_size, idx) -> i64
//   读 token[idx],从 text 字段扫所有 %tN 取 max。tok_size=40 (per lex_il)。
//   text=0 (declaration tokens) → 返 -1。
//   没有 %tN → 返 -1。
fn cg_token_max_temp_id(tok_p: *u8, tok_size: i64, idx: i64) -> i64 {
    if tok_p == (0 as *u8) { return -(1 as i64); }
    let tok_start = (tok_p as i64 + idx * tok_size) as *u8;
    let t = tok_start as *ILToken;
    let text = (*t).text;
    let text_len = (*t).text_len;
    if text == (0 as *u8) || text_len <= (0 as i64) {
        return -(1 as i64);
    }
    let mut max_id: i64 = -(1 as i64);
    let mut i: i64 = 0 as i64;
    while i < text_len {
        let c = cg_byte_at(text, i);
        if c == (37 as i32) && i + (1 as i64) < text_len {
            let c2 = cg_byte_at(text, i + (1 as i64));
            if c2 == (116 as i32) {  // 't'
                let mut k: i64 = i + (2 as i64);
                let mut val: i64 = 0 as i64;
                let mut ndig: i64 = 0 as i64;
                while k < text_len && cg_is_digit(cg_byte_at(text, k)) != (0 as i32) {
                    val = val * (10 as i64) + ((cg_byte_at(text, k) - (48 as i32)) as i64);
                    ndig = ndig + (1 as i64);
                    k = k + (1 as i64);
                }
                if ndig > (0 as i64) {
                    if val > max_id { max_id = val; }
                }
                i = k;
            } else {
                i = i + (1 as i64);
            }
        } else {
            i = i + (1 as i64);
        }
    }
    return max_id;
}

// cg_compute_global_max_temp(tok_p, tok_size, n) -> i64
//   单 pass 扫整个 token 数组,返最大 %tN。找不到返 0 (safe 0 offset = 32 字节)。
fn cg_compute_global_max_temp(tok_p: *u8, tok_size: i64, n: i64) -> i64 {
    let mut gmax: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t_max = cg_token_max_temp_id(tok_p, tok_size, i);
        if t_max > gmax { gmax = t_max; }
        i = i + (1 as i64);
    }
    return gmax;
}

// cg_token_alloc_size(tok_p, tok_size, idx) -> i64
//   读 token[idx] 的 ILTOK_ALLOC text,parse `alloc<N> <size>` 返 size (字节)。
//   非 alloc token → 返 -1 (让 caller 跳过)。
//   语法:`alloc4 N` / `alloc8 N` / `alloc16 N`,N 是正整数。
//   必须跳过 `alloc` 后面的 align digit (例 `alloc8`),否则会把 '8' 当 size。
fn cg_token_alloc_size(tok_p: *u8, tok_size: i64, idx: i64) -> i64 {
    if tok_p == (0 as *u8) { return -(1 as i64); }
    let tok_start = (tok_p as i64 + idx * tok_size) as *u8;
    let t = tok_start as *ILToken;
    if (*t).kind != ILTOK_ALLOC() {
        return -(1 as i64);
    }
    let text = (*t).text;
    let text_len = (*t).text_len;
    if text == (0 as *u8) || text_len <= (0 as i64) {
        return -(1 as i64);
    }
    let mut i: i64 = 0 as i64;
    while i + (4 as i64) < text_len {
        if cg_byte_at(text, i) == (97 as i32) && cg_byte_at(text, i + (1 as i64)) == (108 as i32)
            && cg_byte_at(text, i + (2 as i64)) == (108 as i32) && cg_byte_at(text, i + (3 as i64)) == (111 as i32)
            && cg_byte_at(text, i + (4 as i64)) == (99 as i32) {
            break;
        }
        i = i + (1 as i64);
    }
    if i + (4 as i64) >= text_len {
        return -(1 as i64);
    }
    let mut j: i64 = i + (5 as i64);
    while j < text_len && cg_is_digit(cg_byte_at(text, j)) != (0 as i32) {
        j = j + (1 as i64);
    }
    while j < text_len {
        let sc_byte: i32 = cg_byte_at(text, j);
        if sc_byte == (32 as i32) || sc_byte == (9 as i32) {
            j = j + (1 as i64);
        } else {
            break;
        }
    }
    let mut size: i64 = 0 as i64;
    let mut ndig: i64 = 0 as i64;
    while j < text_len && cg_is_digit(cg_byte_at(text, j)) != (0 as i32) {
        size = size * (10 as i64) + ((cg_byte_at(text, j) - (48 as i32)) as i64);
        ndig = ndig + (1 as i64);
        j = j + (1 as i64);
    }
    if ndig == (0 as i64) {
        return -(1 as i64);
    }
    return size;
}

// ═════════════════════════════════════════════════════════════════════════
// v2.11.10 (W-074.6 T3-a closure) per-fn max temp pre-scan
// ═════════════════════════════════════════════════════════════════════════
//
// 替换 v2.11.2 cg_compute_global_max_temp (单 frame_size 全 module 共用 → 递归
// fn SIGSEGV)。两阶段 pre-scan:
//   Phase 1: 扫 tokens 找所有 ILTOK_FUNC_HEADER 位置 → state.fn_starts[256]
//            + 哨兵 fn_starts[fn_count] = n (end of last fn body)
//   Phase 2: 对每 [fn_starts[i], fn_starts[i+1]) 调 cg_token_max_temp_id 找
//            max temp id → state.per_fn_max[i] (i64 array,frame_size = (max+1)*8)
//
// emit_func_header 读 per_fn_max[cur_fn_idx] 算 frame_size → 每个 fn 独立
// frame。递归 fn fact/fib/gcd 只用 5-10 temps → frame 88 字节 vs 之前 15488
// 字节 → 递归深度 30 才 2640 字节,完全 fit Windows 1MB default thread stack。
//
// (旧的表长上限 1024 → 4096 已随 W-107 终局删除 —— 表按实际函数数分配)
// future stdlib-heavy modules):fn_count >= 1024 safety check 截断到 1023 +
// fn_starts[1023] 哨兵 (留 last fn 的 remaining tokens 全归 fn 1023)。n=0 (空
// module) → fn_count=0 → emit_func_header fall through global-max legacy path
// (per-fn_max 都 0 → frame_size=8 → 0 字节 frame, 安全 no-op 退路)。
//
// fn_starts / per_fn_max 字段:见 CGState struct (v2.11.10 真修)。
// 调用方:codegen_amd64.jhyy:279 (v2.11.10 替换 cg_compute_global_max_temp)。
// cg_resize_temp_tables — W-120 (2026-10-20):按**实际最大 temp id**重新分配
//   两张「按 temp id 索引」的表(temp_slot_for_id + temp_holds_address)。
//
// **为什么必须有这一步(W-120 的根因):**
// temp id 是 IL emitter **全局**编号的 —— 一个文件里用过的最大 id 就是它的
// 上限。固定 65536 的常量只够「main.jhyy 那种规模」,而 main.jhyy 已经到
// **60462**(只剩 8% 余量)。
//
// 而超限的后果**不是报错,是静默产出错代码**:
//
//   temp id ≥ 表长
//     → cg_record_temp_slot 不记录(bound check 直接 return)
//     → cg_offset_for_temp_with_target 跳过查表(bound check)
//     → 落到 formula 兜底路径 `-(32 + t*8)`
//     → 同一个 temp 在「写」和「读」两处解析成**不同的槽**
//     → 值静默丢失
//
// 实测(一个 25000 语句的函数,25000 × ~3 temp ≈ 75000 ids):
//   修复前:算出 s=0(正确值 74994)—— 编译成功、链接成功、运行成功、**值是错的**
//   修复后:s=74994 ✓
//
// **为什么重新分配而不是「就地扩容」:** arena 不能 realloc,而 pre-scan 跑在
// emit **之前** —— 此刻两张表还是空的(记录只发生在 emit 期),所以直接换一块
// 新内存就行,旧的那块留在 arena 里当一次性开销。
//
// **只在需要更大时才换**:小文件(need ≤ 65536)保持原样 → 行为与修复前
// 逐字节一致,不会给普通文件带来任何 diff。
fn cg_resize_temp_tables(state: *u8, max_temp_id: i64) -> i32 {
    let s = state as *CGState;
    // 余量 4096:pre-scan 的 max temp id 来自**文本扫描**(`%tN` 模式)。万一某个
    // temp id 只存在于 token 的 int_val 字段而不在文本里(phi 的 dst 就是这种),
    // 扫描会漏掉它 —— 余量给它留个位置。真漏得更多的话,越界会被
    // temp_table_overflow 标志抓到 → 响亮失败 ✓(不再静默错代码)。
    let need = max_temp_id + (1 as i64) + (4096 as i64);
    if need > (*s).temp_slots_size {
        let bytes = need * (8 as i64);
        let p = arena_alloc((*s).arena, bytes);
        if p == (0 as *u8) {
            jh_fputs_stderr("jhyy error: out of arena memory growing the temp-slot table" as *u8);
            jh_fputs_stderr("
" as *u8);
            return 1 as i32;
        }
        let _z = memset(p, 0 as i32, bytes);
        (*s).temp_slot_for_id = p;
        (*s).temp_slots_size = need;
        // C-side 侧也指着同一张表(读侧走 jh_cgstate_get_temp_slots)—— 必须同步。
        let _wr = cg_state_set_temp_slots(state);
    }
    if need > (*s).temp_holds_size {
        let bytes2 = need as i64;
        let p2 = arena_alloc((*s).arena, bytes2);
        if p2 == (0 as *u8) {
            jh_fputs_stderr("jhyy error: out of arena memory growing the address-holder bitmap" as *u8);
            jh_fputs_stderr("
" as *u8);
            return 1 as i32;
        }
        let _z2 = memset(p2, 0 as i32, bytes2);
        (*s).temp_holds_address = p2;
        (*s).temp_holds_size = need;
        let _wr2 = cg_state_set_holds_address(state);
    }
    return 0 as i32;
}

fn cg_compute_per_fn_max_temps(state: *u8, tok_p: *u8, tok_size: i64, n: i64) -> i32 {
    let s = state as *CGState;
    // ── W-107 (2026-10-20)终局:per-fn 表按**实际函数数**分配 ──
    //
    // 之前五张表固定上限(256 → 1024 → 4096),fn_count 超过上限时**截断**:
    // 被丢弃的函数 → per_fn_max 保持 0 → 单调钳制把 local_max 压成 0
    // → frame_size = 8 → 局部变量冲出帧 → 踩坏调用者的帧。
    // 每次 bump 上限都只是把悬崖往后推 —— 现在**没有上限**了。
    //
    // ⚠️ 这个修法**必须**跟 b7c4e6e 的 `cg_local_t_from_global` 上界真修一起用:
    // 那条真修把越界判据从「写死的表长 1024」改成「**fn_count**」。
    // 两者是同一个 bug 的两半:
    //   · 表按固定长分配 → 超出部分被丢弃(这里修)
    //   · 查表时按固定长判界 → 超出部分**读越界** → base_t 是垃圾
    //     → local_t 变成几万 → 帧偏移 ≈ -518KB(那条已修)
    // 只修一半时,动态分配版本仍然 SEGV —— 这就是 a21c207 被 b7c4e6e 撤回的原因
    // (动态分配先落地,上界真修后落地;两者从未同时存在过)。
    //
    // Phase 1:数函数个数(先数后填,才能按实际个数分配)
    let mut fn_count: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t = (tok_p as i64 + i * tok_size) as *ILToken;
        if (*t).kind == ILTOK_FUNC_HEADER() {
            fn_count = fn_count + (1 as i64);
        }
        i = i + (1 as i64);
    }
    // 分配五张表(cap = fn_count + 1:fn_starts 要多一项放哨兵)
    let arena = (*s).arena;
    let cap = fn_count + (1 as i64);
    let tbl_bytes = cap * (8 as i64);
    let fns_ptr = arena_alloc(arena, tbl_bytes);
    let _z1 = memset(fns_ptr, 0 as i32, tbl_bytes);
    (*s).fn_starts = fns_ptr;
    let pfm_ptr = arena_alloc(arena, tbl_bytes);
    let _z2 = memset(pfm_ptr, 0 as i32, tbl_bytes);
    (*s).per_fn_max = pfm_ptr;
    let pfa_ptr = arena_alloc(arena, tbl_bytes);
    let _z3 = memset(pfa_ptr, 0 as i32, tbl_bytes);
    (*s).per_fn_alloc = pfa_ptr;
    let pfap_ptr = arena_alloc(arena, tbl_bytes);
    let _z4 = memset(pfap_ptr, 0 as i32, tbl_bytes);
    (*s).per_fn_addr_pool = pfap_ptr;
    let pfbt_ptr = arena_alloc(arena, tbl_bytes);
    let _z5 = memset(pfbt_ptr, 0 as i32, tbl_bytes);
    (*s).per_fn_base_t = pfbt_ptr;
    // arena 分配失败 → 响亮失败(绝不能带着空指针往下走:读者只查 `!= 0`,
    // 而 0 会被解释成「没有 per-fn 数据」→ 走 global-max fallback → 帧算成
    // 几百 KB —— 那是**静默产出错代码**,比崩更糟)。
    if fns_ptr == (0 as *u8) || pfm_ptr == (0 as *u8) || pfa_ptr == (0 as *u8)
       || pfap_ptr == (0 as *u8) || pfbt_ptr == (0 as *u8) {
        jh_fputs_stderr("jhyy error: out of arena memory allocating per-fn pre-scan tables" as *u8);
        jh_fputs_stderr("\n" as *u8);
        return 1 as i32;
    }
    // Phase 1b:填 fn_starts(第二遍扫 —— 先数后填)
    let mut fidx: i64 = 0 as i64;
    i = 0 as i64;
    while i < n {
        let t = (tok_p as i64 + i * tok_size) as *ILToken;
        if (*t).kind == ILTOK_FUNC_HEADER() {
            let p = ptr_add_u8((*s).fn_starts, fidx * (8 as i64)) as *i64;
            *p = i;
            fidx = fidx + (1 as i64);
        }
        i = i + (1 as i64);
    }
    // 哨兵: fn_starts[fn_count] = n (end of last fn body)
    let sp = ptr_add_u8((*s).fn_starts, fn_count * (8 as i64)) as *i64;
    *sp = n;
    // W-107 (2026-10-20)终局:**没有上限了** —— 表按 fn_count 分配,
    // 所以不再需要「太多函数」的响亮失败(那是为了替代「静默截断」而加的
    // 临时闸门)。fn_count 只受输入文件里的函数个数限制,而分配量正比于它。
    (*s).fn_count = fn_count;
    // Phase 2: per_fn_max[i] = max temp id in [fn_starts[i], fn_starts[i+1])
    let mut fi: i64 = 0 as i64;
    while fi < fn_count {
        let start_p = ptr_add_u8((*s).fn_starts, fi * (8 as i64)) as *i64;
        let end_p = ptr_add_u8((*s).fn_starts, (fi + (1 as i64)) * (8 as i64)) as *i64;
        let start: i64 = *start_p;
        let end: i64 = *end_p;
        let mut max_t: i64 = 0 as i64;
        let mut j: i64 = start;
        while j < end {
            let t_max = cg_token_max_temp_id(tok_p, tok_size, j);
            if t_max > max_t { max_t = t_max; }
            j = j + (1 as i64);
        }
        // v4.0.8 (W-097 根因 8):per_fn_max 必须单调不降。QBE 的 temp id 跨 fn
        // 只增不减,所以第 fi 个 fn 的 max temp 必然 >= 第 fi-1 个;但
        // cg_token_max_temp_id 对解析不出 %tN 的 token 返 0,一旦某个 fn 的
        // token 区间没扫到 temp,per_fn_max[fi] 就可能比 per_fn_max[fi-1] 还小。
        // 后果链(机械审计 3094 个函数,484 个中招):
        //   local_max = pfm_val - prev_pfm < 0
        //   → frame_size = 0
        //   → addr_holder_init_off = -(0 + 64) = -64
        //   → address-holder 池从 -64 一路往下长,穿过程式池和 value 池
        //   → `(*fd).name = fname` 的 dst 槽被后面的 alloc8 覆盖
        //   → jhyy_v2.exe 在 `mov %rax,(%r8)` 处 r8=5 直接 SEGV
        //   (gdb 现场:parser__parse_expr,call ast_new_struct_lit 之后的 store)
        // 单调钳制让 local_max >= 0 恒成立,frame_size 与公式槽同源对齐。
        if fi > (0 as i64) {
            let mono_idx: i64 = fi - (1 as i64);
            let mono_p = ptr_add_u8((*s).per_fn_max, mono_idx * (8 as i64)) as *i64;
            let prev_m: i64 = *mono_p;
            if max_t < prev_m { max_t = prev_m; }
        }
        let p2 = ptr_add_u8((*s).per_fn_max, fi * (8 as i64)) as *i64;
        *p2 = max_t;
        // v4.0.2.2 (W-096 emit-side per-fn-local counter 真修):per_fn_base_t[fi]
        // = 本 fn body 起始的 global t。fi=0 用 0 (QBE 第一个 fn 从 t0 起);
        // fi>0 用上一 fn 的 max + 1 (QBE IL 跨 fn 累加 t counter,本 fn 的最小
        // global t = 上一 fn max + 1)。cg_offset_for_temp 用这个算 local_t
        // = global_t - per_fn_base_t[cur_fn_idx] → frame_size 用 local_max
        // (不再是 global max 484KB) 跟 slot offset 物理一致。
        let mut base_t: i64 = 0 as i64;
        if fi > (0 as i64) {
            // v4.0.2.5 (W-097 emit-side per_fn_max lookup operand swap 真修):hoist
            // `(fi - 1) * 8` into 2 atomic steps to avoid jhyy-side codegen
            // reassociation / const-fold dropping the `sub $0x1`. See also
            // codegen_amd64_emit_ctrl.jhyy:529 for the primary trigger.
            let prev_idx: i64 = fi - (1 as i64);
            let prev_p = ptr_add_u8((*s).per_fn_max, prev_idx * (8 as i64)) as *i64;
            base_t = *prev_p + (1 as i64);
        }
        let pfbt_p = ptr_add_u8((*s).per_fn_base_t, fi * (8 as i64)) as *i64;
        *pfbt_p = base_t;
        // v3.1.0 W-087 (alloc pool frame offset 真修):per-fn alloc8 sum
        // 累加 alloc pool size (cg_alloc_slot per-alloc advance)。emit_func_header
        // 用这个 + 8192 base 决定 frame_size 覆盖 alloc pool。
        let mut total_a: i64 = 0 as i64;
        j = start;
        while j < end {
            let a_sz = cg_token_alloc_size(tok_p, tok_size, j);
            if a_sz > (0 as i64) {
                let aligned = (a_sz + (7 as i64)) & ((0 as i64) - (8 as i64));
                // v3.1.0 W-087.1 (frame offset 越界真修 — alloc pool pointer slot):
                // 每个 alloc 后 reserves 一个 8B 指针槽 (cg_record_temp_slot writes the
                // runtime derived pointer value into slot at -8200+%pool),不是仅 alloc 大小。
                total_a = total_a + aligned + (8 as i64);
            }
            j = j + (1 as i64);
        }
        // v3.4.1 W-088 真修:address-holder-aware 2-pass pre-scan 替换 heuristic
        // `derived_count = total_a / 2` (floor 8)。
        //
        // 触发面 (per workarounds.md W-088 L5512+):per-fn allocN 函数 + 函数间传 pointer
        // (e.g. `arena_alloc -> ptr_add -> store`) → alloc slot offset 越界或 invalid assembly。
        // Heuristic 假设 平均每 2 alloc slot 1 derived-address temp → alloc-heavy 过度 reserve,
        // alloc-light + many-derived 函数 under-reserve → runtime crash。
        //
        // 真修 (per docs/archive/plans/v3/v3.4.0-plan.md L42-51 spec):
        //   Sub-pass 1: scan tokens;对每 ILTOK_BINOP with qbe_type=='l' (108) — pointer
        //     add binop — derived_count++。**upper bound**:每个 `add l-type` binop 在
        //     emit_binop path (codegen_amd64_emit_call.jhyy L1948) 都检查 src1
        //     is_address_holder,如果 true → reserve derived-slot。无法 pre-scan 阶段
        //     准确判断 src1 is_address_holder (因为 holds_address bitmap 是 emit 期
        //     增量 build 的)→ 用 upper bound:count 所有 `=l add` binops,假设每个都
        //     触发 derived-slot reservation。
        //
        //   比 heuristic **safe** (≥ heuristic count when alloc-heavy;≥ actual count
        //   when alloc-light + many-derived);比 heuristic 浪费 ≥ alloc-heavy 路径
        //   (~0-200B per fn difference),但消除 alloc-light + many-derived 的 crash。
        //
        // 注:v3.x mid 可用完整 dataflow analysis (sub-pass 1 + transitive closure +
        //   text-parsed src1) 替换此 upper bound,见 W-096 deferred v3.x mid 候选。
        //
        // V3'' iter 2 (2026-09-29):经验发现纯 `count_l_add` 在 zero-alloc 函数
        // (e.g. ffi_file main 0 个 `=l alloc` + 0 个 `=l add` binop — 但 fopen 返回的
        // 指针 temp 仍是 address-holder,后续 ptr_add 需要 derived-slot) = 0,
        // SEGV。同理 std_io_basic total_a=80,heuristic=40 但 count_l_add=34 < 40
        // → heuristic 补 buffer。**fix:max(heuristic, count_l_add)**,既保 heuristic
        // floor 8 + alloc-derived buffer,也保 alloc-light many-binop 充足 reserve。
        let mut heuristic: i64 = total_a / (2 as i64);
        if heuristic < (8 as i64) {
            heuristic = 8 as i64;
        }
        let mut count_l_add: i64 = 0 as i64;
        j = start;
        while j < end {
            let t2 = (tok_p as i64 + j * tok_size) as *ILToken;
            if (*t2).kind == ILTOK_BINOP() && (*t2).qbe_type == (108 as i32) {
                count_l_add = count_l_add + (1 as i64);
            }
            j = j + (1 as i64);
        }
        let mut derived_count: i64 = heuristic;
        if count_l_add > derived_count {
            derived_count = count_l_add;
        }
        let p3 = ptr_add_u8((*s).per_fn_alloc, fi * (8 as i64)) as *i64;
        *p3 = total_a + derived_count * (8 as i64);
        // v4.0.7 (W-097 sub-bug 2): address-holder pool depth upper bound.
        // cg_alloc_slot(is_addr=1) is called from exactly three sites, keyed by
        // token kind: emit_alloc (ILTOK_ALLOC, emit_mem.jhyy:348),
        // emit_load dst (ILTOK_LOAD, emit_mem.jhyy:682), emit_binop derived
        // (ILTOK_BINOP, emit_call.jhyy:1838). Count those three kinds.
        let mut addr_tok: i64 = 0 as i64;
        j = start;
        while j < end {
            let t3 = (tok_p as i64 + j * tok_size) as *ILToken;
            if (*t3).kind == ILTOK_ALLOC() || (*t3).kind == ILTOK_LOAD() || (*t3).kind == ILTOK_BINOP() {
                addr_tok = addr_tok + (1 as i64);
            }
            j = j + (1 as i64);
        }
        let p4 = ptr_add_u8((*s).per_fn_addr_pool, fi * (8 as i64)) as *i64;
        *p4 = addr_tok * (8 as i64) + (64 as i64);
        fi = fi + (1 as i64);
    }
    // ── W-120 (2026-10-20):按实际最大 temp id 重新分配两张 temp 表 ──
    //
    // per_fn_max[fn_count-1] 就是**全局**最大 temp id(Phase 2 的单调钳制保证
    // 它 ≥ 任何前面的值)。temp id 是 IL emitter 全局编号的,所以它是「这个
    // 文件用过的最大 id」—— 正是两张表需要的容量。
    let mut global_max_t: i64 = 0 as i64;
    if fn_count > (0 as i64) {
        let last_p = ptr_add_u8((*s).per_fn_max, (fn_count - (1 as i64)) * (8 as i64)) as *i64;
        global_max_t = *last_p;
    }
    let _rsz = cg_resize_temp_tables(state, global_max_t);
    if _rsz != (0 as i32) {
        return _rsz;
    }
    return 0 as i32;
}


// ═════════════════════════════════════════════════════════════════════════
// v2.11.3 (W-074.7 T4-c + T4-h 真修) FN_ARG scan context + arg index finder
// ═════════════════════════════════════════════════════════════════════════
//
// QBE IL fn header 形如:
//   "function $fib(w %n)"                  → 1 arg, %n 在 args 列表 idx=0 → %rcx
//   "function $sum_point(l %point)"        → 1 arg, %point idx=0
//   "function $read_deep(l %outer, l %k)"  → 2 args
// emit_func_header 在 prologue 调 cg_state_set_fn_header 把这串 + 长度存
// CGState,emit_copy FN_ARG 路径用 cg_find_arg_idx 找 %name 位置映射寄存器。
//
// 注:QBE IL args 列表每个 arg 形如 "{w|l|s|d} %name" — 字母是 qt,空格分隔。
// 我们 scan 整个 text 找第 N 个 '%name' 出现位置;忽略 dest(=,前)中的 '%tN'。
//
// Simplification (v2.11.3): 我们不严格区分 args 段 vs body 段;只数 '%' 出
// 现次数,把第 1..arg_count 个 '%' 当作 args(QBE IL 保证 args 全在 body 前
// 的 '(args {...})' 段,lex_finish_instr 已把整条函数头 slice 化,args 段
// 是唯一含 '%name' 的前缀)。body 段的 '%tN' 是 dest temp (int_val 字段),
// 不在 args list 中 — emit_copy 时通过 cg_parse_temp 第二个返回值得
// (idx=1 src temp) 区分,不会跟 args 重叠。

// cg_state_set_fn_header — v2.11.3 setter
//
// 由 emit_func_header 末尾调,把当前 function header 原文 slice + 长度 +
// arg_count 存 CGState。arg_count 从 text 中数 ',' 推断 (QBE IL args 段
// 逗号分隔,即使没有嵌套括号;每个 arg 一段 {qt} %name)。
fn cg_state_set_fn_header(state: *u8, header_text: *u8, header_len: i64) -> i32 {
    let s = state as *CGState;
    (*s).cur_fn_header_text = header_text;
    (*s).cur_fn_header_len  = header_len;
    // count args:数 '%' 出现次数(每个 arg 一个 '%name')
    let mut cnt: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i + (1 as i64) < header_len {
        if cg_byte_at(header_text, i) == (37 as i32) {  // '%'
            cnt = cnt + (1 as i64);
        }
        i = i + (1 as i64);
    }
    (*s).cur_fn_arg_count = cnt;
    return 0;
}

// cg_find_arg_idx(header_text, header_len, name_bytes, name_len) -> i64
//
// 在 fn header 中数到第 1 个匹配 '%<name_bytes>' 的出现位置 (0-based)。
// 返 0..arg_count-1 表示 arg idx;返 -1 表示未找到 (用 caller fallback %rcx)。
//
// 注:QBE IL '%name' 用 % 后跟 ASCII identifier 字符 (字母数字下划线)。
// 我们不强制是字母 — 直接 N 字节比较 name,匹配即接受 (防御 %name 中含
// 数字也 ok)。
fn cg_find_arg_idx(header_text: *u8, header_len: i64,
                   name_bytes: *u8, name_len: i64) -> i64 {
    if header_text == (0 as *u8) || name_bytes == (0 as *u8) {
        return -(1 as i64);
    }
    if header_len <= (0 as i64) || name_len <= (0 as i64) {
        return -(1 as i64);
    }
    let mut seen: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i + (1 as i64) < header_len {
        if cg_byte_at(header_text, i) == (37 as i32) {  // '%'
            // match name_bytes after '%'
            let mut j: i64 = 0 as i64;
            let mut match_ok: i32 = 1 as i32;
            while j < name_len {
                if i + (1 as i64) + j >= header_len {
                    match_ok = 0 as i32;
                    break;
                }
                if cg_byte_at(header_text, i + (1 as i64) + j) != cg_byte_at(name_bytes, j) {
                    match_ok = 0 as i32;
                    break;
                }
                j = j + (1 as i64);
            }
            if match_ok == (1 as i32) {
                // v4.0.7 (W-097 第七缺陷):匹配必须是**整个**参数名,不能是前缀。
                // 不加边界检查时,找名字 "s" 会先命中 "%sb"(同为 s 开头),找 "t"
                // 会先命中 "%ta" —— 参数被映射到别人的寄存器。
                // 实证:sb_append_cstr(a, sb, s) 的第 3 参 %s 命中了 %sb,
                // prologue emit `movq %rdx, -48(%rbp)`(应为 %r8)。
                let after = i + (1 as i64) + name_len;
                if after >= header_len {
                    return seen;
                }
                let nb = cg_byte_at(header_text, after);
                if nb == (44 as i32) || nb == (41 as i32) || nb == (32 as i32) ||
                   nb == (9 as i32) || nb == (10 as i32) || nb == (123 as i32) {
                    return seen;
                }
            }
            seen = seen + (1 as i64);
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_parse_mem_slot — W-104:识别 MEMORY class 参数名里的 "__m<k>" 标记,
// 返回 k(该 slot 的**全局** MEMORY slot 序号);不是 MEMORY 参数则返回 -1。
//
// IL 层给 MEMORY-class 参数的每个 8 字节 slot 起名 `<原名>__m<k>`,k 是**跨所有
// MEMORY 参数累计**的 slot 序号 —— 因为 SysV 栈上只有内存参数,它们的偏移就是
// 16(%rbp) + k*8(第一个栈参数在 16(%rbp):push rbp 后 retaddr 在 8(%rbp))。
//
// ⚠️ 这个「只有内存参数在栈上」的假设 = **整数参数不能溢出**(>6 个)。
//    整数溢出参数也在栈上,会与 MEMORY 参数交错,那时 k*8 就不对了。
//    IL 层负责检测这种情况并报「暂不支持」(不静默产出错误代码)。
fn cg_parse_mem_slot(src_text: *u8, name_start: i64) -> i64 {
    if src_text == (0 as *u8) || name_start < (0 as i64) {
        return -(1 as i64);
    }
    // 自己扫到标识符结束 —— 三个 FNARG 路径里名字变量的**名字都不一样**
    // (name_start / t_name_start / name_start),len 也只有一处可见。
    // 依赖调用方传 len 会踩「out-of-scope 变量被当成 %t0 首参」那个老坑。
    let mut name_len: i64 = 0 as i64;
    while name_len < (256 as i64) {
        let nc = cg_byte_at(src_text, name_start + name_len);
        // ⚠️ 不能写成 `let is_alnum = (A && B) || (C && D) || ...` ——
        // let 绑定多段布尔表达式生成的 IL 形态 self-backend 的 lexer 不认
        // ("unknown QBE IL mnemonic")。逐步赋值。
        let mut is_alnum: i32 = 0 as i32;
        if nc >= (48 as i32) && nc <= (57 as i32) { is_alnum = 1 as i32; }
        if nc >= (65 as i32) && nc <= (90 as i32) { is_alnum = 1 as i32; }
        if nc >= (97 as i32) && nc <= (122 as i32) { is_alnum = 1 as i32; }
        if nc == (95 as i32) { is_alnum = 1 as i32; }
        if is_alnum == (0 as i32) { break; }
        name_len = name_len + (1 as i64);
    }
    if name_len <= (0 as i64) {
        return -(1 as i64);
    }
    let name_bytes = ptr_add_u8(src_text, name_start);
    // 找 "__m" 子串
    //
    // ⚠️ 标记是 **`__m<k>`**(两个下划线 + m + 数字),不是 `_m_`。
    //    参数名形如 `<原名>__m0` → 里面的子串是 "__m0"。
    //    (之前写成 `_`/`m`/`_` 三字节比较 → 永远匹配不上 → MEMORY 参数
    //     被当成普通 INTEGER 参数从 %rdi 读 → 读到垃圾。)
    let mut i: i64 = 0 as i64;
    while i + (3 as i64) < name_len {
        if cg_byte_at(name_bytes, i) == (95 as i32)                 // '_'
           && cg_byte_at(name_bytes, i + (1 as i64)) == (95 as i32) // '_'
           && cg_byte_at(name_bytes, i + (2 as i64)) == (109 as i32) { // 'm'
            // "__m" 之后应是数字
            let mut j: i64 = i + (3 as i64);
            if j >= name_len { return -(1 as i64); }
            let d0 = cg_byte_at(name_bytes, j);
            if d0 < (48 as i32) || d0 > (57 as i32) { return -(1 as i64); }
            let mut k: i64 = 0 as i64;
            while j < name_len {
                let dc = cg_byte_at(name_bytes, j);
                if dc < (48 as i32) || dc > (57 as i32) { break; }
                k = k * (10 as i64) + (dc - 48 as i32) as i64;
                j = j + (1 as i64);
            }
            // "__m<k>" 必须在名字**末尾** —— 否则像 "foo__m0bar" 这种
            // 普通参数名会被误判成 MEMORY slot。
            if j != name_len { return -(1 as i64); }
            return k;
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_find_class_arg_idx — W-104 (2026-10-19):同类序列里的参数序号
//
// SysV psABI § A.2:整数类参数走**整数寄存器序列**(rdi/rsi/rdx/rcx/r8/r9),
// 浮点类参数走**独立的 SSE 序列**(xmm0..xmm7)—— 两个序列各自从 0 开始数。
//
// cg_find_arg_idx 给的是**参数在 header 里的整体序号**,对 SysV 是错的:
//   fn take(d %a, w %b)   ← SSE 在前、INTEGER 在后
//     %a 应进 xmm0(SSE 序列第 0)
//     %b 应进 rdi(INTEGER 序列第 0)
// 用整体序号算,%b 会拿到 rdx —— 整体序号 1。
//
// is_sse=1 → 数前面有多少个 d/s 参数(SSE 序列)
// is_sse=0 → 数前面有多少个非 d/s 参数(INTEGER 序列)
//
// ⚠️ 这只适用于 **SysV**。Win x64 的 XMM 按**参数位置**计数(第 n 个参数是
// float 就走 XMM(n-1)),与 SysV 规则不同 —— 调用方必须用 target_is_win 区分。
fn cg_find_class_arg_idx(header_text: *u8, header_len: i64,
                         name_bytes: *u8, name_len: i64,
                         is_sse: i32) -> i64 {
    if header_text == (0 as *u8) || name_bytes == (0 as *u8) {
        return -(1 as i64);
    }
    if header_len <= (0 as i64) || name_len <= (0 as i64) {
        return -(1 as i64);
    }
    let mut n_class: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i + (1 as i64) < header_len {
        if cg_byte_at(header_text, i) == (37 as i32) {  // '%'
            // 这个参数的字母 = '%' 前面的非空白字符
            let mut b: i64 = i - (1 as i64);
            while b >= (0 as i64) {
                let bc = cg_byte_at(header_text, b);
                if bc != (32 as i32) && bc != (9 as i32) { break; }
                b = b - (1 as i64);
            }
            let mut this_sse: i32 = 0 as i32;
            if b >= (0 as i64) {
                let lc = cg_byte_at(header_text, b);
                if lc == (100 as i32) || lc == (115 as i32) {   // 'd' / 's'
                    this_sse = 1 as i32;
                }
            }
            // match the target name
            let mut j: i64 = 0 as i64;
            let mut match_ok: i32 = 1 as i32;
            while j < name_len {
                if i + (1 as i64) + j >= header_len {
                    match_ok = 0 as i32;
                    break;
                }
                if cg_byte_at(header_text, i + (1 as i64) + j) != cg_byte_at(name_bytes, j) {
                    match_ok = 0 as i32;
                    break;
                }
                j = j + (1 as i64);
            }
            if match_ok == (1 as i32) {
                let after = i + (1 as i64) + name_len;
                if after >= header_len {
                    return n_class;
                }
                let nb = cg_byte_at(header_text, after);
                if nb == (44 as i32) || nb == (41 as i32) || nb == (32 as i32) ||
                   nb == (9 as i32) || nb == (10 as i32) || nb == (123 as i32) {
                    return n_class;
                }
            }
            // 不是目标参数 → 按它的 class 计数
            //
            // ⚠️ W-104 MEMORY class:带 `__m<k>` 标记的参数**不占寄存器**
            // (SysV: MEMORY class 参数落栈,不消耗 INTEGER/SSE 序列)。
            //    不跳过它就会把后面真正的 INTEGER 参数序号整体推偏一位 ——
            //    `f(Big b, i32 x)` 的 %x 会被算成第 5 个 INTEGER 参数(进 %r8),
            //    而 gcc 把它放 %rdi。
            let mut skip_count: i32 = 0 as i32;
            if cg_parse_mem_slot(header_text, i + (1 as i64)) >= (0 as i64) {
                skip_count = 1 as i32;
            }
            if skip_count == (0 as i32) {
                if (this_sse != (0 as i32) && is_sse != (0 as i32)) ||
                   (this_sse == (0 as i32) && is_sse == (0 as i32)) {
                    n_class = n_class + (1 as i64);
                }
            }
        }
        i = i + (1 as i64);
    }
    return -(1 as i64);
}

// cg_state_bump_fn_idx — v2.11.3 (W-074.7 T4-h 真修)
//
// emit_func_header 末尾调,bump cur_fn_idx per-function 序号。emit_jnz /
// emit_label 读此值 append "_fn<N>" 后缀到 .L<name>。
fn cg_state_bump_fn_idx(state: *u8) -> i64 {
    let s = state as *CGState;
    let cur = (*s).cur_fn_idx;
    // v4.0.4 Step 1 (W-101 RCA): log pre/post bump to detect any per-fn zero race.
    (*s).cur_fn_idx = cur + (1 as i64);
    return cur;
}

// cg_state_cur_fn_idx — getter for emit_jnz / emit_label
fn cg_state_cur_fn_idx(state: *u8) -> i64 {
    let s = state as *CGState;
    return (*s).cur_fn_idx;
}
