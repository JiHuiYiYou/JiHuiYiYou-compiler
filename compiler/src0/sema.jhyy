// sema.jhyy — JHYY 翻译自 compiler/src/sema.c
// v1.0.0 sprint 3 commit 5, 2026-06-26
//
// 翻译要点：
//   - jhyy 不支持前向引用 + 单一 self-recursion：函数顺序
//     sema_error → push/pop_scope → resolve_type_node →
//     process_match_pattern (self-rec) → is_const_expr → infer_type (self-rec)
//     → check_func_decl → check_module → sema_init / sema_check
//   - SemaContext 内嵌 256 SemaLocal 太大（4096 字节）→ 外置 locals 数组
//     arena_alloc(SEMA_MAX_LOCALS * SEMA_LOCAL_SIZE())，SemaContext.locals
//     字段为 *u8（用 offset 访问）
//   - FieldDesc / VariantDesc 是 sema.c 内部布局，jhyy 版定义在 sema.jhyy
//     私有区（sema construct + 读取都在这里）
//   - sema_error 不走 vfprintf（jhyy 无变参）→ 走 sb_appendf 单 i32 拼接；
//     整型用 sb_appendf("%d", n)，字符串用 sb_append_cstr，最后 sb_cstr +
//     jh_fputs_stderr
//   - v0.7 7A exhaustive match + 7B const decl：本 commit 暂不支持 NODE_CONST_DECL
//     （parser 还没翻译 const token + sema 复杂；plan 决定推到下一 commit）。
//     完整支持 7A：match 检查 enum 所有 variant 都覆盖或 _ 兜底
//   - SemaContext.locals 用 SemaLocal layout (sym_ptr + type_ptr = 16 bytes)；
//     通过 offset 访问 locals[i].sym / locals[i].type
//
// 已知差异（vs C 版）：
//   - C `vfprintf` 变参 → jhyy `sb_appendf` + sb_append_cstr 拼接
//   - C `int64_t` `%zu` → jhyy i64 单 sprintf "%d" 多次
//   - C `SemaLocal locals[256]` → jhyy `*u8` arena_alloc + offset

import arena;
import util;
import symtab;
import types;
import ast;
import lexer;
import parser;
// v3.2.0 (V3-C 3i generics): Pass 1.5 monomorphize. mono_expand_module 在
//   Pass 1 (decl 注册) 之后 / Pass 2 (layout resolve) 之前调用。
//   import 顺序:parser 之后 — mono 不依赖 parser。
import mono;

// ════════════════════════════════════════════════════
// 常量
// ════════════════════════════════════════════════════

fn SEMA_MAX_LOCALS() -> i64 { return 256 as i64; }

// SemaLocal layout: sym(*u8 8) + type(*u8 8) = 16
fn SEMA_LOCAL_SIZE() -> i64 { return 16 as i64; }

// FieldDesc layout: name(*u8 8) + type(*u8 8) + offset(i64 8) = 24
fn FIELD_DESC_SIZE() -> i64 { return 24 as i64; }

// VariantDesc layout: name(*u8 8) + payload(*u8 8) + tag(i32 4 + pad 4) = 24
//   跟 v0 C 端 types.h:37-41 VariantDesc 字段对齐: name/payload/tag。
//   AUDIT (v0.9 wip commit 2.16): 之前写 16 是错的, sema 写 24B per variant
//   (name@0, payload@8, tag@16) → last variant 4B 溢出 heap。已修。
fn VARIANT_DESC_SIZE() -> i64 { return 24 as i64; }

// var_name_eq_v1: 比较两个 Sym* 的 name 字符串相等 (strcmp 风格: 0=相等, 非 0=不等)。
//   parser 阶段 alloc 的 SYM_VARIANT 跟 sema 阶段 enum 注册的全局 variant
//   Sym 指针可能不同 (但 name 相同)。v0 端 sema.c 用 strcmp(name) 是对的,
//   jhyy 端之前用指针 == 永远不命中 → "enum has no variant" 误报。
//   match_exhaustive.jhyy byte-equal 5/7 → 6/7 的根因修复 (commit 2.12a)。
fn var_name_eq_v1(a: *Sym, b: *Sym) -> i32 {
    if a == (0 as *Sym) {
        return 1 as i32;  // a NULL: 非 0 = 不等
    }
    if b == (0 as *Sym) {
        return 1 as i32;  // b NULL: 非 0 = 不等
    }
    return strcmp((*a).name, (*b).name);
}

// ════════════════════════════════════════════════════
// Sub-structs: FieldDesc / VariantDesc
// ════════════════════════════════════════════════════

type FieldDesc = struct {
    name:   *u8,    // *Sym
    type_:  *u8,    // *Type（jhyy `type` 是 reserved → type_）
    offset: i64,
}

type VariantDesc = struct {
    name:    *u8,   // *Sym
    payload: *u8,   // *Type
    tag:     i32,
}

// ════════════════════════════════════════════════════
// SemaContext
// ════════════════════════════════════════════════════

// v1.3.6: SemaContext 自身字节数: arena(8) + module(8) + global_scope(8) + current_scope(8)
//                       + locals(8) + nlocals(8) + scope_depth(8) + error_count(8)
//                       + current_ret_type(8) + loop_depth(8) + current_fn(8) = 88
type SemaContext = struct {
    arena:             *Arena,
    module:            *Node,
    global_scope:      *u8,        // *SymTable
    current_scope:     *u8,        // *SymTable
    locals:            *u8,        // SemaLocal[]（offset 访问）
    nlocals:           i64,
    scope_depth:       i32,
    error_count:       i32,
    current_ret_type:  *u8,        // *Type
    loop_depth:        i32,
    current_fn:        *u8,        // *NodeFuncDecl (v1.3.6: for defer collection)
}

fn SEMA_CONTEXT_SIZE() -> i64 { return 88 as i64; }

// ════════════════════════════════════════════════════
// SemaLocal 访问 helper（locals[i].sym / locals[i].type）
// ════════════════════════════════════════════════════

fn sema_local_at(locals: *u8, idx: i64) -> *u8 {
    return ptr_add_u8(locals, idx * SEMA_LOCAL_SIZE()) as *u8;
}

fn sema_local_sym(locals: *u8, idx: i64) -> *Sym {
    let p = sema_local_at(locals, idx);
    // [Status: 真修 W-005 family in C-side (commit 2.45); src0/ workaround kept for历史读者了解历史.]
    // v0 codegen bug workaround: 不要 `*(p as *Sym)` 直接 deref cast 取回 ptr
    //   — jhyy_v1 codegen 对 NODE_DEREF(NODE_CAST) 在 inner_node.type_ptr 被
    //     sema 设置但 elem 类型不可解的情况下漏 emit loadl, 改 extsw truncate
    //     返回 truncated pointer。改走 ptr_add_u8 + 字段级读取。
    let sp = p as **Sym;
    return *sp;
}

fn sema_local_type(locals: *u8, idx: i64) -> *Type {
    let p = sema_local_at(locals, idx);
    let type_ptr = *((p as i64 + (8 as i64)) as **Type);
    return type_ptr;
}

fn sema_local_set(locals: *u8, idx: i64, sym: *Sym, t: *Type) -> i32 {
    let p = sema_local_at(locals, idx);
    let sp = p as **Sym;
    *sp = sym;
    let tp = (p as i64 + (8 as i64)) as **Type;
    *tp = t;
    return 1;
}

// ════════════════════════════════════════════════════
// sema_error（变参 vfprintf → sb_appendf 拼接）
// ════════════════════════════════════════════════════

// 简易版：只接受 filename + line + col + format_string + i32_val
// 复杂错误用 sb_append_cstr 多次拼
fn sema_error_int(ctx: *SemaContext, loc_filename: *u8, line: i32, col: i32,
                  msg: *u8, val: i32) -> i32 {
    let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
    sb_init((*ctx).arena, &sb);
    sb_append_cstr((*ctx).arena, &sb, loc_filename);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, line);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, col);
    sb_append_cstr((*ctx).arena, &sb, ": error: " as *u8);
    sb_append_cstr((*ctx).arena, &sb, msg);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, val);
    sb_append_cstr((*ctx).arena, &sb, "\n" as *u8);
    let s = sb_cstr((*ctx).arena, &sb);
    jh_fputs_stderr(s);
    (*ctx).error_count = (*ctx).error_count + (1 as i32);
    sb_free(&sb);
    return 0;
}

// 双 i32 错误
fn sema_error_int2(ctx: *SemaContext, loc_filename: *u8, line: i32, col: i32,
                   msg1: *u8, val1: i32, msg2: *u8, val2: i32) -> i32 {
    let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
    sb_init((*ctx).arena, &sb);
    sb_append_cstr((*ctx).arena, &sb, loc_filename);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, line);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, col);
    sb_append_cstr((*ctx).arena, &sb, ": error: " as *u8);
    sb_append_cstr((*ctx).arena, &sb, msg1);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, val1);
    sb_append_cstr((*ctx).arena, &sb, msg2);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, val2);
    sb_append_cstr((*ctx).arena, &sb, "\n" as *u8);
    let s = sb_cstr((*ctx).arena, &sb);
    jh_fputs_stderr(s);
    (*ctx).error_count = (*ctx).error_count + (1 as i32);
    sb_free(&sb);
    return 0;
}

// 纯字符串错误（无 val）
fn sema_error_str(ctx: *SemaContext, loc_filename: *u8, line: i32, col: i32,
                  msg: *u8) -> i32 {
    let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
    sb_init((*ctx).arena, &sb);
    sb_append_cstr((*ctx).arena, &sb, loc_filename);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, line);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, col);
    sb_append_cstr((*ctx).arena, &sb, ": error: " as *u8);
    sb_append_cstr((*ctx).arena, &sb, msg);
    sb_append_cstr((*ctx).arena, &sb, "\n" as *u8);
    let s = sb_cstr((*ctx).arena, &sb);
    jh_fputs_stderr(s);
    (*ctx).error_count = (*ctx).error_count + (1 as i32);
    sb_free(&sb);
    return 0;
}

// 字符串 + i32 拼接（最常见的 "type mismatch" 等）
fn sema_error_str_int(ctx: *SemaContext, loc_filename: *u8, line: i32, col: i32,
                      msg1: *u8, val: i32) -> i32 {
    let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
    sb_init((*ctx).arena, &sb);
    sb_append_cstr((*ctx).arena, &sb, loc_filename);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, line);
    sb_append_cstr((*ctx).arena, &sb, ":" as *u8);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, col);
    sb_append_cstr((*ctx).arena, &sb, ": error: " as *u8);
    sb_append_cstr((*ctx).arena, &sb, msg1);
    sb_appendf((*ctx).arena, &sb, "%d" as *u8, val);
    sb_append_cstr((*ctx).arena, &sb, "\n" as *u8);
    let s = sb_cstr((*ctx).arena, &sb);
    jh_fputs_stderr(s);
    (*ctx).error_count = (*ctx).error_count + (1 as i32);
    sb_free(&sb);
    return 0;
}

// ════════════════════════════════════════════════════
// push/pop_scope
// ════════════════════════════════════════════════════

fn sema_push_scope(ctx: *SemaContext) -> i32 {
    let new_scope = symtab_new((*ctx).arena, (*ctx).current_scope);
    (*ctx).current_scope = new_scope;
    (*ctx).scope_depth = (*ctx).scope_depth + (1 as i32);
    return 1;
}

fn sema_pop_scope(ctx: *SemaContext) -> i32 {
    let cur = (*ctx).current_scope as *SymTable;
    (*ctx).current_scope = (*cur).parent;
    (*ctx).scope_depth = (*ctx).scope_depth - (1 as i32);
    return 1;
}

// ════════════════════════════════════════════════════
// 内部 forward 声明（jhyy 不支持 forward → 顺序定义）
// infer_type / process_match_pattern 在 resolve_type_node 之后定义
// ════════════════════════════════════════════════════

// TypeArena（sema 持有，懒初始化）
// SemaContext 增加 type_arena 字段——不对，把 TypeArena 当独立全局；
// 实际上 SemaInit 时分配一个。

// ════════════════════════════════════════════════════
// resolve_type_node
// ════════════════════════════════════════════════════

// ta: TypeArena 引用
// tn: type annotation AST node
fn resolve_type_node(ctx: *SemaContext, ta: *TypeArena, tn: *Node) -> *Type {
    if tn == (0 as *Node) { return 0 as *Type; }

    if (*tn).kind == NODE_IDENT() {
        let idd = node_ident_data(tn);
        let sym = (*idd).sym as *Sym;
        let name = (*sym).name;

        // 优先在当前 scope 查 SYM_TYPE（sym 已经设了 type 的话直接返回）
        let looked = symtab_lookup((*ctx).current_scope, name);
        if looked != (0 as *Sym) {
            if (*looked).kind == SYM_TYPE() {
                if (*looked).type_ptr != (0 as *u8) {
                    return (*looked).type_ptr as *Type;
                }
            }
        }

        // v3.1.2 (V3-C 3g.7): fall through — 接受 SYM_VAR / SYM_FN 的 type_ptr
        // 让 sizeof(c) where c: Cap<T> 在 fn body 内能 resolve (c 是 SYM_VAR w/ type=Cap<T>)。
        if looked != (0 as *Sym) {
            if (*looked).type_ptr != (0 as *u8) {
                return (*looked).type_ptr as *Type;
            }
        }

        // v3.2.0 (V3-C 3i generics): bare type-param `T` 在 non-generic scope
        //   报 E0060(`looked` 是 SYM_TYPE + type_ptr==0 = type-param sentinel)。
        //   Pass 1.5 替换后,所有使用位 (field type / let type_annot / 等)
        //   已经被 subst 成 arg type,不再走这一路径。Pass 2 走到这里只能是:
        //   (a) bare T 出现在 generic def body 之外(mono_expand_module 之后
        //       generic def 跳过,所以 Pass 2 不会重新访问 body,但函数返回
        //       类型 / 函数参数 type 仍可能在 generic fn 中 — v3.2.0 不做,
        //       v3.2.0b 接 generic fn 时会改成 mono_substitute 这些位置);
        //   (b) 用户手写 unsubstituted type-param 当 type 用(明显 bug)。
        //   E0060 在两种场景都正确。
        if looked != (0 as *Sym) {
            if (*looked).kind == SYM_TYPE() {
                if (*looked).type_ptr == (0 as *u8) {
                    let _x = sema_error_str(ctx, (*tn).loc_filename,
                                            (*tn).loc_line, (*tn).loc_col,
                                            "E0060: unresolved type parameter; generic must be instantiated" as *u8);
                    return type_primitive(ta, PRIM_I32());  // error recovery
                }
            }
        }

        // primitive types（走 TypeArena）
        if strcmp(name, "i8" as *u8)   == (0 as i32) { return type_primitive(ta, PRIM_I8()); }
        if strcmp(name, "i16" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_I16()); }
        if strcmp(name, "i32" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_I32()); }
        if strcmp(name, "i64" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_I64()); }
        if strcmp(name, "u8" as *u8)   == (0 as i32) { return type_primitive(ta, PRIM_U8()); }
        if strcmp(name, "u16" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_U16()); }
        if strcmp(name, "u32" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_U32()); }
        if strcmp(name, "u64" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_U64()); }
        if strcmp(name, "f32" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_F32()); }
        if strcmp(name, "f64" as *u8)  == (0 as i32) { return type_primitive(ta, PRIM_F64()); }
        if strcmp(name, "bool" as *u8) == (0 as i32) { return type_primitive(ta, PRIM_BOOL()); }
        // v3.1.0 (V3-C 3g): Cap builtin — 8-byte capability (cnode/depth/rights/pad).
        // 简化:default inner=i32, 完整 Cap<T> generic 留 v3.1.2。
        if strcmp(name, "Cap" as *u8) == (0 as i32) {
            return type_cap((*ctx).arena, type_primitive(ta, PRIM_I32()));
        }
        // v3.1.1 (V3-C 3g.5): PhantomData<T> builtin — 0-byte ZST type marker.
        // 简化:default inner=i32, 完整 PhantomData<T> generic inner 解析留 v3.2.0 (3i generics).
        // sema 阶段显式识别避免依赖 parser 在 symtab 插入 type_ptr (parser 路径在 fn body scope
        // 不可靠:global_scope vs current_scope 链查找机制)。type_phantom 已存 inner 字段
        // 留给后续 v3.2.0 monomorphize 阶段使用;v3.1.1 M0 只用 size/align 硬编码 invariant。
        if strcmp(name, "PhantomData" as *u8) == (0 as i32) {
            return type_phantom((*ctx).arena, type_primitive(ta, PRIM_I32()));
        }

        // global scope user-defined type
        let gsym = symtab_lookup((*ctx).global_scope, name);
        if gsym != (0 as *Sym) {
            if (*gsym).kind == SYM_TYPE() {
                if (*gsym).type_ptr != (0 as *u8) {
                    return (*gsym).type_ptr as *Type;
                }
            }
        }

        let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                "unknown type" as *u8);
        return type_primitive(ta, PRIM_I32());  // error recovery
    }

    if (*tn).kind == NODE_UNARY() {
        let ud = node_unary_data(tn);
        if (*ud).op == TOKEN_STAR() {
            let inner = resolve_type_node(ctx, ta, (*ud).expr as *Node);
            return type_pointer((*ctx).arena, inner);
        }
        return type_primitive(ta, PRIM_I32());  // error recovery
    }

    if (*tn).kind == NODE_ARRAY_TYPE() {
        let at = node_array_type_data(tn);
        let elem = resolve_type_node(ctx, ta, (*at).elem_type as *Node);
        let mut count: i64 = 0 as i64;
        if (*at).count_expr != (0 as *u8) {
            if (*((*at).count_expr as *Node)).kind == NODE_INT() {
                let idd = node_int_data((*at).count_expr as *Node);
                count = (*idd).value;
            } else {
                let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                        "array size must be an integer constant" as *u8);
            }
        }
        return type_array((*ctx).arena, elem, count);
    }

    if (*tn).kind == NODE_SLICE_TYPE() {
        let st = node_slice_type_data(tn);
        let elem = resolve_type_node(ctx, ta, (*st).elem_type as *Node);
        return type_slice((*ctx).arena, elem);
    }

    // v3.1.0 (V3-C 3g): NODE_REF_TYPE wrapper — `&T` / `&mut T` borrow type.
    // resolve inner,然后 alloc new Type = copy(inner) + is_mut + KIND_REF。
    // 允许 inner 是任意 type(primitive/struct/pointer/slice/array/borrow)。
    // 拒绝规则:
    //   - chained `&&T`(NODE_REF_TYPE 套 NODE_REF_TYPE)— 借用是 terminal
    //   - `&mut volatile T` / `volatile &mut T`(借用不能 + volatile)
    //   - `&mut` 内层是 immutable(borrow 检查放 check_borrow,不在这)
    if (*tn).kind == NODE_REF_TYPE() {
        let rt = node_ref_type_data(tn);
        let inner = resolve_type_node(ctx, ta, (*rt).inner as *Node);
        if inner == (0 as *Type) {
            return type_primitive(ta, PRIM_I32());  // error recovery
        }
        // 拒绝 chained `&&T`
        if (*inner).kind == KIND_REF() {
            let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                    "chained `&&T` not allowed (borrow is terminal)" as *u8);
            return type_primitive(ta, PRIM_I32());
        }
        // 拒绝 `&(mut)? volatile T` 或 `volatile &mut T`
        // split into 2 ifs for jhyy precedence clarity (avoid mixed && ||)
        let mut vol_conflict: i32 = 0;
        if (*inner).is_volatile != (0 as i32) {
            vol_conflict = 1;
        }
        if (*rt).is_mut != (0 as i32) {
            if (*inner).is_volatile != (0 as i32) {
                vol_conflict = 1;
            }
        }
        if vol_conflict != (0 as i32) {
            let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                    "`&` / `&mut` cannot wrap volatile type (volatile forces fresh temp, borrow must persist)" as *u8);
            return type_primitive(ta, PRIM_I32());
        }
        // 分配新 Type = 复制 inner + KIND_REF + is_mut + elem=inner
        let ref_type = arena_alloc((*ctx).arena, TYPE_SIZE()) as *Type;
        (*ref_type).kind = KIND_REF();
        (*ref_type).prim = (*inner).prim;
        (*ref_type).elem = inner as *u8;
        (*ref_type).arr_count = (*inner).arr_count;
        (*ref_type).params = (*inner).params;
        (*ref_type).nparams = (*inner).nparams;
        (*ref_type).ret = (*inner).ret;
        (*ref_type).name = (*inner).name;
        (*ref_type).fields = (*inner).fields;
        (*ref_type).nfields = (*inner).nfields;
        (*ref_type).size = (*inner).size;
        (*ref_type).align = (*inner).align;
        (*ref_type).variants = (*inner).variants;
        (*ref_type).nvariants = (*inner).nvariants;
        (*ref_type).tag_size = (*inner).tag_size;
        (*ref_type).payload_off = (*inner).payload_off;
        (*ref_type).payload_sz = (*inner).payload_sz;
        (*ref_type).sym = (*inner).sym;
        (*ref_type).underlying = (*inner).underlying;
        (*ref_type).is_volatile = 0 as i32;
        (*ref_type)._pad_volatile = 0 as i32;
        (*ref_type).is_mut = (*rt).is_mut;
        (*ref_type)._pad_mut = 0 as i32;
        return ref_type;
    }

    // v3.0.3 (3c volatile): NODE_VOLATILE_TYPE wrapper — resolve inner,
    // 校验 inner 是 primitive (struct/pointer/array 在 parser 阶段 soft warn,
    // 这里做强校验兜底),然后 alloc new Type = copy(inner) + is_volatile=1。
    if (*tn).kind == NODE_VOLATILE_TYPE() {
        let vt = node_volatile_type_data(tn);
        let inner = resolve_type_node(ctx, ta, (*vt).inner as *Node);
        if inner == (0 as *Type) {
            return type_primitive(ta, PRIM_I32());  // error recovery
        }
        // 拒绝 chained (TYPE 已有 is_volatile=1) — parser 已拦,这里再次兜底
        if (*inner).is_volatile != (0 as i32) {
            let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                    "chained `volatile volatile` not allowed" as *u8);
            return type_primitive(ta, PRIM_I32());  // error recovery
        }
        // 拒绝 compound types — only KIND_PRIMITIVE 接受
        if (*inner).kind != KIND_PRIMITIVE() {
            let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                                    "`volatile` only allowed on primitive types (struct/pointer/array not allowed per spec § 6)" as *u8);
            return type_primitive(ta, PRIM_I32());  // error recovery
        }
        // 分配新 Type = 复制 inner 的所有字段 + is_volatile=1
        let vt_type = arena_alloc((*ctx).arena, TYPE_SIZE()) as *Type;
        (*vt_type).kind = (*inner).kind;
        (*vt_type).prim = (*inner).prim;
        (*vt_type).elem = (*inner).elem;
        (*vt_type).arr_count = (*inner).arr_count;
        (*vt_type).params = (*inner).params;
        (*vt_type).nparams = (*inner).nparams;
        (*vt_type).ret = (*inner).ret;
        (*vt_type).name = (*inner).name;
        (*vt_type).fields = (*inner).fields;
        (*vt_type).nfields = (*inner).nfields;
        (*vt_type).size = (*inner).size;
        (*vt_type).align = (*inner).align;
        (*vt_type).variants = (*inner).variants;
        (*vt_type).nvariants = (*inner).nvariants;
        (*vt_type).tag_size = (*inner).tag_size;
        (*vt_type).payload_off = (*inner).payload_off;
        (*vt_type).payload_sz = (*inner).payload_sz;
        (*vt_type).sym = (*inner).sym;
        (*vt_type).underlying = (*inner).underlying;
        (*vt_type).is_volatile = 1 as i32;
        (*vt_type)._pad_volatile = 0 as i32;
        return vt_type;
    }

    let _x = sema_error_str(ctx, (*tn).loc_filename, (*tn).loc_line, (*tn).loc_col,
                            "invalid type annotation" as *u8);
    return type_primitive(ta, PRIM_I32());
}

// ════════════════════════════════════════════════════
// process_match_pattern（v0.7 7A，self-recursive）
// ════════════════════════════════════════════════════

fn process_match_pattern(ctx: *SemaContext, pat: *Node, match_type: *Type) -> i32 {
    if pat == (0 as *Node) { return 0; }

    if (*pat).kind == NODE_PATTERN_IDENT() {
        let pi = node_pattern_ident_data(pat);
        let sym = (*pi).sym as *Sym;
        (*sym).type_ptr = match_type as *u8;
        (*sym).kind = SYM_VAR();
        let _x = symtab_insert((*ctx).current_scope, (*sym).name, SYM_VAR(),
                              match_type as *u8, 0 as i32, (*ctx).scope_depth);
        if (*ctx).nlocals < SEMA_MAX_LOCALS() {
            sema_local_set((*ctx).locals, (*ctx).nlocals, sym, match_type);
            (*ctx).nlocals = (*ctx).nlocals + (1 as i64);
        }
        return 1;
    }

    if (*pat).kind == NODE_PATTERN_ENUM() {
        let pe = node_pattern_enum_data(pat);
        // 找到 variant 的 payload type
        let mut inner_type: *Type = 0 as *Type;
        let mut enum_type: *Type = 0 as *Type;
        if (*pe).type_sym != (0 as *u8) {
            let ts = (*pe).type_sym as *Sym;
            if (*ts).type_ptr != (0 as *u8) {
                let t = (*ts).type_ptr as *Type;
                if (*t).kind == KIND_ENUM() {
                    enum_type = t;
                }
            }
        }
        if enum_type == (0 as *Type) {
            if match_type != (0 as *Type) {
                if (*match_type).kind == KIND_ENUM() {
                    enum_type = match_type;
                }
            }
        }
        if enum_type != (0 as *Type) {
            if (*pe).variant_sym != (0 as *u8) {
                let vsym = (*pe).variant_sym as *Sym;
                let mut i: i64 = 0 as i64;
                while i < (*enum_type).nvariants {
                    // 读 enum_type.variants[i].name（VariantDesc 16 bytes）
                    let v_off = ptr_add_u8((*enum_type).variants, i * VARIANT_DESC_SIZE());
                    let v_name_ptr = *(v_off as **Sym);
                    if var_name_eq_v1(v_name_ptr, vsym) == (0 as i32) {
                        // payload 在 offset 8
                        let payload_ptr = *((v_off as i64 + (8 as i64)) as **Type);
                        inner_type = payload_ptr;
                        break;
                    }
                    i = i + (1 as i64);
                }
            }
        }
        if (*pe).inner != (0 as *u8) {
            let _x = process_match_pattern(ctx, (*pe).inner as *Node, inner_type);
        }
        return 1;
    }

    if (*pat).kind == NODE_PATTERN_OR() {
        // v1.3.7: OR pattern — check binding consistency before recursing.
        // Required: if both sides bind, names must match. If only one side
        // binds, that's asymmetric (e.g. Some(x) | None).
        let po = node_pattern_or_data(pat);
        let left = (*po).left as *Node;
        let right = (*po).right as *Node;
        // Walk OR tree to find first ENUM leaf on each side (handles nested OR).
        let mut ln_binding: *u8 = 0 as *u8;
        let mut rn_binding: *u8 = 0 as *u8;
        let mut l_cur: *Node = left;
        while l_cur != (0 as *Node) {
            if (*l_cur).kind == NODE_PATTERN_OR() {
                let lpo = node_pattern_or_data(l_cur);
                l_cur = (*lpo).left as *Node;
            } else {
                if (*l_cur).kind == NODE_PATTERN_ENUM() {
                    let lpe = node_pattern_enum_data(l_cur);
                    if (*lpe).inner != (0 as *u8) {
                        let inner_n = (*lpe).inner as *Node;
                        if inner_n != (0 as *Node) {
                            if (*inner_n).kind == NODE_PATTERN_IDENT() {
                                let lpi = node_pattern_ident_data(inner_n);
                                let lsym = (*lpi).sym as *Sym;
                                ln_binding = (*lsym).name;
                            }
                        }
                    }
                }
                break;
            }
        }
        let mut r_cur: *Node = right;
        while r_cur != (0 as *Node) {
            if (*r_cur).kind == NODE_PATTERN_OR() {
                let rpo = node_pattern_or_data(r_cur);
                r_cur = (*rpo).left as *Node;
            } else {
                if (*r_cur).kind == NODE_PATTERN_ENUM() {
                    let rpe = node_pattern_enum_data(r_cur);
                    if (*rpe).inner != (0 as *u8) {
                        let inner_n = (*rpe).inner as *Node;
                        if inner_n != (0 as *Node) {
                            if (*inner_n).kind == NODE_PATTERN_IDENT() {
                                let rpi = node_pattern_ident_data(inner_n);
                                let rsym = (*rpi).sym as *Sym;
                                rn_binding = (*rsym).name;
                            }
                        }
                    }
                }
                break;
            }
        }
        if ln_binding != (0 as *u8) {
            if rn_binding == (0 as *u8) {
                let _x = sema_error_str(ctx, (*pat).loc_filename, (*pat).loc_line, (*pat).loc_col,
                        "OR pattern bindings must match (left binds, right doesn't)" as *u8);
                return 1;
            }
            if strcmp(ln_binding, rn_binding) != (0 as i32) {
                let _x = sema_error_str(ctx, (*pat).loc_filename, (*pat).loc_line, (*pat).loc_col,
                        "OR pattern bindings must match" as *u8);
                return 1;
            }
        } else {
            if rn_binding != (0 as *u8) {
                let _x = sema_error_str(ctx, (*pat).loc_filename, (*pat).loc_line, (*pat).loc_col,
                        "OR pattern bindings must match (right binds, left doesn't)" as *u8);
                return 1;
            }
        }
        let _x1 = process_match_pattern(ctx, left, match_type);
        let _x2 = process_match_pattern(ctx, right, match_type);
        return 1;
    }

    // PATTERN_LIT / PATTERN_WILD / PATTERN_RANGE：无 bindings
    return 1;
}

// ════════════════════════════════════════════════════
// v3.2.0d (3i fn path): mono_propagate_idents_to_cloned_body
//   Walks cloned fn body, for every NODE_IDENT copies (*sym).type_ptr
//   into (*ident).type_ptr. This is what infer_type would do for a regular
//   NODE_IDENT in a checked fn body, but cloned fns in inference path
//   don't get check_func_decl'd (Pass 3b skips $-mangled, Pass 3a already
//   finished before the inference arm). Without this propagation, codegen
//   sees IDENT.type_ptr=0 and defaults to `w` ops (csgtw etc) regardless
//   of the substituted T — broken for f64, struct args etc.
//
//   Inlined here (semantic counterpart of mono_rewrite_idents_in_expr) so
//   inference arm can call it without going through full check_func_decl
//   (which is defined later in this file; jhyy no forward refs).
// ════════════════════════════════════════════════════

fn mono_propagate_idents_in_expr(node: *Node) -> i32 {
    if node == (0 as *Node) { return 0 as i32; }
    let nk_off = node as *i32;
    let nk = *nk_off;
    if nk == NODE_IDENT() {
        let id_data = (node as i64 + NODE_SIZE()) as *u8;
        let id_sym_off = id_data as **u8;
        let cur = *id_sym_off;
        if cur != (0 as *u8) {
            let cur_tp = (*(cur as *Sym)).type_ptr;
            if cur_tp != (0 as *u8) {
                *((node as i64 + (8 as i64)) as **u8) = cur_tp;
            }
        }
        return 1 as i32;
    }
    if nk == NODE_BINARY() {
        let bn_data = (node as i64 + NODE_SIZE()) as *u8;
        let l = *((bn_data as i64 + (8 as i64)) as **Node);
        let r = *((bn_data as i64 + (16 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(l);
        let _x2 = mono_propagate_idents_in_expr(r);
        return 1 as i32;
    }
    if nk == NODE_UNARY() {
        let un_data = (node as i64 + NODE_SIZE()) as *u8;
        let ex = *((un_data as i64 + (8 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(ex);
        return 1 as i32;
    }
    if nk == NODE_CALL() {
        let cn_data = (node as i64 + NODE_SIZE()) as *u8;
        let cn_callee = *((cn_data as i64 + (0 as i64)) as **Node);
        let cn_args = *((cn_data as i64 + (8 as i64)) as **u8);
        let cn_nargs = *((cn_data as i64 + (16 as i64)) as *i64);
        let _x1 = mono_propagate_idents_in_expr(cn_callee);
        let mut ai: i64 = 0 as i64;
        while ai < cn_nargs {
            let a = *((cn_args as i64 + ai * (8 as i64)) as **Node);
            let _x2 = mono_propagate_idents_in_expr(a);
            ai = ai + (1 as i64);
        }
        return 1 as i32;
    }
    if nk == NODE_FIELD() {
        let fn_data = (node as i64 + NODE_SIZE()) as *u8;
        let tg = *((fn_data as i64 + (0 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(tg);
        return 1 as i32;
    }
    if nk == NODE_INDEX() {
        let in_data = (node as i64 + NODE_SIZE()) as *u8;
        let tg = *((in_data as i64 + (0 as i64)) as **Node);
        let ix = *((in_data as i64 + (8 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(tg);
        let _x2 = mono_propagate_idents_in_expr(ix);
        return 1 as i32;
    }
    return 0 as i32;
}

fn mono_propagate_idents_to_cloned_body(body: *Node) -> i32 {
    if body == (0 as *Node) { return 0 as i32; }
    let nk_off = body as *i32;
    let nk = *nk_off;
    if nk == NODE_BLOCK() {
        let bn_data = (body as i64 + NODE_SIZE()) as *u8;
        let bn_stmts = *((bn_data as i64 + (0 as i64)) as **u8);
        let bn_nstmts = *((bn_data as i64 + (8 as i64)) as *i64);
        let mut si: i64 = 0 as i64;
        while si < bn_nstmts {
            let s = *((bn_stmts as i64 + si * (8 as i64)) as **Node);
            let _x = mono_propagate_idents_to_cloned_body(s);
            si = si + (1 as i64);
        }
        return 1 as i32;
    }
    if nk == NODE_IF() {
        let in_data = (body as i64 + NODE_SIZE()) as *u8;
        let c = *((in_data as i64 + (0 as i64)) as **Node);
        let t = *((in_data as i64 + (8 as i64)) as **Node);
        let e = *((in_data as i64 + (16 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(c);
        let _x2 = mono_propagate_idents_to_cloned_body(t);
        let _x3 = mono_propagate_idents_to_cloned_body(e);
        return 1 as i32;
    }
    if nk == NODE_WHILE() {
        let wn_data = (body as i64 + NODE_SIZE()) as *u8;
        let c = *((wn_data as i64 + (0 as i64)) as **Node);
        let b = *((wn_data as i64 + (8 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(c);
        let _x2 = mono_propagate_idents_to_cloned_body(b);
        return 1 as i32;
    }
    if nk == NODE_LET() {
        let ln_data = (body as i64 + NODE_SIZE()) as *u8;
        let an = *((ln_data as i64 + (0 as i64)) as **Node);
        let in_ = *((ln_data as i64 + (8 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(an);
        let _x2 = mono_propagate_idents_in_expr(in_);
        return 1 as i32;
    }
    if nk == NODE_RETURN() {
        let rn_data = (body as i64 + NODE_SIZE()) as *u8;
        let v = *((rn_data as i64 + (0 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(v);
        return 1 as i32;
    }
    if nk == NODE_ASSIGN() {
        let an_data = (body as i64 + NODE_SIZE()) as *u8;
        let tg = *((an_data as i64 + (0 as i64)) as **Node);
        let vl = *((an_data as i64 + (8 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(tg);
        let _x2 = mono_propagate_idents_in_expr(vl);
        return 1 as i32;
    }
    if nk == NODE_EXPR_STMT() {
        let en_data = (body as i64 + NODE_SIZE()) as *u8;
        let e = *((en_data as i64 + (0 as i64)) as **Node);
        let _x1 = mono_propagate_idents_in_expr(e);
        return 1 as i32;
    }
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// infer_type（self-recursive 大函数 — Sprint 3 commit 5 主体）
// ════════════════════════════════════════════════════

// ta: TypeArena
fn infer_type(ctx: *SemaContext, ta: *TypeArena, n: *Node) -> *Type {
    if n == (0 as *Node) { return type_void(ta); }
    if (*n).type_ptr != (0 as *u8) { return (*n).type_ptr as *Type; }

    // ── literals ──
    if (*n).kind == NODE_INT() {
        let d = node_int_data(n);
        let t = type_primitive(ta, (*d).prim);
        (*n).type_ptr = t as *u8;
        return t;
    }
    if (*n).kind == NODE_FLOAT() {
        // v1.7.0 Stage 5: read d->prim (was: hardcoded PRIM_F64)
        let d = node_float_data(n);
        let t = type_primitive(ta, (*d).prim);
        (*n).type_ptr = t as *u8;
        return t;
    }
    if (*n).kind == NODE_STRING() {
        let t = type_pointer((*ctx).arena, type_primitive(ta, PRIM_U8()));
        (*n).type_ptr = t as *u8;
        return t;
    }
    if (*n).kind == NODE_CHAR() {
        // v1.7.0 Stage 3: spec §4.4 — char literal type is i32 (was PRIM_U8)
        let t = type_primitive(ta, PRIM_I32());
        (*n).type_ptr = t as *u8;
        return t;
    }
    if (*n).kind == NODE_BOOL() {
        let t = type_primitive(ta, PRIM_BOOL());
        (*n).type_ptr = t as *u8;
        return t;
    }
    // v1.3.1: null literal — type 由 caller 上下文填充 (sentinel NULL here)
    if (*n).kind == NODE_NULL() {
        (*n).type_ptr = 0 as *u8;
        return 0 as *Type;
    }
    // V3-B v3.0.1: asm!(...) inline asm — type is unit () (per spec § 3 语义).
    //   asm 块只能用于 statement-position; parser 把它放在 expr context
    //   是为了走 cg_expr/cg_stmt 统一 emit 路径. sema 不强制 stmt-position
    //   检查 (parser 已经 emit clear error on `let x = asm!(...)` 通过
    //   type_void return → type mismatch 由 caller 报) — 这里只负责给
    //   type_ptr 填 unit 即可. v3.1+ 加 operand constraints 时这里会读
    //   node_asm_block_data(n).operands[i] 推断 operand 类型.
    if (*n).kind == NODE_ASM_BLOCK() {
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }
    // v3.0.5 (3f memory barrier): fence_seq_cst/acquire/release return
    // unit type (stmt-position; never used as expr value). codegen emits
    // raw mnem (mfence/lfence/sfence) to _fence.buf side-file from
    // node_builtin_fence_data(n).kind.
    if (*n).kind == NODE_BUILTIN_FENCE() {
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }
    // v1.3.3: sizeof(TypeName) — compile-time const. Mirror C-side sema.c.
    // Resolve target type, compute size, fill n->type=i64 + node_int_data.
    if (*n).kind == NODE_SIZEOF() {
        let sd = node_sizeof_data(n);
        let target_type = resolve_type_node(ctx, ta, (*sd).target as *Node);
        if target_type == (0 as *Type) {
            sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col, "unknown type in sizeof" as *u8);
        }
        let t = type_primitive(ta, PRIM_I64());
        (*n).type_ptr = t as *u8;
        let id = node_int_data(n);
        (*id).value = type_size(target_type as *Type);
        (*id).prim = PRIM_I64() as i32;
        return t;
    }

    // ── identifier ──
    if (*n).kind == NODE_IDENT() {
        let d = node_ident_data(n);
        let id_sym = (*d).sym as *Sym;
        // 1) sym 本身有 type
        if id_sym != (0 as *Sym) {
            if (*id_sym).type_ptr != (0 as *u8) {
                let t = (*id_sym).type_ptr as *Type;
                (*n).type_ptr = t as *u8;
                return t;
            }
        }
        // 2) locals 反向搜索
        let mut i: i64 = (*ctx).nlocals - (1 as i64);
        while i >= (0 as i64) {
            let ls = sema_local_sym((*ctx).locals, i);
            if ls == id_sym {
                let lt = sema_local_type((*ctx).locals, i);
                (*n).type_ptr = lt as *u8;
                return lt;
            }
            // name 匹配 fallback（hash 重复 sym 时）
            if strcmp((*ls).name, (*id_sym).name) == (0 as i32) {
                let lt = sema_local_type((*ctx).locals, i);
                (*n).type_ptr = lt as *u8;
                return lt;
            }
            i = i - (1 as i64);
        }
        // 3) global scope lookup（imported fns / types / variants）
        let gsym = symtab_lookup_local((*ctx).global_scope, (*id_sym).name);
        if gsym != (0 as *Sym) {
            if (*gsym).kind == SYM_FN() || (*gsym).kind == SYM_TYPE() {
                if (*gsym).type_ptr != (0 as *u8) {
                    // 替换 sym 让 codegen 拿到正确 module
                    if gsym != id_sym {
                        (*d).sym = gsym as *u8;
                    }
                    let t = (*gsym).type_ptr as *Type;
                    (*n).type_ptr = t as *u8;
                    return t;
                }
            }
            // 3b) SYM_VARIANT: 取 parent enum 的 type（module 字段记的是 enum 名）
            if (*gsym).kind == SYM_VARIANT() {
                let module_name = (*gsym).module;
                if module_name != (0 as *u8) {
                    let enum_sym = symtab_lookup_local((*ctx).global_scope, module_name);
                    if enum_sym != (0 as *Sym) {
                        if (*enum_sym).type_ptr != (0 as *u8) {
                            if gsym != id_sym {
                                (*d).sym = gsym as *u8;
                            }
                            let t = (*enum_sym).type_ptr as *Type;
                            (*n).type_ptr = t as *u8;
                            return t;
                        }
                    }
                }
            }
        }
        let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                "undefined variable" as *u8);
        let t = type_primitive(ta, PRIM_I32());
        (*n).type_ptr = t as *u8;
        return t;
    }

    // ── unary ──
    if (*n).kind == NODE_UNARY() {
        let d = node_unary_data(n);
        let inner = infer_type(ctx, ta, (*d).expr as *Node);
        if (*d).op == TOKEN_MINUS() || (*d).op == TOKEN_TILDE() {
            if (*inner).kind != KIND_PRIMITIVE() {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "unary operator requires primitive type" as *u8);
            }
            (*n).type_ptr = inner as *u8;
            return inner;
        }
        if (*d).op == TOKEN_BANG() {
            let t = type_primitive(ta, PRIM_BOOL());
            (*n).type_ptr = t as *u8;
            return t;
        }
        // default: deref / addr-of 等单独 kind 处理
        (*n).type_ptr = inner as *u8;
        return inner;
    }

    // ── binary ──
    if (*n).kind == NODE_BINARY() {
        let d = node_binary_data(n);
        let mut lt: *Type = infer_type(ctx, ta, (*d).left as *Node);
        let mut rt: *Type = infer_type(ctx, ta, (*d).right as *Node);
        // v1.3.1: null fills other-operand's pointer type (e.g. `if p == null`)
        if (*((*d).left as *Node)).kind == NODE_NULL() {
            if rt != (0 as *Type) {
                if (*rt).kind == KIND_POINTER() {
                    (*((*d).left as *Node)).type_ptr = rt as *u8;
                    lt = rt;
                }
            }
        } else if (*((*d).right as *Node)).kind == NODE_NULL() {
            if lt != (0 as *Type) {
                if (*lt).kind == KIND_POINTER() {
                    (*((*d).right as *Node)).type_ptr = lt as *u8;
                    rt = lt;
                }
            }
        }

        let op = (*d).op;
        if op == TOKEN_PLUS() || op == TOKEN_MINUS() || op == TOKEN_STAR() ||
           op == TOKEN_SLASH() || op == TOKEN_PERCENT() ||
           op == TOKEN_PIPE()  || op == TOKEN_AMP()   || op == TOKEN_CARET() ||
           op == TOKEN_LTLT()  || op == TOKEN_GTGT() {
            // v1.7.0 Stage 2: spec §9.5 pointer arithmetic
            // - *T + int / *T - int → *T
            // - int + *T → *T
            // - *T - *T → i64 (same elem type)
            // NOTE: 避免 `A && (B || C)` pattern — jhyy-side codegen 在 && RHS
            // 含 || 时 phi predecessors 错配 (per Stage 2 Step 3 build break)。
            // 改写为 nested if, 跟 C-side sema.c 行为对齐 (sema.c 不受影响)。
            if lt != (0 as *Type) && rt != (0 as *Type) {
                let lt_kind = (*lt).kind;
                let rt_kind = (*rt).kind;
                if lt_kind == KIND_POINTER() {
                    if rt_kind == KIND_PRIMITIVE() || rt_kind == KIND_POINTER() {
                        if op == TOKEN_PLUS() || op == TOKEN_MINUS() {
                            if rt_kind == KIND_PRIMITIVE() {
                                (*n).type_ptr = lt as *u8;
                                return lt;
                            }
                            if rt_kind == KIND_POINTER() && op == TOKEN_MINUS() {
                                if type_eq((*lt).elem as *Type, (*rt).elem as *Type) != (0 as i32) {
                                    let i64_t = type_primitive(ta, PRIM_I64());
                                    (*n).type_ptr = i64_t as *u8;
                                    return i64_t;
                                }
                            }
                        }
                    }
                }
                if op == TOKEN_PLUS() && rt_kind == KIND_POINTER() &&
                   lt_kind == KIND_PRIMITIVE() {
                    (*n).type_ptr = rt as *u8;
                    return rt;
                }
            }
            if type_eq(lt, rt) == (0 as i32) {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "type mismatch in binary" as *u8);
            }
            (*n).type_ptr = lt as *u8;
            return lt;
        }
        if op == TOKEN_EQEQ() || op == TOKEN_BANGEQ() ||
           op == TOKEN_LT() || op == TOKEN_GT() ||
           op == TOKEN_LTEQ() || op == TOKEN_GTEQ() {
            let t = type_primitive(ta, PRIM_BOOL());
            (*n).type_ptr = t as *u8;
            return t;
        }
        if op == TOKEN_AMPAMP() || op == TOKEN_PIPEPIPE() {
            let t = type_primitive(ta, PRIM_BOOL());
            (*n).type_ptr = t as *u8;
            return t;
        }
        // default
        (*n).type_ptr = lt as *u8;
        return lt;
    }

    // ── cast ──
    if (*n).kind == NODE_CAST() {
        let d = node_cast_data(n);
        // v1.3.1: null cast fills target type (e.g. `null as *u8`)
        if (*((*d).expr as *Node)).kind == NODE_NULL() {
            if (*d).target_type != (0 as *u8) {
                let to = resolve_type_node(ctx, ta, (*d).target_type as *Node);
                (*((*d).expr as *Node)).type_ptr = to as *u8;
                (*n).type_ptr = to as *u8;
                return to;
            }
        }
        let from = infer_type(ctx, ta, (*d).expr as *Node);
        if (*d).target_type != (0 as *u8) {
            let to = resolve_type_node(ctx, ta, (*d).target_type as *Node);
            // array → slice 特殊：直接接受
            (*n).type_ptr = to as *u8;
            return to;
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── deref ──
    if (*n).kind == NODE_DEREF() {
        let d = node_deref_data(n);
        let inner = infer_type(ctx, ta, (*d).expr as *Node);
        if (*inner).kind != KIND_POINTER() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "cannot dereference non-pointer type" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let elem = (*inner).elem as *Type;
        (*n).type_ptr = elem as *u8;
        return elem;
    }

    // ── addr-of ──
    if (*n).kind == NODE_ADDR_OF() {
        let d = node_addr_of_data(n);
        let inner = infer_type(ctx, ta, (*d).expr as *Node);
        let t = type_pointer((*ctx).arena, inner);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // v3.2.1 (V3-C 3j): closure literal — auto-capture analysis + closure type.
    //   MVP design:
    //   - 闭包 = 匿名 struct { fn_ptr: *u8, env_ptr: *u8 }(16 bytes;fn_ptr 是
    //     QBE function 标签 env 通过闭包字面量处栈 alloc + 初始化)
    //   - 闭包 type 不导出具体 field layout(只是 opaque 16-byte struct pointer)
    //   - codegen 负责:
    //     a) 扫描 body 找 free vars,生成 env struct layout + stack alloc
    //     b) 合成 fn `__closure_N(env_ptr, params...) -> ret` 并 append 到
    //        module decls(由 cg_module 后续 pass emit)
    //     c) 返回 closure 值 { fn_ptr=__closure_N label, env_ptr=&env }
    //   - NODE_CALL 检测 callee 是 closure 时:取出 fn_ptr + env_ptr,emit
    //     间接 call(or 直接 call 已知 fn_name)
    if (*n).kind == NODE_CLOSURE_LITERAL() {
        let cd = node_closure_data(n);

        // 1) resolve param types + push params as locals (跟 fn path 类似)
        sema_push_scope(ctx);
        (*ctx).nlocals = 0 as i64;
        let mut pi: i64 = 0 as i64;
        while pi < (*cd).nparams {
            let param = ptr_add_u8((*cd).params, pi * (16 as i64)) as *NodeFuncDeclParam;
            let pt = resolve_type_node(ctx, ta, (*param).type_annot as *Node);
            let param_sym = (*param).sym as *Sym;
            (*param_sym).type_ptr = pt as *u8;
            (*param_sym).kind = SYM_VAR();
            let _x = symtab_insert((*ctx).current_scope, (*param_sym).name, SYM_VAR(),
                                   pt as *u8, 0 as i32, (*ctx).scope_depth);
            pi = pi + (1 as i64);
        }

        // 2) walk body stmts — type-check each (M0: body 仅用 params + literals,
        //    不引用 outer vars)
        let blk = (*cd).body as *Node;
        let mut body_ret_type: *Type = type_void(ta);
        if blk != (0 as *Node) {
            let bd = node_block_data(blk);
            let mut bi: i64 = 0 as i64;
            while bi < (*bd).nstmts {
                let s = *(((*bd).stmts as i64 + bi * (8 as i64)) as **Node);
                if s != (0 as *Node) {
                    let t = infer_type(ctx, ta, s);
                    // 记录最后 expr stmt 的 type 作为 fn 返回类型
                    if (*s).kind == NODE_EXPR_STMT() {
                        body_ret_type = t;
                    }
                }
                bi = bi + (1 as i64);
            }
        }

        sema_pop_scope(ctx);

        // 3) 构造合成 fn 类型 (params...) -> ret
        let param_types_buf = arena_alloc((*ctx).arena, (*cd).nparams * (8 as i64));
        let mut pti: i64 = 0 as i64;
        while pti < (*cd).nparams {
            let param2 = ptr_add_u8((*cd).params, pti * (16 as i64)) as *NodeFuncDeclParam;
            let pt2 = (*((*param2).type_annot as *Node)).type_ptr as *Type;
            let pt_slot = ptr_add_u8(param_types_buf, pti * (8 as i64)) as **Type;
            *pt_slot = pt2;
            pti = pti + (1 as i64);
        }
        let fn_t = type_func((*ctx).arena, param_types_buf, (*cd).nparams, body_ret_type);

        // 4) 构造合成 fn sym `__closure_<N>` — N 用 closure 节点地址 hash
        let mut counter_buf: *u8 = arena_alloc((*ctx).arena, 32 as i64);
        let name0 = "__closure_" as *u8;
        let mut ci: i64 = 0 as i64;
        while ci < 10 as i64 {
            let cs = ptr_add_u8(counter_buf, ci) as *u8;
            *cs = *(ptr_add_u8(name0, ci) as *u8);
            ci = ci + (1 as i64);
        }
        let name_addr = n as i64;
        let digit1 = (name_addr % (10 as i64)) + (0x30 as i64);
        let digit2 = ((name_addr / (10 as i64)) % (10 as i64)) + (0x30 as i64);
        let digit3 = ((name_addr / (100 as i64)) % (10 as i64)) + (0x30 as i64);
        let digit4 = ((name_addr / (1000 as i64)) % (10 as i64)) + (0x30 as i64);
        let digit5 = ((name_addr / (10000 as i64)) % (10 as i64)) + (0x30 as i64);
        *(ptr_add_u8(counter_buf, 10 as i64) as *u8) = digit1 as u8;
        *(ptr_add_u8(counter_buf, 11 as i64) as *u8) = digit2 as u8;
        *(ptr_add_u8(counter_buf, 12 as i64) as *u8) = digit3 as u8;
        *(ptr_add_u8(counter_buf, 13 as i64) as *u8) = digit4 as u8;
        *(ptr_add_u8(counter_buf, 14 as i64) as *u8) = digit5 as u8;
        *(ptr_add_u8(counter_buf, 15 as i64) as *u8) = 0 as u8;

        let fn_sym = symtab_insert((*ctx).global_scope, counter_buf, SYM_FN(),
                                   fn_t as *u8, 0 as i32, 0 as i32);
        // store fn sym into closure node
        (*cd).fn_sym = fn_sym as *u8;

        // 5) v3.2.1 (3j): append 合成 NODE_FUNC_DECL to module.decls — cg_module Pass B
        //   visits decls 走 cg_func 自动 emit 合成 fn body 为 top-level QBE function.
        //   ret_type = null: cg_func reads return type from fn_sym.type_ptr (= fn_t.ret)
        //   params/nparams/body 复用 closure 原 AST nodes(零拷贝)。
        let fn_decl = ast_new_func_decl(
            (*ctx).arena,
            (*n).loc_filename, (*n).loc_line, (*n).loc_col,
            fn_sym as *Sym,
            (*cd).params, (*cd).nparams,
            0 as *Node,                       // ret_type = null (cg_func uses sym.type_ptr)
            (*cd).body as *Node,
            0 as i32, 0 as i32, 0 as i32,     // is_extern, is_inline, is_naked = 0
            0 as *u8,                         // link_section = null
            0 as *u8,                         // type_params = null
            0 as i64                          // ntype_params = 0
        );
        let mnd2 = node_module_data((*ctx).module);
        mono_decls_append((*ctx).arena, mnd2 as *u8, fn_decl);

        // 6) closure type = synthesized fn type (KIND_FUNC)
        (*n).type_ptr = fn_t as *u8;
        return fn_t;
    }

    // ── call ──
    if (*n).kind == NODE_CALL() {
        let d = node_call_data(n);

        // v3.2.0c (3i fn path): turbofish handling — if parser attached type_args
        //   (e.g. `max::<i32>(3, 5)`),trigger mono_expand_fn_call:
        //   - resolve callee to NODE_FUNC_DECL via global_scope lookup
        //   - clone generic fn body,subst T→arg_nodes,register mangled sym
        //   - rewrite NODE_CALL.callee to point at mangled sym
        // call-site inference (no turbofish) not yet supported in v3.2.0c —
        //   fallback to E0062 below if callee is still generic.
        //   offset access (per v3.2.0b mitigation): `(*d).ntype_args` deep
        //   nested struct deref triggers stage-0 codegen stack-spill bug.
        //   NodeCall ntype_args @ offset 32.
        let d_off = d as i64;
        let nta_off = (d_off + (32 as i64)) as *i64;
        let nta_val = *nta_off;
        if nta_val > (0 as i64) {
            // callee @ offset 0 (offset access)
            let callee_off = d_off as **u8;
            let callee_ptr = *callee_off;
            if callee_ptr != (0 as *u8) {
                let callee_kind_off = callee_ptr as *i32;
                let callee_kind = *callee_kind_off;
                if callee_kind == NODE_IDENT() {
                    let callee_id_pre = node_ident_data(callee_ptr as *Node);
                    let callee_id_pre_sym_off = callee_id_pre as **u8;
                    let callee_sym_pre = *callee_id_pre_sym_off as *Sym;
                    if (*callee_sym_pre).kind == SYM_FN() {
                        // type_args @ offset 24 (offset access)
                        let ta_off = (d_off + (24 as i64)) as **u8;
                        let ta_ptr = *ta_off;
                        let mangled_sym = mono_expand_fn_call(
                            (*ctx).global_scope, (*ctx).arena,
                            (*ctx).module as *Node,
                            callee_sym_pre,
                            ta_ptr, nta_val);
                        if mangled_sym != (0 as *Sym) {
                            // rewrite NODE_IDENT.sym → mangled fn sym
                            *callee_id_pre_sym_off = mangled_sym as *u8;
                        }
                    }
                }
            }
        } else {
            // v3.2.0d (3i fn path): call-site type inference — when no turbofish
            //   (nta_val == 0) but callee is a generic fn (ntype_params > 0),
            //   infer type_args from arg types. Algorithm:
            //     1. resolve generic def via mono_find_generic_def
            //     2. for each fn param whose type matches a type_param, record slot
            //     3. for each call arg, infer_type → *Type → mono_type_to_type_node
            //     4. set type_args[slot] = arg_type_node; verify agreement
            //     5. call mono_expand_fn_call; rewrite callee sym to mangled sym
            //   Full offset access pattern (per v3.2.0b L102-104 mitigation).
            let callee_off2 = d_off as **u8;
            let callee_ptr2 = *callee_off2;
            if callee_ptr2 != (0 as *u8) {
                let callee_kind_off2 = callee_ptr2 as *i32;
                let callee_kind2 = *callee_kind_off2;
                if callee_kind2 == NODE_IDENT() {
                    let callee_id_pre2 = node_ident_data(callee_ptr2 as *Node);
                    let callee_id_pre2_sym_off = callee_id_pre2 as **u8;
                    let callee_sym_pre2 = *callee_id_pre2_sym_off as *Sym;
                    if (*callee_sym_pre2).kind == SYM_FN() {
                        let base_name2 = (*callee_sym_pre2).name;
                        // convert (*ctx).module (*Node) → *NodeModule for mono_find_generic_def
                        let mnd = node_module_data((*ctx).module);
                        let generic_def = mono_find_generic_def(mnd as *Node, base_name2);
                        if generic_def != (0 as *Node) {
                            // read type_params + ntype_params (offsets 80 / 88)
                            let gd_off = generic_def as i64;
                            let gd_tp_off = (gd_off + NODE_SIZE() + (80 as i64)) as **u8;
                            let gd_tp = *gd_tp_off;
                            let gd_ntp_off = (gd_off + NODE_SIZE() + (88 as i64)) as *i64;
                            let gd_ntp = *gd_ntp_off;
                            if gd_ntp > (0 as i64) {
                                let gfd = node_func_decl_data(generic_def);
                                let nparams2 = (*gfd).nparams;
                                // alloc type_args buffer (gd_ntp * 8) + slot_filled bytes
                                let type_args_buf = arena_alloc((*ctx).arena, gd_ntp * (8 as i64));
                                let slot_filled = arena_alloc((*ctx).arena, gd_ntp);
                                // init: type_args[i] = 0, slot_filled[i] = 0
                                let mut si2: i64 = 0 as i64;
                                while si2 < gd_ntp {
                                    let ta_slot_init = (type_args_buf as i64 + si2 * (8 as i64)) as **Node;
                                    *ta_slot_init = 0 as *Node;
                                    let sf_byte = (slot_filled as i64 + si2) as *u8;
                                    *sf_byte = 0 as u8;
                                    si2 = si2 + (1 as i64);
                                }
                                let mut all_ok2: i32 = 1 as i32;
                                // walk fn params, match type_annot against type_params
                                let mut pi2: i64 = 0 as i64;
                                while pi2 < nparams2 {
                                    if all_ok2 == (0 as i32) { break; }
                                    if pi2 >= (*d).nargs { break; }
                                    let param2 = ptr_add_u8((*gfd).params, pi2 * (16 as i64)) as *NodeFuncDeclParam;
                                    let pt_node2 = (*param2).type_annot as *Node;
                                    // match pt_node2 against type_params[tj] — type_params stores
                                    //   *Sym (per parser.jhyy L3150), NOT *Node. So compare
                                    //   param.type_annot.sym directly against type_params[i].
                                    let mut matched_slot: i64 = -1 as i64;
                                    if (*pt_node2).kind == NODE_IDENT() {
                                        let pt_id2 = node_ident_data(pt_node2);
                                        let pt_sym2 = (*pt_id2).sym;
                                        let mut tj2: i64 = 0 as i64;
                                        while tj2 < gd_ntp {
                                            let tp_sym2 = *((gd_tp as i64 + tj2 * (8 as i64)) as **Sym);
                                            if pt_sym2 == tp_sym2 as *u8 {
                                                matched_slot = tj2;
                                                break;
                                            }
                                            tj2 = tj2 + (1 as i64);
                                        }
                                    }
                                    // infer this call arg's type
                                    let arg_node2 = *(((*d).args as i64 + pi2 * (8 as i64)) as **Node);
                                    let arg_t2 = infer_type(ctx, ta, arg_node2);
                                    if matched_slot >= (0 as i64) {
                                        let ta_slot2 = (type_args_buf as i64 + matched_slot * (8 as i64)) as **Node;
                                        let sf_byte2 = (slot_filled as i64 + matched_slot) as *u8;
                                        if *sf_byte2 == (0 as u8) {
                                            // first time: convert + set
                                            let new_targ2 = mono_type_to_type_node((*ctx).arena, (*ctx).global_scope, arg_t2);
                                            if new_targ2 == (0 as *Node) {
                                                let _x_err2 = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "E0062: cannot infer type parameter from argument (unsupported type kind)" as *u8);
                                                all_ok2 = 0 as i32;
                                            } else {
                                                *ta_slot2 = new_targ2;
                                                *sf_byte2 = 1 as u8;
                                            }
                                        } else {
                                            // already filled: mangle-equality check
                                            let existing_targ2 = *ta_slot2;
                                            let new_targ2b = mono_type_to_type_node((*ctx).arena, (*ctx).global_scope, arg_t2);
                                            if new_targ2b == (0 as *Node) {
                                                let _x_err2b = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "E0062: cannot infer type parameter from argument (unsupported type kind)" as *u8);
                                                all_ok2 = 0 as i32;
                                            } else {
                                                let mut buf_a: *u8 = 0 as *u8;
                                                let mut len_a: i64 = 0 as i64;
                                                let mut cap_a: i64 = 0 as i64;
                                                mono_mangle_type_node_fn((*ctx).arena, existing_targ2, &buf_a, &len_a, &cap_a);
                                                *(ptr_add_u8(buf_a, len_a) as *u8) = 0 as u8;
                                                let mut buf_b: *u8 = 0 as *u8;
                                                let mut len_b: i64 = 0 as i64;
                                                let mut cap_b: i64 = 0 as i64;
                                                mono_mangle_type_node_fn((*ctx).arena, new_targ2b, &buf_b, &len_b, &cap_b);
                                                *(ptr_add_u8(buf_b, len_b) as *u8) = 0 as u8;
                                                if strcmp(buf_a, buf_b) != (0 as i32) {
                                                    let _x_err2d = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                        "E0062: conflicting types for type parameter" as *u8);
                                                    all_ok2 = 0 as i32;
                                                }
                                            }
                                        }
                                    }
                                    pi2 = pi2 + (1 as i64);
                                }
                                if all_ok2 == (1 as i32) {
                                    // verify all slots filled
                                    let mut all_filled2: i32 = 1 as i32;
                                    let mut sf3: i64 = 0 as i64;
                                    while sf3 < gd_ntp {
                                        let sf_byte3 = (slot_filled as i64 + sf3) as *u8;
                                        if *sf_byte3 == (0 as u8) {
                                            all_filled2 = 0 as i32;
                                            break;
                                        }
                                        sf3 = sf3 + (1 as i64);
                                    }
                                    if all_filled2 == (1 as i32) {
                                        let mangled2 = mono_expand_fn_call(
                                            (*ctx).global_scope, (*ctx).arena,
                                            (*ctx).module as *Node,
                                            callee_sym_pre2,
                                            type_args_buf, gd_ntp);
                                        if mangled2 != (0 as *Sym) {
                                            // rewrite NODE_IDENT.sym → mangled fn sym (mirror v3.2.0c turbofish path L991-993)
                                            *callee_id_pre2_sym_off = mangled2 as *u8;
                                            // v3.2.0d (3i fn path): for inference path, no generic_insts was
                                            //   pre-recorded by parser (turbofish records but `f(args)` doesn't).
                                            //   Pass 1.5 (mono_expand_module) did nothing; Pass 3a has already
                                            //   finished before us. The cloned fn decl we just appended via
                                            //   mono_expand_fn_call won't be check_func_decl'd by Pass 3b either
                                            //   (Pass 3b skips mangled-$ fns, deferring to Pass 3a). So we
                                            //   inline the type_ptr setup here — find the cloned decl, build its
                                            //   KIND_FUNC type from resolved param_types + ret_type, and assign
                                            //   to mangled2.type_ptr. check_func_decl (L2273) does the same
                                            //   thing at L2290-2294, but it's defined later in this file (jhyy no
                                            //   forward refs), so we can't call it from inside infer_type.
                                            let mdd2 = node_module_data((*ctx).module);
                                            let decls2 = (*mdd2).decls;
                                            let ndeccls2 = (*mdd2).ndeccls;
                                            let mut fi2: i64 = 0 as i64;
                                            let mut cloned_fd2: *u8 = 0 as *u8;
                                            while fi2 < ndeccls2 {
                                                let fdn2 = *((decls2 as i64 + fi2 * (8 as i64)) as **Node);
                                                if fdn2 != (0 as *Node) {
                                                    let fdn2_kind_off = fdn2 as *i32;
                                                    let fdn2_kind = *fdn2_kind_off;
                                                    if fdn2_kind == NODE_FUNC_DECL() {
                                                        let fdn2_sym_off = (fdn2 as i64 + NODE_SIZE()) as **u8;
                                                        let fdn2_sym = *fdn2_sym_off;
                                                        if fdn2_sym == mangled2 as *u8 {
                                                            cloned_fd2 = fdn2 as *u8;
                                                            break;
                                                        }
                                                    }
                                                }
                                                fi2 = fi2 + (1 as i64);
                                            }
                                            if cloned_fd2 != (0 as *u8) {
                                                let fd2 = node_func_decl_data(cloned_fd2 as *Node);
                                                let nparams_c2 = (*fd2).nparams;
                                                let pt_buf2 = arena_alloc((*ctx).arena, nparams_c2 * (8 as i64));
                                                let mut pi_c2: i64 = 0 as i64;
                                                while pi_c2 < nparams_c2 {
                                                    let par2 = ptr_add_u8((*fd2).params, pi_c2 * (16 as i64)) as *NodeFuncDeclParam;
                                                    let pt2 = resolve_type_node(ctx, ta, (*par2).type_annot as *Node);
                                                    let pslot2 = (pt_buf2 as i64 + pi_c2 * (8 as i64)) as **Type;
                                                    *pslot2 = pt2;
                                                    // mirror check_func_decl L2302-2305: set cloned param sym's
                                                    //   type_ptr + kind=SYM_VAR, so the cloned body IDENT's sym
                                                    //   (cloned_p_sym) resolves to pt when infer_type walks the
                                                    //   body during Pass 3b → codegen sees correct type → `csgtw`
                                                    //   becomes `csgtd` for f64 etc.
                                                    let par2_sym = (*par2).sym as *Sym;
                                                    (*par2_sym).type_ptr = pt2 as *u8;
                                                    (*par2_sym).kind = SYM_VAR();
                                                    pi_c2 = pi_c2 + (1 as i64);
                                                }
                                                let mut ret2_t: *Type = 0 as *Type;
                                                if (*fd2).ret_type != (0 as *u8) {
                                                    ret2_t = resolve_type_node(ctx, ta, (*fd2).ret_type as *Node);
                                                } else {
                                                    ret2_t = type_void(ta);
                                                }
                                                let fn_type2 = type_func((*ctx).arena, pt_buf2, nparams_c2, ret2_t);
                                                (*mangled2).type_ptr = fn_type2 as *u8;
                                                (*mangled2).kind = SYM_FN();
                                                // v3.2.0d (3i fn path): walk cloned body, set every NODE_IDENT's
                                                //   type_ptr to its sym's type_ptr (now set above for params).
                                                //   This mirrors what infer_type would do for NODE_IDENT in a
                                                //   regular fn body. Without this, codegen sees IDENT.type_ptr=0
                                                //   and defaults to `w` ops (csgtw etc) — wrong for f64 / structs.
                                                let _x_body = mono_propagate_idents_to_cloned_body(
                                                    (*fd2).body as *Node);
                                            }
                                        }
                                    } else {
                                        let _x_err3 = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "E0062: cannot infer type parameter from arguments (no argument for some type parameter)" as *u8);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // len() builtin：对 slice → NODE_FIELD.synth / 对 array → NODE_INT
        if (*d).callee != (0 as *u8) {
            if (*((*d).callee as *Node)).kind == NODE_IDENT() {
                if (*d).nargs == (1 as i64) {
                    let callee_id = node_ident_data((*d).callee as *Node);
                    let fname = (*((*callee_id).sym as *Sym)).name;
                    if strcmp(fname, "len" as *u8) == (0 as i32) {
                        // 取第一个 arg：同 line 660/724 模式（*((*d).args as i64 + 0*8) as **Node）
                        let first_arg_ptr_ptr = ((*d).args as i64 + (0 as i64) * (8 as i64)) as **Node;
                        let first_arg_node = *first_arg_ptr_ptr;
                        let arg_t = infer_type(ctx, ta, first_arg_node);
                        if (*arg_t).kind == KIND_SLICE() {
                            // 改写 NODE_CALL → NODE_FIELD(s.len)：复用 n 的 memory (Node header 32B
                            // + NodeField 16B 总 48B，原 NodeCall 24B 也 fit)
                            (*n).kind = NODE_FIELD();
                            let fd = node_field_data(n);
                            (*fd).expr = first_arg_node as *u8;
                            (*fd).field = "len" as *u8;
                            let t = type_primitive(ta, PRIM_I64());
                            (*n).type_ptr = t as *u8;
                            return t;
                        }
                        if (*arg_t).kind == KIND_ARRAY() {
                            // 改写 NODE_CALL → NODE_INT(arr_count)
                            (*n).kind = NODE_INT();
                            let id = node_int_data(n);
                            (*id).value = (*arg_t).arr_count;
                            (*id).prim = PRIM_I64();
                            let t = type_primitive(ta, PRIM_I64());
                            (*n).type_ptr = t as *u8;
                            return t;
                        }
                    }
                }
            }
        }

        let callee_type = infer_type(ctx, ta, (*d).callee as *Node);
        // v3.1.1 (V3-C 3g.5): PhantomData 不允许实例化(只能作 type-level marker)
        if (*callee_type).kind == KIND_PHANTOM() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "E0050: cannot instantiate PhantomData<T> (use as type-level marker only)" as *u8);
        }
        // 推所有 arg 类型
        let mut i: i64 = 0 as i64;
        while i < (*d).nargs {
            let _x = infer_type(ctx, ta, *(((*d).args as i64 + i * (8 as i64)) as **Node));
            i = i + (1 as i64);
        }
        if (*callee_type).kind == KIND_FUNC() {
            let ret = (*callee_type).ret as *Type;
            if ret != (0 as *Type) {
                (*n).type_ptr = ret as *u8;
                return ret;
            }
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── qualified call ──
    if (*n).kind == NODE_QUALIFIED_CALL() {
        let d = node_qualified_call_data(n);
        if (*d).module == (0 as *u8) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "qualified call missing module" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        if (*((*d).module as *Node)).kind != NODE_IDENT() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "qualified call left side must be a module name" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let mod_idd = node_ident_data((*d).module as *Node);
        let mod_sym = (*mod_idd).sym as *Sym;
        if (*mod_sym).kind != SYM_MODULE() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "not a module" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let mod_name = (*mod_sym).name;

        if (*d).function == (0 as *u8) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "qualified call missing function" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        if (*((*d).function as *Node)).kind != NODE_IDENT() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "qualified call function name must be identifier" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let fn_idd = node_ident_data((*d).function as *Node);
        let fn_sym_ph = (*fn_idd).sym as *Sym;
        let fn_name = (*fn_sym_ph).name;

        // 推所有 arg 类型
        let mut ai: i64 = 0 as i64;
        while ai < (*d).nargs {
            let _x = infer_type(ctx, ta, *(((*d).args as i64 + ai * (8 as i64)) as **Node));
            ai = ai + (1 as i64);
        }

        // 搜索 global_scope 找 SYM_FN，name == fn_name 且 module == mod_name
        let mut resolved: *Sym = 0 as *Sym;
        let gscope = (*ctx).global_scope as *SymTable;
        let mut i: i64 = 0 as i64;
        while i < (*gscope).nentries {
            let entry = *(ptr_add_u8((*gscope).entries, i * (8 as i64)) as **Sym);
            if entry != (0 as *Sym) {
                if (*entry).kind == SYM_FN() {
                    if strcmp((*entry).name, fn_name) == (0 as i32) {
                        if mod_name != (0 as *u8) {
                            if (*mod_name) == (0 as i32) {  // '\0'
                                if (*entry).module == (0 as *u8) {
                                    resolved = entry;
                                    break;
                                }
                            } else {
                                if (*entry).module != (0 as *u8) {
                                    if strcmp((*entry).module, mod_name) == (0 as i32) {
                                        resolved = entry;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + (1 as i64);
        }
        if resolved == (0 as *Sym) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "module has no function" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        (*d).resolved = resolved as *u8;
        if (*resolved).type_ptr != (0 as *u8) {
            let t = (*resolved).type_ptr as *Type;
            if (*t).kind == KIND_FUNC() {
                let ret = (*t).ret as *Type;
                if ret != (0 as *Type) {
                    (*n).type_ptr = ret as *u8;
                    return ret;
                }
            }
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── field ──
    if (*n).kind == NODE_FIELD() {
        let d = node_field_data(n);
        let struct_type = infer_type(ctx, ta, (*d).expr as *Node);

        // slice synthetic .ptr / .len
        if (*struct_type).kind == KIND_SLICE() {
            if strcmp((*d).field, "ptr" as *u8) == (0 as i32) {
                let t = type_pointer((*ctx).arena, (*struct_type).elem as *Type);
                (*n).type_ptr = t as *u8;
                return t;
            }
            if strcmp((*d).field, "len" as *u8) == (0 as i32) {
                let t = type_primitive(ta, PRIM_I64());
                (*n).type_ptr = t as *u8;
                return t;
            }
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "slice has no field" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }

        // struct field
        if (*struct_type).kind == KIND_STRUCT() {
            let mut i: i64 = 0 as i64;
            while i < (*struct_type).nfields {
                // FieldDesc layout: name(*u8) + type(*u8) + offset(i64)
                let f_off = ptr_add_u8((*struct_type).fields, i * FIELD_DESC_SIZE());
                let f_name_ptr = *(f_off as **Sym);
                if f_name_ptr != (0 as *Sym) {
                    if strcmp((*f_name_ptr).name, (*d).field) == (0 as i32) {
                        let ft_ptr = *((f_off as i64 + (8 as i64)) as **Type);
                        (*n).type_ptr = ft_ptr as *u8;
                        return ft_ptr;
                    }
                }
                i = i + (1 as i64);
            }
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "struct has no field" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }

        // pointer → struct auto-deref
        if (*struct_type).kind == KIND_POINTER() {
            let elem = (*struct_type).elem as *Type;
            if (*elem).kind == KIND_STRUCT() {
                let mut i: i64 = 0 as i64;
                while i < (*elem).nfields {
                    let f_off = ptr_add_u8((*elem).fields, i * FIELD_DESC_SIZE());
                    let f_name_ptr = *(f_off as **Sym);
                    if f_name_ptr != (0 as *Sym) {
                        if strcmp((*f_name_ptr).name, (*d).field) == (0 as i32) {
                            let ft_ptr = *((f_off as i64 + (8 as i64)) as **Type);
                            (*n).type_ptr = ft_ptr as *u8;
                            return ft_ptr;
                        }
                    }
                    i = i + (1 as i64);
                }
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "struct has no field (auto-deref)" as *u8);
                let v = type_void(ta);
                (*n).type_ptr = v as *u8;
                return v;
            }
        }

        let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                "cannot access field on type" as *u8);
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── index ──
    if (*n).kind == NODE_INDEX() {
        let d = node_index_data(n);
        let arr_type = infer_type(ctx, ta, (*d).expr as *Node);
        let _x = infer_type(ctx, ta, (*d).index as *Node);
        if (*arr_type).kind == KIND_ARRAY() {
            let t = (*arr_type).elem as *Type;
            (*n).type_ptr = t as *u8;
            return t;
        }
        if (*arr_type).kind == KIND_POINTER() {
            let t = (*arr_type).elem as *Type;
            (*n).type_ptr = t as *u8;
            return t;
        }
        if (*arr_type).kind == KIND_SLICE() {
            let t = (*arr_type).elem as *Type;
            (*n).type_ptr = t as *u8;
            return t;
        }
        let _x1 = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                 "cannot index into type" as *u8);
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── array lit ──
    if (*n).kind == NODE_ARRAY_LIT() {
        let d = node_array_lit_data(n);
        let mut elem_type: *Type = 0 as *Type;
        let mut i: i64 = 0 as i64;
        while i < (*d).nelems {
            let et = infer_type(ctx, ta, *(((*d).elems as i64 + i * (8 as i64)) as **Node));
            if i == (0 as i64) {
                elem_type = et;
            } else {
                if type_eq(elem_type, et) == (0 as i32) {
                    let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "array literal elements must have same type" as *u8);
                }
            }
            i = i + (1 as i64);
        }
        if elem_type == (0 as *Type) {
            elem_type = type_void(ta);
        }
        let t = type_array((*ctx).arena, elem_type, (*d).nelems);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // ── slice lit ──
    if (*n).kind == NODE_SLICE_LIT() {
        let d = node_slice_lit_data(n);
        let arr_t = infer_type(ctx, ta, (*d).array as *Node);
        if arr_t == (0 as *Type) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "slice literal needs array" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        if (*arr_t).kind != KIND_ARRAY() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "slice literal must wrap an array literal" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let t = type_slice((*ctx).arena, (*arr_t).elem as *Type);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // ── slice range ──
    if (*n).kind == NODE_SLICE_RANGE() {
        let d = node_slice_range_data(n);
        let bt = infer_type(ctx, ta, (*d).base as *Node);
        let _x1 = infer_type(ctx, ta, (*d).start as *Node);
        let _x2 = infer_type(ctx, ta, (*d).end as *Node);
        let mut elem: *Type = 0 as *Type;
        if (*bt).kind == KIND_SLICE() {
            elem = (*bt).elem as *Type;
        } else {
            if (*bt).kind == KIND_ARRAY() {
                elem = (*bt).elem as *Type;
            } else {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "sub-range requires slice or array" as *u8);
                elem = 0 as *Type;
            }
        }
        if elem == (0 as *Type) {
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        let t = type_slice((*ctx).arena, elem);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // ── block ──
    if (*n).kind == NODE_BLOCK() {
        let d = node_block_data(n);
        let mut last_type: *Type = type_void(ta);
        let mut i: i64 = 0 as i64;
        while i < (*d).nstmts {
            last_type = infer_type(ctx, ta, *(((*d).stmts as i64 + i * (8 as i64)) as **Node));
            i = i + (1 as i64);
        }
        (*n).type_ptr = last_type as *u8;
        return last_type;
    }

    // ── if ──
    if (*n).kind == NODE_IF() {
        let d = node_if_data(n);
        let cond_type = infer_type(ctx, ta, (*d).cond as *Node);
        let bool_t = type_primitive(ta, PRIM_BOOL());
        if type_eq(cond_type, bool_t) == (0 as i32) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "if condition must be bool" as *u8);
        }
        let then_type = infer_type(ctx, ta, (*d).then_body as *Node);
        if (*d).else_body != (0 as *u8) {
            let else_type = infer_type(ctx, ta, (*d).else_body as *Node);
            if type_eq(then_type, else_type) == (0 as i32) {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "if/else branches must have same type" as *u8);
            }
            (*n).type_ptr = then_type as *u8;
            return then_type;
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── let ──
    if (*n).kind == NODE_LET() {
        let d = node_let_data(n);
        let mut decl_type: *Type = 0 as *Type;
        if (*d).type_annot != (0 as *u8) {
            decl_type = resolve_type_node(ctx, ta, (*d).type_annot as *Node);
            // v3.1.1 (V3-C 3g.5): PhantomData 不允许实例化(只能作 type-level marker)
            // 字段声明 `let _m: PhantomData<T>;`(无 init)是合法的 → 只在有 init 时报 E0050
            if (*decl_type).kind == KIND_PHANTOM() {
                if (*d).init != (0 as *u8) {
                    let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "E0050: cannot instantiate PhantomData<T> (use as type-level marker only)" as *u8);
                }
            }
        }
        // float literal coerce
        if (*d).init != (0 as *u8) {
            if (*((*d).init as *Node)).kind == NODE_FLOAT() {
                if decl_type != (0 as *Type) {
                    if (*decl_type).kind == KIND_PRIMITIVE() {
                        if (*decl_type).prim == PRIM_F32() || (*decl_type).prim == PRIM_F64() {
                            (*((*d).init as *Node)).type_ptr = decl_type as *u8;
                        }
                    }
                }
            }
        }
        // v1.7.1 patch A4: int literal coerce — `let x: u32 = 10` 不再 type mismatch.
        // 只 coerce 到 int primitive (i8/i16/i32/i64/u8/u16/u32/u64); bool/float 不 coerce.
        // 跟 src/sema.c 镜像.
        if (*d).init != (0 as *u8) {
            if (*((*d).init as *Node)).kind == NODE_INT() {
                if decl_type != (0 as *Type) {
                    if (*decl_type).kind == KIND_PRIMITIVE() {
                        let p = (*decl_type).prim;
                        if p == PRIM_I8() || p == PRIM_I16() || p == PRIM_I32() || p == PRIM_I64() ||
                           p == PRIM_U8() || p == PRIM_U16() || p == PRIM_U32() || p == PRIM_U64() {
                            (*((*d).init as *Node)).type_ptr = decl_type as *u8;
                        }
                    }
                }
            }
        }
        let mut init_type: *Type = infer_type(ctx, ta, (*d).init as *Node);
        // v1.3.1: null auto-coerces to declared pointer type; else error
        if (*d).init != (0 as *u8) {
            if (*((*d).init as *Node)).kind == NODE_NULL() {
                if decl_type != (0 as *Type) {
                    if (*decl_type).kind == KIND_POINTER() {
                        (*((*d).init as *Node)).type_ptr = decl_type as *u8;
                        init_type = decl_type;
                    } else {
                        let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                "cannot assign `null` to non-pointer type" as *u8);
                    }
                } else {
                    let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "cannot infer type of `null` (declare as *T, e.g. `let p: *u8 = null;`)" as *u8);
                }
            }
        }
        if decl_type == (0 as *Type) {
            decl_type = init_type;
        }
        if (*d).type_annot != (0 as *u8) {
            if type_eq(decl_type, init_type) == (0 as i32) {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "type mismatch in let" as *u8);
            }
        }
        let sym = (*d).sym as *Sym;
        (*sym).type_ptr = decl_type as *u8;
        (*sym).kind = SYM_VAR();
        // v3.2.1 (3j MVP): let-bound closure -> wire aux_sym to 合成 fn_sym
        //   codegen NODE_CALL 看到 SYM_VAR + KIND_FUNC + aux_sym != 0 → call $aux_sym_name
        if (*d).init != (0 as *u8) {
            let init_node = (*d).init as *Node;
            if (*init_node).kind == NODE_CLOSURE_LITERAL() {
                let init_cd = node_closure_data(init_node);
                (*sym).aux_sym = (*init_cd).fn_sym;
            }
        }
        if (*ctx).nlocals < SEMA_MAX_LOCALS() {
            sema_local_set((*ctx).locals, (*ctx).nlocals, sym, decl_type);
            (*ctx).nlocals = (*ctx).nlocals + (1 as i64);
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── const_decl (v0.7 7B; v0.9 wip commit 2.20 / Task #52 + #42 合并) ──
    //   对齐 C 端 sema.c:673-719 check_const_decl: 不强校 init type
    //   (let int 元素 vs decl [u8; 26] 元素 jhyy type_eq 会失败, 但 C 端宽松)
    //   只校验 decl type 是 KIND_ARRAY + elem 不是 pointer/slice/enum
    if (*n).kind == NODE_CONST_DECL() {
        let d = node_const_decl_data(n);
        let mut arr_t: *Type = 0 as *Type;
        if (*d).type_annot != (0 as *u8) {
            arr_t = resolve_type_node(ctx, ta, (*d).type_annot as *Node);
        }
        if arr_t == (0 as *Type) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "const decl requires array type annotation" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        if (*arr_t).kind != KIND_ARRAY() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "const declaration must be an array type [T; N]" as *u8);
        }
        let sym = (*d).sym as *Sym;
        (*sym).type_ptr = arr_t as *u8;
        (*sym).kind = SYM_CONST();
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── assign ──
    if (*n).kind == NODE_ASSIGN() {
        let d = node_assign_data(n);
        let target_type = infer_type(ctx, ta, (*d).target as *Node);
        let value_type = infer_type(ctx, ta, (*d).value as *Node);
        if type_eq(target_type, value_type) == (0 as i32) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "assignment type mismatch" as *u8);
        }
        // v0.6.5 patch: forbid rebinding immutable `let`
        if (*d).target != (0 as *u8) {
            if (*((*d).target as *Node)).kind == NODE_IDENT() {
                let idd = node_ident_data((*d).target as *Node);
                let id_sym = (*idd).sym as *Sym;
                if id_sym != (0 as *Sym) {
                    if (*id_sym).kind == SYM_VAR() {
                        if (*id_sym).is_mutable == (0 as i32) {
                            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "cannot assign to immutable variable (use let mut)" as *u8);
                        }
                    }
                }
            }
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── expr stmt ──
    if (*n).kind == NODE_EXPR_STMT() {
        let d = node_expr_stmt_data(n);
        let t = infer_type(ctx, ta, (*d).expr as *Node);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // ── return ──
    if (*n).kind == NODE_RETURN() {
        let dr = node_return_data(n);
        let mut expr_type: *Type = type_void(ta);
        if (*dr).expr != (0 as *u8) {
            // v1.3.1: null fills function's return pointer type
            if (*((*dr).expr as *Node)).kind == NODE_NULL() {
                let ret_t = (*ctx).current_ret_type as *Type;
                if ret_t != (0 as *Type) {
                    if (*ret_t).kind == KIND_POINTER() {
                        (*((*dr).expr as *Node)).type_ptr = ret_t as *u8;
                        expr_type = ret_t;
                        (*n).type_ptr = expr_type as *u8;
                    } else {
                        expr_type = infer_type(ctx, ta, (*dr).expr as *Node);
                        (*n).type_ptr = expr_type as *u8;
                    }
                } else {
                    expr_type = infer_type(ctx, ta, (*dr).expr as *Node);
                    (*n).type_ptr = expr_type as *u8;
                }
            } else {
                expr_type = infer_type(ctx, ta, (*dr).expr as *Node);
                (*n).type_ptr = expr_type as *u8;
            }
        } else {
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
        }
        // check against function return type
        let ret_t = (*ctx).current_ret_type as *Type;
        if ret_t != (0 as *Type) {
            if (*ret_t).kind != KIND_VOID() {
                if type_eq(expr_type, ret_t) == (0 as i32) {
                    let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "return type does not match function return type" as *u8);
                }
            }
        }
        return expr_type;
    }

    // ── while ──
    if (*n).kind == NODE_WHILE() {
        let d = node_while_data(n);
        let _x1 = infer_type(ctx, ta, (*d).cond as *Node);
        (*ctx).loop_depth = (*ctx).loop_depth + (1 as i32);
        let _x2 = infer_type(ctx, ta, (*d).body as *Node);
        (*ctx).loop_depth = (*ctx).loop_depth - (1 as i32);
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── for ──
    if (*n).kind == NODE_FOR() {
        let d = node_for_data(n);
        let start_type = infer_type(ctx, ta, (*d).start as *Node);
        let _x = infer_type(ctx, ta, (*d).end as *Node);
        // register loop var
        let var_sym = (*d).var as *Sym;
        (*var_sym).kind = SYM_VAR();
        (*var_sym).type_ptr = start_type as *u8;
        if (*ctx).nlocals < SEMA_MAX_LOCALS() {
            sema_local_set((*ctx).locals, (*ctx).nlocals, var_sym, start_type);
            (*ctx).nlocals = (*ctx).nlocals + (1 as i64);
        }
        (*ctx).loop_depth = (*ctx).loop_depth + (1 as i32);
        if (*d).body != (0 as *u8) {
            let _x1 = infer_type(ctx, ta, (*d).body as *Node);
        }
        (*ctx).loop_depth = (*ctx).loop_depth - (1 as i32);
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── break / continue ──
    if (*n).kind == NODE_BREAK() {
        if (*ctx).loop_depth == (0 as i32) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "'break' outside of a loop" as *u8);
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }
    if (*n).kind == NODE_CONTINUE() {
        if (*ctx).loop_depth == (0 as i32) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "'continue' outside of a loop" as *u8);
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        return v;
    }

    // ── v1.3.6: defer fncall(); — validate expr is fncall, register into fd->defers ──
    if (*n).kind == NODE_DEFER() {
        let d = node_defer_data(n);
        let expr = (*d).expr as *Node;
        if expr == (0 as *Node) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "defer requires fncall (got non-call expression)" as *u8);
        } else if (*expr).kind != NODE_CALL() && (*expr).kind != NODE_QUALIFIED_CALL() {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "defer requires fncall (got non-call expression)" as *u8);
        }
        if expr != (0 as *Node) {
            let _v = infer_type(ctx, ta, expr);
        }
        let v = type_void(ta);
        (*n).type_ptr = v as *u8;
        // collect into current fn's defer stack (sema walks in source order,
        // so fd->defers ends up declaration-ordered; codegen reverses for LIFO)
        if (*ctx).current_fn != (0 as *u8) {
            let fd = (*ctx).current_fn as *NodeFuncDecl;
            let old_n = (*fd).ndefers;
            let new_n = old_n + (1 as i64);
            let new_defers = arena_alloc((*ctx).arena, new_n * (8 as i64)) as **Node;
            if old_n > (0 as i64) {
                if (*fd).defers != (0 as *u8) {
                    memcpy(new_defers as *u8, (*fd).defers, old_n * (8 as i64));
                }
            }
            let slot = (new_defers as i64 + old_n * (8 as i64)) as **Node;
            *slot = n;
            (*fd).defers = new_defers as *u8;
            (*fd).ndefers = new_n;
        }
        return v;
    }

    // ── struct lit ──
    if (*n).kind == NODE_STRUCT_LIT() {
        let d = node_struct_lit_data(n);
        let mut st: *Type = 0 as *Type;
        if (*d).type_sym != (0 as *u8) {
            let ts = (*d).type_sym as *Sym;
            if (*ts).type_ptr != (0 as *u8) {
                let t = (*ts).type_ptr as *Type;
                // v3.1.1 (V3-C 3g.5): PhantomData 不允许实例化 — struct literal 也拦
                if (*t).kind == KIND_PHANTOM() {
                    let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                            "E0050: cannot instantiate PhantomData<T> (use as type-level marker only)" as *u8);
                }
                if (*t).kind == KIND_STRUCT() {
                    st = t;
                }
            }
        }
        if st == (0 as *Type) {
            // try global scope
            let ts = (*d).type_sym as *Sym;
            if ts != (0 as *Sym) {
                let gsym = symtab_lookup((*ctx).global_scope, (*ts).name);
                if gsym != (0 as *Sym) {
                    if (*gsym).type_ptr != (0 as *u8) {
                        let t = (*gsym).type_ptr as *Type;
                        if (*t).kind == KIND_STRUCT() {
                            st = t;
                        }
                    }
                }
            }
        }
        if st == (0 as *Type) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "unknown struct type" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        // check fields (NodeFieldInit: name(*u8) + value(*Node))
        let mut i: i64 = 0 as i64;
        while i < (*d).nfields {
            let fi = ptr_add_u8((*d).fields, i * (16 as i64)) as *NodeFieldInit;
            let fname = (*fi).name;
            let fval_type = infer_type(ctx, ta, (*fi).value as *Node);
            let mut found: i32 = 0 as i32;
            let mut j: i64 = 0 as i64;
            while j < (*st).nfields {
                let f_off = ptr_add_u8((*st).fields, j * FIELD_DESC_SIZE());
                let f_name_ptr = *(f_off as **Sym);
                if f_name_ptr != (0 as *Sym) {
                    if strcmp((*f_name_ptr).name, fname) == (0 as i32) {
                        let ft_ptr = *((f_off as i64 + (8 as i64)) as **Type);
                        if type_eq(ft_ptr, fval_type) == (0 as i32) {
                            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "field type mismatch" as *u8);
                        }
                        found = 1 as i32;
                        break;
                    }
                }
                j = j + (1 as i64);
            }
            if found == (0 as i32) {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "struct has no field" as *u8);
            }
            i = i + (1 as i64);
        }
        (*n).type_ptr = st as *u8;
        return st;
    }

    // ── enum variant ──
    if (*n).kind == NODE_ENUM_VARIANT() {
        let d = node_enum_variant_data(n);
        let mut et: *Type = 0 as *Type;
        if (*d).type_sym != (0 as *u8) {
            let ts = (*d).type_sym as *Sym;
            if (*ts).type_ptr != (0 as *u8) {
                let t = (*ts).type_ptr as *Type;
                if (*t).kind == KIND_ENUM() {
                    et = t;
                }
            }
        }
        if et == (0 as *Type) {
            let ts = (*d).type_sym as *Sym;
            if ts != (0 as *Sym) {
                let gsym = symtab_lookup((*ctx).global_scope, (*ts).name);
                if gsym != (0 as *Sym) {
                    if (*gsym).type_ptr != (0 as *u8) {
                        let t = (*gsym).type_ptr as *Type;
                        if (*t).kind == KIND_ENUM() {
                            et = t;
                        }
                    }
                }
            }
        }
        if et == (0 as *Type) {
            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                    "unknown enum type" as *u8);
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        // check payload
        if (*d).payload != (0 as *u8) {
            let payload_type = infer_type(ctx, ta, (*d).payload as *Node);
            let vsym = (*d).variant_sym as *Sym;
            let mut found: i32 = 0 as i32;
            let mut i: i64 = 0 as i64;
            while i < (*et).nvariants {
                let v_off = ptr_add_u8((*et).variants, i * VARIANT_DESC_SIZE());
                let v_name_ptr = *(v_off as **Sym);
                if var_name_eq_v1(v_name_ptr, vsym) == (0 as i32) {
                    let variant_payload = *((v_off as i64 + (8 as i64)) as **Type);
                    if variant_payload != (0 as *Type) {
                        if type_eq(variant_payload, payload_type) == (0 as i32) {
                            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "variant payload type mismatch" as *u8);
                        }
                    } else {
                        let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                "variant takes no payload" as *u8);
                    }
                    found = 1 as i32;
                    break;
                }
                i = i + (1 as i64);
            }
            if found == (0 as i32) {
                let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                        "enum has no variant" as *u8);
            }
        }
        (*n).type_ptr = et as *u8;
        return et;
    }

    // ── match (v0.7 7A) ──
    if (*n).kind == NODE_MATCH() {
        let d = node_match_data(n);
        let match_type = infer_type(ctx, ta, (*d).subject as *Node);
        let mut common_type: *Type = 0 as *Type;

        // 7A: 收集 enum variants 用于 exhaustive 检查
        let mut variants_buf: *u8 = arena_alloc((*ctx).arena, 64 as i64 * (8 as i64));
        let mut nv: i64 = 0 as i64;
        let mut has_wildcard: i32 = 0 as i32;
        let mut is_enum_match: i32 = 0 as i32;
        if match_type != (0 as *Type) {
            if (*match_type).kind == KIND_ENUM() {
                if (*match_type).name != (0 as *u8) {
                    let ename = (*((*match_type).name as *Sym)).name;
                    let got = sym_enum_variants((*ctx).global_scope, ename, variants_buf, 64 as i64);
                    nv = got as i64;
                    is_enum_match = 1 as i32;
                }
            }
        }

        let mut i: i64 = 0 as i64;
        while i < (*d).narms {
            let arm = *(((*d).arms as i64 + i * (8 as i64)) as **Node);
            let armd = node_match_arm_data(arm);
            let pat = (*armd).pattern as *Node;

            // 7A: register pattern bindings
            let _x = process_match_pattern(ctx, pat, match_type);

            // 7A: mark variant covered
            if is_enum_match == (1 as i32) {
                if nv > (0 as i64) {
                    if (*pat).kind == NODE_PATTERN_WILD() {
                        has_wildcard = 1 as i32;
                    } else {
                        if (*pat).kind == NODE_PATTERN_ENUM() {
                            let pe = node_pattern_enum_data(pat);
                            let vsym = (*pe).variant_sym as *Sym;
                            if vsym != (0 as *Sym) {
                                let vname = (*vsym).name;
                                let mut j: i64 = 0 as i64;
                                while j < nv {
                                    let slot = ptr_add_u8(variants_buf, j * (8 as i64)) as **Sym;
                                    let v_sym = *slot;
                                    if v_sym != (0 as *Sym) {
                                        if strcmp((*v_sym).name, vname) == (0 as i32) {
                                            *slot = 0 as *Sym;  // mark covered
                                            break;
                                        }
                                    }
                                    j = j + (1 as i64);
                                }
                            }
                        } else {
                            // v1.3.7: OR pattern — mark both branches' variants.
                            if (*pat).kind == NODE_PATTERN_OR() {
                                let po = node_pattern_or_data(pat);
                                let left = (*po).left as *Node;
                                if left != (0 as *Node) {
                                    if (*left).kind == NODE_PATTERN_ENUM() {
                                        let lpe = node_pattern_enum_data(left);
                                        let lvsym = (*lpe).variant_sym as *Sym;
                                        if lvsym != (0 as *Sym) {
                                            let lvname = (*lvsym).name;
                                            let mut jj: i64 = 0 as i64;
                                            while jj < nv {
                                                let slot = ptr_add_u8(variants_buf, jj * (8 as i64)) as **Sym;
                                                let v_sym = *slot;
                                                if v_sym != (0 as *Sym) {
                                                    if strcmp((*v_sym).name, lvname) == (0 as i32) {
                                                        *slot = 0 as *Sym;
                                                    }
                                                }
                                                jj = jj + (1 as i64);
                                            }
                                        }
                                    } else {
                                        if (*left).kind == NODE_PATTERN_WILD() {
                                            has_wildcard = 1 as i32;
                                        }
                                    }
                                }
                                let right = (*po).right as *Node;
                                if right != (0 as *Node) {
                                    if (*right).kind == NODE_PATTERN_ENUM() {
                                        let rpe = node_pattern_enum_data(right);
                                        let rvsym = (*rpe).variant_sym as *Sym;
                                        if rvsym != (0 as *Sym) {
                                            let rvname = (*rvsym).name;
                                            let mut jj: i64 = 0 as i64;
                                            while jj < nv {
                                                let slot = ptr_add_u8(variants_buf, jj * (8 as i64)) as **Sym;
                                                let v_sym = *slot;
                                                if v_sym != (0 as *Sym) {
                                                    if strcmp((*v_sym).name, rvname) == (0 as i32) {
                                                        *slot = 0 as *Sym;
                                                    }
                                                }
                                                jj = jj + (1 as i64);
                                            }
                                        }
                                    } else {
                                        if (*right).kind == NODE_PATTERN_WILD() {
                                            has_wildcard = 1 as i32;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            let body_type = infer_type(ctx, ta, (*armd).body as *Node);
            if i == (0 as i64) {
                common_type = body_type;
            } else {
                if type_eq(common_type, body_type) == (0 as i32) {
                    // 允许 void 与非 void 混合
                    if (*common_type).kind != KIND_VOID() {
                        if (*body_type).kind != KIND_VOID() {
                            let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                    "match arm type mismatch" as *u8);
                        }
                    }
                }
            }
            i = i + (1 as i64);
        }

        // 7A: report uncovered variants
        if is_enum_match == (1 as i32) {
            if has_wildcard == (0 as i32) {
                let mut j: i64 = 0 as i64;
                while j < nv {
                    let slot = ptr_add_u8(variants_buf, j * (8 as i64)) as **Sym;
                    let v_sym = *slot;
                    if v_sym != (0 as *Sym) {
                        let _x = sema_error_str(ctx, (*n).loc_filename, (*n).loc_line, (*n).loc_col,
                                                "non-exhaustive match: missing variant" as *u8);
                    }
                    j = j + (1 as i64);
                }
            }
        }

        let ret_t = common_type;
        if ret_t == (0 as *Type) {
            let v = type_void(ta);
            (*n).type_ptr = v as *u8;
            return v;
        }
        (*n).type_ptr = ret_t as *u8;
        return ret_t;
    }

    // v3.0.3 (3c volatile): NODE_VOLATILE_TYPE — 应在 type annotation 阶段已被
    // resolve_type_node 处理掉,但表达式路径里若出现(罕见)fallback 处理。
    if (*n).kind == NODE_VOLATILE_TYPE() {
        let vt = node_volatile_type_data(n);
        let t = resolve_type_node(ctx, ta, (*vt).inner as *Node);
        (*n).type_ptr = t as *u8;
        return t;
    }

    // default: skip for now
    let v = type_void(ta);
    (*n).type_ptr = v as *u8;
    return v;
}

// ════════════════════════════════════════════════════
// check_naked_body (v3.0.2 / 3b)
//   Defined BEFORE check_func_decl (jhyy has no forward decl).
//   Naked fn body must be a NODE_BLOCK whose every stmt is an asm!(...) call.
//   Local vars / control flow forbidden — naked is raw-asm escape hatch.
fn check_naked_body(ctx: *SemaContext, body: *Node) -> i32 {
    if body == (0 as *Node) { return 0 as i32; }
    if (*body).kind != NODE_BLOCK() {
        let _e = sema_error_str(ctx, (*body).loc_filename, (*body).loc_line, (*body).loc_col,
                                "naked function body must be a block { ... }" as *u8);
        return 0 as i32;
    }
    let bd = node_block_data(body);
    let stmts = (*bd).stmts;
    let nstmts = (*bd).nstmts;
    let mut i: i64 = 0 as i64;
    while i < nstmts {
        let elem_addr = ptr_add_u8(stmts, i * (8 as i64));
        let stmt = (*((elem_addr as i64) as **Node)) as *Node;
        let sk = (*stmt).kind;
        if sk == NODE_ASM_BLOCK() {
            // parser quirk: bare asm!() as a stmt (not wrapped in EXPR_STMT)
            i = i + (1 as i64);
            continue;
        }
        if sk == NODE_EXPR_STMT() {
            let esd = node_expr_stmt_data(stmt);
            let inner = (*esd).expr as *Node;
            if inner != (0 as *Node) {
                if (*inner).kind == NODE_ASM_BLOCK() {
                    i = i + (1 as i64);
                    continue;
                }
            }
        }
        let _e = sema_error_str(ctx, (*stmt).loc_filename, (*stmt).loc_line, (*stmt).loc_col,
                                "naked function body may only contain asm!(...) statements" as *u8);
        i = i + (1 as i64);
    }
    return 1 as i32;
}

// v3.0.4 (3e link_section): validate ELF section name. Reject empty / NUL /
// non-printable / whitespace / quote (would break `.section <name>` directive
// parser). Defined BEFORE check_func_decl — jhyy has no forward decls.
fn check_link_section_name(ctx: *SemaContext, loc_filename: *u8,
                            loc_line: i32, loc_col: i32, name: *u8) -> i32 {
    if name == (0 as *u8) { return 0 as i32; }
    let nlen = strlen(name);
    if nlen == (0 as i64) {
        let _e = sema_error_str(ctx, loc_filename, loc_line, loc_col,
                                "link_section name is empty" as *u8);
        return 0 as i32;
    }
    let mut k: i64 = 0 as i64;
    while k < nlen {
        let c = *(ptr_add_u8(name, k) as *u8) as i32;
        // printable ASCII range 0x21..0x7E (excludes space, tab, NL, CR, NUL, DEL)
        if c < (33 as i32) {
            let _e = sema_error_str(ctx, loc_filename, loc_line, loc_col,
                                    "link_section name contains non-printable byte" as *u8);
            return 0 as i32;
        }
        if c > (126 as i32) {
            let _e = sema_error_str(ctx, loc_filename, loc_line, loc_col,
                                    "link_section name contains non-ASCII byte" as *u8);
            return 0 as i32;
        }
        k = k + (1 as i64);
    }
    return 1 as i32;
}

// check_func_decl
// ════════════════════════════════════════════════════

// v3.1.0 (V3-C 3g): check_borrow — STUB for v3.1.0 ship-gate.
// Full NLL (Non-Lexical Lifetimes) / Polonius 留 v3.x 末。当前 ship-gate
// 实现 linear-scope simplification: 仅 **类型解析** `&T` / `&mut T` 正确,
// 不检测 active-borrow 冲突 (no NLL path analysis, no nested blocks)。
//
// 已知限制 (out of scope 留 v3.x 末):
//   - 不检测 `let y = &mut x; let z = &mut x;` 双 mutable 冲突
//   - 不检测 `&mut` + `&` shared/mutable 互斥
//   - 不支持 reborrow `&mut *x` 路径
//   - 不支持 lifetime 子类型 / variance
//   - 不支持 跨函数 borrow
//   - 不支持 nested block 借用作用域
//
// 完整 NLL 设计参 spec supplement v3.1.0 § 4 (v3.x 末重新设计)。
fn check_borrow(ctx: *SemaContext, ta: *TypeArena, body: *Node) -> i32 {
    return 1;
}

// v3.1.2 (V3-C 3g.7): check_cap_pass — STUB for v3.1.2 ship-gate.
// 跨函数 Cap<T> pass 完整校验(active-cap conflict / reentrancy / depth transition)
// 留 v3.x 末。当前 ship-gate 仅做类型签名层面的 Cap<T> pass-by-value 验证
// (走 qbe_type_of → QBE_L → Win x64 INTEGER class),不做语义级 cap ownership 分析。
//
// 已知限制 (out of scope 留 v3.x 末):
//   - 不检测 active-cap conflict(同一 cnode 跨函数双写)
//   - 不检测 reentrancy(同一函数重入 + cap 调用)
//   - 不检测 depth transition(Cap depth 自动递增)
//   - 不支持 `Cap<T>` 字段访问 `.cnode_idx` / `.depth` / `.rights`(per spec supplement v3.1.0 § 126)
//   - 不支持 `*Cap<T>` 裸指针类型(per parser gap,generic-on-pointer 留 v3.2.0)
//   - 不支持 `cap_new()` builtin ctor
//   - 不支持 cross-fn borrow + Cap 组合(跟 check_borrow 同样 stub)
//   - 不支持 SysV target ABI(per Windows-only 决策,v2.7.0+ 后 backport)
//
// 完整 cap pass 设计参 spec supplement v3.1.0 § 4 + v3.1.2 § 3 (v3.x 末重新设计)。
fn check_cap_pass(ctx: *SemaContext, ta: *TypeArena, body: *Node) -> i32 {
    return 1;
}

fn check_func_decl(ctx: *SemaContext, ta: *TypeArena, n: *Node) -> i32 {
    let fd = node_func_decl_data(n);

    // v3.2.0c (3i fn path): skip generic fn body — mono_expand_module 已经把
    //   substituted 实例 (ntype_params == 0) append 到 decls,它们走正常
    //   check_func_decl 路径。原始 generic def 不 check (codegen 时也 skip)。
    //   offset access (per v3.2.0b mitigation L102-104): `(*fd).ntype_params`
    //   deep nested struct deref triggers stage-0 codegen stack-spill bug.
    //   NodeFuncDecl ntype_params @ offset 88.
    let fd_off = fd as i64;
    let ntp_off = (fd_off + (88 as i64)) as *i64;
    if *ntp_off > (0 as i64) {
        return 1 as i32;
    }
    sema_push_scope(ctx);
    (*ctx).nlocals = 0 as i64;

    // 分配 param_types 数组
    let param_types = arena_alloc((*ctx).arena, (*fd).nparams * (8 as i64));

    let mut i: i64 = 0 as i64;
    while i < (*fd).nparams {
        let param = ptr_add_u8((*fd).params, i * (16 as i64)) as *NodeFuncDeclParam;
        let pt = resolve_type_node(ctx, ta, (*param).type_annot as *Node);
        // store pt into param_types[i]
        let pt_slot = ptr_add_u8(param_types, i * (8 as i64)) as **Type;
        *pt_slot = pt;

        let param_sym = (*param).sym as *Sym;
        (*param_sym).type_ptr = pt as *u8;
        (*param_sym).kind = SYM_VAR();
        let _x1 = symtab_insert((*ctx).current_scope, (*param_sym).name, SYM_VAR(),
                                pt as *u8, 0 as i32, (*ctx).scope_depth);
        // v3.0.3 (3c volatile): volatile param 是常见 MMIO callback 模式(per spec § 3
        //   examples)。允许 — 不 warn(codegen 已正确处理;warn 会污染 regress baseline)。
        i = i + (1 as i64);
    }

    // return type
    let mut ret_type: *Type = 0 as *Type;
    if (*fd).ret_type != (0 as *u8) {
        ret_type = resolve_type_node(ctx, ta, (*fd).ret_type as *Node);
    } else {
        ret_type = type_void(ta);  // will be inferred from body
    }

    // 构造 fn type
    let fn_type = type_func((*ctx).arena, param_types, (*fd).nparams, ret_type);
    let fn_sym = (*fd).sym as *Sym;
    (*fn_sym).type_ptr = fn_type as *u8;
    (*fn_sym).kind = SYM_FN();

    // check body
    if (*fd).body != (0 as *u8) {
        if (*fd).is_extern == (0 as i32) {
            (*ctx).current_ret_type = ret_type as *u8;
            (*ctx).loop_depth = 0 as i32;
            (*ctx).current_fn = fd as *u8;  // v1.3.6: NODE_DEFER case collects into fd->defers
            let body_type = infer_type(ctx, ta, (*fd).body as *Node);
            (*ctx).current_ret_type = 0 as *u8;
            (*ctx).loop_depth = 0 as i32;
            (*ctx).current_fn = 0 as *u8;
            if (*ret_type).kind != KIND_VOID() {
                if type_eq(body_type, ret_type) == (0 as i32) {
                    let _x = sema_error_str(ctx, (*((*fd).body as *Node)).loc_filename,
                                            (*((*fd).body as *Node)).loc_line, (*((*fd).body as *Node)).loc_col,
                                            "function body type does not match return type" as *u8);
                }
            }
            // void ret + non-void body：infer return type
            if (*ret_type).kind == KIND_VOID() {
                if (*body_type).kind != KIND_VOID() {
                    let new_fn_type = type_func((*ctx).arena, param_types, (*fd).nparams, body_type);
                    (*fn_sym).type_ptr = new_fn_type as *u8;
                }
            }
            // v3.0.2 (3b naked): validate that naked fn body has only asm!() expr stmts.
            // Naked fns skip QBE export + skip prologue/epilogue, so any control flow
            // or local var would break. We walk body stmts + reject non-asm.
            if (*fd).is_naked != (0 as i32) {
                let _nk = check_naked_body(ctx, (*fd).body as *Node);
            }
            // v3.0.4 (3e link_section): validate that the section name is non-empty
            // and contains only ASCII printable chars (no whitespace, no quote,
            // no NUL). The name is emitted verbatim to a `.section <name>` directive
            // in the .s side-file, so unprintable bytes would corrupt the assembler
            // input. Multiple fns per section is allowed (linker merges).
            if (*fd).link_section != (0 as *u8) {
                let _ls = check_link_section_name(ctx, (*n).loc_filename,
                                                  (*n).loc_line, (*n).loc_col,
                                                  (*fd).link_section);
            }
            // v3.1.0 (V3-C 3g): simplified NLL borrow check. Linear-scope walk
            // top-level stmts; detects `&mut x` twice (current simplification —
            // no path analysis, no reborrow, no nested blocks).
            let _bc = check_borrow(ctx, ta, (*fd).body as *Node);
        }
    }

    sema_pop_scope(ctx);
    return 1;
}

// ════════════════════════════════════════════════════
// v3.1.0 (V3-C 3g): check_borrow — STUB for v3.1.0 ship-gate
// ════════════════════════════════════════════════════
//
// (定义见 line 1955 — 必须在 check_func_decl 之前,jhyy 无 forward decls)
//
// v3.0.4 (3e link_section): validate ELF section name. Reject empty / NUL /
// non-printable / whitespace / quote (would break `.section <name>` directive
// parser). Moved BEFORE check_func_decl — see line 1808 area — jhyy has no
// forward decls.

// v3.0.2 (3b naked): validate naked fn body. Body must be a NODE_BLOCK whose
// every stmt is either:
//   - NODE_EXPR_STMT wrapping NODE_ASM_BLOCK, OR
//   - NODE_ASM_BLOCK directly (parser-level single-stmt body).
// Local vars (NODE_LET), control flow (NODE_IF, NODE_WHILE, NODE_RETURN, etc.)
// are forbidden — naked fns are pure raw-asm escape hatches per L4 inline asm.
// Reports sema errors via sema_error_str.
// (Definition moved BEFORE check_func_decl — see line 1808 area — jhyy has no
// forward decls.)

// ════════════════════════════════════════════════════
// check_module（3-pass）
// ════════════════════════════════════════════════════

fn check_module(ctx: *SemaContext, ta: *TypeArena, module: *Node) -> i32 {
    let md = node_module_data(module);

    // Pass 1: register decls into global scope
    let mut i: i64 = 0 as i64;
    while i < (*md).ndeccls {
        let decl = *(((*md).decls as i64 + i * (8 as i64)) as **Node);
        // W-005 #2 guard: skip NULL decls from corrupted inline_imports output
        if decl == (0 as *Node) { i = i + (1 as i64); } else {
        if (*decl).kind == NODE_FUNC_DECL() {
            let fd = node_func_decl_data(decl);
            let fn_sym = (*fd).sym as *Sym;
            (*fn_sym).kind = SYM_FN();
            let _x = symtab_insert_sym((*ctx).global_scope, fn_sym);
        } else {
            if (*decl).kind == NODE_TYPE_DECL() {
                let td = node_type_decl_data(decl);
                let td_sym = (*td).sym as *Sym;
                let dup = symtab_lookup((*ctx).global_scope, (*td_sym).name);
                if dup == (0 as *Sym) {
                    (*td_sym).kind = SYM_TYPE();
                    let _x = symtab_insert_sym((*ctx).global_scope, td_sym);
                }
            } else {
                // v0.9 wip commit 2.20 / Task #52 + #42 合并: NODE_CONST_DECL 跟 SYM_CONST
                //   跟 C 端 sema.c:1034-1038 check_module Pass 1 对齐
                if (*decl).kind == NODE_CONST_DECL() {
                    let cd = node_const_decl_data(decl);
                    let cd_sym = (*cd).sym as *Sym;
                    (*cd_sym).kind = SYM_CONST();
                    let _x = symtab_insert_sym((*ctx).global_scope, cd_sym);
                }
            }
        }
        i = i + (1 as i64);
        }  // close else from NULL guard
    }

    // v3.0.0 (3d no_std): if `#[no_std]` is set, require `fn main` to exist
    // (kernel/freestanding entry point). `fn main_jhyy` is NOT required (no
    // runtime bridge). User-defined `fn main` will be called from
    // `__start_kernel` in compiler/runtime/no_std_core/__start_kernel.jhyy.
    // Placed after Pass 1 so `main` is already in global scope.
    if (*md).is_no_std != (0 as i32) {
        let main_sym = symtab_lookup((*ctx).global_scope, "main" as *u8);
        if main_sym == (0 as *Sym) {
            jh_fputs_stderr("error: #[no_std] module must define `fn main()` as the entry point\n" as *u8);
            (*ctx).error_count = (*ctx).error_count + (1 as i32);
        } else {
            if (*main_sym).kind != SYM_FN() {
                jh_fputs_stderr("error: #[no_std] module's `main` must be a function\n" as *u8);
                (*ctx).error_count = (*ctx).error_count + (1 as i32);
            }
        }
    }

    // v3.2.0 (V3-C 3i generics): Pass 1.5 — monomorphize expansion.
    //   必须在 Pass 2 之前跑,这样 Pass 2 看到的 decls 已经是 cloned + substituted
    //   后的 NON-generic struct/enum(走现有 layout 路径,不用改 codegen)。
    //   - 遍历 (*md).generic_insts(parser 累积的 {base_name, mangled_name, [args]})
    //   - 对每条 inst:克隆 generic def body → substitute → append 到 (*md).decls
    //   - dedupe by mangled_name(symtab_lookup_one 已经存在 type_ptr → skip)
    //   - 错误数累加到 (*ctx).error_count,不影响 Pass 2/3 继续(便于报告所有错误)
    let mono_errs = mono_expand_module((*ctx).global_scope, (*ctx).arena, md);
    if mono_errs != (0 as i32) {
        (*ctx).error_count = (*ctx).error_count + mono_errs;
    }

    // Pass 2: resolve TYPE_DECL（struct/enum/alias）— 必须先于 Pass 3
    let mut i2: i64 = 0 as i64;
    while i2 < (*md).ndeccls {
        let decl = *(((*md).decls as i64 + i2 * (8 as i64)) as **Node);
        if decl == (0 as *Node) { i2 = i2 + (1 as i64); } else {
        if (*decl).kind == NODE_TYPE_DECL() {
            let td = node_type_decl_data(decl);
            // v3.2.0 (V3-C 3i generics): skip generic def body layout —
            //   mono_expand_module 已经把 substituted 实例 append 到 decls,
            //   它们 (ntype_params == 0) 走下面的正常 layout 路径。
            //   原始 generic def 不 layout(codegen 时 skip)。
            if (*td).ntype_params > (0 as i64) {
                i2 = i2 + (1 as i64);
            } else {
            if (*((*td).body as *Node)).kind == NODE_STRUCT_DEF() {
                let sd = node_struct_def_data((*td).body as *Node);
                let fields = arena_alloc((*ctx).arena, (*sd).nfields * FIELD_DESC_SIZE());
                let mut offset: i64 = 0 as i64;
                let mut max_align: i64 = 1 as i64;
                let mut j: i64 = 0 as i64;
                while j < (*sd).nfields {
                    let fld = ptr_add_u8((*sd).fields, j * (16 as i64)) as *StructFieldDecl;
                    let ft = resolve_type_node(ctx, ta, (*fld).type_annot as *Node);
                    let al = type_align(ft);
                    if al > max_align {
                        max_align = al;
                    }
                    // align up offset
                    offset = (offset + al - (1 as i64)) & ~((al - (1 as i64)) as i64);
                    let fld_name = (*fld).name;
                    let mut fsym = symtab_lookup((*ctx).global_scope, fld_name);
                    if fsym == (0 as *Sym) {
                        fsym = symtab_insert((*ctx).global_scope, fld_name, SYM_FIELD(),
                                            ft as *u8, 0 as i32, 0 as i32);
                    }
                    // write FieldDesc
                    let fd_off = ptr_add_u8(fields, j * FIELD_DESC_SIZE());
                    let fd_name_slot = fd_off as **Sym;
                    *fd_name_slot = fsym;
                    let fd_type_slot = (fd_off as i64 + (8 as i64)) as **Type;
                    *fd_type_slot = ft;
                    let fd_offset_slot = (fd_off as i64 + (16 as i64)) as *i64;
                    *fd_offset_slot = offset;
                    offset = offset + type_size(ft);
                    j = j + (1 as i64);
                }
                // final size alignment
                offset = (offset + max_align - (1 as i64)) & ~((max_align - (1 as i64)) as i64);

                let td_sym = (*td).sym as *Sym;
                let st = type_struct((*ctx).arena, td_sym, fields, (*sd).nfields, offset, max_align);
                (*td_sym).type_ptr = st as *u8;
                (*td_sym).kind = SYM_TYPE();
            } else {
                if (*((*td).body as *Node)).kind == NODE_ENUM_DEF() {
                    let ed = node_enum_def_data((*td).body as *Node);
                    let variants = arena_alloc((*ctx).arena, (*ed).nvariants * VARIANT_DESC_SIZE());
                    let mut max_payload_size: i64 = 0 as i64;
                    let mut max_payload_align: i64 = 1 as i64;
                    let mut j: i64 = 0 as i64;
                    while j < (*ed).nvariants {
                        let vd = ptr_add_u8((*ed).variants, j * (16 as i64)) as *EnumVariantDecl;
                        let mut pt: *Type = 0 as *Type;
                        if (*vd).payload_type != (0 as *u8) {
                            pt = resolve_type_node(ctx, ta, (*vd).payload_type as *Node);
                            let sz = type_size(pt);
                            let al = type_align(pt);
                            if sz > max_payload_size {
                                max_payload_size = sz;
                            }
                            if al > max_payload_align {
                                max_payload_align = al;
                            }
                        }
                        let vd_name = (*vd).name;
                        let mut vsym = symtab_lookup((*ctx).global_scope, vd_name);
                        if vsym == (0 as *Sym) {
                            vsym = symtab_insert((*ctx).global_scope, vd_name, SYM_VARIANT(),
                                                pt as *u8, 0 as i32, 0 as i32);
                            // 7A: 标记 variant 所属 enum 名
                            let td_sym = (*td).sym as *Sym;
                            let td_name = (*td_sym).name;
                            let td_name_len = strlen(td_name);
                            (*vsym).module = arena_strdup((*ctx).arena, td_name, td_name_len);
                        }
                        // write VariantDesc
                        let vd_off = ptr_add_u8(variants, j * VARIANT_DESC_SIZE());
                        let vd_name_slot = vd_off as **Sym;
                        *vd_name_slot = vsym;
                        let vd_payload_slot = (vd_off as i64 + (8 as i64)) as **Type;
                        *vd_payload_slot = pt;
                        let vd_tag_slot = (vd_off as i64 + (8 as i64) + (8 as i64)) as *i32;
                        *vd_tag_slot = j as i32;
                        j = j + (1 as i64);
                    }
                    let tag_size: i64 = 4 as i64;
                    let total_align = if max_payload_align > (4 as i64) { max_payload_align } else { (4 as i64) };
                    let payload_offset = (tag_size + max_payload_align - (1 as i64)) & ~((max_payload_align - (1 as i64)) as i64);
                    let mut total_size = payload_offset + max_payload_size;
                    total_size = (total_size + total_align - (1 as i64)) & ~((total_align - (1 as i64)) as i64);

                    let td_sym = (*td).sym as *Sym;
                    let et = type_enum((*ctx).arena, td_sym, variants, (*ed).nvariants,
                                      tag_size, payload_offset, max_payload_size, total_size);
                    (*td_sym).type_ptr = et as *u8;
                    (*td_sym).kind = SYM_TYPE();
                } else {
                    if (*((*td).body as *Node)).kind == NODE_IDENT() {
                        // type alias
                        let underlying = resolve_type_node(ctx, ta, (*td).body as *Node);
                        let td_sym = (*td).sym as *Sym;
                        let at = type_alias((*ctx).arena, td_sym, underlying);
                        (*td_sym).type_ptr = at as *u8;
                        (*td_sym).kind = SYM_TYPE();
                    }
                }
            }
            }  // close else from ntype_params == 0 (v3.2.0: skip generic def)
        }
        }  // close else from NULL guard
        i2 = i2 + (1 as i64);
    }

    // Pass 3: check function bodies + top-level stmts
    // v3.2.0c (3i fn path): 2-pass — cloned fns (mangled sym) checked FIRST
    //   so that the mangled SYM_FN has kind=SYM_FN + type_ptr=fn_type before
    //   any caller (e.g. main_jhyy) hits the call site in its body and looks
    //   up the mangled sym in global_scope. Without this, the lookup at
    //   L765 fails because P1.5 inserted the sym as SYM_TYPE with type_ptr=0,
    //   and check_func_decl for the cloned fn (which would upgrade it) hasn't
    //   run yet.
    // Pass 3a: cloned fns (NODE_FUNC_DECL with sym name containing '$')
    let mut i3a: i64 = 0 as i64;
    while i3a < (*md).ndeccls {
        let decl3a = *(((*md).decls as i64 + i3a * (8 as i64)) as **Node);
        if decl3a == (0 as *Node) {
            // skip
        } else {
            if (*decl3a).kind == NODE_FUNC_DECL() {
                // check if sym name contains '$' (mangled)
                let fd3a = node_func_decl_data(decl3a);
                let sym3a = (*fd3a).sym as *Sym;
                let nm3a = (*sym3a).name;
                let nlen3a = strlen(nm3a);
                let mut has_dollar: i32 = 0 as i32;
                let mut k3: i64 = 0 as i64;
                while k3 < nlen3a {
                    if *(ptr_add_u8(nm3a, k3) as *u8) == (0x24 as u8) {
                        has_dollar = 1 as i32;
                    }
                    k3 = k3 + (1 as i64);
                }
                if has_dollar != (0 as i32) {
                    let _x = check_func_decl(ctx, ta, decl3a);
                }
            }
        }
        i3a = i3a + (1 as i64);
    }

    // Pass 3b: everything else (regular fns, lets, expr stmts, const decls)
    let mut i3: i64 = 0 as i64;
    while i3 < (*md).ndeccls {
        let decl = *(((*md).decls as i64 + i3 * (8 as i64)) as **Node);
        if decl == (0 as *Node) { i3 = i3 + (1 as i64); } else {
        if (*decl).kind == NODE_FUNC_DECL() {
            // skip if already checked in Pass 3a (mangled sym)
            let fd_b = node_func_decl_data(decl);
            let sym_b = (*fd_b).sym as *Sym;
            let nm_b = (*sym_b).name;
            let nlen_b = strlen(nm_b);
            let mut has_dollar_b: i32 = 0 as i32;
            let mut kb: i64 = 0 as i64;
            while kb < nlen_b {
                if *(ptr_add_u8(nm_b, kb) as *u8) == (0x24 as u8) {
                    has_dollar_b = 1 as i32;
                }
                kb = kb + (1 as i64);
            }
            if has_dollar_b == (0 as i32) {
                let _x = check_func_decl(ctx, ta, decl);
            }
        } else {
            if (*decl).kind == NODE_TYPE_DECL() {
                // already done in Pass 2
            } else {
                if (*decl).kind == NODE_LET() || (*decl).kind == NODE_EXPR_STMT() {
                    let _x = infer_type(ctx, ta, decl);
                } else {
                    // v0.9 wip commit 2.20 / Task #52 + #42 合并: NODE_CONST_DECL
                    //   sema infer_type dispatch 设 sym.type_ptr = array type
                    if (*decl).kind == NODE_CONST_DECL() {
                        let _x = infer_type(ctx, ta, decl);
                    }
                }
            }
        }
        }  // close else from NULL guard
        i3 = i3 + (1 as i64);
    }

    return 1;
}

// ════════════════════════════════════════════════════
// sema_init / sema_check
// ════════════════════════════════════════════════════

fn sema_init(ctx: *SemaContext, arena: *Arena, ta: *TypeArena) -> i32 {
    (*ctx).arena = arena;
    (*ctx).module = 0 as *Node;
    let new_scope = symtab_new(arena, 0 as *u8);
    (*ctx).global_scope = new_scope;
    (*ctx).current_scope = new_scope;
    // locals 数组外置
    (*ctx).locals = arena_alloc(arena, SEMA_MAX_LOCALS() * SEMA_LOCAL_SIZE());
    (*ctx).nlocals = 0 as i64;
    (*ctx).scope_depth = 0 as i32;
    (*ctx).error_count = 0 as i32;
    (*ctx).current_ret_type = 0 as *u8;
    (*ctx).loop_depth = 0 as i32;
    (*ctx).current_fn = 0 as *u8;
    // init type arena（lazy init 也会触发）
    (*ta).arena = arena;
    (*ta).inited = 0 as i32;
    types_init_arena(ta);
    return 1;
}

fn sema_check(ctx: *SemaContext, ta: *TypeArena, module: *Node) -> i32 {
    (*ctx).module = module;
    (*ctx).current_scope = (*ctx).global_scope;
    check_module(ctx, ta, module);
    return (*ctx).error_count;
}