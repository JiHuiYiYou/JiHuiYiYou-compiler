// target_dispatch.jhyy — target 解析 / dispatch(CLI 层)
//
// 四个 target(CLI `--target=<name>` 的取值):
//   - amd64_win                : x86-64-w64-mingw32(默认;hosted Windows)
//   - amd64_win_freestanding   : x86-64-w64-none(UEFI;freestanding,无 libc)
//   - amd64_sysv               : x86-64-linux-none(Linux;SysV ABI)
//   - amd64_sysv_freestanding  : x86-64-linux-none-freestanding(Linux;无 libc)
//
// **能力边界(2026-11-05 写实)**:四个 target **都真出代码**(自研 in-mem 后端;
// QBE 在 v2.x 末就下线了)。但**只有 amd64_win 能被这个 build 链接**:
// link_with_gcc 链的是宿主 Windows 工具链(gcc + runtime.c + .exe 后缀)
// ⇒ 拿它链一个 SysV / freestanding 的 .s,得到的是一个**按 Win64 调用约定**
// 的 PE(实测跑起来调 libc 时段错误,exit 139),而编译器**退出码 0、零告警**。
// ⇒ 另外三个 target 必须显式 `--no-link`,拿 .s 去用匹配的工具链接。
//
// 2026-11-05:删掉五个**死函数**(target_name / target_qbe_flag /
// jh_target_count / target_status / target_abi_module)—— 它们带着一堆 v2.x
// 时代的注释(「Mirrors C-side ... .c」—— 那个 C 文件 v4.0.21 就删了;
// 「only ... passed to QBE」—— QBE 早没了),留着只会骗人。
// 真 ABI dispatch 是 **codegen.jhyy 的静态 import**(abi_amd64_win /
// abi_amd64_win_freestanding / abi_amd64_sysv / abi_amd64_sysv_freestanding)。
//
// ⚠️ 本文件现在是 target 层的**唯一实现** —— C 侧那份
// (compiler/src/target/target_dispatch.c) 已随 v4.0.21 的「删 C 编译器」删除。

extern fn strcmp(a: *u8, b: *u8) -> i32;
extern fn jh_fputs_stderr(s: *u8) -> i32;

// ════════════════════════════════════════════════════
// Target tag constants (i32; jhyy-side enum-mimic pattern from ast.jhyy:67+)
// ════════════════════════════════════════════════════

fn TARGET_AMD64_WIN()                  -> i32 { return 0 as i32; }
fn TARGET_AMD64_WIN_FREESTANDING()     -> i32 { return 1 as i32; }
fn TARGET_AMD64_SYSV()                 -> i32 { return 2 as i32; }
fn TARGET_AMD64_SYSV_FREESTANDING()    -> i32 { return 3 as i32; }

// ════════════════════════════════════════════════════
// Backend mode constants
//
// BACKEND_SELF = 自研 in-mem 后端(codegen_amd64_run_text)—— **唯一**还在的路径。
// BACKEND_QBE  = 旧 QBE 路径的常量残留:QBE 已下线,target_backend_mode 对四个
//                已知 target 一律返回 BACKEND_SELF ⇒ 这个常量只剩「未知 tag
//                的兜底」这一处引用(见 target_backend_mode)。
// ════════════════════════════════════════════════════

fn BACKEND_QBE()  -> i32 { return 0 as i32; }
fn BACKEND_SELF() -> i32 { return 1 as i32; }

// target_backend_mode — 返回 target t 用哪个后端。
// 四个已知 target 一律 BACKEND_SELF(自研后端);只有「未知 tag」才落到兜底。
fn target_backend_mode(t: i32) -> i32 {
    if t == TARGET_AMD64_WIN()              { return BACKEND_SELF(); }
    if t == TARGET_AMD64_WIN_FREESTANDING() { return BACKEND_SELF(); }
    if t == TARGET_AMD64_SYSV()             { return BACKEND_SELF(); }
    if t == TARGET_AMD64_SYSV_FREESTANDING(){ return BACKEND_SELF(); }
    return BACKEND_QBE();
}

// ════════════════════════════════════════════════════
// target_parse — CLI triple string → tag (or fatal sentinel)
// ════════════════════════════════════════════════════

fn target_parse(s: *u8) -> i32 {
    if strcmp(s, "amd64_win" as *u8) == (0 as i32) {
        return TARGET_AMD64_WIN();
    }
    if strcmp(s, "amd64_win_freestanding" as *u8) == (0 as i32) {
        return TARGET_AMD64_WIN_FREESTANDING();
    }
    if strcmp(s, "amd64_sysv" as *u8) == (0 as i32) {
        return TARGET_AMD64_SYSV();
    }
    if strcmp(s, "amd64_sysv_freestanding" as *u8) == (0 as i32) {
        return TARGET_AMD64_SYSV_FREESTANDING();
    }
    jh_fputs_stderr("unknown target '" as *u8);
    jh_fputs_stderr(s);
    jh_fputs_stderr("'\navailable: amd64_win, amd64_win_freestanding, amd64_sysv, amd64_sysv_freestanding\n" as *u8);
    jh_fputs_stderr("note: only amd64_win can be linked by this build - the others need --no-link\n" as *u8);
    return -(1 as i32);  // sentinel; caller (main_jhyy CLI loop) treats as fatal
}

// ════════════════════════════════════════════════════
// target_default — 默认 tag
// ════════════════════════════════════════════════════

fn target_default() -> i32 {
    return TARGET_AMD64_WIN();
}

// ════════════════════════════════════════════════════
// target_help — --help 的 target 列表
//
// 2026-11-05:以前这里写的是 v2.x 时代的版本标记("v2.1.0+, OVMF demo v2.3.0"
// / "v2.7.0 Phase 2b wire" / "v2.7.1 ship")—— 在 v4.1.3 的二进制里那些标记
// 对用户零信息量(v2 轴早在 v2.16.0 终结)。现在写**能力**:每个 target 是什么,
// 以及**能不能链接**。
// ════════════════════════════════════════════════════

fn target_help() -> *u8 {
    return "targets:\n  amd64_win                x86-64-w64-mingw32 (default; hosted Windows) - the only target this build can link\n  amd64_win_freestanding   x86-64-w64-none (UEFI; freestanding, no libc) - .s only (--no-link)\n  amd64_sysv               x86-64-linux-none (Linux; SysV ABI) - .s only (--no-link)\n  amd64_sysv_freestanding  x86-64-linux-none-freestanding (Linux; no libc) - .s only (--no-link)\n" as *u8;
}
