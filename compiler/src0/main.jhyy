// main.jhyy — JHYY 翻译自 compiler/src/main.c
// v1.0.0 sprint 5 commit 2, 2026-07-02
//
// 翻译要点：
//   - C main(int argc, char **argv) → jhyy main_jhyy(argc, argv)
//     runtime.c 改 main 转发 argc/argv（v0.8 commit 2）
//   - CLI dispatch（compile/build/run/dump）跟 C 版保持一致
//   - cmd_build 走 lex → parse → sema → codegen → 写 .il
//   - cmd_compile 在 build 之上加 QBE + gcc 链接（绝对路径，per v1.0.0 L1 § 134）
//   - resolve_imports (main.c:241) 暂不翻译 — 单文件能用，多文件待 commit 2b/2c
//   - path_to_win (/) 转换：jhyy 端 inline 写
//   - 已知差异：cmd_dump_v1 是 stub（commit 2c 加 ast_dump.jhyy）
//
// 本 commit 范围（v0.8 commit 2a）：
//   - main_jhyy dispatch
//   - read_file: fopen("rb") + fseek/ftell + malloc + fread
//   - cmd_build: lex → parse → sema → codegen → 写 .il
//   - cmd_compile: cmd_build + QBE + gcc link
//   - cmd_run_v1: cmd_compile + system(exe)
//   - cmd_dump_v1: stub (return 1)
//   - 暂不支持 multi-file

import ffi;
import util;

// v1 sprint W-005 workaround: jhyy_v1 inline_imports 不带 extern 声明跨文件，
// 编译器自身用的 libc 函数必须显式 extern 在 main.jhyy 顶部。
extern fn malloc(size: i64) -> *u8;
extern fn free(p: *u8) -> i32;
extern fn strlen(s: *u8) -> i64;
extern fn strcmp(a: *u8, b: *u8) -> i32;
extern fn fopen(path: *u8, mode: *u8) -> *u8;
import arena;
import ast;
import types;
import symtab;
import lexer;
import parser;
import sema;
import ir;
import codegen;

// ═══ Local externs (ffi.jhyy 已声明 malloc/free/fopen/fread/fwrite/fclose/
//    strlen/strcmp/system/jh_fputs_stderr/jh_fopen_wb 等；这里只补 main.jhyy
//    额外需要的) ═══

extern fn fseek(fp: *u8, off: i64, whence: i32) -> i32;
extern fn ftell(fp: *u8) -> i64;
extern fn strrchr(s: *u8, c: i32) -> *u8;
extern fn sprintf(buf: *u8, fmt: *u8, val: i32) -> i32;

// ═══ Constants ═══

// fseek whence: SEEK_SET=0, SEEK_CUR=1, SEEK_END=2 (POSIX/Windows)
fn SEEK_END_VAL() -> i32 { return 2 as i32; }

// QBE + gcc 绝对路径（per v1.0.0 L1 § 134 决策）
fn QBE_PATH_v1() -> *u8 { return "C:/Users/liuzhen/Desktop/coding/JiHuiYiYou/qbe/qbe.exe" as *u8; }
fn GCC_PATH_v1() -> *u8 { return "C:/msys64/ucrt64/bin/gcc.exe" as *u8; }
fn RUNTIME_C() -> *u8 { return "C:/Users/liuzhen/Desktop/coding/JiHuiYiYou/compiler/runtime/runtime.c" as *u8; }
fn HELPERS_C() -> *u8 { return "C:/Users/liuzhen/Desktop/coding/JiHuiYiYou/compiler/src0/jhyy_helpers.c" as *u8; }

// ═══ Helpers ═══

// path_to_win: / → \ 转换（Windows cmd.exe 需要）
// 注：直接 walk 直到 '\0'，不用 strlen
// W-005 workaround: let-mut + assign 触发 jhyy_v1 segfault。改用 *i64 索引累加
// （用 i64 而不是 *u8 指针比较绕开 jhyy_v1 codegen 错误 emit 指针 cmp IL）。
fn path_to_win(p_v1: *u8) -> i32 {
    let n = strlen(p_v1);
    let idx_ptr = malloc(8 as i64) as *i64;
    *idx_ptr = 0 as i64;
    while (*idx_ptr) < n {
        let c_p = (p_v1 as i64 + (*idx_ptr)) as *u8;
        let c_pi = c_p as *i32;
        if (*c_pi) == (47 as i32) {  // '/' = 47
            (*c_pi) = (92 as i32);   // '\\' = 92
        }
        *idx_ptr = (*idx_ptr) + (1 as i64);
    }
    free(idx_ptr as *u8);
    return 0 as i32;
}

// read_file: 读整个文件到 malloc'd buffer
fn read_file(path_v1: *u8) -> *u8 {
    let fp = fopen(path_v1, "rb" as *u8);
    if fp == (0 as *u8) {
        jh_fputs_stderr("cannot open file\n" as *u8);
        return 0 as *u8;
    }
    fseek(fp, 0 as i64, SEEK_END_VAL());
    let sz = ftell(fp);
    fseek(fp, 0 as i64, 0 as i32);  // SEEK_SET = 0
    let buf = malloc(sz + (1 as i64));
    if buf == (0 as *u8) {
        fclose(fp);
        return 0 as *u8;
    }
    fread(buf, 1 as i64, sz, fp);
    // null-terminate
    let last = (buf as i64 + sz) as *u8;
    let last_i_v1 = last as *i32;
    (*last_i_v1) = 0 as i32;
    fclose(fp);
    return buf;
}

// store_byte_i32: 写 i32 值到 *u8 位置（按 1 byte 存）
fn store_byte_i32(p_v2: *u8, val_v1: i32) -> i32 {
    let pi = p_v2 as *i32;
    (*pi) = val_v1;
    return 0 as i32;
}

// load_byte_i32: 读 *u8 位置到 i32
fn load_byte_i32(p_v3: *u8) -> i32 {
    let pi = p_v3 as *i32;
    return (*pi);
}

// str_concat: 拷贝 src 到 dst，返回写入字节数（不含 NUL）
fn str_copy_v1(dst_v1: *u8, src_v1: *u8) -> i64 {
    let n = strlen(src_v1);
    let mut i_v2: i64 = 0 as i64;
    while i_v2 < n {
        let s_p = (src_v1 as i64 + i_v2) as *u8;
        let d_p = (dst_v1 as i64 + i_v2) as *u8;
        let s_pi = s_p as *i32;
        let d_pi = d_p as *i32;
        (*d_pi) = (*s_pi);
        i_v2 = i_v2 + (1 as i64);
    }
    return n;
}

// str_concat_at: 把 src append 到 dst+offset_v1，返回新 offset_v1
fn str_concat_at(dst_v2: *u8, off_v1: i64, src_v2: *u8) -> i64 {
    let n = strlen(src_v2);
    let mut i_v3: i64 = 0 as i64;
    while i_v3 < n {
        let s_p = (src_v2 as i64 + i_v3) as *u8;
        let d_p = (dst_v2 as i64 + off_v1 + i_v3) as *u8;
        let s_pi = s_p as *i32;
        let d_pi = d_p as *i32;
        (*d_pi) = (*s_pi);
        i_v3 = i_v3 + (1 as i64);
    }
    return off_v1 + n;
}

// build_il_v1: 完整 lex → parse → sema → codegen → 写 .il
// 返回 0 成功，1 失败
fn build_il_v1(input: *u8, output: *u8) -> i32 {
    let source_v1 = read_file(input);
    if source_v1 == (0 as *u8) {
        return 1 as i32;
    }

    // ── Arena ──
    let mut arena: Arena = Arena {
        start: 0 as *u8,
        cur: 0 as *u8,
        end: 0 as *u8,
        blocks: 0 as *u8,
        def_size: 0 as i64,
    };
    arena_init(&arena, (16 as i64) * (1024 as i64) * (1024 as i64));

    // ── TypeArena ──
    let mut ta_v1: TypeArena = TypeArena {
        arena:  0 as *Arena,
        inited: 0 as i32,
        i8_ty:  0 as *u8, i16_ty: 0 as *u8, i32_ty: 0 as *u8, i64_ty: 0 as *u8,
        u8_ty:  0 as *u8, u16_ty: 0 as *u8, u32_ty: 0 as *u8, u64_ty: 0 as *u8,
        f32_ty: 0 as *u8, f64_ty: 0 as *u8, bool_ty: 0 as *u8, void_ty: 0 as *u8,
    };
    ta_v1.arena = &arena;
    types_init_arena(&ta_v1);

    // ── Lexer ──
    let mut lexer: Lexer = Lexer {
        source_v1:       0 as *u8,
        current:      0 as *u8,
        filename:     0 as *u8,
        line:         0 as i32,
        col:          0 as i32,
        peek_kind:    0 as i32,
        peek_start:   0 as *u8,
        peek_len:     0 as i64,
        peek_lf:      0 as *u8,
        peek_ll:      0 as i32,
        peek_lc:      0 as i32,
        has_peek:     0 as i32,
        error_count:  0 as i32,
    };
    lexer_init(&lexer, source_v1, input);

    // ── Parser ──
    let mut parser_v: Parser = Parser {
        lexer:         0 as *Lexer,
        arena:         0 as *Arena,
        prev_kind:     0 as i32,
        prev_start:    0 as *u8,
        prev_length:   0 as i64,
        prev_lf:       0 as *u8,
        prev_ll:       0 as i32,
        prev_lc:       0 as i32,
        global_scope:  0 as *u8,
        current_scope: 0 as *u8,
        scope_depth:   0 as i32,
        error_count:   0 as i32,
    };
    parser_init(&parser_v, &lexer, &arena);

    let ast_node_v1 = parser_parse(&parser_v);
    if parser_v.error_count > (0 as i32) {
        jh_fputs_stderr("parse errors\n" as *u8);
        free(source_v1);
        return 1 as i32;
    }

    // skip resolve_imports (commit 2b/2c 加)

    // ── Sema ──
    let mut sema_v1: SemaContext = SemaContext {
        arena:            0 as *Arena,
        module:           0 as *Node,
        global_scope:     0 as *u8,
        current_scope:    0 as *u8,
        locals:           0 as *u8,
        nlocals:          0 as i64,
        scope_depth:      0 as i32,
        error_count:      0 as i32,
        current_ret_type: 0 as *u8,
        loop_depth:       0 as i32,
    };
    sema_init(&sema_v1, &arena, &ta_v1);
    if sema_check(&sema_v1, &ta_v1, ast_node_v1) > (0 as i32) {
        jh_fputs_stderr("semantic errors\n" as *u8);
        free(source_v1);
        return 1 as i32;
    }

    // ── IR + Codegen ──
    let mut ir_v1: IRBuf = IRBuf {
        arena:      0 as *Arena,
        sb:         0 as *StringBuilder,
        next_tmp:   0 as i32,
        next_block: 0 as i32,
        next_data:  0 as i32,
        data_sb:    0 as *StringBuilder,
        data_used:  0 as i32,
    };
    ir_init_v1(&ir_v1, &arena);
    cg_module(&ir_v1, ast_node_v1);
    ir_flush_data(&ir_v1);

    // ── 写 <output>.il ──
    let il_path_buf_v1 = malloc(1024 as i64);
    let il_path_v1 = il_path_buf_v1;
    let n_o = strlen(output);
    str_copy_v1(il_path_v1, output);
    let ext_il_v1 = ".il" as *u8;
    let off1 = str_concat_at(il_path_v1, n_o, ext_il_v1);
    let nul1 = (il_path_v1 as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);

    let ilf = jh_fopen_wb(il_path_v1);
    if ilf == (0 as *u8) {
        jh_fputs_stderr("cannot write il\n" as *u8);
        free(source_v1);
        free(il_path_buf_v1);
        return 1 as i32;
    }
    // fwrite((*ir.sb).buf, 1, (*ir.sb).len, ilf)
    let sb_inner_v1 = ir_v1.sb;
    let buf_p = (*sb_inner_v1).buf;
    let buf_len_v1 = (*sb_inner_v1).len;
    fwrite(buf_p, (1 as i64), buf_len_v1, ilf);
    fclose(ilf);

    free(il_path_buf_v1);
    free(source_v1);
    arena_free(&arena);
    return 0 as i32;
}

// run_qbe_v1: invoke QBE on .il → .s
// W-005 workaround: 用 *pos_ptr_v1 deref 累加替代 let mut pos_v1 (let-mut + assign
// 触发 jhyy_v1 codegen segfault)。`pos_ptr_v1` 走 NODE_DEREF 路径，绕 NODE_ASSIGN[NODE_IDENT] 触发面。
fn run_qbe_v1(il_path_v1: *u8, asm_path_v1: *u8) -> i32 {
    let cmd_buf_v1 = malloc(4096 as i64);
    let pos_ptr_v1 = malloc(8 as i64) as *i64;
    *pos_ptr_v1 = 0 as i64;
    let qbe = QBE_PATH_v1();
    *pos_ptr_v1 = str_concat_at(cmd_buf_v1, *pos_ptr_v1, qbe);
    let sep1 = " -t amd64_win -o " as *u8;
    *pos_ptr_v1 = str_concat_at(cmd_buf_v1, *pos_ptr_v1, sep1);
    *pos_ptr_v1 = str_concat_at(cmd_buf_v1, *pos_ptr_v1, asm_path_v1);
    let sep2 = " " as *u8;
    *pos_ptr_v1 = str_concat_at(cmd_buf_v1, *pos_ptr_v1, sep2);
    *pos_ptr_v1 = str_concat_at(cmd_buf_v1, *pos_ptr_v1, il_path_v1);
    let nul_p = (cmd_buf_v1 as i64 + *pos_ptr_v1) as *u8;
    store_byte_i32(nul_p, 0 as i32);
    free(pos_ptr_v1 as *u8);

    path_to_win(il_path_v1);
    path_to_win(asm_path_v1);
    let r = system(cmd_buf_v1);
    free(cmd_buf_v1);
    if r != (0 as i32) {
        jh_fputs_stderr("QBE failed\n" as *u8);
        return 1 as i32;
    }
    return 0 as i32;
}

// link_with_gcc: gcc ASM_PATH RUNTIME_C HELPERS_C -o EXE_PATH -lm
// W-005 workaround: 同 run_qbe_v1，用 *pos_ptr_v2 替代 let mut pos_v2
fn link_with_gcc(asm_path_v1: *u8, exe_path_v1: *u8) -> i32 {
    let cmd_buf_v1 = malloc(4096 as i64);
    let pos_ptr_v2 = malloc(8 as i64) as *i64;
    *pos_ptr_v2 = 0 as i64;
    let gcc = GCC_PATH_v1();
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, gcc);
    let sp = " " as *u8;
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, sp);
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, asm_path_v1);
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, sp);
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, RUNTIME_C());
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, sp);
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, HELPERS_C());
    let oflag = " -o " as *u8;
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, oflag);
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, exe_path_v1);
    let lmflag_v1 = " -lm" as *u8;
    *pos_ptr_v2 = str_concat_at(cmd_buf_v1, *pos_ptr_v2, lmflag_v1);
    let nul_p = (cmd_buf_v1 as i64 + *pos_ptr_v2) as *u8;
    store_byte_i32(nul_p, 0 as i32);
    free(pos_ptr_v2 as *u8);

    path_to_win(exe_path_v1);
    let r = system(cmd_buf_v1);
    free(cmd_buf_v1);
    if r != (0 as i32) {
        jh_fputs_stderr("gcc link failed\n" as *u8);
        return 1 as i32;
    }
    return 0 as i32;
}

// derive_output_name: input "path/foo.jhyy" → "path/foo" (strip .jhyy)
fn derive_output_name(input: *u8, out_buf_v1: *u8) -> i32 {
    let n = strlen(input);
    str_copy_v1(out_buf_v1, input);
    let nul = (out_buf_v1 as i64 + n) as *u8;
    store_byte_i32(nul, 0 as i32);
    let dot = strrchr(out_buf_v1, (46 as i32));  // '.' = 46
    if dot != (0 as *u8) {
        let _sd = store_byte_i32(dot, 0 as i32);
    }
    return 0 as i32;
}

// cmd_build: lex → parse → sema → codegen → 写 .il
fn cmd_build(argc_v1: i32, argv_v1: *u8) -> i32 {
    if argc_v1 < (1 as i32) {
        jh_fputs_stderr("usage: jhyy build <file.jhyy> [-o output]\n" as *u8);
        return 1 as i32;
    }
    // argv is *u8 → first arg is at *(argv as **u8)
    let argv_arr_v1 = argv_v1 as **u8;
    let input = (*argv_arr_v1);
    let out_buf_v1 = malloc(1024 as i64);
    derive_output_name(input, out_buf_v1);
    let r = build_il_v1(input, out_buf_v1);
    free(out_buf_v1);
    return r;
}

// cmd_compile: build + QBE + gcc。支持 `-o <output>` flag（v0.8 commit 4 补；
// regress_v1.py 传 `-o` 写 regress 结果，但 v0.8 commit 2 翻译时漏了 -o 解析
// → regress_v1.py NORUN=7）
fn cmd_compile(argc_v2: i32, argv_v2: *u8) -> i32 {
    if argc_v2 < (1 as i32) {
        jh_fputs_stderr("usage: jhyy compile <file.jhyy> [-o output]\n" as *u8);
        return 1 as i32;
    }

    /* parse argv: 找 -o flag + 第一个非 - 开头的文件。jhyy 端 argv 是 *u8
     * （实质 **u8 cast），每个元素 8 字节。避免 bug 9 (&&/|| phi) 用 nested if。
     * W-005 workaround: let-mut + assign 触发 jhyy_v1 segfault。改用 *i32 指针
     * 解引用累加，绕开 NODE_ASSIGN[NODE_IDENT] 触发面。 */
    let input_ptr_v1 = malloc(8 as i64) as **u8;
    *input_ptr_v1 = 0 as *u8;
    let user_out_ptr_v1 = malloc(8 as i64) as **u8;
    *user_out_ptr_v1 = 0 as *u8;
    let i_v4_ptr = malloc(4 as i64) as *i32;
    *i_v4_ptr = 0 as i32;
    while (*i_v4_ptr) < argc_v2 {
        let i64_i = (*i_v4_ptr) as i64;
        let arg_p = ptr_add_u8(argv_v2, i64_i * (8 as i64)) as **u8;
        let arg = (*arg_p);
        if strcmp(arg, "-o" as *u8) == (0 as i32) {
            let next_i_v1 = (*i_v4_ptr) + (1 as i32);
            if next_i_v1 < argc_v2 {
                let next_i64_v1 = next_i_v1 as i64;
                let out_p = ptr_add_u8(argv_v2, next_i64_v1 * (8 as i64)) as **u8;
                *user_out_ptr_v1 = (*out_p);
                *i_v4_ptr = next_i_v1;
            }
        } else {
            if *input_ptr_v1 == (0 as *u8) {
                *input_ptr_v1 = arg;
            }
        }
        *i_v4_ptr = (*i_v4_ptr) + (1 as i32);
    }
    let input = *input_ptr_v1;
    let user_out = *user_out_ptr_v1;

    if input == (0 as *u8) {
        jh_fputs_stderr("compile: no input file\n" as *u8);
        return 1 as i32;
    }

    /* 默认从 input 派生 output 名（去 .jhyy 后缀） */
    let derived_v1 = malloc(1024 as i64);
    derive_output_name(input, derived_v1);
    let mut out_buf_v1: *u8 = derived_v1;
    if user_out != (0 as *u8) {
        // W-005 workaround: let-mut 走 if-else 显式分支，避免直接 `out_buf_v1 = user_out` 触发 segfault
        if derived_v1 != (0 as *u8) { free(derived_v1); }
        out_buf_v1 = user_out;
    }
    // 1. build .il
    if build_il_v1(input, out_buf_v1) != (0 as i32) {
        if derived_v1 != (0 as *u8) { free(derived_v1); }
        return 1 as i32;
    }
    // 2. .il → .s
    let il_path_v1 = malloc(1024 as i64);
    let asm_path_v1 = malloc(1024 as i64);
    let exe_path_v1 = malloc(1024 as i64);
    let n_o = strlen(out_buf_v1);
    str_copy_v1(il_path_v1, out_buf_v1);
    let off1 = str_concat_at(il_path_v1, n_o, ".il" as *u8);
    let nul1 = (il_path_v1 as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);
    str_copy_v1(asm_path_v1, out_buf_v1);
    let off2 = str_concat_at(asm_path_v1, n_o, ".s" as *u8);
    let nul2 = (asm_path_v1 as i64 + off2) as *u8;
    store_byte_i32(nul2, 0 as i32);
    str_copy_v1(exe_path_v1, out_buf_v1);
    let off3 = str_concat_at(exe_path_v1, n_o, ".exe" as *u8);
    let nul3 = (exe_path_v1 as i64 + off3) as *u8;
    store_byte_i32(nul3, 0 as i32);

    let r1 = run_qbe_v1(il_path_v1, asm_path_v1);
    if r1 != (0 as i32) {
        if derived_v1 != (0 as *u8) { free(derived_v1); }
        free(il_path_v1); free(asm_path_v1); free(exe_path_v1);
        return 1 as i32;
    }
    let r2 = link_with_gcc(asm_path_v1, exe_path_v1);
    if derived_v1 != (0 as *u8) { free(derived_v1); }
    free(il_path_v1); free(asm_path_v1); free(exe_path_v1);
    if r2 != (0 as i32) {
        return 1 as i32;
    }
    return 0 as i32;
}

// cmd_run_v1: cmd_compile + system(exe)
fn cmd_run_v1(argc_v3: i32, argv_v3: *u8) -> i32 {
    if argc_v3 < (1 as i32) {
        jh_fputs_stderr("usage: jhyy run <file.jhyy>\n" as *u8);
        return 1 as i32;
    }
    let argv_arr_v1 = argv_v3 as **u8;
    let input = (*argv_arr_v1);

    // tmp output: "input" minus ext + "_run"
    let out_buf_v1 = malloc(1024 as i64);
    str_copy_v1(out_buf_v1, input);
    let dot = strrchr(out_buf_v1, (46 as i32));
    if dot != (0 as *u8) {
        let _sdr = store_byte_i32(dot, 0 as i32);
    }
    let nl = strlen(out_buf_v1);
    let off1 = str_concat_at(out_buf_v1, nl, "_run" as *u8);
    let nul1 = (out_buf_v1 as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);

    // build argv for cmd_compile: {input}
    let arg_arr_v1 = malloc(8 as i64);
    let arg_arr_pp = arg_arr_v1 as **u8;
    (*arg_arr_pp) = input;

    let r = cmd_compile(1 as i32, arg_arr_v1);
    free(arg_arr_v1);
    if r != (0 as i32) {
        free(out_buf_v1);
        return r;
    }
    // system("out.exe")
    let exe_path_v1 = malloc(1024 as i64);
    let no = strlen(out_buf_v1);
    str_copy_v1(exe_path_v1, out_buf_v1);
    let off2 = str_concat_at(exe_path_v1, no, ".exe" as *u8);
    let nul2 = (exe_path_v1 as i64 + off2) as *u8;
    store_byte_i32(nul2, 0 as i32);
    path_to_win(exe_path_v1);
    let rc = system(exe_path_v1);
    free(exe_path_v1);
    free(out_buf_v1);
    return rc;
}

// cmd_dump_v1: stub for now
fn cmd_dump_v1(argc_v4: i32, argv_v4: *u8) -> i32 {
    jh_fputs_stderr("cmd_dump_v1 not yet implemented (sprint 5 commit 2c)\n" as *u8);
    return 1 as i32;
}

// ═══ Entry point ═══

fn main_jhyy(argc_v5: i32, argv_v5: *u8) -> i32 {
    if argc_v5 < (2 as i32) {
        printf("jhyy compiler v0.8 (self-hosted)\n" as *u8, 0);
        printf("usage: jhyy <command> [args]\n" as *u8, 0);
        printf("  compile <file.jhyy> [-o output]\n" as *u8, 0);
        printf("  build   <file.jhyy> [-o output]\n" as *u8, 0);
        printf("  run     <file.jhyy>\n" as *u8, 0);
        printf("  dump    <file.jhyy>\n" as *u8, 0);
        return 0 as i32;
    }
    // argv is *u8 (passed from C runtime). Each element is *u8, 8 bytes.
    // argv[0] = program path, argv[1] = command, argv[2...] = args
    let argv_arr_v1 = argv_v5 as **u8;
    let cmd_p = (argv_v5 as i64 + (8 as i64)) as *u8;
    let cmd_arr_v1 = cmd_p as **u8;
    let cmd = (*cmd_arr_v1);
    let rest_argc = argc_v5 - (2 as i32);
    let rest_argv_p = (argv_v5 as i64 + (16 as i64)) as *u8;
    let rest_argv = rest_argv_p;

    if strcmp(cmd, "compile" as *u8) == (0 as i32) {
        return cmd_compile(rest_argc, rest_argv);
    }
    if strcmp(cmd, "build" as *u8) == (0 as i32) {
        return cmd_build(rest_argc, rest_argv);
    }
    if strcmp(cmd, "run" as *u8) == (0 as i32) {
        return cmd_run_v1(rest_argc, rest_argv);
    }
    if strcmp(cmd, "dump" as *u8) == (0 as i32) {
        return cmd_dump_v1(rest_argc, rest_argv);
    }
    jh_fputs_stderr("unknown command\n" as *u8);
    return 1 as i32;
}