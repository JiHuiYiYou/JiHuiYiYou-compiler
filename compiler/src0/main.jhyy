// main.jhyy — JHYY 翻译自 compiler/src/main.c
// v1.0.0 sprint 5 commit 2, 2026-07-02
//
// 翻译要点：
//   - C main(int argc, char **argv) → jhyy main_jhyy(argc, argv)
//     runtime.c 改 main 转发 argc/argv（v0.8 commit 2）
//   - CLI dispatch（compile/build/run/dump）跟 C 版保持一致
//   - cmd_build 走 lex → parse → sema → codegen → 写 .il
//   - cmd_compile 在 build 之上加 QBE + gcc 链接（绝对路径，per v1.0.0 L1 § 134）
//   - resolve_imports (main.c:241) 暂不翻译 — 单文件能用，多文件待 commit 2b/2c
//   - path_to_win (/) 转换：jhyy 端 inline 写
//   - 已知差异：cmd_dump 是 stub（commit 2c 加 ast_dump.jhyy）
//
// 本 commit 范围（v0.8 commit 2a）：
//   - main_jhyy dispatch
//   - read_file: fopen("rb") + fseek/ftell + malloc + fread
//   - cmd_build: lex → parse → sema → codegen → 写 .il
//   - cmd_compile: cmd_build + QBE + gcc link
//   - cmd_run: cmd_compile + system(exe)
//   - cmd_dump: stub (return 1)
//   - 暂不支持 multi-file

import ffi;
import util;

// v1 sprint W-005 workaround: jhyy_v1 inline_imports 不带 extern 声明跨文件，
// 编译器自身用的 libc 函数必须显式 extern 在 main.jhyy 顶部。
extern fn malloc(size: i64) -> *u8;
extern fn free(p: *u8) -> i32;
extern fn strlen(s: *u8) -> i64;
extern fn strcmp(a: *u8, b: *u8) -> i32;
extern fn fopen(path: *u8, mode: *u8) -> *u8;
import arena;
import ast;
import types;
import symtab;
import lexer;
import parser;
import sema;
import ir;
import codegen;

// ═══ Local externs (ffi.jhyy 已声明 malloc/free/fopen/fread/fwrite/fclose/
//    strlen/strcmp/system/jh_fputs_stderr/jh_fopen_wb 等；这里只补 main.jhyy
//    额外需要的) ═══

extern fn fseek(fp: *u8, off: i64, whence: i32) -> i32;
extern fn ftell(fp: *u8) -> i64;
extern fn strrchr(s: *u8, c: i32) -> *u8;
extern fn sprintf(buf: *u8, fmt: *u8, val: i32) -> i32;
extern fn fread(buf: *u8, size: i64, count: i64, fp: *u8) -> i64;
extern fn fwrite(buf: *u8, size: i64, count: i64, fp: *u8) -> i64;
extern fn fclose(fp: *u8) -> i32;
extern fn system(cmd: *u8) -> i32;
extern fn jh_fputs_stderr(s: *u8) -> i32;
extern fn memset(p: *u8, c: i32, n: i64) -> *u8;

// ═══ Constants ═══

// fseek whence: SEEK_SET=0, SEEK_CUR=1, SEEK_END=2 (POSIX/Windows)
fn SEEK_END_VAL() -> i32 { return 2 as i32; }

// v1.4.1: 路径硬编码消除 — 委托 jhyy_helpers.c (C runtime)
//   jhyy 端 codegen 不实现真正的顶层 let mut global (compile-time 0 constant fold),
//   所以路径状态放在 C runtime: jh_paths_init() 一次, jh_path_*() 多次读
extern fn jh_paths_init(argv0: *u8) -> i32;
extern fn jh_path_qbe() -> *u8;
extern fn jh_path_gcc() -> *u8;
extern fn jh_path_runtime() -> *u8;
extern fn jh_path_helpers() -> *u8;
// v1.5.6: A 派 Driver 探测 — link_with_gcc 改用 jh_gcc_invoke (resolved gcc 路径
// + 引号包裹, 替代裸 system("gcc ...") 拼 cmd_buf). 4 层优先级: JHY_GCC env →
// env.txt → MSYS2 magic → SearchPathA → fallback "gcc".
extern fn jh_gcc_invoke(out_buf: *u8, out_size: i32, args: *u8) -> i32;
// v1.5.6 W-034: convert relative path → absolute (cmd.exe /C searches PATH only)
extern fn jh_fullpath(out_buf: *u8, rel_path: *u8, max_len: i32) -> i32;
// v1.5.6 W-038: bypass cmd.exe /C, use CreateProcessA (handles paths with spaces)
extern fn jh_run(cmd_line: *u8) -> i32;
// v1.5.6 W-045: capture child stderr/stdout from jh_run (pipe-based)
extern fn jh_run_get_output() -> *u8;
// v1.5.6 W-048: temp ASCII path + copy + rename 绕开 mingw CRT 中文 argv 编码歧义
extern fn jh_mktemp_ascii(tag: *u8, out: *u8, out_cap: i32) -> i32;
extern fn jh_file_copy(src: *u8, dst: *u8) -> i32;
extern fn jh_rename_file(src: *u8, dst: *u8) -> i32;
extern fn jh_unlink_file(path: *u8) -> i32;

fn QBE_PATH() -> *u8 { return jh_path_qbe(); }
fn GCC_PATH() -> *u8 { return jh_path_gcc(); }
fn RUNTIME_C() -> *u8 { return jh_path_runtime(); }
fn HELPERS_C() -> *u8 { return jh_path_helpers(); }

// ═══ Helpers ═══

// path_to_win: / → \ 转换（Windows cmd.exe 需要）
// 注：直接 walk 直到 '\0'，不用 strlen
fn path_to_win(p: *u8) -> i32 {
    let n = strlen(p);
    let mut idx: i64 = 0 as i64;
    while idx < n {
        let c_p = (p as i64 + idx) as *u8;
        let c_pi = c_p as *i32;
        if (*c_pi) == (47 as i32) {  // '/' = 47
            (*c_pi) = (92 as i32);   // '\\' = 92
        }
        idx = idx + (1 as i64);
    }
    return 0 as i32;
}

// read_file: 读整个文件到 malloc'd buffer
fn read_file(path: *u8) -> *u8 {
    let fp = fopen(path, "rb" as *u8);
    if fp == (0 as *u8) {
        jh_fputs_stderr("cannot open file\n" as *u8);
        return 0 as *u8;
    }
    fseek(fp, 0 as i64, SEEK_END_VAL());
    let sz = ftell(fp);
    fseek(fp, 0 as i64, 0 as i32);  // SEEK_SET = 0
    // alloc sz+4 (not sz+1): 下面 (*last_i)=0 是 *i32 写 (4字节), 在 sz+1 边界写 4 字节
    // 会 overflow heap。改成 sz+4 让边界 4 字节內可写。v0.9 wip commit 2.9 修。
    let buf = malloc(sz + (4 as i64));
    if buf == (0 as *u8) {
        fclose(fp);
        return 0 as *u8;
    }
    fread(buf, 1 as i64, sz, fp);
    // null-terminate: 4字节 store 覆盖 buf+sz..buf+sz+3
    let last = (buf as i64 + sz) as *u8;
    let last_i = last as *i32;
    (*last_i) = 0 as i32;
    fclose(fp);
    return buf;
}

// store_byte_i32: 写 i32 值到 *u8 位置（按 1 byte 存）
fn store_byte_i32(p: *u8, val: i32) -> i32 {
    let pi = p as *i32;
    (*pi) = val;
    return 0 as i32;
}

// load_byte_i32: 读 *u8 位置到 i32
fn load_byte_i32(p: *u8) -> i32 {
    let pi = p as *i32;
    return (*pi);
}

// str_concat: 拷贝 src 到 dst，返回写入字节数（不含 NUL）
fn str_copy(dst: *u8, src: *u8) -> i64 {
    let n = strlen(src);
    let mut i: i64 = 0 as i64;
    while i < n {
        let s_p = (src as i64 + i) as *u8;
        let d_p = (dst as i64 + i) as *u8;
        let s_pi = s_p as *i32;
        let d_pi = d_p as *i32;
        (*d_pi) = (*s_pi);
        i = i + (1 as i64);
    }
    return n;
}

// str_concat_at: 把 src append 到 dst+offset，返回新 offset
fn str_concat_at(dst: *u8, off: i64, src: *u8) -> i64 {
    let n = strlen(src);
    let mut i: i64 = 0 as i64;
    while i < n {
        let s_p = (src as i64 + i) as *u8;
        let d_p = (dst as i64 + off + i) as *u8;
        let s_pi = s_p as *i32;
        let d_pi = d_p as *i32;
        (*d_pi) = (*s_pi);
        i = i + (1 as i64);
    }
    return off + n;
}

// ════════════════════════════════════════════════════
// inline_imports: 翻译 v0 resolve_imports (main.c:241) + resolve_one_import
//   (main.c:101) → jhyy 版 AST-level merge。
//   - 跟 v0 行为对齐: 保留 sym.module namespace 标签 + decls 顺序 (imported 在前)
//   - 递归解析 transitive imports + cycle detection (in_progress / completed)
//   - heap-allocated cycle arrays (64 × 512 bytes = 32KB, 避免 stack overflow)
//   - extra_paths / extra_names: v0 CLI multi-file 支持, jhyy_v1 不暴露
//     (regress.py 单文件路径, 不需要)
// ════════════════════════════════════════════════════

// in_progress_match: 检查 path 是否在 in_progress 数组里 (cycle detection)
fn in_progress_match(in_progress: *u8, nin_progress: i64, path: *u8) -> i32 {
    let mut k: i64 = 0 as i64;
    while k < nin_progress {
        let slot = (in_progress as i64 + k * (512 as i64)) as **u8;
        if strcmp((*slot), path) == (0 as i32) {
            return 1 as i32;
        }
        k = k + (1 as i64);
    }
    return 0 as i32;
}

// completed_match: 检查 path 是否在 completed 数组里 (skip if done)
fn completed_match(completed: *u8, ncompleted: i64, path: *u8) -> i32 {
    let mut k: i64 = 0 as i64;
    while k < ncompleted {
        let slot = (completed as i64 + k * (512 as i64)) as **u8;
        if strcmp((*slot), path) == (0 as i32) {
            return 1 as i32;
        }
        k = k + (1 as i64);
    }
    return 0 as i32;
}

// dir_from_path: 从文件路径提取 dir（最后一个 '/' 或 '\\' 切）
//   写回 dir_buf (caller 提供 ≥512 字节)
//   返回 0 = OK, 1 = 无 separator (用 "." 代替)
fn dir_from_path(path: *u8, dir_buf: *u8) -> i32 {
    let n = strlen(path);
    let mut last_sep_off: i64 = -(1 as i64);
    let mut idx: i64 = 0 as i64;
    while idx < n {
        // 读单字节 (cast to *u8 deref to i32 = single byte 0-255 due to type width)
        // Actually: *u8 deref gives u8, cast to i32
        let ch_p = (path as i64 + idx) as *u8;
        let ch_byte = (*ch_p);
        let ch = ch_byte as i32;
        if ch == (47 as i32) || ch == (92 as i32) {  // '/' or '\\'
            last_sep_off = idx;
        }
        idx = idx + (1 as i64);
    }
    if last_sep_off < (0 as i64) {
        // 无 separator, 用 "." 代替
        store_byte_i32(dir_buf, (46 as i32));  // '.'
        store_byte_i32((dir_buf as i64 + (1 as i64)) as *u8, 0 as i32);
        return 1 as i32;
    }
    let mut j: i64 = 0 as i64;
    while j < last_sep_off {
        let s_p = (path as i64 + j) as *u8;
        let d_p = (dir_buf as i64 + j) as *u8;
        let s_pi = s_p as *i32;
        let d_pi = d_p as *i32;
        (*d_pi) = (*s_pi);
        j = j + (1 as i64);
    }
    let nul_p = (dir_buf as i64 + last_sep_off) as *u8;
    store_byte_i32(nul_p, 0 as i32);
    return 0 as i32;
}

// resolve_one_import_v1: 翻译 v0 main.c:101 resolve_one_import
//   读 mod_path 文件 → parse → 递归处理 nested imports
//   → 对每个非-import decl, 设 sym.module = mod_name 后 append 到 out_decls
//   returns: 0 = OK, 1 = error
fn resolve_one_import_v1(mod_path: *u8, mod_name: *u8, arena: *Arena,
                          out_decls: **u8, out_count: *i64, out_cap: *i64,
                          in_progress: *u8, nin_progress: *i64,
                          completed: *u8, ncompleted: *i64,
                          main_loc_filename: *u8) -> i32 {
    // already processed? skip
    if completed_match(completed, (*ncompleted), mod_path) != (0 as i32) {
        return 0 as i32;
    }
    // cycle?
    if in_progress_match(in_progress, (*nin_progress), mod_path) != (0 as i32) {
        jh_fputs_stderr("error: circular import '" as *u8);
        jh_fputs_stderr(mod_path);
        jh_fputs_stderr("'\n" as *u8);
        return 1 as i32;
    }

    // read mod_path
    let mod_source = read_file(mod_path);
    if mod_source == (0 as *u8) {
        jh_fputs_stderr("error: cannot open import '" as *u8);
        jh_fputs_stderr(mod_path);
        jh_fputs_stderr("'\n" as *u8);
        return 1 as i32;
    }

    // Sprint 4.10: heap Lexer/Parser avoids struct-literal codegen crash
    let ml_buf = malloc(128 as i64); memset(ml_buf, 0 as i32, 128 as i64);
    let mod_lexer = ml_buf as *Lexer;
    let mp_buf = malloc(128 as i64); memset(mp_buf, 0 as i32, 128 as i64);
    let mod_parser = mp_buf as *Parser;
    lexer_init(mod_lexer, mod_source, mod_path);
    parser_init(mod_parser, mod_lexer, arena);
    let mod_ast = parser_parse(mod_parser);

    if (*mod_parser).error_count > (0 as i32) {
        jh_fputs_stderr("parse errors in import '" as *u8);
        jh_fputs_stderr(mod_path); jh_fputs_stderr("'
" as *u8);
        free(mod_source); free(ml_buf); free(mp_buf);
        return 1 as i32;
    }
    // Sprint 4.12: decl processing with transitive import
    let mut errors_ti: i32 = 0 as i32;
    let imd = node_module_data(mod_ast);

    // Sprint 4.24: push mod_path to in_progress BEFORE recursion (cycle detection)
    // mirror C-side main.c:159-161
    // Slot layout: first 8 bytes = *u8 pointer to a separate heap path buf,
    // next 504 bytes unused. Path buf lives forever (heap leak, like mod_path).
    if (*nin_progress) < (64 as i64) {
        let ip_path_buf = malloc(512 as i64);
        let mut ip_off: i64 = 0 as i64;
        ip_off = str_concat_at(ip_path_buf as *u8, ip_off, mod_path);
        let ip_nul = (ip_path_buf as i64 + ip_off) as *u8;
        store_byte_i32(ip_nul, 0 as i32);
        // Write the *u8 pointer at slot offset (slot is interpreted as **u8)
        let ip_slot_pp = (in_progress as i64 + (*nin_progress) * (512 as i64)) as **u8;
        (*ip_slot_pp) = ip_path_buf as *u8;
        (*nin_progress) = (*nin_progress) + (1 as i64);
    }

    let mut j: i64 = 0 as i64;
    while j < (*imd).ndeccls {
        let idecl = *(((*imd).decls as i64 + j * (8 as i64)) as **Node);
        if (*idecl).kind == NODE_IMPORT_DECL() {
            // transitive import: nested_name = *(sym as **u8) (name is at offset 0 of Sym)
            let iid = node_import_decl_data(idecl);
            let nested_name = *((*iid).sym as **u8);
            let dir_buf = malloc(512 as i64);
            dir_from_path(mod_path, dir_buf);
            let npath = malloc(1024 as i64);
            let mut off_n: i64 = 0 as i64;
            off_n = str_concat_at(npath, off_n, dir_buf);
            off_n = str_concat_at(npath, off_n, "/" as *u8);
            off_n = str_concat_at(npath, off_n, nested_name);
            off_n = str_concat_at(npath, off_n, ".jhyy" as *u8);
            let nul_np = (npath as i64 + off_n) as *u8;
            store_byte_i32(nul_np, 0 as i32);
            let rv1_err = resolve_one_import_v1(npath, nested_name, arena,
                                                 out_decls, out_count, out_cap,
                                                 in_progress, nin_progress,
                                                 completed, ncompleted,
                                                 mod_path);
            errors_ti = errors_ti + rv1_err;
            let _f1 = free(npath); let _f2 = free(dir_buf);
        } else {
            if idecl == (0 as *Node) { j = j + (1 as i64); } else {
            let mut owner_sym_raw: *u8 = 0 as *u8;
            if (*idecl).kind == NODE_FUNC_DECL() { owner_sym_raw = (*node_func_decl_data(idecl)).sym; }
            if owner_sym_raw != (0 as *u8) { (*(owner_sym_raw as *Sym)).module = mod_name; }
            if (*out_count) >= (*out_cap) {
                let mut nc: i64 = (*out_cap) * (2 as i64); if nc < (8 as i64) { nc = 8 as i64; }
                let nb = arena_alloc(arena, nc * (8 as i64));
                let mut ci: i64 = 0 as i64;
                // W-005 #2 guard: (*out_count) may be corrupted → cap copy loop
                let mut max_copy = (*out_cap); if (*out_count) < max_copy { max_copy = (*out_count); }
                while ci < max_copy { *((nb as i64 + ci*(8 as i64)) as **u8) = *(((*out_decls) as i64 + ci*(8 as i64)) as **u8); ci = ci + (1 as i64); }
                (*out_decls) = nb; (*out_cap) = nc;
            }
            if (*out_count) < (*out_cap) {
                *(((*out_decls) as i64 + (*out_count)*(8 as i64)) as **Node) = idecl;
                (*out_count) = (*out_count) + (1 as i64);
            }
            }  // close else from NULL guard
        }
        j = j + (1 as i64);
    }

    // Sprint 4.24: pop mod_path from in_progress, push to completed (dedup)
    // mirror C-side main.c:215-229
    let mut ip_k: i64 = 0 as i64;
    let mut ip_found: i32 = 0 as i32;
    while ip_k < (*nin_progress) {
        let ip_slot = (in_progress as i64 + ip_k * (512 as i64)) as **u8;
        if strcmp((*ip_slot), mod_path) == (0 as i32) {
            // shift remaining down (preserve order, match C-side semantics)
            let mut ip_m: i64 = ip_k;
            while ip_m < (*nin_progress) - (1 as i64) {
                let src_slot = (in_progress as i64 + (ip_m + (1 as i64)) * (512 as i64)) as **u8;
                let dst_slot = (in_progress as i64 + ip_m * (512 as i64)) as **u8;
                (*dst_slot) = (*src_slot);
                ip_m = ip_m + (1 as i64);
            }
            (*nin_progress) = (*nin_progress) - (1 as i64);
            ip_found = 1 as i32;
        }
        ip_k = ip_k + (1 as i64);
    }
    // push to completed (cap 64, match C-side)
    // Same layout as in_progress push above.
    if (*ncompleted) < (64 as i64) {
        let cp_path_buf = malloc(512 as i64);
        let mut cp_off: i64 = 0 as i64;
        cp_off = str_concat_at(cp_path_buf as *u8, cp_off, mod_path);
        let cp_nul = (cp_path_buf as i64 + cp_off) as *u8;
        store_byte_i32(cp_nul, 0 as i32);
        let cp_slot_pp = (completed as i64 + (*ncompleted) * (512 as i64)) as **u8;
        (*cp_slot_pp) = cp_path_buf as *u8;
        (*ncompleted) = (*ncompleted) + (1 as i64);
    }

    free(mod_source); free(ml_buf); free(mp_buf);
    return errors_ti;
}

// inline_imports: 翻译 v0 main.c:241 resolve_imports
//   处理 main_path 的 module decls → 拆 import decls + main decls
//   → recursive resolve_one_import_v1 → 拼成 merged decls
//   replaces module.decls / ndeccls in-place
fn inline_imports(module: *Node, main_path: *u8, arena: *Arena) -> i32 {
    let md = node_module_data(module);

    // count initial imports
    let mut nimports: i64 = 0 as i64;
    let mut i_cnt: i64 = 0 as i64;
    while i_cnt < (*md).ndeccls {
        let d = *(((*md).decls as i64 + i_cnt * (8 as i64)) as **Node);
        if (*d).kind == NODE_IMPORT_DECL() {
            nimports = nimports + (1 as i64);
        }
        i_cnt = i_cnt + (1 as i64);
    }
    if nimports == (0 as i64) {
        return 0 as i32;  // 无 import = no-op
    }

    // extract main dir
    let main_dir_buf = malloc(512 as i64);
    let _ignore = dir_from_path(main_path, main_dir_buf);

    // allocate in_progress + completed (heap, 64 × 512 = 32KB each, avoid stack overflow)
    let in_progress = malloc(64 as i64 * (512 as i64));
    let completed = malloc(64 as i64 * (512 as i64));
    let mut nin_progress: i64 = 0 as i64;
    let mut ncompleted: i64 = 0 as i64;

    // extract main module's non-import decls
    let main_decls = arena_alloc(arena, (*md).ndeccls * (8 as i64));
    let mut nmain: i64 = 0 as i64;
    let mut ii: i64 = 0 as i64;
    while ii < (*md).ndeccls {
        let decl = *(((*md).decls as i64 + ii * (8 as i64)) as **Node);
        if (*decl).kind != NODE_IMPORT_DECL() {
            let slot = (main_decls as i64 + nmain * (8 as i64)) as **Node;
            (*slot) = decl;
            nmain = nmain + (1 as i64);
        }
        ii = ii + (1 as i64);
    }

    // merged decls: imported first, main decls after
    let new_cap: i64 = 65536 as i64;
    let new_decls = arena_alloc(arena, new_cap * (8 as i64));
    let mut new_count: i64 = 0 as i64;

    // resolve each import
    let mut errors: i32 = 0 as i32;
    let mut iii: i64 = 0 as i64;
    while iii < (*md).ndeccls {
        let decl = *(((*md).decls as i64 + iii * (8 as i64)) as **Node);
        if (*decl).kind != NODE_IMPORT_DECL() {
            iii = iii + (1 as i64);
            // (continue-like: skip)
        } else {
            let id = node_import_decl_data(decl);
            // (*id).sym is *Sym; need .name (offset 0)
            let id_sym_p = (*id).sym as *Sym;
            let mod_name_str = (*id_sym_p).name;
            // mod_path = main_dir/mod_name.jhyy
            let mod_path_buf = malloc(1024 as i64);
            let mut off_m: i64 = 0 as i64;
            off_m = str_concat_at(mod_path_buf, off_m, main_dir_buf);
            let slash_m = "/" as *u8;
            off_m = str_concat_at(mod_path_buf, off_m, slash_m);
            off_m = str_concat_at(mod_path_buf, off_m, mod_name_str);
            let ext_m = ".jhyy" as *u8;
            off_m = str_concat_at(mod_path_buf, off_m, ext_m);
            let nul_mp = (mod_path_buf as i64 + off_m) as *u8;
            store_byte_i32(nul_mp, 0 as i32);
            errors = errors + resolve_one_import_v1(mod_path_buf, mod_name_str, arena,
                                                     (&new_decls as **u8), &new_count, &new_cap,
                                                     in_progress, &nin_progress,
                                                     completed, &ncompleted,
                                                     main_path);
            // don't free mod_path_buf — AST nodes ref it for loc_filename
            iii = iii + (1 as i64);
        }
    }

    if errors > (0 as i32) {
        free(in_progress);
        free(completed);
        free(main_dir_buf);
        return errors;
    }

    // append main module's non-import decls after imported
    let mut im: i64 = 0 as i64;
    while im < nmain && new_count < new_cap {
        let slot_app = (new_decls as i64 + new_count * (8 as i64)) as **Node;
        (*slot_app) = *((main_decls as i64 + im * (8 as i64)) as **Node);
        new_count = new_count + (1 as i64);
        im = im + (1 as i64);
    }

    // mutate module.decls / ndeccls
    (*md).decls = new_decls;
    (*md).ndeccls = new_count;

    free(in_progress);
    free(completed);
    free(main_dir_buf);
    return 0 as i32;
}

// build_il: 完整 lex → parse → sema → codegen → 写 .il
// 返回 0 成功，1 失败
fn build_il(input: *u8, output: *u8) -> i32 {
    let source = read_file(input);
    if source == (0 as *u8) {
        return 1 as i32;
    }

    // ── Arena ──
    let mut arena: Arena = Arena {
        start: 0 as *u8,
        cur: 0 as *u8,
        end: 0 as *u8,
        blocks: 0 as *u8,
        def_size: 0 as i64,
    };
    arena_init(&arena, (32 as i64) * (1024 as i64) * (1024 as i64));

    // ── TypeArena ──
    let mut ta: TypeArena = TypeArena {
        arena:  0 as *Arena,
        inited: 0 as i32,
        i8_ty:  0 as *u8, i16_ty: 0 as *u8, i32_ty: 0 as *u8, i64_ty: 0 as *u8,
        u8_ty:  0 as *u8, u16_ty: 0 as *u8, u32_ty: 0 as *u8, u64_ty: 0 as *u8,
        f32_ty: 0 as *u8, f64_ty: 0 as *u8, bool_ty: 0 as *u8, void_ty: 0 as *u8,
    };
    ta.arena = &arena;
    types_init_arena(&ta);

    // ── Lexer ──
    let mut lexer: Lexer = Lexer {
        source:       0 as *u8,
        current:      0 as *u8,
        filename:     0 as *u8,
        line:         0 as i32,
        col:          0 as i32,
        peek_kind:    0 as i32,
        peek_start:   0 as *u8,
        peek_len:     0 as i64,
        peek_lf:      0 as *u8,
        peek_ll:      0 as i32,
        peek_lc:      0 as i32,
        has_peek:     0 as i32,
        error_count:  0 as i32,
    };
    lexer_init(&lexer, source, input);

    // ── Parser ──
    let mut parser_v: Parser = Parser {
        lexer:         0 as *Lexer,
        arena:         0 as *Arena,
        prev_kind:     0 as i32,
        prev_start:    0 as *u8,
        prev_length:   0 as i64,
        prev_lf:       0 as *u8,
        prev_ll:       0 as i32,
        prev_lc:       0 as i32,
        global_scope:  0 as *u8,
        current_scope: 0 as *u8,
        scope_depth:   0 as i32,
        error_count:   0 as i32,
    };
    parser_init(&parser_v, &lexer, &arena);

    let ast_node = parser_parse(&parser_v);
    if parser_v.error_count > (0 as i32) {
        jh_fputs_stderr("parse errors\n" as *u8);
        free(source);
        return 1 as i32;
    }

    // ── Inline imports ──
    jh_fputs_stderr("[1] imports start\n" as *u8);
    let imp_err = inline_imports(ast_node, input, &arena);
    jh_fputs_stderr("[2] imports done\n" as *u8);
    if imp_err > (0 as i32) {
        jh_fputs_stderr("import resolution failed\n" as *u8);
        free(source);
        return 1 as i32;
    }

    // ── Sema ──
    jh_fputs_stderr("[3] sema start\n" as *u8);
    let mut sema: SemaContext = SemaContext {
        arena:            0 as *Arena,
        module:           0 as *Node,
        global_scope:     0 as *u8,
        current_scope:    0 as *u8,
        locals:           0 as *u8,
        nlocals:          0 as i64,
        scope_depth:      0 as i32,
        error_count:      0 as i32,
        current_ret_type: 0 as *u8,
        loop_depth:       0 as i32,
    };
    sema_init(&sema, &arena, &ta);
    if sema_check(&sema, &ta, ast_node) > (0 as i32) {
        jh_fputs_stderr("semantic errors\n" as *u8);
        free(source);
        return 1 as i32;
    }

    // ── IR + Codegen ──
    jh_fputs_stderr("[4] post-sema\n" as *u8);
    // W-005 #2 workaround: malloc IRBuf avoids both stack overflow and arena exhaustion
    let ir = malloc(128 as i64) as *IRBuf;
    ir_init(ir, &arena);
    jh_fputs_stderr("[4a] ir_init done\n" as *u8);
    cg_module(ir, ast_node);
    jh_fputs_stderr("[4b] cg_module done\n" as *u8);
    ir_flush_data(ir);
    jh_fputs_stderr("[4] codegen done\n" as *u8);

    // ── 写 <output>.il ──
    let il_path_buf = malloc(1024 as i64);
    let il_path = il_path_buf;
    let n_o = strlen(output);
    str_copy(il_path, output);
    let ext_il = ".il" as *u8;
    let off1 = str_concat_at(il_path, n_o, ext_il);
    let nul1 = (il_path as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);

    let ilf = jh_fopen_wb(il_path);
    if ilf == (0 as *u8) {
        jh_fputs_stderr("cannot write il\n" as *u8);
        free(source);
        free(il_path_buf);
        return 1 as i32;
    }
    // fwrite((*ir.sb).buf, 1, (*ir.sb).len, ilf)
    let sb_inner = (*ir).sb;
    let buf_p = (*sb_inner).buf;
    let buf_len = (*sb_inner).len;
    fwrite(buf_p, (1 as i64), buf_len, ilf);
    fclose(ilf);

    free(il_path_buf);
    free(source);
    arena_free(&arena);
    return 0 as i32;
}

// run_qbe: invoke QBE on .il → .s
fn run_qbe(il_path: *u8, asm_path: *u8) -> i32 {
    let cmd_buf = malloc(16384 as i64);
    let mut pos: i64 = 0 as i64;
    let qbe = QBE_PATH();
    // v1.5.6 W-039: wrap QBE_PATH in quotes so CreateProcessA treats the
    // full path (e.g. "C:\Program Files\JHYY\bin\qbe.exe") as the module
    // name. Without quotes, Windows tokenizes at first whitespace and
    // launches C:\Program instead of qbe.exe if that file exists.
    let lquote = "\"" as *u8;
    pos = str_concat_at(cmd_buf, pos, lquote);
    pos = str_concat_at(cmd_buf, pos, qbe);
    let rquote = "\"" as *u8;
    pos = str_concat_at(cmd_buf, pos, rquote);
    let sep1 = " -t amd64_win -o " as *u8;
    pos = str_concat_at(cmd_buf, pos, sep1);
    pos = str_concat_at(cmd_buf, pos, asm_path);
    let sep2 = " " as *u8;
    pos = str_concat_at(cmd_buf, pos, sep2);
    pos = str_concat_at(cmd_buf, pos, il_path);
    let nul_p = (cmd_buf as i64 + pos) as *u8;
    store_byte_i32(nul_p, 0 as i32);

    path_to_win(il_path);
    path_to_win(asm_path);
    // v1.5.6 W-038: use jh_run (CreateProcessA) instead of system() so that
    // qbe paths with spaces (e.g. "C:\Program Files\JHYY\bin\qbe.exe") are
    // handled correctly. cmd.exe /C tokenizes by whitespace and breaks on
    // space; CreateProcessA's command-line parser preserves quoted paths.
    // v1.5.6 W-039: run_qbe wraps QBE_PATH in quotes (above) — jh_run passes
    // the cmd_line through unchanged.
    let r = jh_run(cmd_buf);
    if r != (0 as i32) {
        // debug: print the actual command on failure so users can see which
        // qbe path jh_paths_init resolved. cmd_buf is freed below.
        jh_fputs_stderr("QBE failed: " as *u8);
        jh_fputs_stderr(cmd_buf as *u8);
        jh_fputs_stderr("\n" as *u8);
        free(cmd_buf);
        return 1 as i32;
    }
    free(cmd_buf);
    return 0 as i32;
}

// link_with_gcc: jh_gcc_invoke(ASM_PATH RUNTIME_C HELPERS_C -o EXE_PATH -lm)
//   v1.5.6: 替代裸 system("gcc ...") 拼 cmd_buf. jh_gcc_invoke 内部调
//   jh_gcc_path() 拿 resolved gcc 路径 + 引号包裹, 写 cmd_buf 头部;
//   cmd_buf 后续段 (args + -o EXE -lm) 由 caller 拼. 全 cmd 仍传 system().
fn link_with_gcc(asm_path: *u8, exe_path: *u8) -> i32 {
    // v1.5.6 W-048: temp ASCII path 绕开 mingw CRT 中文 argv 编码歧义.
    // src0 jhyy 是 UTF-8 源; path 字面量是 UTF-8 bytes. MSYS2 mingw-w64 CRT
    // _initargv 拿到 Unicode cmdline 后再用 CP_ACP 转 ANSI argv — PowerShell
    // cmdline parser 已把 UTF-8 bytes 当 GB2312 解错 → mojibake ANSI argv →
    // gcc 找不到文件 → silent exit. 改 cmd_buf 用 ASCII temp path 绕开。
    let temp_asm = malloc(1024 as i64);
    let temp_exe = malloc(1024 as i64);
    let _t1 = jh_mktemp_ascii("a" as *u8, temp_asm, 1024 as i32);
    let _t2 = jh_mktemp_ascii("e" as *u8, temp_exe, 1024 as i32);
    if _t1 != (0 as i32) || _t2 != (0 as i32) {
        jh_fputs_stderr("W-048: cannot create temp path\n" as *u8);
        free(temp_asm); free(temp_exe); return 1 as i32;
    }
    // jh_mktemp_ascii 输出 "...Temp\\jha<8hex>.tmp" / "jhe<8hex>.tmp".
    // gcc 需要 .s / .exe 后缀 — 把末尾 ".tmp" (固定 4 字节) overwrite 为新 suffix,
    // 然后 nul-terminate. W-048 fix: 之前用 `tmplen - suflen` 错算成 `tmplen - 2`,
    // 导致 .tmp 变成 ".t.s" → gcc 找不到文件.
    let suffix_s = ".s" as *u8;
    let tmplen_a = strlen(temp_asm);
    let suflen_s = strlen(suffix_s) as i64;
    let src_off_a = tmplen_a - (4 as i64);   // ".tmp" = 4 字节, 从这位置开始 overwrite
    let dst_p_a = (temp_asm as i64 + src_off_a) as *u8;
    let mut k: i64 = 0 as i64;
    while k < suflen_s {
        let sp = (suffix_s as i64 + k) as *i32;
        let dp = (dst_p_a as i64 + k) as *i32;
        (*dp) = (*sp);
        k = k + (1 as i64);
    }
    // nul-terminate after new suffix (".s" 短于 ".tmp", 后面 2 字节需清零)
    let nul_at_a = (temp_asm as i64 + src_off_a + suflen_s) as *u8;
    store_byte_i32(nul_at_a, 0 as i32);

    let suffix_e = ".exe" as *u8;
    let tmplen_e = strlen(temp_exe);
    let suflen_e = strlen(suffix_e) as i64;
    let src_off_e = tmplen_e - (4 as i64);   // ".tmp" = 4 字节
    let dst_p_e = (temp_exe as i64 + src_off_e) as *u8;
    k = 0 as i64;
    while k < suflen_e {
        let sp = (suffix_e as i64 + k) as *i32;
        let dp = (dst_p_e as i64 + k) as *i32;
        (*dp) = (*sp);
        k = k + (1 as i64);
    }
    // nul-terminate (".exe" 同长于 ".tmp", 写在最后刚好)
    let nul_at_e = (temp_exe as i64 + src_off_e + suflen_e) as *u8;
    store_byte_i32(nul_at_e, 0 as i32);
    // Copy 原 Chinese asm → temp_asm (ASCII)
    let _cp = jh_file_copy(asm_path, temp_asm);
    if _cp != (0 as i32) {
        jh_fputs_stderr("W-048: copy asm failed\n" as *u8);
        jh_unlink_file(temp_asm);
        free(temp_asm); free(temp_exe); return 1 as i32;
    }

    // v1.5.6 W-040: wrap each path arg in quotes so gcc's argv parser
    // treats the full path as one token. RUNTIME_C() and HELPERS_C() resolve
    // to "<INSTALLDIR>\bin\runtime.c" / "<INSTALLDIR>\bin\jhyy_helpers.c"
    // which contain spaces under installer layout ("C:\Program Files\...").
    // Without quotes, gcc tokenizes "C:\Program Files\...\runtime.c" into
    // "C:\Program" + "Files\...\runtime.c" and cc1.exe fails with
    // "Files\JHYY\bin\runtime.c: No such file or directory". asm_path and
    // exe_path may also contain spaces when the user's cwd or -o output path
    // has spaces, so quote all of them.
    // v1.5.6 W-048: asm_path / exe_path 用 temp ASCII path (避免 mingw argv 编码 bug)
    let lq = "\"" as *u8;
    let rq = "\"" as *u8;
    let cmd_buf = malloc(16384 as i64);
    let mut pos: i64 = 0 as i64;
    let sp = " " as *u8;
    pos = str_concat_at(cmd_buf, pos, lq);
    pos = str_concat_at(cmd_buf, pos, temp_asm);    // W-048: ASCII
    pos = str_concat_at(cmd_buf, pos, rq);
    pos = str_concat_at(cmd_buf, pos, sp);
    pos = str_concat_at(cmd_buf, pos, lq);
    pos = str_concat_at(cmd_buf, pos, RUNTIME_C());
    pos = str_concat_at(cmd_buf, pos, rq);
    pos = str_concat_at(cmd_buf, pos, sp);
    pos = str_concat_at(cmd_buf, pos, lq);
    pos = str_concat_at(cmd_buf, pos, HELPERS_C());
    pos = str_concat_at(cmd_buf, pos, rq);
    let oflag = " -o " as *u8;
    pos = str_concat_at(cmd_buf, pos, oflag);
    pos = str_concat_at(cmd_buf, pos, lq);
    pos = str_concat_at(cmd_buf, pos, temp_exe);    // W-048: ASCII
    pos = str_concat_at(cmd_buf, pos, rq);
    let lmflag = " -lm" as *u8;
    pos = str_concat_at(cmd_buf, pos, lmflag);
    let nul_p = (cmd_buf as i64 + pos) as *u8;
    store_byte_i32(nul_p, 0 as i32);

    path_to_win(exe_path);  // 保留:exe_path 用于最终 rename dst
    // v1.5.6: jh_gcc_invoke 把 "RESOLVED_GCC_PATH" + space + cmd_buf 写到 invoke_buf;
    // gcc 路径有空格 (e.g. "C:\Program Files\...") 也安全.
    // v1.5.6 W-038: 用 jh_run (CreateProcessA) 替代 system(), 绕过 cmd.exe /C 的
    // 多重 quote 处理 bug. CreateProcessA 的 cmd-line parser 正确处理 quoted path.
    // v1.5.6 W-040: path args 在 cmd_buf 已经 quote 包裹, gcc 看到 quoted argv.
    // v1.5.6 W-048: cmd_buf 用 ASCII temp path,mingw CRT 不再 misdecode.
    let invoke_buf = malloc(16384 as i64);
    let args_start = cmd_buf;
    let _wrote = jh_gcc_invoke(invoke_buf, 16384 as i32, args_start);
    path_to_win(exe_path);
    let r = jh_run(invoke_buf);
    let captured = jh_run_get_output();
    if r != (0 as i32) {
        // v1.5.6 W-042: mirror run_qbe pattern (:684-686) — print actual gcc
        // cmd_buf so user can distinguish CreateProcessA fail (gcc not
        // found, return -1) from gcc exit != 0 (link error). See
        // docs/internal/workarounds.md § W-042.
        jh_fputs_stderr("gcc link failed: " as *u8);
        jh_fputs_stderr(invoke_buf as *u8);
        jh_fputs_stderr("\n" as *u8);
        // v1.5.6 W-045: also print captured child stderr so the actual gcc
        // error message is visible. Without this, gcc errors bypass the
        // parent's stderr (cmd.exe /c '2>&1' only redirects cmd.exe's own
        // stderr, not the child's) and the user sees "gcc link failed" with
        // no explanation. See docs/internal/workarounds.md § W-045.
        if captured != (0 as *u8) {
            let c0 = (*captured);
            if c0 != (0 as i32) {
                jh_fputs_stderr("gcc stderr:\n" as *u8);
                jh_fputs_stderr(captured);
                jh_fputs_stderr("\n" as *u8);
            }
        }
        free(invoke_buf);
        free(cmd_buf);
        jh_unlink_file(temp_asm);  // W-048 cleanup
        free(temp_asm); free(temp_exe);
        return 1 as i32;
    }
    // W-048: 链接成功 — rename temp_exe → 原 Chinese exe_path
    let _mv = jh_rename_file(temp_exe, exe_path);
    if _mv != (0 as i32) {
        jh_fputs_stderr("W-048: rename temp exe failed (kept at " as *u8);
        jh_fputs_stderr(temp_exe);
        jh_fputs_stderr(")\n" as *u8);
        free(invoke_buf);
        free(cmd_buf);
        jh_unlink_file(temp_asm);
        free(temp_asm); free(temp_exe);
        return 1 as i32;
    }
    free(invoke_buf);
    free(cmd_buf);
    jh_unlink_file(temp_asm);  // temp asm 清理 (.s 留在原 Chinese 路径给用户调试)
    free(temp_asm); free(temp_exe);
    return 0 as i32;
}

// derive_output_name: input "path/foo.jhyy" → "path/foo" (strip .jhyy)
fn derive_output_name(input: *u8, out_buf: *u8) -> i32 {
    let n = strlen(input);
    str_copy(out_buf, input);
    let nul = (out_buf as i64 + n) as *u8;
    store_byte_i32(nul, 0 as i32);
    let dot = strrchr(out_buf, (46 as i32));  // '.' = 46
    if dot != (0 as *u8) {
        let _sd = store_byte_i32(dot, 0 as i32);
    }
    return 0 as i32;
}

// cmd_build: lex → parse → sema → codegen → 写 .il
fn cmd_build(argc: i32, argv: *u8) -> i32 {
    if argc < (1 as i32) {
        jh_fputs_stderr("usage: jhyy build <file.jhyy> [-o output]\n" as *u8);
        return 1 as i32;
    }
    // argv is *u8 → first arg is at *(argv as **u8)
    let argv_arr = argv as **u8;
    let input = (*argv_arr);
    let out_buf = malloc(1024 as i64);
    derive_output_name(input, out_buf);
    let r = build_il(input, out_buf);
    free(out_buf);
    return r;
}

// cmd_compile: build + QBE + gcc。支持 `-o <output>` flag（v0.8 commit 4 补；
// regress_v1.py 传 `-o` 写 regress 结果，但 v0.8 commit 2 翻译时漏了 -o 解析
// → regress_v1.py NORUN=7）
fn cmd_compile(argc: i32, argv: *u8) -> i32 {
    if argc < (1 as i32) {
        jh_fputs_stderr("usage: jhyy compile <file.jhyy> [-o output]\n" as *u8);
        return 1 as i32;
    }

    /* parse argv: 找 -o flag + 第一个非 - 开头的文件。jhyy 端 argv 是 *u8
     * （实质 **u8 cast），每个元素 8 字节。避免 bug 9 (&&/|| phi) 用 nested if。 */
    let mut input: *u8 = 0 as *u8;
    let mut user_out: *u8 = 0 as *u8;
    let mut i: i32 = 0 as i32;
    while i < argc {
        let i64_i = i as i64;
        let arg_p = ptr_add_u8(argv, i64_i * (8 as i64)) as **u8;
        let arg = (*arg_p);
        if strcmp(arg, "-o" as *u8) == (0 as i32) {
            let next_i = i + (1 as i32);
            if next_i < argc {
                let next_i64 = next_i as i64;
                let out_p = ptr_add_u8(argv, next_i64 * (8 as i64)) as **u8;
                user_out = (*out_p);
                i = next_i;
            }
        } else {
            if input == (0 as *u8) {
                input = arg;
            }
        }
        i = i + (1 as i32);
    }
    let input_path = input;
    let user_out_path = user_out;

    if input == (0 as *u8) {
        jh_fputs_stderr("compile: no input file\n" as *u8);
        return 1 as i32;
    }

    /* 默认从 input 派生 output 名（去 .jhyy 后缀） */
    let derived = malloc(1024 as i64);
    derive_output_name(input, derived);
    let mut out_buf: *u8 = derived;
    if user_out != (0 as *u8) {
        free(derived);
        out_buf = user_out;
    }
    // 1. build .il
    if build_il(input, out_buf) != (0 as i32) {
        if user_out == (0 as *u8) { free(derived); }  // Sprint 4.5 B Task #145 fix: avoid double-free when user_out was set
        return 1 as i32;
    }
    // 2. .il → .s
    let il_path = malloc(1024 as i64);
    let asm_path = malloc(1024 as i64);
    let exe_path = malloc(1024 as i64);
    let n_o = strlen(out_buf);
    str_copy(il_path, out_buf);
    let off1 = str_concat_at(il_path, n_o, ".il" as *u8);
    let nul1 = (il_path as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);
    str_copy(asm_path, out_buf);
    let off2 = str_concat_at(asm_path, n_o, ".s" as *u8);
    let nul2 = (asm_path as i64 + off2) as *u8;
    store_byte_i32(nul2, 0 as i32);
    str_copy(exe_path, out_buf);
    let off3 = str_concat_at(exe_path, n_o, ".exe" as *u8);
    let nul3 = (exe_path as i64 + off3) as *u8;
    store_byte_i32(nul3, 0 as i32);

    let r1 = run_qbe(il_path, asm_path);
    if r1 != (0 as i32) {
        if user_out == (0 as *u8) { free(derived); }
        free(il_path); free(asm_path); free(exe_path);
        return 1 as i32;
    }
    let r2 = link_with_gcc(asm_path, exe_path);
    if user_out == (0 as *u8) { free(derived); }
    free(il_path); free(asm_path); free(exe_path);
    if r2 != (0 as i32) {
        return 1 as i32;
    }
    return 0 as i32;
}

// cmd_run: cmd_compile + system(exe)
fn cmd_run(argc: i32, argv: *u8) -> i32 {
    if argc < (1 as i32) {
        jh_fputs_stderr("usage: jhyy run <file.jhyy>\n" as *u8);
        return 1 as i32;
    }
    let argv_arr = argv as **u8;
    let input = (*argv_arr);

    // tmp output: "input" minus ext + "_run"
    let out_buf = malloc(1024 as i64);
    str_copy(out_buf, input);
    let dot = strrchr(out_buf, (46 as i32));
    if dot != (0 as *u8) {
        let _sdr = store_byte_i32(dot, 0 as i32);
    }
    let nl = strlen(out_buf);
    let off1 = str_concat_at(out_buf, nl, "_run" as *u8);
    let nul1 = (out_buf as i64 + off1) as *u8;
    store_byte_i32(nul1, 0 as i32);

    // build argv for cmd_compile: {input, "-o", out_buf_with_run}
    // cmd_compile defaults to "<input_no_ext>"; cmd_run uses "<input_no_ext>_run"
    // to avoid clobbering an existing build artifact. Pass -o explicitly.
    let arg_arr = malloc((3 as i64) * (8 as i64));
    let arg_arr_pp = arg_arr as **u8;
    (*arg_arr_pp) = input;
    let arg_arr_pp2 = ptr_add_u8(arg_arr, (8 as i64)) as **u8;
    (*arg_arr_pp2) = "-o" as *u8;
    let arg_arr_pp3 = ptr_add_u8(arg_arr, (16 as i64)) as **u8;
    (*arg_arr_pp3) = out_buf;

    let r = cmd_compile(3 as i32, arg_arr);
    free(arg_arr);
    if r != (0 as i32) {
        free(out_buf);
        return r;
    }
    // W-034: build ABSOLUTE path to exe via jh_fullpath. cmd.exe /C only searches
    // PATH (not cwd) for bare basenames, AND strips the leading/trailing quote
    // characters when there is no whitespace between them (cmd.exe /C quote
    // rule 2). For input "compiler\tests\foo.jhyy", out_buf is also relative,
    // so cmd.exe would treat "compiler" as command name and fail with
    // "'compiler' is not recognized". Resolving to absolute path bypasses both
    // issues — cmd.exe finds the file by full path.
    let abs_in = malloc(1024 as i64);
    let fr = jh_fullpath(abs_in, input, 1024 as i32);
    if fr != (0 as i32) {
        jh_fputs_stderr("jhyy: cannot resolve absolute path for input\n" as *u8);
        free(abs_in);
        free(out_buf);
        return 1 as i32;
    }
    // Build abs_exe = abs_in (with .jhyy → _run.exe)
    let abs_exe = malloc(1024 as i64);
    str_copy(abs_exe, abs_in);
    let ext_dot = strrchr(abs_exe, (46 as i32));
    if ext_dot != (0 as *u8) {
        let _sdx = store_byte_i32(ext_dot, 0 as i32);
    }
    let abs_n = strlen(abs_exe);
    let ae1 = str_concat_at(abs_exe, abs_n, "_run.exe" as *u8);
    let ae_nul = (abs_exe as i64 + ae1) as *u8;
    store_byte_i32(ae_nul, 0 as i32);
    // v1.5.6 W-039: wrap abs_exe in quotes so CreateProcessA treats the full
    // path (e.g. "C:\Program Files\...\dungeon_game_run.exe") as the module
    // name. Without quotes, Windows tokenizes at first whitespace and would
    // launch C:\Program if that file exists.
    let quoted_exe = malloc(1024 as i64);
    let _qe0 = str_concat_at(quoted_exe, 0 as i64, "\"" as *u8);
    let qe_n = strlen(quoted_exe);
    let _qe1 = str_concat_at(quoted_exe, qe_n, abs_exe);
    let qe_n2 = strlen(quoted_exe);
    let _qe2 = str_concat_at(quoted_exe, qe_n2, "\"" as *u8);
    // v1.5.6 W-038: 用 jh_run (CreateProcessA) 替代 system(), 绕过 cmd.exe /C 不搜索 cwd.
    // W-034 jh_fullpath 已把 abs_exe 解析为绝对路径, W-039 已用 quotes 包裹.
    let rc = jh_run(quoted_exe);
    free(quoted_exe);
    free(abs_exe);
    free(abs_in);
    free(out_buf);
    return rc;
}

// cmd_dump: stub for now
fn cmd_dump(argc: i32, argv: *u8) -> i32 {
    jh_fputs_stderr("cmd_dump not yet implemented (sprint 5 commit 2c)\n" as *u8);
    return 1 as i32;
}

// ═══ Entry point ═══

fn main_jhyy(argc: i32, argv: *u8) -> i32 {
    // v1.4.1: 初始化路径 (C runtime 持有状态, jhyy 端只调一次)
    if argc >= (1 as i32) {
        let argv0_arr = argv as **u8;
        let argv0 = (*argv0_arr);
        let r = jh_paths_init(argv0);
        if r != (0 as i32) {
            jh_fputs_stderr("jhyy: cannot derive project root from argv[0]\n" as *u8);
            return 1 as i32;
        }
    }

    if argc < (2 as i32) {
        printf("jhyy compiler v1.0.0 (self-hosted)\n" as *u8, 0);
        printf("usage: jhyy <command> [args]\n" as *u8, 0);
        printf("  compile <file.jhyy> [-o output]\n" as *u8, 0);
        printf("  build   <file.jhyy> [-o output]\n" as *u8, 0);
        printf("  run     <file.jhyy>\n" as *u8, 0);
        printf("  dump    <file.jhyy>\n" as *u8, 0);
        return 0 as i32;
    }
    // argv is *u8 (passed from C runtime). Each element is *u8, 8 bytes.
    // argv[0] = program path, argv[1] = command, argv[2...] = args
    let argv_arr = argv as **u8;
    let cmd_p = (argv as i64 + (8 as i64)) as *u8;
    let cmd_arr = cmd_p as **u8;
    let cmd = (*cmd_arr);
    let rest_argc = argc - (2 as i32);
    let rest_argv_p = (argv as i64 + (16 as i64)) as *u8;
    let rest_argv = rest_argv_p;

    if strcmp(cmd, "compile" as *u8) == (0 as i32) {
        return cmd_compile(rest_argc, rest_argv);
    }
    if strcmp(cmd, "build" as *u8) == (0 as i32) {
        return cmd_build(rest_argc, rest_argv);
    }
    if strcmp(cmd, "run" as *u8) == (0 as i32) {
        return cmd_run(rest_argc, rest_argv);
    }
    if strcmp(cmd, "dump" as *u8) == (0 as i32) {
        return cmd_dump(rest_argc, rest_argv);
    }
    jh_fputs_stderr("unknown command\n" as *u8);
    return 1 as i32;
}