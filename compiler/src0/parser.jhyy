// parser.jhyy — JHYY 翻译自 compiler/src/parser.c
// v1.0.0 sprint 3 commit 3, 2026-06-26
//
// 翻译要点（sprint 3 commit 2 + commit 3）：
//   - parse_decl 顶层 dispatch（fn/type/extern/import），fallback 走 parse_stmt
//   - parse_func 注册 sym 到 global scope（递归调用支持），push/pop scope 给 body
//   - parse_type 走 pointer / slice / array / ident / qualified ident
//     fn type 占位（ast_new_int 0 PRIM_I32 替代，C 端亦同）
//   - commit 3 完整 parse_stmt 9 个子分支配器：
//     parse_let / parse_if / parse_while / parse_for / parse_match /
//     parse_return / parse_break / parse_continue / parse_expr_stmt
//   - commit 3 完整 parse_pattern（literal / wildcard / ident / enum variant / range）
//   - commit 3 起 strtoll 走 ffi extern
//
//   - v0.9 wip commit 2.20 / Task #52: parse_const_decl 翻译 (顶层 const 数组声明),
//     SYM_CONST 在此文件冗余定义 (跟 codegen.jhyy:63 一致 — jhyy 无跨文件 import 机制,
//     task #42 完整搬家留后续独立 commit)
// 已知差异（vs C 版）：
//   - **C Token by value** → jhyy Token 平铺 6 字段 + caller 栈分配 + lexer 写 *t
//   - **C `bool` 参数 is_extern** → jhyy `i32` (0/1)
//   - **C `Token` nested in `Parser.prev`** → jhyy Parser.prev_kind/start/length/lf/ll/lc 6 字段
//     （避免 nested struct 触发 QBE 'w' load 不对齐，plan § 1.5 bug #5）
//   - **C `static Node *advance(Parser *p)` 返回 Token by value**
//     → jhyy fn parser_advance(p, *t) 写 *t，prev 字段同步更新
//   - **C `bool match / check` 返回 bool** → jhyy i32 (0/1)
//   - **C NodeFuncDeclParam / StructFieldDecl / EnumVariantDecl 数组 growable**
//     → jhyy 走同样 growable 模式（arena_alloc + memcpy）
//   - **C `size_t nparams` etc.** → jhyy i64
//   - **C `fprintf(stderr, ...)` 变参** → jhyy jh_print_loc_stderr + jh_fputs_stderr
//     （v0.6 parser 不接受变参，plan § 1.5 bug #3）
//   - **jhyy 不支持 mutual recursion**（forward reference hard error）→ commit 3 设计：
//     parse_if / parse_while / parse_for / parse_func 的 block body 各自 inline 一份
//     dispatcher（共享 6 个 sub-stmt + self-recursion + 必要 cross control flow）。
//     不再共享 parse_block。Order 限制：
//       parse_if     → inlined block 调 self + (no other ctrl flow)
//       parse_for    → inlined block 调 self + parse_if
//       parse_while  → inlined block 调 self + parse_for + parse_if
//       parse_func   → inlined block 调 parse_if + parse_while + parse_for
//     nested LBRACE（`{ { ... } }`）暂不支持（commit 3 limitation，测试无此用例）
//   - **parse_expr stub**：commit 3 仍为 stub（返回 NULL），match arm body / let init 等
//     临时为 NULL。commit 4 实现完整 Pratt 表达式。
//
// commit 拆分：
//   commit 2：parse_decl + parse_func + parse_type_decl + parse_type
//             + parse_extern_decl + parse_import_decl + parse_block
//             + parse_stmt stub + parse_expr stub
//   commit 3（本 commit）：parse_stmt 完整（parse_let/if/while/for/match/return/break/continue/
//             parse_expr_stmt）+ parse_pattern + inline block in if/while/for/func
//   commit 4（下次）：parse_expr 完整 Pratt + ParseRule 表 + init_rules

import ffi;

// v0.9 wip commit 2.20 / Task #52: SYM_CONST 由 symtab.jhyy 统一定义
//   (跟 SYM_VAR/SYM_FN/SYM_TYPE 同列)。parser.jhyy 通过 `import symtab` 可见,
//   不再需要本地冗余定义。
import util;
import lexer;
import arena;
import symtab;
import ast;

// ════════════════════════════════════════════════════
// Parser state（pre 字段平铺避免 nested struct，plan § 1.5 bug #5）
// ════════════════════════════════════════════════════

type Parser = struct {
    lexer:         *Lexer,
    arena:         *Arena,
    prev_kind:     i32,         // last consumed token's kind
    prev_start:    *u8,         // last consumed token's text start
    prev_length:   i64,         // last consumed token's text length
    prev_lf:       *u8,         // last consumed token's loc_filename
    prev_ll:       i32,         // last consumed token's loc_line
    prev_lc:       i32,         // last consumed token's loc_col
    global_scope:  *u8,         // *SymTable (jhyy 无 *SymTable in struct)
    current_scope: *u8,
    scope_depth:   i32,
    error_count:   i32,
}

// Parser 字节数 = 2 * 8 (ptr) + 6 * 8 (token fields) + 2 * 8 (scope) + 2 * 4 (depth/count) + 2 pad = 80
fn PARSER_SIZE() -> i64 { return 80 as i64; }

// ════════════════════════════════════════════════════
// Token helpers（caller 栈分配 Token，let mut t: Token = ...）
// ════════════════════════════════════════════════════

// 空 Token（用于栈分配初始化）
fn empty_token() -> Token {
    return Token {
        kind: 0, start: 0 as *u8, length: 0 as i64,
        loc_filename: 0 as *u8, loc_line: 0, loc_col: 0,
    };
}

// peek: 不消耗 token。caller 栈分配 Token
fn parser_peek(p: *Parser, t: *Token) -> i32 {
    lexer_peek((*p).lexer, t);
    return 0;
}

// advance: 取下一 token（消耗），存到 prev 字段，复制到 *t
fn parser_advance(p: *Parser, t: *Token) -> i32 {
    lexer_next((*p).lexer, t);
    (*p).prev_kind = t.kind;
    (*p).prev_start = t.start;
    (*p).prev_length = t.length;
    (*p).prev_lf = t.loc_filename;
    (*p).prev_ll = t.loc_line;
    (*p).prev_lc = t.loc_col;
    return 0;
}

// check: peek 当前 token kind 是否匹配
fn parser_check(p: *Parser, kind: i32) -> i32 {
    let mut t = empty_token();
    parser_peek(p, &t);
    if t.kind == kind {
        return 1;
    }
    return 0;
}

// match: 若 peek 匹配则 advance，返回 1；否则不消耗，返回 0
fn parser_match(p: *Parser, kind: i32, t: *Token) -> i32 {
    if parser_check(p, kind) != (0 as i32) {
        parser_advance(p, t);
        return 1;
    }
    return 0;
}

// expect: 必须匹配 kind；匹配则 advance 返回 0；不匹配则报 error 到 stderr 返回 1
// 报错：jh_print_loc_stderr(filename, line, col) + jh_fputs_stderr("expected X, got Y\n")
fn parser_expect(p: *Parser, kind: i32, what: *u8, t: *Token) -> i32 {
    if parser_check(p, kind) != (0 as i32) {
        parser_advance(p, t);
        return 0;
    }
    let mut peekt = empty_token();
    parser_peek(p, &peekt);
    jh_print_loc_stderr(peekt.loc_filename, peekt.loc_line, peekt.loc_col);
    jh_fputs_stderr("error: expected " as *u8);
    jh_fputs_stderr(what);
    jh_fputs_stderr(", got " as *u8);
    jh_fputs_stderr(token_kind_name(peekt.kind));
    jh_fputs_stderr("\n" as *u8);
    (*p).error_count = (*p).error_count + (1 as i32);
    return 1;
}

// ════════════════════════════════════════════════════
// Scope management
// ════════════════════════════════════════════════════

fn parser_push_scope(p: *Parser) -> i32 {
    (*p).current_scope = symtab_new((*p).arena, (*p).current_scope);
    (*p).scope_depth = (*p).scope_depth + (1 as i32);
    return 0;
}

fn parser_pop_scope(p: *Parser) -> i32 {
    let cur = (*p).current_scope as *SymTable;
    if cur != (0 as *SymTable) {
        let parent = (*cur).parent;
        (*p).current_scope = parent;
    }
    (*p).scope_depth = (*p).scope_depth - (1 as i32);
    return 0;
}

// ════════════════════════════════════════════════════
// Token name helper
// ════════════════════════════════════════════════════

// tok_name: arena_strdup token 文本，返回 *u8（NUL 终止）
fn parser_tok_name(p: *Parser, t: *Token) -> *u8 {
    return arena_strdup((*p).arena, t.start, t.length);
}

// ════════════════════════════════════════════════════
// Precedence constants（Pratt 解析，对齐 parser.h）
// ════════════════════════════════════════════════════

fn PREC_NONE()      -> i32 { return 0  as i32; }
fn PREC_ASSIGN()    -> i32 { return 1  as i32; }
fn PREC_OR()        -> i32 { return 2  as i32; }
fn PREC_AND()       -> i32 { return 3  as i32; }
fn PREC_COMPARE()   -> i32 { return 4  as i32; }
fn PREC_BIT_OR()    -> i32 { return 5  as i32; }
fn PREC_BIT_XOR()   -> i32 { return 6  as i32; }
fn PREC_BIT_AND()   -> i32 { return 7  as i32; }
fn PREC_SHIFT()     -> i32 { return 8  as i32; }
fn PREC_TERM()      -> i32 { return 9  as i32; }
fn PREC_FACTOR()    -> i32 { return 10 as i32; }
fn PREC_UNARY()     -> i32 { return 11 as i32; }
fn PREC_PRIMARY()   -> i32 { return 12 as i32; }

// ════════════════════════════════════════════════════
// Type parsing（前置：parse_let / parse_func / parse_type_decl / parse_expr 都调用）
// commit 4 移到 parse_expr 之前，parse_expr 中 sizeof/alignof/as 需要它
// array count 不再走 parse_expr（避免 mutual recursion），改 inline int literal
// ════════════════════════════════════════════════════

fn parse_type(p: *Parser) -> *Node {
    let mut t = empty_token();

    // *T (pointer type)
    if parser_match(p, TOKEN_STAR(), &t) != (0 as i32) {
        let inner = parse_type(p);
        return ast_new_unary((*p).arena, (*p).prev_lf, (*p).prev_ll, (*p).prev_lc,
                             TOKEN_STAR(), inner);
    }

    // [*]T (slice) or [T; N] (array)
    if parser_match(p, TOKEN_LBRACKET(), &t) != (0 as i32) {
        if parser_match(p, TOKEN_STAR(), &t) != (0 as i32) {
            // [*]T
            parser_expect(p, TOKEN_RBRACKET(), "] after [*" as *u8, &t);
            let elem = parse_type(p);
            return ast_new_slice_type((*p).arena, (*p).prev_lf, (*p).prev_ll, (*p).prev_lc, elem);
        }
        // [T; N] — count 走 inline int literal（避免 mutual recursion with parse_expr）
        let body_loc_lf = (*p).prev_lf;
        let body_loc_ll = (*p).prev_ll;
        let body_loc_lc = (*p).prev_lc;
        let base = parse_type(p);
        parser_expect(p, TOKEN_SEMICOLON(), "; in array type" as *u8, &t);
        let mut count_t = empty_token();
        parser_expect(p, TOKEN_INT(), "array size" as *u8, &count_t);
        let count_val = strtoll(count_t.start, 0 as *u8, 0 as i32);
        let count_node = ast_new_int((*p).arena, body_loc_lf, body_loc_ll, body_loc_lc,
                                     count_val, PRIM_I32());
        parser_expect(p, TOKEN_RBRACKET(), "] in array type" as *u8, &t);
        return ast_new_array_type((*p).arena, body_loc_lf, body_loc_ll, body_loc_lc, base, count_node);
    }

    // fn(T1, T2) -> Ret
    if parser_match(p, TOKEN_FN(), &t) != (0 as i32) {
        parser_expect(p, TOKEN_LPAREN(), "( in fn type" as *u8, &t);
        // skip params: 循环消耗直到 )
        while parser_check(p, TOKEN_RPAREN()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                break;
            }
            parser_advance(p, &t);
            if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) {
                break;
            }
        }
        parser_expect(p, TOKEN_RPAREN(), ") in fn type" as *u8, &t);
        // 占位：返回 ast_new_int(0, PRIM_I32)，跟 C 端 placeholder 一致
        return ast_new_int((*p).arena, (*p).prev_lf, (*p).prev_ll, (*p).prev_lc,
                           0 as i64, PRIM_I32());
    }

    // Ident [:: Ident]*
    parser_expect(p, TOKEN_IDENT(), "type name" as *u8, &t);
    let name = parser_tok_name(p, &t);
    let mut sym = symtab_lookup((*p).current_scope, name);
    if sym == (0 as *Sym) {
        sym = symtab_insert((*p).current_scope, name, SYM_TYPE(),
                            0 as *u8, 0 as i32, (*p).scope_depth);
    }
    let mut base = ast_new_ident((*p).arena, t.loc_filename, t.loc_line, t.loc_col, sym);

    // :: Ident (qualified)
    while parser_check(p, TOKEN_COLONCOLON()) != (0 as i32) {
        parser_advance(p, &t);
        parser_expect(p, TOKEN_IDENT(), "type name after ::" as *u8, &t);
        let qname = parser_tok_name(p, &t);
        let mut qsym = symtab_lookup((*p).current_scope, qname);
        if qsym == (0 as *Sym) {
            qsym = symtab_insert((*p).current_scope, qname, SYM_TYPE(),
                                 0 as *u8, 0 as i32, (*p).scope_depth);
        }
        base = ast_new_ident((*p).arena, t.loc_filename, t.loc_line, t.loc_col, qsym);
    }

    return base;
}

// ════════════════════════════════════════════════════
// parse_expr: 完整 Pratt 表达式（commit 4）
// 对应 C 端 parser.c:612-967（parse_expr + 12 prefix_* + 6 infix_*）
//
// 关键设计：jhyy 不支持 mutual recursion，所以 prefix_* / infix_* 不能拆成
// 独立函数（parse_expr → prefix_unary → parse_expr 死循环编译失败）。
// 把所有 prefix / infix 逻辑 inline 在 parse_expr 内部 token-kind dispatch 里。
//
// 已知差异（vs C 版）：
//   - **不处理 expression-oriented keywords**（if/match/while/for/lbrace）：
//     C 端 parse_expr 起头 if 调 parse_if(p)，但 jhyy parse_expr 必须定义在
//     parse_if 之前（parse_let/return/pattern/match/if/while/for 都调 parse_expr
//     且都在它之前定义），所以 parse_expr 调 parse_if 是 forward reference。
//     后果：`let x = if cond { a } else { b };` 这种 C 允许的语法 jhyy 报
//     "unexpected token IF in expression"。v0.7 测试集不用此 pattern（regress.py
//     47/50 pass 验证），文档化为 limitation。
//   - **f64 字面量走 jh_f64_atof store 模式**（不能 extern fn return f64，
//     QBE Windows amd64 backend SSE return 路径未验证）。
//   - **int 后缀 (42i32 / 100u8) 走 jh_int_suffix_prim**（jhyy 无 atoi）。
// ════════════════════════════════════════════════════

fn parse_expr(p: *Parser, min_prec: i32) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    let mut left: *Node = 0 as *Node;

    // ── Prefix dispatch（基于 t.kind 走 inline）──
    if t.kind == TOKEN_EOF() {
        jh_print_loc_stderr(loc_lf, loc_ll, loc_lc);
        jh_fputs_stderr("error: unexpected end of file in expression\n" as *u8);
        (*p).error_count = (*p).error_count + (1 as i32);
        return 0 as *Node;
    }

    if t.kind == TOKEN_INT() {
        parser_advance(p, &t);
        let val = strtoll(t.start, 0 as *u8, 0 as i32);
        let prim = jh_int_suffix_prim(t.start, t.length);
        left = ast_new_int((*p).arena, loc_lf, loc_ll, loc_lc, val, prim);
    }
    else if t.kind == TOKEN_FLOAT() {
        parser_advance(p, &t);
        let mut val: f64 = 0.0;
        jh_f64_atof(t.start, t.length, (&val) as *u8);
        left = ast_new_float((*p).arena, loc_lf, loc_ll, loc_lc, val);
    }
    else if t.kind == TOKEN_STRING() {
        parser_advance(p, &t);
        // token 包含两端引号；提取中间内容并 arena_strdup
        let chars = ((t.start as i64) + (1 as i64)) as *u8;
        let len = t.length - (2 as i64);
        let arena_chars = arena_strdup((*p).arena, chars, len);
        left = ast_new_string((*p).arena, loc_lf, loc_ll, loc_lc, arena_chars, len);
    }
    else if t.kind == TOKEN_CHAR() {
        parser_advance(p, &t);
        // 绕开 qbe_type_of(*u8)='b' bug：4-byte aligned read + shift + mask
        // t.start[0] = '\'', t.start[1] = char (or '\\'), t.start[2] = (escape or '\'')
        let p1 = (t.start as i64) + (1 as i64);
        let a1 = p1 & (~(3 as i64));
        let r1 = (p1 - a1) as i32;
        let w1 = *((a1) as *i32);
        let s1 = r1 * (8 as i32);
        let c1 = (w1 >> s1) & (255 as i32);
        let mut ch: i32 = 0;
        if c1 == (92 as i32) {  // '\\'
            let p2 = (t.start as i64) + (2 as i64);
            let a2 = p2 & (~(3 as i64));
            let r2 = (p2 - a2) as i32;
            let w2 = *((a2) as *i32);
            let s2 = r2 * (8 as i32);
            let c2 = (w2 >> s2) & (255 as i32);
            if c2 == (110 as i32) { ch = 10 as i32; }       // 'n'
            else if c2 == (116 as i32) { ch = 9 as i32; }  // 't'
            else if c2 == (114 as i32) { ch = 13 as i32; } // 'r'
            else if c2 == (48 as i32) { ch = 0 as i32; }   // '0'
            else { ch = c2; }
        } else {
            ch = c1;
        }
        left = ast_new_char((*p).arena, loc_lf, loc_ll, loc_lc, ch);
    }
    else if t.kind == TOKEN_BOOL() {
        parser_advance(p, &t);
        let mut val: i32 = 0;
        if t.length == (4 as i64) {
            let r = strncmp(t.start, "true" as *u8, 4 as i64);
            if r == (0 as i32) { val = 1; }
        }
        left = ast_new_bool((*p).arena, loc_lf, loc_ll, loc_lc, val);
    }
    // v1.3.1: null keyword → NODE_NULL (sema 上下文填充类型)
    else if t.kind == TOKEN_NULL() {
        parser_advance(p, &t);
        left = ast_new_null((*p).arena, loc_lf, loc_ll, loc_lc);
    }
    else if t.kind == TOKEN_IDENT() {
        parser_advance(p, &t);
        let name = parser_tok_name(p, &t);
        let mut sym = symtab_lookup((*p).current_scope, name);
        if sym == (0 as *Sym) {
            sym = symtab_insert((*p).current_scope, name, SYM_VAR(),
                                0 as *u8, 0 as i32, (*p).scope_depth);
        }

        // branch on sym kind
        if (*sym).kind == SYM_TYPE() {
            // ── struct lit: TypeName { field: val, ... } ──
            if parser_check(p, TOKEN_LBRACE()) != (0 as i32) {
                parser_advance(p, &t);  // consume {
                let mut fields: *u8 = 0 as *u8;
                let mut nfields: i64 = 0 as i64;
                let mut fcap: i64 = 0 as i64;
                while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                    if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                    let mut fnt = empty_token();
                    parser_expect(p, TOKEN_IDENT(), "field name" as *u8, &fnt);
                    let fname = parser_tok_name(p, &fnt);
                    parser_expect(p, TOKEN_COLON(), ":" as *u8, &t);
                    let fval = parse_expr(p, PREC_NONE());
                    if nfields >= fcap {
                        fcap = if fcap != (0 as i64) { fcap * (2 as i64) } else { (8 as i64) };
                        let nf = arena_alloc((*p).arena, fcap * (16 as i64));
                        if fields != (0 as *u8) {
                            if nfields > (0 as i64) { memcpy(nf, fields, nfields * (16 as i64)); }
                        }
                        fields = nf;
                    }
                    let fd = (fields as i64 + nfields * (16 as i64)) as *NodeFieldInit;
                    (*fd).name = fname;
                    (*fd).value = fval as *u8;
                    nfields = nfields + (1 as i64);
                    if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) { break; }
                }
                parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
                left = ast_new_struct_lit((*p).arena, loc_lf, loc_ll, loc_lc, sym, fields, nfields);
            }
            // ── enum variant: TypeName::Variant(args) ──
            else if parser_check(p, TOKEN_COLONCOLON()) != (0 as i32) {
                parser_advance(p, &t);  // consume ::
                let mut vt = empty_token();
                parser_expect(p, TOKEN_IDENT(), "variant name" as *u8, &vt);
                let vname = parser_tok_name(p, &vt);
                let mut vsym = symtab_lookup((*p).current_scope, vname);
                if vsym == (0 as *Sym) {
                    vsym = symtab_insert((*p).current_scope, vname, SYM_VARIANT(),
                                         0 as *u8, 0 as i32, (*p).scope_depth);
                }
                let mut payload: *Node = 0 as *Node;
                if parser_match(p, TOKEN_LPAREN(), &t) != (0 as i32) {
                    payload = parse_expr(p, PREC_NONE());
                    parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
                }
                left = ast_new_enum_variant((*p).arena, loc_lf, loc_ll, loc_lc, sym, vsym, payload);
            }
            // bare type ident (allowed as expression — resolves later)
            else {
                left = ast_new_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
            }
        }
        else if (*sym).kind == SYM_MODULE() {
            // ── qualified call: mod::name(args) ──
            if parser_check(p, TOKEN_COLONCOLON()) != (0 as i32) {
                parser_advance(p, &t);  // consume ::
                let mut fnt = empty_token();
                parser_expect(p, TOKEN_IDENT(), "function name after '::'" as *u8, &fnt);
                let fn_name = parser_tok_name(p, &fnt);
                let mut fn_sym = symtab_lookup((*p).current_scope, fn_name);
                if fn_sym == (0 as *Sym) {
                    fn_sym = symtab_insert((*p).current_scope, fn_name, SYM_FN(),
                                            0 as *u8, 0 as i32, 0 as i32);
                }
                let mut args: *u8 = 0 as *u8;
                let mut nargs: i64 = 0 as i64;
                let mut cap: i64 = 0 as i64;
                parser_expect(p, TOKEN_LPAREN(), "(" as *u8, &t);
                if parser_check(p, TOKEN_RPAREN()) == (0 as i32) {
                    while true {
                        let arg = parse_expr(p, PREC_NONE());
                        if nargs >= cap {
                            cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                            let na = arena_alloc((*p).arena, cap * (8 as i64));
                            if args != (0 as *u8) {
                                if nargs > (0 as i64) { memcpy(na, args, nargs * (8 as i64)); }
                            }
                            args = na;
                        }
                        let slot = (args as i64 + nargs * (8 as i64)) as **Node;
                        *slot = arg;
                        nargs = nargs + (1 as i64);
                        if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) { break; }
                    }
                }
                parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
                let mod_node = ast_new_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
                let fn_node = ast_new_ident((*p).arena, (*p).prev_lf, (*p).prev_ll, (*p).prev_lc, fn_sym);
                left = ast_new_qualified_call((*p).arena, loc_lf, loc_ll, loc_lc, mod_node, fn_node, args, nargs);
            } else {
                left = ast_new_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
            }
        }
        else {
            left = ast_new_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
        }
    }
    // ── unary prefix: - ! ~ ──
    else if t.kind == TOKEN_MINUS() {
        parser_advance(p, &t);
        let op = t.kind;
        let expr = parse_expr(p, PREC_UNARY());
        left = ast_new_unary((*p).arena, loc_lf, loc_ll, loc_lc, op, expr);
    }
    else if t.kind == TOKEN_BANG() {
        parser_advance(p, &t);
        let op = t.kind;
        let expr = parse_expr(p, PREC_UNARY());
        left = ast_new_unary((*p).arena, loc_lf, loc_ll, loc_lc, op, expr);
    }
    else if t.kind == TOKEN_TILDE() {
        parser_advance(p, &t);
        let op = t.kind;
        let expr = parse_expr(p, PREC_UNARY());
        left = ast_new_unary((*p).arena, loc_lf, loc_ll, loc_lc, op, expr);
    }
    else if t.kind == TOKEN_STAR() {
        // * is both prefix (deref) and infix (multiply)
        parser_advance(p, &t);
        let expr = parse_expr(p, PREC_UNARY());
        left = ast_new_deref((*p).arena, loc_lf, loc_ll, loc_lc, expr);
    }
    else if t.kind == TOKEN_AMP() {
        // & is both prefix (addr-of) and infix (bit-and), and starts slice literal &[...]
        parser_advance(p, &t);
        if parser_check(p, TOKEN_LBRACKET()) != (0 as i32) {
            // slice literal: &[1, 2, 3]
            parser_advance(p, &t);  // consume [
            let mut elems: *u8 = 0 as *u8;
            let mut nelems: i64 = 0 as i64;
            let mut cap: i64 = 0 as i64;
            if parser_check(p, TOKEN_RBRACKET()) == (0 as i32) {
                while true {
                    let elem = parse_expr(p, PREC_NONE());
                    if nelems >= cap {
                        cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                        let ne = arena_alloc((*p).arena, cap * (8 as i64));
                        if elems != (0 as *u8) {
                            if nelems > (0 as i64) { memcpy(ne, elems, nelems * (8 as i64)); }
                        }
                        elems = ne;
                    }
                    let slot = (elems as i64 + nelems * (8 as i64)) as **Node;
                    *slot = elem;
                    nelems = nelems + (1 as i64);
                    if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) { break; }
                }
            }
            parser_expect(p, TOKEN_RBRACKET(), "] in slice literal" as *u8, &t);
            let arr = ast_new_array_lit((*p).arena, loc_lf, loc_ll, loc_lc, elems, nelems);
            left = ast_new_slice_lit((*p).arena, loc_lf, loc_ll, loc_lc, arr);
        } else {
            let expr = parse_expr(p, PREC_UNARY());
            left = ast_new_addr_of((*p).arena, loc_lf, loc_ll, loc_lc, expr);
        }
    }
    else if t.kind == TOKEN_LPAREN() {
        // paren grouping / unit
        parser_advance(p, &t);
        if parser_match(p, TOKEN_RPAREN(), &t) != (0 as i32) {
            // unit ()
            left = ast_new_int((*p).arena, loc_lf, loc_ll, loc_lc, 0 as i64, PRIM_I32());
        } else {
            let expr = parse_expr(p, PREC_NONE());
            parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
            left = expr;
        }
    }
    else if t.kind == TOKEN_SIZEOF() {
        parser_advance(p, &t);
        parser_expect(p, TOKEN_LPAREN(), "(" as *u8, &t);
        let target = parse_type(p);
        parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
        left = ast_new_sizeof((*p).arena, loc_lf, loc_ll, loc_lc, target);
    }
    else if t.kind == TOKEN_ALIGNOF() {
        parser_advance(p, &t);
        parser_expect(p, TOKEN_LPAREN(), "(" as *u8, &t);
        let target = parse_type(p);
        parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
        left = ast_new_alignof((*p).arena, loc_lf, loc_ll, loc_lc, target);
    }
    else if t.kind == TOKEN_IF() {
        /* if-as-expression（Phase A-1, v0.8 commit 5）：`let r = if cond { a } else { b };`
         * jhyy 无 forward reference（parse_if 定义在 parse_expr 之后，见 line 286 注释），
         * 所以不能调 parse_if。这里 inline 一份 if 解析，块内语句只支持：
         *   - 表达式语句（parse_expr + optional ;，自递归 OK）
         *   - 嵌套 if / else-if（parse_expr 自递归回到本分支）
         * 不支持块内 let/return/match（if-expr 值块场景用不到；if-statement 走 parse_if）。*/
        parser_advance(p, &t);  // consume 'if'
        let ifx_cond = parse_expr(p, PREC_NONE());

        // ── then block ──
        parser_expect(p, TOKEN_LBRACE(), "{ after if condition" as *u8, &t);
        parser_push_scope(p);
        let mut ifx_then: *u8 = 0 as *u8;
        let mut ifx_nthen: i64 = 0 as i64;
        let mut ifx_tcap: i64 = 0 as i64;
        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
            let mut ifx_s: *Node = 0 as *Node;
            if parser_check(p, TOKEN_IF()) != (0 as i32) {
                ifx_s = parse_expr(p, PREC_NONE());   // 嵌套 if-expr（自递归）
            } else {
                let ex = parse_expr(p, PREC_NONE());
                if ex != (0 as *Node) {
                    if parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                        if parser_check(p, TOKEN_EOF()) == (0 as i32) {
                            parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);
                        }
                    }
                    ifx_s = ast_new_expr_stmt((*p).arena, ex, (*ex).loc_line, (*ex).loc_col, ex);
                }
            }
            if ifx_s != (0 as *Node) {
                if ifx_nthen >= ifx_tcap {
                    ifx_tcap = if ifx_tcap != (0 as i64) { ifx_tcap * (2 as i64) } else { (8 as i64) };
                    let nt = arena_alloc((*p).arena, ifx_tcap * (8 as i64));
                    if ifx_then != (0 as *u8) {
                        if ifx_nthen > (0 as i64) { memcpy(nt, ifx_then, ifx_nthen * (8 as i64)); }
                    }
                    ifx_then = nt;
                }
                let slot = (ifx_then as i64 + ifx_nthen * (8 as i64)) as **Node;
                *slot = ifx_s;
                ifx_nthen = ifx_nthen + (1 as i64);
            }
        }
        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
        parser_pop_scope(p);
        let ifx_then_body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, ifx_then, ifx_nthen);

        // ── else block (optional) ──
        let mut ifx_else_body: *Node = 0 as *Node;
        if parser_match(p, TOKEN_ELSE(), &t) != (0 as i32) {
            if parser_check(p, TOKEN_IF()) != (0 as i32) {
                ifx_else_body = parse_expr(p, PREC_NONE());   // else-if（自递归）
            } else {
                parser_expect(p, TOKEN_LBRACE(), "{ after else" as *u8, &t);
                parser_push_scope(p);
                let mut ifx_els: *u8 = 0 as *u8;
                let mut ifx_nels: i64 = 0 as i64;
                let mut ifx_ecap: i64 = 0 as i64;
                while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                    if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                    let mut ifx_s2: *Node = 0 as *Node;
                    if parser_check(p, TOKEN_IF()) != (0 as i32) {
                        ifx_s2 = parse_expr(p, PREC_NONE());
                    } else {
                        let ex2 = parse_expr(p, PREC_NONE());
                        if ex2 != (0 as *Node) {
                            if parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                                if parser_check(p, TOKEN_EOF()) == (0 as i32) {
                                    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);
                                }
                            }
                            ifx_s2 = ast_new_expr_stmt((*p).arena, ex2, (*ex2).loc_line, (*ex2).loc_col, ex2);
                        }
                    }
                    if ifx_s2 != (0 as *Node) {
                        if ifx_nels >= ifx_ecap {
                            ifx_ecap = if ifx_ecap != (0 as i64) { ifx_ecap * (2 as i64) } else { (8 as i64) };
                            let ne = arena_alloc((*p).arena, ifx_ecap * (8 as i64));
                            if ifx_els != (0 as *u8) {
                                if ifx_nels > (0 as i64) { memcpy(ne, ifx_els, ifx_nels * (8 as i64)); }
                            }
                            ifx_els = ne;
                        }
                        let slot2 = (ifx_els as i64 + ifx_nels * (8 as i64)) as **Node;
                        *slot2 = ifx_s2;
                        ifx_nels = ifx_nels + (1 as i64);
                    }
                }
                parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
                parser_pop_scope(p);
                ifx_else_body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, ifx_els, ifx_nels);
            }
        }

        left = ast_new_if((*p).arena, loc_lf, loc_ll, loc_lc, ifx_cond, ifx_then_body, ifx_else_body);
    }
    else if t.kind == TOKEN_MATCH() {
        /* match-as-expression（Sprint 4.5 C step 3a）：
         *   let result = match x { 1 => 10, 2 => 20, _ => 0 };
         * jhyy 无 forward reference（parse_match 定义在 parse_expr 之后），
         * 所以不能调 parse_match。这里 inline 一份 match 解析。
         * 模式只支持 literal int + wildcard（match.jhyy + dungeon_game.jhyy 触发面已足）；
         * enum/range/binding pattern 走原 parse_match。*/
        parser_advance(p, &t);  // consume 'match'
        let mx_subj = parse_expr(p, PREC_NONE());
        parser_expect(p, TOKEN_LBRACE(), "{ after match subject" as *u8, &t);

        let mut mx_arms: *u8 = 0 as *u8;
        let mut mx_narms: i64 = 0 as i64;
        let mut mx_cap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }

            // inline minimal pattern: literal int (TOKEN_INT) + wildcard (single-char '_' ident)
            let mut mx_pat: *Node = 0 as *Node;
            let mut pt = empty_token();
            parser_peek(p, &pt);
            let p_lf = pt.loc_filename;
            let p_ll = pt.loc_line;
            let p_lc = pt.loc_col;

            if pt.kind == TOKEN_INT() {
                parser_advance(p, &pt);
                let pval = strtoll(pt.start, 0 as *u8, 0 as i32);
                mx_pat = ast_new_pattern_lit((*p).arena, p_lf, p_ll, p_lc, pval, PRIM_I32());
            } else if pt.kind == TOKEN_IDENT() {
                // check wildcard '_' (single-char ident)
                let mut is_wild = 0 as i32;
                if pt.length == (1 as i64) {
                    let p_addr = pt.start as i64;
                    let aligned = p_addr & (~(3 as i64));
                    let rem = (p_addr - aligned) as i32;
                    let w = *((aligned) as *i32);
                    let shift = rem * (8 as i32);
                    let c0 = (w >> shift) & (255 as i32);
                    if c0 == (95 as i32) {
                        is_wild = 1 as i32;
                    }
                }
                if is_wild != (0 as i32) {
                    parser_advance(p, &pt);
                    mx_pat = ast_new_pattern_wild((*p).arena, p_lf, p_ll, p_lc);
                } else {
                    // ident binding fallback（parse_pattern forward ref 限制下最简实现）
                    parser_advance(p, &pt);
                    let iname = arena_strdup((*p).arena, pt.start, pt.length);
                    let mut isym = symtab_lookup((*p).current_scope, iname);
                    if isym == (0 as *Sym) {
                        isym = symtab_insert((*p).current_scope, iname, SYM_VAR(),
                                             0 as *u8, 0 as i32, (*p).scope_depth);
                    }
                    mx_pat = ast_new_pattern_ident((*p).arena, p_lf, p_ll, p_lc, isym);
                }
            } else {
                jh_print_loc_stderr(p_lf, p_ll, p_lc);
                jh_fputs_stderr("error: unexpected token in match pattern\n" as *u8);
                (*p).error_count = (*p).error_count + (1 as i32);
                parser_advance(p, &pt);
                mx_pat = 0 as *Node;  // type-anchor: 让 if/else chain 末表达式类型一致
            }

            parser_expect(p, TOKEN_FATARROW(), "=>" as *u8, &t);
            let mx_body = parse_expr(p, PREC_NONE());

            // optional trailing comma
            let _mx_c = parser_match(p, TOKEN_COMMA(), &t);

            let mx_arm = ast_new_match_arm((*p).arena, loc_lf, loc_ll, loc_lc, mx_pat, mx_body);

            if mx_narms >= mx_cap {
                mx_cap = if mx_cap != (0 as i64) { mx_cap * (2 as i64) } else { (8 as i64) };
                let mna = arena_alloc((*p).arena, mx_cap * (8 as i64));
                if mx_arms != (0 as *u8) {
                    if mx_narms > (0 as i64) {
                        memcpy(mna, mx_arms, mx_narms * (8 as i64));
                    }
                }
                mx_arms = mna;
            }
            let mslot = (mx_arms as i64 + mx_narms * (8 as i64)) as **Node;
            *mslot = mx_arm;
            mx_narms = mx_narms + (1 as i64);
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
        left = ast_new_match((*p).arena, loc_lf, loc_ll, loc_lc, mx_subj, mx_arms, mx_narms);
    }
    else if t.kind == TOKEN_LBRACKET() {
        // array literal: [1, 2, 3]
        parser_advance(p, &t);
        let mut elems: *u8 = 0 as *u8;
        let mut nelems: i64 = 0 as i64;
        let mut cap: i64 = 0 as i64;
        if parser_check(p, TOKEN_RBRACKET()) == (0 as i32) {
            while true {
                let elem = parse_expr(p, PREC_NONE());
                if nelems >= cap {
                    cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                    let ne = arena_alloc((*p).arena, cap * (8 as i64));
                    if elems != (0 as *u8) {
                        if nelems > (0 as i64) { memcpy(ne, elems, nelems * (8 as i64)); }
                    }
                    elems = ne;
                }
                let slot = (elems as i64 + nelems * (8 as i64)) as **Node;
                *slot = elem;
                nelems = nelems + (1 as i64);
                if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) { break; }
            }
        }
        parser_expect(p, TOKEN_RBRACKET(), "]" as *u8, &t);
        left = ast_new_array_lit((*p).arena, loc_lf, loc_ll, loc_lc, elems, nelems);
    }
    else {
        // unexpected token (IF / MATCH / WHILE / FOR / LBRACE 等 statement-only)
        jh_print_loc_stderr(loc_lf, loc_ll, loc_lc);
        jh_fputs_stderr("error: unexpected token '" as *u8);
        jh_fputs_stderr(token_kind_name(t.kind));
        jh_fputs_stderr("' in expression\n" as *u8);
        (*p).error_count = (*p).error_count + (1 as i32);
        parser_advance(p, &t);
        left = 0 as *Node;
    }

    // error path：prefix dispatch 失败，提前返回
    if left == (0 as *Node) { return 0 as *Node; }

    // ── Pratt loop: infix dispatch（基于 peek t.kind）──
    while true {
        parser_peek(p, &t);
        // stop conditions (C 端 parser.c:637-643)
        if t.kind == TOKEN_EOF() { return left; }
        if t.kind == TOKEN_SEMICOLON() { return left; }
        if t.kind == TOKEN_RBRACE() { return left; }
        if t.kind == TOKEN_RPAREN() { return left; }
        if t.kind == TOKEN_RBRACKET() { return left; }
        if t.kind == TOKEN_COMMA() { return left; }
        if t.kind == TOKEN_COLON() { return left; }
        if t.kind == TOKEN_FATARROW() { return left; }
        if t.kind == TOKEN_IN() { return left; }
        if t.kind == TOKEN_ELSE() { return left; }

        // determine precedence (C 端 init_rules 表 inline)
        let mut prec: i32 = 0;
        let mut is_infix: i32 = 0;
        if t.kind == TOKEN_EQ() || t.kind == TOKEN_PLUSEQ() || t.kind == TOKEN_MINUSEQ()
           || t.kind == TOKEN_STAREQ() || t.kind == TOKEN_SLASHEQ() || t.kind == TOKEN_PERCENTEQ() {
            prec = PREC_ASSIGN(); is_infix = 1;
        } else if t.kind == TOKEN_PIPEPIPE() {
            prec = PREC_OR(); is_infix = 1;
        } else if t.kind == TOKEN_AMPAMP() {
            prec = PREC_AND(); is_infix = 1;
        } else if t.kind == TOKEN_EQEQ() || t.kind == TOKEN_BANGEQ()
                  || t.kind == TOKEN_LT() || t.kind == TOKEN_GT()
                  || t.kind == TOKEN_LTEQ() || t.kind == TOKEN_GTEQ() {
            prec = PREC_COMPARE(); is_infix = 1;
        } else if t.kind == TOKEN_PIPE() {
            prec = PREC_BIT_OR(); is_infix = 1;
        } else if t.kind == TOKEN_CARET() {
            prec = PREC_BIT_XOR(); is_infix = 1;
        } else if t.kind == TOKEN_AMP() {
            prec = PREC_BIT_AND(); is_infix = 1;
        } else if t.kind == TOKEN_LTLT() || t.kind == TOKEN_GTGT() {
            prec = PREC_SHIFT(); is_infix = 1;
        } else if t.kind == TOKEN_PLUS() || t.kind == TOKEN_MINUS() {
            prec = PREC_TERM(); is_infix = 1;
        } else if t.kind == TOKEN_STAR() || t.kind == TOKEN_SLASH() || t.kind == TOKEN_PERCENT() {
            prec = PREC_FACTOR(); is_infix = 1;
        } else if t.kind == TOKEN_LPAREN() {
            prec = PREC_PRIMARY(); is_infix = 1;
        } else if t.kind == TOKEN_DOT() {
            prec = PREC_PRIMARY(); is_infix = 1;
        } else if t.kind == TOKEN_LBRACKET() {
            prec = PREC_PRIMARY(); is_infix = 1;
        } else if t.kind == TOKEN_AS() {
            prec = PREC_FACTOR(); is_infix = 1;
        } else {
            // unknown token in expression — not an infix
            is_infix = 0;
        }

        if is_infix == (0 as i32) { return left; }
        if prec < min_prec { return left; }

        // ── infix dispatch（基于 t.kind）──
        if t.kind == TOKEN_EQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, right);
        }
        else if t.kind == TOKEN_PLUSEQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            let bin = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, TOKEN_PLUS(), left, right);
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, bin);
        }
        else if t.kind == TOKEN_MINUSEQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            let bin = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, TOKEN_MINUS(), left, right);
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, bin);
        }
        else if t.kind == TOKEN_STAREQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            let bin = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, TOKEN_STAR(), left, right);
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, bin);
        }
        else if t.kind == TOKEN_SLASHEQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            let bin = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, TOKEN_SLASH(), left, right);
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, bin);
        }
        else if t.kind == TOKEN_PERCENTEQ() {
            parser_advance(p, &t);
            let right = parse_expr(p, PREC_NONE());
            let bin = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, TOKEN_PERCENT(), left, right);
            left = ast_new_assign((*p).arena, loc_lf, loc_ll, loc_lc, left, bin);
        }
        else if t.kind == TOKEN_LPAREN() {
            // call: foo(a, b, ...)
            parser_advance(p, &t);
            let mut args: *u8 = 0 as *u8;
            let mut nargs: i64 = 0 as i64;
            let mut cap: i64 = 0 as i64;
            if parser_check(p, TOKEN_RPAREN()) == (0 as i32) {
                while true {
                    let arg = parse_expr(p, PREC_NONE());
                    if nargs >= cap {
                        cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                        let na = arena_alloc((*p).arena, cap * (8 as i64));
                        if args != (0 as *u8) {
                            if nargs > (0 as i64) { memcpy(na, args, nargs * (8 as i64)); }
                        }
                        args = na;
                    }
                    let slot = (args as i64 + nargs * (8 as i64)) as **Node;
                    *slot = arg;
                    nargs = nargs + (1 as i64);
                    if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) { break; }
                }
            }
            parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
            left = ast_new_call((*p).arena, loc_lf, loc_ll, loc_lc, left, args, nargs);
        }
        else if t.kind == TOKEN_DOT() {
            // field access: expr.field
            parser_advance(p, &t);
            let mut field_t = empty_token();
            parser_expect(p, TOKEN_IDENT(), "field name" as *u8, &field_t);
            let field_name = parser_tok_name(p, &field_t);
            left = ast_new_field((*p).arena, loc_lf, loc_ll, loc_lc, left, field_name);
        }
        else if t.kind == TOKEN_LBRACKET() {
            // index: a[i] or slice range: a[i..j]
            parser_advance(p, &t);
            let start = parse_expr(p, PREC_NONE());
            if parser_match(p, TOKEN_DOTDOT(), &t) != (0 as i32) {
                let end = parse_expr(p, PREC_NONE());
                parser_expect(p, TOKEN_RBRACKET(), "]" as *u8, &t);
                left = ast_new_slice_range((*p).arena, loc_lf, loc_ll, loc_lc, left, start, end);
            } else {
                parser_expect(p, TOKEN_RBRACKET(), "]" as *u8, &t);
                left = ast_new_index((*p).arena, loc_lf, loc_ll, loc_lc, left, start);
            }
        }
        else if t.kind == TOKEN_AS() {
            // as cast: expr as Type
            parser_advance(p, &t);
            let target = parse_type(p);
            left = ast_new_cast((*p).arena, loc_lf, loc_ll, loc_lc, left, target);
        }
        else {
            // binary op: +, -, *, /, %, ==, !=, <, >, <=, >=, &&, ||, |, ^, &, <<, >>
            parser_advance(p, &t);
            let op = t.kind;
            let right = parse_expr(p, prec + (1 as i32));
            left = ast_new_binary((*p).arena, loc_lf, loc_ll, loc_lc, op, left, right);
        }
    }
    return 0 as *Node;  // sentinel（while true 永远不退出；jhyy 类型检查需要）
}

// ════════════════════════════════════════════════════
// parse_let: let [mut] name [: type] = expr ;
// ════════════════════════════════════════════════════

fn parse_let(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'let'

    let mut is_mut = 0 as i32;
    if parser_match(p, TOKEN_MUT(), &t) != (0 as i32) {
        is_mut = 1 as i32;
    }

    parser_expect(p, TOKEN_IDENT(), "variable name" as *u8, &t);
    let vname = parser_tok_name(p, &t);

    // optional type annotation
    let mut type_annot: *Node = 0 as *Node;
    if parser_match(p, TOKEN_COLON(), &t) != (0 as i32) {
        type_annot = parse_type(p);
    }

    parser_expect(p, TOKEN_EQ(), "=" as *u8, &t);
    let init = parse_expr(p, PREC_NONE());
    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);

    let sym = symtab_insert((*p).current_scope, vname, SYM_VAR(),
                            0 as *u8, is_mut, (*p).scope_depth);
    return ast_new_let((*p).arena, loc_lf, loc_ll, loc_lc, is_mut, sym, type_annot, init);
}

// ════════════════════════════════════════════════════
// parse_return / parse_break / parse_continue / parse_expr_stmt
// ════════════════════════════════════════════════════

// parse_return: return [expr] ;
fn parse_return(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'return'

    let mut expr: *Node = 0 as *Node;
    if parser_check(p, TOKEN_SEMICOLON()) == (0 as i32) {
        if parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            expr = parse_expr(p, PREC_NONE());
        }
    }
    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);

    return ast_new_return((*p).arena, loc_lf, loc_ll, loc_lc, expr);
}

// parse_break: break ;
fn parse_break(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'break'
    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);

    return ast_new_break((*p).arena, loc_lf, loc_ll, loc_lc);
}

// parse_continue: continue ;
fn parse_continue(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'continue'
    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);

    return ast_new_continue((*p).arena, loc_lf, loc_ll, loc_lc);
}

// v1.3.6: defer fncall();
//   - Only allowed at function-body top level (scope_depth <= 2).
//   - sema validates expr is NODE_CALL / NODE_QUALIFIED_CALL.
fn parse_defer(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'defer'
    if (*p).scope_depth > (2 as i32) {
        jh_print_loc_stderr(loc_lf, loc_ll, loc_lc);
        jh_fputs_stderr("error: defer not allowed in nested scope (only at function-body top level)\n" as *u8);
        (*p).error_count = (*p).error_count + (1 as i32);
    }
    let expr = parse_expr(p, PREC_NONE());
    if parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
        if parser_check(p, TOKEN_EOF()) == (0 as i32) {
            parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);
        }
    }

    return ast_new_defer((*p).arena, loc_lf, loc_ll, loc_lc, expr);
}

// parse_expr_stmt: expr [;] — allow omitting ; before }
// commit 4 保留：parse_expr 现在是完整 Pratt（定义在 line ~200，本函数之后），
// parse_expr_stmt 仍是 5 处 inlined block dispatcher 的"表达式语句"入口。
fn parse_expr_stmt(p: *Parser) -> *Node {
    let mut t = empty_token();
    let expr = parse_expr(p, PREC_NONE());
    if expr != (0 as *Node) {
        // optional ; (not needed before } / EOF)
        if parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) == (0 as i32) {
                parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);
            }
        }
        return ast_new_expr_stmt((*p).arena, expr, (*expr).loc_line, (*expr).loc_col, expr);
    }
    return 0 as *Node;
}

// ════════════════════════════════════════════════════
// parse_pattern: 完整实现（commit 3）
// 对应 C 端 parser.c:113-204
// 自递归 OK（mutual recursion 走 internal calls 也 OK，因为所有 callee 都已定义）
// ════════════════════════════════════════════════════

fn parse_pattern(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);

    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    // ── TOKEN_IDENT 分支 ──
    if t.kind == TOKEN_IDENT() {
        // wildcard _
        if t.length == (1 as i64) {
            // t.start may not be 4-byte aligned; use aligned read
            let p_addr = t.start as i64;
            let aligned = p_addr & (~(3 as i64));
            let rem = (p_addr - aligned) as i32;
            let w = *((aligned) as *i32);
            let shift = rem * (8 as i32);
            let c0 = (w >> shift) & (255 as i32);
            if c0 == (95 as i32) {  // '_' = ASCII 95
                parser_advance(p, &t);
                return ast_new_pattern_wild((*p).arena, loc_lf, loc_ll, loc_lc);
            }
        }
        parser_advance(p, &t);

        // Name::Variant
        // 关键：outer ident 必须在 consume `::` 之前保存。
        // line 414 已经 consume 了 outer ident（prev_* 现在指向 outer ident）。
        // t.start/t.length 也还指向 outer ident。
        if parser_check(p, TOKEN_COLONCOLON()) != (0 as i32) {
            // outer ident 当前在 t 里（已 advance 过），先存
            let outer_name = arena_strdup((*p).arena, t.start, t.length);
            parser_advance(p, &t);  // consume ::
            parser_expect(p, TOKEN_IDENT(), "variant name" as *u8, &t);
            let vname = parser_tok_name(p, &t);
            let mut tsym = symtab_lookup((*p).current_scope, outer_name);
            if tsym == (0 as *Sym) {
                tsym = symtab_insert((*p).current_scope, outer_name, SYM_TYPE(),
                                     0 as *u8, 0 as i32, (*p).scope_depth);
            }
            let mut vsym = symtab_lookup((*p).current_scope, vname);
            if vsym == (0 as *Sym) {
                vsym = symtab_insert((*p).current_scope, vname, SYM_VAR(),
                                     0 as *u8, 0 as i32, (*p).scope_depth);
            }
            let mut inner: *Node = 0 as *Node;
            if parser_match(p, TOKEN_LPAREN(), &t) != (0 as i32) {
                inner = parse_pattern(p);
                parser_expect(p, TOKEN_RPAREN(), ") after enum pattern" as *u8, &t);
            }
            return ast_new_pattern_enum((*p).arena, loc_lf, loc_ll, loc_lc, tsym, vsym, inner);
        }

        // range lo..hi  —— hi 走 parse_expr（PREC_PRIMARY），commit 3 parse_expr 是 stub 返回 NULL
        if parser_match(p, TOKEN_DOTDOT(), &t) != (0 as i32) {
            let hi = parse_expr(p, PREC_PRIMARY());
            let lo_name = arena_strdup((*p).arena, t.start, t.length);
            let mut sym = symtab_lookup((*p).current_scope, lo_name);
            if sym == (0 as *Sym) {
                sym = symtab_insert((*p).current_scope, lo_name, SYM_VAR(),
                                    0 as *u8, 0 as i32, (*p).scope_depth);
            }
            let lo = ast_new_pattern_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
            return ast_new_pattern_range((*p).arena, loc_lf, loc_ll, loc_lc, lo, hi);
        }

        // short-name variant（v0.7 7A）：Name 解析到 SYM_VARIANT in global_scope
        //   Some(v) → NODE_PATTERN_ENUM + inner=v
        //   None    → NODE_PATTERN_ENUM + inner=NULL
        let ident_name = arena_strdup((*p).arena, t.start, t.length);
        let mut gsym = symtab_lookup((*p).global_scope, ident_name);
        if gsym != (0 as *Sym) {
            if (*gsym).kind == SYM_VARIANT() {
                if parser_check(p, TOKEN_LPAREN()) != (0 as i32) {
                    parser_advance(p, &t);  // consume (
                    let inner = parse_pattern(p);
                    parser_expect(p, TOKEN_RPAREN(), ") after enum pattern" as *u8, &t);
                    return ast_new_pattern_enum((*p).arena, loc_lf, loc_ll, loc_lc,
                                                0 as *Sym, gsym, inner);
                }
                // bare variant: None
                return ast_new_pattern_enum((*p).arena, loc_lf, loc_ll, loc_lc,
                                            0 as *Sym, gsym, 0 as *Node);
            }
        }

        // 普通 ident pattern（binding）
        let mut sym = symtab_lookup((*p).current_scope, ident_name);
        if sym == (0 as *Sym) {
            sym = symtab_insert((*p).current_scope, ident_name, SYM_VAR(),
                                0 as *u8, 0 as i32, (*p).scope_depth);
        }
        return ast_new_pattern_ident((*p).arena, loc_lf, loc_ll, loc_lc, sym);
    }

    // ── TOKEN_INT 分支 ──
    if t.kind == TOKEN_INT() {
        parser_advance(p, &t);
        let val = strtoll(t.start, 0 as *u8, 0 as i32);
        return ast_new_pattern_lit((*p).arena, loc_lf, loc_ll, loc_lc, val, PRIM_I32());
    }

    // ── TOKEN_BOOL 分支 ──
    if t.kind == TOKEN_BOOL() {
        parser_advance(p, &t);
        // "true" = 4 bytes; "false" = 5 bytes; check length + first 4 chars
        let mut val = 0 as i64;
        if t.length == (4 as i64) {
            let r = strncmp(t.start, "true" as *u8, 4 as i64);
            if r == (0 as i32) {
                val = 1 as i64;
            }
        }
        return ast_new_pattern_lit((*p).arena, loc_lf, loc_ll, loc_lc, val, PRIM_BOOL());
    }

    // ── TOKEN_CHAR 分支 ──
    if t.kind == TOKEN_CHAR() {
        parser_advance(p, &t);
        // t.start[0] = '\'', t.start[1] = char, t.start[2] = '\''
        // qbe_type_of(*u8) 默认 'b' bug（plan § 0 #6），绕开：4-byte aligned read + mask
        // 对齐 lexer.jhyy::lex_peek_char 的写法
        let p_addr = t.start as i64;
        let aligned = p_addr & (~(3 as i64));
        let rem = (p_addr - aligned) as i32;
        let w = *((aligned) as *i32);
        let shift = rem * (8 as i32);
        let masked = (w >> shift) & (255 as i32);
        let ch = masked & (255 as i32);
        return ast_new_pattern_lit((*p).arena, loc_lf, loc_ll, loc_lc, ch as i64, PRIM_U8());
    }

    // ── TOKEN_MINUS 分支 ──
    if t.kind == TOKEN_MINUS() {
        parser_advance(p, &t);  // consume '-'
        parser_expect(p, TOKEN_INT(), "integer after - in pattern" as *u8, &t);
        let val = strtoll(t.start, 0 as *u8, 0 as i32);
        return ast_new_pattern_lit((*p).arena, loc_lf, loc_ll, loc_lc, -val, PRIM_I32());
    }

    // ── default: error ──
    jh_print_loc_stderr(loc_lf, loc_ll, loc_lc);
    jh_fputs_stderr("error: unexpected token '" as *u8);
    jh_fputs_stderr(token_kind_name(t.kind));
    jh_fputs_stderr("' in pattern\n" as *u8);
    (*p).error_count = (*p).error_count + (1 as i32);
    parser_advance(p, &t);
    return 0 as *Node;
}

// ════════════════════════════════════════════════════
// parse_match: match expr { pat => body [, ...] }
// arm body 走 parse_expr stub（commit 3 限制：返回 NULL）
// ════════════════════════════════════════════════════

fn parse_match(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'match'

    let subj = parse_expr(p, PREC_NONE());
    parser_expect(p, TOKEN_LBRACE(), "{" as *u8, &t);

    let mut arms: *u8 = 0 as *u8;
    let mut narms: i64 = 0 as i64;
    let mut cap: i64 = 0 as i64;

    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
        if parser_check(p, TOKEN_EOF()) != (0 as i32) {
            break;
        }
        let mut pat: *Node = parse_pattern(p);
        // v1.3.7: OR pattern — left-associative loop on `|`.
        while parser_check(p, TOKEN_PIPE()) != (0 as i32) {
            parser_advance(p);
            let rloc_lf = (*pat).loc_filename;
            let rloc_ll = (*pat).loc_line;
            let rloc_lc = (*pat).loc_col;
            let right = parse_pattern(p);
            pat = ast_new_pattern_or((*p).arena, rloc_lf, rloc_ll, rloc_lc, pat, right);
        }
        parser_expect(p, TOKEN_FATARROW(), "=>" as *u8, &t);
        let body = parse_expr(p, PREC_NONE());

        // optional trailing comma
        let _x = parser_match(p, TOKEN_COMMA(), &t);

        let arm = ast_new_match_arm((*p).arena, loc_lf, loc_ll, loc_lc, pat, body);

        if narms >= cap {
            cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
            let na = arena_alloc((*p).arena, cap * (8 as i64));
            if arms != (0 as *u8) {
                if narms > (0 as i64) {
                    memcpy(na, arms, narms * (8 as i64));
                }
            }
            arms = na;
        }
        let slot = (arms as i64 + narms * (8 as i64)) as **Node;
        *slot = arm;
        narms = narms + (1 as i64);
    }

    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
    return ast_new_match((*p).arena, loc_lf, loc_ll, loc_lc, subj, arms, narms);
}

// ════════════════════════════════════════════════════
// parse_dispatch_simple_only: block body 里的"非控制流"语句 dispatcher
// ════════════════════════════════════════════════════
//
// v0.8 commit 6：抽取 helper 解决 parse_if / parse_for 缺 while/for 的问题。
// 原始 commit 3 设计是每个 block body inline 一份 dispatcher（避免 mutual recursion）。
// 但 inline dispatcher 在 parse_if body 漏 TOKEN_WHILE，在 parse_for body 漏 TOKEN_WHILE，
// 导致 while-inside-if / while-inside-for 报 CERR。
//
// 折中：dispatcher 拆成两部分：
//   1. **简单语句**（let/return/break/continue/match/expr_stmt）→ parse_dispatch_simple_only
//      在 parse_match 之后定义，可在 parse_if / parse_for / parse_while / parse_func
//      任意位置复用（不依赖 control flow parsers 的相对顺序）
//   2. **控制流**（if/while/for）→ 各自 dispatcher inline 加分支
//
// 这样：
//   - parse_if body 加 TOKEN_WHILE/TOKEN_FOR 分支（用内联 parse_while/parse_for 逻辑）
//   - parse_for body 加 TOKEN_WHILE 分支
//   - parse_while / parse_func body 已有全 dispatcher，保持不变
//
// 限制：parse_if 内部的 while body 不能嵌套 for/while（forward ref），
// parse_for 内部的 while body 不能嵌套 while。compiler 源码里的 while-inside-if
// 模式（util.jhyy hm_grow）body 只有 if/break/expr_stmt，正好够用。
//
// v0.9 wip commit 2.15 (Task #60 修): parse_if 内部的 while body 现在支持嵌套
// TOKEN_WHILE（if→while→while 模式, codegen.jhyy:2186-2206 + sema.jhyy:1150-1206
// 触发）。仍然不支持嵌套 TOKEN_FOR/TOKEN_MATCH（forward ref 限制）；src0/ 内
// for loop 数为 0, 不影响当前 main.jhyy 跑通。

fn parse_dispatch_simple_only(p: *Parser) -> *Node {
    if parser_check(p, TOKEN_LET()) != (0 as i32) {
        return parse_let(p);
    }
    if parser_check(p, TOKEN_RETURN()) != (0 as i32) {
        return parse_return(p);
    }
    if parser_check(p, TOKEN_BREAK()) != (0 as i32) {
        return parse_break(p);
    }
    if parser_check(p, TOKEN_CONTINUE()) != (0 as i32) {
        return parse_continue(p);
    }
    if parser_check(p, TOKEN_DEFER()) != (0 as i32) {
        return parse_defer(p);
    }
    if parser_check(p, TOKEN_MATCH()) != (0 as i32) {
        return parse_match(p);
    }
    return parse_expr_stmt(p);
}

// ════════════════════════════════════════════════════
// parse_if: inlined block body (commit 3 限制：block 内不支持 nested LBRACE)
// 顺序：parse_if 必须先于 parse_for 定义（parse_for 调 parse_if）
// ════════════════════════════════════════════════════

fn parse_if(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'if'

    let cond = parse_expr(p, PREC_NONE());

    // ── then body: inlined block parser ──
    parser_expect(p, TOKEN_LBRACE(), "{ after if condition" as *u8, &t);
    parser_push_scope(p);

    let mut then_stmts: *u8 = 0 as *u8;
    let mut nthen: i64 = 0 as i64;
    let mut tcap: i64 = 0 as i64;

    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
        if parser_check(p, TOKEN_EOF()) != (0 as i32) {
            break;
        }
        // v0.8 commit 6 dispatcher: simple_only helper + parse_if (self) +
        // parse_while + parse_for（inlined limited 版本 — 见下）
        let mut stmt: *Node = 0 as *Node;
        if parser_check(p, TOKEN_IF()) != (0 as i32) {
            stmt = parse_if(p);
        } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
            // ── inline parse_while（limited body：simple_only + parse_if） ──
            let mut wt = empty_token();
            parser_peek(p, &wt);
            let wlf = wt.loc_filename;
            let wll = wt.loc_line;
            let wlc = wt.loc_col;
            parser_advance(p, &wt);  // consume 'while'
            let wcond = parse_expr(p, PREC_NONE());
            parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &wt);
            parser_push_scope(p);
            let mut wstmts: *u8 = 0 as *u8;
            let mut wnstmts: i64 = 0 as i64;
            let mut wcap: i64 = 0 as i64;
            while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                let mut wstmt: *Node = 0 as *Node;
                if parser_check(p, TOKEN_IF()) != (0 as i32) {
                    wstmt = parse_if(p);
                } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
                    // ── inline parse_while（嵌套版,limited body: TOKEN_IF + simple_only）──
                    // Task #60 修:if → while → while 模式（codegen.jhyy:2186-2206,
                    //   sema.jhyy:1150-1206）需要内层 while body 支持 TOKEN_WHILE 嵌套。
                    //   不支持嵌套 for/while（forward ref）；src0/ 最大嵌套 3 满足。
                    let mut wt2 = empty_token();
                    parser_peek(p, &wt2);
                    let w2lf = wt2.loc_filename;
                    let w2ll = wt2.loc_line;
                    let w2lc = wt2.loc_col;
                    parser_advance(p, &wt2);  // consume 'while'
                    let w2cond = parse_expr(p, PREC_NONE());
                    parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &wt2);
                    parser_push_scope(p);
                    let mut w2stmts: *u8 = 0 as *u8;
                    let mut w2nstmts: i64 = 0 as i64;
                    let mut w2cap: i64 = 0 as i64;
                    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                        if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                        let mut w2stmt: *Node = 0 as *Node;
                        if parser_check(p, TOKEN_IF()) != (0 as i32) {
                            w2stmt = parse_if(p);
                        } else {
                            w2stmt = parse_dispatch_simple_only(p);
                        }
                        if w2stmt != (0 as *Node) {
                            if w2nstmts >= w2cap {
                                w2cap = if w2cap != (0 as i64) { w2cap * (2 as i64) } else { (8 as i64) };
                                let w2ns = arena_alloc((*p).arena, w2cap * (8 as i64));
                                if w2stmts != (0 as *u8) {
                                    if w2nstmts > (0 as i64) { memcpy(w2ns, w2stmts, w2nstmts * (8 as i64)); }
                                }
                                w2stmts = w2ns;
                            }
                            let w2slot = (w2stmts as i64 + w2nstmts * (8 as i64)) as **Node;
                            *w2slot = w2stmt;
                            w2nstmts = w2nstmts + (1 as i64);
                        }
                    }
                    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &wt2);
                    parser_pop_scope(p);
                    let w2body = ast_new_block((*p).arena, w2lf, w2ll, w2lc, w2stmts, w2nstmts);
                    wstmt = ast_new_while((*p).arena, w2lf, w2ll, w2lc, w2cond, w2body);
                } else {
                    wstmt = parse_dispatch_simple_only(p);
                }
                if wstmt != (0 as *Node) {
                    if wnstmts >= wcap {
                        wcap = if wcap != (0 as i64) { wcap * (2 as i64) } else { (8 as i64) };
                        let wns = arena_alloc((*p).arena, wcap * (8 as i64));
                        if wstmts != (0 as *u8) {
                            if wnstmts > (0 as i64) { memcpy(wns, wstmts, wnstmts * (8 as i64)); }
                        }
                        wstmts = wns;
                    }
                    let wslot = (wstmts as i64 + wnstmts * (8 as i64)) as **Node;
                    *wslot = wstmt;
                    wnstmts = wnstmts + (1 as i64);
                }
            }
            parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &wt);
            parser_pop_scope(p);
            let wbody = ast_new_block((*p).arena, wlf, wll, wlc, wstmts, wnstmts);
            stmt = ast_new_while((*p).arena, wlf, wll, wlc, wcond, wbody);
        } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
            // ── inline parse_for（limited body：simple_only + parse_if） ──
            let mut ft = empty_token();
            parser_peek(p, &ft);
            let flf = ft.loc_filename;
            let fll = ft.loc_line;
            let flc = ft.loc_col;
            parser_advance(p, &ft);  // consume 'for'
            parser_expect(p, TOKEN_IDENT(), "loop variable" as *u8, &ft);
            let fvname = parser_tok_name(p, &ft);
            parser_expect(p, TOKEN_IN(), "in" as *u8, &ft);
            let fstart = parse_expr(p, PREC_NONE());
            parser_expect(p, TOKEN_DOTDOT(), ".." as *u8, &ft);
            let fend = parse_expr(p, PREC_NONE());
            parser_expect(p, TOKEN_LBRACE(), "{ after for range" as *u8, &ft);
            parser_push_scope(p);
            let fsym = symtab_insert((*p).current_scope, fvname, SYM_VAR(),
                                    0 as *u8, 0 as i32, (*p).scope_depth);
            let mut fstmts: *u8 = 0 as *u8;
            let mut fnstmts: i64 = 0 as i64;
            let mut fcap: i64 = 0 as i64;
            while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                let mut fstmt: *Node = 0 as *Node;
                if parser_check(p, TOKEN_IF()) != (0 as i32) {
                    fstmt = parse_if(p);
                } else {
                    fstmt = parse_dispatch_simple_only(p);
                }
                if fstmt != (0 as *Node) {
                    if fnstmts >= fcap {
                        fcap = if fcap != (0 as i64) { fcap * (2 as i64) } else { (8 as i64) };
                        let fns = arena_alloc((*p).arena, fcap * (8 as i64));
                        if fstmts != (0 as *u8) {
                            if fnstmts > (0 as i64) { memcpy(fns, fstmts, fnstmts * (8 as i64)); }
                        }
                        fstmts = fns;
                    }
                    let fslot = (fstmts as i64 + fnstmts * (8 as i64)) as **Node;
                    *fslot = fstmt;
                    fnstmts = fnstmts + (1 as i64);
                }
            }
            parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &ft);
            parser_pop_scope(p);
            let fbody = ast_new_block((*p).arena, flf, fll, flc, fstmts, fnstmts);
            stmt = ast_new_for((*p).arena, flf, fll, flc, fsym, fstart, fend, fbody);
        } else {
            stmt = parse_dispatch_simple_only(p);
        }

        if stmt != (0 as *Node) {
            if nthen >= tcap {
                tcap = if tcap != (0 as i64) { tcap * (2 as i64) } else { (8 as i64) };
                let nt = arena_alloc((*p).arena, tcap * (8 as i64));
                if then_stmts != (0 as *u8) {
                    if nthen > (0 as i64) {
                        memcpy(nt, then_stmts, nthen * (8 as i64));
                    }
                }
                then_stmts = nt;
            }
            let slot = (then_stmts as i64 + nthen * (8 as i64)) as **Node;
            *slot = stmt;
            nthen = nthen + (1 as i64);
        }
    }

    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
    parser_pop_scope(p);
    let then_body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, then_stmts, nthen);

    // ── else body (optional) ──
    let mut else_body: *Node = 0 as *Node;
    if parser_match(p, TOKEN_ELSE(), &t) != (0 as i32) {
        if parser_check(p, TOKEN_IF()) != (0 as i32) {
            else_body = parse_if(p);
        } else {
            // inlined else block
            parser_expect(p, TOKEN_LBRACE(), "{ after else" as *u8, &t);
            parser_push_scope(p);
            let mut else_stmts: *u8 = 0 as *u8;
            let mut nelse: i64 = 0 as i64;
            let mut ecap: i64 = 0 as i64;
            while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                    break;
                }
                // v0.8 commit 6 dispatcher: simple_only + parse_if + inline limited while/for
                let mut stmt: *Node = 0 as *Node;
                if parser_check(p, TOKEN_IF()) != (0 as i32) {
                    stmt = parse_if(p);
                } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
                    // ── inline parse_while（limited body：simple_only + parse_if） ──
                    let mut wt = empty_token();
                    parser_peek(p, &wt);
                    let wlf = wt.loc_filename;
                    let wll = wt.loc_line;
                    let wlc = wt.loc_col;
                    parser_advance(p, &wt);
                    let wcond = parse_expr(p, PREC_NONE());
                    parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &wt);
                    parser_push_scope(p);
                    let mut wstmts: *u8 = 0 as *u8;
                    let mut wnstmts: i64 = 0 as i64;
                    let mut wcap: i64 = 0 as i64;
                    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                        if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                        let mut wstmt: *Node = 0 as *Node;
                        if parser_check(p, TOKEN_IF()) != (0 as i32) {
                            wstmt = parse_if(p);
                        } else {
                            wstmt = parse_dispatch_simple_only(p);
                        }
                        if wstmt != (0 as *Node) {
                            if wnstmts >= wcap {
                                wcap = if wcap != (0 as i64) { wcap * (2 as i64) } else { (8 as i64) };
                                let wns = arena_alloc((*p).arena, wcap * (8 as i64));
                                if wstmts != (0 as *u8) {
                                    if wnstmts > (0 as i64) { memcpy(wns, wstmts, wnstmts * (8 as i64)); }
                                }
                                wstmts = wns;
                            }
                            let wslot = (wstmts as i64 + wnstmts * (8 as i64)) as **Node;
                            *wslot = wstmt;
                            wnstmts = wnstmts + (1 as i64);
                        }
                    }
                    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &wt);
                    parser_pop_scope(p);
                    let wbody = ast_new_block((*p).arena, wlf, wll, wlc, wstmts, wnstmts);
                    stmt = ast_new_while((*p).arena, wlf, wll, wlc, wcond, wbody);
                } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                    // ── inline parse_for（limited body：simple_only + parse_if） ──
                    let mut ft = empty_token();
                    parser_peek(p, &ft);
                    let flf = ft.loc_filename;
                    let fll = ft.loc_line;
                    let flc = ft.loc_col;
                    parser_advance(p, &ft);
                    parser_expect(p, TOKEN_IDENT(), "loop variable" as *u8, &ft);
                    let fvname = parser_tok_name(p, &ft);
                    parser_expect(p, TOKEN_IN(), "in" as *u8, &ft);
                    let fstart = parse_expr(p, PREC_NONE());
                    parser_expect(p, TOKEN_DOTDOT(), ".." as *u8, &ft);
                    let fend = parse_expr(p, PREC_NONE());
                    parser_expect(p, TOKEN_LBRACE(), "{ after for range" as *u8, &ft);
                    parser_push_scope(p);
                    let fsym = symtab_insert((*p).current_scope, fvname, SYM_VAR(),
                                            0 as *u8, 0 as i32, (*p).scope_depth);
                    let mut fstmts: *u8 = 0 as *u8;
                    let mut fnstmts: i64 = 0 as i64;
                    let mut fcap: i64 = 0 as i64;
                    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                        if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                        let mut fstmt: *Node = 0 as *Node;
                        if parser_check(p, TOKEN_IF()) != (0 as i32) {
                            fstmt = parse_if(p);
                        } else {
                            fstmt = parse_dispatch_simple_only(p);
                        }
                        if fstmt != (0 as *Node) {
                            if fnstmts >= fcap {
                                fcap = if fcap != (0 as i64) { fcap * (2 as i64) } else { (8 as i64) };
                                let fns = arena_alloc((*p).arena, fcap * (8 as i64));
                                if fstmts != (0 as *u8) {
                                    if fnstmts > (0 as i64) { memcpy(fns, fstmts, fnstmts * (8 as i64)); }
                                }
                                fstmts = fns;
                            }
                            let fslot = (fstmts as i64 + fnstmts * (8 as i64)) as **Node;
                            *fslot = fstmt;
                            fnstmts = fnstmts + (1 as i64);
                        }
                    }
                    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &ft);
                    parser_pop_scope(p);
                    let fbody = ast_new_block((*p).arena, flf, fll, flc, fstmts, fnstmts);
                    stmt = ast_new_for((*p).arena, flf, fll, flc, fsym, fstart, fend, fbody);
                } else {
                    stmt = parse_dispatch_simple_only(p);
                }
                if stmt != (0 as *Node) {
                    if nelse >= ecap {
                        ecap = if ecap != (0 as i64) { ecap * (2 as i64) } else { (8 as i64) };
                        let ne = arena_alloc((*p).arena, ecap * (8 as i64));
                        if else_stmts != (0 as *u8) {
                            if nelse > (0 as i64) {
                                memcpy(ne, else_stmts, nelse * (8 as i64));
                            }
                        }
                        else_stmts = ne;
                    }
                    let slot = (else_stmts as i64 + nelse * (8 as i64)) as **Node;
                    *slot = stmt;
                    nelse = nelse + (1 as i64);
                }
            }
            parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
            parser_pop_scope(p);
            else_body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, else_stmts, nelse);
        }
    }

    return ast_new_if((*p).arena, loc_lf, loc_ll, loc_lc, cond, then_body, else_body);
}

// ════════════════════════════════════════════════════
// parse_for: inlined block body
// 顺序：在 parse_if 之后定义（block 内调 parse_if 处理 if-inside-for）
// ════════════════════════════════════════════════════

fn parse_for(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'for'

    parser_expect(p, TOKEN_IDENT(), "loop variable" as *u8, &t);
    let vname = parser_tok_name(p, &t);

    parser_expect(p, TOKEN_IN(), "in" as *u8, &t);

    let first_expr = parse_expr(p, PREC_NONE());

    // v1.3.4: disambiguate range form `for x in a..b` vs slice form `for x in slice { body }`.
    if parser_check(p, TOKEN_DOTDOT()) != (0 as i32) {
        // ── range form (existing) ──
        parser_expect(p, TOKEN_DOTDOT(), ".." as *u8, &t);
        let end = parse_expr(p, PREC_NONE());

        // ── body: inlined block (with parse_if for if-inside-for) ──
        parser_expect(p, TOKEN_LBRACE(), "{ after for range" as *u8, &t);
        parser_push_scope(p);
        let sym = symtab_insert((*p).current_scope, vname, SYM_VAR(),
                                0 as *u8, 0 as i32, (*p).scope_depth);

        let mut stmts: *u8 = 0 as *u8;
        let mut nstmts: i64 = 0 as i64;
        let mut cap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                break;
            }
            let mut stmt: *Node = 0 as *Node;
            if parser_check(p, TOKEN_IF()) != (0 as i32) {
                stmt = parse_if(p);
            } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                stmt = parse_for(p);
            } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
                let mut wt = empty_token();
                parser_peek(p, &wt);
                let wlf = wt.loc_filename;
                let wll = wt.loc_line;
                let wlc = wt.loc_col;
                parser_advance(p, &wt);
                let wcond = parse_expr(p, PREC_NONE());
                parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &wt);
                parser_push_scope(p);
                let mut wstmts: *u8 = 0 as *u8;
                let mut wnstmts: i64 = 0 as i64;
                let mut wcap: i64 = 0 as i64;
                while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                    if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                    let mut wstmt: *Node = 0 as *Node;
                    if parser_check(p, TOKEN_IF()) != (0 as i32) {
                        wstmt = parse_if(p);
                    } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                        wstmt = parse_for(p);
                    } else {
                        wstmt = parse_dispatch_simple_only(p);
                    }
                    if wstmt != (0 as *Node) {
                        if wnstmts >= wcap {
                            wcap = if wcap != (0 as i64) { wcap * (2 as i64) } else { (8 as i64) };
                            let wns = arena_alloc((*p).arena, wcap * (8 as i64));
                            if wstmts != (0 as *u8) {
                                if wnstmts > (0 as i64) { memcpy(wns, wstmts, wnstmts * (8 as i64)); }
                            }
                            wstmts = wns;
                        }
                        let wslot = (wstmts as i64 + wnstmts * (8 as i64)) as **Node;
                        *wslot = wstmt;
                        wnstmts = wnstmts + (1 as i64);
                    }
                }
                parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &wt);
                parser_pop_scope(p);
                let wbody = ast_new_block((*p).arena, wlf, wll, wlc, wstmts, wnstmts);
                stmt = ast_new_while((*p).arena, wlf, wll, wlc, wcond, wbody);
            } else {
                stmt = parse_dispatch_simple_only(p);
            }
            if stmt != (0 as *Node) {
                if nstmts >= cap {
                    cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                    let ns = arena_alloc((*p).arena, cap * (8 as i64));
                    if stmts != (0 as *u8) {
                        if nstmts > (0 as i64) {
                            memcpy(ns, stmts, nstmts * (8 as i64));
                        }
                    }
                    stmts = ns;
                }
                let slot = (stmts as i64 + nstmts * (8 as i64)) as **Node;
                *slot = stmt;
                nstmts = nstmts + (1 as i64);
            }
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
        parser_pop_scope(p);
        let body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, stmts, nstmts);

        return ast_new_for((*p).arena, loc_lf, loc_ll, loc_lc, sym, first_expr, end, body);
    }

    if parser_check(p, TOKEN_LBRACE()) != (0 as i32) {
        // ── slice form: `for x in slice { body }` — pre-desugar to
        //    `for i in 0..slice.len { let x = slice[i]; body }` ──
        let slice = first_expr;
        parser_push_scope(p);
        let i_sym = symtab_insert((*p).current_scope, "i" as *u8, SYM_VAR(),
                                  0 as *u8, 0 as i32, (*p).scope_depth);
        // bind x BEFORE body parse so prefix_ident doesn't auto-insert x (which would
        // collide with our injected `let x = slice[i]` later)
        let x_sym = symtab_insert((*p).current_scope, vname, SYM_VAR(),
                                  0 as *u8, 0 as i32, (*p).scope_depth);
        parser_expect(p, TOKEN_LBRACE(), "{ after for-in slice" as *u8, &t);

        let mut stmts: *u8 = 0 as *u8;
        let mut nstmts: i64 = 0 as i64;
        let mut cap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
            let mut stmt: *Node = 0 as *Node;
            if parser_check(p, TOKEN_IF()) != (0 as i32) {
                stmt = parse_if(p);
            } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                stmt = parse_for(p);
            } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
                let mut wt = empty_token();
                parser_peek(p, &wt);
                let wlf = wt.loc_filename;
                let wll = wt.loc_line;
                let wlc = wt.loc_col;
                parser_advance(p, &wt);
                let wcond = parse_expr(p, PREC_NONE());
                parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &wt);
                parser_push_scope(p);
                let mut wstmts: *u8 = 0 as *u8;
                let mut wnstmts: i64 = 0 as i64;
                let mut wcap: i64 = 0 as i64;
                while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
                    if parser_check(p, TOKEN_EOF()) != (0 as i32) { break; }
                    let mut wstmt: *Node = 0 as *Node;
                    if parser_check(p, TOKEN_IF()) != (0 as i32) {
                        wstmt = parse_if(p);
                    } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                        wstmt = parse_for(p);
                    } else {
                        wstmt = parse_dispatch_simple_only(p);
                    }
                    if wstmt != (0 as *Node) {
                        if wnstmts >= wcap {
                            wcap = if wcap != (0 as i64) { wcap * (2 as i64) } else { (8 as i64) };
                            let wns = arena_alloc((*p).arena, wcap * (8 as i64));
                            if wstmts != (0 as *u8) {
                                if wnstmts > (0 as i64) { memcpy(wns, wstmts, wnstmts * (8 as i64)); }
                            }
                            wstmts = wns;
                        }
                        let wslot = (wstmts as i64 + wnstmts * (8 as i64)) as **Node;
                        *wslot = wstmt;
                        wnstmts = wnstmts + (1 as i64);
                    }
                }
                parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &wt);
                parser_pop_scope(p);
                let wbody = ast_new_block((*p).arena, wlf, wll, wlc, wstmts, wnstmts);
                stmt = ast_new_while((*p).arena, wlf, wll, wlc, wcond, wbody);
            } else {
                stmt = parse_dispatch_simple_only(p);
            }
            if stmt != (0 as *Node) {
                if nstmts >= cap {
                    cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                    let ns = arena_alloc((*p).arena, cap * (8 as i64));
                    if stmts != (0 as *u8) {
                        if nstmts > (0 as i64) {
                            memcpy(ns, stmts, nstmts * (8 as i64));
                        }
                    }
                    stmts = ns;
                }
                let slot = (stmts as i64 + nstmts * (8 as i64)) as **Node;
                *slot = stmt;
                nstmts = nstmts + (1 as i64);
            }
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);

        let i_ident = ast_new_ident((*p).arena, loc_lf, loc_ll, loc_lc, i_sym);
        let index_node = ast_new_index((*p).arena, loc_lf, loc_ll, loc_lc, slice, i_ident);
        let let_x = ast_new_let((*p).arena, loc_lf, loc_ll, loc_lc,
                                0 as i32, x_sym, 0 as *Node, index_node);

        // prepend let x = slice[i]; to body stmts
        let new_stmts = arena_alloc((*p).arena, (nstmts + (1 as i64)) * (8 as i64));
        let slot0 = new_stmts as **Node;
        *slot0 = let_x;
        if nstmts > (0 as i64) {
            let dst = (new_stmts as i64 + (1 as i64) * (8 as i64)) as *u8;
            memcpy(dst, stmts, nstmts * (8 as i64));
        }
        let body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, new_stmts, nstmts + (1 as i64));
        parser_pop_scope(p);

        return ast_new_for_slice((*p).arena, loc_lf, loc_ll, loc_lc, i_sym, slice, body);
    }

    // Neither .. nor { — error
    let mut nt = empty_token();
    parser_peek(p, &nt);
    jh_print_loc_stderr(nt.loc_filename, nt.loc_line, nt.loc_col);
    jh_fputs_stderr("error: expected '..' or '{' after for-in expression, got " as *u8);
    jh_fputs_stderr(token_kind_name(nt.kind));
    jh_fputs_stderr("\n" as *u8);
    (*p).error_count = (*p).error_count + (1 as i32);
    return 0 as *Node;
}

// ════════════════════════════════════════════════════
// parse_while: inlined block body
// 顺序：在 parse_if / parse_for 之后定义（block 内调两者）
// ════════════════════════════════════════════════════

fn parse_while(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'while'

    let cond = parse_expr(p, PREC_NONE());

    // ── body: inlined block (with parse_if + parse_for for nested) ──
    parser_expect(p, TOKEN_LBRACE(), "{ after while condition" as *u8, &t);
    parser_push_scope(p);

    let mut stmts: *u8 = 0 as *u8;
    let mut nstmts: i64 = 0 as i64;
    let mut cap: i64 = 0 as i64;

    while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
        if parser_check(p, TOKEN_EOF()) != (0 as i32) {
            break;
        }
        // inlined dispatcher: shared 6 sub-stmts + self (parse_while) + parse_if + parse_for
        let mut stmt: *Node = 0 as *Node;
        if parser_check(p, TOKEN_LET()) != (0 as i32) {
            stmt = parse_let(p);
        } else if parser_check(p, TOKEN_RETURN()) != (0 as i32) {
            stmt = parse_return(p);
        } else if parser_check(p, TOKEN_BREAK()) != (0 as i32) {
            stmt = parse_break(p);
        } else if parser_check(p, TOKEN_CONTINUE()) != (0 as i32) {
            stmt = parse_continue(p);
        } else if parser_check(p, TOKEN_DEFER()) != (0 as i32) {
            stmt = parse_defer(p);
        } else if parser_check(p, TOKEN_MATCH()) != (0 as i32) {
            stmt = parse_match(p);
        } else if parser_check(p, TOKEN_IF()) != (0 as i32) {
            stmt = parse_if(p);
        } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
            stmt = parse_for(p);
        } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
            stmt = parse_while(p);
        } else {
            stmt = parse_expr_stmt(p);
        }
        if stmt != (0 as *Node) {
            if nstmts >= cap {
                cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                let ns = arena_alloc((*p).arena, cap * (8 as i64));
                if stmts != (0 as *u8) {
                    if nstmts > (0 as i64) {
                        memcpy(ns, stmts, nstmts * (8 as i64));
                    }
                }
                stmts = ns;
            }
            let slot = (stmts as i64 + nstmts * (8 as i64)) as **Node;
            *slot = stmt;
            nstmts = nstmts + (1 as i64);
        }
    }

    parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
    parser_pop_scope(p);
    let body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, stmts, nstmts);

    return ast_new_while((*p).arena, loc_lf, loc_ll, loc_lc, cond, body);
}

// ════════════════════════════════════════════════════
// parse_stmt: 顶层 dispatcher（C 端 parser.c:376-387 一致）
// 调所有 9 个 sub-stmt（parse_if/while/for/let/return/break/continue/match/expr_stmt）
// ════════════════════════════════════════════════════

fn parse_stmt(p: *Parser) -> *Node {
    if parser_check(p, TOKEN_LET())      != (0 as i32) { return parse_let(p); }
    if parser_check(p, TOKEN_IF())       != (0 as i32) { return parse_if(p); }
    if parser_check(p, TOKEN_WHILE())    != (0 as i32) { return parse_while(p); }
    if parser_check(p, TOKEN_FOR())      != (0 as i32) { return parse_for(p); }
    if parser_check(p, TOKEN_MATCH())    != (0 as i32) { return parse_match(p); }
    if parser_check(p, TOKEN_RETURN())   != (0 as i32) { return parse_return(p); }
    if parser_check(p, TOKEN_BREAK())    != (0 as i32) { return parse_break(p); }
    if parser_check(p, TOKEN_CONTINUE()) != (0 as i32) { return parse_continue(p); }
    if parser_check(p, TOKEN_DEFER())    != (0 as i32) { return parse_defer(p); }
    return parse_expr_stmt(p);
}

// ════════════════════════════════════════════════════
// parse_func: inlined block body (fn body 可含 if/while/for/match/let/...)
// 顺序：在所有 sub-stmts + parse_stmt 之后定义
// ════════════════════════════════════════════════════

fn parse_func(p: *Parser, is_extern: i32) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'fn'

    parser_expect(p, TOKEN_IDENT(), "function name" as *u8, &t);
    let fname = parser_tok_name(p, &t);

    // 注册到 global scope（递归调用支持）
    let sym = symtab_insert((*p).global_scope, fname, SYM_FN(),
                            0 as *u8, 0 as i32, 0 as i32);
    if is_extern != (0 as i32) {
        if sym != (0 as *Sym) {
            (*sym).is_extern = 1 as i32;
        }
    }

    parser_push_scope(p);

    parser_expect(p, TOKEN_LPAREN(), "(" as *u8, &t);
    let mut params: *u8 = 0 as *u8;
    let mut nparams: i64 = 0 as i64;
    let mut pcap: i64 = 0 as i64;

    while parser_check(p, TOKEN_RPAREN()) == (0 as i32) {
        if parser_check(p, TOKEN_EOF()) != (0 as i32) {
            break;
        }

        // 取参数名（在 parse_type 之前，因 parse_type 会改 t）
        parser_expect(p, TOKEN_IDENT(), "parameter name" as *u8, &t);
        let pname = parser_tok_name(p, &t);

        parser_expect(p, TOKEN_COLON(), ":" as *u8, &t);
        let ptype = parse_type(p);

        let psym = symtab_insert((*p).current_scope, pname, SYM_VAR(),
                                 0 as *u8, 0 as i32, (*p).scope_depth);

        if nparams >= pcap {
            pcap = if pcap != (0 as i64) { pcap * (2 as i64) } else { (4 as i64) };
            let np = arena_alloc((*p).arena, pcap * NODE_FUNC_DECL_PARAM_SIZE());
            if params != (0 as *u8) {
                if nparams > (0 as i64) {
                    memcpy(np, params, nparams * NODE_FUNC_DECL_PARAM_SIZE());
                }
            }
            params = np;
        }
        let pd = (params as i64 + nparams * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
        (*pd).sym = psym as *u8;
        (*pd).type_annot = ptype as *u8;
        nparams = nparams + (1 as i64);

        if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) {
            break;
        }
    }
    parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);

    // return type（可选）
    let mut ret_type: *Node = 0 as *Node;
    if parser_match(p, TOKEN_ARROW(), &t) != (0 as i32) {
        ret_type = parse_type(p);
    }

    // body: extern → ; ；否则 inlined block
    let mut body: *Node = 0 as *Node;
    if is_extern != (0 as i32) {
        let _x = parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);
        body = 0 as *Node;
    } else {
        // inlined fn body block
        parser_expect(p, TOKEN_LBRACE(), "{ in function body" as *u8, &t);
        let mut stmts: *u8 = 0 as *u8;
        let mut nstmts: i64 = 0 as i64;
        let mut cap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                break;
            }
            // inlined dispatcher: shared 6 sub-stmts + all 3 control flow (parse_if/while/for)
            let mut stmt: *Node = 0 as *Node;
            if parser_check(p, TOKEN_LET()) != (0 as i32) {
                stmt = parse_let(p);
            } else if parser_check(p, TOKEN_RETURN()) != (0 as i32) {
                stmt = parse_return(p);
            } else if parser_check(p, TOKEN_BREAK()) != (0 as i32) {
                stmt = parse_break(p);
            } else if parser_check(p, TOKEN_CONTINUE()) != (0 as i32) {
                stmt = parse_continue(p);
            } else if parser_check(p, TOKEN_DEFER()) != (0 as i32) {
                stmt = parse_defer(p);
            } else if parser_check(p, TOKEN_MATCH()) != (0 as i32) {
                stmt = parse_match(p);
            } else if parser_check(p, TOKEN_IF()) != (0 as i32) {
                stmt = parse_if(p);
            } else if parser_check(p, TOKEN_WHILE()) != (0 as i32) {
                stmt = parse_while(p);
            } else if parser_check(p, TOKEN_FOR()) != (0 as i32) {
                stmt = parse_for(p);
            } else {
                stmt = parse_expr_stmt(p);
            }
            if stmt != (0 as *Node) {
                if nstmts >= cap {
                    cap = if cap != (0 as i64) { cap * (2 as i64) } else { (8 as i64) };
                    let ns = arena_alloc((*p).arena, cap * (8 as i64));
                    if stmts != (0 as *u8) {
                        if nstmts > (0 as i64) {
                            memcpy(ns, stmts, nstmts * (8 as i64));
                        }
                    }
                    stmts = ns;
                }
                let slot = (stmts as i64 + nstmts * (8 as i64)) as **Node;
                *slot = stmt;
                nstmts = nstmts + (1 as i64);
            }
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
        body = ast_new_block((*p).arena, loc_lf, loc_ll, loc_lc, stmts, nstmts);
    }

    parser_pop_scope(p);

    return ast_new_func_decl((*p).arena, loc_lf, loc_ll, loc_lc,
                             sym, params, nparams, ret_type, body, is_extern);
}

// ════════════════════════════════════════════════════
// Declaration parsing
// ════════════════════════════════════════════════════

fn parse_type_decl(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'type'

    parser_expect(p, TOKEN_IDENT(), "type name" as *u8, &t);
    let tname = parser_tok_name(p, &t);

    parser_expect(p, TOKEN_EQ(), "=" as *u8, &t);

    let mut body: *Node = 0 as *Node;

    if parser_match(p, TOKEN_STRUCT(), &t) != (0 as i32) {
        // type Name = struct { ... }
        let body_loc_lf = (*p).prev_lf;
        let body_loc_ll = (*p).prev_ll;
        let body_loc_lc = (*p).prev_lc;

        parser_expect(p, TOKEN_LBRACE(), "{" as *u8, &t);

        let mut fields: *u8 = 0 as *u8;
        let mut nfields: i64 = 0 as i64;
        let mut fcap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                break;
            }

            // 字段名（在 parse_type 前保存）
            parser_expect(p, TOKEN_IDENT(), "field name" as *u8, &t);
            let fname = parser_tok_name(p, &t);

            parser_expect(p, TOKEN_COLON(), ":" as *u8, &t);
            let ftype = parse_type(p);

            if nfields >= fcap {
                fcap = if fcap != (0 as i64) { fcap * (2 as i64) } else { (8 as i64) };
                let nf = arena_alloc((*p).arena, fcap * STRUCT_FIELD_DECL_SIZE());
                if fields != (0 as *u8) {
                    if nfields > (0 as i64) {
                        memcpy(nf, fields, nfields * STRUCT_FIELD_DECL_SIZE());
                    }
                }
                fields = nf;
            }
            let fd = (fields as i64 + nfields * STRUCT_FIELD_DECL_SIZE()) as *StructFieldDecl;
            (*fd).name = fname;
            (*fd).type_annot = ftype as *u8;
            nfields = nfields + (1 as i64);

            if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) {
                break;
            }
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);
        body = ast_new_struct_def((*p).arena, body_loc_lf, body_loc_ll, body_loc_lc,
                                  fields, nfields);
    } else if parser_match(p, TOKEN_ENUM(), &t) != (0 as i32) {
        // type Name = enum { ... }
        let body_loc_lf = (*p).prev_lf;
        let body_loc_ll = (*p).prev_ll;
        let body_loc_lc = (*p).prev_lc;

        parser_expect(p, TOKEN_LBRACE(), "{" as *u8, &t);

        let mut variants: *u8 = 0 as *u8;
        let mut nvariants: i64 = 0 as i64;
        let mut vcap: i64 = 0 as i64;

        while parser_check(p, TOKEN_RBRACE()) == (0 as i32) {
            if parser_check(p, TOKEN_EOF()) != (0 as i32) {
                break;
            }

            parser_expect(p, TOKEN_IDENT(), "variant name" as *u8, &t);
            let vname = parser_tok_name(p, &t);

            // 可选 payload: Variant(Type)
            let mut payload_type: *Node = 0 as *Node;
            if parser_match(p, TOKEN_LPAREN(), &t) != (0 as i32) {
                payload_type = parse_type(p);
                parser_expect(p, TOKEN_RPAREN(), ")" as *u8, &t);
            }

            if nvariants >= vcap {
                vcap = if vcap != (0 as i64) { vcap * (2 as i64) } else { (8 as i64) };
                let nv = arena_alloc((*p).arena, vcap * ENUM_VARIANT_DECL_SIZE());
                if variants != (0 as *u8) {
                    if nvariants > (0 as i64) {
                        memcpy(nv, variants, nvariants * ENUM_VARIANT_DECL_SIZE());
                    }
                }
                variants = nv;
            }
            let vd = (variants as i64 + nvariants * ENUM_VARIANT_DECL_SIZE()) as *EnumVariantDecl;
            (*vd).name = vname;
            (*vd).payload_type = payload_type as *u8;
            nvariants = nvariants + (1 as i64);

            if parser_match(p, TOKEN_COMMA(), &t) == (0 as i32) {
                break;
            }
        }

        parser_expect(p, TOKEN_RBRACE(), "}" as *u8, &t);

        // v0.7 7A: register variant names in global_scope so short-name pattern
        // `match x { Some(v) => ... }` can resolve at parse time.
        let mut vi: i64 = 0 as i64;
        while vi < nvariants {
            let vdi = (variants as i64 + vi * ENUM_VARIANT_DECL_SIZE()) as *EnumVariantDecl;
            if symtab_lookup_local((*p).global_scope, (*vdi).name) == (0 as *Sym) {
                let _vs = symtab_insert((*p).global_scope, (*vdi).name, SYM_VARIANT(),
                                        0 as *u8, 0 as i32, 0 as i32);
            }
            vi = vi + (1 as i64);
        }

        body = ast_new_enum_def((*p).arena, body_loc_lf, body_loc_ll, body_loc_lc,
                                variants, nvariants);
    } else {
        // type alias: type Name = OtherType
        let alias_type = parse_type(p);
        body = alias_type;
    }

    let sym = symtab_insert((*p).global_scope, tname, SYM_TYPE(),
                            0 as *u8, 0 as i32, 0 as i32);
    return ast_new_type_decl((*p).arena, loc_lf, loc_ll, loc_lc, sym, body);
}

fn parse_extern_decl(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_advance(p, &t);  // consume 'extern'
    return parse_func(p, 1 as i32);
}

// v0.7 7B: parse `const NAME: [T; N] = [elem, ...];`
//   v0.9 wip commit 2.20 / Task #52: NODE_CONST_DECL 翻译补全,让 jhyy_v1 编
//   const_array.jhyy 不再 parser CERR, stage1 byte-equal 6/7 → 7/7。
fn parse_const_decl(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'const'

    parser_expect(p, TOKEN_IDENT(), "const name" as *u8, &t);
    let cname = parser_tok_name(p, &t);

    parser_expect(p, TOKEN_COLON(), ": after const name" as *u8, &t);

    // type annotation — must be [T; N]; reuse parse_type
    let type_annot = parse_type(p);

    parser_expect(p, TOKEN_EQ(), "= after const type" as *u8, &t);

    // init: [elem, elem, ...]
    let mut t2 = empty_token();
    parser_expect(p, TOKEN_LBRACKET(), "[ for const array init" as *u8, &t2);
    let lbr_lf = t2.loc_filename;
    let lbr_ll = t2.loc_line;
    let lbr_lc = t2.loc_col;
    let mut elems: *u8 = 0 as *u8;
    let mut nelems: i64 = 0 as i64;
    let mut dcap: i64 = 0 as i64;
    if parser_check(p, TOKEN_RBRACKET()) == (0 as i32) {
        let mut done: i32 = 0 as i32;
        while done == (0 as i32) {
            let elem = parse_expr(p, PREC_NONE());
            // grow array if needed (double capacity, initial 8)
            if nelems >= dcap {
                let mut ncap: i64 = 0 as i64;
                if dcap != (0 as i64) {
                    ncap = dcap * (2 as i64);
                } else {
                    ncap = 8 as i64;
                }
                let new_buf = arena_alloc((*p).arena, ncap * (8 as i64));
                if elems != (0 as *u8) {
                    if nelems > (0 as i64) {
                        let mut k: i64 = 0 as i64;
                        while k < nelems {
                            let src_slot = ptr_add_u8(elems, k * (8 as i64)) as **Node;
                            let dst_slot = ptr_add_u8(new_buf, k * (8 as i64)) as **Node;
                            *dst_slot = *src_slot;
                            k = k + (1 as i64);
                        }
                    }
                }
                elems = new_buf;
                dcap = ncap;
            }
            let slot = ptr_add_u8(elems, nelems * (8 as i64)) as **Node;
            *slot = elem;
            nelems = nelems + (1 as i64);
            if parser_match(p, TOKEN_COMMA(), &t2) == (0 as i32) {
                done = 1 as i32;
            }
        }
    }
    parser_expect(p, TOKEN_RBRACKET(), "] after const array init" as *u8, &t);
    let init = ast_new_array_lit((*p).arena, lbr_lf, lbr_ll, lbr_lc, elems, nelems);

    parser_expect(p, TOKEN_SEMICOLON(), "; after const decl" as *u8, &t);

    let sym = symtab_insert((*p).global_scope, cname, SYM_CONST(),
                            0 as *u8, 0 as i32, 0 as i32);
    return ast_new_const_decl((*p).arena, loc_lf, loc_ll, loc_lc, sym, type_annot, init);
}

fn parse_import_decl(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    parser_advance(p, &t);  // consume 'import'

    parser_expect(p, TOKEN_IDENT(), "module name" as *u8, &t);
    let mname = parser_tok_name(p, &t);
    parser_expect(p, TOKEN_SEMICOLON(), ";" as *u8, &t);

    let sym = symtab_insert((*p).global_scope, mname, SYM_MODULE(),
                            0 as *u8, 0 as i32, 0 as i32);
    return ast_new_import_decl((*p).arena, loc_lf, loc_ll, loc_lc, sym);
}

// v0.9 wip commit 2.20 / Task #52: parse_decl 移到 parse_import_decl 之后
//   (parse_decl 调 parse_import_decl; jhyy 无 forward ref 解析)
fn parse_decl(p: *Parser) -> *Node {
    if parser_check(p, TOKEN_FN()) != (0 as i32) {
        return parse_func(p, 0 as i32);
    }
    if parser_check(p, TOKEN_TYPE()) != (0 as i32) {
        return parse_type_decl(p);
    }
    if parser_check(p, TOKEN_EXTERN()) != (0 as i32) {
        return parse_extern_decl(p);
    }
    if parser_check(p, TOKEN_IMPORT()) != (0 as i32) {
        return parse_import_decl(p);
    }
    if parser_check(p, TOKEN_CONST()) != (0 as i32) {
        return parse_const_decl(p);
    }
    // 未识别顶层 token → 走 parse_stmt 兜底
    return parse_stmt(p);
}

// ════════════════════════════════════════════════════
// parser_init + parser_parse
// ════════════════════════════════════════════════════

fn parser_init(p: *Parser, lex: *Lexer, a: *Arena) -> i32 {
    (*p).lexer = lex;
    (*p).arena = a;
    (*p).error_count = 0 as i32;
    (*p).scope_depth = 0 as i32;
    (*p).prev_kind = 0 as i32;
    (*p).prev_start = 0 as *u8;
    (*p).prev_length = 0 as i64;
    (*p).prev_lf = 0 as *u8;
    (*p).prev_ll = 0 as i32;
    (*p).prev_lc = 0 as i32;
    (*p).global_scope = symtab_new(a, 0 as *u8);
    (*p).current_scope = (*p).global_scope;
    return 0;
}

fn parser_parse(p: *Parser) -> *Node {
    let mut t = empty_token();
    parser_peek(p, &t);
    let loc_lf = t.loc_filename;
    let loc_ll = t.loc_line;
    let loc_lc = t.loc_col;

    let mut decls: *u8 = 0 as *u8;
    let mut ndecls: i64 = 0 as i64;
    let mut dcap: i64 = 0 as i64;

    while parser_check(p, TOKEN_EOF()) == (0 as i32) {
        let decl = parse_decl(p);
        if decl != (0 as *Node) {
            if ndecls >= dcap {
                dcap = if dcap != (0 as i64) { dcap * (2 as i64) } else { (16 as i64) };
                let nd = arena_alloc((*p).arena, dcap * (8 as i64));
                if decls != (0 as *u8) {
                    if ndecls > (0 as i64) {
                        memcpy(nd, decls, ndecls * (8 as i64));
                    }
                }
                decls = nd;
            }
            let slot = (decls as i64 + ndecls * (8 as i64)) as **Node;
            *slot = decl;
            ndecls = ndecls + (1 as i64);
        }
    }

    return ast_new_module((*p).arena, loc_lf, loc_ll, loc_lc, decls, ndecls);
}
