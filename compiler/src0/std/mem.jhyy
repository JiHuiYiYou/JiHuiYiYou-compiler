// mem.jhyy — v3.2.2 (3l.1) std lib 起步:memcpy/memcmp/memset 纯 jhyy byte 循环。
//
// M0 简化(per `docs/plans/v3/v3.2.2-plan.md` + 2026-09-09 user 决定):
//   - 不依赖 closure / generic / 借用
//   - 自实现 byte 循环(不调 libc memcpy/memcmp/memset),保证 std lib 不依赖 libc 运行时
//   - 不跨 import 模块(避免 mangle 复杂度;ptr_add 本地实现)
//   - 失败语义:长度 < 0 返 0/null(不允许);长度 0 是 no-op
//
// API:
//   mem_copy(dst, src, n)        -> 复制 n 字节;返回 dst
//   mem_compare(a, b, n)         -> 比较 n 字节:0 equal / <0 a<b / >0 a>b
//   mem_set(dst, val, n)         -> n 字节设为 val (低 8 位);返回 dst
//   mem_find_byte(p, n, val)     -> 找第一个 == val 的字节;返回 index / -1
//   mem_zero(dst, n)             -> n 字节清零;返回 dst
//
// 测试:`compiler/tests/examples/std_mem_*.jhyy` (5+ 测试)

// ════════════════════════════════════════════════════
// ptr_add — 本地指针算术 helper
// ════════════════════════════════════════════════════
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}

// ════════════════════════════════════════════════════
// mem_copy — 复制 n 字节从 src 到 dst
// 语义跟 libc memcpy 一致:不处理 overlap;overlap 用 memmove(M0 不实现)
// ════════════════════════════════════════════════════
fn mem_copy(dst: *u8, src: *u8, n: i64) -> *u8 {
    if n < (0 as i64) {
        return 0 as *u8;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let d = ptr_add(dst, i);
        let s = ptr_add(src, i);
        let v: i32 = *(s as *i32) & (0xff as i32);
        *(d as *i32) = v;
        i = i + (1 as i64);
    }
    return dst;
}

// ════════════════════════════════════════════════════
// mem_compare — 比较 n 字节
// ════════════════════════════════════════════════════
fn mem_compare(a: *u8, b: *u8, n: i64) -> i32 {
    if n < (0 as i64) {
        return 0 as i32;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let av: i32 = *(ptr_add(a, i) as *i32) & (0xff as i32);
        let bv: i32 = *(ptr_add(b, i) as *i32) & (0xff as i32);
        if av != bv {
            if av < bv {
                return 0 as i32 - (1 as i32);
            }
            return 1;
        }
        i = i + (1 as i64);
    }
    return 0 as i32;
}

// ════════════════════════════════════════════════════
// mem_set — 把 n 字节设为 val (低 8 位)
// ════════════════════════════════════════════════════
fn mem_set(dst: *u8, val: i32, n: i64) -> *u8 {
    if n < (0 as i64) {
        return 0 as *u8;
    }
    let b: i32 = val & (0xff as i32);
    let mut i: i64 = 0 as i64;
    while i < n {
        *(ptr_add(dst, i) as *i32) = b;
        i = i + (1 as i64);
    }
    return dst;
}

// ════════════════════════════════════════════════════
// mem_find_byte — 在 n 字节内找第一个 == val 的字节
// ════════════════════════════════════════════════════
fn mem_find_byte(p: *u8, n: i64, val: i32) -> i64 {
    if n < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    let b: i32 = val & (0xff as i32);
    let mut i: i64 = 0 as i64;
    while i < n {
        let v: i32 = *(ptr_add(p, i) as *i32) & (0xff as i32);
        if v == b {
            return i;
        }
        i = i + (1 as i64);
    }
    return 0 as i64 - (1 as i64);
}

// ════════════════════════════════════════════════════
// mem_zero — 等价 mem_set(p, 0, n)
// ════════════════════════════════════════════════════
fn mem_zero(dst: *u8, n: i64) -> *u8 {
    return mem_set(dst, 0 as i32, n);
}
