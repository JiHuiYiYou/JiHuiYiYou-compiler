// os.jhyy — v3.2.3 (3l.2) std lib OS:syscall wrappers (open/read/write/exit/getenv)。
//
// M0 简化(per `docs/plans/v3/v3.2.3-plan.md` + 2026-09-10 user 决定):
//   - 不依赖 closure / generic / 借用
//   - 不依赖 std::mem / std::string(避免 cross-module import — 见 W-077 根因)
//   - 不 export cap / fd table(M11 OS launch 后再做 v3.x 中)
//   - 全部 fn 用 std_os_* 前缀(W-076 风格 + plan § 风险 R6 明确要求:
//     std lib 不能跟 runtime.c C-side symbol name 冲突)
//
// API:
//   std_os_open(path, flags, mode)   -> fd (i64) / -1 on fail
//   std_os_close(fd)                -> 0 ok / -1 fail
//   std_os_read(fd, buf, n)         -> 实际读字节数 / -1 on fail
//   std_os_write(fd, buf, n)        -> 实际写字节数 / -1 on fail
//   std_os_exit(code)               -> 终止进程(never returns)
//   std_os_getenv(name)             -> env value cstr / 0 on miss
//
// ════════════════════════════════════════════════════════════════════════════
// W-103 (2026-10-20 真修):std_os_* 现在是**真 I/O**,不再是 M0 mock
// ════════════════════════════════════════════════════════════════════════════
// 之前这五个函数全是 mock:open 恒返 fd=42、read/write 恒返 n(声称做了,
// 但 buf 一个字节都没动)、exit 只是 `let _ignore = code; return;`(进程不退出)。
//
// M0 的理由是 W-079「QBE amd64_win mixed (l,w,w) extern args bug」——
// QBE 随 v4.0.0 完全移除,self-backend(codegen_amd64_*)不再经过 QBE,
// 那个理由早已失效。W-079 在 2026-09-28 翻 RESOLVED 时只声明了 mixed-args
// 与 zero-extend 两件事由 W-080 解决,W-080 实际只动了 std/io.jhyy。
// **stdio 那半修了,std_os 这半没人动过,而 W-079 的 ✅ 把整个表面盖住了。**
//
// 现在走 jhyy_helpers.c 的 5 个 libc bridge(W-103 新增):
//   jh_os_open / jh_os_close / jh_os_read / jh_os_write / jh_os_exit
// 签名跟下面的 std_os_* **1:1 对齐**,jhyy 侧零宽度转换。
//
// ⚠️ 方向张力(必记,见 docs/internal/workarounds.md W-103):
// 这 5 个 bridge 让 jhyy 程序**又依赖 C runtime**,与 M5「删 C runtime /
// 0-C 闭环」方向相反。取舍:std_os_* 是 POSIX 语义层,OS kernel M11 launch
// 之前由 host libc 兑现最省事。真要 0-C 时,换掉的是 bridge 的**实现**
// (改成 syscall / kernel call),本文件的 std_os_* 一行都不用动。
//
// ⚠️ flag 语义:下面的 O_* 常量是 **POSIX 值**(O_CREAT=0x40 …),
// 与 Windows 的 _O_* (O_CREAT=0x100)不同。平台差异由 bridge 翻译,
// jhyy 侧保持 POSIX 语义。
// ════════════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════
// FFI — 真 libc bridge (jhyy_helpers.c, W-103)
// ════════════════════════════════════════════════════
//
// 签名与 std_os_* 逐个对齐:
//   jh_os_open (const char*, int, int)              -> long long
//   jh_os_close(long long)                          -> int
//   jh_os_read (long long, void*, long long)        -> long long
//   jh_os_write(long long, const void*, long long) -> long long
//   jh_os_exit (int)                                -> void
extern fn jh_os_open(path: *u8, flags: i32, mode: i32) -> i64;
extern fn jh_os_close(fd: i64) -> i32;
extern fn jh_os_read(fd: i64, buf: *u8, n: i64) -> i64;
extern fn jh_os_write(fd: i64, buf: *u8, n: i64) -> i64;
extern fn jh_os_exit(code: i32);

// jh_getenv — read env var (jh_helpers.c v2.5.0)
extern fn jh_getenv(name: *u8) -> *u8;

// ════════════════════════════════════════════════════
// POSIX open flag constants(POSIX 值 —— 平台差异由 bridge 翻译)
// ════════════════════════════════════════════════════
fn OS_O_RDONLY() -> i32 { return 0 as i32; }
fn OS_O_WRONLY() -> i32 { return 1 as i32; }
fn OS_O_RDWR()   -> i32 { return 2 as i32; }
fn OS_O_CREAT()  -> i32 { return 64 as i32; }     // 0x40
fn OS_O_TRUNC()  -> i32 { return 512 as i32; }    // 0x200
fn OS_O_APPEND() -> i32 { return 1024 as i32; }   // 0x400

// POSIX mode bits(0644 = 0x1A4)
fn OS_MODE_RW_R() -> i32 { return 420 as i32; }   // 0644

// ════════════════════════════════════════════════════
// File descriptor API — 真实现(W-103)
// ════════════════════════════════════════════════════

// std_os_open — open(2) wrapper
//   返回 fd (i64) / -1 on fail / -1 if path/flags invalid
fn std_os_open(path: *u8, flags: i32, mode: i32) -> i64 {
    // 输入验证 (跟 libc open() 错误语义对齐):
    //   path == 0 → -1 (EINVAL)
    //   flags < 0  → -1 (EINVAL)
    //   mode < 0   → -1 (EINVAL)
    //   mode > 0777 → -1 (EINVAL)
    if path == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if flags < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode > (511 as i32) {
        return 0 as i64 - (1 as i64);
    }
    return jh_os_open(path, flags, mode);
}

// std_os_close — close(2) wrapper
fn std_os_close(fd: i64) -> i32 {
    if fd < (0 as i64) {
        return 0 as i32 - (1 as i32);
    }
    return jh_os_close(fd);
}

// std_os_read — read(2) wrapper
//   返回实际读到的字节数;EOF 返回 0;出错返回 -1
fn std_os_read(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return jh_os_read(fd, buf, n);
}

// std_os_write — write(2) wrapper
//   返回实际写出的字节数;出错返回 -1
fn std_os_write(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return jh_os_write(fd, buf, n);
}

// ════════════════════════════════════════════════════
// Process API — 真实现(真退出进程)
// ════════════════════════════════════════════════════

// std_os_exit — 终止进程(exit(3))
//   never returns(真不返回:bridge 调 libc exit())
fn std_os_exit(code: i32) {
    jh_os_exit(code);
    return;
}

// ════════════════════════════════════════════════════
// Environment API(jh_getenv extern — verified work)
// ════════════════════════════════════════════════════

// std_os_getenv — 读环境变量
//   返回 env value cstr / 0 on miss
fn std_os_getenv(name: *u8) -> *u8 {
    return jh_getenv(name);
}
