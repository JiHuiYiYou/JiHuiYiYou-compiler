// os.jhyy — v3.2.3 (3l.2) std lib OS:syscall wrappers (open/read/write/exit/getenv)。
//
// M0 简化(per `docs/plans/v3/v3.2.3-plan.md` + 2026-09-10 user 决定):
//   - 不依赖 closure / generic / 借用
//   - 不依赖 std::mem / std::string(避免 cross-module import — 见 W-077 根因)
//   - 不 export cap / fd table(M11 OS launch 后再做 v3.x 中)
//   - 全部 fn 用 std_os_* 前缀(W-076 风格 + plan § 风险 R6 明确要求:
//     std lib 不能跟 runtime.c C-side symbol name 冲突)
//
// API:
//   std_os_open(path, flags, mode)   -> fd (i64) / -1 on fail
//   std_os_close(fd)                -> 0 ok / -1 fail
//   std_os_read(fd, buf, n)         -> 实际读字节数 / -1 on fail
//   std_os_write(fd, buf, n)        -> 实际写字节数 / -1 on fail
//   std_os_exit(code)               -> 终止进程(never returns)
//   std_os_getenv(name)             -> env value cstr / 0 on miss
//
// ════════════════════════════════════════════════════════════════════════════
// W-079: QBE amd64_win mixed (l, w, w) args bug + i32 return zero-extension
// 现象:QBE 不 emit 完整 arg register 装载 给 extern fn (l path, w flags, w mode),
//       extern fn 拿 uninitialized registers → 行为未定义。
// 现象2:QBE 在 main_jhyy 末尾 return i32 from extern i32 result 时,不 emit
//       `movl %eax, %eax` zero-extend → bash exit code 拿到 garbage upper bits。
// 影响:std_os_open / std_os_read / std_os_write 不可在 M0 跑通 (Phase 1)。
// workaround:
//   M0 Phase 1 — std_os_* API 表面 ship,但 std_os_open / read / write 用
//   stub 实现(verify args + return success / -1 based on input validation)。
//   实际 libc POSIX 集成留 v3.x 中,等 self-backend (codegen_amd64) 修 QBE
//   bug 后回退。或者 QBE upstream patch + 重编 qbe/qbe.exe (per v2.x 中
//   QBE 自写 sprint 计划)。
//
// M0 设计意图:
//   - API surface (fn signature + 错误语义) 锁;OS kernel M11 launch 时只
//     换 impl,不改 user code。
//   - std_os_getenv + std_os_exit + std_os_open stub (verify args + return -1
//     on invalid input) 跑 5/5 PASS,验证 jhyy-side jh_getenv (extern fn →
//     pointer return) 工作正常。
//   - std_os_read / write / close stub 同上。
// ════════════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════
// FFI(只走已验证的 1-arg + pointer-return pattern,绕开 W-079)
// ════════════════════════════════════════════════════

// jh_getenv — read env var (jh_helpers.c v2.5.0)
// extern fn → pointer return → QBE amd64_win 已知 OK pattern
extern fn jh_getenv(name: *u8) -> *u8;

// ════════════════════════════════════════════════════
// POSIX open flag constants (M0 子集, 跟 fcntl.h 一致)
// ════════════════════════════════════════════════════
fn OS_O_RDONLY() -> i32 { return 0 as i32; }
fn OS_O_WRONLY() -> i32 { return 1 as i32; }
fn OS_O_RDWR()   -> i32 { return 2 as i32; }
fn OS_O_CREAT()  -> i32 { return 64 as i32; }     // 0x40
fn OS_O_TRUNC()  -> i32 { return 512 as i32; }    // 0x200
fn OS_O_APPEND() -> i32 { return 1024 as i32; }   // 0x400

// POSIX mode bits(M0 子集,owner-only 写 0644 = 0x1A4)
fn OS_MODE_RW_R() -> i32 { return 420 as i32; }   // 0644

// ════════════════════════════════════════════════════
// File descriptor API (M0 stub — see W-079)
// ════════════════════════════════════════════════════

// std_os_open — open(2) wrapper (M0 stub)
//   返回 fd (i64) / -1 on fail / -1 if path/flags invalid
//   Phase 2+: 接 libc open() (W-079 修后)
fn std_os_open(path: *u8, flags: i32, mode: i32) -> i64 {
    // 输入验证 (跟 future libc open() 错误语义对齐):
    //   path == 0 → -1 (EINVAL)
    //   flags < 0  → -1 (EINVAL)
    //   mode < 0   → -1 (EINVAL)
    //   mode > 0777 → -1 (EINVAL)
    // M0 stub:验证失败 → -1;验证成功 → 返回模拟 fd=42 (Phase 2 替换)
    if path == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if flags < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode < (0 as i32) {
        return 0 as i64 - (1 as i64);
    }
    if mode > (511 as i32) {
        return 0 as i64 - (1 as i64);
    }
    // M0 stub:模拟成功 fd(Phase 2 接 libc open 后,return real fd)
    return 42 as i64;
}

// std_os_close — close(2) wrapper (M0 stub)
fn std_os_close(fd: i64) -> i32 {
    if fd < (0 as i64) {
        return 0 as i32 - (1 as i32);
    }
    // M0 stub:模拟成功(Phase 2 接 libc close)
    return 0;
}

// std_os_read — read(2) wrapper (M0 stub)
fn std_os_read(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    // M0 stub:模拟读到 n 字节(Phase 2 接 libc read)
    return n;
}

// std_os_write — write(2) wrapper (M0 stub)
fn std_os_write(fd: i64, buf: *u8, n: i64) -> i64 {
    if fd < (0 as i64) {
        return 0 as i64 - (1 as i64);
    }
    if buf == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    // M0 stub:模拟写入 n 字节(Phase 2 接 libc write)
    return n;
}

// ════════════════════════════════════════════════════
// Process API(M0 stub for exit — never returns in real impl)
// ════════════════════════════════════════════════════

// std_os_exit — 终止进程(exit(3))
//   never returns
//   Phase 2+:接 libc exit() (M0 stub 不调 exit,avoid QBE bug 触发现实进程退出)
fn std_os_exit(code: i32) {
    // M0 stub:不调 exit,设置 internal marker(Phase 2 接 libc exit)
    // 通过 asm volatile 内存屏障 (M0 简化 → just assign to global dummy)
    let _ignore = code;
    // unreachable 但 jhyy codegen 需要
    return;
}

// ════════════════════════════════════════════════════
// Environment API(jh_getenv extern — verified work)
// ════════════════════════════════════════════════════

// std_os_getenv — 读环境变量
//   返回 env value cstr / 0 on miss
fn std_os_getenv(name: *u8) -> *u8 {
    return jh_getenv(name);
}
