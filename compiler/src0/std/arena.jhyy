// arena.jhyy — v3.2.2 (3l.1) std lib 起步:API-equivalent arena allocator。
//
// D22 arena byte-equal v0.x C arena.c: deferred (W-074), 因 v2.x 中末在重写
//   codegen, 现在追 byte-equal 必被覆写。v3.2.4 再回头追 byte-equal。
//
// M0 简化(per `docs/archive/plans/v3/v3.2.2-plan.md`):
//   - 不依赖 closure / generic / 借用
//   - API 等价 compiler/src0/arena.jhyy 的 4 个 fn(arena_init / arena_alloc /
//     arena_calloc / arena_reset),signature + 行为兼容
//   - 内部 jhyy-side 实现(不 import src0/arena.jhyy,避免 mangle 复杂度;
//     两个 Arena 并存:compiler 用 src0/arena.jhyy,std lib user 用 std::Arena)
//   - 后端 alloc 走 libc malloc(M0 简化,MMAP 后端留 v3.x 中末)
//
// 2026-11-09 真修(W-222):块大小这件事,三个函数曾经各说各话 ——
//   arena_new_block 按「本次要的量」malloc,arena_reset 却按 def_size 摆 end
//   ⇒ reset 之后的分配越过块尾写坏堆。
//   现在:块大小 = max(def_size, 本次要的量),并且**记在块头里**
//   (payload_size),reset 从块头读回真实大小 ⇒ end 永远落在块内 ✓。
//   (compiler/src0/arena.jhyy —— 编译器自用的那份 —— 一直是对的:
//    它的块大小本来就是 max(def_size, min_size) ⇒ end = data + def_size
//    必然落在块内。本文件是 std 侧另写的一份,没跟上。)
//
// API:
//   std::Arena (struct)
//   arena_init(a, default_size) -> 1 / 0
//   arena_alloc(a, size)        -> *u8 (8-byte aligned) / 0 on fail
//   arena_calloc(a, size)       -> *u8 (zeroed) / 0 on fail
//   arena_reset(a)              -> 1 (重置 cur 到 start, 不释放 block)
//   arena_free(a)               -> 1 (释放所有 block)
//
// 注:Arena struct 不导出 blocks (linked list head);仅暴露 start/cur/end/def_size
//   4 字段给 user。blocks 走 `*u8` 占位 (跟 src0/arena.jhyy ArenaBlock 同款)。

// ════════════════════════════════════════════════════
// FFI
// ════════════════════════════════════════════════════
extern fn malloc(size: i64) -> *u8;
extern fn free(p: *u8) -> i32;
extern fn memset(p: *u8, val: i32, n: i64) -> *u8;

// ════════════════════════════════════════════════════
// Arena struct (jhyy-side, std lib user 用)
// ════════════════════════════════════════════════════
//
// 字节布局 (跟 src0/arena.jhyy 的 Arena 一致):
//   start (8) + cur (8) + end (8) + blocks (8) + def_size (8) = 40
//
// 注:`blocks` 走 *u8 占位 (jhyy 不支持自引用 struct),使用处 cast。
type Arena = struct {
    start:    *u8,
    cur:      *u8,
    end:      *u8,
    blocks:   *u8,         // *ArenaBlock head (使用处 cast)
    def_size: i64,
}

fn ARENA_SIZE() -> i64 { return 40 as i64; }

// ArenaBlock: linked-list node;arena_alloc 时新建,linked by blocks head
// 字节布局:next (8) + payload_size (8) = 16. arena_new_block 时 malloc(16 + payload)。
//
// ⚠️ 2026-11-09 真修(W-222):payload_size 这一格**不能省** ——
//   arena_reset 要知道「这个块到底多大」才能把 end 摆对。
//   旧布局 [next(8)][payload...] 只有 8 字节头 ⇒ reset 拿不到块的真实大小,
//   只能拿 def_size 猜 —— 而 def_size 是「**默认**块大小」不是「这个块的
//   实际大小」⇒ 真实块只有几十字节、end 却摆到 def_size(默认 1MB)⇒
//   reset 之后的分配**越过块尾写坏堆**。
//   (compiler/src0/std/string.jhyy 的 mini arena 早就用「把 payload 大小存在
//    块头里」这套写法 —— 同一个坑,同一个解法。)
type ArenaBlock = struct {
    next: *u8,
    payload_size: i64,
}

fn ARENA_BLOCK_HEADER() -> i64 { return 16 as i64; }

// ════════════════════════════════════════════════════
// ptr_add — 本地指针算术
// ════════════════════════════════════════════════════
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}

// align_up:把 x 上调到 align 倍数(align 必为 2 的幂)
fn align_up(x: i64, align: i64) -> i64 {
    let mask = align - 1 as i64;
    return (x + mask) & ~(mask);
}

// ════════════════════════════════════════════════════
// arena_new_block — 私有 API,新建一块并 link 到 blocks head
// ════════════════════════════════════════════════════
fn arena_new_block(a: *Arena, size: i64) -> i32 {
    // 块大小 = max(def_size, 本次要的量) —— def_size 是「**默认**块大小」
    // (跟 compiler/src0/arena.jhyy 同一套规矩):小请求也占一整块,大请求
    // 也不会把块切碎。
    let mut block_size: i64 = (*a).def_size;
    if block_size < size {
        block_size = size;
    }
    let raw = malloc(ARENA_BLOCK_HEADER() + block_size);
    if raw == (0 as *u8) {
        return 0;
    }
    let b = raw as *ArenaBlock;
    (*b).next = (*a).blocks;
    (*b).payload_size = block_size;
    (*a).blocks = b as *u8;
    let data = ptr_add(raw, ARENA_BLOCK_HEADER());
    (*a).start = data;
    (*a).cur = data;
    (*a).end = ptr_add(data, block_size);
    return 1;
}

// ════════════════════════════════════════════════════
// Public API
// ════════════════════════════════════════════════════

// arena_init — 初始化 Arena,设置 default_size (若 ≤ 0 用 1MB)
fn arena_init(a: *Arena, default_size: i64) -> i32 {
    if default_size > 0 as i64 {
        (*a).def_size = default_size;
    } else {
        (*a).def_size = 1048576 as i64;  // 1 MB
    }
    (*a).blocks = 0 as *u8;
    (*a).start = 0 as *u8;
    (*a).cur = 0 as *u8;
    (*a).end = 0 as *u8;
    return 1;
}

// arena_alloc_aligned — 私有,8/16/... 字节对齐 alloc
fn arena_alloc_aligned(a: *Arena, size: i64, align: i64) -> *u8 {
    if size == 0 as i64 {
        return 0 as *u8;
    }
    if (*a).cur != (0 as *u8) {
        let cur_int = (*a).cur as i64;
        let aligned = align_up(cur_int, align);
        let aligned_ptr = aligned as *u8;
        let end_int = (*a).end as i64;
        if aligned + size <= end_int {
            (*a).cur = (aligned + size) as *u8;
            return aligned_ptr;
        }
    }
    let min_total = size + align;
    let ok = arena_new_block(a, min_total);
    if ok == 0 {
        return 0 as *u8;
    }
    return arena_alloc_aligned(a, size, align);
}

// arena_alloc — 8-byte 对齐 alloc
fn arena_alloc(a: *Arena, size: i64) -> *u8 {
    return arena_alloc_aligned(a, size, 8 as i64);
}

// arena_calloc — alloc + zero
fn arena_calloc(a: *Arena, size: i64) -> *u8 {
    let p = arena_alloc(a, size);
    if p != (0 as *u8) {
        memset(p, 0 as i32, size);
    }
    return p;
}

// arena_reset — 重置 cur 到 start (不释放 block;arena 后续 alloc 复用这些 block)
//
// ⚠️ 2026-11-09 真修(W-222):end 必须按**块的真实大小**摆,不能拿 def_size 猜。
//   旧实现 `end = data + def_size`:def_size 是「默认块大小」(默认 1MB),
//   而 reset 到的这个块可能只有几十字节 ⇒ end 越过块尾 ⇒ 之后的分配
//   **写穿块尾踩坏堆**(实测:写到 64KB 直接踩坏堆 ⇒ 进程 abort)。
//   现在 end 来自块头的 payload_size ⇒ 永远落在块内 ✓。
fn arena_reset(a: *Arena) -> i32 {
    if (*a).blocks != (0 as *u8) {
        let first = (*a).blocks;
        let data = ptr_add(first, ARENA_BLOCK_HEADER());
        (*a).start = data;
        (*a).cur = data;
        (*a).end = ptr_add(data, (*(first as *ArenaBlock)).payload_size);
    }
    return 1;
}

// arena_free — 释放所有 block (遍历 linked list,逐个 free)
fn arena_free(a: *Arena) -> i32 {
    let mut b: *u8 = (*a).blocks;
    while b != (0 as *u8) {
        let next = (*(b as *ArenaBlock)).next;
        free(b);
        b = next;
    }
    (*a).blocks = 0 as *u8;
    (*a).start = 0 as *u8;
    (*a).cur = 0 as *u8;
    (*a).end = 0 as *u8;
    return 1;
}
