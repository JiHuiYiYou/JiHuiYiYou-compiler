// string.jhyy — v3.2.2 (3l.1) std lib 起步:string ops (裸 *u8 + 长度, 无借用)。
//
// M0 简化(per `docs/plans/v3/v3.2.2-plan.md`):
//   - 不依赖 closure / generic / 借用
//   - String 用裸 *u8 + 长度表示 (跟 CapTable 路径一致)
//   - 借用 string view (&str) 留 v3.x 中末 (需 &mut + lifetime)
//   - 所有 string buffer 从内部 mini-arena alloc;caller 自己 reset / free
//   - 不 import 跨文件模块 (避免 mangle 复杂度);byte 循环本地实现
//
// API:
//   StringHeader (struct): data (*u8), len (i64)
//   str_from_cstr(a, s)            -> 复制 cstr 到 arena;返回 *StringHeader (16B)
//   str_from_bytes(a, p, n)        -> 复制 n 字节;返回 *StringHeader
//   str_len(s)                     -> 长度
//   str_data(s)                    -> *u8 (data pointer, NOT null-terminated)
//   str_concat(a, x, y)            -> 拼接 x + y 到新 arena buffer
//   str_compare(x, y)              -> 0 equal / <0 x<y / >0 x>y
//   str_find(s, needle)            -> 找 substring (needle = cstr);index / -1
//   str_equals(x, y)               -> 1 equal / 0
//
// Arena 内部 layout (40B):
//   [0..8)   blocks_head (*ArenaBlock linked list head, *u8 占位)
//   [8..16)  cur (*u8 = bump pointer)
//   [16..24) end (*u8)
//   [24..32) reserved
//   [32..40) def_size (i64)
//
// 测试:`compiler/tests/examples/std_string_*.jhyy` (5+ 测试)

// ════════════════════════════════════════════════════
// ptr_add — 本地指针算术
// ════════════════════════════════════════════════════
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}

// ════════════════════════════════════════════════════
// FFI
// ════════════════════════════════════════════════════
extern fn malloc(size: i64) -> *u8;
extern fn free(p: *u8) -> i32;
extern fn memset(p: *u8, val: i32, n: i64) -> *u8;

// ════════════════════════════════════════════════════
// StringHeader
// ════════════════════════════════════════════════════
//
// 字节布局:data (8) + len (8) = 16
// 注:buffer 不强制 null-terminated (M0 简化);user 需要时手写 *(data+len)=0。
type StringHeader = struct {
    data: *u8,
    len:  i64,
}

fn STR_HEADER_SIZE() -> i64 { return 16 as i64; }

// ArenaBlock: linked-list node;8B (next ptr)
type ArenaBlock = struct {
    next: *u8,
}

// ════════════════════════════════════════════════════
// mini arena (string.jhyy 内嵌,不复用 std/arena.jhyy)
// ════════════════════════════════════════════════════

// arena_init — 初始化 a (40B 已分配)
fn arena_init(a: *u8, default_size: i64) -> i32 {
    let sz = if default_size > 0 as i64 { default_size } else { 1048576 as i64 };
    *(ptr_add(a, 32 as i64) as *i64) = sz;
    *(a as *i64) = 0 as i64;
    *(ptr_add(a, 8 as i64) as *i64) = 0 as i64;
    *(ptr_add(a, 16 as i64) as *i64) = 0 as i64;
    *(ptr_add(a, 24 as i64) as *i64) = 0 as i64;
    return 1;
}

fn align_up(x: i64, align: i64) -> i64 {
    let mask = align - 1 as i64;
    return (x + mask) & ~(mask);
}

// arena_alloc — 8B 对齐 alloc;返回新 buffer / 0 on fail
fn arena_alloc(a: *u8, size: i64) -> *u8 {
    if size == 0 as i64 {
        return 0 as *u8;
    }
    let cur_int = *(ptr_add(a, 8 as i64) as *i64);
    if cur_int != (0 as i64) {
        let aligned = align_up(cur_int, 8 as i64);
        let end_int = *(ptr_add(a, 16 as i64) as *i64);
        if aligned + size <= end_int {
            *(ptr_add(a, 8 as i64) as *i64) = aligned + size;
            return aligned as *u8;
        }
    }
    // 新建 block
    let min_total = size + 8 as i64;
    let raw = malloc(min_total);
    if raw == (0 as *u8) {
        return 0 as *u8;
    }
    // prepend to blocks linked list
    let old_blocks = *(a as *i64);
    *(raw as *i64) = old_blocks;
    *(a as *i64) = raw as i64;
    // set start/cur/end to raw's data area
    let data_start = (raw as i64);
    *(ptr_add(a, 8 as i64) as *i64) = data_start;
    let data_end = data_start + min_total;
    *(ptr_add(a, 16 as i64) as *i64) = data_end;
    return raw;
}

// arena_reset — 重置 cur 到 blocks head 的 data start
fn arena_reset(a: *u8) -> i32 {
    let blocks_int = *(a as *i64);
    if blocks_int != 0 as i64 {
        let first = blocks_int as *u8;
        *(ptr_add(a, 8 as i64) as *i64) = first as i64;
        let def_size = *(ptr_add(a, 32 as i64) as *i64);
        *(ptr_add(a, 16 as i64) as *i64) = (first as i64) + def_size;
    }
    return 1;
}

// arena_free — 释放所有 block
fn arena_free(a: *u8) -> i32 {
    let mut b: *u8 = (*(a as **u8));
    while b != (0 as *u8) {
        let next = (*(b as *ArenaBlock)).next;
        free(b);
        b = next;
    }
    *(a as *i64) = 0 as i64;
    *(ptr_add(a, 8 as i64) as *i64) = 0 as i64;
    *(ptr_add(a, 16 as i64) as *i64) = 0 as i64;
    return 1;
}

// ════════════════════════════════════════════════════
// str_from_cstr — 从 cstr 复制到 arena
// 返回 *StringHeader (16B) / 0 on fail
// ════════════════════════════════════════════════════
fn strlen_local(s: *u8) -> i64 {
    let mut n: i64 = 0 as i64;
    while *(ptr_add(s, n) as *i32) != (0 as i32) {
        n = n + (1 as i64);
    }
    return n;
}

fn str_from_cstr(a: *u8, s: *u8) -> *u8 {
    let n = strlen_local(s);
    let buf = arena_alloc(a, n + 1 as i64);
    if buf == (0 as *u8) {
        return 0 as *u8;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        *(ptr_add(buf, i) as *i32) = *(ptr_add(s, i) as *i32);
        i = i + (1 as i64);
    }
    *(ptr_add(buf, n) as *i32) = 0 as i32;
    let hdr = arena_alloc(a, STR_HEADER_SIZE());
    if hdr == (0 as *u8) {
        return 0 as *u8;
    }
    *(hdr as *i64) = buf as i64;
    *(ptr_add(hdr, 8 as i64) as *i64) = n;
    return hdr;
}

// ════════════════════════════════════════════════════
// str_from_bytes — 从 raw bytes 复制 n 字节到 arena
// ════════════════════════════════════════════════════
fn str_from_bytes(a: *u8, p: *u8, n: i64) -> *u8 {
    let buf = arena_alloc(a, n + 1 as i64);
    if buf == (0 as *u8) {
        return 0 as *u8;
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        *(ptr_add(buf, i) as *i32) = *(ptr_add(p, i) as *i32);
        i = i + (1 as i64);
    }
    *(ptr_add(buf, n) as *i32) = 0 as i32;
    let hdr = arena_alloc(a, STR_HEADER_SIZE());
    if hdr == (0 as *u8) {
        return 0 as *u8;
    }
    *(hdr as *i64) = buf as i64;
    *(ptr_add(hdr, 8 as i64) as *i64) = n;
    return hdr;
}

// ════════════════════════════════════════════════════
// str_len / str_data — header accessor
// ════════════════════════════════════════════════════
fn str_len(s: *u8) -> i64 {
    return *(ptr_add(s, 8 as i64) as *i64);
}

fn str_data(s: *u8) -> *u8 {
    return *(s as **u8);
}

// ════════════════════════════════════════════════════
// str_equals — 1 equal / 0
// ════════════════════════════════════════════════════
fn str_equals(x: *u8, y: *u8) -> i32 {
    let xlen = str_len(x);
    let ylen = str_len(y);
    if xlen != ylen {
        return 0;
    }
    let xd = str_data(x);
    let yd = str_data(y);
    let mut i: i64 = 0 as i64;
    while i < xlen {
        if (*(ptr_add(xd, i) as *i32) & (0xff as i32)) !=
           (*(ptr_add(yd, i) as *i32) & (0xff as i32)) {
            return 0;
        }
        i = i + (1 as i64);
    }
    return 1;
}

// str_compare — 字典序比较;0 equal / <0 x<y / >0 x>y
fn str_compare(x: *u8, y: *u8) -> i32 {
    let xlen = str_len(x);
    let ylen = str_len(y);
    let minlen = if xlen < ylen { xlen } else { ylen };
    let xd = str_data(x);
    let yd = str_data(y);
    let mut i: i64 = 0 as i64;
    while i < minlen {
        let a: i32 = *(ptr_add(xd, i) as *i32) & (0xff as i32);
        let b: i32 = *(ptr_add(yd, i) as *i32) & (0xff as i32);
        if a != b {
            if a < b {
                return 0 as i32 - (1 as i32);
            }
            return 1;
        }
        i = i + (1 as i64);
    }
    if xlen < ylen { return 0 as i32 - (1 as i32); }
    if xlen > ylen { return 1; }
    return 0;
}

// str_concat — 拼接 x + y 到新 arena buffer;返回 *StringHeader
fn str_concat(a: *u8, x: *u8, y: *u8) -> *u8 {
    let xlen = str_len(x);
    let ylen = str_len(y);
    let total = xlen + ylen;
    let buf = arena_alloc(a, total + 1 as i64);
    if buf == (0 as *u8) {
        return 0 as *u8;
    }
    let xd = str_data(x);
    let yd = str_data(y);
    let mut i: i64 = 0 as i64;
    while i < xlen {
        *(ptr_add(buf, i) as *i32) = *(ptr_add(xd, i) as *i32);
        i = i + (1 as i64);
    }
    let mut j: i64 = 0 as i64;
    while j < ylen {
        *(ptr_add(buf, xlen + j) as *i32) = *(ptr_add(yd, j) as *i32);
        j = j + (1 as i64);
    }
    *(ptr_add(buf, total) as *i32) = 0 as i32;
    let hdr = arena_alloc(a, STR_HEADER_SIZE());
    if hdr == (0 as *u8) {
        return 0 as *u8;
    }
    *(hdr as *i64) = buf as i64;
    *(ptr_add(hdr, 8 as i64) as *i64) = total;
    return hdr;
}

// str_find — 找 substring (needle 必为 cstr);返回 index / -1
fn str_find(s: *u8, needle: *u8) -> i64 {
    let slen = str_len(s);
    let nlen = strlen_local(needle);
    if nlen == 0 as i64 {
        return 0;
    }
    if nlen > slen {
        return 0 as i64 - (1 as i64);
    }
    let sd = str_data(s);
    let mut i: i64 = 0 as i64;
    while i + nlen <= slen {
        let mut m: i32 = 1;
        let mut j: i64 = 0 as i64;
        while j < nlen {
            if (*(ptr_add(sd, i + j) as *i32) & (0xff as i32)) !=
               (*(ptr_add(needle, j) as *i32) & (0xff as i32)) {
                m = 0;
                break;
            }
            j = j + (1 as i64);
        }
        if m != 0 {
            return i;
        }
        i = i + (1 as i64);
    }
    return 0 as i64 - (1 as i64);
}
