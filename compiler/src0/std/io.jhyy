// io.jhyy — v3.2.3 (3l.2) std lib IO:file read/write + stdin/stdout/stderr。
//
// M0 简化(per `docs/plans/v3/v3.2.3-plan.md` + 2026-09-10 user 决定):
//   - 不依赖 closure / generic / 借用
//   - 不依赖 std::mem / std::string(避免 cross-module import — 见 W-077 根因:
//     inline_imports 不支持 subdir,v3.2.2 ships 4 个独立 module,test 走 inline 副本)
//   - 不 export cap / fd table(M11 OS launch 后再做 v3.x 中)
//   - 后端走 libc fopen/fread/fwrite/fclose(M0 简化, OS kernel M11 launch 前
//     不依赖 std lib,host M0 测试可用 libc)
//   - 用 std_io_* 前缀(W-076 风格,runtime.c C-side 命名空间未隔离;Phase 1
//     不调 printf 避免 name clash)
//
// API:
//   std_io_open(path, mode)     -> FILE* (file handle) / 0 on fail
//   std_io_close(f)            -> 0 ok / -1 fail
//   std_io_read(f, buf, n)     -> 实际读字节数
//   std_io_write(f, buf, n)    -> 实际写字节数
//   std_io_print(s)            -> stdout 写 cstr(真 impl,W-080 v3.2.3.1)
//   std_io_print_err(s)        -> stderr 写 cstr(真 impl,W-080 v3.2.3.1)
//
// 注:
//   - std_io_print / std_io_print_err 真 impl (W-080 v3.2.3.1 ship):走
//     C-side jh_fputs_stdout / jh_fputs_stderr 现成桥 (jhyy_helpers.c L32/36,
//     v1.5.6 W-049 UTF-8 mode preserved)。fputs → stdout/stderr 直接写,
//     无需 jhyy 拿 FILE* 地址 (bridge 帮做)。
//   - OS kernel M11 launch 后换 syscall 实现 (写 com1 / serial port):
//     改 jhyy_helpers.c 的 jh_fputs_* 实现 (printf→write syscall),std/io.jhyy
//     不变。
//
// 测试:`compiler/tests/examples/std_io_basic.jhyy` (6 sub-test)

// ════════════════════════════════════════════════════
// FFI — libc via runtime.c + jhyy_helpers.c link path
// ════════════════════════════════════════════════════
//
// libc fopen/fclose/fread/fwrite 是 QBE amd64_win extern-args 已知 OK
// pattern (pointer return + 同 type args — 跟 std_io_* wrapper signature
// 1:1 match,callee registers 已经按 Win ABI 准备好)。M0 验证 PASS。
extern fn fopen(path: *u8, mode: *u8) -> *u8;
extern fn fclose(f: *u8) -> i32;
extern fn fread(buf: *u8, size: i64, count: i64, f: *u8) -> i64;
extern fn fwrite(buf: *u8, size: i64, count: i64, f: *u8) -> i64;

// ════════════════════════════════════════════════════
// File handle API
// ════════════════════════════════════════════════════

// std_io_open — 打开文件
//   mode: cstr ("r" / "w" / "wb" / "rb" / "a" 等)
//   返回 FILE* / 0 on fail
fn std_io_open(path: *u8, mode: *u8) -> *u8 {
    return fopen(path, mode);
}

// std_io_close — 关闭文件
fn std_io_close(f: *u8) -> i32 {
    if f == (0 as *u8) {
        return 0 as i32 - (1 as i32);
    }
    return fclose(f);
}

// std_io_read — 从 f 读 n 字节到 buf
// 返回实际读字节数(< n 表示 EOF / error)
fn std_io_read(f: *u8, buf: *u8, n: i64) -> i64 {
    if f == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return fread(buf, 1 as i64, n, f);
}

// std_io_write — 写 n 字节从 buf 到 f
// 返回实际写字节数
fn std_io_write(f: *u8, buf: *u8, n: i64) -> i64 {
    if f == (0 as *u8) {
        return 0 as i64 - (1 as i64);
    }
    if n <= (0 as i64) {
        return 0 as i64;
    }
    return fwrite(buf, 1 as i64, n, f);
}

// ════════════════════════════════════════════════════
// stdio print API (v3.2.3.1 W-080 真修)
// ════════════════════════════════════════════════════
//
// 走 C-side jh_fputs_stdout / jh_fputs_stderr 现成桥 (jhyy_helpers.c L32/36,
// v1.5.6 W-049 UTF-8 mode preserved, W-079 verified path)。fputs 走 libc
// UTF-8 mode,中文输出正常 (chcp 65001)。
//
// OS kernel M11 launch 后:改 jhyy_helpers.c jh_fputs_* 实现 (printf→
// write syscall,目标 com1 / serial port),std/io.jhyy 不变。

extern fn jh_fputs_stdout(s: *u8) -> i32;
extern fn jh_fputs_stderr(s: *u8) -> i32;

fn std_io_print(s: *u8) -> i32 {
    if s == (0 as *u8) {
        return 0 as i32 - (1 as i32);
    }
    return jh_fputs_stdout(s);
}

fn std_io_print_err(s: *u8) -> i32 {
    if s == (0 as *u8) {
        return 0 as i32 - (1 as i32);
    }
    return jh_fputs_stderr(s);
}

fn std_io_eprint(s: *u8) -> i32 {
    return std_io_print_err(s);
}
