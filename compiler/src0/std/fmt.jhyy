// fmt.jhyy — v3.2.2 (3l.1) std lib 起步:自实现格式化基础。
//
// M0 简化(per `docs/archive/plans/v3/v3.2.2-plan.md`):
//   - 不依赖 closure / generic / 借用
//   - 自实现 4 个基础 fmt fn(i32/i64/string/hex),不走 libc printf 变参
//     (变参 ABI 复杂 + std lib 不依赖 libc runtime)
//   - 复杂 fmt(浮点/width/precision)留 v3.x 中末
//   - 不 import 跨文件模块(避免 mangle 复杂度);所有 byte 循环本地实现
//
// API:
//   fmt_i32(out_buf, val)        -> 写入 i32 十进制到 out_buf (null-terminated);返回写入字节数 (不含 \0)
//   fmt_i64(out_buf, val)        -> 写入 i64 十进制;返回字节数
//   fmt_str(out_buf, s)          -> 复制 cstr 到 out_buf;返回字节数
//   fmt_hex_u32(out_buf, val, upper) -> 写入 u32 十六进制;返回字节数
//
// 注:buffer 必须 ≥ 32 字节(i32/i64 最多 11/20 位 + sign + \0;hex u32 10 位 + \0)。

// ════════════════════════════════════════════════════
// ptr_add — 本地指针算术 helper
//
// ⚠️ 旧注释写的「jhyy 不支持 *u8 + i64」**已过期** —— 指针算术早已实装
//   (W-055「spec §9.5 指针算术 p + 1 整节未实现」已于 v1.7.0 关闭)。
//   现在 `*(buf + i)` 直接可用(实测:buf 是 *u8、i 是 i64 ⇒ 正常工作)。
//
//   本 helper 保留是为了**可移植性**:它写的是 `(p as i64 + off) as *u8`,
//   不依赖指针算术的类型规则,在任何后端下都成立。
// ════════════════════════════════════════════════════
fn ptr_add(p: *u8, off: i64) -> *u8 {
    return (p as i64 + off) as *u8;
}

// ════════════════════════════════════════════════════
// digit / hex table
// ════════════════════════════════════════════════════
fn digit_char(d: i32) -> i32 {
    if d == (0 as i32) { return 48 as i32; }
    if d == (1 as i32) { return 49 as i32; }
    if d == (2 as i32) { return 50 as i32; }
    if d == (3 as i32) { return 51 as i32; }
    if d == (4 as i32) { return 52 as i32; }
    if d == (5 as i32) { return 53 as i32; }
    if d == (6 as i32) { return 54 as i32; }
    if d == (7 as i32) { return 55 as i32; }
    if d == (8 as i32) { return 56 as i32; }
    return 57 as i32;
}

fn hex_char(d: i32, upper: i32) -> i32 {
    if d < (10 as i32) {
        return digit_char(d);
    }
    if upper != (0 as i32) {
        if d == (10 as i32) { return 65 as i32; }
        if d == (11 as i32) { return 66 as i32; }
        if d == (12 as i32) { return 67 as i32; }
        if d == (13 as i32) { return 68 as i32; }
        if d == (14 as i32) { return 69 as i32; }
        return 70 as i32;
    }
    if d == (10 as i32) { return 97 as i32; }
    if d == (11 as i32) { return 98 as i32; }
    if d == (12 as i32) { return 99 as i32; }
    if d == (13 as i32) { return 100 as i32; }
    if d == (14 as i32) { return 101 as i32; }
    return 102 as i32;
}

// ════════════════════════════════════════════════════
// fmt_i32 — 写入 i32 十进制到 out_buf
// 返回写入字节数 (不含 \0)
// ════════════════════════════════════════════════════
fn fmt_i32(out_buf: *u8, val: i32) -> i64 {
    let mut rev: [i32; 16] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let mut n: i64 = 0 as i64;
    let mut v: i32 = val;
    if v == (0 as i32) {
        rev[0] = 48 as i32;
        n = 1 as i64;
    } else {
        let negative: i32 = if v < (0 as i32) { 1 as i32 } else { 0 as i32 };
        // ⚠️ **W-195 真修 (2026-11-04)**:原来这里先 `v = 0 - v` 取绝对值,
        //   而 **i32::MIN 取负回绕成它自己**(仍是负数)⇒ `while v > 0` 一次都不跑
        //   ⇒ 只打出一个 `-`(实测 fmt_i32(i32::MIN) 返回 1,应为 11)。
        // ⇒ 改成**不取绝对值**,直接用**向 0 截断**的除法:
        //   · `v % 10` 的符号跟 `v` 一样 ⇒ 取它的绝对值(余数在 -9..9 ⇒ 取负不溢出)
        //   · `v = v / 10` 向 0 截断 ⇒ **MIN / 10 不溢出**(唯一会溢出的除法是 MIN / -1)
        //     ⇒ MIN 天然可用,**不需要特判**。
        // ⚠️ 刻意**不用无符号除法**(那会依赖编译器版本的 u32/u64 除法语义)。
        while v != (0 as i32) {
            let mut d: i32 = v % (10 as i32);
            if d < (0 as i32) {
                d = 0 as i32 - d;      // 余数在 -9..9 ⇒ 这里取负不会溢出
            }
            rev[n] = digit_char(d);
            n = n + (1 as i64);
            v = v / (10 as i32);        // 向 0 截断
        }
        if negative != (0 as i32) {
            rev[n] = 45 as i32;
            n = n + (1 as i64);
        }
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let dst = ptr_add(out_buf, i);
        *(dst as *u8) = rev[n - (1 as i64) - i] as u8;
        i = i + (1 as i64);
    }
    *(ptr_add(out_buf, n) as *u8) = 0 as u8;
    return n;
}

// ════════════════════════════════════════════════════
// fmt_i64 — 写入 i64 十进制
// 返回写入字节数 (不含 \0)
// ════════════════════════════════════════════════════
fn fmt_i64(out_buf: *u8, val: i64) -> i64 {
    let mut rev: [i32; 24] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let mut n: i64 = 0 as i64;
    let mut v: i64 = val;
    if v == (0 as i64) {
        rev[0] = 48 as i32;
        n = 1 as i64;
    } else {
        let negative: i32 = if v < (0 as i64) { 1 as i32 } else { 0 as i32 };
        // ⚠️ **W-195 真修 (2026-11-04)**:同 fmt_i32 的老形状 ⇒
        //   `fmt_i64(i64::MIN)` 只打出一个 `-`(实测返回 1,应为 20
        //   ⇒ `-9223372036854775808`)—— i64::MIN 取负回绕成它自己。
        // ⇒ 改成不取绝对值,直接用向 0 截断的除法(理由见 fmt_i32 的注释)。
        // ⚠️ `i64::MIN / 10` = -922337203685477580(向 0 截断)**不溢出** ⇒ MIN 天然可用。
        while v != (0 as i64) {
            let mut d: i64 = v % (10 as i64);
            if d < (0 as i64) {
                d = 0 as i64 - d;      // 余数在 -9..9 ⇒ 这里取负不会溢出
            }
            rev[n] = digit_char(d as i32);
            n = n + (1 as i64);
            v = v / (10 as i64);        // 向 0 截断
        }
        if negative != (0 as i32) {
            rev[n] = 45 as i32;
            n = n + (1 as i64);
        }
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let dst = ptr_add(out_buf, i);
        *(dst as *u8) = rev[n - (1 as i64) - i] as u8;
        i = i + (1 as i64);
    }
    *(ptr_add(out_buf, n) as *u8) = 0 as u8;
    return n;
}

// ════════════════════════════════════════════════════
// fmt_str — 复制 cstr 到 out_buf;返回字节数
// ════════════════════════════════════════════════════
fn fmt_str(out_buf: *u8, s: *u8) -> i64 {
    let mut i: i64 = 0 as i64;
    while *(ptr_add(s, i) as *u8) != (0 as u8) {
        *(ptr_add(out_buf, i) as *u8) = *(ptr_add(s, i) as *u8);
        i = i + (1 as i64);
    }
    *(ptr_add(out_buf, i) as *u8) = 0 as u8;
    return i;
}

// ════════════════════════════════════════════════════
// fmt_hex_u32 — 写入 u32 十六进制到 out_buf
// upper: 0 = 'a'..'f', 1 = 'A'..'F'
// 返回写入字节数 (不含 \0, 不带 "0x" 前缀)
// ════════════════════════════════════════════════════
fn fmt_hex_u32(out_buf: *u8, val: i32, upper: i32) -> i64 {
    if val == (0 as i32) {
        *(out_buf as *u8) = 48 as u8;
        *(ptr_add(out_buf, 1 as i64) as *u8) = 0 as u8;
        return 1 as i64;
    }
    let mut rev: [i32; 12] = [0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32,
                              0 as i32, 0 as i32, 0 as i32, 0 as i32];
    let mut n: i64 = 0 as i64;
    // ⚠️ **W-195 真修 (2026-11-04)**:val 是 **u32 的位模式**(以 i32 传入)
    //   ⇒ 值 ≥ 0x80000000 时它是**负的** ⇒ 修前 `while v > 0` 一次都不跑
    //   ⇒ **输出空串**(实测 fmt_hex_u32(0x80000000) 返回 0,应为 8)。
    // ⇒ 先把位模式**手工转成无符号的 i64**(0..2³²-1)⇒ 之后 i64 的除法就够用。
    // ⚠️ **为什么不写 `val as u32 as i64`**:那条路依赖「u32 → i64 **零扩展**」
    //   这条规则(W-185 刚修的)⇒ **老编译器**会符号扩展 ⇒ 用老编译器编出来的
    //   std lib 会打出错的 hex ⇒ 手工转换只用「符号扩展 + i64 加法」
    //   ⇒ **任何版本的编译器都对**。
    let mut v: i64 = 0 as i64;
    if val < (0 as i32) {
        v = 4294967296i64 + (val as i64);   // 2³² + 负数 ⇒ 0..2³¹-1
    } else {
        v = val as i64;
    }
    while v > (0 as i64) {
        let d: i64 = v - (v / (16 as i64)) * (16 as i64);
        rev[n] = hex_char(d as i32, upper);
        n = n + (1 as i64);
        v = v / (16 as i64);
    }
    let mut i: i64 = 0 as i64;
    while i < n {
        let dst = ptr_add(out_buf, i);
        *(dst as *u8) = rev[n - (1 as i64) - i] as u8;
        i = i + (1 as i64);
    }
    *(ptr_add(out_buf, n) as *u8) = 0 as u8;
    return n;
}
