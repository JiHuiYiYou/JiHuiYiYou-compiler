// abi_amd64_sysv.jhyy — v2.7.0 ship of amd64_sysv ABI module
//
// V2-B v2.7.0 M2 deliverable: SysV AMD64 ABI (Linux ABI Supplement, x86-64
// psABI § 3.2.3 + § A.4) for self-written backend. Mirror of
// `abi_amd64_win.jhyy` structure but with target=SysV semantics.
//
// Phase 1 scope (v2.7.0 Commit 1): drop-in byte-equal mirror of win.
// All 5 fn bodies + 1 internal helper are identical to abi_win_*. The only
// divergence is `abi_sysv_classify_arg` which returns SysV 3-class codes
// (INTEGER=0 / SSE=1 / MEMORY=2) instead of QBE type letters — this is
// the true SysV per-class classifier as required by § A.4.
//
// Phase 2b scope (v2.7.0 Commit 3): `codegen_amd64_emit_call.jhyy`
// `emit_amd64_arg_regs` helper splits arg-reg per target (Win: 4 regs
// rcx/rdx/r8/r9 + 32B shadow / SysV: 6 regs rdi/rsi/rdx/rcx/r8/r9 NO
// shadow). SysV bodies here remain mirror until v2.7.1+ when real
// SysV-specific IL emit lands (8-class § A.4 full classifier, vararg AL,
// etc.).
//
// 3-class minimum viable: INTEGER / SSE / MEMORY. Full 8-class SysV § A.4
// (INTEGER / SSE / SSEUP / MEMORY / NO_CLASS) is v2.7.2+ territory per
// `docs/plans/v2/v2.7.0-plan.md` out-of-scope list.
//
// Note: lives flat in compiler/src0/ (not in a subdir) — jhyy import
// syntax doesn't support paths with `/` (per `parse_import_decl`
// codegen.c:731 — same restriction as abi_amd64_win.jhyy).

import types;
import ir;
import ast;  // for Sym (used by emit_function_header)
import symtab;
import arena;
import abi_amd64_win;  // for abi_win_classify_arg (Phase 1 mirror placeholder)

// ════════════════════════════════════════════
// v2.7.0 Commit 1: abi_sysv_classify_arg
// ════════════════════════════════════════════
//
// SysV 3-class minimum viable classifier (per SysV psABI § A.4):
//   - INTEGER (0) for scalar integer types (i8/i16/i32/i64 / pointer /
//     slice / func / enum ≤ 8B / struct ≤ 16B via reg-pair)
//   - SSE (1)    for f32 / f64
//   - MEMORY (2) for structs > 16B or arrays
//
// This differs from abi_win_classify_arg which returns QBE type letters
// (QBE_L for 8-byte, QBE_W for 4-byte, etc.). The SysV classifier
// returns class codes consumed by `emit_amd64_arg_regs` in Phase 2b
// to decide register vs stack allocation.
//
// 8-class full classifier (SSEUP, etc.) is punted to v2.7.2+.

// SysV class codes (i32 constants) — v2.13.0 Phase 2 真修:
//   3-class (Phase 1 v2.7.0) → 8-class (Phase 2 full § A.4)
//   INTEGER/SSEUP/NO_CLASS 是新增,for __m128 + struct field classification
fn SYSV_CLASS_INTEGER()  -> i32 { return 0 as i32; }
fn SYSV_CLASS_SSE()      -> i32 { return 1 as i32; }
fn SYSV_CLASS_SSEUP()    -> i32 { return 2 as i32; }
fn SYSV_CLASS_MEMORY()   -> i32 { return 3 as i32; }
fn SYSV_CLASS_NO_CLASS() -> i32 { return 4 as i32; }

// v2.13.0 Phase 2: classification to QBE type letter map
//   INTEGER (i64/i32/i16/i8/pointer/slice/func/enum/Cap<T>/PhantomData/small struct)
//     → QBE_L (8-byte INTEGER) OR QBE_W (4-byte INTEGER) per size
//   SSE (f32/f64) → QBE_S / QBE_D
//   SSEUP (__m128 high half + long double field) → QBE_L (8-byte INTEGER slot)
//   MEMORY (struct >16B / array) → QBE_L (stack pointer)
//   NO_CLASS → 0 (unused, 不 emit)
fn sysv_class_to_qbe_letter(cls: i32, sz: i64) -> i32 {
    if cls == SYSV_CLASS_NO_CLASS() { return 0 as i32; }
    if cls == SYSV_CLASS_SSE() {
        if sz == (4 as i64) { return QBE_S(); }
        return QBE_D();
    }
    // INTEGER / SSEUP / MEMORY all use l/w based on size
    if sz <= (4 as i64) { return QBE_W(); }
    return QBE_L();
}

// ════════════════════════════════════════════════════════════════════════════
// W-104 (2026-10-19 真修):struct 按 eightbyte 切分 —— 分类 / 宽度
// ════════════════════════════════════════════════════════════════════════════
//
// SysV psABI § A.2/A.3:一个 struct(≤16B)按 **eightbyte**(8 字节块)切分,
// 每个 eightbyte 独立分类:
//
//   · eightbyte 内**全是** f32/f64 → **SSE** 类,走 XMM 寄存器
//   · 否则(含任何非浮点字段)      → **INTEGER** 类,走 GPR 寄存器
//
// **宽度** = 该 eightbyte 内字段**实际覆盖到的范围**(向上取到 4 或 8)。
// 这不是可选的细节 —— gcc 的行为实测如下(docker gcc:12 -O0):
//
//   struct {int  a; int  b;}  → 1 个 INTEGER eightbyte,加载 **8** 字节
//   struct {int  a; double b;} → INTEGER(4) + SSE(8),分别加载 4 / 8 字节
//   struct {double a;}         → 1 个 SSE eightbyte,加载 **8** 字节
//   struct {float  a;}         → 1 个 SSE eightbyte,加载 **4** 字节
//
// 统一按 8 字节传是**错的**:`{int,int}` 的第二个 int 在 offset 4,若只传 4
// 字节(gcc 的做法)而 callee 按 8 字节读,第二个 int 就是垃圾;反之若 callee
// 只按 4 字节读而 caller 传 8 字节,gcc 的 callee 会丢掉高位 —— 两边都必须
// 按同一宽度。
//
// >16B 的 struct 是 MEMORY 类(整体走栈),本函数返回 0 表示「不适用」。
// MEMORY 类的栈传递是另一条路径,尚未实现 —— 见台账 W-104 的「剩余缺口」。

// abi_sysv_struct_n_eightbytes(t_raw) -> i64
//   struct 按 eightbyte 切分后的个数;0 = 不适用(非 struct / >16B / 零长)
fn abi_sysv_struct_n_eightbytes(t_raw: *u8) -> i64 {
    if t_raw == (0 as *u8) {
        return 0 as i64;
    }
    let t = t_raw as *Type;
    if (*t).kind != KIND_STRUCT() {
        return 0 as i64;
    }
    let sz = type_size(t);
    if sz <= (0 as i64) {
        return 0 as i64;
    }
    if sz > (16 as i64) {
        return 0 as i64;   // MEMORY class —— 走栈,尚未实现
    }
    return (sz + (7 as i64)) / (8 as i64);
}

// abi_sysv_struct_is_memory(t_raw) -> i32
//   >16B 的 struct 是 SysV § A.2/A.3 的 **MEMORY class** —— 整体**拷贝到栈上**
//   传递(不是传指针、也不占整数寄存器)。
//
//   ≤16B 的 struct 走 eightbyte 分类(见 abi_sysv_struct_n_eightbytes);
//   >16B 的走 MEMORY,本函数返回 1。
fn abi_sysv_struct_is_memory(t_raw: *u8) -> i32 {
    if t_raw == (0 as *u8) {
        return 0 as i32;
    }
    let t = t_raw as *Type;
    if (*t).kind != KIND_STRUCT() {
        return 0 as i32;
    }
    let sz = type_size(t);
    if sz > (16 as i64) {
        return 1 as i32;
    }
    return 0 as i32;
}

// abi_sysv_struct_mem_slots(t_raw) -> i64
//   MEMORY class 参数在栈上占的 slot 数(每 slot 8 字节,向上取整)。
//   20B 的 struct → 3 slots(24 字节)。
fn abi_sysv_struct_mem_slots(t_raw: *u8) -> i64 {
    if t_raw == (0 as *u8) {
        return 0 as i64;
    }
    let t = t_raw as *Type;
    let sz = type_size(t);
    if sz <= (0 as i64) {
        return 0 as i64;
    }
    return (sz + (7 as i64)) / (8 as i64);
}

// abi_sysv_eightbyte_class(t_raw, idx) -> i32
//   第 idx 个 eightbyte 的 class:SYSV_CLASS_INTEGER / SYSV_CLASS_SSE
fn abi_sysv_eightbyte_class(t_raw: *u8, idx: i64) -> i32 {
    if t_raw == (0 as *u8) {
        return SYSV_CLASS_INTEGER();
    }
    let t = t_raw as *Type;
    if (*t).kind != KIND_STRUCT() {
        return SYSV_CLASS_INTEGER();
    }
    let nfields = (*t).nfields;
    let fields = (*t).fields;
    let lo = idx * (8 as i64);
    let hi = lo + (8 as i64);
    let mut i: i64 = 0 as i64;
    let mut is_sse: i32 = 1 as i32;
    let mut any: i32 = 0 as i32;
    while i < nfields {
        // FieldDesc: name(*Sym 8) + type_(*Type 8) + offset(i64 8) = 24 bytes
        let fdesc = ptr_add_u8(fields, i * (24 as i64)) as *u8;
        let ftype = *(ptr_add_u8(fdesc, 8 as i64) as **Type);
        let foff = *(ptr_add_u8(fdesc, 16 as i64) as *i64);
        if foff >= lo && foff < hi {
            any = 1 as i32;
            if (*ftype).kind != KIND_PRIMITIVE() {
                is_sse = 0 as i32;
            } else {
                if (*ftype).prim != PRIM_F32() && (*ftype).prim != PRIM_F64() {
                    is_sse = 0 as i32;
                }
            }
        }
        i = i + (1 as i64);
    }
    if any == (0 as i32) {
        return SYSV_CLASS_INTEGER();
    }
    if is_sse != (0 as i32) {
        return SYSV_CLASS_SSE();
    }
    return SYSV_CLASS_INTEGER();
}

// abi_sysv_eightbyte_width(t_raw, idx) -> i64
//   第 idx 个 eightbyte 的传输宽度(字节):4 或 8
fn abi_sysv_eightbyte_width(t_raw: *u8, idx: i64) -> i64 {
    if t_raw == (0 as *u8) {
        return 8 as i64;
    }
    let t = t_raw as *Type;
    if (*t).kind != KIND_STRUCT() {
        return 8 as i64;
    }
    let nfields = (*t).nfields;
    let fields = (*t).fields;
    let lo = idx * (8 as i64);
    let hi = lo + (8 as i64);
    let mut i: i64 = 0 as i64;
    let mut extent: i64 = 0 as i64;
    while i < nfields {
        let fdesc = ptr_add_u8(fields, i * (24 as i64)) as *u8;
        let ftype = *(ptr_add_u8(fdesc, 8 as i64) as **Type);
        let foff = *(ptr_add_u8(fdesc, 16 as i64) as *i64);
        if foff >= lo && foff < hi {
            let fend = foff + type_size(ftype);
            if fend > extent {
                extent = fend;
            }
        }
        i = i + (1 as i64);
    }
    if extent <= (4 as i64) {
        return 4 as i64;
    }
    return 8 as i64;
}

// abi_sysv_eightbyte_letter(t_raw, idx) -> i32
//   第 idx 个 eightbyte 的 QBE 字母:INTEGER→l/w,SSE→d/s
//   (与 gcc 的 movq/movl/movsd/movss 对应)
fn abi_sysv_eightbyte_letter(t_raw: *u8, idx: i64) -> i32 {
    let cls = abi_sysv_eightbyte_class(t_raw, idx);
    let w = abi_sysv_eightbyte_width(t_raw, idx);
    if cls == SYSV_CLASS_SSE() {
        if w <= (4 as i64) {
            return QBE_S();
        }
        return QBE_D();
    }
    if w <= (4 as i64) {
        return QBE_W();
    }
    return QBE_L();
}

fn abi_sysv_classify_arg(t_raw: *u8) -> i32 {
    if t_raw == (0 as *u8) {
        return SYSV_CLASS_INTEGER();
    }
    let t = t_raw as *Type;
    let kind = (*t).kind;
    // SSE: f32 / f64 (KIND_PRIMITIVE + prim in {PRIM_F32, PRIM_F64})
    if kind == KIND_PRIMITIVE() {
        if (*t).prim == PRIM_F32() {
            return SYSV_CLASS_SSE();
        }
        if (*t).prim == PRIM_F64() {
            return SYSV_CLASS_SSE();
        }
        return SYSV_CLASS_INTEGER();
    }
    // MEMORY: struct > 16 bytes (SysV § A.4)
    if kind == KIND_STRUCT() {
        if (*t).size > (16 as i64) {
            return SYSV_CLASS_MEMORY();
        }
        // Small struct (≤16B): INTEGER class (passed in 1-2 regs)
        return SYSV_CLASS_INTEGER();
    }
    if kind == KIND_ARRAY() {
        // Arrays are passed by reference (MEMORY)
        return SYSV_CLASS_MEMORY();
    }
    // INTEGER: pointer / slice / func / unknown
    if kind == KIND_POINTER() {
        return SYSV_CLASS_INTEGER();
    }
    if kind == KIND_SLICE() {
        return SYSV_CLASS_INTEGER();
    }
    if kind == KIND_FUNC() {
        return SYSV_CLASS_INTEGER();
    }
    if kind == KIND_ENUM() {
        if (*t).size > (8 as i64) {
            return SYSV_CLASS_MEMORY();
        }
        return SYSV_CLASS_INTEGER();
    }
    // v3.1.4: KIND_CAP — Cap<T> is 8-byte opaque builtin (size = 8).
    //   SysV § A.2: any 8-byte aggregate = INTEGER class (RDI/RSI).
    //   Per v3.1.0 spec § 3 — Cap<T> pass-by-value on SysV uses 1 reg slot.
    //   (Carry-over from v3.1.3, formally added in v3.1.4 ship.)
    if kind == KIND_CAP() {
        return SYSV_CLASS_INTEGER();
    }
    // v3.1.4: KIND_PHANTOM — PhantomData<T> is ZST (size = 0). SysV ZSTs
    //   are ignored at the call boundary (no register consumed) but we
    //   defend with INTEGER fallback so any future layout drift doesn't
    //   miss the arg entirely. Per v3.1.1 spec.
    if kind == KIND_PHANTOM() {
        return SYSV_CLASS_INTEGER();
    }
    // Default: INTEGER (VOID / ALIAS / UNRESOLVED / unknown)
    return SYSV_CLASS_INTEGER();
}

// v2.13.0 Phase 2: full 8-class SysV § A.4 algorithm wrapper (declared AFTER
// abi_sysv_classify_arg since jhyy sema doesn't support forward refs).
//   Phase 1 v2.7.0 only does 3-class flat type check — Phase 2 recurses into
//   struct/array fields per § A.4 algorithm.
// Currently delegates to abi_sysv_classify_arg (Phase 1 3-class); Phase 2
// expands this for struct field classification (used by abi_sysv_emit_call_prelude).
fn abi_sysv_classify_arg_full(t_raw: *u8) -> i32 {
    return abi_sysv_classify_arg(t_raw);
}

// ════════════════════════════════════════════
// Stage 1c.2 mirror: abi_sysv_emit_mangled_name
// ════════════════════════════════════════════
//
// SysV uses `$mod__name` style mangling (same as Win in our self backend
// — C-side extern naming is independent of ABI). Real SysV ELF .dynsym
// uses Z-encoding for C++ or `_` prefix for C; this is a jhyy-side
// stub that mirrors Win for now.

fn abi_sysv_emit_mangled_name(ir: *IRBuf, sym_raw: *u8) -> i32 {
    let sym = sym_raw as *Sym;
    if (*sym).module != (0 as *u8) {
        ir_emit_str(ir, "$" as *u8);
        ir_emit_str(ir, (*sym).module);
        ir_emit_str(ir, "__" as *u8);
        ir_emit_str(ir, (*sym).name);
    } else {
        ir_emit_str(ir, "$" as *u8);
        if (*sym).name != (0 as *u8) {
            ir_emit_str(ir, (*sym).name);
        } else {
            ir_emit_str(ir, "?" as *u8);
        }
    }
    return 1;
}

// ════════════════════════════════════════════
// Stage 1c.2 mirror: abi_sysv_emit_function_header
// ════════════════════════════════════════════
//
// Phase 1: byte-equal mirror of abi_win_emit_function_header. QBE IL
// `export function ... {` is target-agnostic at the IL level — the
// actual register allocation (4 vs 6 regs) happens at QBE -t stage.
// Phase 2b will add SysV-specific tweaks (e.g. no sret for small struct
// return — SysV uses rax/rdx register return for ≤16B structs, not
// hidden sret pointer).
//
// Note: classifier placeholder uses abi_win_classify_arg (QBE letter) for
// Phase 1 mirror. Phase 2b will replace with abi_sysv_classify_arg + a
// class-to-letter map (INTEGER→QBE_L/QBE_W based on size; SSE→QBE_D/QBE_S;
// MEMORY→QBE_L stack pointer).

fn abi_sysv_emit_function_header(
    ir: *IRBuf,
    fn_sym: *Sym,
    ret_qt: i32,
    is_sret: i32,
    params: *u8,
    nparams: i64
) -> i32 {
    ir_emit_str(ir, "export function " as *u8);
    if ret_qt != (0 as i32) {
        ir_emit_int(ir, "%c " as *u8, ret_qt);
    }
    abi_sysv_emit_mangled_name(ir, fn_sym as *u8);
    ir_emit_str(ir, "(" as *u8);
    let mut first: i32 = 1;
    if is_sret != 0 {
        ir_emit_str(ir, "l %ret" as *u8);
        first = 0;
    }
    let mut pi: i64 = 0 as i64;
    // W-104 MEMORY class:MEMORY slot 的**全局**序号(跨所有 MEMORY 参数累计)。
    // 必须跨参数循环累计 —— SysV 栈上只有 MEMORY 参数时,第 k 个 MEMORY slot
    // 就在 16(%rbp)+k*8;两个 MEMORY 参数各自从 0 起会撞名(第二个参数的
    // `__m0` 会被当成第一个参数的 slot 读)。
    let mut mem_slot_base: i64 = 0 as i64;
    while pi < nparams {
        if first == 0 {
            ir_emit_str(ir, ", " as *u8);
        }
        first = 0;
        let param_slot = ptr_add_u8(params, pi * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
        let p_sym_raw = (*param_slot).sym;
        let p_sym = p_sym_raw as *Sym;
        let mut pt: *u8 = 0 as *u8;
        if (*p_sym).type_ptr != (0 as *u8) {
            pt = (*p_sym).type_ptr;
        }
        // W-104 (2026-10-19):struct 参数按 **eightbyte 拆成多个 IL 参数**。
        //
        // 之前一律用 abi_win_classify_arg(struct) → QBE_L,即「一个 64 位
        // 指针槽」。caller 与 callee 都按这个约定,彼此自洽 —— 于是
        // **所有现有测试都过**,但与 gcc 的 SysV 完全不兼容
        // (实测:jhyy caller → gcc callee,退出码 171,应为 44)。
        //
        // 拆开后,self-backend 看到的是普通标量参数,寄存器分配
        // (INTEGER→GPR / SSE→XMM)与栈溢出全走既有机制。callee 侧由
        // codegen.jhyy 的「register params as locals」循环把八个byte
        // 重建回一个连续的 struct 槽。
        //
        // ⚠️ 这里刻意用「先 while 再 if(n_emitted==0)」而不是 if/else:
        // jhyy 要求 if/else 两个分支**表达式类型相同**,而 while 的类型是
        // void、ir_emit_str 的返回是 i32 —— 放一起就报
        // "if/else branches must have same type"。
        let n_eb = abi_sysv_struct_n_eightbytes(pt);
        // W-104: 本参数已 emit 的 IL 参数个数(0 = 走下面的「单参数」老路径)。
        // ⚠️ 必须声明在 if/else **外面** —— 之前它被声明在 else 块里却在块外
        //    被读(jhyy 的块作用域不保证可见性),MEMORY 分支下读到的是垃圾。
        let mut n_emitted: i64 = 0 as i64;
        // W-104 MEMORY class:>16B 的 struct 整体走栈。header 里声明成 N 个
        // 8 字节 slot,名字带 `__m<k>`(k = **跨所有 MEMORY 参数累计**的 slot
        // 序号 —— 必须在参数循环外累计,否则两个 MEMORY 参数会撞名)。callee 侧
        // 由 self-backend 识别这个名字 → 从 16(%rbp)+k*8 读。
        if abi_sysv_struct_is_memory(pt) != (0 as i32) {
            let nslots = abi_sysv_struct_mem_slots(pt);
            let mut k2: i64 = 0 as i64;
            while k2 < nslots {
                if k2 > (0 as i64) {
                    ir_emit_str(ir, ", " as *u8);
                }
                // letter 用 'l'(64 位)—— self-backend 不解析 header 的 letter
                // (lexer 整体跳过 args 部分),真正决定读法的是 body 里那条
                // copy 的目标 temp 类型 + 名字里的 __m 标记。
                ir_emit_str(ir, "l %" as *u8);
                ir_emit_str(ir, (*p_sym).name);
                ir_emit_str(ir, "__m" as *u8);
                ir_emit_int(ir, "%d" as *u8, mem_slot_base + k2);
                k2 = k2 + (1 as i64);
            }
            mem_slot_base = mem_slot_base + nslots;
            n_emitted = nslots;
        } else {
            let mut k: i64 = 0 as i64;
            while k < n_eb {
                if k > (0 as i64) {
                    ir_emit_str(ir, ", " as *u8);
                }
                let lqt = abi_sysv_eightbyte_letter(pt, k);
                ir_emit_int(ir, "%c " as *u8, lqt);
                ir_emit_str(ir, "%" as *u8);
                ir_emit_str(ir, (*p_sym).name);
                ir_emit_str(ir, "__e" as *u8);
                ir_emit_int(ir, "%d" as *u8, k);
                n_emitted = n_emitted + (1 as i64);
                k = k + (1 as i64);
            }
        }
        if n_emitted == (0 as i64) {
            // 非 struct(或 >16B 的 MEMORY class):单参数,沿用原逻辑
            if pt != (0 as *u8) {
                let pqt = abi_win_classify_arg(pt);
                ir_emit_int(ir, "%c " as *u8, pqt);
                ir_emit_str(ir, "%" as *u8);
                ir_emit_str(ir, (*p_sym).name);
            } else {
                ir_emit_str(ir, "w %" as *u8);
                ir_emit_str(ir, (*p_sym).name);
            }
        }
        pi = pi + (1 as i64);
    }
    ir_emit_str(ir, ") {\n" as *u8);
    let start_block = *ir_new_block(ir, "start" as *u8);
    ir_emit_label(ir, start_block);
    return 1;
}

// ════════════════════════════════════════════
// Stage 1c.3 mirror: abi_sysv_emit_return
// ════════════════════════════════════════════
//
// Phase 1: byte-equal mirror. SysV small struct (≤16B) return uses
// rax/rdx register return, but QBE -t amd64_sysv handles this at the
// backend stage, not at the IR emit stage. Phase 2b may diverge for
// large struct return (>16B) — caller allocates memory, callee writes,
// caller copies (same pattern as Win sret, but no hidden sret param in
// SysV — instead the return value is written to a caller-provided
// address passed implicitly via a calling convention metadata register).

fn abi_sysv_emit_return(ir: *IRBuf, val: IRVal, is_sret: i32) -> i32 {
    if is_sret != 0 {
        let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let _r = ir_emit_ret(ir, v);
    } else if val.qbe_type != (0 as i32) {
        let _r = ir_emit_ret(ir, val);
    } else {
        let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let _r = ir_emit_ret(ir, v);
    }
    return 1;
}

// ════════════════════════════════════════════
// Stage 1c.4 mirror: abi_sysv_emit_call_prelude
// ════════════════════════════════════════════
//
// Phase 1: byte-equal mirror. Same args buffer + sret slot alloc pattern
// as Win. Phase 2b may diverge for SysV vararg (need al register save /
// xmm register save before call) and for SysV struct-pass-by-class
// (INTEGER vs SSE vs MEMORY routing).

fn abi_sysv_emit_call_prelude(
    ir: *IRBuf,
    arena: *u8,
    n_user_args: i64,
    is_sret: i32,
    rsize: i32,
    out_ret_slot: *u8
) -> *u8 {
    let extra: i64 = if is_sret != 0 { (1 as i64) } else { (0 as i64) };
    let total = n_user_args + extra;
    let mut args_arr: *u8 = 0 as *u8;
    if total > 0 {
        let arena_a = arena as *Arena;
        args_arr = arena_alloc(arena_a, total * IRVAL_SIZE());
    }
    let mut ret_slot: IRVal = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
    if is_sret != 0 {
        ret_slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, ret_slot, rsize);
        if total > 0 {
            let slot0 = args_arr as *i32;
            *slot0 = ret_slot.kind;
            *(ptr_add_u8(args_arr, 4 as i64) as *i32) = ret_slot.id;
            *(ptr_add_u8(args_arr, 8 as i64) as *i64) = ret_slot.ival;
            *(ptr_add_u8(args_arr, 16 as i64) as **u8) = ret_slot.name;
            *(ptr_add_u8(args_arr, 24 as i64) as *i32) = ret_slot.qbe_type;
        }
    }
    if out_ret_slot != (0 as *u8) {
        let kind_p = out_ret_slot as *i32;
        let id_p = ptr_add_u8(out_ret_slot, 4 as i64) as *i32;
        let ival_p = ptr_add_u8(out_ret_slot, 8 as i64) as *i64;
        let name_p = ptr_add_u8(out_ret_slot, 16 as i64) as **u8;
        let qt_p = ptr_add_u8(out_ret_slot, 24 as i64) as *i32;
        *kind_p = ret_slot.kind;
        *id_p = ret_slot.id;
        *ival_p = ret_slot.ival;
        *name_p = ret_slot.name;
        *qt_p = ret_slot.qbe_type;
    }
    return args_arr;
}

// ════════════════════════════════════════════
// Stage 1c.5 mirror: abi_sysv_emit_struct_arg_slot
// ════════════════════════════════════════════
//
// Phase 1: byte-equal mirror. Per SysV psABI § A.4, structs are passed
// by class (INTEGER/SSE/MEMORY) — small structs ≤16B go in registers
// (1-2 INTEGER regs or 1 SSE reg), large structs go by stack pointer.
// The actual class-based dispatch is in `emit_amd64_arg_regs` (Phase 2b)
// — this function still allocates the stack slot for the MEMORY class.

fn abi_sysv_emit_struct_arg_slot(ir: *IRBuf, struct_type_raw: *u8) -> IRVal {
    let mut asize: i32 = 0;
    if struct_type_raw != (0 as *u8) {
        asize = type_size(struct_type_raw as *Type) as i32;
    }
    if asize < (4 as i32) {
        asize = 4;
    }
    let copy_slot = *ir_new_tmp(ir, QBE_L());
    ir_emit_alloc(ir, copy_slot, asize);
    return copy_slot;
}