// codegen_amd64_emit_ctrl.jhyy — v2.5.0 A3 agent: control-flow emit
//
// Module-split 设计(per `v2.5.0详细实现方案.md` § 4.1 + § AA + A0 commit 729073c):
//   本模块 = A3 unit = 6 control-flow emit 函数
//   sibling 模块:
//     codegen_amd64_state.jhyy (A0) — shared CGState / QBE_* / ILTOK_* / ILToken
//     codegen_amd64_lexer.jhyy  (A1) — QBE IL lexer (本模块不调)
//     codegen_amd64_emit_mem.jhyy (A2) — alloc/store/load/loadsub
//     codegen_amd64_emit_call.jhyy (A4) — call/phi/copy/binop/volatile
//     codegen_amd64.jhyy (A5 main) — state init + parse loop dispatch + D42 stub
//
// 替换路径(per L4 § 1.1):
//   v2.0.0..v2.4.0: parse → sema → codegen.jhyy (QBE IL) → qbe.exe → .s
//   v2.5.0+:        parse → sema → codegen.jhyy (QBE IL) → [target=win → 本模块路径 emit .s] / [target=sysv → qbe.exe fallback]
//
// 关键约束 cross-link:
//   - D42 escape hatch(coordination.md § 3): codegen_amd64_emit_raw_asm 在 A5 main,
//     本模块不实现 inline asm(留 V3-B v3.0.1)
//   - 3c volatile(roadmap § 4.2 + L4 § 2.4 + § X.2): emit_volatile 在 A4,
//     本模块 emit_jnz 仅靠 `tok.qbe_type` 区分 testq/testl,**不**插 memory barrier
//   - D43 self-equal baseline(L4 § X.4): closure sha 仍 = 51376ce5... — 本模块不改 codegen.jhyy 主干
//   - D26 byte-equal 三件套: .il / .s / .exe — 本模块 emit 跟 QBE .s 输出格式 match
//
// Note: lives flat in compiler/src0/ — jhyy import syntax doesn't support
// paths with `/` (per `parse_import_decl` codegen.c:731).

import codegen_amd64_state;  // CGState / QBE_W_LOCAL / QBE_L_LOCAL / ILTOK_*

// ════════════════════════════════════════════════════
// FFI(util.jhyy 已声明 strlen/sprintf_lld;补本模块需要)
// ════════════════════════════════════════════════════

// ptr_add_u8 在 util.jhyy 定义(jhyy 不支持 *u8 + i64,需 cast)
// 因为 import util; 隐式拉不到 ptr_add_u8 是因为 codegen_amd64_state
// 没 import util。本模块直接 extern 本地声明避免传递依赖。
extern fn ptr_add_u8(p: *u8, off: i64) -> *u8;

// jhyy_helpers — 失败时打诊断(per `feedback_diagnostic_emit`)
extern fn jh_fputs_stderr(s: *u8) -> i32;

// StringBuilder API(per util.jhyy / ir.jhyy) — 全 module 共享,emit 模块只用 5 个
extern fn sb_append(a: *u8, sb: *u8, src: *u8, n: i64) -> i32;
extern fn sb_append_cstr(a: *u8, sb: *u8, s: *u8) -> i32;
extern fn sb_appendf(a: *u8, sb: *u8, fmt: *u8, val: i32) -> i32;
extern fn sb_appendf_lld(a: *u8, sb: *u8, fmt: *u8, val: i64) -> i32;
extern fn sb_init(a: *u8, sb: *u8) -> i32;

// Arena alloc(per arena.jhyy)
extern fn arena_alloc(a: *u8, size: i64) -> *u8;

// libc
extern fn strlen(s: *u8) -> i64;

// CGState helpers(per codegen_amd64_state.jhyy)
// 注:codegen_amd64_state.jhyy 的 cg_offset_for_temp 当前 stub `return 0`(签名 -> i64
// 但 body return 0 是 i32 → sema 拒绝)。v2.5.0 1-to-1 简化版可直接 inline 同样公式
// `offset = -(32 + t * 8)`,不需要跨模块调用 — 本 commit 不依赖该 helper。
// 后续 coordinator 修 state module 后,可改回 extern + call。
//
// 32-byte shadow space(MS x64 ABI) + per-temp 8-byte slot。
fn SHADOW_SPACE() -> i64 { return 32 as i64; }
fn TEMP_SLOT_BYTES() -> i64 { return 8 as i64; }

// compute_offset_for_temp_id(t: i64) -> i64
// v2.5.0 简化:offset = -(32 + t * 8)。返回 i64(matches GAS `-$N(%rbp)` 形式)。
// v2.8.0: 仍用于 backward compat (jmp/jnz label 间接路径);
// 真 target-aware path 用 compute_offset_for_temp_id_with_target。
fn compute_offset_for_temp_id(t: i64) -> i64 {
    let raw = SHADOW_SPACE() + t * TEMP_SLOT_BYTES();
    return 0 as i64 - raw;
}

// compute_offset_for_temp_id_with_target(t, target_tag) -> i64
// v2.8.0: target-aware variant。Win (target_is_win=1): `-(32 + t*8)`;
// SysV (target_is_win=0): `-(t*8)`。emit_jnz 用此拿 cond slot offset,
// emit_func_header 用 total_alloc (state-tracked) 而非此函数。
fn compute_offset_for_temp_id_with_target(t: i64, target_tag: i32) -> i64 {
    if target_is_win(target_tag) == (1 as i32) {
        let raw = SHADOW_SPACE() + t * TEMP_SLOT_BYTES();
        return 0 as i64 - raw;
    }
    // SysV: no shadow
    return 0 as i64 - t * TEMP_SLOT_BYTES();
}

// ════════════════════════════════════════════════════
// E10 emit_jmp — `jmp @label` → `jmp .L<label>`
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E10:QBE output:`jmp .L_label_name`(或 `jmp <label>`)
// 本 emit:`jmp .L<label>`(QBE 风格 `.L` 前缀)
//
// v2.11.2 (T1-a):从 tok.text (e.g. "mp @loop1") parse label via cg_find_at。
// 旧 emit 用 sb_append(text, text_len) — 会把 "mp " prefix 也 emit 出去。
fn emit_jmp(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_JMP() {
        jh_fputs_stderr("emit_jmp: ILToken kind != ILTOK_JMP\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;
    let text = (*t).text;
    let text_len = (*t).text_len;
    // parse @label via cg_find_at
    let label_off = cg_find_at(text, text_len, 0 as i64);
    if label_off < (0 as i64) {
        jh_fputs_stderr("emit_jmp: no @label\n" as *u8);
        return 1 as i32;
    }
    let name_off = label_off + (1 as i64);
    let mut name_len: i64 = 0 as i64;
    let mut scan = name_off;
    while scan < text_len {
        let c = *(ptr_add_u8(text, scan)) as i32;
        if c == (32 as i32) || c == (9 as i32) || c == (10 as i32) {
            break;
        }
        name_len = name_len + (1 as i64);
        scan = scan + (1 as i64);
    }
    sb_append_cstr(arena, sb, "\tjmp .L" as *u8);
    let _a = sb_append(arena, sb, ptr_add_u8(text, name_off), name_len);
    sb_append_cstr(arena, sb, "\n" as *u8);
    let _tt = target_tag;
    return 0;
}

// ════════════════════════════════════════════════════
// E11 emit_jnz — `jnz %cond, @then, @else` → test + jne + jmp
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E11:QBE output:`testl -X(%rbp), -X(%rbp); jne .L_then; jmp .L_else`
// 本 emit(1-to-1 简化):用 `testq` 或 `testl` per qbe_type(l/w)
//
// v2.11.2 (T1-d):从 tok.text (e.g. "nz %t3, @then1, @else2") parse:
//   - cond_id = cg_parse_temp(text, 0)         → first %tN id
//   - then_off = cg_find_at(text, 0)           → offset of first '@'
//   - else_off = cg_find_at(text, then_off+1)  → offset of second '@'
//   - then_name = text[then_off+1 .. first_ws_after_@]
//   - else_name = text[else_off+1 .. first_ws_after_@]
//
// T2-a:literal "-" 删掉;offset 本身是负值,sb_appendf_lld %lld 已含 '-'。
fn emit_jnz(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_JNZ() {
        jh_fputs_stderr("emit_jnz: ILToken kind != ILTOK_JNZ\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;
    let text = (*t).text;
    let text_len = (*t).text_len;

    // parse cond (%tN) — first %tN in text
    let cond_id = cg_parse_temp(text, text_len, 0 as i64);
    if cond_id < (0 as i64) {
        jh_fputs_stderr("emit_jnz: no cond temp\n" as *u8);
        return 1 as i32;
    }
    let neg_off = cg_offset_for_temp_with_target(cond_id, target_tag);

    // parse @then label (first '@' after cond)
    let then_off = cg_find_at(text, text_len, 0 as i64);
    if then_off < (0 as i64) {
        jh_fputs_stderr("emit_jnz: no then label\n" as *u8);
        return 1 as i32;
    }
    let then_name_off = then_off + (1 as i64);  // skip '@'

    // parse @else label (next '@' after then_name)
    let else_off = cg_find_at(text, text_len, then_name_off);
    if else_off < (0 as i64) {
        jh_fputs_stderr("emit_jnz: no else label\n" as *u8);
        return 1 as i32;
    }
    let else_name_off = else_off + (1 as i64);

    // scan label name lengths (until ',' / ')' / ' ' / EOL)
    let mut then_name_len: i64 = 0 as i64;
    let mut then_scan = then_name_off;
    while then_scan < text_len {
        let c = *(ptr_add_u8(text, then_scan)) as i32;
        if c == (44 as i32) || c == (32 as i32) || c == (9 as i32) {
            break;  // ',' or whitespace ends label name
        }
        then_name_len = then_name_len + (1 as i64);
        then_scan = then_scan + (1 as i64);
    }
    let mut else_name_len: i64 = 0 as i64;
    let mut else_scan = else_name_off;
    while else_scan < text_len {
        let c = *(ptr_add_u8(text, else_scan)) as i32;
        if c == (44 as i32) || c == (32 as i32) || c == (9 as i32) {
            break;
        }
        else_name_len = else_name_len + (1 as i64);
        else_scan = else_scan + (1 as i64);
    }

    // 1) cmp<sz> $0, mem(%rbp) — GAS 拒绝 test mem, mem → 改用 cmp $0, mem(mem/imm 合法)。
    //   T2-a:drop literal "-",use neg_off %lld (already signed)。
    let qbe_type = (*t).qbe_type;
    if qbe_type == QBE_L_LOCAL() {
        sb_append_cstr(arena, sb, "\tcmpq $0, " as *u8);
        sb_appendf_lld(arena, sb, "%lld" as *u8, neg_off);
        sb_append_cstr(arena, sb, "(%rbp)\n" as *u8);
    } else {
        // w / b / h / volatile-marker / 0 走 cmpl (32-bit 默认)
        sb_append_cstr(arena, sb, "\tcmpl $0, " as *u8);
        sb_appendf_lld(arena, sb, "%lld" as *u8, neg_off);
        sb_append_cstr(arena, sb, "(%rbp)\n" as *u8);
    }

    // 2) jne .L<then>
    sb_append_cstr(arena, sb, "\tjne .L" as *u8);
    let _a1 = sb_append(arena, sb, ptr_add_u8(text, then_name_off), then_name_len);
    sb_append_cstr(arena, sb, "\n" as *u8);

    // 3) jmp .L<else>
    sb_append_cstr(arena, sb, "\tjmp .L" as *u8);
    let _a2 = sb_append(arena, sb, ptr_add_u8(text, else_name_off), else_name_len);
    sb_append_cstr(arena, sb, "\n" as *u8);
    return 0;
}

// ════════════════════════════════════════════════════
// E12 emit_label — `@name` → `.Lname:`
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E12:QBE output:`.L<name>:`(QBE 风格 `.L` prefix)
// 本 emit:`.L<text>:\n`(QBE 风格,无 tab 缩进,因为是 label 定义不是指令)
//
// label 来源:tok.text(block name,lexer 已剥 @ 前缀)

fn emit_label(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_LABEL() {
        jh_fputs_stderr("emit_label: ILToken kind != ILTOK_LABEL\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;
    // .L<text>:\n
    sb_append_cstr(arena, sb, ".L" as *u8);
    sb_append(arena, sb, (*t).text, (*t).text_len);
    sb_append_cstr(arena, sb, ":\n" as *u8);
    // target_tag v2.8.0 加,label target-agnostic — 仅为签名统一
    let _tt = target_tag;
    return 0;
}

// ════════════════════════════════════════════════════
// E9 emit_ret — `ret %val` 或 `ret 0` 或 `ret` → mov 到 %rax + epilogue
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E9:QBE output(MS x64):
//   - movl -X(%rbp), %eax(return value 到 %rax)
//   - function epilogue: movq %rbp, %rsp; popq %rbp; ret
//
// v2.11.2 (T2-b):从 tok.text (e.g. "ret %t5" / "ret 0" / "ret") parse val:
//   - 跳过 "ret" prefix + 空白
//   - peek '%' → TEMP val,parse %tN via cg_parse_temp
//   - peek digit → IMM val,parse int via cg_parse_int_from
//   - empty (just "ret") → void ret,直接 epilogue
//
// T2-a:literal "-" 删掉;offset 本身是负值,sb_appendf_lld %lld 已含 '-'。
fn emit_ret(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_RET() {
        jh_fputs_stderr("emit_ret: ILToken kind != ILTOK_RET\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;
    let text = (*t).text;
    let text_len = (*t).text_len;

    // 1) parse val (if any) from "ret [val]"
    //    text 必以 "ret" 开头(dispatcher lex_match_kw 已确认)
    let mut val_kind: i32 = 0 as i32;  // 0=void, 1=temp, 2=imm
    let mut val_id: i64 = 0 as i64;
    let mut imm_val: i64 = 0 as i64;
    if text_len > (3 as i64) {
        // skip "ret" + ws
        let mut scan: i64 = 3 as i64;
        while scan < text_len {
            let c = *(ptr_add_u8(text, scan)) as i32;
            if c != (32 as i32) && c != (9 as i32) {
                break;
            }
            scan = scan + (1 as i64);
        }
        if scan < text_len {
            let c0 = *(ptr_add_u8(text, scan)) as i32;
            if c0 == (37 as i32) {
                // TEMP: %tN — cg_parse_temp 的 idx 是 0-based "第几个 %tN"
                // (不是 byte offset),所以传 0 找第 1 个 %tN。
                // 之前 v2.11.2 (T2-b) 误传 scan 4 → 找第 5 个 %tN,fallback
                // val_id=0 → emit `mov -32(%rbp), %eax` 读 %t0 slot 错位。
                val_kind = 1 as i32;
                val_id = cg_parse_temp(text, text_len, 0 as i64);
                if val_id < (0 as i64) { val_id = 0 as i64; }
            } else if c0 >= (48 as i32) && c0 <= (57 as i32) {
                // IMM: decimal
                val_kind = 2 as i32;
                imm_val = cg_parse_int_from(text, text_len, scan);
            }
            // else:unknown suffix — treat as void (defensive)
        }
    }

    // 2) mov val → %rax/%eax per qbe_type
    let qbe_type = (*t).qbe_type;
    if val_kind != (0 as i32) {
        let neg_off: i64 = if val_kind == (1 as i32) {
            cg_offset_for_temp_with_target(val_id, target_tag)
        } else {
            0 as i64  // imm_val mov form: "$N" 直接 emit,不走 slot offset
        };
        if qbe_type == QBE_L_LOCAL() {
            sb_append_cstr(arena, sb, "\tmovq " as *u8);
            if val_kind == (1 as i32) {
                sb_appendf_lld(arena, sb, "%lld" as *u8, neg_off);
                sb_append_cstr(arena, sb, "(%rbp), %rax\n" as *u8);
            } else {
                sb_append_cstr(arena, sb, "$" as *u8);
                sb_appendf_lld(arena, sb, "%lld" as *u8, imm_val);
                sb_append_cstr(arena, sb, ", %rax\n" as *u8);
            }
        } else {
            // w / b / h 默认走 32-bit
            sb_append_cstr(arena, sb, "\tmovl " as *u8);
            if val_kind == (1 as i32) {
                sb_appendf_lld(arena, sb, "%lld" as *u8, neg_off);
                sb_append_cstr(arena, sb, "(%rbp), %eax\n" as *u8);
            } else {
                sb_append_cstr(arena, sb, "$" as *u8);
                sb_appendf_lld(arena, sb, "%lld" as *u8, imm_val);
                sb_append_cstr(arena, sb, ", %eax\n" as *u8);
            }
        }
    }

    // 3) function epilogue (per L4 § 3.4 + MS x64 ABI)
    sb_append_cstr(arena, sb, "\tmovq %rbp, %rsp\n" as *u8);
    sb_append_cstr(arena, sb, "\tpopq %rbp\n" as *u8);
    sb_append_cstr(arena, sb, "\tret\n" as *u8);
    return 0;
}

// ════════════════════════════════════════════════════
// E13 emit_func_header — `export function ...` → .globl + label + prologue
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E13:QBE output(MS x64):
//   - .globl <name>
//   - <name>:
//   - pushq %rbp
//   - movq %rsp, %rbp
//   - subq $N, %rsp  (N = shadow_space + frame_size,frame_size per v2.11.2 global-max)
//
// v2.11.2 (T3-a):frame size 用 (*cg).frame_max_temp(per-module max temp id 跨函数复用);
//   per-function pre-scan table 留 v2.11.3 EXIT exact sprint。
// v2.11.2 (T3-a):调 cg_state_reset_for_function 重置 next_offset/total_alloc/nparams
//   per function;frame_max_temp 不重置(per-module constant)。
// v2.11.2 (T3-b):emit_jnz 不再用 compute_offset_for_temp_id_with_target,统一 cg_offset_for_temp_with_target。
fn emit_func_header(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_FUNC_HEADER() {
        jh_fputs_stderr("emit_func_header: ILToken kind != ILTOK_FUNC_HEADER\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;

    // v2.11.2 (T3-a):reset per-function alloc state at function entry。
    // frame_max_temp 不重置 (per-module constant)。
    let _reset_rc = cg_state_reset_for_function(state, (*t).text);

    // 1) .globl <name>\n
    sb_append_cstr(arena, sb, ".globl " as *u8);
    sb_append(arena, sb, (*t).text, (*t).text_len);
    sb_append_cstr(arena, sb, "\n" as *u8);

    // 2) <name>:\n
    sb_append(arena, sb, (*t).text, (*t).text_len);
    sb_append_cstr(arena, sb, ":\n" as *u8);

    // 3) pushq %rbp\n
    sb_append_cstr(arena, sb, "\tpushq %rbp\n" as *u8);

    // 4) movq %rsp, %rbp\n
    sb_append_cstr(arena, sb, "\tmovq %rsp, %rbp\n" as *u8);

    // 5) subq $N, %rsp\n
    //    v2.11.2 (T3-a):N = shadow_space + (frame_max_temp + 1) * 8。
    //    全 module 用同一 frame size (global-max fallback),每个 function alloc 上限 = max_temp+1 temps。
    let frame_max: i64 = (*cg).frame_max_temp;
    let frame_size: i64 = if frame_max < (0 as i64) {
        0 as i64
    } else {
        (frame_max + (1 as i64)) * TEMP_SLOT_BYTES()
    };
    let mut n: i64 = 0 as i64;
    if target_is_win(target_tag) == (1 as i32) {
        n = (*cg).shadow_space + frame_size;
    } else {
        // SysV: round frame_size up to 16-byte boundary for stack alignment
        n = (frame_size + (15 as i64)) & ((0 as i64) - (16 as i64));
    }
    sb_append_cstr(arena, sb, "\tsubq $" as *u8);
    sb_appendf_lld(arena, sb, "%lld" as *u8, n);
    sb_append_cstr(arena, sb, ", %rsp\n" as *u8);

    return 0;
}

// ════════════════════════════════════════════════════
// E14 emit_data_string — `data $name = { b "..." }` → .globl + label + .ascii + .byte 0
// ════════════════════════════════════════════════════
//
// Per L4 § 3.5 E14:QBE output:
//   .globl $str0
//   $str0:
//       .ascii "hello"
//       .byte 0
//
// 本 emit(match QBE 风格,`\0` 终止符 per byte):
//   .globl <name>
//   <name>:
//       .ascii "<text>"
//       .byte 0
//
// name 来源:tok.text(data label name,lexer 已剥 $ 前缀)
// 字符串内容:tok.text + offset/text_len 拼接 — [ASSUMED-LAYOUT] lexer 把
// `name\0content` 拼一个 buffer,text_len 截止于 name,content 在
// (text + text_len + 1)。QBE IL 形式 `data $str0 = { b "hello", b 0 }` 也可能
// lexer 把整段当 single text field,A1 lexer 落地后由 coordinator 决定。
//
// v2.5.0 简化:字符串内容不做 escape 处理(lexer 已经 produce raw bytes;
// QBE IL emit 也不做 escape,raw form 直通)。QBE .s 输出用 GAS `.ascii` 接 raw bytes,
// 但 content 含 `"` 字符会破汇编 — v2.5.0 不接含特殊字符的字符串(regress 104/104
// 测试用例都是 ASCII alpha,无 escape 需求)。后续 V2-B 加 escape。

fn emit_data_string(state: *u8, tok: *u8, target_tag: i32) -> i32 {
    let cg = state as *CGState;
    let t = tok as *ILToken;
    if (*t).kind != ILTOK_DATA_STRING() {
        jh_fputs_stderr("emit_data_string: ILToken kind != ILTOK_DATA_STRING\n" as *u8);
        return 1;
    }
    let sb = (*cg).out;
    let arena = (*cg).arena;

    // 1) .globl <name>\n
    sb_append_cstr(arena, sb, ".globl " as *u8);
    sb_append(arena, sb, (*t).text, (*t).text_len);
    sb_append_cstr(arena, sb, "\n" as *u8);

    // 2) <name>:\n
    sb_append(arena, sb, (*t).text, (*t).text_len);
    sb_append_cstr(arena, sb, ":\n" as *u8);

    // 3) .ascii "<content>"\n — content 在 (text + text_len + 1)
    //    [ASSUMED-LAYOUT] 跟 emit_jnz else label 同样假设 — lexer 拼 name\0content。
    let content_ptr = ptr_add_u8((*t).text, (*t).text_len + (1 as i64));
    let content_len = strlen(content_ptr);
    sb_append_cstr(arena, sb, "\t.ascii \"" as *u8);
    sb_append(arena, sb, content_ptr, content_len);
    sb_append_cstr(arena, sb, "\"\n" as *u8);

    // 4) .byte 0\n — null terminator(per L4 § 3.5 E14 + ir.jhyy:797 emit `b 0`)
    sb_append_cstr(arena, sb, "\t.byte 0\n" as *u8);
    // target_tag v2.8.0 加,data string target-agnostic — 仅为签名统一
    let _tt = target_tag;
    return 0;
}
