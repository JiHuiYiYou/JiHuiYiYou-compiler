fn parse_and_emit(state: *u8, tokens: *u8, n: i64) -> i32 {
    // v2.5.0 skeleton:stub — return 0 占位;Phase 3b 填实现
    let _ = state;
    let _ = tokens;
    let _ = n;
    return 0;
}

// ════════════════════════════════════════════════════
// 内部:文件 I/O 包装(per L4 § 4.1)
// ════════════════════════════════════════════════════
//
// 所有 IL/二进制派生文件必须 "wb"(per memory `feedback_qbe_crlf_root_cause`):
// QBE 行号偏移错 = Windows fopen "w" 写 .il 把 \n 转 \r\n。

fn read_file(path: *u8) -> *u8 {
    // 全文件读取,返回 *u8(arena-alloc)
    // Phase 3b 实现:jh_fopen_rb + jh_file_size + jh_fread + arena alloc
    let _ = path;
    return 0 as *u8;
}

fn write_file(path: *u8, content: *u8, len: i64) -> i32 {
    // 全文件写,用 "wb"(per `feedback_qbe_crlf_root_cause`)
    // Phase 3b 实现:jh_fopen_wb + jh_fwrite + jh_fclose
    let _ = path;
    let _ = content;
    let _ = len;
    return 0;
}
