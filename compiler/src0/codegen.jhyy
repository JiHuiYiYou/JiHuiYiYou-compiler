// codegen.jhyy — JHYY 翻译自 compiler/src/codegen.c
// v1.0.0 sprint 4 commit 2, 2026-06-30
//
// 翻译要点：
//   - LocalEntry / CGContext：jhyy 无 static + no struct forward decl → 全部
//     arena alloc + *u8 占位（避免循环引用）+ field-by-field 初始化
//   - CGContext 含 StringBuilder/Arena/SymTable 指针都用 *u8（避开前向引用）
//     → 使用处 cast `as *CGContext`
//   - ir_emit(fmt, ...) 变参 → ir_emit_str / ir_emit_int / ir_emit_lld 拆分
//   - 不翻译：fprintf stderr warnings（codegen 不需要，sema 已检查）
//   - C `LocalEntry locals[MAX_LOCALS]` 定长数组 → jhyy arena_alloc 一次性
//     分配 MAX_LOCALS * LOCALENTRY_SIZE 字节
//   - C `body_terminates` / `body_returns` macro → jhyy 函数（避开 v0 let mut bug）
//     → 不需要 let mut，用 if-else 即可
//   - C switch (n->kind) → jhyy if-else if chain（避开 v0 switch codegen 不通）
//
// 本 commit 覆盖：
//   - § helpers (emit_mangled_name / cg_add_local / cg_find_local / ir_new_int)
//   - § load/store (cg_emit_load / cg_emit_store / cg_copy_agg)
//   - § pattern (cg_match_pattern)
//   - § convert (cg_convert_arg)
//   - § cg_expr literal cases (NODE_INT/BOOL/FLOAT/STRING/CHAR/IDENT/UNARY)
//   - § cg_module stub（占位，commit 3/4 补全）
//
// 不在本 commit（commit 3/4 处理）：
//   - cg_expr NODE_BINARY/CALL/IF/BLOCK/RETURN/EXPR_STMT
//   - cg_expr NODE_CAST/ADDR_OF/DEREF/STRUCT_LIT/ENUM_VARIANT/MATCH/INDEX/
//     ARRAY_LIT/SLICE_LIT/SLICE_RANGE/FIELD
//   - cg_stmt（NODE_LET/ASSIGN/RETURN/BREAK/CONTINUE/EXPR_STMT/FOR/WHILE）
//   - cg_func（function header + locals + body wrap）
//   - cg_module（Pass A: const data / Pass B: function emit）
//
// 关键风险（plan § 4.5）：
//   - emit 顺序 + tmp 单调编号必须跟 C 版一致 → commit 4 Stage 1 .il byte-equal
//   - QBE IL 写盘走 jh_fopen_wb（"wb"），见 sprint 4 commit 1 / feedback memory
//   - 4 个 v0 codegen bug（嵌套 struct LEA / 嵌套 if-else phi / *u8 deref loadub
//     / &local_var 漏 store）用 jhyy 内 workaround 绕开，见 feedback memory

import arena;
import util;
import types;
import ast;
import symtab;
import ir;
import lexer;  // TOKEN_* 常量（commit 2 用 TOKEN_MINUS/BANG/TILDE）
import target_dispatch;  // v2.0.0: Target tag constants (cg_module dispatch)
import abi_amd64_win;  // v2.1.0 Stage 1c.1: QBE-level ABI classify_arg
import abi_amd64_win_freestanding;  // v2.1.0 Stage 2: UE/PE/COFF entry + no_crt hooks
import abi_amd64_sysv;  // v2.7.0 Phase 1: SysV ABI module (3-class classifier + 7 fn stubs)
import abi_amd64_sysv_freestanding;  // v2.7.0 Phase 1: SysV freestanding delegate (target_sysv FS hooks)

// ════════════════════════════════════════════════════
// FFI（util.jhyy / ir.jhyy 已声明 strlen/strcmp/memset/sprintf_lld；补 codegen 需要）
// ════════════════════════════════════════════════════

extern fn jh_fputs_stderr(s: *u8) -> i32;
/* W-136:side-file 路径 per-compilation 唯一(pid 后缀)—— 见 jhyy_helpers.c */
extern fn jh_sidefile_path(name: *u8) -> *u8;
// W-104: MEMORY class 的受限实现边界 —— 遇到「不支持」的组合必须**报错退出**,
// 而不是静默产出错误的代码(见 cg_sysv_check_memory_scope)。
extern fn exit(code: i32);
extern fn jh_sprintf_f64(buf: *u8, val: f64) -> i32;
extern fn jh_sprintf_f32(buf: *u8, val: f64) -> i32;

// V3-B v3.0.1: inline asm side-file append (per feedback_qbe_crlf_root_cause:
//   IL/ASM/binary files use "ab" not "a" to avoid Windows \n→\r\n mangling).
extern fn fopen(path: *u8, mode: *u8) -> *u8;
extern fn fwrite(buf: *u8, size: i64, count: i64, fp: *u8) -> i64;
extern fn fclose(fp: *u8) -> i32;
extern fn strlen(s: *u8) -> i64;

// fprintf 重定向：v0 codegen 用 fprintf(stderr, ...) 写 warning。jhyy 走
// jh_fputs_stderr 单字符串参数风格 → caller 用 StringBuilder 拼好单字符串再传
// 注：本 commit 不实际 emit warning（C 端 codegen 也不太 emit warning），占位

// ════════════════════════════════════════════════════
// SymKind: SYM_CONST 由 symtab.jhyy 统一定义 (v0.9 wip commit 2.20 / Task #52 + #42 合并)
// ════════════════════════════════════════════════════


// ════════════════════════════════════════════════════
// 局部表容量常量（对应 C #define MAX_LOCALS / MAX_LOOP_DEPTH）
// ════════════════════════════════════════════════════

fn MAX_LOCALS()     -> i32 { return 1024 as i32; }  // Sprint 4.23 step 1: align with C-side (was 512)
fn MAX_LOOP_DEPTH() -> i32 { return 32 as i32; }
fn MAX_MATCH_ARMS() -> i32 { return 32 as i32; }

// ════════════════════════════════════════════════════
// LocalEntry
// ════════════════════════════════════════════════════

// jhyy size: sym(*u8 8) + value(IRVal 40) + is_stack(i32 4 + pad 4) = 56
type LocalEntry = struct {
    sym:      *u8,        // *Sym
    value:    IRVal,
    is_stack: i32,
}

fn LOCALENTRY_SIZE() -> i64 { return 56 as i64; }

// ════════════════════════════════════════════════════
// FieldDesc / VariantDesc / NodeFieldInit（size constants + types）
// jhyy 无 forward decl：sema.jhyy / ast.jhyy 定义了，但 codegen 翻译时
// 为避开循环引用在 codegen.jhyy 复制定义（sprint 4 commit 4）
// ════════════════════════════════════════════════════

// FieldDesc: name(*Sym *u8 8) + type(*Type *u8 8) + offset(i64 8) = 24 bytes
fn FIELD_DESC_SIZE() -> i64 { return 24 as i64; }

// VariantDesc: name(*Sym *u8 8) + payload(*Type *u8 8) + tag(i32 4 + pad 4) = 24 bytes
//   跟 v0 C 端 types.h:37-41 VariantDesc 字段对齐: name/payload/tag。
//   jhyy 端 jhyy ABI 使用 proper ABI (字段按实际类型对齐), 24 bytes。
fn VARIANT_DESC_SIZE() -> i64 { return 24 as i64; }

// NodeFieldInit: name(*u8 8) + value(*Node *u8 8) = 16 bytes
fn NODE_FIELD_INIT_SIZE() -> i64 { return 16 as i64; }

type FieldDesc = struct {
    name:   *u8,    // *Sym
    type_:  *u8,    // *Type
    offset: i64,
}

type VariantDesc = struct {
    name:    *u8,    // *Sym
    payload: *u8,    // *Type (may be NULL for nullary variant)
    tag:     i32,
}

type NodeFieldInit = struct {
    name:  *u8,
    value: *u8,
}

// ════════════════════════════════════════════════════
// CGContext（codegen 上下文）
// ════════════════════════════════════════════════════

// jhyy size:
//   ir(*u8 8) + locals(*u8 8) + nlocals(i32 4 + pad 4) +
//   current_ret_type(*u8 8) + sret_slot_id(i64 8) +
//   has_sret(i32 4 + pad 4) +
//   loop_starts(IRVal[32] = 32*40=1280) +
//   loop_ends(IRVal[32] = 1280) +
//   loop_continues(IRVal[32] = 1280) +
//   loop_depth(i32 4 + pad 4)
// ≈ 8 + 8 + 8 + 8 + 40 + 8 + 1280*3 + 8 = 3920 bytes
//
// 注：jhyy 不支持 inline 数组当 struct 字段（IRVal[32] 不行），所以 loop 标签
// 数组不能直接放 CGContext 里。**workaround**：CGContext 里只存 IRVal 数组指针
// （4 个 8 字节指针：starts/ends/continues 共 32+32+32 = 96 entries 共享一个
// arena block），单独 arena_alloc。
//
// 简化方案（commit 2）：CGContext 只放 ir + locals + nlocals + current_ret_type
// + sret_slot + has_sret + loop_depth + 4 个 IRVal 数组指针。loop arrays
// 在 cg_func 里 arena_alloc（commit 3 处理）。commit 2 不实际使用 loop arrays。
type CGContext = struct {
    ir:               *u8,        // *IRBuf
    locals:           *u8,        // *LocalEntry 数组（arena alloc，MAX_LOCALS * LOCALENTRY_SIZE）
    nlocals:          i32,
    current_ret_type: *u8,        // *Type
    // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
    // v0 codegen bug workaround: sret_slot 改为 i64 (just temp number) 而不是 IRVal
    //   struct — 避免 (*cg).sret_slot = X 这种 5-field struct value assignment
    //   在 v0 jhyy compiler 里 emit 错的 struct-to-buffer copy (bug 8: loadw
    //   kind 当成 src base 算 next field offset). id 字段 = temp number = 唯一
    //   真正用得到的字段.
    sret_slot_id:     i64,
    has_sret:         i32,
    loop_depth:       i32,
    loop_starts:      *u8,        // *IRVal[32]
    loop_ends:        *u8,        // *IRVal[32]
    loop_continues:   *u8,        // *IRVal[32]
    current_fn:       *u8,        // *NodeFuncDecl (v1.3.6: for cg_emit_defers on ret)
    // v1.3.5: #[inline] attribute. inline_fns/n_inline_fns 是 cg_module pass A
    //   构建的 #[inline] fn decl 数组。call site 检查 inline_fns 决定是否 in-place
    //   展开 fn body 而不是 emit `call $fn`。current_inline_sym 用于递归守卫:
    //   检测 "正在 emit 自己的 body" 时回退到 call 防无限 inline 展开.
    inline_fns:       *u8,        // *NodeFuncDecl 数组 (arena_alloc)
    n_inline_fns:     i64,
    current_inline_sym: *u8,     // *Sym
    // v1.4.2: DWARF debug info emit (per docs/plans/v1/v1.4.0任务清单 + 概要设计.md § v1.4.2).
    //   last_dbg_line: dedup consecutive dbgloc emits with same line (cg_expr fires many times
    //                  per source line; only emit dbgloc when line changes).
    //   dbg_file_emitted: 1 if `dbgfile "<src>"` already written at cg_module top; 0 to skip if filename
    //                  is NULL (per C-side mirror).
    last_dbg_line:    i32,
    dbg_file_emitted: i32,
    // v1.4.6 W-017: module-level globals dict (Sym* → QBE data label).
    //   cg_module pass A 在遇到 NODE_LET 时 emit `data $g_x = { w 41 }` +
    //   register; cg_find_local fallthrough; cg_expr/cg_stmt 用 IRVAL_STR 形式
    //   触发 ir_emit_load/store emit `$name` (per C-side mirror)。
    mod_globals:      *u8,        // *CGModGlobal 数组 (arena_alloc)
    n_mod_globals:    i32,
    cap_mod_globals:  i32,
    // W-069 v2.6.6: fn name → pre-mangled qbe name table (mirrors C-side
    //   g_fn_defs static globals). Built in cg_module Pass A from all
    //   NODE_FUNC_DECL with is_extern=0. Read in cg_expr NODE_CALL is_extern
    //   branch to fall back to mangle when caller module mis-declared a .jhyy
    //   fn as `extern fn` (e.g. codegen_amd64_*.jhyy `extern fn ptr_add_u8`
    //   → real def is `util__ptr_add_u8` in another module). 2*i64 = +16 bytes.
    fn_defs:          *u8,        // *CGFnDef 数组 (arena_alloc, sized by n_fn_defs)
    n_fn_defs:        i64,
    // v2.8.2 W-070 真修: target_tag (0=Win, 1=WinFS, 2=SysV, 3=SysVFS per
    //   target_dispatch.jhyy 4 targets). Set in cg_module after arena_alloc
    //   cg_buf. Read in cg_func (header + 3 return emit sites) + cg_expr
    //   (2 call_prelude + 2 struct_arg_slot + 4 stmt-level return sites) to
    //   dispatch abi_win_* vs abi_sysv_*. +4 bytes (padded +4 = +8 total).
    target_tag:       i32,
    // W-104 (2026-10-19):SysV 下 struct 实参按 eightbyte 展开 —— 这两个字段
    // 暂存「刚拆出来的 eightbyte 值」,由调用方取出写进 args 数组。
    last_struct_arg_vals: *u8,   // *IRVal[] (最多 2 个)
    last_struct_arg_n:    i64,

}

// CGModGlobal layout (24 bytes): sym(0..8) + qbe_name(8..16) + qbe_type(16..20), padded to 24
fn CGMOD_GLOBAL_SIZE() -> i64 { return 24 as i64; }

// CGContext size (v1.3.5: + 3*i64 for inline_fns / n_inline_fns / current_inline_sym;
//                   v1.4.2: + 2*i32 for last_dbg_line / dbg_file_emitted;
//                   v1.4.6 W-017: + 1*i64 (mod_globals) + 2*i32 (n_mod_globals, cap_mod_globals) = +16;
//                   v2.6.6 W-069: + 2*i64 (fn_defs, n_fn_defs) — jhyy-side only, mirrors
//                                  C-side static g_fn_defs globals; C-side keeps CGContext
//                                  at 128 bytes and uses module-level statics for the same
//                                  data, so jhyy-side growing to 144 only affects jhyy-side
//                                  arena alloc, no shared-layout invariant broken;
//                   v2.8.2 W-070: + 1*i32 (target_tag) + padding = +8 bytes — jhyy-side
//                                  only, drives cg_func/cg_expr dispatch Win vs SysV ABI):
//   9*i64 (ir, locals, nlocals_pad, current_ret_type, sret_slot_id, current_fn,
//          inline_fns, n_inline_fns, current_inline_sym) = 72 +
//   has_sret(i32) + loop_depth(i32) + last_dbg_line(i32) + dbg_file_emitted(i32)
//   + n_mod_globals(i32) + cap_mod_globals(i32) = 24 +
//   3*i64 (loop_starts, loop_ends, loop_continues) = 24 +
//   1*i64 (mod_globals) = 8 +
//   2*i64 (fn_defs, n_fn_defs) = 16 +
//   1*i32 (target_tag) + padding(4) = 8
//   = 152 (was 144 before v2.8.2)
fn CGCONTEXT_SIZE() -> i64 { return 152 as i64; }

// ═══════════════════════════════════════════════════════════════════════════
// v1.4.6 W-017: CGModGlobal struct + register/lookup helpers
//   CGModGlobal layout MUST match C-side CGModGlobal (24 bytes) — Stage 2
//   closure chain (jhyy_v1→v2→v3→v4 编 src0/main.jhyy) writes to same offsets.
// ═══════════════════════════════════════════════════════════════════════════

type CGModGlobal = struct {
    sym:       *u8,        // 0..8
    qbe_name:  *u8,        // 8..16
    qbe_type:  i32,        // 16..20
}

// cg_mod_global_register: append (sym, qbe_name, qbe_type) to cg->mod_globals.
// Mirrors C-side cg_mod_global_register. arena_alloc new array when full.
fn cg_mod_global_register(cg_raw: *u8, sym: *u8, qbe_name: *u8, qbe_type: i32) -> i32 {
    let cg = cg_raw as *CGContext;
    let n = (*cg).n_mod_globals;
    let cap = (*cg).cap_mod_globals;
    if n >= cap {
        let mut new_cap: i32 = cap * (2 as i32);
        if new_cap < (8 as i32) { new_cap = 8 as i32; }
        let new_size = (new_cap as i64) * CGMOD_GLOBAL_SIZE();
        let new_arr = arena_alloc((*((*cg).ir as *IRBuf)).arena, new_size);
        // copy existing entries
        let mut i: i32 = 0 as i32;
        while i < n {
            let old_p = ptr_add_u8((*cg).mod_globals, (i as i64) * CGMOD_GLOBAL_SIZE());
            let new_p = ptr_add_u8(new_arr, (i as i64) * CGMOD_GLOBAL_SIZE());
            *(new_p as **u8) = *(old_p as **u8);
            *(ptr_add_u8(new_p, 8 as i64) as **u8) = *(ptr_add_u8(old_p, 8 as i64) as **u8);
            *(ptr_add_u8(new_p, 16 as i64) as *i32) = *(ptr_add_u8(old_p, 16 as i64) as *i32);
            i = i + (1 as i32);
        }
        (*cg).mod_globals = new_arr;
        (*cg).cap_mod_globals = new_cap;
    }
    let entry_p = ptr_add_u8((*cg).mod_globals, (n as i64) * CGMOD_GLOBAL_SIZE());
    *(entry_p as **u8) = sym;
    *(ptr_add_u8(entry_p, 8 as i64) as **u8) = qbe_name;
    *(ptr_add_u8(entry_p, 16 as i64) as *i32) = qbe_type;
    (*cg).n_mod_globals = n + (1 as i32);
    return 1;
}

// cg_mod_global_lookup: out_buf 写 IRVAL_STR (kind=IRVAL_STR, name=qbe_name, qbe_type=qbe_type).
// 找到返回 1, 没找到返回 0。
fn cg_mod_global_lookup(cg_raw: *u8, sym: *u8, out_buf: *u8) -> i32 {
    let cg = cg_raw as *CGContext;
    if (*cg).mod_globals == (0 as *u8) { return 0; }
    let n = (*cg).n_mod_globals;
    let mut i: i32 = 0 as i32;
    while i < n {
        let entry_p = ptr_add_u8((*cg).mod_globals, (i as i64) * CGMOD_GLOBAL_SIZE());
        let entry_sym = *(entry_p as **u8);
        if entry_sym == sym {
            let entry_name = *(ptr_add_u8(entry_p, 8 as i64) as **u8);
            let entry_qt = *(ptr_add_u8(entry_p, 16 as i64) as *i32);
            // IRVal layout: kind(0) + id(4) + ival(8) + name(16) + qbe_type(24)
            *(out_buf as *i32) = IRVAL_STR();
            *(ptr_add_u8(out_buf, 4 as i64) as *i32) = 0;
            *(ptr_add_u8(out_buf, 8 as i64) as *i64) = 0 as i64;
            *(ptr_add_u8(out_buf, 16 as i64) as **u8) = entry_name;
            *(ptr_add_u8(out_buf, 24 as i64) as *i32) = entry_qt;
            return 1;
        }
        i = i + (1 as i32);
    }
    return 0;
}

// ═══════════════════════════════════════════════════════════════════════════
// v1.4.2: DWARF debug info emit helpers
//   QBE's .il syntax for DWARF: `dbgfile "<name>"` (top-level) + `dbgloc <line>`
//   in function body (BEFORE the next instruction). QBE translates these into
//   `.file N "<name>"` + `.loc N <line>` directives in .s, which gdb reads.
//   jhyy just needs to emit dbgfile once + dbgloc before each line change.
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// W-069 v2.6.6: CGFnDef struct + register/lookup helpers
//   fn name → pre-mangled qbe name table. Built in cg_module Pass A from all
//   NODE_FUNC_DECL with is_extern=0. Read in cg_expr NODE_CALL is_extern
//   branch to fix `extern fn` mis-decls in caller modules (codegen_amd64_*.jhyy
//   declare ptr_add_u8 etc. as `extern fn` but real def is `util__ptr_add_u8`).
//   jhyy-side analog of C-side static g_fn_defs (codegen.c:40-42); both write
//   the same lookup table to support the same is_extern fallback emit.
// ═══════════════════════════════════════════════════════════════════════════

type CGFnDef = struct {
    name:     *u8,        // 0..8
    qbe_name: *u8,        // 8..16
}

// CGFnDef entry = 16 bytes (name ptr + qbe_name ptr)
fn FNDEF_SIZE() -> i64 { return 16 as i64; }

// cg_fn_defs_clear: reset fn_defs table to empty (called at cg_module Pass A top).
fn cg_fn_defs_clear(cg_raw: *u8) -> i32 {
    let cg = cg_raw as *CGContext;
    (*cg).fn_defs = 0 as *u8;
    (*cg).n_fn_defs = 0 as i64;
    return 1;
}

// cg_fn_defs_register: append (name, qbe_name) to cg->fn_defs. arena_alloc once at
// Pass A start with size = n_decl_total * FNDEF_SIZE (upper bound).
fn cg_fn_defs_register(cg_raw: *u8, name: *u8, qbe_name: *u8) -> i32 {
    let cg = cg_raw as *CGContext;
    let n = (*cg).n_fn_defs;
    let slot = ptr_add_u8((*cg).fn_defs, n * FNDEF_SIZE());
    *(slot as **u8) = name;
    *(ptr_add_u8(slot, 8 as i64) as **u8) = qbe_name;
    (*cg).n_fn_defs = n + (1 as i64);
    return 1;
}

// cg_fn_defs_lookup: linear scan for name match; return qbe_name ptr or 0.
fn cg_fn_defs_lookup(cg_raw: *u8, name: *u8) -> *u8 {
    let cg = cg_raw as *CGContext;
    if (*cg).fn_defs == (0 as *u8) { return 0 as *u8; }
    let mut i: i64 = 0 as i64;
    while i < (*cg).n_fn_defs {
        let entry_p = ptr_add_u8((*cg).fn_defs, i * FNDEF_SIZE());
        let entry_name = *(entry_p as **u8);
        // strcmp
        if strcmp(entry_name, name) == (0 as i32) {
            return *(ptr_add_u8(entry_p, 8 as i64) as **u8);
        }
        i = i + (1 as i64);
    }
    return 0 as *u8;
}

fn cg_dbg_emit_file(ir: *IRBuf, filename: *u8) -> i32 {
    if filename == (0 as *u8) { return 0; }
    ir_emit_str(ir, "dbgfile \"" as *u8);
    ir_emit_str(ir, filename);
    ir_emit_str(ir, "\"\n" as *u8);
    return 1;
}

fn cg_dbg_emit_loc(cg_raw: *u8, line: i32) -> i32 {
    let cg = cg_raw as *CGContext;
    // v3.0.2 (3b naked): naked fns emit NO QBE IR, so `dbgloc` at top-level
    // (no enclosing function) is invalid QBE syntax. Skip dbgloc emit when
    // the current function is naked. The asm body still gets its source line
    // recorded in the .s via the inline asm itself (no DWARF needed).
    if (*cg).current_fn != (0 as *u8) {
        // current_fn is already a *NodeFuncDecl (set in cg_func: `current_fn = fd as *u8`).
        // Do NOT call node_func_decl_data — that would double-add NODE_SIZE().
        let cfd = (*cg).current_fn as *NodeFuncDecl;
        if (*cfd).is_naked != (0 as i32) {
            return 0;
        }
    }
    if line == (*cg).last_dbg_line { return 0; }
    if line <= (0 as i32) { return 0; }
    let ir = (*cg).ir as *IRBuf;
    ir_emit_str(ir, "    dbgloc " as *u8);
    ir_emit_int(ir, "%d" as *u8, line);
    ir_emit_str(ir, "\n" as *u8);
    (*cg).last_dbg_line = line;
    return 1;
}

// ════════════════════════════════════════════════════
// cg_add_local / cg_find_local
// ════════════════════════════════════════════════════

fn cg_add_local(cg_raw: *u8, sym: *u8, val: IRVal, is_stack: i32) -> i32 {
    let cg = cg_raw as *CGContext;
    let idx = (*cg).nlocals;
    if idx >= MAX_LOCALS() {
        return 0;
    }
    let entry_ptr = ptr_add_u8((*cg).locals, (idx as i64) * LOCALENTRY_SIZE()) as *u8;
    // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
    // v0 codegen bug workaround: 避免 (*entry_ptr).value = val 这种 struct value
    //   field assignment (bug 8: multi-field struct 走 cg_copy_agg 时会 emit
    //   错 sret body). 改走 ptr_add_u8 + 字段级 store.
    // IRVal layout: kind(0) + id(4) + ival(8) + name(16) + qbe_type(24) = 32, padded to 40
    // LocalEntry: sym(0..8) + value(8..48) + is_stack(48..52), padded to 56
    let sym_p = entry_ptr as **u8;
    *sym_p = sym;
    let val_u8 = ptr_add_u8(entry_ptr, 8 as i64);
    let kind_p = val_u8 as *i32;
    *kind_p = val.kind;
    let id_p = ptr_add_u8(val_u8, 4 as i64) as *i32;
    *id_p = val.id;
    let ival_p = ptr_add_u8(val_u8, 8 as i64) as *i64;
    *ival_p = val.ival;
    let name_p = ptr_add_u8(val_u8, 16 as i64) as **u8;
    *name_p = val.name;
    let qt_p = ptr_add_u8(val_u8, 24 as i64) as *i32;
    *qt_p = val.qbe_type;
    let stack_p = ptr_add_u8(entry_ptr, 48 as i64) as *i32;
    *stack_p = is_stack;
    (*cg).nlocals = idx + (1 as i32);
    return 1;
}

// cg_find_local: 找 sym 对应的 IRVal，写到 out_buf。返回 1 if found, 0 if not。
//
// [Status: 真修 W-005 + W-005 #2 in C-side (commit 2.45 + 2.81); src0/ workaround kept for历史读者了解历史.]
// v0 codegen bug workaround (复合):
//   - bug 1: 避免 (*entry_ptr).value.field 这种嵌套 struct field access
//     （v0 codegen LEA 32-bit 字段会算错 offset，emit 出 loadw on loadw）。
//     改走 ptr_add_u8 + cast + scalar deref。
//   - bug 8: 避免返回 IRVal struct（v0 codegen 多字段 struct return 漏写 sret）。
//     改走 out_buf 模式：caller alloc IRVal 缓冲，pass pointer。
fn cg_find_local(cg_raw: *u8, sym: *u8, out_buf: *u8) -> i32 {
    let cg = cg_raw as *CGContext;
    let mut i: i32 = 0 as i32;
    let n = (*cg).nlocals;
    while i < n {
        // [Status: 真修 W-005 (IRVal layout) in C-side (commit 2.45); src0/ workaround kept for历史读者了解历史.]
        // v0 codegen bug 10 workaround: 避免 (*entry_ptr).sym 这种 struct field
        //   access（jhyy codegen 在 nested struct + 32-bit field 上会算错 offset）。
        //   改走 ptr_add_u8 + scalar deref：entry 0..8 是 sym *u8 字段。
        let entry_ptr = ptr_add_u8((*cg).locals, (i as i64) * LOCALENTRY_SIZE());
        let entry_sym_p = entry_ptr as **u8;
        if *entry_sym_p == sym {
            // IRVal layout: kind(i32) + id(i32) + ival(i64) + name(*u8) + qbe_type(i32)
            // offsets: 0 / 4 / 8 / 16 / 24
            let value_u8 = ptr_add_u8(entry_ptr as *u8, 8 as i64);
            // kind
            let kind_p = value_u8 as *i32;
            let out_kind_p = out_buf as *i32;
            *out_kind_p = *kind_p;
            // id
            let id_p = ptr_add_u8(value_u8, 4 as i64) as *i32;
            let out_id_p = ptr_add_u8(out_buf, 4 as i64) as *i32;
            *out_id_p = *id_p;
            // ival
            let ival_p = ptr_add_u8(value_u8, 8 as i64) as *i64;
            let out_ival_p = ptr_add_u8(out_buf, 8 as i64) as *i64;
            *out_ival_p = *ival_p;
            // name
            let name_p = ptr_add_u8(value_u8, 16 as i64) as **u8;
            let out_name_p = ptr_add_u8(out_buf, 16 as i64) as **u8;
            *out_name_p = *name_p;
            // qbe_type
            let qt_p = ptr_add_u8(value_u8, 24 as i64) as *i32;
            let out_qt_p = ptr_add_u8(out_buf, 24 as i64) as *i32;
            *out_qt_p = *qt_p;
            return 1;
        }
        i = i + (1 as i32);
    }
    // not found in locals — fallthrough to module-level globals (v1.4.6 W-017)
    if cg_mod_global_lookup(cg_raw, sym, out_buf) != 0 {
        return 1;
    }
    // not found anywhere — zero out
    let zk = out_buf as *i32;
    *zk = 0;
    let zi = ptr_add_u8(out_buf, 4 as i64) as *i32;
    *zi = 0;
    let ziv = ptr_add_u8(out_buf, 8 as i64) as *i64;
    *ziv = 0 as i64;
    let zn = ptr_add_u8(out_buf, 16 as i64) as **u8;
    *zn = 0 as *u8;
    let zq = ptr_add_u8(out_buf, 24 as i64) as *i32;
    *zq = 0;
    return 0;
}

// ════════════════════════════════════════════════════
// v1.3.5: #[inline] call-site expansion helpers
// ════════════════════════════════════════════════════

// cg_find_inline_decl: 查 inline_fns 表，找 sym 对应的 NodeFuncDecl。找不到返回 0。
fn cg_find_inline_decl(cg_raw: *u8, fn_sym: *u8) -> *u8 {
    let cg = cg_raw as *CGContext;
    if (*cg).inline_fns == (0 as *u8) {
        return 0 as *u8;
    }
    if fn_sym == (0 as *u8) {
        return 0 as *u8;
    }
    let mut i: i64 = 0 as i64;
    while i < (*cg).n_inline_fns {
        let fd_ptr = ptr_add_u8((*cg).inline_fns, i * NODE_FUNC_DECL_SIZE() as i64);
        let fd = fd_ptr as *NodeFuncDecl;
        if (*fd).sym == fn_sym {
            return fd_ptr;
        }
        i = i + (1 as i64);
    }
    return 0 as *u8;
}

// cg_inline_simple_return_expr: 仅支持 body 是单条 `return <expr>;` 的 fn。
// 返回 return expr node (or 0 if 不符合).
// NodeBlock layout: nstmts(i64 0) + stmts(*u8 8) = 16
//   stmts 是 *Node 数组
fn cg_inline_simple_return_expr(body: *Node) -> *Node {
    if body == (0 as *Node) {
        return 0 as *Node;
    }
    if (*body).kind != NODE_BLOCK() {
        return 0 as *Node;
    }
    let nstmts_field = body as *i64;
    let nstmts = *nstmts_field;
    if nstmts != (1 as i64) {
        return 0 as *Node;
    }
    let stmts_ptr = ptr_add_u8(body as *u8, 8 as i64) as *u8;
    let stmt = (*((stmts_ptr as i64) as **Node)) as *Node;
    if (*stmt).kind != NODE_RETURN() {
        return 0 as *Node;
    }
    let expr_field = stmt as *u8;
    let expr = *((expr_field as i64) as **u8) as *Node;
    return expr;
}

// cg_find_local 带 is_stack out 参数（C 端用 int*；jhyy 不支持 output 参数，
// 改走单独的 cg_find_local_is_stack 函数）
fn cg_find_local_is_stack(cg_raw: *u8, sym: *u8) -> i32 {
    let cg = cg_raw as *CGContext;
    let mut i: i32 = 0 as i32;
    let n = (*cg).nlocals;
    while i < n {
        // [Status: 真修 W-005 in C-side (commit 2.45); src0/ workaround kept for历史读者了解历史.]
        // v0 codegen bug 10 workaround: 同 cg_find_local
        let entry_ptr = ptr_add_u8((*cg).locals, (i as i64) * LOCALENTRY_SIZE());
        let entry_sym_p = entry_ptr as **u8;
        if *entry_sym_p == sym {
            // is_stack 字段在 LocalEntry 偏移 48（见 cg_add_local 注释）
            let is_stack_p = ptr_add_u8(entry_ptr, 48 as i64) as *i32;
            return *is_stack_p;
        }
        i = i + (1 as i32);
    }
    return 0;
}

// ════════════════════════════════════════════════════
// emit_mangled_name
// ════════════════════════════════════════════════════

// emit "$mod__name" 当 sym 有 module，否则 "$name"。等价 C 端 emit_mangled_name。
// [Removed v2.1.0 Stage 1c.2: mangling moved to abi_amd64_win.jhyy
//  `abi_win_emit_mangled_name` (ABI-internal helper). Call site was the
//  single use in cg_func's inline header block, now in
//  `abi_win_emit_function_header`.]

// ════════════════════════════════════════════════════
// ir_new_int（构造 INT IRVal）
// ════════════════════════════════════════════════════

fn ir_new_int(val: i64) -> IRVal {
    let v = IRVal {
        kind:     IRVAL_INT(),
        id:       0,
        ival:     val,
        name:     0 as *u8,
        qbe_type: QBE_L(),  /* used as offset in pointer arithmetic */
    };
    return v;
}

// ════════════════════════════════════════════════════
// cg_emit_load / cg_emit_store / cg_copy_agg
// ════════════════════════════════════════════════════

// cg_emit_load：emit 正确 load 指令（sub-word 用 loadsb/loadub/loadsh/loaduh，
// 其他走 ir_emit_load）。dst 已经按调用方指定类型预分配。
//
// 参数：cg_raw (*u8 → *CGContext)，t_raw (*u8 → *Type)，dst (IRVal)，addr (IRVal)
fn cg_emit_load(cg_raw: *u8, dst: IRVal, t_raw: *u8, addr: IRVal) -> i32 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // v3.0.3 (3c volatile): 标记 volatile load.emit comment "volatile" 让 .il
    //   grep 可命中,也提醒 reader 此 load 是 volatile。每次 load 已强制 fresh temp
    //   (cg_expr NODE_IDENT 路径走 ir_new_tmp + cg_emit_load),无 regalloc reuse;
    //   QBE IL 不识别 volatile keyword,所以仅发注释 — codegen 主路径下保证"no regalloc"
    //   靠 cg_expr NODE_IDENT 每次新 temp 的纪律,不靠 qbe 本身。
    let mut is_volatile_load: i32 = 0 as i32;
    if t_raw != (0 as *u8) {
        let vt = t_raw as *Type;
        if (*vt).is_volatile != (0 as i32) {
            is_volatile_load = 1 as i32;
        }
    }
    if is_volatile_load != (0 as i32) {
        ir_emit_str(ir, "    # volatile load\n" as *u8);
    }
    if t_raw == (0 as *u8) {
        return ir_emit_load(ir, dst, QBE_W(), addr);
    }
    let t = t_raw as *Type;
    if (*t).kind == KIND_PRIMITIVE() {
        let prim = (*t).prim;
        let mut insn: *u8 = 0 as *u8;
        if prim == PRIM_I8() {
            insn = "loadsb" as *u8;
        } else if prim == PRIM_U8() {
            insn = "loadub" as *u8;
        } else if prim == PRIM_BOOL() {
            insn = "loadub" as *u8;
        } else if prim == PRIM_I16() {
            insn = "loadsh" as *u8;
        } else if prim == PRIM_U16() {
            insn = "loaduh" as *u8;
        }
        if insn != (0 as *u8) {
            /* sub-word: always returns word. "    %tD =w insn <addr>" — IRVAL_STR addr
               (W-017 global) dispatches via ir_emit_arg. */
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, dst.id);
            ir_emit_str(ir, " =w " as *u8);
            ir_emit_str(ir, insn);
            let _a = ir_emit_arg(ir, addr);
            ir_emit_str(ir, "\n" as *u8);
            return 1;
        }
    }
    let qt = qbe_type_of(t_raw);
    return ir_emit_load(ir, dst, qt, addr);
}

// cg_emit_store_primitive：emit 标量 store 指令（sub-word 走 storeb/storeh，
// word/long 走 ir_emit_store）。**struct 不走这里**，struct 走 cg_copy_agg
// 字段级拷贝（在 cg_emit_store dispatcher 里 dispatch）。
//
// cg_copy_agg 用这个函数（而不是 cg_emit_store）来 store 标量字段，
// 避开 cg_emit_store ↔ cg_copy_agg mutual recursion（jhyy 无 forward decl）。
fn cg_emit_store_primitive(cg_raw: *u8, t_raw: *u8, val: IRVal, addr: IRVal) -> i32 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // v3.0.3 (3c volatile): 标记 volatile store(per cg_emit_load 同逻辑)。
    if t_raw != (0 as *u8) {
        let vt = t_raw as *Type;
        if (*vt).is_volatile != (0 as i32) {
            ir_emit_str(ir, "    # volatile store\n" as *u8);
        }
    }
    if t_raw == (0 as *u8) {
        // Sprint 4.3 A fix: NULL type 时用 val.qbe_type 决定 store 宽度 — 不是 hardcoded QBE_W().
        //   修 slice/array 路径 heap corruption 根因: 写 64-bit ptr (QBE_L) 时应该用 storel,
        //   旧代码永远 storew (32-bit) → 高 32 位 garbage → 后续 loadl 读到坏 ptr → AV.
        //   历史调用方 (zero_v/one_v/rb_and 都是 QBE_W tmp) 不受影响.
        return ir_emit_store(ir, val.qbe_type, val, addr);
    }
    let t = t_raw as *Type;
    if (*t).kind == KIND_PRIMITIVE() {
        let prim = (*t).prim;
        if prim == PRIM_I8() || prim == PRIM_U8() || prim == PRIM_BOOL() {
            /* "    storeb %tV, <addr>" — addr IRVAL_STR → "$name" (W-017 globals) */
            ir_emit_str(ir, "    storeb %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, val.id);
            ir_emit_str(ir, "," as *u8);
            let _a = ir_emit_arg(ir, addr);
            ir_emit_str(ir, "\n" as *u8);
            return 1;
        }
        if prim == PRIM_I16() || prim == PRIM_U16() {
            ir_emit_str(ir, "    storeh %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, val.id);
            ir_emit_str(ir, "," as *u8);
            let _a = ir_emit_arg(ir, addr);
            ir_emit_str(ir, "\n" as *u8);
            return 1;
        }
    }
    let qt = qbe_type_of(t_raw);
    return ir_emit_store(ir, qt, val, addr);
}

// cg_copy_agg：field-by-field 拷贝 struct 值（QBE 无 aggregate store）。
// 嵌套 struct 递归（用 cg_copy_agg 自身）；标量字段走 cg_emit_load +
// cg_emit_store_primitive（不用 cg_emit_store，避开 mutual recursion）。
//
// jhyy 无 forward decl：必须在 cg_emit_load / cg_emit_store_primitive 之后定义，
// 在 cg_emit_store dispatcher 之前定义。
// cg_value_type_of — 一个表达式的**运行时值**在栈上的类型。
//
// 与 `qbe_type_of` 的区别只在 enum 上:
//
// jhyy 的 enum 值 = **指向一个槽的地址**(槽里是 [tag|padding|payload],
// 见 ABI § 2.6 / § 4.1)。所以一个「返回 enum 的调用」的结果是一个
// **8 字节指针**,不是 4 字节的 tag。
//
// ⚠️ W-114 (2026-10-20):之前这里走 `qbe_type_of(enum)` = 'w' → 调用方只把
// %rax 的**低 4 字节**存进结果槽 → callee 拿到的地址是**截断的** →
// `match mk() {...}` 读到垃圾、`arm(mk())` 直接 SEGV。
//
// 什么时候用哪个:
//   · `qbe_type_of` —— 描述**槽里的 image**(struct 字段的 load/store 用它)
//   · `cg_value_type_of` —— 描述**一个表达式的值**(调用结果 / if 结果 /
//     match 结果用它)
fn cg_value_type_of(t_raw: *u8) -> i32 {
    if t_raw != (0 as *u8) {
        let t = t_raw as *Type;
        if (*t).kind == KIND_ENUM() {
            return QBE_L();
        }
    }
    return qbe_type_of(t_raw);
}

// cg_sysv_check_memory_scope — W-104 MEMORY class 的**受限实现**边界检查。
//
// SysV 栈参数排布:所有落栈的实参(MEMORY class 的 + 整数寄存器溢出后落栈的)
// 按**声明顺序**排在栈上。callee 侧读 MEMORY slot 用的是 `16(%rbp) + k*8`
// (k = 该 MEMORY 参数在栈上的 slot 序号)—— 这只在「栈上**只有** MEMORY 参数」
// 时成立。
//
// 整数参数超过 6 个(SysV 只有 rdi/rsi/rdx/rcx/r8/r9)时第 7 个起也落栈,
// 于是 MEMORY slot 的真实位置被推后 → 偏移公式失效。SSE 参数超过 8 个
// (xmm0-xmm7)同理。
//
// 所以:检测到「有 MEMORY 参数」且「整数/SSE 参数溢出」时**明确报错退出**,
// 而不是静默产出错误的代码。
//
// 只在 SysV 目标下检查;Win 的 struct 传参规则完全不同(>8B 走指针)。
fn cg_sysv_check_memory_scope(cg_raw: *u8, args_node: *u8, nargs: i64) -> i32 {
    let cg = cg_raw as *CGContext;
    if (*cg).target_tag != TARGET_AMD64_SYSV() && (*cg).target_tag != TARGET_AMD64_SYSV_FREESTANDING() {
        return 0 as i32;
    }
    let mut has_mem: i32 = 0 as i32;
    let mut n_int: i64 = 0 as i64;
    let mut n_sse: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < nargs {
        let an = *(ptr_add_u8(args_node, i * (8 as i64)) as **Node);
        let mut at: *u8 = 0 as *u8;
        if an != (0 as *Node) {
            at = (*an).type_ptr;
        }
        if at != (0 as *u8) {
            if abi_sysv_struct_is_memory(at) != (0 as i32) {
                has_mem = 1 as i32;
            } else {
                let ne = abi_sysv_struct_n_eightbytes(at);
                if ne > (0 as i64) {
                    // ≤16B 的 struct:每个 eightbyte 独立分类
                    let mut k: i64 = 0 as i64;
                    while k < ne {
                        if abi_sysv_eightbyte_class(at, k) == SYSV_CLASS_SSE() {
                            n_sse = n_sse + (1 as i64);
                        } else {
                            n_int = n_int + (1 as i64);
                        }
                        k = k + (1 as i64);
                    }
                } else {
                    if abi_sysv_classify_arg(at) == SYSV_CLASS_SSE() {
                        n_sse = n_sse + (1 as i64);
                    } else {
                        n_int = n_int + (1 as i64);
                    }
                }
            }
        }
        i = i + (1 as i64);
    }
    if has_mem != (0 as i32) && (n_int > (6 as i64) || n_sse > (8 as i64)) {
        let _e = jh_fputs_stderr("jhyy error: SysV MEMORY-class struct (>16 bytes) cannot be mixed with register-overflow arguments" as *u8);
        let _e2 = jh_fputs_stderr(" (integer args > 6 or float args > 8)." as *u8);
        let _e3 = jh_fputs_stderr(" This combination is not implemented yet -- the compiler refuses to emit wrong code." as *u8);
        let _e4 = jh_fputs_stderr("\n" as *u8);
        let _x = exit(1 as i32);
        return 1 as i32;
    }
    return 0 as i32;
}

// cg_sysv_expanded_nargs — W-104:SysV 下 struct 实参按 eightbyte 展开后,
// args 数组的容量与 call 文本里的实参个数都要按**展开后**的数量算。
//
// 只在 SysV 目标下展开;Win 仍是「一个 struct 一个实参(指针)」。
fn cg_sysv_expanded_nargs(cg_raw: *u8, args_node: *u8, nargs: i64) -> i64 {
    let cg = cg_raw as *CGContext;
    if (*cg).target_tag != TARGET_AMD64_SYSV() && (*cg).target_tag != TARGET_AMD64_SYSV_FREESTANDING() {
        return nargs;
    }
    let mut total: i64 = 0 as i64;
    let mut i: i64 = 0 as i64;
    while i < nargs {
        let an = *(ptr_add_u8(args_node, i * (8 as i64)) as **Node);
        let mut cnt: i64 = 1 as i64;
        if an != (0 as *Node) {
            let at = (*an).type_ptr;
            if at != (0 as *u8) {
                if abi_sysv_struct_is_memory(at) != (0 as i32) {
                    cnt = abi_sysv_struct_mem_slots(at);
                } else {
                    let ne = abi_sysv_struct_n_eightbytes(at);
                    if ne > (0 as i64) { cnt = ne; }
                }
            }
        }
        total = total + cnt;
        i = i + (1 as i64);
    }
    return total;
}

// cg_emit_struct_arg_eightbytes — W-104:把一个 struct 实参按 eightbyte 拆成
// 若干个「值」实参(而不是一个指针),写进 args 数组。
//
// 拆出来的每个 eightbyte 从 struct 副本的对应偏移**按值加载**:
//   INTEGER eightbyte → w(4B) / l(8B)  → GPR
//   SSE     eightbyte → s(4B) / d(8B)  → XMM
// 字母与宽度与 callee 侧的声明严格对称(同一个 abi_sysv_eightbyte_letter)。
//
// 返回写入 args 数组的实参个数(1 或 2)。
fn cg_emit_struct_arg_memory_slots(cg_raw: *u8, st_raw: *u8, copy_slot: IRVal) -> i64 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    if (*cg).target_tag != TARGET_AMD64_SYSV() && (*cg).target_tag != TARGET_AMD64_SYSV_FREESTANDING() {
        return 0 as i64;
    }
    if abi_sysv_struct_is_memory(st_raw) == (0 as i32) {
        return 0 as i64;
    }
    let nslots = abi_sysv_struct_mem_slots(st_raw);
    let mut vals = arena_alloc((*ir).arena, (8 as i64) * IRVAL_SIZE());
    let mut k: i64 = 0 as i64;
    while k < nslots {
        let eoff = k * (8 as i64);
        let eaddr = *ir_new_tmp(ir, QBE_L());
        if eoff > (0 as i64) {
            ir_emit_binary(ir, eaddr, "add" as *u8, copy_slot, ir_new_int(eoff));
        } else {
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, eaddr.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, copy_slot.id);
            ir_emit_str(ir, "
" as *u8);
        }
        let eval = *ir_new_tmp(ir, QBE_L());
        ir_emit_load(ir, eval, QBE_L(), eaddr);
        let vslot = ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal;
        *vslot = eval;
        *(ptr_add_u8(vslot, 24 as i64) as *i32) = 109 as i32;
        k = k + (1 as i64);
    }
    (*cg).last_struct_arg_vals = vals;
    (*cg).last_struct_arg_n = nslots;
    return nslots;
}

fn cg_emit_struct_arg_eightbytes(cg_raw: *u8, st_raw: *u8, copy_slot: IRVal) -> i64 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let st = st_raw as *Type;
    // ⚠️ 只有 **SysV** 才按 eightbyte 拆 —— Win x64 的 struct 传参规则不同
    // (>8B 走间接:传指针;≤8B 走寄存器)。
    if (*cg).target_tag != TARGET_AMD64_SYSV() && (*cg).target_tag != TARGET_AMD64_SYSV_FREESTANDING() {
        return 0 as i64;
    }
    let ne = abi_sysv_struct_n_eightbytes(st_raw);
    if ne <= (0 as i64) {
        return 0 as i64;
    }
    // 加载出的 temp 们要放进 args 数组 —— 数组由调用方持有,这里只把
    // 「值」放进一个临时的 IRVal 数组,调用方再取。
    let mut vals = arena_alloc((*ir).arena, (2 as i64) * IRVAL_SIZE());
    let mut k: i64 = 0 as i64;
    while k < ne {
        let eoff = k * (8 as i64);
        let eaddr = *ir_new_tmp(ir, QBE_L());
        if eoff > (0 as i64) {
            ir_emit_binary(ir, eaddr, "add" as *u8, copy_slot, ir_new_int(eoff));
        } else {
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, eaddr.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, copy_slot.id);
            ir_emit_str(ir, "
" as *u8);
        }
        let eqt = abi_sysv_eightbyte_letter(st_raw, k);
        let eval = *ir_new_tmp(ir, eqt);
        ir_emit_load(ir, eval, eqt, eaddr);
        let vslot = ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal;
        *vslot = eval;
        k = k + (1 as i64);
    }
    (*cg).last_struct_arg_vals = vals;
    (*cg).last_struct_arg_n = ne;
    return ne;
}
// cg_copy_enum — W-114 (2026-10-20):把一个 enum 的**内存映像**(image)从
// src 拷到 dst。
//
// enum 的运行时值 = **指向一个槽的地址**,槽里是
// [tag | padding | payload](ABI § 2.6 布局 / § 4.1「enum 构造 → 栈槽」)。
//
// sret 返回时 caller 提供目标槽,callee 必须把 **image** 拷进去 ——
// 不能只把地址拷过去:那个地址指向 **callee 自己帧里**的槽,函数一返回
// 它就悬垂了(实测:`arm(mk())` 里 arm 的序言把 mk 的槽整个盖掉 → tag 读成 0)。
//
// 拷贝粒度:enum 的 size 总是 4 的倍数(tag_size = 4,align ≥ 4)→
// 8 字节一组,尾巴最多 4 字节 —— 不需要 1/2 字节的 load/store。
fn cg_copy_enum(cg_raw: *u8, et_raw: *u8, dst_addr: IRVal, src_addr: IRVal) -> i32 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    if et_raw == (0 as *u8) {
        return 0;
    }
    let et = et_raw as *Type;
    if (*et).kind != KIND_ENUM() {
        return 0;
    }
    // 与 cg_copy_agg 同款守卫:sentinel src/dst 会 emit `copy %t0`(QBE 报错)
    if irval_is_undef(src_addr) != 0 {
        return 0;
    }
    if irval_is_undef(dst_addr) != 0 {
        return 0;
    }
    let size = type_size(et);
    let mut off: i64 = 0 as i64;
    while off + (8 as i64) <= size {
        let s = *ir_new_tmp(ir, QBE_L());
        let d = *ir_new_tmp(ir, QBE_L());
        if off > (0 as i64) {
            ir_emit_binary(ir, s, "add" as *u8, src_addr, ir_new_int(off));
            ir_emit_binary(ir, d, "add" as *u8, dst_addr, ir_new_int(off));
        } else {
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, s.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, src_addr.id);
            ir_emit_str(ir, "\n" as *u8);
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, d.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, dst_addr.id);
            ir_emit_str(ir, "\n" as *u8);
        }
        let v = *ir_new_tmp(ir, QBE_L());
        ir_emit_load(ir, v, QBE_L(), s);
        ir_emit_store(ir, QBE_L(), v, d);
        off = off + (8 as i64);
    }
    if off < size {
        // 尾巴:4 字节(tag 本身,或 12 字节 enum 的最后 4 字节)
        let s = *ir_new_tmp(ir, QBE_L());
        let d = *ir_new_tmp(ir, QBE_L());
        if off > (0 as i64) {
            ir_emit_binary(ir, s, "add" as *u8, src_addr, ir_new_int(off));
            ir_emit_binary(ir, d, "add" as *u8, dst_addr, ir_new_int(off));
        } else {
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, s.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, src_addr.id);
            ir_emit_str(ir, "\n" as *u8);
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, d.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, dst_addr.id);
            ir_emit_str(ir, "\n" as *u8);
        }
        let v = *ir_new_tmp(ir, QBE_W());
        ir_emit_load(ir, v, QBE_W(), s);
        ir_emit_store(ir, QBE_W(), v, d);
    }
    return 1;
}


fn cg_copy_agg(cg_raw: *u8, st_raw: *u8, dst_addr: IRVal, src_addr: IRVal) -> i32 {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let st = st_raw as *Type;
    if st_raw == (0 as *u8) {
        return 0;
    }
    // W-144 (2026-10-26):本函数现在同时处理 **struct** 与 **array** 两种聚合。
    //
    // 为什么必须合并成一个函数(而不是拆成 cg_copy_array + cg_copy_struct):
    // array 元素可能是 struct(struct-in-array),而 struct 字段可能是 array
    // (array-in-struct)⇒ 两个函数**互相递归**⇒ jhyy 无 forward decl ⇒ 编不过。
    // 与 cg_value_eq 同款处理(它也把 struct/enum/array/slice 全塞一个函数里 dispatch)。
    let agg_kind = (*st).kind;
    if agg_kind != KIND_STRUCT() && agg_kind != KIND_ARRAY() {
        return 0;
    }
    // Sprint 4.25 W-005 #2 真修: callers may pass a sentinel IRVal (kind=0,
    // id=0) when the value source was unreachable (e.g. cg_func epilogue with
    // body = `if c { return A } else { return B }`). Without this guard, the
    // inner field-by-field emit loop produces `%t%d =l copy %t0` lines that
    // QBE rejects with "invalid type for first operand %t0".
    if irval_is_undef(src_addr) != 0 {
        return 0;
    }
    if irval_is_undef(dst_addr) != 0 {
        return 0;
    }

    // ── array:逐元素拷贝 ──
    //
    // W-144:数组在 struct 里是**内联字节**(ABI § 2.2/§ 2.3:数组是值类型,
    // sizeof = N × sizeof(elem))⇒ 拷数组 = 拷 N × elem_size 字节。
    //
    // 「数组的值」在 IR/后端里是**数组数据的地址**(数组字面量 alloc 一个槽、
    // 逐元素 store、返回槽地址)⇒ 所以 src_addr 已经是「源数组数据地址」。
    //
    // 逐元素(而不是按字节块)拷贝 ⇒ 元素是 u8/i8/u16/i16 时走
    // cg_emit_load / cg_emit_store_primitive 的 **sub-word** 路径
    // (loadub/storeb/loaduh/storeh)⇒ 不会越界多写 3 字节。
    if agg_kind == KIND_ARRAY() {
        let elem_t = (*st).elem as *Type;
        let cnt = (*st).arr_count;
        let esz = type_size(elem_t);
        let mut i: i64 = 0 as i64;
        while i < cnt {
            let src_off = *ir_new_tmp(ir, QBE_L());
            let dst_off = *ir_new_tmp(ir, QBE_L());
            ir_emit_binary(ir, src_off, "add" as *u8, src_addr, ir_new_int(i * esz));
            ir_emit_binary(ir, dst_off, "add" as *u8, dst_addr, ir_new_int(i * esz));
            let et_kind = (*elem_t).kind;
            if et_kind == KIND_ENUM() {
                // enum 元素内联放 image ⇒ 拷 image(与 struct 字段同款)
                let _ce = cg_copy_enum(cg_raw, elem_t as *u8, dst_off, src_off);
            } else if et_kind == KIND_STRUCT() || et_kind == KIND_ARRAY() {
                // struct/array 元素:递归(自递归,无 forward decl 问题)
                let _cs = cg_copy_agg(cg_raw, elem_t as *u8, dst_off, src_off);
            } else {
                let fval = *ir_new_tmp(ir, qbe_type_of(elem_t as *u8));
                let _ld = cg_emit_load(cg_raw, fval, elem_t as *u8, src_off);
                let _sp = cg_emit_store_primitive(cg_raw, elem_t as *u8, fval, dst_off);
            }
            i = i + (1 as i64);
        }
        return 1;
    }

    let nfields = (*st).nfields;
    let fields = (*st).fields;
    let mut i: i64 = 0 as i64;
    while i < nfields {
        // fields[i]: name(*u8 8) + type(*u8 8) + offset(i64 8) = 24 bytes
        // FieldDesc layout 假设（types.jhyy 应有定义，TODO 验证）
        let fdesc_ptr = ptr_add_u8(fields, i * (24 as i64)) as *u8;
        // bug fix: ftype 在 offset 8, 不是 0 (offset 0 是 name *u8)
        // W-008 fix: 漏一层 deref。ptr_add_u8(...) as *Type 给的是 *Type 指向
        //   fdesc+8 处的字节（即 type 字段存储位置），并不是 type 字段存的值。
        //   要拿到真正的 Type* 必须再 deref 一层：*(fdesc+8 as **Type)。
        let ftype_slot = ptr_add_u8(fdesc_ptr, 8 as i64) as **Type;
        let ftype = *ftype_slot;
        let foffset_ptr = ptr_add_u8(fdesc_ptr, 16 as i64) as *i64;
        let offset = *foffset_ptr;

        // v3.1.1 (V3-C 3g.5): PhantomData ZST 字段不 emit 任何 IR。
        // 理由: PhantomData size=0/align=1, struct layout 阶段 offset 不推进
        // (sema.jhyy:2166-2193 layout 循环天然支持 0-size 字段),
        // codegen 层无需 load/store/copy 该字段。直接 continue 避免 tmp 浪费。
        if (*ftype).kind == KIND_PHANTOM() {
            i = i + (1 as i64);
            continue;
        }

        // compute field addresses
        // v0.9 wip commit 2.8 (B-struct fix): 对齐 v0 codegen.c:140-148
        //   - 总是 alloc src_off/dst_off 新 tmp (即使 offset==0)
        //   - offset > 0: emit `add %tA, offset`
        //   - offset == 0: emit `copy %tA, src_addr/dst_addr`
        //   jhyy_v1 旧版本偷懒 offset==0 时直接用 src_addr/dst_addr 不 alloc → 字段编号错位 byte-equal diff
        let mut src_off: IRVal = *ir_new_tmp(ir, QBE_L());
        let mut dst_off: IRVal = *ir_new_tmp(ir, QBE_L());
        if offset > (0 as i64) {
            ir_emit_binary(ir, src_off, "add" as *u8, src_addr, ir_new_int(offset));
            ir_emit_binary(ir, dst_off, "add" as *u8, dst_addr, ir_new_int(offset));
        } else {
            // ir_emit_copy 只接受 i64 literal,这里要 `copy %tN` 从 IRVal src/dst → 走 inline emit
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, src_off.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, src_addr.id);
            ir_emit_str(ir, "\n" as *u8);
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, dst_off.id);
            ir_emit_str(ir, " =l copy %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, dst_addr.id);
            ir_emit_str(ir, "\n" as *u8);
        }
        let ft_kind = (*ftype).kind;
        if ft_kind == KIND_ENUM() {
            // W-114:enum 字段内联存放 image —— 拷 image,不是拷地址
            let _ce = cg_copy_enum(cg_raw, ftype as *u8, dst_off, src_off);
        } else if ft_kind == KIND_STRUCT() {
            let _cs = cg_copy_agg(cg_raw, ftype as *u8, dst_off, src_off);
        } else if ft_kind == KIND_ARRAY() {
            // W-144: array 字段内联存放 ⇒ 拷元素(src_off 就是源数组的内联地址)
            let _ca = cg_copy_agg(cg_raw, ftype as *u8, dst_off, src_off);
        } else {
            let fval = *ir_new_tmp(ir, qbe_type_of(ftype as *u8));
            let _ld = cg_emit_load(cg_raw, fval, ftype as *u8, src_off);
            let _sp = cg_emit_store_primitive(cg_raw, ftype as *u8, fval, dst_off);
        }
        i = i + (1 as i64);
    }
    return 1;
}



// ════════════════════════════════════════════════════════════════════════════
// cg_value_eq — 值的**按值**相等比较(W-133 真修)
// ════════════════════════════════════════════════════════════════════════════
//
// 返回一个 'w' 的 IRVal(1 = 相等, 0 = 不相等)。
//   t_raw  : 值的类型(Type*;可能是 KIND_ALIAS → 入口解包)
//   a_addr : 左值的**槽地址**(IRVal,'l')
//   b_addr : 右值的**槽地址**(IRVal,'l')
//
// ⚠️ **单函数实现**:struct 字段 / 数组元素 / enum payload 的比较都要**递归**
// 调用本函数 —— jhyy 无 forward reference,拆成 cg_struct_eq / cg_enum_eq 会变成
// **互相递归**(编不过)。所以全部 kind 在一个函数里 dispatch。
//
// 语义(2026-10-24 用户拍板):
//   · struct → 逐字段递归比较(浅比较:指针字段比指针值本身)
//   · enum   → tag 相等 + payload 按变体类型比(**不按字节比** —— 两个分别构造的
//              同值 enum,padding 是未初始化垃圾,按字节比会误判不等);
//              各变体 payload 类型不一致时用 per-variant 掩码 dispatch(branch-free,
//              不碰 phi / 分支区)
//   · array  → 逐元素(arr_count 是编译期常量 ⇒ 全展开)
//   · slice  → 比**头**(ptr@0 + len@8),不逐元素
//   · bool 字段 → 按原值比(与标量 bool == 一致,不做 0/1 归一化)
//   · float 字段 → 与标量浮点 == 同语义(ordered)
fn cg_value_eq(cg_raw: *u8, t_raw: *u8, a_addr: IRVal, b_addr: IRVal) -> *IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // W-133 必做:alias 解包。`type Q = P`(P 是 struct)必须按 P 的布局比。
    let t = type_unwrap_alias(t_raw as *Type);
    let mut result: *IRVal = ir_new_tmp(ir, QBE_W());
    if t == (0 as *Type) {
        ir_emit_copy(ir, *result, 0);
        return result;
    }
    let k = (*t).kind;

    // ── 标量 / 指针 / 引用 / Cap / fn:load 后按值比 ──
    if k == KIND_PRIMITIVE() || k == KIND_POINTER() || k == KIND_REF() ||
       k == KIND_CAP() || k == KIND_FUNC() {
        let qt = qbe_type_of(t as *u8);
        let av = *ir_new_tmp(ir, qt);
        let bv = *ir_new_tmp(ir, qt);
        let _l1 = cg_emit_load(cg_raw, av, t as *u8, a_addr);
        let _l2 = cg_emit_load(cg_raw, bv, t as *u8, b_addr);
        let mut op: *u8 = "ceqw" as *u8;
        if qt == QBE_L() { op = "ceql" as *u8; }
        else if qt == QBE_D() { op = "ceqd" as *u8; }
        else if qt == QBE_S() { op = "ceqs" as *u8; }
        ir_emit_binary(ir, *result, op, av, bv);
        return result;
    }

    // ── struct:逐字段(and 链,不短路)──
    if k == KIND_STRUCT() {
        let nfields = (*t).nfields;
        let fields = (*t).fields;
        let acc = *ir_new_tmp(ir, QBE_W());
        ir_emit_copy(ir, acc, 1);
        let mut i: i64 = 0 as i64;
        while i < nfields {
            // fields[i]: name(*u8 8) + type(*u8 8) + offset(i64 8) = 24 bytes
            // (布局同 cg_copy_agg:1011 —— 名字在 0,类型在 8,偏移在 16)
            let fdesc_ptr = ptr_add_u8(fields, i * (24 as i64)) as *u8;
            let ftype_slot = ptr_add_u8(fdesc_ptr, 8 as i64) as **Type;
            let ftype = *ftype_slot;
            let foffset_ptr = ptr_add_u8(fdesc_ptr, 16 as i64) as *i64;
            let offset = *foffset_ptr;
            // PhantomData ZST 字段不参与比较(同 cg_copy_agg)
            if (*ftype).kind != KIND_PHANTOM() {
                let fa = *ir_new_tmp(ir, QBE_L());
                let fb = *ir_new_tmp(ir, QBE_L());
                ir_emit_binary(ir, fa, "add" as *u8, a_addr, ir_new_int(offset));
                ir_emit_binary(ir, fb, "add" as *u8, b_addr, ir_new_int(offset));
                let fc = cg_value_eq(cg_raw, ftype as *u8, fa, fb);
                ir_emit_binary(ir, acc, "and" as *u8, acc, *fc);
            }
            i = i + (1 as i64);
        }
        ir_emit_copy_tmp(ir, *result, acc);
        return result;
    }

    // ── enum:tag 相等 + payload 按变体类型比(掩码 dispatch)──
    if k == KIND_ENUM() {
        // tag 在 image 的 offset 0(4 字节)
        let tag_a = *ir_new_tmp(ir, QBE_W());
        let tag_b = *ir_new_tmp(ir, QBE_W());
        ir_emit_load(ir, tag_a, QBE_W(), a_addr);
        ir_emit_load(ir, tag_b, QBE_W(), b_addr);
        let acc = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, acc, "ceqw" as *u8, tag_a, tag_b);
        let nvariants = (*t).nvariants;
        let variants = (*t).variants;
        let payload_off = (*t).payload_off;
        let mut j: i64 = 0 as i64;
        while j < nvariants {
            // variants[j]: name(*u8 8) + payload_type(*u8 8) + tag(i64 8) = 24 bytes
            // (布局见 sema.jhyy:3300-3303 —— payload 类型在 offset 8)
            let vd_ptr = ptr_add_u8(variants, j * (24 as i64)) as *u8;
            let pt_slot = ptr_add_u8(vd_ptr, 8 as i64) as **Type;
            let pt = *pt_slot;
            // 没有 payload 的变体(pt == 0)⇒ 不比 payload
            if pt != (0 as *Type) {
                // tagv = copy j  (temp vs temp,避开「立即数当第一操作数」的边角)
                let tagv = *ir_new_tmp(ir, QBE_W());
                ir_emit_copy(ir, tagv, j);
                // m = (tag_a == tagv)
                let m = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, m, "ceqw" as *u8, tag_a, tagv);
                // payload 地址
                let pa = *ir_new_tmp(ir, QBE_L());
                let pb = *ir_new_tmp(ir, QBE_L());
                ir_emit_binary(ir, pa, "add" as *u8, a_addr, ir_new_int(payload_off));
                ir_emit_binary(ir, pb, "add" as *u8, b_addr, ir_new_int(payload_off));
                // pv = 按该变体的 payload 类型比
                let pv = cg_value_eq(cg_raw, pt as *u8, pa, pb);
                // sel = (pv AND m) OR (1 - m)   —— 命中取 pv,未命中取 1
                let pv_and_m = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, pv_and_m, "and" as *u8, *pv, m);
                let one = *ir_new_tmp(ir, QBE_W());
                ir_emit_copy(ir, one, 1);
                let one_minus_m = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, one_minus_m, "sub" as *u8, one, m);
                let sel = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, sel, "or" as *u8, pv_and_m, one_minus_m);
                ir_emit_binary(ir, acc, "and" as *u8, acc, sel);
            }
            j = j + (1 as i64);
        }
        ir_emit_copy_tmp(ir, *result, acc);
        return result;
    }

    // ── array:逐元素(arr_count 编译期常量 ⇒ 全展开)──
    if k == KIND_ARRAY() {
        let elem_t = (*t).elem as *Type;
        let cnt = (*t).arr_count;
        let esz = type_size(elem_t);
        let acc = *ir_new_tmp(ir, QBE_W());
        ir_emit_copy(ir, acc, 1);
        let mut i: i64 = 0 as i64;
        while i < cnt {
            let ea = *ir_new_tmp(ir, QBE_L());
            let eb = *ir_new_tmp(ir, QBE_L());
            ir_emit_binary(ir, ea, "add" as *u8, a_addr, ir_new_int(i * esz));
            ir_emit_binary(ir, eb, "add" as *u8, b_addr, ir_new_int(i * esz));
            let ec = cg_value_eq(cg_raw, elem_t as *u8, ea, eb);
            ir_emit_binary(ir, acc, "and" as *u8, acc, *ec);
            i = i + (1 as i64);
        }
        ir_emit_copy_tmp(ir, *result, acc);
        return result;
    }

    // ── slice:比头(ptr@0 + len@8),不逐元素 ──
    if k == KIND_SLICE() {
        let a_ptr_at = *ir_new_tmp(ir, QBE_L());
        let a_len_at = *ir_new_tmp(ir, QBE_L());
        let b_ptr_at = *ir_new_tmp(ir, QBE_L());
        let b_len_at = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, a_ptr_at, "add" as *u8, a_addr, ir_new_int(0));
        ir_emit_binary(ir, a_len_at, "add" as *u8, a_addr, ir_new_int(8));
        ir_emit_binary(ir, b_ptr_at, "add" as *u8, b_addr, ir_new_int(0));
        ir_emit_binary(ir, b_len_at, "add" as *u8, b_addr, ir_new_int(8));
        let a_ptr = *ir_new_tmp(ir, QBE_L());
        let a_len = *ir_new_tmp(ir, QBE_L());
        let b_ptr = *ir_new_tmp(ir, QBE_L());
        let b_len = *ir_new_tmp(ir, QBE_L());
        ir_emit_load(ir, a_ptr, QBE_L(), a_ptr_at);
        ir_emit_load(ir, a_len, QBE_L(), a_len_at);
        ir_emit_load(ir, b_ptr, QBE_L(), b_ptr_at);
        ir_emit_load(ir, b_len, QBE_L(), b_len_at);
        let e1 = *ir_new_tmp(ir, QBE_W());
        let e2 = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, e1, "ceql" as *u8, a_ptr, b_ptr);
        ir_emit_binary(ir, e2, "ceql" as *u8, a_len, b_len);
        let acc = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, acc, "and" as *u8, e1, e2);
        ir_emit_copy_tmp(ir, *result, acc);
        return result;
    }

    // 未知 kind(KIND_ALIAS 已解包 / KIND_VOID / KIND_UNRESOLVED 等)
    //   → 不等(而不是退回身份比较)
    ir_emit_copy(ir, *result, 0);
    return result;
}

// cg_find_field_offset：full helper
fn cg_find_field_offset(st_raw: *u8, field_name: *u8, out_buf: *u8) -> i32 {
    if st_raw == (0 as *u8) {
        return 0;
    }
    let st = st_raw as *Type;
    if (*st).kind != KIND_STRUCT() {
        return 0;
    }
    let mut j: i64 = 0 as i64;
    while j < (*st).nfields {
        let fdesc = ptr_add_u8((*st).fields, j * FIELD_DESC_SIZE()) as *u8;
        // W-008 fix (深层): FieldDesc.name 存的是 *Sym（sema.jhyy:1507 写入
        //   `*fd_name_slot = fsym`），不是 const char *。直接 strcmp(Sym*, str)
        //   把 Sym 字节当字符串（指针 8 字节内会有 0x00）→ 几乎永远不匹配 →
        //   cg_find_field_offset 返回 0 + garbage → caller 拿到 offset=0 +
        //   field_type_raw=garbage → emit `=w loadw` 错 IL。
        //   修法：deref Sym*，读 Sym.name (Sym 字节布局 name @ offset 0)。
        //   C 端 codegen.c:854 等价 `st->fields[j].name->name`。
        let sym_p = *(fdesc as **Sym);
        let fname_str = *(ptr_add_u8(sym_p as *u8, 0 as i64) as **u8);
        if strcmp(fname_str, field_name) == 0 {
            let foff = ptr_add_u8(fdesc, 16 as i64) as *i64;
            let out_off = out_buf as *i64;
            *out_off = *foff;
            let out_type = ptr_add_u8(out_buf, 8 as i64) as **u8;
            // W-008 fix: 漏一层 deref。ptr_add_u8(fdesc, 8) as *u8 是
            //   FieldDesc.type 字段存储位置的地址，并非字段存的 Type* 本身。
            //   必须再 deref 一层拿到真 Type*；否则 caller 的 qbe_type_of(bad_ptr)
            //   读到 Type 指针值低 32 位当 kind → fall through → QBE_W →
            //   emit `=w loadw` 错的，i64/pointer field 全部踩。
            *out_type = *(ptr_add_u8(fdesc, 8 as i64) as **u8);
            return 1;
        }
        j = j + (1 as i64);
    }
    return 0;
}

// cg_emit_store：dispatcher。struct 走 cg_copy_agg 字段级拷贝；
// 标量走 cg_emit_store_primitive。jhyy 无 forward decl → 必须 cg_copy_agg
// 先于 cg_emit_store 定义。
fn cg_emit_store(cg_raw: *u8, t_raw: *u8, val: IRVal, addr: IRVal) -> i32 {
    if t_raw == (0 as *u8) {
        return cg_emit_store_primitive(cg_raw, 0 as *u8, val, addr);
    }
    let t = t_raw as *Type;
    // W-144: array 与 struct 同款 —— 聚合没有单条 store ⇒ 走逐元素/逐字段拷贝。
    // 缺这个分支时 array 落到 cg_emit_store_primitive ⇒ 按 qbe_type_of(array)='w'
    // 只写 4 字节(数组地址的低 32 位)⇒ 字段槽里是截断指针,读出来是垃圾。
    if (*t).kind == KIND_STRUCT() || (*t).kind == KIND_ARRAY() {
        return cg_copy_agg(cg_raw, t_raw, addr, val);
    }
    return cg_emit_store_primitive(cg_raw, t_raw, val, addr);
}

// cg_store_enum_image — W-114 (2026-10-20):往一个 **enum 类型的存储**
// (局部变量 / struct 字段 / 数组元素 / 循环变量)写值。
//
// enum 的**存储**放的是内存映像(image = [tag|padding|payload]),不是那个
// 地址 —— enum 的**表达式**才求值为「指向 image 的地址」。
//   · 存储:本地变量槽、struct 字段、数组元素 → 放 image
//   · 表达式:enum 变量 / enum 字段 / enum 解引用 → 求值为 image 的地址
//
// ⚠️ 之前一律用 `cg_emit_store`(宽度 = qbe_type_of(enum) = 'w' = 4 字节)
//    → 存的是**地址的低 32 位**(截断的指针)→ 读回来是垃圾。
//    `let mut c: U = U::B;` 因此恒读出 tag 0。
fn cg_store_enum_image(cg_raw: *u8, t_raw: *u8, val: IRVal, addr: IRVal) -> i32 {
    if t_raw != (0 as *u8) {
        let t = t_raw as *Type;
        if (*t).kind == KIND_ENUM() {
            return cg_copy_enum(cg_raw, t_raw, addr, val);
        }
    }
    return cg_emit_store(cg_raw, t_raw, val, addr);
}

