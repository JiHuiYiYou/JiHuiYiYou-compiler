// cg_emit_phi — v2.11.18 DEPRECATED (no-op).
// 原 v0.9 wip commit 2.6 (B-φ1 fix) 设计: emit QBE phi 指令；v2.5.0+ 自研 backend
//   `emit_phi` 是 noop, 但 cg_emit_phi 仍 emit phi 进 IL → IL 含 phi .s 缺 merge move → 11 phi 测试 fail.
// v2.11.18 phi 修复: 改为 move-pair lowering (经 ir_emit_copy_tmp), phi 不再 emit.
//   本函数保留定义 + return 0 避免连锁修改; 新代码请用 ir_emit_copy_tmp.
fn cg_emit_phi(ir: *IRBuf, result: IRVal, block1: IRVal, val1: IRVal,
                                 block2: IRVal, val2: IRVal) -> i32 {
    return 0;
}

// ══════════════════════════════════════════════════════════════════════
// W-143:饱和的 float→整数 转换(Rust 风格)
// ══════════════════════════════════════════════════════════════════════
//
// 语义(spec §4.3 v4.0.22):
//   · 区间内:向 0 截断
//   · 越界:饱和到目标类型 MIN / MAX
//   · NaN:0
//
// 为什么不用裸 cvttsd2si:它对越界/NaN 给的是「integer indefinite」
// (0x8000_0000_0000_0000)—— 既不是截断也不是饱和,spec 推不出来。
//
// 实现要点:
//   · 浮点比较(后端已有 W-133 的有序守卫 setnp/setp ⇒ NaN 下 `<`/`>=` 为 false)
//   · 整数 mask select(and/or/xor)—— branch-free,不碰 phi / 分支区
//   · 窄宽度:先按 64 位饱和,再在**整数域**夹到窄类型的 [MIN, MAX]
//     (iN 的区间是 i64 区间的子集 ⇒「先判大区间、再夹小区间」等价)
//
// ⚠ 实现纪律(jhyy 侧的三条硬约束,踩过):
//   ① 无 forward ref ⇒ 本块的 helper 只能调**本块里更靠前**定义的函数。
//      (irval_box 在 codegen.jhyy:2308,本块在它之前 ⇒ 一律不用它,
//       改用 `*ir_new_tmp(...)` 按值返回 IRVal —— 与 cg_convert_arg 同款做法)
//   ② **struct 局部变量不可重新赋值**(W-097:struct-by-value 赋值会越界写坏 arena)
//      ⇒ 所有 struct 类型的中间量只绑定一次;分支用「早返回」而不是重新赋值。
//   ③ 不做隐式整型扩宽 ⇒ 字面量运算必须显式 i64 后缀。

// cg_mask_from_cmp — 'w' 的 0/1 比较结果 → 'l' 的全 0 / 全 1 掩码
//
// 0 → 掩码 0;1 → 掩码 0xFFFFFFFFFFFFFFFF。
fn cg_mask_from_cmp(cg_raw: *u8, cmp_w: IRVal) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let ext = *ir_new_tmp(ir, QBE_L());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, ext.id);
    ir_emit_str(ir, " =l extsw %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, cmp_w.id);
    ir_emit_str(ir, "\n" as *u8);
    let zero = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, zero, 0);
    let m = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, m, "sub" as *u8, zero, ext);
    return m;
}

// cg_select_mask — 按掩码选值:mask != 0 ⇒ a,否则 b
fn cg_select_mask(cg_raw: *u8, mask: IRVal, a: IRVal, b: IRVal) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // nm = mask ^ (-1)   (取反)
    let ones = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, ones, 0i64 - 1i64);
    let nm = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, nm, "xor" as *u8, mask, ones);
    // r = (a & mask) | (b & nm)
    //   mask != 0 ⇒ a     (nm = ~mask = 0 ⇒ 第二项被清掉)
    //   mask == 0 ⇒ b     (mask = 0 ⇒ 第一项被清掉)
    let t1 = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, t1, "and" as *u8, a, mask);
    let t2 = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, t2, "and" as *u8, b, nm);
    let r = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, r, "or" as *u8, t1, t2);
    return r;
}

// cg_clamp_i64 — 整数域夹到 [lo, hi](有符号 64 位比较)
//
// lo/hi 都在 i64 范围内 ⇒ signed 比较足够。
// (u64 的窄宽度夹取走 cg_clamp_u64_narrow —— 有符号比较在 u64 上是错的。)
fn cg_clamp_i64(cg_raw: *u8, t: IRVal, lo: i64, hi: i64) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let lo_t = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, lo_t, lo);
    let hi_t = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, hi_t, hi);
    // c_lo = (t < lo)
    let c_lo = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_lo, "csltl" as *u8, t, lo_t);
    // c_hi = (t > hi)
    let c_hi = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_hi, "csgel" as *u8, t, hi_t);
    let m_lo = cg_mask_from_cmp(cg_raw, c_lo);
    let m_hi = cg_mask_from_cmp(cg_raw, c_hi);
    let r1 = cg_select_mask(cg_raw, m_lo, lo_t, t);
    let r2 = cg_select_mask(cg_raw, m_hi, hi_t, r1);
    return r2;
}

// cg_clamp_u64_narrow — u64 值 → 窄无符号类型的 [0, MAX]
//
// ⚠ **不能用有符号比较**:u64 值 ≥ 2^63 时有符号看是负数 ⇒「t < 0 ⇒ 0」会
//   把合法的 u64 值清成 0。正确做法:
//   · t 有符号看是负数 ⇒ t (无符号) ≥ 2^63 ⇒ **一定** > 任何窄无符号类型的 MAX
//     ⇒ 直接给 MAX
//   · 否则(t < 2^63)⇒ 用有符号比较与 MAX 比即可(MAX ≤ 2^32−1,是正的)
fn cg_clamp_u64_narrow(cg_raw: *u8, t: IRVal, hi: i64) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let hi_t = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, hi_t, hi);
    let zero = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, zero, 0);
    // c_neg = (t < 0)   —— 有符号看是负数 ⇒ 无符号看 ≥ 2^63
    let c_neg = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_neg, "csltl" as *u8, t, zero);
    // c_hi  = (t > hi)
    let c_hi = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_hi, "csgel" as *u8, t, hi_t);
    let m_neg = cg_mask_from_cmp(cg_raw, c_neg);
    let m_hi = cg_mask_from_cmp(cg_raw, c_hi);
    // r1 = neg ? hi : t
    let r1 = cg_select_mask(cg_raw, m_neg, hi_t, t);
    // r2 = (t > hi) ? hi : r1
    let r2 = cg_select_mask(cg_raw, m_hi, hi_t, r1);
    return r2;
}

// cg_clamp_int — 窄宽度的整数域夹取(统一入口)
//
// is_unsigned != 0 ⇒ 走 u64 语义(「负数看是 ≥ 2^63」的规则);
// 否则走有符号语义。
fn cg_clamp_int(cg_raw: *u8, t: IRVal, lo: i64, hi: i64, is_unsigned: i32) -> IRVal {
    if is_unsigned != 0 {
        return cg_clamp_u64_narrow(cg_raw, t, hi);
    }
    return cg_clamp_i64(cg_raw, t, lo, hi);
}

// cg_f64_const — 造一个 f64 常量 temp('d')
//
// 与 NODE_FLOAT 同款:jh_sprintf_f64 格式化 ⇒ "d_<十进制>" 文本。
// ⚠ 后端对 f64 **立即数**的算术会静默走整数路径(产生 garbage)⇒
//   任何用到浮点常量的地方都必须先把常量发射进 temp,再对 temp 做算术。
fn cg_f64_const(cg_raw: *u8, val: f64) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let mut buf: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
    sb_init((*ir).arena, &buf);
    sb_append_cstr((*ir).arena, &buf, "d_" as *u8);
    let fmt_buf_u8 = arena_alloc((*ir).arena, 64 as i64);
    jh_sprintf_f64(fmt_buf_u8, val);
    sb_append_cstr((*ir).arena, &buf, fmt_buf_u8);
    let v = *ir_new_tmp(ir, QBE_D());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, v.id);
    ir_emit_str(ir, " =d copy " as *u8);
    let fmt_str = sb_cstr((*ir).arena, &buf);
    ir_emit_str(ir, fmt_str);
    ir_emit_str(ir, "\n" as *u8);
    return v;
}

// cg_promote_f32_to_f64 — f32 → f64 无损提升(exts)
fn cg_promote_f32_to_f64(cg_raw: *u8, x: IRVal) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let up = *ir_new_tmp(ir, QBE_D());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, up.id);
    ir_emit_str(ir, " =d exts %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, x.id);
    ir_emit_str(ir, "\n" as *u8);
    return up;
}

// cg_sat_f64_to_i64 — f64 → i64 饱和(Rust 风格)
//
//   NaN          → 0
//   x < i64::MIN → i64::MIN   (dtosl 的 invalid 恰好就是 i64::MIN ⇒ 天然对上)
//   x > i64::MAX → i64::MAX   (需一次浮点比较)
//   区间内       → 向 0 截断
fn cg_sat_f64_to_i64(cg_raw: *u8, x: IRVal) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // t = dtosl(x) —— 区间内精确;NaN / 越界 ⇒ 0x8000_0000_0000_0000
    let t = *ir_new_tmp(ir, QBE_L());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, t.id);
    ir_emit_str(ir, " =l dtosl %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, x.id);
    ir_emit_str(ir, "\n" as *u8);
    // big = (x >= 2^63)
    let big_c = cg_f64_const(cg_raw, 9223372036854775808.0);
    let c_big = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_big, "cged" as *u8, x, big_c);
    // nan = (x != x)
    let c_nan = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_nan, "cned" as *u8, x, x);
    let m_big = cg_mask_from_cmp(cg_raw, c_big);
    let m_nan = cg_mask_from_cmp(cg_raw, c_nan);
    let i64_max = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, i64_max, 9223372036854775807i64);
    let zero = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, zero, 0);
    // r1 = big ? i64::MAX : t
    let r1 = cg_select_mask(cg_raw, m_big, i64_max, t);
    // r2 = nan ? 0 : r1
    let r2 = cg_select_mask(cg_raw, m_nan, zero, r1);
    return r2;
}

// cg_sat_f64_to_u64 — f64 → u64 饱和(Rust 风格)
//
//   NaN          → 0
//   x < 0        → 0
//   x >= 2^64    → u64::MAX
//   区间内       → 向 0 截断
//
// 「区间内」对 x ∈ [2^63, 2^64) 需要两步(经典无符号转换):
//   x < 2^63       → dtosl(x)
//   x >= 2^63      → dtosl(x - 2^63) + 2^63
// (dtosl 是**有符号**转换,对 x >= 2^63 给 invalid ⇒ 直接用它会丢一半值。)
//
// ⚠ 三个角落(NaN / 负数 / 太大)必须在**浮点域**做比较:
//   整数域的有符号比较会把 x ∈ [2^63, 2^64)(合法精确值)与 u64::MAX 一起当负数。
fn cg_sat_f64_to_u64(cg_raw: *u8, x: IRVal) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // 两步常量:2^63 与 2^64
    let c_2p63 = cg_f64_const(cg_raw, 9223372036854775808.0);
    let c_2p64 = cg_f64_const(cg_raw, 18446744073709551616.0);
    // y = x - 2^63      (浮点减;常量已是 temp ⇒ 不会踩「f64 立即数算术」的坑)
    let y = *ir_new_tmp(ir, QBE_D());
    ir_emit_binary(ir, y, "sub" as *u8, x, c_2p63);
    // t_lo = dtosl(x)    (x < 2^63 时精确)
    let t_lo = *ir_new_tmp(ir, QBE_L());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, t_lo.id);
    ir_emit_str(ir, " =l dtosl %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, x.id);
    ir_emit_str(ir, "\n" as *u8);
    // t_hi = dtosl(y) + 2^63
    let t_hi = *ir_new_tmp(ir, QBE_L());
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, t_hi.id);
    ir_emit_str(ir, " =l dtosl %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, y.id);
    ir_emit_str(ir, "\n" as *u8);
    let c_2p63_i = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, c_2p63_i, 0i64 - 9223372036854775807i64 - 1i64);
    let t_hi2 = *ir_new_tmp(ir, QBE_L());
    ir_emit_binary(ir, t_hi2, "add" as *u8, t_hi, c_2p63_i);
    // ge63 = (x >= 2^63)
    let c_ge63 = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_ge63, "cged" as *u8, x, c_2p63);
    let m_ge63 = cg_mask_from_cmp(cg_raw, c_ge63);
    // t = ge63 ? t_hi2 : t_lo
    let t = cg_select_mask(cg_raw, m_ge63, t_hi2, t_lo);
    // big = (x >= 2^64) → u64::MAX
    let c_big = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_big, "cged" as *u8, x, c_2p64);
    let m_big = cg_mask_from_cmp(cg_raw, c_big);
    let u64_max = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, u64_max, 0i64 - 1i64);
    let t1 = cg_select_mask(cg_raw, m_big, u64_max, t);
    // NaN → 0
    let c_nan = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_nan, "cned" as *u8, x, x);
    let m_nan = cg_mask_from_cmp(cg_raw, c_nan);
    let zero = *ir_new_tmp(ir, QBE_L());
    ir_emit_copy(ir, zero, 0);
    let t2 = cg_select_mask(cg_raw, m_nan, zero, t1);
    // x < 0 → 0
    let c_zero_f = cg_f64_const(cg_raw, 0.0);
    let c_neg = *ir_new_tmp(ir, QBE_W());
    ir_emit_binary(ir, c_neg, "cltd" as *u8, x, c_zero_f);
    let m_neg = cg_mask_from_cmp(cg_raw, c_neg);
    let t3 = cg_select_mask(cg_raw, m_neg, zero, t2);
    return t3;
}

// cg_sat_f64_to_int — f64/f32 → 目标整型的饱和转换(统一入口)
//
// src_is_f32 != 0 ⇒ 先无损提升到 f64(阈值比较只维护一套)。
// is_unsigned != 0 ⇒ 走 u64 饱和;否则走 i64 饱和。
fn cg_sat_f64_to_int(cg_raw: *u8, x: IRVal, src_is_f32: i32, is_unsigned: i32) -> IRVal {
    if is_unsigned != 0 {
        if src_is_f32 != 0 {
            let up = cg_promote_f32_to_f64(cg_raw, x);
            return cg_sat_f64_to_u64(cg_raw, up);
        }
        return cg_sat_f64_to_u64(cg_raw, x);
    }
    if src_is_f32 != 0 {
        let up = cg_promote_f32_to_f64(cg_raw, x);
        return cg_sat_f64_to_i64(cg_raw, up);
    }
    return cg_sat_f64_to_i64(cg_raw, x);
}

// 当 arg.qbe_type != param.qbe_type 时 emit QBE 转换指令（dtosi/stosi/sltof/...
// 等）。返回转换后的 IRVal（同 qt）或原 arg（不需要转换）。
//
// 输入：cg_raw, arg (IRVal), src_t (*Type), dst_t (*Type)
fn cg_convert_arg(cg_raw: *u8, arg: IRVal, src_t: *u8, dst_t: *u8) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    if dst_t == (0 as *u8) {
        return arg;
    }
    // W-009 fix: src_t==0（literal 没 type info）时用 arg.qbe_type 当 src_qt。
    //   否则 literal 0 (NODE_INT emit "=w copy 0") 在比较 i64/pointer 字段时
    //   ceql/csltl 报 operand type 不匹配（QBE 要两边都是 l）。
    // W-009 fix: dst.kind=KIND_POINTER 也走转换（emit W→L extsw 给 pointer cast 用）
    let mut src_qt: i32 = if src_t == (0 as *u8) { arg.qbe_type } else { qbe_type_of(src_t) };
    let dst_qt = qbe_type_of(dst_t);
    // v4.0.2.2 (W-098 真修 — cast-side):NODE_INT IR-builder 已 promote 大 imm W → L
    //   (避免 W copy 静默截断),但 src_t 仍指 i32 AST type (default int prim)。
    //   若 arg.qbe_type = L 而 src_qt = W,说明 IR 层已升级;cast 不应再 emit extsw
    //   (会把 promote 后的 L 值 re-truncate 到低 32 位 → 静默 loss)。
    //   Fix:取 IR-层实际宽度作 src_qt,跳过 downcast 重新 sign-extend。
    if arg.qbe_type == QBE_L() && src_qt == QBE_W() {
        src_qt = QBE_L();
    }
    // ── W-143:指针 ↔ 浮点 ──
    //
    // 放在下面的 KIND_PRIMITIVE 早 bail **之前** —— 早 bail 会让指针原样返回
    // (一条指令都不发)⇒ 「指针→浮点」既没有转换、结果的 qbe_type 也仍是 'l'
    // ⇒ 流进 f64 形参时 caller 放整数寄存器 / callee 读 XMM ⇒ **ABI 错配**。
    //
    // 语义(用户 2026-10-26 拍板):**数值转换**,不是位重解释、不是解引用
    //   · 指针 → f64/f32:地址当 64 位**无符号**整数 → 数值转浮点
    //     (整数→浮点是 roundTiesToEven,只可能丢精度,**不涉及饱和** ⇒ 不对称化)
    //   · f64/f32 → 指针:浮点值**饱和**转成 64 位无符号整数 → 当地址
    if src_t != (0 as *u8) && dst_t != (0 as *u8) {
        let src2 = src_t as *Type;
        let dst2 = dst_t as *Type;
        let mut src_is_ptr: i32 = 0;
        if (*src2).kind == KIND_POINTER() || (*src2).kind == KIND_REF() {
            src_is_ptr = 1;
        }
        let mut dst_is_ptr: i32 = 0;
        if (*dst2).kind == KIND_POINTER() || (*dst2).kind == KIND_REF() {
            dst_is_ptr = 1;
        }
        let mut src_is_f: i32 = 0;
        if (*src2).kind == KIND_PRIMITIVE() {
            if (*src2).prim == PRIM_F64() || (*src2).prim == PRIM_F32() { src_is_f = 1; }
        }
        let mut dst_is_f: i32 = 0;
        if (*dst2).kind == KIND_PRIMITIVE() {
            if (*dst2).prim == PRIM_F64() || (*dst2).prim == PRIM_F32() { dst_is_f = 1; }
        }
        // 指针 → 浮点:地址当 u64 → 数值转浮点(ultof = u64→f64,后端已有)
        if src_is_ptr != 0 && dst_is_f != 0 {
            // u64 → f64
            let mid = *ir_new_tmp(ir, QBE_D());
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, mid.id);
            ir_emit_str(ir, " =d ultof %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, arg.id);
            ir_emit_str(ir, "\n" as *u8);
            if (*dst2).prim == PRIM_F32() {
                // f64 → f32(ultof 只发 f64)
                let out = *ir_new_tmp(ir, QBE_S());
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, out.id);
                ir_emit_str(ir, " =s truncd %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, mid.id);
                ir_emit_str(ir, "\n" as *u8);
                return out;
            }
            return mid;
        }
        // 浮点 → 指针:饱和转 u64 → 当地址
        if src_is_f != 0 && dst_is_ptr != 0 {
            let mut src_is_f32: i32 = 0;
            if src_qt == QBE_S() { src_is_f32 = 1; }
            let sat = cg_sat_f64_to_int(cg_raw, arg, src_is_f32, 1);
            return sat;
        }
    }
    // 只有 src_t 非 0 时做 KIND_PRIMITIVE 早 bail（保留原语义）；src_t==0 时直接走转换
    // dst 不再硬要求 KIND_PRIMITIVE（pointer 是 qbe_type L，走 W→L extsw）
    if src_t != (0 as *u8) {
        let src = src_t as *Type;
        if (*src).kind != KIND_PRIMITIVE() {
            return arg;
        }
        // same-qt-same-prim only when both are primitive
        if src_qt == dst_qt && (*src).kind == KIND_PRIMITIVE() {
            let dst2 = dst_t as *Type;
            if (*dst2).kind == KIND_PRIMITIVE() {
                if (*src).prim == (*dst2).prim {
                    return arg;
                }
            }
        }
        // sub-word (u8/u16/i8/i16/bool) → word (i32/u32) / long (i64)
//   v0.6 jhyy workaround: qbe_type_of(u8) returns 'w' (not 'b' like C-side),
//   so判断走 prim check 而非 src_qt/b vs dst_qt/w.
// Bug 3 真修 (v0.9 wip commit 2.86): sub-word → long 不能直 emit `=l copy`
//   (QBE 拒绝 w→l copy 无 extsw/extuw)。必须链: sub-word → w (loadub/loadsb 已经扩展)
//   然后 w → l (extuw 符号 or extsw 有符号).
//   判定: src prim ∈ {I8,U8,I16,U16,BOOL} 且 dst prim ∈ {I32,U32,I64,U64}
        if src_t != (0 as *u8) && dst_t != (0 as *u8) {
            let src2 = src_t as *Type;
            let dst2 = dst_t as *Type;
            if (*src2).kind == KIND_PRIMITIVE() && (*dst2).kind == KIND_PRIMITIVE() {
                let sp = (*src2).prim;
                let dp = (*dst2).prim;
                let src_sub: i32 = if sp == PRIM_I8() || sp == PRIM_U8() || sp == PRIM_I16() || sp == PRIM_U16() || sp == PRIM_BOOL() { 1 } else { 0 };
                let dst_word: i32 = if dp == PRIM_I32() || dp == PRIM_U32() || dp == PRIM_I64() || dp == PRIM_U64() { 1 } else { 0 };
                if src_sub != 0 && dst_word != 0 {
                    let is_long: i32 = if dp == PRIM_I64() || dp == PRIM_U64() { 1 } else { 0 };
                    let is_signed: i32 = if sp == PRIM_I8() || sp == PRIM_I16() { 1 } else { 0 };
                    if is_long == 0 {
                        // sub-word → word: loadub/loadsb/loaduh/loadsh already extended, just copy
                        let result = *ir_new_tmp(ir, dst_qt);
                        ir_emit_str(ir, "    %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, result.id);
                        ir_emit_str(ir, " =" as *u8);
                        ir_emit_int(ir, "%c" as *u8, dst_qt);
                        ir_emit_str(ir, " copy %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, arg.id);
                        ir_emit_str(ir, "\n" as *u8);
                        return result;
                    }
                    // sub-word → long: chain w copy then w→l extsw/extuw
                    let w_tmp = *ir_new_tmp(ir, QBE_W());
                    ir_emit_str(ir, "    %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, w_tmp.id);
                    ir_emit_str(ir, " =w copy %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, arg.id);
                    ir_emit_str(ir, "\n" as *u8);
                    let l_tmp = *ir_new_tmp(ir, QBE_L());
                    ir_emit_str(ir, "    %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, l_tmp.id);
                    ir_emit_str(ir, " =l " as *u8);
                    if is_signed != 0 {
                        ir_emit_str(ir, "extsw" as *u8);
                    } else {
                        ir_emit_str(ir, "extuw" as *u8);
                    }
                    ir_emit_str(ir, " %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, w_tmp.id);
                    ir_emit_str(ir, "\n" as *u8);
                    return l_tmp;
                }
            }
        }
    }
    // [历史] v0 codegen bug 2 的 workaround:「避免 &&/|| 嵌套 short-circuit」
    //   —— 当时 nested phi predecessor 会 mismatch,故一律改成 nested if-else。
    //   **该约束已退役**(W-169):v4.x 的 in-mem 后端对嵌套短路是正确的,
    //   门是 compiler/tests/examples/logical_nested.jhyy(带调用计数器)。
    //   本行以下的代码是 float→int 转换,跟短路无关 —— 旧注释挂错了位置。
    // Sprint 4.5 C step 2 fix (float_cmp): D→S case was unreachable
    //   (above if src_qt==D matched first; inner QBE_W/L only — no QBE_S case).
    //   Add explicit QBE_S branch so f64→f32 truncd emits correctly.
    //   S→D exts branch already in dedicated else-if below; mirror here for src_qt==S.
    // ── W-143:float → 整数 走**饱和**转换(Rust 风格)──
    //
    // 放在 conv 表**之前**:裸 cvttsd2si 对越界/NaN 给的是 integer indefinite
    // (i32::MIN / i64::MIN)—— 既不是「向 0 截断」也不是「饱和」⇒ spec 推不出来。
    //
    // 窄宽度(i8/u8/i16/u16/i32/u32/bool):先按 64 位饱和,再在**整数域**夹到
    // 目标类型的 [MIN, MAX](iN 的区间是 i64 区间的子集 ⇒ 等价)。
    if (src_qt == QBE_D() || src_qt == QBE_S()) && (dst_qt == QBE_W() || dst_qt == QBE_L()) {
        // 目标整型的 prim 决定有符号性
        let mut is_unsigned: i32 = 0;
        if dst_t != (0 as *u8) {
            let dt = dst_t as *Type;
            if (*dt).kind == KIND_PRIMITIVE() {
                let dp = (*dt).prim;
                if dp == PRIM_U64() || dp == PRIM_U32() || dp == PRIM_U16() || dp == PRIM_U8() {
                    is_unsigned = 1;
                }
            }
        }
        let mut src_is_f32: i32 = 0;
        if src_qt == QBE_S() { src_is_f32 = 1; }
        let sat = cg_sat_f64_to_int(cg_raw, arg, src_is_f32, is_unsigned);
        if dst_qt == QBE_L() {
            return sat;
        }
        // 窄宽度:整数域夹到目标类型的 [MIN, MAX],再窄化成 'w'
        let mut lo: i64 = 0i64 - 2147483648i64;
        let mut hi: i64 = 2147483647i64;
        let mut unsigned_narrow: i32 = 0;
        if dst_t != (0 as *u8) {
            let dt = dst_t as *Type;
            if (*dt).kind == KIND_PRIMITIVE() {
                let dp = (*dt).prim;
                if dp == PRIM_I8() { lo = 0i64 - 128i64; hi = 127i64; }
                else if dp == PRIM_U8() { lo = 0i64; hi = 255i64; unsigned_narrow = 1; }
                else if dp == PRIM_I16() { lo = 0i64 - 32768i64; hi = 32767i64; }
                else if dp == PRIM_U16() { lo = 0i64; hi = 65535i64; unsigned_narrow = 1; }
                else if dp == PRIM_I32() { lo = 0i64 - 2147483648i64; hi = 2147483647i64; }
                else if dp == PRIM_U32() { lo = 0i64; hi = 4294967295i64; unsigned_narrow = 1; }
            }
        }
        let clamped = cg_clamp_int(cg_raw, sat, lo, hi, unsigned_narrow);
        // 'l' → 'w' 窄化(QBE 'copy' 从 l 到 w 隐式截断)
        let out = *ir_new_tmp(ir, QBE_W());
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, out.id);
        ir_emit_str(ir, " =w copy %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, clamped.id);
        ir_emit_str(ir, "\n" as *u8);
        return out;
    }
    let mut conv: *u8 = 0 as *u8;
    // W-149:conv 这个 op 产出的是 f64 还是 f32?——
    //   整数→浮点的四个 op(sltof/swtof/ultof/uwtof)在本后端**恒产 f64**
    //   (只有 swtof 会按目标槽在 cvtsi2ss/cvtsi2sd 之间切,见
    //    codegen_amd64_emit_sse.jhyy:264-268;另三个恒 cvtsi2sd + movsd,
    //    见 codegen_amd64_state.jhyy 的 ILTOK_* 注释)
    //   ⇒ f32 目标必须「先落 f64,再 truncd」。
    let mut conv_makes_f64: i32 = 0;
    if src_qt == QBE_D() {
        if dst_qt == QBE_S() {
            conv = "truncd" as *u8;
        }
    } else if src_qt == QBE_S() {
        if dst_qt == QBE_D() {
            conv = "exts" as *u8;
        }
    } else if dst_qt == QBE_D() || dst_qt == QBE_S() {
        // ── W-149 (2026-10-26 真修):整数 → 浮点 ──
        //
        // 修前两处错:
        //   ① **符号性丢了** —— u64 → f64 发的是 `sltof`(有符号)⇒ 值 ≥ 2^63
        //      变**负数**。后端的 `ultof` 早就写好了(W-146 还把它的算法修对了),
        //      但前端从来没发过它 ⇒ 那条修复对 u64→f64 是**死代码**。
        //   ② **f32 目标拿到的是 f64** —— 旧表给 f32 目标发 `ultof`/`uwtof`,
        //      而这两个恒产 f64 ⇒ **f64 的位模式塞进 f32 槽** ⇒ 读出来是垃圾。
        //
        // 修法:按**源类型的 prim** 判符号性(拿不到 src_t ⇒ 不猜,保持 sltof);
        //       f32 目标统一走「f64 + truncd」(见下面的 conv_makes_f64 分支)。
        //
        // 注:u8/u16/u32 的值在 64 位槽里是**零扩展**的(实测 u32→i64 保号),
        //     所以 L 槽上的无符号源用 `ultof`(u64→f64)是对的。
        let mut src_unsigned: i32 = 0;
        if src_t != (0 as *u8) {
            let st = src_t as *Type;
            if (*st).kind == KIND_PRIMITIVE() {
                let sp = (*st).prim;
                if sp == PRIM_U64() || sp == PRIM_U32() || sp == PRIM_U16() || sp == PRIM_U8() {
                    src_unsigned = 1;
                }
            }
        }
        if src_qt == QBE_L() {
            if src_unsigned != (0 as i32) {
                conv = "ultof" as *u8;
            } else {
                conv = "sltof" as *u8;
            }
        } else if src_qt == QBE_W() {
            if src_unsigned != (0 as i32) {
                conv = "uwtof" as *u8;
            } else {
                conv = "swtof" as *u8;
            }
        }
        conv_makes_f64 = 1;
    } else if src_qt == QBE_W() {
        // W-007 fix (v0.8 bug 11 analog): i32→i64 sign-extend via extsw
        if dst_qt == QBE_L() {
            conv = "extsw" as *u8;
        }
    } else if src_qt == QBE_L() {
        // v0.9 wip commit 2.5 (B-let2): l→w narrow — QBE 'copy' from l to w truncates implicitly
        // (对齐 v0 codegen.c:780-783 integer width change narrowing l→w 分支)
        if dst_qt == QBE_W() {
            conv = "copy" as *u8;
        }
    }
    if conv == (0 as *u8) {
        return arg;
    }
    // ── W-149:f32 目标 ⇒ 先转 f64,再 truncd ──
    //
    // 整数→浮点的 op 恒产 f64(见上面 conv_makes_f64 的说明)⇒ 直接发
    // `=s <conv> %t` 会把 f64 的位模式塞进 f32 槽 ⇒ 读出来是垃圾。
    // 正确形状:先落一个 'd' 临时槽,再 `=s truncd` 收窄(后端已支持 truncd)。
    if conv_makes_f64 != (0 as i32) && dst_qt == QBE_S() {
        let mid = *ir_new_tmp(ir, QBE_D());
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, mid.id);
        ir_emit_str(ir, " =d " as *u8);
        ir_emit_str(ir, conv);
        ir_emit_str(ir, " %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, arg.id);
        ir_emit_str(ir, "\n" as *u8);
        let result = *ir_new_tmp(ir, QBE_S());
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, result.id);
        ir_emit_str(ir, " =s truncd %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, mid.id);
        ir_emit_str(ir, "\n" as *u8);
        return result;
    }
    let result = *ir_new_tmp(ir, dst_qt);
    ir_emit_str(ir, "    %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, result.id);
    ir_emit_str(ir, " =" as *u8);
    ir_emit_int(ir, "%c" as *u8, dst_qt);
    ir_emit_str(ir, " " as *u8);
    ir_emit_str(ir, conv);
    ir_emit_str(ir, " %t" as *u8);
    ir_emit_int(ir, "%d" as *u8, arg.id);
    ir_emit_str(ir, "\n" as *u8);
    return result;
}

// ════════════════════════════════════════════════════
// cg_body_returns — body 是否以 return 结尾（cg_expr NODE_IF 用）
// ════════════════════════════════════════════════════

// 注意：本函数必须在 cg_expr 之前定义（v1.0.0 sprint 5: NODE_IF 现在用
// cg_body_returns 检查 then/else 末是否为 return，避免 QBE dead jmp after ret）
fn cg_body_returns(body_node: *Node) -> i32 {
    if body_node == (0 as *Node) {
        return 0;
    }
    if (*body_node).kind == NODE_RETURN() {
        return 1;
    }
    if (*body_node).kind == NODE_BREAK() || (*body_node).kind == NODE_CONTINUE() {
        return 1;
    }
    if (*body_node).kind == NODE_BLOCK() {
        let bd = node_block_data(body_node);
        if (*bd).nstmts > (0 as i64) {
            // v4.0.2.5 (W-097 hoist): atomic step decomposition for `(nstmts - 1) * 8`
            let last_idx: i64 = (*bd).nstmts - (1 as i64);
            let last_slot = ptr_add_u8((*bd).stmts, last_idx * (8 as i64)) as **Node;
            let last = *last_slot;
            if (*last).kind == NODE_RETURN() || (*last).kind == NODE_BREAK() || (*last).kind == NODE_CONTINUE() {
                return 1;
            }
        }
        return 0;
    }
    // Bug 2 真修 (v0.9 wip commit 2.85): NODE_IF / NODE_MATCH 是 value-producing expr.
    // 若 then AND else 都 return, then 整个 if 表达式语义上"终止"控制流(无 value 流向 phi).
    // 原版只查 NODE_RETURN/BLOCK/BREAK/CONTINUE,误判 nested 3-way dispatch (if A { if B {...} else {...} } else if C {...} else {...})
    // 为 non-termin,走 phi emit 路径,emit `phi %t0 %t0` 引用 sentinel → QBE reject.
    // 递归检查: then AND else 都 termin 时 → if expr 等价 termin.
    if (*body_node).kind == NODE_IF() {
        let nid = node_if_data(body_node);
        let then_n = (*nid).then_body as *Node;
        let else_n = (*nid).else_body as *Node;
        let then_term = cg_body_returns(then_n);
        let else_term = if else_n != (0 as *Node) { cg_body_returns(else_n) } else { 1 };
        if then_term != 0 && else_term != 0 {
            return 1;
        }
        return 0;
    }
    if (*body_node).kind == NODE_MATCH() {
        let nm = node_match_data(body_node);
        let n_arms = (*nm).narms;
        if n_arms > (0 as i64) {
            // 检查所有 arm 都 termin
            let mut all_term: i32 = 1;
            let mut ai: i64 = 0 as i64;
            while ai < n_arms {
                let arm_slot = ptr_add_u8((*nm).arms, ai * (8 as i64)) as **Node;
                let arm = *arm_slot;
                if cg_body_returns(arm) == 0 {
                    all_term = 0;
                }
                ai = ai + (1 as i64);
            }
            if all_term != 0 { return 1; }
        }
        return 0;
    }
    return 0;
}

// ════════════════════════════════════════════════════
// cg_match_pattern — v0.9 wip commit 2.9 (B-match fix)
// Emit pattern 比较,返回 IRVal cmp (QBE 'w') 给 NODE_MATCH 用。
// 对齐 v0 codegen.c:159-197: NODE_PATTERN_LIT / WILD 显式,其他 default = cmp = 1 (accept-all)。
// RANGE pattern 暂略(match_exhaustive 不用 + jhyy forward ref 不支持 cg_expr 调用) →
// 推迟到 v1.0.0 sprint 3 (Task #50)
//
// v1.3.7: NODE_PATTERN_ENUM — tag compare + payload slot alias.
//          NODE_PATTERN_OR   — recurse left+right, `or` the cmps.
// v1.4.6 W-019 真修 expanded: signature now takes CGContext + match_type so
//   NODE_PATTERN_ENUM can do full tag compare + payload slot alias via
//   cg_add_local (mirror codegen.c:272-358). 之前 src0/ silently skipped,
//   body `v` 在 arm body reference 时 cg_find_local miss → phi %t0 缺定义
//   → QBE "invalid type for operand %t0 in phi" (gdb_pretty_test fail)。
// Note: must define before cg_expr (no forward decl).
fn cg_match_pattern(cg_raw: *u8, matched: IRVal, pattern: *Node, match_type: *u8) -> IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let pk = (*pattern).kind;
    if pk == NODE_PATTERN_LIT() {
        let pl = node_pattern_lit_data(pattern);
        let mut qt: i32 = matched.qbe_type;
        if qt == (0 as i32) { qt = QBE_W(); }
        let lit = *ir_new_tmp(ir, qt);
        ir_emit_copy(ir, lit, (*pl).value);
        let cmp = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, cmp, "ceqw" as *u8, matched, lit);
        return cmp;
    }
    if pk == NODE_PATTERN_WILD() {
        let cmp = *ir_new_tmp(ir, QBE_W());
        ir_emit_copy(ir, cmp, 1);
        return cmp;
    }
    // v1.3.7: OR pattern — recurse left and right, combine with `or`.
    if pk == NODE_PATTERN_OR() {
        let po = node_pattern_or_data(pattern);
        let cl = cg_match_pattern(cg_raw, matched, (*po).left as *Node, match_type);
        let cr = cg_match_pattern(cg_raw, matched, (*po).right as *Node, match_type);
        let result = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, result, "or" as *u8, cl, cr);
        return result;
    }
    // v1.4.6 W-019 真修: ENUM pattern — tag compare + payload slot alias (mirror codegen.c:272-358).
    // 1. Find enum_type from pe->type_sym (long form `MaybeInt::Some`) or fallback to match_type (short form).
    // 2. Find variant tag + payload_offset.
    // 3. Load tag from matched+0 (word), compare to expected tag → tag_cmp.
    // 4. If inner is NODE_PATTERN_IDENT, register payload slot alias via cg_add_local
    //    so body dereferences load from there directly. (No copy needed.)
    //    Skip the tag compare when no binding (Some(_) / None) to preserve legacy
    //    accept-all semantics.
    if pk == NODE_PATTERN_ENUM() {
        let pe = node_pattern_enum_data(pattern);
        let variant_sym_raw = (*pe).variant_sym;
        if variant_sym_raw != (0 as *u8) {
            // Resolve enum_type
            let mut enum_type_raw: *u8 = 0 as *u8;
            let type_sym_raw = (*pe).type_sym;
            if type_sym_raw != (0 as *u8) {
                let type_sym = type_sym_raw as *Sym;
                let type_field = (*type_sym).type_ptr;
                if type_field != (0 as *u8) {
                    let tt = type_field as *Type;
                    if (*tt).kind == KIND_ENUM() {
                        enum_type_raw = type_field;
                    }
                }
            }
            if enum_type_raw == (0 as *u8) {
                if match_type != (0 as *u8) {
                    let mt = match_type as *Type;
                    if (*mt).kind == KIND_ENUM() {
                        enum_type_raw = match_type;
                    }
                }
            }
            if enum_type_raw != (0 as *u8) {
                let enum_type = enum_type_raw as *Type;
                // Find expected_tag by variant name
                let variant_sym = variant_sym_raw as *Sym;
                let mut expected_tag: i32 = (0 as i32) - (1 as i32);
                let nvariants: i64 = (*enum_type).nvariants;
                let mut vi: i64 = 0 as i64;
                while vi < nvariants {
                    let vd_ptr = ptr_add_u8((*enum_type).variants, vi * VARIANT_DESC_SIZE());
                    let vd = vd_ptr as *VariantDesc;
                    let v_name_sym_raw = (*vd).name;
                    if v_name_sym_raw != (0 as *u8) {
                        let v_name_sym = v_name_sym_raw as *Sym;
                        let v_name = (*v_name_sym).name;
                        if strcmp(v_name, (*variant_sym).name) == (0 as i32) {
                            expected_tag = (*vd).tag;
                            break;
                        }
                    }
                    vi = vi + (1 as i64);
                }
                if expected_tag != ((0 as i32) - (1 as i32)) {
                    // Check binding (inner is NODE_PATTERN_IDENT → register payload slot)
                    let inner_raw = (*pe).inner;
                    let mut has_binding: i32 = 0 as i32;
                    if inner_raw != (0 as *u8) {
                        let inner_node = inner_raw as *Node;
                        if (*inner_node).kind == NODE_PATTERN_IDENT() {
                            has_binding = 1 as i32;
                        }
                    }
                    if has_binding == (1 as i32) {
                        // matched may be w when enum fits in a register. Spill to slot for tag compare + payload alias.
                        let mut slot_base = matched;
                        if matched.qbe_type == QBE_W() {
                            let tmp = *ir_new_tmp(ir, QBE_L());
                            ir_emit_str(ir, "    %t" as *u8);
                            ir_emit_int(ir, "%d" as *u8, tmp.id);
                            ir_emit_str(ir, " =l alloc8 8\n" as *u8);
                            let tmp_addr = *ir_new_tmp(ir, QBE_L());
                            ir_emit_binary(ir, tmp_addr, "add" as *u8, tmp, ir_new_int(0 as i64));
                            ir_emit_str(ir, "    storew %t" as *u8);
                            ir_emit_int(ir, "%d" as *u8, matched.id);
                            ir_emit_str(ir, ", %t" as *u8);
                            ir_emit_int(ir, "%d" as *u8, tmp_addr.id);
                            ir_emit_str(ir, "\n" as *u8);
                            slot_base = tmp_addr;
                        }
                        // load tag from slot_base+0
                        let tag_addr = *ir_new_tmp(ir, QBE_L());
                        ir_emit_binary(ir, tag_addr, "add" as *u8, slot_base, ir_new_int(0 as i64));
                        let loaded_tag = *ir_new_tmp(ir, QBE_W());
                        ir_emit_str(ir, "    %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, loaded_tag.id);
                        ir_emit_str(ir, " =w loadw %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, tag_addr.id);
                        ir_emit_str(ir, "\n" as *u8);
                        let tag_lit = *ir_new_tmp(ir, QBE_W());
                        ir_emit_copy(ir, tag_lit, expected_tag as i64);
                        let tag_cmp = *ir_new_tmp(ir, QBE_W());
                        ir_emit_binary(ir, tag_cmp, "ceqw" as *u8, loaded_tag, tag_lit);
                        // payload slot alias
                        let pi = node_pattern_ident_data((*pe).inner as *Node);
                        let bind_sym = (*pi).sym;
                        let payload_slot = *ir_new_tmp(ir, QBE_L());
                        let off: i64 = (*enum_type).payload_off;
                        ir_emit_binary(ir, payload_slot, "add" as *u8, slot_base, ir_new_int(off));
                        let _al = cg_add_local(cg_raw, bind_sym, payload_slot, 1);
                        return tag_cmp;
                    }
                    // v1.7.1 patch A3: non-binding enum pattern — 仍需 tag compare,
                    // 跟 binding 路径差异只在无 payload slot alias. 没这 fix 时
                    // `Option::None => 200` 走 fallback cmp=1, 永远第一 arm 命中
                    // (per docs/workarounds.md § Stage 3 已知限制 + W-XXX ACTIVE 段).
                    //
                    // v1.7.2 patch A2': mirror src/codegen.c:434-442 spill guard.
                    //   matched may be 'w' (literal/reg) when enum fits in a register —
                    //   `add IRVAL_INT, 0` 把 literal 当 pointer + loadw literal 是 UB.
                    //   触发 `match 1 { Color::Red => 0 }` cmp 永远乱 + gdb_pretty read_color fail.
                    //   镜像 binding path 上方 (line 1070-1085) 的 spill block.
                    let mut slot_base2 = matched;
                    if matched.qbe_type == QBE_W() {
                        let tmp_n = *ir_new_tmp(ir, QBE_L());
                        ir_emit_str(ir, "    %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, tmp_n.id);
                        ir_emit_str(ir, " =l alloc8 8\n" as *u8);
                        let tmp_n_addr = *ir_new_tmp(ir, QBE_L());
                        ir_emit_binary(ir, tmp_n_addr, "add" as *u8, tmp_n, ir_new_int(0 as i64));
                        ir_emit_str(ir, "    storew %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, matched.id);
                        ir_emit_str(ir, ", %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, tmp_n_addr.id);
                        ir_emit_str(ir, "\n" as *u8);
                        slot_base2 = tmp_n_addr;
                    }
                    let tag_addr2 = *ir_new_tmp(ir, QBE_L());
                    ir_emit_binary(ir, tag_addr2, "add" as *u8, slot_base2, ir_new_int(0 as i64));
                    let loaded_tag2 = *ir_new_tmp(ir, QBE_W());
                    ir_emit_str(ir, "    %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, loaded_tag2.id);
                    ir_emit_str(ir, " =w loadw %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, tag_addr2.id);
                    ir_emit_str(ir, "\n" as *u8);
                    let tag_lit2 = *ir_new_tmp(ir, QBE_W());
                    ir_emit_copy(ir, tag_lit2, expected_tag as i64);
                    let tag_cmp2 = *ir_new_tmp(ir, QBE_W());
                    ir_emit_binary(ir, tag_cmp2, "ceqw" as *u8, loaded_tag2, tag_lit2);
                    return tag_cmp2;
                }
            }
        }
        // fallback: always match (legacy, defensive)
        let cmp = *ir_new_tmp(ir, QBE_W());
        ir_emit_copy(ir, cmp, 1);
        return cmp;
    }
    // v1.6.x: NODE_PATTERN_RANGE — emit lo/hi manually (no cg_expr forward-call,
    // jhyy 无 forward decl). Covers literal range `1..10` after parse_pattern +
    // parse_pattern_primary extension (W-NNN follow-up):
    //   - lo = NODE_PATTERN_LIT (parse_pattern TOKEN_INT/BOOL/CHAR/MINUS arm)
    //   - hi = NODE_INT         (parse_pattern_primary extension)
    // Both emitted as `copy N` with matched.qbe_type. IDENT range (`x..y`) goes
    // lo=NODE_PATTERN_IDENT which has no value resolution path — fall through
    // to cmp=1 accept-all (preexisting behavior, no test exercises it).
    if pk == NODE_PATTERN_RANGE() {
        let pr = node_pattern_range_data(pattern) as *NodePatternRange;
        let mut qt: i32 = matched.qbe_type;
        if qt == (0 as i32) { qt = QBE_W(); }

        let zero = IRVal { kind: IRVAL_INT(), id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let mut lo_val: IRVal = zero;
        let mut hi_val: IRVal = zero;
        let mut unsupported: i32 = 0 as i32;

        // emit lo: NODE_PATTERN_LIT only (literal range)
        let lo_raw = (*pr).lo;
        let lo_node = lo_raw as *Node;
        if (*lo_node).kind == NODE_PATTERN_LIT() {
            let pl = node_pattern_lit_data(lo_node);
            let tmp = *ir_new_tmp(ir, qt);
            ir_emit_copy(ir, tmp, (*pl).value);
            lo_val = tmp;
        } else {
            // NODE_PATTERN_IDENT (IDENT range lo) + other → fall through to cmp=1
            unsupported = 1 as i32;
        }

        // emit hi: NODE_INT only (parse_pattern_primary returns ast_new_int)
        let hi_raw = (*pr).hi;
        let hi_node = hi_raw as *Node;
        if (*hi_node).kind == NODE_INT() {
            let li = node_int_data(hi_node);
            let tmp = *ir_new_tmp(ir, qt);
            ir_emit_copy(ir, tmp, (*li).value);
            hi_val = tmp;
        } else {
            unsupported = 1 as i32;
        }

        if unsupported != (0 as i32) {
            // Ident range (x..y) or other unsupported lo/hi kind → cmp=1 accept-all
            let cmp = *ir_new_tmp(ir, QBE_W());
            ir_emit_copy(ir, cmp, 1);
            return cmp;
        }

        // lo <= matched && matched <= hi
        let cmp_lo = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, cmp_lo, "cslew" as *u8, lo_val, matched);
        let cmp_hi = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, cmp_hi, "cslew" as *u8, matched, hi_val);
        let result = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, result, "and" as *u8, cmp_lo, cmp_hi);
        return result;
    }
    // default: 其他 → cmp = 1 (accept-all, 跟 v0 codegen.c:191-195 对齐)
    let cmp = *ir_new_tmp(ir, QBE_W());
    ir_emit_copy(ir, cmp, 1);
    return cmp;
}

// cg_expr — 主体（jhyy 用 if-else if chain 替代 C switch）
// ════════════════════════════════════════════════════

// 本 commit 覆盖：NODE_INT / NODE_BOOL / NODE_FLOAT / NODE_STRING / NODE_CHAR /
// NODE_IDENT / NODE_UNARY / NODE_RETURN。其他 case 在 commit 3/4 补全。
//
// jhyy 无 forward decl。cg_match_pattern 在本函数之后定义，cg_expr 内部对
// cg_match_pattern 的调用（commit 4 NODE_MATCH 用）由 jhyy 编译器在末尾统一
// 解析函数引用。

// irval_box — 把 5 个字段**逐字段写指针**装进 arena 分配的 IRVal,返回指针。
//
// v4.0.7 (W-097 闭环): 为什么不用 `*p = some_irval` 结构体赋值 ——
// 那个路径经 emit_copy 的 struct-by-value 传递,同样只可靠地搬部分字节,
// 在 jhyy-side codegen 下会越界写坏 arena(实测 sb_append 的 memmove SEGV)。
// 逐字段 ptr 写是本文件已有的安全模式(见 NODE_BLOCK 的 bug-16 workaround)。
fn irval_box(ir: *IRBuf, kind: i32, id: i32, ival: i64, name: *u8, qbe_type: i32) -> *IRVal {
    let p = arena_alloc((*ir).arena, IRVAL_SIZE()) as *IRVal;
    *(p as *i32) = kind;
    *(ptr_add_u8(p, 4 as i64) as *i32) = id;
    *(ptr_add_u8(p, 8 as i64) as *i64) = ival;
    *(ptr_add_u8(p, 16 as i64) as **u8) = name;
    *(ptr_add_u8(p, 24 as i64) as *i32) = qbe_type;
    return p;
}

// v4.0.7 (W-097 闭环): cg_expr 返回 arena 指针而不是 32 字节 IRVal 值 ——
// MS x64 无结构体按值返回约定,原 `-> IRVal` 从未实现 sret:ret 时 rax 里是最后
// 一个字段的值,调用方当结构体指针拷贝 → 读到垃圾 → arena__align_up 的 `~m`
// emit 成 `xor %t687,%t10`,而 %t687 全文件从未定义(悬空 temp)。
// cg_emit_raw_asm_inline — W-113 (2026-10-20):把 asm 文本**内联进函数体**。
//
// 之前:codegen 把 asm 原文写进 side-file(`_inline_asm.buf`),main.jhyy 在
// **链接前**把 side-file 拼接到 .s 的**末尾** ⇒ asm 字节落在**所有函数之外**
// ⇒ 是**死字节**,永不执行(spec supplement v3.0.1 § 6 记的「appended 到 .s 末」)。
// spec 的 § 6 roadmap 写明「要 inline 调用 asm,需要 v3.1+ 加 operand constraints
// + **placement tracking**」—— placement tracking 就是这一条。
//
// 做法:文本 **hex 编码**后作为一条 IL 指令 `dbgasm <hex>` 写进 IL ——
// 后端在**那个位置**把 hex 解回原文,直接写进 .s(在函数体内部 ✓)。
//
// 为什么 hex 而不是原样写进 IL:IL 是**按行**的文本格式,而 asm 文本可能含
// 换行 / 引号 / 反斜杠 —— hex 编码把这三个问题一次性消掉 ✓(跨平台也稳)。
fn cg_emit_raw_asm_inline(ir: *IRBuf, text: *u8) -> i32 {
let n = strlen(text);
let hex = arena_alloc((*ir).arena, n * (2 as i64) + (1 as i64));
if hex == (0 as *u8) {
    return 1 as i32;
}
let mut i: i64 = 0 as i64;
while i < n {
    let b = *(ptr_add_u8(text, i)) as i32;
    let hi = (b >> 4) & (15 as i32);
    let lo = b & (15 as i32);
    let h1 = hi + (48 as i32);
    let h2 = lo + (48 as i32);
    // 0-9 → '0'..'9';10-15 → 'a'..'f'
    let h1c: i32 = if h1 > (57 as i32) { h1 + (39 as i32) } else { h1 };
    let h2c: i32 = if h2 > (57 as i32) { h2 + (39 as i32) } else { h2 };
    let hp = ptr_add_u8(hex, i * (2 as i64)) as *u8;
    *(hp as *i32) = h1c;
    *(ptr_add_u8(hex, i * (2 as i64) + (1 as i64)) as *i32) = h2c;
    i = i + (1 as i64);
}
let nul = ptr_add_u8(hex, n * (2 as i64)) as *u8;
*(nul as *i32) = 0 as i32;
let _e = ir_emit_str(ir, "dbgasm " as *u8);
let _e2 = ir_emit_str(ir, hex);
let _e3 = ir_emit_str(ir, "\n" as *u8);
return 0 as i32;
}


fn cg_expr(cg_raw: *u8, n: *Node) -> *IRVal {
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    // Sprint 4.4 commit 2.36: zero IRVal 改 kind=IRVAL_INT (1) — 之前 kind=0=IRVAL_TEMP
    //   被 ir_emit_load / ir_emit_phi2 当 temp 发 %t0, 触发 QBE "invalid type for
    //   first operand %t0". 现在 literal 0, dispatch 走 ir_emit_arg 的 literal 分支.
    let zero = IRVal { kind: IRVAL_INT(), id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
    if n == (0 as *Node) {
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }
    let kind = (*n).kind;

    // v1.4.2: emit `dbgloc <line>` before any IR for this node, if line changed.
    //   Dedupe via last_dbg_line (cg_expr fires many times per source line —
    //   once per subexpression — but most share the same line; only the first
    //   per line produces a dbgloc). Result: roughly 1 dbgloc per source line per
    //   function. gdb reads the latest .loc for each instruction.
    if (*n).loc_line > (0 as i32) {
        let _e = cg_dbg_emit_loc(cg_raw, (*n).loc_line);
    }

    // ── NODE_INT ──
    if kind == NODE_INT() {
        let d = node_int_data(n);
        let mut qt: i32 = qbe_type_of((*n).type_ptr);
        // v4.0.2.2 (W-098 真修 — IR-builder side):如果字面量 > 32-bit signed range
        //   且当前 qt = W (i32),promote 到 L (i64) 避免 W-098 movl $imm 静默截断。
        //   触发模式:literal 0x100000001 在 i64 context 下,cg_expr NODE_INT
        //   走 default W 槽 (`movl $imm, mem`) — GAS 不 reject 但只存低 32 位。
        //   原先靠 cast binop (extsw) 救场,但 cltq 只能 sign-ext 已截断值。
        //   Fix:IR 层直接把 literal 存 L 槽,movabsq 模式 emit (per W-098 emit-side fix)。
        if qt == QBE_W() {
            if (*d).value > (2147483647 as i64) || (*d).value < ((-2147483648 as i64)) {
                qt = QBE_L();
            }
        }
        let v = *ir_new_tmp(ir, qt);
        ir_emit_copy(ir, v, (*d).value);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // v1.7.2 patch A1': NODE_SIZEOF — sema fills n->type=i64 + node_int_data(value).
    //   Emit like NODE_INT (value is the compile-time-computed size).
    //   Mirror of src/codegen.c:570-575 (src-side has it; src0-side was missing).
    //   Without this case sizeof(Type) falls through to zero IRVal (line 1214) and
    //   emits `=l copy 0`, so sizeof_basic gets total=0 instead of 4+8+1+8+8=29.
    // W-129 (2026-10-24 真修):NODE_ALIGNOF 与 NODE_SIZEOF **同形** ——
    //   sema 已经把值填进 node_int_data(value),codegen 只要照 NODE_INT 发。
    //   之前 codegen 没有 NODE_ALIGNOF 分支 ⇒ 落到默认分支返回零 IRVal ⇒
    //   alignof 求值恒为 0(编译能过,值是错的)。
    //   ⚠️ 合并成一个分支(不新开 case):cg_expr 是编译器的巨型递归函数,
    //   新开 case 会给它加局部变量 → 推高栈帧(实测 +720 B)→ 自举产物
    //   行为漂移(见 W-130)。
    if kind == NODE_SIZEOF() || kind == NODE_ALIGNOF() {
        let d = node_int_data(n);
        let v = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));
        ir_emit_copy(ir, v, (*d).value);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_NULL (v1.3.1) ──
    //   null → 0 of expected pointer width (sema fills KIND_POINTER via context).
    //   qbe_type_of 内部 NULL type 防御: 已设的 type_ptr 才走; 否则 fallback W.
    if kind == NODE_NULL() {
        let mut qt: i32 = QBE_W();
        let nt = (*n).type_ptr as *Type;
        if nt != (0 as *Type) {
            if (*nt).kind == KIND_POINTER() {
                qt = QBE_L();
            }
        }
        let v = *ir_new_tmp(ir, qt);
        ir_emit_copy(ir, v, 0);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_BOOL ──
    if kind == NODE_BOOL() {
        let d = node_bool_data(n);
        let v = *ir_new_tmp(ir, QBE_W());
        if (*d).value != (0 as i32) {
            ir_emit_copy(ir, v, 1);
        } else {
            ir_emit_copy(ir, v, 0);
        }
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_FLOAT ──
    // 注意：f64 数值字面量 emit "    %tD =d copy d_3.14\n"，jhyy 走
    // StringBuilder 拼（避开嵌套 struct LEA bug）。
    if kind == NODE_FLOAT() {
        let d = node_float_data(n);
        let val = (*d).value;
        let mut qt: i32 = QBE_D();  /* default: f64 */
        let mut qt_prefix: *u8 = "d_" as *u8;

        /* Check type for f32 vs f64 */
        if (*n).type_ptr != (0 as *u8) {
            let nt = (*n).type_ptr as *Type;
            if (*nt).kind == KIND_PRIMITIVE() && (*nt).prim == PRIM_F32() {
                qt = QBE_S();
                qt_prefix = "s_" as *u8;
            }
        }

        // Format the value for QBE. d_nan / d_+inf / d_-inf / d_X.XX
        let mut buf: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
        sb_init((*ir).arena, &buf);
        sb_append_cstr((*ir).arena, &buf, qt_prefix);

        /* IEEE 754 special values */
        if val != val {
            /* NaN */
            sb_append_cstr((*ir).arena, &buf, "nan" as *u8);
        } else {
            /* 调 jh_sprintf_f64/f32 C helper（sprint 5 commit 4 加）把 f64 字面量
             * 格式化到 StringBuilder buf。jhyy 不能 sprintf f64（QBE Windows amd64
             * backend SSE return 未验证），走 C 端 sprintf。 */
            let fmt_buf_u8 = arena_alloc((*ir).arena, 64 as i64);
            if qt == QBE_S() {
                jh_sprintf_f32(fmt_buf_u8, val);
            } else {
                jh_sprintf_f64(fmt_buf_u8, val);
            }
            sb_append_cstr((*ir).arena, &buf, fmt_buf_u8);
        }
        let v = *ir_new_tmp(ir, qt);
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, v.id);
        ir_emit_str(ir, " =" as *u8);
        ir_emit_int(ir, "%c" as *u8, qt);
        ir_emit_str(ir, " copy " as *u8);
        let fmt_str = sb_cstr((*ir).arena, &buf);
        ir_emit_str(ir, fmt_str);
        ir_emit_str(ir, "\n" as *u8);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_STRING ──
    if kind == NODE_STRING() {
        let d = node_string_data(n);
        let str_val = ir_new_data_str(ir, (*d).chars, (*d).len);
        let v = *ir_new_tmp(ir, QBE_L());
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, v.id);
        ir_emit_str(ir, " =l copy " as *u8);
        ir_emit_str(ir, str_val.name);
        ir_emit_str(ir, "\n" as *u8);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_CHAR ──
    if kind == NODE_CHAR() {
        let d = node_char_data(n);
        let v = *ir_new_tmp(ir, QBE_W());
        /* v1.7.0 Stage 3: drop & 255 mask — ch is now full BMP codepoint
           (i32 in AST, fits 2-byte BMP U+0080..U+07FF + ASCII). */
        let ch = (*d).ch as i64;
        ir_emit_copy(ir, v, ch);
        return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
    }

    // ── NODE_IDENT ──
    if kind == NODE_IDENT() {
        let d = node_ident_data(n);
        /* v0.7 7B: const array reference — emit `copy $name` */
        let sym = (*d).sym;
        if sym != (0 as *u8) {
            let s = sym as *Sym;
            if (*s).kind == SYM_CONST() {
                let v = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, v.id);
                ir_emit_str(ir, " =l copy $" as *u8);
                ir_emit_str(ir, (*s).name);
                ir_emit_str(ir, "\n" as *u8);
                return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
            }
        }
        let is_stack = cg_find_local_is_stack(cg_raw, sym);
        // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
        // v0 codegen bug workaround: 不要在 caller 栈上 declare IRVal 然后 cast
        //   `(loc_buf as *u8)` 取地址 — jhyy codegen 对 IRVal struct value 做
        //   as-pointer 时会 emit 错的 loadw/loadl 链。改在 arena 里 alloc 一个
        //   已知 buffer，把 sym IRVal 写进去再 field-level read。
        let loc_buf_u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
        cg_find_local(cg_raw, sym, loc_buf_u8);
        let loc_kind_p = loc_buf_u8 as *i32;
        let loc_id_p = ptr_add_u8(loc_buf_u8, 4 as i64) as *i32;
        let loc_ival_p = ptr_add_u8(loc_buf_u8, 8 as i64) as *i64;
        let loc_name_p = ptr_add_u8(loc_buf_u8, 16 as i64) as **u8;
        let loc_qt_p = ptr_add_u8(loc_buf_u8, 24 as i64) as *i32;
        let loc = IRVal {
            kind: *loc_kind_p,
            id: *loc_id_p,
            ival: *loc_ival_p,
            name: *loc_name_p,
            qbe_type: *loc_qt_p,
        };
        if is_stack != (0 as i32) {
            /* structs/arrays/slices always manipulated via address */
            if (*n).type_ptr != (0 as *u8) {
                let nt = (*n).type_ptr as *Type;
                if (*nt).kind == KIND_STRUCT() || (*nt).kind == KIND_ARRAY() || (*nt).kind == KIND_SLICE() {
                    return irval_box(ir, (loc).kind, (loc).id, (loc).ival, (loc).name, (loc).qbe_type);
                }
                // W-114:enum 同理 —— 局部变量槽里放的是 image,enum 表达式
                // 求值为「指向 image 的地址」→ 直接给地址,不 load。
                // (load 出来的是 4 字节 image → tag 对、payload 丢)
                if (*nt).kind == KIND_ENUM() {
                    return irval_box(ir, (loc).kind, (loc).id, (loc).ival, (loc).name, (loc).qbe_type);
                }
            }
            /* load from stack */
            let v = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));
            cg_emit_load(cg_raw, v, (*n).type_ptr, loc);
            return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
        }
        /* v1.4.6 W-017: module-level global (IRVAL_STR addr) — load via
           cg_emit_load which dispatches on addr.kind (loadw $g_x). */
        if *loc_kind_p == IRVAL_STR() {
            let v = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));
            cg_emit_load(cg_raw, v, (*n).type_ptr, loc);
            return irval_box(ir, (v).kind, (v).id, (v).ival, (v).name, (v).qbe_type);
        }
        return irval_box(ir, (loc).kind, (loc).id, (loc).ival, (loc).name, (loc).qbe_type);  /* SSA value */
    }

    // ── NODE_UNARY ──
    if kind == NODE_UNARY() {
        let d = node_unary_data(n);
        let inner = *cg_expr(cg_raw, (*d).expr);
        let op = (*d).op;
        if op == TOKEN_MINUS() {
            /* -expr → 0 - expr */
            let result = *ir_new_tmp(ir, inner.qbe_type);
            let zero_v = *ir_new_tmp(ir, inner.qbe_type);
            ir_emit_copy(ir, zero_v, 0);
            ir_emit_binary(ir, result, "sub" as *u8, zero_v, inner);
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }
        if op == TOKEN_BANG() {
            /* !expr → ceqw(expr, 0) */
            let result = *ir_new_tmp(ir, QBE_W());
            let mut qt: i32 = inner.qbe_type;
            if qt == (0 as i32) {
                qt = QBE_W();
            }
            let zero_v = *ir_new_tmp(ir, qt);
            ir_emit_copy(ir, zero_v, 0);
            ir_emit_binary(ir, result, "ceqw" as *u8, inner, zero_v);
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }
        if op == TOKEN_TILDE() {
            /* ~expr → xor(expr, -1) */
            let result = *ir_new_tmp(ir, inner.qbe_type);
            let neg_one = *ir_new_tmp(ir, inner.qbe_type);
            ir_emit_copy(ir, neg_one, -1);
            ir_emit_binary(ir, result, "xor" as *u8, inner, neg_one);
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }
        return irval_box(ir, (inner).kind, (inner).id, (inner).ival, (inner).name, (inner).qbe_type);  /* default: no-op */
    }

    // ── NODE_RETURN（stmt-position + expr-position 都走这里，cg_stmt 已 merge 到 cg_expr）──
    if kind == NODE_RETURN() {
        let d = node_return_data(n);
        if (*d).expr != (0 as *Node) {
            if (*cg).has_sret != 0 {
                // Sprint 4.25 W-005 #2 真修: sret struct return path.
                //   cg_expr(expr) returns value; copy to sret slot via cg_copy_agg
                //   (guarded against sentinel src); then bare `ret`.
                //   Mirror of compiler/src/codegen.c NODE_RETURN sret branch.
                let src = *cg_expr(cg_raw, (*d).expr);
                let sret_addr = IRVal { kind: 0, id: (*cg).sret_slot_id as i32, ival: 0 as i64, name: 0 as *u8, qbe_type: QBE_L() };
                if irval_is_undef(src) == 0 {
                    // W-114:enum 的 sret 拷的是**内存映像**,不是地址
                    // (地址指向 callee 自己的帧 → 返回即悬垂)。
                    let mut _is_enum_ret: i32 = 0;
                    if (*cg).current_ret_type != (0 as *u8) {
                        let crt = (*cg).current_ret_type as *Type;
                        if (*crt).kind == KIND_ENUM() { _is_enum_ret = 1 as i32; }
                    }
                    if _is_enum_ret != (0 as i32) {
                        let _ce = cg_copy_enum(cg_raw, (*cg).current_ret_type, sret_addr, src);
                    } else {
                        let _copy = cg_copy_agg(cg_raw, (*cg).current_ret_type, sret_addr, src);
                    }
                }
                // v1.3.6: emit LIFO defers before `ret` (sret path)
                //   (inline — jhyy 无 forward decl → 不能抽成 helper call from cg_expr)
                let fd_a = (*cg).current_fn;
                if fd_a != (0 as *u8) {
                    let fd_a_d = fd_a as *NodeFuncDecl;
                    let nd_a = (*fd_a_d).ndefers;
                    let dr_a = (*fd_a_d).defers;
                    if nd_a > (0 as i64) && dr_a != (0 as *u8) {
                        let mut ia: i64 = nd_a;
                        while ia > (0 as i64) {
                            // v4.0.2.5 (W-097 hoist): atomic step decomposition
                            let ia_minus: i64 = ia - (1 as i64);
                            let dsa = ptr_add_u8(dr_a, ia_minus * (8 as i64)) as **Node;
                            let dna = *dsa;
                            if dna != (0 as *Node) {
                                let dd_a = node_defer_data(dna);
                                let er_a = (*dd_a).expr;
                                if er_a != (0 as *u8) {
                                    let _ca = *cg_expr(cg_raw, er_a as *Node);
                                }
                            }
                            ia = ia - (1 as i64);
                        }
                    }
                }
                let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
                // v2.1.0 Stage 1c.3: abi_win_emit_return centralises the
                // `ret` line decision. sret branch → empty ret.
                // W-070 v2.8.2: dispatch Win vs SysV.
                let mut _ret: i32 = 0 as i32;
                if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                    _ret = abi_sysv_emit_return(ir, v, 1);
                } else {
                    _ret = abi_win_emit_return(ir, v, 1);
                }
            } else {
                let val = *cg_expr(cg_raw, (*d).expr);
                // v1.3.6: emit LIFO defers before `ret` (value path)
                let fd_b = (*cg).current_fn;
                if fd_b != (0 as *u8) {
                    let fd_b_d = fd_b as *NodeFuncDecl;
                    let nd_b = (*fd_b_d).ndefers;
                    let dr_b = (*fd_b_d).defers;
                    if nd_b > (0 as i64) && dr_b != (0 as *u8) {
                        let mut ib: i64 = nd_b;
                        while ib > (0 as i64) {
                            // v4.0.2.5 (W-097 hoist): atomic step decomposition
                            let ib_minus: i64 = ib - (1 as i64);
                            let dsb = ptr_add_u8(dr_b, ib_minus * (8 as i64)) as **Node;
                            let dnb = *dsb;
                            if dnb != (0 as *Node) {
                                let dd_b = node_defer_data(dnb);
                                let er_b = (*dd_b).expr;
                                if er_b != (0 as *u8) {
                                    let _cb = *cg_expr(cg_raw, er_b as *Node);
                                }
                            }
                            ib = ib - (1 as i64);
                        }
                    }
                }
                let mut _ret_v: i32 = 0 as i32;
                if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                    _ret_v = abi_sysv_emit_return(ir, val, 0);
                } else {
                    _ret_v = abi_win_emit_return(ir, val, 0);
                }
            }
        } else {
            if (*cg).has_sret != 0 {
                // sret void return (rare): bare `ret\n`
                // v1.3.6: emit LIFO defers before bare `ret` (sret void path)
                let fd_c = (*cg).current_fn;
                if fd_c != (0 as *u8) {
                    let fd_c_d = fd_c as *NodeFuncDecl;
                    let nd_c = (*fd_c_d).ndefers;
                    let dr_c = (*fd_c_d).defers;
                    if nd_c > (0 as i64) && dr_c != (0 as *u8) {
                        let mut ic: i64 = nd_c;
                        while ic > (0 as i64) {
                            // v4.0.2.5 (W-097 hoist): atomic step decomposition
                            let ic_minus: i64 = ic - (1 as i64);
                            let dsc = ptr_add_u8(dr_c, ic_minus * (8 as i64)) as **Node;
                            let dnc = *dsc;
                            if dnc != (0 as *Node) {
                                let dd_c = node_defer_data(dnc);
                                let er_c = (*dd_c).expr;
                                if er_c != (0 as *u8) {
                                    let _cc = *cg_expr(cg_raw, er_c as *Node);
                                }
                            }
                            ic = ic - (1 as i64);
                        }
                    }
                }
                let mut _str_ret: i32 = 0 as i32;
                if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                    _str_ret = abi_sysv_emit_return(ir, IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 }, 1);
                } else {
                    _str_ret = abi_win_emit_return(ir, IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 }, 1);
                }
            } else {
                // v1.3.6: emit LIFO defers before `ret` (void path)
                let fd_d = (*cg).current_fn;
                if fd_d != (0 as *u8) {
                    let fd_d_d = fd_d as *NodeFuncDecl;
                    let nd_d = (*fd_d_d).ndefers;
                    let dr_d = (*fd_d_d).defers;
                    if nd_d > (0 as i64) && dr_d != (0 as *u8) {
                        let mut id_: i64 = nd_d;
                        while id_ > (0 as i64) {
                            // v4.0.2.5 (W-097 hoist): atomic step decomposition
                            let id_minus: i64 = id_ - (1 as i64);
                            let dsd = ptr_add_u8(dr_d, id_minus * (8 as i64)) as **Node;
                            let dnd = *dsd;
                            if dnd != (0 as *Node) {
                                let dd_d = node_defer_data(dnd);
                                let er_d = (*dd_d).expr;
                                if er_d != (0 as *u8) {
                                    let _cd = *cg_expr(cg_raw, er_d as *Node);
                                }
                            }
                            id_ = id_ - (1 as i64);
                        }
                    }
                }
                let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
                // v2.1.0 Stage 1c.3: abi_win_emit_return — void (val undef → empty).
                // W-070 v2.8.2: dispatch Win vs SysV.
                let mut _ret_v2: i32 = 0 as i32;
                if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                    _ret_v2 = abi_sysv_emit_return(ir, v, 0);
                } else {
                    _ret_v2 = abi_win_emit_return(ir, v, 0);
                }
            }
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // NOTE: sret void function return fix is handled via IL post-processing
    // (fix_il.py in cmd_compile) — cg_func can't fix NODE_RETURN emit here
    // because cg_copy_agg inside cg_expr triggers v0 codegen SIGSEGV.

    // ── NODE_BLOCK（expr-position: block 最后一个 expr 的值）──
    // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
    // v0 codegen bug 16 workaround: `last = cg_expr(...)` 把 40 字节 IRVal
    // 按值赋给 mutable local，在 second-function + 嵌套 expr 时触发 v0 jhyy
    // codegen stack buffer 错位 → rc=127。改走 arena_alloc + field-level
    // read-back（arena 不释放，重建 IRVal 通过 deref 5 字段完成）。
    if kind == NODE_BLOCK() {
        let d = node_block_data(n);
        let last_buf = arena_alloc((*ir).arena, IRVAL_SIZE());
        *(last_buf as *i32) = 0;
        *(ptr_add_u8(last_buf, 4 as i64) as *i32) = 0;
        *(ptr_add_u8(last_buf, 8 as i64) as *i64) = 0 as i64;
        *(ptr_add_u8(last_buf, 16 as i64) as **u8) = 0 as *u8;
        *(ptr_add_u8(last_buf, 24 as i64) as *i32) = 0;
        let mut i: i64 = 0 as i64;
        while i < (*d).nstmts {
            let stmt_slot = ptr_add_u8((*d).stmts, i * (8 as i64)) as **Node;
            let stmt = *stmt_slot as *Node;
            if (*stmt).kind == NODE_RETURN() || (*stmt).kind == NODE_BREAK() || (*stmt).kind == NODE_CONTINUE() {
                let _expr = *cg_expr(cg_raw, stmt);
                let last = IRVal {
                    kind: *(last_buf as *i32),
                    id: *(ptr_add_u8(last_buf, 4 as i64) as *i32),
                    ival: *(ptr_add_u8(last_buf, 8 as i64) as *i64),
                    name: *(ptr_add_u8(last_buf, 16 as i64) as **u8),
                    qbe_type: *(ptr_add_u8(last_buf, 24 as i64) as *i32),
                };
                return irval_box(ir, (last).kind, (last).id, (last).ival, (last).name, (last).qbe_type);
            }
            if (*stmt).kind == NODE_EXPR_STMT() {
                let es = node_expr_stmt_data(stmt);
                let inner_node = (*es).expr as *Node;
                if (*inner_node).kind == NODE_ASSIGN() {
                    let _expr = *cg_expr(cg_raw, stmt);
                } else {
                    let r = *cg_expr(cg_raw, inner_node);
                    *(last_buf as *i32) = r.kind;
                    *(ptr_add_u8(last_buf, 4 as i64) as *i32) = r.id;
                    *(ptr_add_u8(last_buf, 8 as i64) as *i64) = r.ival;
                    *(ptr_add_u8(last_buf, 16 as i64) as **u8) = r.name;
                    *(ptr_add_u8(last_buf, 24 as i64) as *i32) = r.qbe_type;
                }
            } else if (*stmt).kind == NODE_IF() || (*stmt).kind == NODE_MATCH() {
                let r = *cg_expr(cg_raw, stmt);
                *(last_buf as *i32) = r.kind;
                *(ptr_add_u8(last_buf, 4 as i64) as *i32) = r.id;
                *(ptr_add_u8(last_buf, 8 as i64) as *i64) = r.ival;
                *(ptr_add_u8(last_buf, 16 as i64) as **u8) = r.name;
                *(ptr_add_u8(last_buf, 24 as i64) as *i32) = r.qbe_type;
            } else if (*stmt).kind == NODE_BLOCK() {
                let r = *cg_expr(cg_raw, stmt);
                *(last_buf as *i32) = r.kind;
                *(ptr_add_u8(last_buf, 4 as i64) as *i32) = r.id;
                *(ptr_add_u8(last_buf, 8 as i64) as *i64) = r.ival;
                *(ptr_add_u8(last_buf, 16 as i64) as **u8) = r.name;
                *(ptr_add_u8(last_buf, 24 as i64) as *i32) = r.qbe_type;
            } else {
                let _expr = *cg_expr(cg_raw, stmt);
            }
            i = i + (1 as i64);
        }
        let last = IRVal {
            kind: *(last_buf as *i32),
            id: *(ptr_add_u8(last_buf, 4 as i64) as *i32),
            ival: *(ptr_add_u8(last_buf, 8 as i64) as *i64),
            name: *(ptr_add_u8(last_buf, 16 as i64) as **u8),
            qbe_type: *(ptr_add_u8(last_buf, 24 as i64) as *i32),
        };
        return irval_box(ir, (last).kind, (last).id, (last).ival, (last).name, (last).qbe_type);
    }

    // ── NODE_LET （stmt position: alloc + (optional) store + register local）──
    if kind == NODE_LET() {
        let d = node_let_data(n);
        let mut is_array: i32 = 0;
        let mut is_struct: i32 = 0;
        if (*d).sym != (0 as *u8) {
            let sym_lt = (*d).sym as *Sym;
            if (*sym_lt).type_ptr != (0 as *u8) {
                let st_lt = (*sym_lt).type_ptr as *Type;
                if (*st_lt).kind == KIND_ARRAY() { is_array = 1; }
                if (*st_lt).kind == KIND_STRUCT() { is_struct = 1; }
            }
        }

        let init_node = ((*d).init) as *Node;
        if (*d).is_mutable != 0 || is_array != 0 || is_struct != 0 {
            // mutable / array / struct: alloc stack slot
            let init_v = *cg_expr(cg_raw, init_node);
            let init_kind = (*init_node).kind;
            if init_kind == NODE_ARRAY_LIT() || init_kind == NODE_STRUCT_LIT() {
                cg_add_local(cg_raw, (*d).sym, init_v, 1);
            } else if is_struct != 0 {
                let sym_t = ((*d).sym as *Sym).type_ptr;
                let sz = type_size(sym_t as *Type) as i32;
                let mut sz2 = sz;
                if sz2 < 4 { sz2 = 4; }
                let slot = *ir_new_tmp(ir, QBE_L());
                ir_emit_alloc(ir, slot, sz2);
                cg_copy_agg(cg_raw, sym_t, slot, init_v);
                cg_add_local(cg_raw, (*d).sym, slot, 1);
            } else {
                let sym_t = ((*d).sym as *Sym).type_ptr;
                let sz = type_size(sym_t as *Type) as i32;
                let mut sz2 = sz;
                if sz2 < 4 { sz2 = 4; }
                let slot = *ir_new_tmp(ir, QBE_L());
                ir_emit_alloc(ir, slot, sz2);
                let _st0 = cg_store_enum_image(cg_raw, sym_t, init_v, slot);
                cg_add_local(cg_raw, (*d).sym, slot, 1);
            }
        } else {
            // immutable 标量：keep as SSA
            // 重新算 init_v（C 端 codegen.c 这里重算一份；jhyy 的 if/else 是
            // 兄弟 block，init_v 在 else 里不可见，必须重 declare 才能拿到正确 SSA）
            let init_v = *cg_expr(cg_raw, init_node);
            cg_add_local(cg_raw, (*d).sym, init_v, 0);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_ASSIGN （stmt position）──
    if kind == NODE_ASSIGN() {
        let d = node_assign_data(n);
        let val = *cg_expr(cg_raw, ((*d).value) as *Node);
        let target = ((*d).target) as *Node;
        let target_kind = (*target).kind;

        if target_kind == NODE_DEREF() {
            let dd = node_deref_data(target);
            let ptr = *cg_expr(cg_raw, (*dd).expr);
            let _store = cg_store_enum_image(cg_raw, (*target).type_ptr, val, ptr);
        } else if target_kind == NODE_IDENT() {
            let id = node_ident_data(target);
            let is_stack = cg_find_local_is_stack(cg_raw, (*id).sym);
            // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
            // v0 codegen bug 16 workaround (W-005): 不要 `let slot_buf = IRVal {...}` 然后
            // `slot_buf as *u8` —— v0 codegen 把 IRVal literal 当 32-bit alloc,然后
            // (slot_buf as *u8) 走 extsw 截断指针 → cg_find_local 收截断的 out_buf,
            // 写野指针 → segfault。改走 arena_alloc(IRVAL_SIZE()) 拿 40 字节
            // 的 heap buffer + field-level 读出 IRVal local。
            let slot_buf_u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
            let _found2 = cg_find_local(cg_raw, (*id).sym, slot_buf_u8);
            let slot = IRVal {
                kind:     *(slot_buf_u8 as *i32),
                id:       *(ptr_add_u8(slot_buf_u8, 4 as i64) as *i32),
                ival:     *(ptr_add_u8(slot_buf_u8, 8 as i64) as *i64),
                name:     *(ptr_add_u8(slot_buf_u8, 16 as i64) as **u8),
                qbe_type: *(ptr_add_u8(slot_buf_u8, 24 as i64) as *i32),
            };
            if is_stack != 0 {
                let tgt_t = (*target).type_ptr;
                if tgt_t != (0 as *u8) {
                    let tt = tgt_t as *Type;
                    if (*tt).kind == KIND_STRUCT() {
                        let _copy = cg_copy_agg(cg_raw, tgt_t, slot, val);
                    } else {
                        let _store = cg_store_enum_image(cg_raw, tgt_t, val, slot);
                    }
                }
            }
            /* v1.4.6 W-017: module-level global — slot.kind = IRVAL_STR,
               cg_emit_store dispatch on addr.kind (storew %val, $g_x). */
            else if *(slot_buf_u8 as *i32) == IRVAL_STR() {
                let tgt_t2 = (*target).type_ptr;
                let _store2 = cg_store_enum_image(cg_raw, tgt_t2, val, slot);
            }
        } else if target_kind == NODE_INDEX() {
            // arr[i] = value
            let idx = node_index_data(target);
            let idx_expr_node = ((*idx).expr) as *Node;
            let idx_index_node = ((*idx).index) as *Node;
            let arr_type = (*idx_expr_node).type_ptr;
            if arr_type != (0 as *u8) {
                let at = arr_type as *Type;
                if (*at).kind == KIND_ARRAY() || (*at).kind == KIND_POINTER() {
                    let is_array = ((*at).kind == KIND_ARRAY());
                    let elem_type = (*at).elem;
                    let elem_sz = type_size(elem_type as *Type);

                    // 路径 1: 数组 + IDENT 标识符 → 直接用 stack slot
                    if is_array != 0 && (*idx_expr_node).kind == NODE_IDENT() {
                        let id = node_ident_data(idx_expr_node);
                        // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
                        // v0 codegen bug 16 workaround (W-005): 同 NODE_ASSIGN — arena_alloc + field-level read
                        let real_base_buf_u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
                        let _found3 = cg_find_local(cg_raw, (*id).sym, real_base_buf_u8);
                        let real_base = IRVal {
                            kind:     *(real_base_buf_u8 as *i32),
                            id:       *(ptr_add_u8(real_base_buf_u8, 4 as i64) as *i32),
                            ival:     *(ptr_add_u8(real_base_buf_u8, 8 as i64) as *i64),
                            name:     *(ptr_add_u8(real_base_buf_u8, 16 as i64) as **u8),
                            qbe_type: *(ptr_add_u8(real_base_buf_u8, 24 as i64) as *i32),
                        };
                        let idx_val = *cg_expr(cg_raw, idx_index_node);
                        let offset2 = *ir_new_tmp(ir, QBE_L());
                        let idx_index_kind = (*idx_index_node).kind;
                        if idx_index_kind == NODE_INT() {
                            let nd2 = node_int_data(idx_index_node);
                            let const_off2 = (*nd2).value * (elem_sz as i64);
                            ir_emit_copy(ir, offset2, const_off2);
                        } else {
                            ir_emit_binary(ir, offset2, "mul" as *u8, idx_val, ir_new_int(elem_sz));
                        }
                        let final_addr = *ir_new_tmp(ir, QBE_L());
                        ir_emit_binary(ir, final_addr, "add" as *u8, real_base, offset2);
                        let _store = cg_store_enum_image(cg_raw, elem_type, val, final_addr);
                    } else {
                        // 路径 2: 通用 → base from expr + offset
                        let base = *cg_expr(cg_raw, idx_expr_node);
                        let idx_val2 = *cg_expr(cg_raw, idx_index_node);

                        // offset = index * elem_sz
                        let offset = *ir_new_tmp(ir, QBE_L());
                        let idx_v2_kind = (*idx_index_node).kind;
                        if idx_v2_kind == NODE_INT() {
                            let nd = node_int_data(idx_index_node);
                            let const_off = (*nd).value * (elem_sz as i64);
                            ir_emit_copy(ir, offset, const_off);
                        } else {
                            if idx_val2.qbe_type == QBE_L() {
                                ir_emit_binary(ir, offset, "mul" as *u8, idx_val2, ir_new_int(elem_sz));
                            } else {
                                let idx64 = *ir_new_tmp(ir, QBE_L());
                                ir_emit_str(ir, "    %t" as *u8);
                                ir_emit_int(ir, "%d" as *u8, idx64.id);
                                ir_emit_str(ir, " =l extsw %t" as *u8);
                                ir_emit_int(ir, "%d" as *u8, idx_val2.id);
                                ir_emit_str(ir, "\n" as *u8);
                                ir_emit_binary(ir, offset, "mul" as *u8, idx64, ir_new_int(elem_sz));
                            }
                        }

                        // addr = base + offset
                        let addr = *ir_new_tmp(ir, QBE_L());
                        ir_emit_binary(ir, addr, "add" as *u8, base, offset);
                        let _store = cg_store_enum_image(cg_raw, elem_type, val, addr);
                    }
                }
            }
        } else if target_kind == NODE_FIELD() {
            // (*ptr).field = value
            let df = node_field_data(target);
            let df_expr_node = ((*df).expr) as *Node;
            let expr_t = (*df_expr_node).type_ptr;
            let mut struct_type_raw: *u8 = 0 as *u8;
            if expr_t != (0 as *u8) {
                let et = expr_t as *Type;
                if (*et).kind == KIND_POINTER() && (*et).elem != (0 as *u8) {
                    let inner_t = (*et).elem as *Type;
                    if (*inner_t).kind == KIND_STRUCT() {
                        struct_type_raw = (*et).elem;
                    }
                } else if (*et).kind == KIND_STRUCT() {
                    struct_type_raw = expr_t;
                }
            }
            if struct_type_raw != (0 as *u8) {
                let base = *cg_expr(cg_raw, df_expr_node);
                // find field offset via cg_find_field_offset
                let foff_buf = arena_alloc((*ir).arena, 16 as i64);
                cg_find_field_offset(struct_type_raw, (*df).field, foff_buf);
                let offset: i64 = *(foff_buf as *i64);
                let field_type_raw: *u8 = *(ptr_add_u8(foff_buf, 8 as i64) as **u8);
                let mut addr = base;
                if offset > (0 as i64) {
                    addr = *ir_new_tmp(ir, QBE_L());
                    ir_emit_binary(ir, addr, "add" as *u8, base, ir_new_int(offset));
                }
                // W-114:enum 字段存的是 image,不是地址
                let mut _af_is_enum: i32 = 0;
                if field_type_raw != (0 as *u8) {
                    let aft = field_type_raw as *Type;
                    if (*aft).kind == KIND_ENUM() { _af_is_enum = 1 as i32; }
                }
                if _af_is_enum != (0 as i32) {
                    let _ce = cg_copy_enum(cg_raw, field_type_raw, addr, val);
                } else {
                    let _store = cg_emit_store(cg_raw, field_type_raw, val, addr);
                }
            }
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_BREAK ──
    if kind == NODE_BREAK() {
        if (*cg).loop_depth > 0 {
            let ends_ptr = (*cg).loop_ends as *IRVal;
            let end_label = *(ptr_add_u8(ends_ptr as *u8, (((*cg).loop_depth - (1 as i32)) as i64) * (40 as i64)) as *IRVal);
            let _jmp = ir_emit_jmp(ir, end_label);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_CONTINUE ──
    if kind == NODE_CONTINUE() {
        if (*cg).loop_depth > 0 {
            let conts_ptr = (*cg).loop_continues as *IRVal;
            let cont_label = *(ptr_add_u8(conts_ptr as *u8, (((*cg).loop_depth - (1 as i32)) as i64) * (40 as i64)) as *IRVal);
            let _jmp = ir_emit_jmp(ir, cont_label);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_EXPR_STMT（stmt position）──
    if kind == NODE_EXPR_STMT() {
        let inner = node_expr_stmt_data(n);
        let inner_node = (*inner).expr as *Node;
        if (*inner_node).kind == NODE_ASSIGN() {
            let _expr = *cg_expr(cg_raw, inner_node);
        } else {
            let _expr = *cg_expr(cg_raw, inner_node);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_BINARY ──
    if kind == NODE_BINARY() {
        let d = node_binary_data(n);
        let left_node = ((*d).left) as *Node;
        let right_node = ((*d).right) as *Node;
        let left = *cg_expr(cg_raw, left_node);

        // short-circuit && 和 ||
        //
        // [历史] v0 codegen bug 2 的 workaround:「避免 &&/|| 嵌套 short-circuit」
        //   —— 当时 nested phi predecessor 会 mismatch,故一律改成 nested if-else。
        //   **该约束已退役**(W-169):v4.x 的 in-mem 后端对嵌套短路是正确的 ——
        //   右侧只在 `sc_eval` 块求值(见下面)。门是
        //   compiler/tests/examples/logical_nested.jhyy(带调用计数器,验 7 种嵌套形状
        //   + 左到右求值顺序)。
        //   - alloc result slot at outer scope
        //   - each branch stores its value to slot, jmps merge
        //   - merge loads from slot (no phi needed)
        let d_op = (*d).op;
        if d_op == TOKEN_AMPAMP() || d_op == TOKEN_PIPEPIPE() {
            let result = *ir_new_tmp(ir, QBE_W());
            let result_slot = *ir_new_tmp(ir, QBE_L());
            ir_emit_alloc(ir, result_slot, 4 as i32);
            let eval_b = *ir_new_block(ir, "sc_eval" as *u8);
            let merge_b = *ir_new_block(ir, "sc_merge" as *u8);

            if d_op == TOKEN_AMPAMP() {
                let false_block = *ir_new_block(ir, "sc_false" as *u8);
                ir_emit_jnz(ir, left, eval_b, false_block);
                ir_emit_label(ir, false_block);
                let zero_v = *ir_new_tmp(ir, QBE_W());
                ir_emit_copy(ir, zero_v, 0);
                let _s1 = cg_emit_store_primitive(cg_raw, 0 as *u8, zero_v, result_slot);
                ir_emit_jmp(ir, merge_b);
                ir_emit_label(ir, eval_b);
                let right_and = *cg_expr(cg_raw, right_node);
                let rb_and = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, rb_and, "cnew" as *u8, right_and, ir_new_int(0));
                let _s2 = cg_emit_store_primitive(cg_raw, 0 as *u8, rb_and, result_slot);
                ir_emit_jmp(ir, merge_b);
                ir_emit_label(ir, merge_b);
                cg_emit_load(cg_raw, result, 0 as *u8, result_slot);  // v0.8 commit 5: ir_emit_load→cg_emit_load
            } else {
                let true_block = *ir_new_block(ir, "sc_true" as *u8);
                ir_emit_jnz(ir, left, true_block, eval_b);
                ir_emit_label(ir, true_block);
                let one_v = *ir_new_tmp(ir, QBE_W());
                ir_emit_copy(ir, one_v, 1);
                let _s3 = cg_emit_store_primitive(cg_raw, 0 as *u8, one_v, result_slot);
                ir_emit_jmp(ir, merge_b);
                ir_emit_label(ir, eval_b);
                let right_or = *cg_expr(cg_raw, right_node);
                let rb_or = *ir_new_tmp(ir, QBE_W());
                ir_emit_binary(ir, rb_or, "cnew" as *u8, right_or, ir_new_int(0));
                let _s4 = cg_emit_store_primitive(cg_raw, 0 as *u8, rb_or, result_slot);
                ir_emit_jmp(ir, merge_b);
                ir_emit_label(ir, merge_b);
                cg_emit_load(cg_raw, result, 0 as *u8, result_slot);  // v0.8 commit 5: ir_emit_load→cg_emit_load
            }
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }

        // 非短路：eager eval right
        let right = *cg_expr(cg_raw, right_node);

        // v1.7.0 Stage 2: pointer arithmetic (spec §9.5).
        //   - *T + int / *T - int → *T (offset = int * sizeof(elem))
        //   - int + *T → *T (symmetric)
        //   - *T - *T → i64 (diff in elements = (left - right) / sizeof(elem))
        // Mirror of C-side codegen.c NODE_BINARY pointer arith dispatch.
        // NOTE: 避免 if-expression 含 let block (jhyy parser 限制); 改用 statement-level
        // 单 branch if + 默认值 (跟 C 端 if/else void 语义对齐 — 两 branch 末同 type)。
        if d_op == TOKEN_PLUS() || d_op == TOKEN_MINUS() {
            let left_t_raw = (*left_node).type_ptr;
            let right_t_raw = (*right_node).type_ptr;
            let mut left_is_ptr: i32 = 0;
            let mut right_is_ptr: i32 = 0;
            if left_t_raw != (0 as *u8) {
                let lt = left_t_raw as *Type;
                if (*lt).kind == KIND_POINTER() { left_is_ptr = 1; }
            }
            if right_t_raw != (0 as *u8) {
                let rt = right_t_raw as *Type;
                if (*rt).kind == KIND_POINTER() { right_is_ptr = 1; }
            }

            // *T +/- int → *T
            if left_is_ptr == 1 && right_is_ptr == 0 {
                let elem_t = (*(left_t_raw as *Type)).elem;
                let elem_sz = type_size(elem_t as *Type);
                let byte_off = *ir_new_tmp(ir, QBE_L());
                if (*right_node).kind == NODE_INT() {
                    let nd_r = node_int_data(right_node);
                    let const_off = (*nd_r).value * elem_sz;
                    ir_emit_copy(ir, byte_off, const_off);
                } else {
                    // 单 branch if + 默认 r64 = right (no new tmp alloc if already l)
                    let mut r64: IRVal = right;
                    if right.qbe_type != QBE_L() {
                        r64 = *ir_new_tmp(ir, QBE_L());
                        ir_emit_str(ir, "    %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, r64.id);
                        ir_emit_str(ir, " =l extsw %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, right.id);
                        ir_emit_str(ir, "\n" as *u8);
                    }
                    let es = *ir_new_tmp(ir, QBE_L());
                    ir_emit_copy(ir, es, elem_sz);
                    ir_emit_binary(ir, byte_off, "mul" as *u8, r64, es);
                }
                let result_ptr = *ir_new_tmp(ir, QBE_L());
                let op_name: *u8 = if d_op == TOKEN_PLUS() { "add" as *u8 } else { "sub" as *u8 };
                ir_emit_binary(ir, result_ptr, op_name, left, byte_off);
                return irval_box(ir, (result_ptr).kind, (result_ptr).id, (result_ptr).ival, (result_ptr).name, (result_ptr).qbe_type);
            }

            // int + *T → *T (symmetric)
            if left_is_ptr == 0 && right_is_ptr == 1 && d_op == TOKEN_PLUS() {
                let elem_t = (*(right_t_raw as *Type)).elem;
                let elem_sz = type_size(elem_t as *Type);
                let byte_off = *ir_new_tmp(ir, QBE_L());
                if (*left_node).kind == NODE_INT() {
                    let nd_l = node_int_data(left_node);
                    let const_off = (*nd_l).value * elem_sz;
                    ir_emit_copy(ir, byte_off, const_off);
                } else {
                    let mut l64: IRVal = left;
                    if left.qbe_type != QBE_L() {
                        l64 = *ir_new_tmp(ir, QBE_L());
                        ir_emit_str(ir, "    %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, l64.id);
                        ir_emit_str(ir, " =l extsw %t" as *u8);
                        ir_emit_int(ir, "%d" as *u8, left.id);
                        ir_emit_str(ir, "\n" as *u8);
                    }
                    let es = *ir_new_tmp(ir, QBE_L());
                    ir_emit_copy(ir, es, elem_sz);
                    ir_emit_binary(ir, byte_off, "mul" as *u8, l64, es);
                }
                let result_ptr = *ir_new_tmp(ir, QBE_L());
                ir_emit_binary(ir, result_ptr, "add" as *u8, byte_off, right);
                return irval_box(ir, (result_ptr).kind, (result_ptr).id, (result_ptr).ival, (result_ptr).name, (result_ptr).qbe_type);
            }

            // *T - *T → i64 (diff in elements)
            if left_is_ptr == 1 && right_is_ptr == 1 && d_op == TOKEN_MINUS() {
                let elem_t = (*(left_t_raw as *Type)).elem;
                let elem_sz = type_size(elem_t as *Type);
                let byte_diff = *ir_new_tmp(ir, QBE_L());
                ir_emit_binary(ir, byte_diff, "sub" as *u8, left, right);
                let es = *ir_new_tmp(ir, QBE_L());
                ir_emit_copy(ir, es, elem_sz);
                let result_diff = *ir_new_tmp(ir, QBE_L());
                ir_emit_binary(ir, result_diff, "div" as *u8, byte_diff, es);
                return irval_box(ir, (result_diff).kind, (result_diff).id, (result_diff).ival, (result_diff).name, (result_diff).qbe_type);
            }
        }

        let result = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));

        // operand width + signedness
        let mut op_qt: i32 = QBE_W();
        let mut is_unsigned: i32 = 0;
        if (*left_node).type_ptr != (0 as *u8) {
            let op_type = (*left_node).type_ptr as *Type;
            op_qt = qbe_type_of((*left_node).type_ptr);
            if (*op_type).kind == KIND_PRIMITIVE() {
                let prim = (*op_type).prim;
                if prim == PRIM_U8() || prim == PRIM_U16() || prim == PRIM_U32() || prim == PRIM_U64() {
                    is_unsigned = 1;
                }
            }
        }

        // W-058 真修 (v3.0.6/Ph.2): vendor QBE 不支持 remd/rems 浮点取模
        //   fold a % b = a - trunc(a/b) * b  (trunc toward 0; match QBE remd spec + C fmod)
        //   5 IL insns: div + dtosi/stosi + swtof + mul + sub
        //   跳过 op = "rem" dispatch (下方 line 2267) 直接 early-return
        // [历史] 当时为避免 `&&`/`||` 嵌套 short-circuit(W-081 sub-bug 触发 phi merge gap)
        //   而写成 nested plain `if`(无 short-circuit)。**该约束已退役**(W-169) ——
        //   in-mem 后端嵌套短路正确,门是 compiler/tests/examples/logical_nested.jhyy。
        //   这里保留 nested 写法只是不想动已验证的代码。
        if d_op == TOKEN_PERCENT() {
            let mut is_fmod_qt: i32 = 0;
            if op_qt == QBE_D() { is_fmod_qt = 1; }
            if op_qt == QBE_S() { is_fmod_qt = 1; }
            if is_fmod_qt != 0 {
                let is_f32: i32 = if op_qt == QBE_S() { 1 } else { 0 };
                // QBE IL 多态 arith op (div/mul/sub) 靠 `=d`/`=s` 类型后缀, 不嵌 type suffix 进 opcode name
                //   只有 type-conversion ops (stosi/dtosi/swtof/...) 把 type 后缀编入 name
                let div_op: *u8 = "div" as *u8;
                let conv_op: *u8 = if is_f32 != 0 { "stosi" as *u8 } else { "dtosi" as *u8 };
                let tof_op: *u8 = "swtof" as *u8;
                let mul_op: *u8 = "mul" as *u8;
                let sub_op: *u8 = "sub" as *u8;
                let t1 = *ir_new_tmp(ir, op_qt);
                let tn = *ir_new_tmp(ir, QBE_W());
                let tnf = *ir_new_tmp(ir, op_qt);
                let tm = *ir_new_tmp(ir, op_qt);
                ir_emit_binary(ir, t1, div_op, left, right);
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, tn.id);
                ir_emit_str(ir, " =w " as *u8);
                ir_emit_str(ir, conv_op);
                ir_emit_str(ir, " %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, t1.id);
                ir_emit_str(ir, "\n" as *u8);
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, tnf.id);
                ir_emit_str(ir, " =" as *u8);
                ir_emit_int(ir, "%c" as *u8, op_qt);
                ir_emit_str(ir, " " as *u8);
                ir_emit_str(ir, tof_op);
                ir_emit_str(ir, " %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, tn.id);
                ir_emit_str(ir, "\n" as *u8);
                ir_emit_binary(ir, tm, mul_op, tnf, right);
                ir_emit_binary(ir, result, sub_op, left, tm);
                return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
            }
        }

        let mut op: *u8 = "add" as *u8;
        if d_op == TOKEN_PLUS()    { op = "add" as *u8; }
        else if d_op == TOKEN_MINUS() { op = "sub" as *u8; }
        else if d_op == TOKEN_STAR()  { op = "mul" as *u8; }
        else if d_op == TOKEN_SLASH() { op = "div" as *u8; }
        else if d_op == TOKEN_PERCENT() { op = "rem" as *u8; }
        else if d_op == TOKEN_AMP()   { op = "and" as *u8; }
        else if d_op == TOKEN_PIPE()  { op = "or" as *u8; }
        else if d_op == TOKEN_CARET() { op = "xor" as *u8; }
        else if d_op == TOKEN_LTLT()  { op = "shl" as *u8; }
        else if d_op == TOKEN_GTGT()  { op = "shr" as *u8; }
        else if d_op == TOKEN_EQEQ() {
            if op_qt == QBE_L()      { op = "ceql" as *u8; }
            else if op_qt == QBE_D() { op = "ceqd" as *u8; }
            else if op_qt == QBE_S() { op = "ceqs" as *u8; }
            else                     { op = "ceqw" as *u8; }
        }
        else if d_op == TOKEN_BANGEQ() {
            if op_qt == QBE_L()      { op = "cnel" as *u8; }
            else if op_qt == QBE_D() { op = "cned" as *u8; }
            else if op_qt == QBE_S() { op = "cnes" as *u8; }
            else                     { op = "cnew" as *u8; }
        }
        else if d_op == TOKEN_LT() {
            if op_qt == QBE_L() {
                if is_unsigned != 0 { op = "cultl" as *u8; } else { op = "csltl" as *u8; }
            } else if op_qt == QBE_D() {
                op = "cltd" as *u8;
            } else if op_qt == QBE_S() {
                op = "clts" as *u8;
            } else {
                if is_unsigned != 0 { op = "cultw" as *u8; } else { op = "csltw" as *u8; }
            }
        }
        else if d_op == TOKEN_LTEQ() {
            if op_qt == QBE_L() {
                if is_unsigned != 0 { op = "culel" as *u8; } else { op = "cslel" as *u8; }
            } else if op_qt == QBE_D() {
                op = "cled" as *u8;
            } else if op_qt == QBE_S() {
                op = "cles" as *u8;
            } else {
                if is_unsigned != 0 { op = "culew" as *u8; } else { op = "cslew" as *u8; }
            }
        }
        else if d_op == TOKEN_GT() {
            if op_qt == QBE_L() {
                if is_unsigned != 0 { op = "cugtl" as *u8; } else { op = "csgtl" as *u8; }
            } else if op_qt == QBE_D() {
                op = "cgtd" as *u8;
            } else if op_qt == QBE_S() {
                op = "cgts" as *u8;
            } else {
                if is_unsigned != 0 { op = "cugtw" as *u8; } else { op = "csgtw" as *u8; }
            }
        }
        else if d_op == TOKEN_GTEQ() {
            if op_qt == QBE_L() {
                if is_unsigned != 0 { op = "cugel" as *u8; } else { op = "csgel" as *u8; }
            } else if op_qt == QBE_D() {
                op = "cged" as *u8;
            } else if op_qt == QBE_S() {
                op = "cges" as *u8;
            } else {
                if is_unsigned != 0 { op = "cugew" as *u8; } else { op = "csgew" as *u8; }
            }
        }

        // W-133 (2026-10-24 真修):聚合类型(struct/enum/array/slice)的
        // == / != 走**按值比较**,不再比槽地址。
        //
        // 修前:qbe_type_of(聚合) 落到默认 'w' ⇒ op 选 ceqw ⇒ 比的是两个
        // **槽地址**(而且只比低 32 位)⇒ 字段完全相同的两个 struct 判 false。
        //
        // left / right 对聚合类型就是**值的地址**(struct 字面量 / is_stack 局部
        // 都返回 slot 地址)⇒ 直接喂给 cg_value_eq。
        if d_op == TOKEN_EQEQ() || d_op == TOKEN_BANGEQ() {
            let lt_raw = (*left_node).type_ptr;
            if lt_raw != (0 as *u8) {
                let lt = type_unwrap_alias(lt_raw as *Type);
                let lk = (*lt).kind;
                if lk == KIND_STRUCT() || lk == KIND_ENUM() ||
                   lk == KIND_ARRAY()  || lk == KIND_SLICE() {
                    let eqp = cg_value_eq(cg_raw, lt_raw, left, right);
                    if d_op == TOKEN_BANGEQ() {
                        // != → !eq。⚠️ **不能**用 `cnew eq, 0` —— cnew(a,b) 的语义
                        // 是「a ≠ b」,所以 cnew(eq, 0) = (eq ≠ 0) = eq ⇒ 取反取反了。
                        // 用 xor 1(位取反)最直白:eq 是 0/1, xor 1 就是它的否定。
                        let one = *ir_new_tmp(ir, QBE_W());
                        ir_emit_copy(ir, one, 1);
                        let res = *ir_new_tmp(ir, QBE_W());
                        ir_emit_binary(ir, res, "xor" as *u8, *eqp, one);
                        return irval_box(ir, (res).kind, (res).id, (res).ival, (res).name, (res).qbe_type);
                    }
                    return irval_box(ir, (*eqp).kind, (*eqp).id, (*eqp).ival, (*eqp).name, (*eqp).qbe_type);
                }
            }
        }
        // 比较时若左右 qbe_type 不同，coerce right 到 left type
        let mut right_coerced = right;
        if d_op >= TOKEN_EQEQ() && d_op <= TOKEN_GTEQ() {
            if left.qbe_type != right.qbe_type {
                right_coerced = cg_convert_arg(cg_raw, right, (*right_node).type_ptr, (*left_node).type_ptr);
            }
        }
        ir_emit_binary(ir, result, op, left, right_coerced);
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_INDEX ──
    // 对齐 v0 codegen.c:1007-1080: const-fold NODE_INT + extsw w→l + 用 elem_sz (非 hardcoded 8)
    // v0.9 wip commit 2.20 真修: ir_emit_copy 第三个参数是 int64_t, 之前传 IRVal 32 字节 → C 读前 8 字节
    //   当成 int64 (kind+id 联合解释) → garbage。const-fold 走 NODE_INT 直接避开 broken 调用。
    if kind == NODE_INDEX() {
        let nd_idx = node_index_data(n);
        let base_node = (*nd_idx).expr as *Node;
        let idx_node = (*nd_idx).index as *Node;
        let base_t_raw = (*base_node).type_ptr;
        // 取 element type
        let mut elem_t_raw: *u8 = 0 as *u8;
        if base_t_raw != (0 as *u8) {
            let bt = base_t_raw as *Type;
            if (*bt).kind == KIND_ARRAY() || (*bt).kind == KIND_POINTER() || (*bt).kind == KIND_SLICE() {
                elem_t_raw = (*bt).elem;
            }
        }
        let elem_sz = type_size(elem_t_raw as *Type);
        let mut base = *cg_expr(cg_raw, base_node);
        // Sprint 4.1 IL_ONLY #1: slice → load ptr from struct (slice = { ptr: l, len: l })
        // working-tree slice index fix: base 是 slice struct 地址,byte-equal 要求 loadl offset 0
        //   拿 ptr 再做 index + offset
        if base_t_raw != (0 as *u8) {
            let bt_slice = base_t_raw as *Type;
            if (*bt_slice).kind == KIND_SLICE() {
                let slice_ptr = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, slice_ptr.id);
                ir_emit_str(ir, " =l loadl" as *u8);
                // Sprint 4.4 commit 2.36: base.kind dispatch (literal vs temp) —
                //   防 `zero` IRVal (kind=IRVAL_INT) 误发 %t0 触发 QBE 错误
                let _b = ir_emit_arg(ir, base);
                ir_emit_str(ir, "\n" as *u8);
                base = slice_ptr;
            }
        }
        // byte-equal v0 codegen.c:1007-1080 — 先 cg_expr(idx_node) emit 原 idx tmp (e.g. %t1 =w copy 25)
        //   再 *ir_new_tmp(byte_off) → const-fold 或 extsw+mul。const-fold 不复用 idx_val tmp (next_tmp 递增),
        //   对齐 v0 codegen.c 路径: const_off = value * elem_sz emit 到新 tmp。
        let idx_val = *cg_expr(cg_raw, idx_node);
        let byte_off = *ir_new_tmp(ir, QBE_L());
        let idx_index_kind = (*idx_node).kind;
        if idx_index_kind == NODE_INT() {
            // 常量索引：const-fold value * elem_sz 直接 emit copy
            let nd = node_int_data(idx_node);
            let const_off = (*nd).value * elem_sz;
            ir_emit_copy(ir, byte_off, const_off);
        } else {
            // 动态索引：必要时 w→l extsw → mul elem_sz
            if idx_val.qbe_type == QBE_L() {
                ir_emit_binary(ir, byte_off, "mul" as *u8, idx_val, ir_new_int(elem_sz));
            } else {
                let idx64 = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, idx64.id);
                ir_emit_str(ir, " =l extsw %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, idx_val.id);
                ir_emit_str(ir, "\n" as *u8);
                ir_emit_binary(ir, byte_off, "mul" as *u8, idx64, ir_new_int(elem_sz));
            }
        }
        let elem_addr = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, elem_addr, "add" as *u8, base, byte_off);
        // struct element: return address (not load) — caller applies field offset.
        // 对齐 v0 codegen.c:1067-1071（struct 走地址，caller 按 is_stack 处理）。
        if elem_t_raw != (0 as *u8) {
            let et = elem_t_raw as *Type;
            if (*et).kind == KIND_STRUCT() {
                return irval_box(ir, (elem_addr).kind, (elem_addr).id, (elem_addr).ival, (elem_addr).name, (elem_addr).qbe_type);
            }
            // W-114:enum 元素同理 —— 数组元素槽里放的是 image,
            // enum 表达式求值为「指向 image 的地址」→ 给地址,不 load。
            if (*et).kind == KIND_ENUM() {
                return irval_box(ir, (elem_addr).kind, (elem_addr).id, (elem_addr).ival, (elem_addr).name, (elem_addr).qbe_type);
            }
            // W-144: array 元素同理(数组元素也是内联字节 ⇒ 给地址,不 load)
            if (*et).kind == KIND_ARRAY() {
                return irval_box(ir, (elem_addr).kind, (elem_addr).id, (elem_addr).ival, (elem_addr).name, (elem_addr).qbe_type);
            }
        }
        let result = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));
        // 用 cg_emit_load 而非 ir_emit_load — u8 走 loadub (与 C 端 byte-equal 对齐)
        let _ld = cg_emit_load(cg_raw, result, (*n).type_ptr, elem_addr);
        let _ = _ld;
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_FIELD ──
    // (*ptr).field 或 s.field。emit base 表达式 + 算 offset + load。
    // 如果字段是 struct 类型，struct 在 QBE 里只能按地址处理 → 返回 addr 不 load。
    if kind == NODE_FIELD() {
        let nf = node_field_data(n);
        let target_node = (*nf).expr as *Node;
        let field_name = (*nf).field;
        let target_t = (*target_node).type_ptr;
        // KIND_SLICE: 合成字段 ptr (off 0) / len (off 8). slice value 是 16-byte stack slot
        if target_t != (0 as *u8) {
            let tt = target_t as *Type;
            if (*tt).kind == KIND_SLICE() {
                let slot_sl = *cg_expr(cg_raw, target_node);
                if strcmp(field_name, "ptr" as *u8) == (0 as i32) {
                    let vp = *ir_new_tmp(ir, QBE_L());
                    let _lp = ir_emit_load(ir, vp, QBE_L(), slot_sl);
                    return irval_box(ir, (vp).kind, (vp).id, (vp).ival, (vp).name, (vp).qbe_type);
                }
                if strcmp(field_name, "len" as *u8) == (0 as i32) {
                    let off8_sl = *ir_new_tmp(ir, QBE_L());
                    let _al = ir_emit_binary(ir, off8_sl, "add" as *u8, slot_sl, ir_new_int(8 as i64));
                    let vl = *ir_new_tmp(ir, QBE_L());
                    let _ll = ir_emit_load(ir, vl, QBE_L(), off8_sl);
                    return irval_box(ir, (vl).kind, (vl).id, (vl).ival, (vl).name, (vl).qbe_type);
                }
                return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
            }
        }
        let base = *cg_expr(cg_raw, target_node);
        if target_t == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let tt = target_t as *Type;
        let mut struct_type_raw: *u8 = 0 as *u8;
        if (*tt).kind == KIND_POINTER() && (*tt).elem != (0 as *u8) {
            struct_type_raw = (*tt).elem;
        } else if (*tt).kind == KIND_STRUCT() {
            struct_type_raw = target_t;
        }
        if struct_type_raw == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        // find field offset via cg_find_field_offset
        let foff_buf2 = arena_alloc((*ir).arena, 16 as i64);
        cg_find_field_offset(struct_type_raw, field_name, foff_buf2);
        let offset: i64 = *(foff_buf2 as *i64);
        let field_type_raw: *u8 = *(ptr_add_u8(foff_buf2, 8 as i64) as **u8);
        let mut addr = base;
        if offset > (0 as i64) {
            addr = *ir_new_tmp(ir, QBE_L());
            ir_emit_binary(ir, addr, "add" as *u8, base, ir_new_int(offset));
        }
        // struct field → 返回 addr（caller 按 is_stack 处理）
        if field_type_raw != (0 as *u8) {
            let ft = field_type_raw as *Type;
            if (*ft).kind == KIND_STRUCT() {
                return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
            }
            // W-114:enum 字段同理 —— enum 的值是「指向 image 的地址」,
            // 字段里放的是 image 本体 → 取字段 = 取它的地址。
            // (与 struct 字段同一处理:不 load,直接给地址)
            if (*ft).kind == KIND_ENUM() {
                return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
            }
            // W-144: array 字段同理 —— 数组在 struct 里是**内联字节**,
            // 取字段 = 取它的地址(与 struct/enum 字段同款)。
            // 不走这条时 array 落到下面的 loadw ⇒ 读到「数组前 4 字节」当值,
            // 后续 a.buf[0] 拿它当基址 ⇒ ACCESS_VIOLATION。
            if (*ft).kind == KIND_ARRAY() {
                return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
            }
        }
        let result = *ir_new_tmp(ir, qbe_type_of(field_type_raw));
        cg_emit_load(cg_raw, result, field_type_raw, addr);
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_DEREF ──
    // *expr。emit expr（应该 produce pointer），然后 load 返回。
    // 如果目标是 struct/array：struct 在 QBE 只能按指针走 → 返回 pointer itself。
    if kind == NODE_DEREF() {
        let dd = node_deref_data(n);
        let inner_node = (*dd).expr as *Node;
        let ptr = *cg_expr(cg_raw, inner_node);
        let t_inner = (*inner_node).type_ptr;
        if t_inner == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let t_inner_t = t_inner as *Type;
        if (*t_inner_t).kind == KIND_POINTER() && (*t_inner_t).elem != (0 as *u8) {
            let elem_t = (*t_inner_t).elem;
            let et = elem_t as *Type;
            // W-114:enum 同 struct —— `*p`(p: *U)求值为「指向 image 的地址」
            // = p 本身;load 出来的是 4 字节 image → tag 对、payload 丢。
            if (*et).kind == KIND_STRUCT() || (*et).kind == KIND_ARRAY() || (*et).kind == KIND_SLICE() || (*et).kind == KIND_ENUM() {
                return irval_box(ir, (ptr).kind, (ptr).id, (ptr).ival, (ptr).name, (ptr).qbe_type);
            }
        }
        let result = *ir_new_tmp(ir, qbe_type_of((*n).type_ptr));
        cg_emit_load(cg_raw, result, (*n).type_ptr, ptr);
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_CALL ──
    // Function call. 处理:
    //   - extern FFI（不 mangle，fn_name = sym.name）
    //   - module 函数（mangle "$mod__$name"，用 StringBuilder 拼）
    //   - 普通函数（fn_name = sym.name）
    //   - sret: 返回类型 struct → alloc ret_slot + pass as hidden arg[0]
    //   - struct arg → copy to stack slot before call
    //   - 隐式类型转换（cg_convert_arg）
    if kind == NODE_CALL() {
        let cd = node_call_data(n);
        let callee_node = ((*cd).callee) as *Node;
        let args_node = (*cd).args;
        let nargs = (*cd).nargs;

        // 取 callee sym（callee 是 IDENT 时才有 sym）
        let mut fn_sym_raw: *u8 = 0 as *u8;
        if (*callee_node).kind == NODE_IDENT() {
            let id_d = node_ident_data(callee_node);
            fn_sym_raw = (*id_d).sym;
        }

        // 决定 fn_name（extern 不 mangle；有 module 做 mangle）
        let mut fn_name: *u8 = "?" as *u8;
        let mut is_extern_call: i32 = 0;
        if fn_sym_raw != (0 as *u8) {
            let fs = fn_sym_raw as *Sym;
            if (*fs).is_extern != 0 {
                is_extern_call = 1;
                // W-069 v2.6.6 fallback: if same name exists as non-extern fn
                //   decl in merged module (caller module's `extern fn X` for a
                //   .jhyy fn X that actually lives in another module), use the
                //   pre-mangled name from fn_defs table. Otherwise pass through
                //   unmangled (true C ABI extern like malloc/free).
                let real_name = cg_fn_defs_lookup(cg_raw, (*fs).name);
                if real_name != (0 as *u8) {
                    fn_name = real_name;
                } else {
                    fn_name = (*fs).name;
                }
            } else if (*fs).module != (0 as *u8) {
                // mangle "$mod__$name" via StringBuilder
                let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
                sb_init((*ir).arena, &sb);
                sb_append_cstr((*ir).arena, &sb, (*fs).module as *u8);
                sb_append_cstr((*ir).arena, &sb, "__" as *u8);
                sb_append_cstr((*ir).arena, &sb, (*fs).name as *u8);
                fn_name = sb_cstr((*ir).arena, &sb);
            } else if (*fs).kind == SYM_VAR() && (*fs).type_ptr != (0 as *u8) {
                // v3.2.1 (3j MVP): closure-bound SYM_VAR -> emit call to 合成 fn
                //   sema NODE_LET wires (*sym).aux_sym = closure.fn_sym
                //   合成 fn sym's name = "__closure_<5digits>", codegen emits call $__closure_<N>
                let fst = (*fs).type_ptr as *Type;
                if (*fst).kind == KIND_FUNC() && (*fs).aux_sym != (0 as *u8) {
                    let aux_s = (*fs).aux_sym as *Sym;
                    fn_name = (*aux_s).name;
                } else {
                    fn_name = (*fs).name;
                }
            } else {
                fn_name = (*fs).name;
            }
        }

        // sret if return type is struct
        // v2.1.0 Stage 1c.4: abi_win_emit_call_prelude handles sret detection +
        // alloc + ret_slot alloc + args buffer init. Replaces prior inline block.
        let mut is_sret: i32 = 0;
        if (*n).type_ptr != (0 as *u8) {
            let nt = (*n).type_ptr as *Type;
            // W-114:enum 的返回值也走 sret —— ABI § 3.3 明写
            // 「struct / enum → 通过隐式 sret 指针参数返回」。
            // 之前 enum 按值返回(地址),而那个地址指向 **callee 自己帧里**的槽
            // → 函数一返回就悬垂(实测:下一个函数的序言把它盖掉 → tag 读成 0)。
            if (*nt).kind == KIND_STRUCT() || (*nt).kind == KIND_ENUM() {
                is_sret = 1;
            }
        }
        let mut rsize: i32 = 0;
        if is_sret != 0 {
            rsize = type_size((*n).type_ptr as *Type) as i32;
            if rsize < (4 as i32) { rsize = 4; }
        }
        let ret_slot_buf: *u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
        let mut args_arr2: *u8 = 0 as *u8;
        // W-070 v2.8.2: dispatch call_prelude Win vs SysV (first call site).
        if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
            args_arr2 = abi_sysv_emit_call_prelude(ir, (*ir).arena, cg_sysv_expanded_nargs(cg_raw, args_node, nargs), is_sret, rsize, ret_slot_buf);
            // W-104: MEMORY class 与「寄存器溢出参数」混排暂不支持 → 明确报错
            let _scope = cg_sysv_check_memory_scope(cg_raw, args_node, nargs);
        } else {
            args_arr2 = abi_win_emit_call_prelude(ir, (*ir).arena, nargs, is_sret, rsize, ret_slot_buf);
        }
        let ret_slot: IRVal = IRVal {
            kind: *(ret_slot_buf as *i32),
            id: *(ptr_add_u8(ret_slot_buf, 4 as i64) as *i32),
            ival: *(ptr_add_u8(ret_slot_buf, 8 as i64) as *i64),
            name: *(ptr_add_u8(ret_slot_buf, 16 as i64) as **u8),
            qbe_type: *(ptr_add_u8(ret_slot_buf, 24 as i64) as *i32)
        };

        // 取 param_types + nparams（fn_sym 是 fn 时）
        let mut param_ts_raw: *u8 = 0 as *u8;
        let mut nparams: i64 = 0 as i64;
        if fn_sym_raw != (0 as *u8) {
            let fs2 = fn_sym_raw as *Sym;
            if (*fs2).type_ptr != (0 as *u8) {
                let fst = (*fs2).type_ptr as *Type;
                if (*fst).kind == KIND_FUNC() {
                    param_ts_raw = (*fst).params;
                    nparams = (*fst).nparams;
                }
            }
        }

        // v1.3.5: #[inline] call-site expansion. Try inline first; fall back to
        //   `call $name` if body 不简单或递归。
        let inline_decl_raw = cg_find_inline_decl(cg_raw, fn_sym_raw);
        let mut inline_decl: *u8 = 0 as *u8;
        if inline_decl_raw != (0 as *u8) {
            inline_decl = inline_decl_raw;
        }
        let mut simple_expr: *Node = 0 as *Node;
        if inline_decl != (0 as *u8) {
            let inline_decl_t = inline_decl as *NodeFuncDecl;
            simple_expr = cg_inline_simple_return_expr((*inline_decl_t).body as *Node);
        }
        let mut try_inline: i32 = 0 as i32;
        if inline_decl != (0 as *u8) {
            if (*cg).current_inline_sym != fn_sym_raw {
                if (*n).type_ptr != (0 as *u8) {
                    let nt2 = (*n).type_ptr as *Type;
                    if (*nt2).kind != KIND_STRUCT() {
                        if simple_expr != (0 as *Node) {
                            try_inline = 1 as i32;
                        }
                    }
                }
            }
        }
        if try_inline != (0 as i32) {
            let inline_decl_t = inline_decl as *NodeFuncDecl;
            let ret_expr = simple_expr;
            // 评估 args 到 buffer (cg_expr 直接, 不走 struct-copy / sret — locals 直接用值)
            // v1.3.5 MVP: 仅 primitive args; struct arg 走 call fallback
            let mut arg_vals_raw: *u8 = 0 as *u8;
            if nargs > (0 as i64) {
                arg_vals_raw = arena_alloc((*ir).arena, (nargs as i64) * IRVAL_SIZE());
                let mut ai: i64 = 0 as i64;
                while ai < nargs {
                    let arg_slot_node2 = ptr_add_u8(args_node, ai * (8 as i64)) as **Node;
                    let arg_node2 = *arg_slot_node2;
                    let av = *cg_expr(cg_raw, arg_node2);
                    let out_slot = ptr_add_u8(arg_vals_raw, ai * IRVAL_SIZE()) as *IRVal;
                    *out_slot = av;
                    ai = ai + (1 as i64);
                }
            }
            // 保存 caller state;把 params 注册为 locals with arg values
            let saved_nlocals = (*cg).nlocals;
            let saved_loop_depth = (*cg).loop_depth;
            let prev_inline = (*cg).current_inline_sym;
            (*cg).current_inline_sym = fn_sym_raw;
            let mut pi2: i64 = 0 as i64;
            while pi2 < (*inline_decl_t).nparams {
                let param_slot3 = ptr_add_u8((*inline_decl_t).params, pi2 * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
                let p3_sym_raw = (*param_slot3).sym;
                let av_slot = ptr_add_u8(arg_vals_raw, pi2 * IRVAL_SIZE()) as *IRVal;
                let av_val = *av_slot;
                cg_add_local(cg_raw, p3_sym_raw, av_val, 0);
                pi2 = pi2 + (1 as i64);
            }
            // emit body return expr
            let result = *cg_expr(cg_raw, ret_expr);
            // 恢复 caller state
            (*cg).nlocals = saved_nlocals;
            (*cg).loop_depth = saved_loop_depth;
            (*cg).current_inline_sym = prev_inline;
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }

        // args buffer + ret_slot already set by abi_win_emit_call_prelude above
        let extra: i64 = if is_sret != 0 { (1 as i64) } else { (0 as i64) };

        let mut i: i64 = 0 as i64;
        // W-104:args 数组的写入位置必须是**跨实参累计**的运行计数器 ——
        // 一个 struct 实参展开成 N 个「值」实参后,后续实参的位置整体后移。
        // ⚠️ 之前这里写的是 `let mut out_idx = i`(实参在**原始**列表里的下标),
        //    于是 struct 展开后,下一个实参会写回**已被占用的**槽位 ——
        //    `f(Mixed m, i32 x)` 的 %x 落在 m 的第二个 eightbyte 上,
        //    而 call 文本里多出一个没写过的空槽(渲染成 `%t0`)。
        //    单参数调用测不到(只有一个实参时 i == out_idx)。
        let mut out_idx: i64 = 0 as i64;
        while i < nargs {
            let arg_slot_node = ptr_add_u8(args_node, i * (8 as i64)) as **Node;
            let arg_node = *arg_slot_node;
            let mut arg_v = *cg_expr(cg_raw, arg_node);
            let arg_t = (*arg_node).type_ptr;
            // struct arg → 拷贝到 stack slot (v2.1.0 Stage 1c.5)
            if arg_t != (0 as *u8) {
                let at = arg_t as *Type;
                if (*at).kind == KIND_STRUCT() {
                    // W-070 v2.8.2: dispatch struct_arg_slot Win vs SysV.
                    let mut copy_slot = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
                    if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                        copy_slot = abi_sysv_emit_struct_arg_slot(ir, arg_t);
                    } else {
                        copy_slot = abi_win_emit_struct_arg_slot(ir, arg_t);
                    }
                    cg_copy_agg(cg_raw, arg_t, copy_slot, arg_v);
                    arg_v = copy_slot;
                } else {
                    // 隐式类型转换（cg_convert_arg）
                    if param_ts_raw != (0 as *u8) && i < nparams {
                        let pt_slot = ptr_add_u8(param_ts_raw, i * (8 as i64)) as **Type;
                        let pt = *pt_slot as *Type;
                        if pt != (0 as *Type) {
                            arg_v = cg_convert_arg(cg_raw, arg_v, arg_t, pt as *u8);
                        }
                    }
                }
            }
            // W-104:SysV 下 struct 实参按 eightbyte 拆成多个「值」实参。
            // 写 args 数组的索引改用运行计数器 out_idx(不再是 i)—— 展开后
            // 后续实参的位置会整体后移。
            let n_mem_arg = cg_emit_struct_arg_memory_slots(cg_raw, arg_t, arg_v);
            let mut n_eb_arg = 0 as i64;
            if n_mem_arg == (0 as i64) {
                n_eb_arg = cg_emit_struct_arg_eightbytes(cg_raw, arg_t, arg_v);
            }
            // W-104 MEMORY class(>16B 的 struct):整体走栈,不拆 eightbyte。
            //
            // 每个 8 字节 slot 作为**独立实参**进 args 数组,type letter 用
            // 'm'(109)—— self-backend 见到 'm' 就把它推进 outgoing 栈区,
            // 且**不消耗整数寄存器**(SysV: MEMORY class 不占 INTEGER 序列)。
            //
            // ⚠️ 这里必须显式写进 args 数组。之前 MEMORY 分支只调 helper
            //    (生成 slot temp)却**没写 args**,于是 call 文本里那些 slot
            //    位置读到未初始化的 IRVal(id=0)→ 渲染成 `%t0` → 传的是垃圾。
            let mut n_written: i64 = 0 as i64;
            if n_mem_arg > (0 as i64) {
                let vals = (*cg).last_struct_arg_vals;
                let mut k: i64 = 0 as i64;
                while k < n_mem_arg {
                    let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                    *out_slot = *(ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal);
                    // IRVal 布局:kind@0 id@4 ival@8 name@16 qbe_type@24
                    *(ptr_add_u8(out_slot, 24 as i64) as *i32) = 109 as i32;
                    out_idx = out_idx + (1 as i64);
                    k = k + (1 as i64);
                }
                n_written = n_mem_arg;
            }
            if n_written == (0 as i64) {
                if n_eb_arg > (0 as i64) {
                    let vals = (*cg).last_struct_arg_vals;
                    let mut k: i64 = 0 as i64;
                    while k < n_eb_arg {
                        let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                        *out_slot = *(ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal);
                        out_idx = out_idx + (1 as i64);
                        k = k + (1 as i64);
                    }
                    n_written = n_eb_arg;
                }
            }
            if n_written == (0 as i64) {
                let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                *out_slot = arg_v;
                out_idx = out_idx + (1 as i64);
            }
            i = i + (1 as i64);
        }

        if is_sret != 0 {
            ir_emit_call_void(ir, fn_name, args_arr2, ((cg_sysv_expanded_nargs(cg_raw, args_node, nargs) + (extra as i64)) as i32));
            return irval_box(ir, (ret_slot).kind, (ret_slot).id, (ret_slot).ival, (ret_slot).name, (ret_slot).qbe_type);
        }
        let mut qt: i32 = QBE_W();
        if (*n).type_ptr != (0 as *u8) {
            // W-114:enum 的返回值是**地址** → 结果槽 8 字节,不是 4 字节的 tag
            qt = cg_value_type_of((*n).type_ptr);
        }
        let result = *ir_new_tmp(ir, qt);
        ir_emit_call(ir, result, fn_name, args_arr2, (cg_sysv_expanded_nargs(cg_raw, args_node, nargs) as i32));
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_QUALIFIED_CALL ──
    // module::func(args) — sema 已设 resolved (Sym*)
    if kind == NODE_QUALIFIED_CALL() {
        let qd = node_qualified_call_data(n);
        let fn_sym_raw = (*qd).resolved;
        let args_node = (*qd).args;
        let nargs = (*qd).nargs;

        // mangle "$mod__$name" via StringBuilder
        let mut fn_name: *u8 = "?" as *u8;
        if fn_sym_raw != (0 as *u8) {
            let fs = fn_sym_raw as *Sym;
            if (*fs).module != (0 as *u8) {
                let mut sb: StringBuilder = StringBuilder { buf: 0 as *u8, len: 0 as i64, cap: 0 as i64 };
                sb_init((*ir).arena, &sb);
                sb_append_cstr((*ir).arena, &sb, (*fs).module as *u8);
                sb_append_cstr((*ir).arena, &sb, "__" as *u8);
                sb_append_cstr((*ir).arena, &sb, (*fs).name as *u8);
                fn_name = sb_cstr((*ir).arena, &sb);
            } else {
                fn_name = (*fs).name;
            }
        }

        // sret 同 NODE_CALL
        // v2.1.0 Stage 1c.4: abi_win_emit_call_prelude handles sret detection +
        // alloc + ret_slot alloc + args buffer init.
        let mut is_sret: i32 = 0;
        if (*n).type_ptr != (0 as *u8) {
            let nt = (*n).type_ptr as *Type;
            // W-114:enum 的返回值也走 sret —— ABI § 3.3 明写
            // 「struct / enum → 通过隐式 sret 指针参数返回」。
            // 之前 enum 按值返回(地址),而那个地址指向 **callee 自己帧里**的槽
            // → 函数一返回就悬垂(实测:下一个函数的序言把它盖掉 → tag 读成 0)。
            if (*nt).kind == KIND_STRUCT() || (*nt).kind == KIND_ENUM() {
                is_sret = 1;
            }
        }
        let mut rsize2: i32 = 0;
        if is_sret != 0 {
            rsize2 = type_size((*n).type_ptr as *Type) as i32;
            if rsize2 < (4 as i32) { rsize2 = 4; }
        }
        let ret_slot_buf2: *u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
        let mut args_arr2: *u8 = 0 as *u8;
        // W-070 v2.8.2: dispatch call_prelude Win vs SysV (second call site).
        if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
            args_arr2 = abi_sysv_emit_call_prelude(ir, (*ir).arena, cg_sysv_expanded_nargs(cg_raw, args_node, nargs), is_sret, rsize2, ret_slot_buf2);
            // W-104: MEMORY class 与「寄存器溢出参数」混排暂不支持 → 明确报错
            let _scope = cg_sysv_check_memory_scope(cg_raw, args_node, nargs);
        } else {
            args_arr2 = abi_win_emit_call_prelude(ir, (*ir).arena, nargs, is_sret, rsize2, ret_slot_buf2);
        }
        let ret_slot: IRVal = IRVal {
            kind: *(ret_slot_buf2 as *i32),
            id: *(ptr_add_u8(ret_slot_buf2, 4 as i64) as *i32),
            ival: *(ptr_add_u8(ret_slot_buf2, 8 as i64) as *i64),
            name: *(ptr_add_u8(ret_slot_buf2, 16 as i64) as **u8),
            qbe_type: *(ptr_add_u8(ret_slot_buf2, 24 as i64) as *i32)
        };

        let mut param_ts_raw: *u8 = 0 as *u8;
        let mut nparams: i64 = 0 as i64;
        if fn_sym_raw != (0 as *u8) {
            let fs2 = fn_sym_raw as *Sym;
            if (*fs2).type_ptr != (0 as *u8) {
                let fst = (*fs2).type_ptr as *Type;
                if (*fst).kind == KIND_FUNC() {
                    param_ts_raw = (*fst).params;
                    nparams = (*fst).nparams;
                }
            }
        }

        // v1.3.5: #[inline] call-site expansion (qualified call). Try inline first;
        //   fall back to `call $mod__$name` if 不简单或递归。
        let inline_decl_raw2 = cg_find_inline_decl(cg_raw, fn_sym_raw);
        let mut inline_decl2: *u8 = 0 as *u8;
        if inline_decl_raw2 != (0 as *u8) {
            inline_decl2 = inline_decl_raw2;
        }
        let mut simple_expr2: *Node = 0 as *Node;
        if inline_decl2 != (0 as *u8) {
            let inline_decl2_t = inline_decl2 as *NodeFuncDecl;
            simple_expr2 = cg_inline_simple_return_expr((*inline_decl2_t).body as *Node);
        }
        let mut try_inline2: i32 = 0 as i32;
        if inline_decl2 != (0 as *u8) {
            if (*cg).current_inline_sym != fn_sym_raw {
                if (*n).type_ptr != (0 as *u8) {
                    let nt3 = (*n).type_ptr as *Type;
                    if (*nt3).kind != KIND_STRUCT() {
                        if simple_expr2 != (0 as *Node) {
                            try_inline2 = 1 as i32;
                        }
                    }
                }
            }
        }
        if try_inline2 != (0 as i32) {
            let inline_decl2_t = inline_decl2 as *NodeFuncDecl;
            let ret_expr2 = simple_expr2;
            let mut arg_vals_raw2: *u8 = 0 as *u8;
            if nargs > (0 as i64) {
                arg_vals_raw2 = arena_alloc((*ir).arena, (nargs as i64) * IRVAL_SIZE());
                let mut ai2: i64 = 0 as i64;
                while ai2 < nargs {
                    let arg_slot_node3 = ptr_add_u8(args_node, ai2 * (8 as i64)) as **Node;
                    let arg_node3 = *arg_slot_node3;
                    let av2 = *cg_expr(cg_raw, arg_node3);
                    let out_slot2 = ptr_add_u8(arg_vals_raw2, ai2 * IRVAL_SIZE()) as *IRVal;
                    *out_slot2 = av2;
                    ai2 = ai2 + (1 as i64);
                }
            }
            let saved_nlocals2 = (*cg).nlocals;
            let saved_loop_depth2 = (*cg).loop_depth;
            let prev_inline2 = (*cg).current_inline_sym;
            (*cg).current_inline_sym = fn_sym_raw;
            let mut pi3: i64 = 0 as i64;
            while pi3 < (*inline_decl2_t).nparams {
                let param_slot4 = ptr_add_u8((*inline_decl2_t).params, pi3 * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
                let p4_sym_raw = (*param_slot4).sym;
                let av_slot2 = ptr_add_u8(arg_vals_raw2, pi3 * IRVAL_SIZE()) as *IRVal;
                let av_val2 = *av_slot2;
                cg_add_local(cg_raw, p4_sym_raw, av_val2, 0);
                pi3 = pi3 + (1 as i64);
            }
            let result2 = *cg_expr(cg_raw, ret_expr2);
            (*cg).nlocals = saved_nlocals2;
            (*cg).loop_depth = saved_loop_depth2;
            (*cg).current_inline_sym = prev_inline2;
            return irval_box(ir, (result2).kind, (result2).id, (result2).ival, (result2).name, (result2).qbe_type);
        }

        // v2.1.0 Stage 1c.4: extra + args_arr already set up by
        // abi_win_emit_call_prelude above (lines 2543-2544). ret_slot
        // written to args_arr[0] inside the abi if is_sret.
        let extra: i64 = if is_sret != 0 { (1 as i64) } else { (0 as i64) };

        let mut i: i64 = 0 as i64;
        // W-104:args 数组的写入位置必须是**跨实参累计**的运行计数器 ——
        // 一个 struct 实参展开成 N 个「值」实参后,后续实参的位置整体后移。
        // ⚠️ 之前这里写的是 `let mut out_idx = i`(实参在**原始**列表里的下标),
        //    于是 struct 展开后,下一个实参会写回**已被占用的**槽位 ——
        //    `f(Mixed m, i32 x)` 的 %x 落在 m 的第二个 eightbyte 上,
        //    而 call 文本里多出一个没写过的空槽(渲染成 `%t0`)。
        //    单参数调用测不到(只有一个实参时 i == out_idx)。
        let mut out_idx: i64 = 0 as i64;
        while i < nargs {
            let arg_slot_node = ptr_add_u8(args_node, i * (8 as i64)) as **Node;
            let arg_node = *arg_slot_node;
            let mut arg_v = *cg_expr(cg_raw, arg_node);
            let arg_t = (*arg_node).type_ptr;
            if arg_t != (0 as *u8) {
                let at = arg_t as *Type;
                if (*at).kind == KIND_STRUCT() {
                    // W-070 v2.8.2: dispatch struct_arg_slot Win vs SysV.
                    let mut copy_slot = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
                    if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
                        copy_slot = abi_sysv_emit_struct_arg_slot(ir, arg_t);
                    } else {
                        copy_slot = abi_win_emit_struct_arg_slot(ir, arg_t);
                    }
                    cg_copy_agg(cg_raw, arg_t, copy_slot, arg_v);
                    arg_v = copy_slot;
                } else {
                    if param_ts_raw != (0 as *u8) && i < nparams {
                        let pt_slot = ptr_add_u8(param_ts_raw, i * (8 as i64)) as **Type;
                        let pt = *pt_slot as *Type;
                        if pt != (0 as *Type) {
                            arg_v = cg_convert_arg(cg_raw, arg_v, arg_t, pt as *u8);
                        }
                    }
                }
            }
            // W-104:SysV 下 struct 实参按 eightbyte 拆成多个「值」实参。
            // 写 args 数组的索引改用运行计数器 out_idx(不再是 i)—— 展开后
            // 后续实参的位置会整体后移。
            let n_mem_arg = cg_emit_struct_arg_memory_slots(cg_raw, arg_t, arg_v);
            let mut n_eb_arg = 0 as i64;
            if n_mem_arg == (0 as i64) {
                n_eb_arg = cg_emit_struct_arg_eightbytes(cg_raw, arg_t, arg_v);
            }
            // W-104 MEMORY class:见 NODE_CALL 分支的同名注释(结构相同)。
            let mut n_written: i64 = 0 as i64;
            if n_mem_arg > (0 as i64) {
                let vals = (*cg).last_struct_arg_vals;
                let mut k: i64 = 0 as i64;
                while k < n_mem_arg {
                    let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                    *out_slot = *(ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal);
                    *(ptr_add_u8(out_slot, 24 as i64) as *i32) = 109 as i32;
                    out_idx = out_idx + (1 as i64);
                    k = k + (1 as i64);
                }
                n_written = n_mem_arg;
            }
            if n_written == (0 as i64) {
                if n_eb_arg > (0 as i64) {
                    let vals = (*cg).last_struct_arg_vals;
                    let mut k: i64 = 0 as i64;
                    while k < n_eb_arg {
                        let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                        *out_slot = *(ptr_add_u8(vals, k * IRVAL_SIZE()) as *IRVal);
                        out_idx = out_idx + (1 as i64);
                        k = k + (1 as i64);
                    }
                    n_written = n_eb_arg;
                }
            }
            if n_written == (0 as i64) {
                let out_slot = ptr_add_u8(args_arr2, ((extra as i64) + out_idx) * IRVAL_SIZE()) as *IRVal;
                *out_slot = arg_v;
                out_idx = out_idx + (1 as i64);
            }
            i = i + (1 as i64);
        }

        if is_sret != 0 {
            ir_emit_call_void(ir, fn_name, args_arr2, ((cg_sysv_expanded_nargs(cg_raw, args_node, nargs) + (extra as i64)) as i32));
            return irval_box(ir, (ret_slot).kind, (ret_slot).id, (ret_slot).ival, (ret_slot).name, (ret_slot).qbe_type);
        }
        let mut qt: i32 = QBE_W();
        if (*n).type_ptr != (0 as *u8) {
            // W-114:enum 的返回值是**地址** → 结果槽 8 字节,不是 4 字节的 tag
            qt = cg_value_type_of((*n).type_ptr);
        }
        let result = *ir_new_tmp(ir, qt);
        ir_emit_call(ir, result, fn_name, args_arr2, (cg_sysv_expanded_nargs(cg_raw, args_node, nargs) as i32));
        return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
    }

    // ── NODE_IF ──
    // if cond { then } [else { else }]
    //
    // v0.9 wip commit 2.6 (B-φ1 fix): 对齐 v0 codegen.c:602-674 if-expr logic
    //   - 删 v0 codegen bug 2 workaround (store/load 模式)
    //   - 删 alloc result_slot 提前 (会占 tmp 编号, fib_renamed.il 偏移 1)
    //   - phi 只在 then AND else 都不 return 时 emit
    //   - void if → 不 alloc, 不 phi
    //   - 单边 return → fallback return then_v (zero IRVal from NODE_RETURN)
    if kind == NODE_IF() {
        let nid = node_if_data(n);
        let cond_node = (*nid).cond as *Node;
        let then_node = (*nid).then_body as *Node;
        let else_node = (*nid).else_body as *Node;
        let cond = *cg_expr(cg_raw, cond_node);
        let then_block = *ir_new_block(ir, "then" as *u8);
        let else_block = *ir_new_block(ir, "else" as *u8);
        let merge_block = *ir_new_block(ir, "merge" as *u8);

        // 决定返回类型（void if 不 emit phi）
        let mut is_void: i32 = 0;
        let mut ret_qt: i32 = QBE_W();
        if (*n).type_ptr != (0 as *u8) {
            let nt = (*n).type_ptr as *Type;
            if (*nt).kind == KIND_VOID() {
                is_void = 1;
            } else {
                // W-114:同调用结果 —— enum 的值是地址
                ret_qt = cg_value_type_of((*n).type_ptr);
            }
        }

        // 检测 then/else 是否以 return/break/continue 结尾（避免 dead jmp after ret）
        let then_returns: i32 = cg_body_returns(then_node);
        let else_returns: i32 = if else_node != (0 as *Node) { cg_body_returns(else_node) } else { 1 };

        // v2.11.18 phi 修复: hoist result temp + do_emit_pair gate
        //   move-pair lowering 在每个非 return 的前驱块末尾 emit copy (经 ir_emit_copy_tmp)
        //   merge 直接 return result, 不再 emit phi (QBE ssa() pass 自动构造 SSA)。
        //   do_emit_pair 保留原 hoist 条件 (both don't return) 防止漏前驱静默错。
        let mut result: IRVal = zero;
        let mut do_emit_pair: i32 = 0;
        if is_void == 0 && else_node != (0 as *Node) && then_returns == 0 && else_returns == 0 {
            result = *ir_new_tmp(ir, ret_qt);
            do_emit_pair = 1;
        }

        ir_emit_jnz(ir, cond, then_block, else_block);

        // then
        ir_emit_label(ir, then_block);
        let mut then_v: IRVal = zero;
        let _then_void = *cg_expr(cg_raw, then_node);
        if is_void == 0 {
            then_v = _then_void;
        }
        // v2.11.18 phi 修复: move-pair. 在前驱块末尾 emit copy (gate by do_emit_pair 防 result 未 alloc).
        //   删除 then_phi_pred (原 cg_emit_phi 不再需要)
        if then_returns == 0 {
            if do_emit_pair != 0 {
                ir_emit_copy_tmp(ir, result, then_v);
            }
            ir_emit_jmp(ir, merge_block);
        }

        // else
        ir_emit_label(ir, else_block);
        let mut else_v: IRVal = zero;
        let _has_else: i32 = if else_node != (0 as *Node) { 1 } else { 0 };
        // v2.11.18 phi 修复: move-pair. 删 else_phi_pred (cg_emit_phi 不再调用)
        if _has_else != 0 {
            let _else_void = *cg_expr(cg_raw, else_node);
            if is_void == 0 {
                else_v = _else_void;
            }
            if else_returns == 0 {
                if do_emit_pair != 0 {
                    ir_emit_copy_tmp(ir, result, else_v);
                }
                ir_emit_jmp(ir, merge_block);
            }
        }
        if _has_else == 0 {
            // no else → fallthrough to merge
            ir_emit_jmp(ir, merge_block);
        }

        // merge
        ir_emit_label(ir, merge_block);
        if is_void != 0 {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        // v2.11.18 phi 修复: phi → move-pair. result 已 hoist (见上), copies 已在各前驱块 emit,
        //   merge 直接 return result (QBE ssa() 自动构造 SSA, 多余 copy 在 copy() pass 消除).
        if do_emit_pair != 0 {
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }
        // fallback: 单边 return / 无 else → 直接返回 then_v (zero IRVal from NODE_RETURN)
        return irval_box(ir, (then_v).kind, (then_v).id, (then_v).ival, (then_v).name, (then_v).qbe_type);
    }

    // ── NODE_FOR ──
    // for i in start..end { body }
    //   alloc stack slot for i, init with start
    //   4 blocks: loop_start, loop_body, loop_inc, loop_end
    //   loop_start: load i, compare with end, jnz loop_body, loop_end
    //   loop_body: emit body
    //   loop_inc: load i, add 1, store, jmp loop_start
    //   loop_end: pop loop_depth
    //   (loop_continues = loop_inc → continue jumps to increment)
    // v0 参考: compiler/src/codegen.c:1468-1540
    if kind == NODE_FOR() {
        let d = node_for_data(n);
        let start_node = ((*d).start) as *Node;
        let end_node = ((*d).end) as *Node;
        let body_node = ((*d).body) as *Node;
        let var_sym_raw = (*d).var;
        let var_type_raw = (*(var_sym_raw as *Sym)).type_ptr;

        // Compile start and end expressions
        let start_v = *cg_expr(cg_raw, start_node);
        let end_v = *cg_expr(cg_raw, end_node);

        // Determine loop variable type
        let var_qt = qbe_type_of(var_type_raw);
        let mut var_sz = type_size(var_type_raw as *Type) as i32;
        if var_sz < 4 { var_sz = 4; }

        // Determine signed vs unsigned for comparison op (csltw/csltl/cultw/cultl)
        let mut cmp_op_str: *u8 = "csltw" as *u8;
        if var_qt == QBE_L() {
            cmp_op_str = "csltl" as *u8;
        }
        if var_type_raw != (0 as *u8) {
            let vt = var_type_raw as *Type;
            if (*vt).kind == KIND_PRIMITIVE() {
                let prim_k = (*vt).prim;
                if prim_k == PRIM_U8() || prim_k == PRIM_U16() || prim_k == PRIM_U32() || prim_k == PRIM_U64() {
                    if var_qt == QBE_L() {
                        cmp_op_str = "cultl" as *u8;
                    } else {
                        cmp_op_str = "cultw" as *u8;
                    }
                }
            }
        }

        // Allocate stack slot for loop variable (mutable)
        let slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slot, var_sz);
        let _st_lv = cg_store_enum_image(cg_raw, var_type_raw, start_v, slot);
        cg_add_local(cg_raw, var_sym_raw, slot, 1);

        // 4 blocks
        let loop_start = *ir_new_block(ir, "loop_start" as *u8);
        let loop_body_b = *ir_new_block(ir, "loop_body" as *u8);
        let loop_inc = *ir_new_block(ir, "loop_inc" as *u8);
        let loop_end = *ir_new_block(ir, "loop_end" as *u8);

        // Push loop labels for break/continue
        let depth = (*cg).loop_depth;
        let starts_ptr = (*cg).loop_starts as *IRVal;
        let ends_ptr = (*cg).loop_ends as *IRVal;
        let conts_ptr = (*cg).loop_continues as *IRVal;
        *(ptr_add_u8(starts_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_start;
        *(ptr_add_u8(ends_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_end;
        *(ptr_add_u8(conts_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_inc;
        (*cg).loop_depth = depth + (1 as i32);

        // jmp loop_start
        ir_emit_jmp(ir, loop_start);

        // loop_start: load i, compare with end, jnz loop_body, loop_end
        ir_emit_label(ir, loop_start);
        let i_val = *ir_new_tmp(ir, var_qt);
        cg_emit_load(cg_raw, i_val, var_type_raw, slot);
        let cond = *ir_new_tmp(ir, QBE_W());
        ir_emit_binary(ir, cond, cmp_op_str, i_val, end_v);
        ir_emit_jnz(ir, cond, loop_body_b, loop_end);

        // loop_body: emit body
        ir_emit_label(ir, loop_body_b);
        let _expr = *cg_expr(cg_raw, body_node);

        // loop_inc: load i, add 1, store, jmp loop_start
        ir_emit_label(ir, loop_inc);
        let current = *ir_new_tmp(ir, var_qt);
        cg_emit_load(cg_raw, current, var_type_raw, slot);
        let next_val = *ir_new_tmp(ir, var_qt);
        ir_emit_binary(ir, next_val, "add" as *u8, current, ir_new_int(1 as i64));
        let _st_lv2 = cg_store_enum_image(cg_raw, var_type_raw, next_val, slot);
        ir_emit_jmp(ir, loop_start);

        // loop_end
        ir_emit_label(ir, loop_end);
        (*cg).loop_depth = depth;
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_WHILE ──
    // while cond { body }
    //   loop_start: cond eval → jnz loop_body, loop_end
    //   loop_body: body emit → jmp loop_start
    //   loop_continues / loop_ends 推到 stack（loop_depth++）
    if kind == NODE_WHILE() {
        let nwd = node_while_data(n);
        let cond_node = (*nwd).cond as *Node;
        let body_node = (*nwd).body as *Node;
        let loop_start = *ir_new_block(ir, "loop_start" as *u8);
        let loop_body = *ir_new_block(ir, "loop_body" as *u8);
        let loop_end = *ir_new_block(ir, "loop_end" as *u8);
        let loop_cont = *ir_new_block(ir, "loop_cont" as *u8);

        // push loop labels onto stack
        let depth = (*cg).loop_depth;
        let starts_ptr = (*cg).loop_starts as *IRVal;
        let ends_ptr = (*cg).loop_ends as *IRVal;
        let conts_ptr = (*cg).loop_continues as *IRVal;
        *(ptr_add_u8(starts_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_start;
        *(ptr_add_u8(ends_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_end;
        *(ptr_add_u8(conts_ptr as *u8, (depth as i64) * (40 as i64)) as *IRVal) = loop_cont;
        (*cg).loop_depth = depth + (1 as i32);

        // start: emit label, eval cond
        ir_emit_label(ir, loop_start);
        let cond_v = *cg_expr(cg_raw, cond_node);
        ir_emit_jnz(ir, cond_v, loop_body, loop_end);

        // body
        ir_emit_label(ir, loop_body);
        let _expr = *cg_expr(cg_raw, body_node);
        ir_emit_label(ir, loop_cont);
        ir_emit_jmp(ir, loop_start);

        // end
        ir_emit_label(ir, loop_end);
        (*cg).loop_depth = depth;
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_STRUCT_LIT ──
    // Type { field1: val1, field2: val2, ... }
    // alloc stack slot + store 每个字段（field offset 通过 st.fields[] 查 name）
    //
    // 注意：NODE_STRUCT_LIT 作为 "let x = Type{...}" 右侧时（mutable/struct 用 is_stack
    // 路径，见 NODE_LET）；本 case 是表达式位置（struct lit 自身已经返回 slot）
    if kind == NODE_STRUCT_LIT() {
        let sl = node_struct_lit_data(n);
        if (*n).type_ptr == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let st = (*n).type_ptr as *Type;
        if (*st).kind != KIND_STRUCT() {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let size = type_size(st) as i32;
        let mut size2 = size;
        if size2 < (4 as i32) { size2 = 4; }
        let slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slot, size2);

        let nfields = (*sl).nfields;
        let fields_arr = (*sl).fields;
        let mut i: i64 = 0 as i64;
        while i < nfields {
            let fi_entry = ptr_add_u8(fields_arr, i * NODE_FIELD_INIT_SIZE()) as *NodeFieldInit;
            let fname = (*fi_entry).name;
            let fval_node = (*fi_entry).value as *Node;
            let fval = *cg_expr(cg_raw, fval_node);

            // 找 field offset by name (via cg_find_field_offset helper)
            let foff_buf3 = arena_alloc((*ir).arena, 16 as i64);
            cg_find_field_offset(st as *u8, fname as *u8, foff_buf3);
            let offset: i64 = *(foff_buf3 as *i64);

            // store value at slot + offset
            let addr = *ir_new_tmp(ir, QBE_L());
            let off_val = ir_new_int(offset);
            ir_emit_binary(ir, addr, "add" as *u8, slot, off_val);
            // W-114:enum 字段放的是**内存映像**(tag|padding|payload),不是那个
            // 地址 —— 字段是**内联**存放的(ABI § 2.6 的布局),而 enum 的值
            // 是「指向 image 的地址」。直接存地址会存成**截断的指针**
            // (enum 字段 4 字节 → 指针低 32 位)→ 读回来是垃圾。
            let mut _fld_is_enum: i32 = 0;
            if (*fval_node).type_ptr != (0 as *u8) {
                let fvt = (*fval_node).type_ptr as *Type;
                if (*fvt).kind == KIND_ENUM() { _fld_is_enum = 1 as i32; }
            }
            if _fld_is_enum != (0 as i32) {
                let _ce = cg_copy_enum(cg_raw, (*fval_node).type_ptr, addr, fval);
            } else {
                let _st = cg_emit_store(cg_raw, (*fval_node).type_ptr, fval, addr);
            }
            i = i + (1 as i64);
        }
        return irval_box(ir, (slot).kind, (slot).id, (slot).ival, (slot).name, (slot).qbe_type);
    }

    if kind == NODE_ARRAY_LIT() {
        let al = node_array_lit_data(n);
        if (*n).type_ptr == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let at_arr = (*n).type_ptr as *Type;
        if (*at_arr).kind != KIND_ARRAY() {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let elem_t_arr = (*at_arr).elem;
        let count_arr = (*at_arr).arr_count;
        let elem_sz_arr = type_size(elem_t_arr as *Type);
        let total_sz = count_arr * elem_sz_arr;
        let mut slot_sz = total_sz as i32;
        if slot_sz < 4 { slot_sz = 4; }
        let slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slot, slot_sz);
        let arr_elems = (*al).elems;
        let arr_n = (*al).nelems;
        let mut i_arr: i64 = 0 as i64;
        while i_arr < arr_n {
            let e_slot_arr = ptr_add_u8(arr_elems, i_arr * (8 as i64)) as **Node;
            let e_node_arr = *e_slot_arr;
            let e_val = *cg_expr(cg_raw, e_node_arr);
            let off_arr = ir_new_int(i_arr * elem_sz_arr);
            let elem_addr_arr = *ir_new_tmp(ir, QBE_L());
            ir_emit_binary(ir, elem_addr_arr, "add" as *u8, slot, off_arr);
            let _store = cg_emit_store(cg_raw, elem_t_arr, e_val, elem_addr_arr);
            i_arr = i_arr + (1 as i64);
        }
        return irval_box(ir, (slot).kind, (slot).id, (slot).ival, (slot).name, (slot).qbe_type);
    }

    if kind == NODE_SLICE_LIT() {
        let sl_lit = node_slice_lit_data(n);
        if (*n).type_ptr == (0 as *u8) { return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type); }
        let st_slice = (*n).type_ptr as *Type;
        if (*st_slice).kind != KIND_SLICE() { return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type); }
        let elem_t_sl = (*st_slice).elem;
        let elem_sz_sl = type_size(elem_t_sl as *Type);
        let al_inner = node_array_lit_data((*sl_lit).array as *Node);
        let sl_n = (*al_inner).nelems;
        let sl_elems = (*al_inner).elems;
        let mut elem_buf_sz = (sl_n * elem_sz_sl) as i32;
        if elem_buf_sz < 4 { elem_buf_sz = 4; }
        let elem_buf = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, elem_buf, elem_buf_sz);
        let mut isl: i64 = 0 as i64;
        while isl < sl_n {
            let es_slot = ptr_add_u8(sl_elems, isl * (8 as i64)) as **Node;
            let es_node = *es_slot;
            let es_val = *cg_expr(cg_raw, es_node);
            let off_sl = ir_new_int(isl * elem_sz_sl);
            let es_addr = *ir_new_tmp(ir, QBE_L());
            ir_emit_binary(ir, es_addr, "add" as *u8, elem_buf, off_sl);
            let _store = cg_emit_store(cg_raw, elem_t_sl, es_val, es_addr);
            isl = isl + (1 as i64);
        }
        let slice_slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slice_slot, 16 as i32);
        let ptr_addr = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, ptr_addr, "add" as *u8, slice_slot, ir_new_int(0 as i64));
        let _s1 = cg_emit_store_primitive(cg_raw, 0 as *u8, elem_buf, ptr_addr);
        let len_addr = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, len_addr, "add" as *u8, slice_slot, ir_new_int(8 as i64));
        let len_val = *ir_new_tmp(ir, QBE_L());
        ir_emit_copy(ir, len_val, sl_n);
        let _s2 = cg_emit_store_primitive(cg_raw, 0 as *u8, len_val, len_addr);
        return irval_box(ir, (slice_slot).kind, (slice_slot).id, (slice_slot).ival, (slice_slot).name, (slice_slot).qbe_type);
    }

    // ── NODE_SLICE_RANGE (Sprint 4.8 full impl, W-006 MAX_LOCALS fix) ──
    // 对齐 v0 codegen.c:1139-1200。
    if kind == NODE_SLICE_RANGE() {
        let sr = node_slice_range_data(n);
        let base_node = (*sr).base as *Node;
        let start_node = (*sr).start as *Node;
        let end_node = (*sr).end as *Node;
        let base_t_raw = (*base_node).type_ptr;
        if base_t_raw == (0 as *u8) { return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type); }
        let bt = base_t_raw as *Type;
        let is_slice: i64 = if (*bt).kind == KIND_SLICE() { 1 as i64 } else { 0 as i64 };
        let mut elem_t_raw: *u8 = 0 as *u8;
        if (*bt).kind == KIND_SLICE() { elem_t_raw = (*bt).elem; } else { elem_t_raw = (*bt).elem; }
        if elem_t_raw == (0 as *u8) { return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type); }
        let elem_sz = type_size(elem_t_raw as *Type);
        let mut elem_sz_eff = elem_sz;
        if elem_sz_eff < (4 as i64) { elem_sz_eff = 4 as i64; }

        // base: ptr to first element
        let mut base = *ir_new_tmp(ir, QBE_L());
        if is_slice != (0 as i64) {
            let slice_addr = *cg_expr(cg_raw, base_node);
            ir_emit_str(ir, "    %t" as *u8); ir_emit_int(ir, "%d" as *u8, base.id);
            ir_emit_str(ir, " =l loadl %t" as *u8); ir_emit_int(ir, "%d" as *u8, slice_addr.id);
            ir_emit_str(ir, "\n" as *u8);
        }
        if is_slice == (0 as i64) { base = *cg_expr(cg_raw, base_node); }

        // start_off = start * elem_sz_eff
        let start_v = *cg_expr(cg_raw, start_node);
        let start_off = *ir_new_tmp(ir, QBE_L());
        if (*start_node).kind == NODE_INT() {
            let sv = (*(node_int_data(start_node))).value;
            ir_emit_copy(ir, start_off, sv * elem_sz_eff);
        } else {
            let mut start64 = start_v;
            if start_v.qbe_type != QBE_L() {
                start64 = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8); ir_emit_int(ir, "%d" as *u8, start64.id);
                ir_emit_str(ir, " =l extsw %t" as *u8); ir_emit_int(ir, "%d" as *u8, start_v.id);
                ir_emit_str(ir, "\n" as *u8);
            }
            ir_emit_binary(ir, start_off, "mul" as *u8, start64, ir_new_int(elem_sz_eff));
        }

        // new_ptr = base + start_off
        let new_ptr = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, new_ptr, "add" as *u8, base, start_off);

        // new_len = end - start
        let end_v = *cg_expr(cg_raw, end_node);
        let new_len = *ir_new_tmp(ir, QBE_L());
        if (*start_node).kind == NODE_INT() && (*end_node).kind == NODE_INT() {
            let sv2 = (*(node_int_data(start_node))).value;
            let ev = (*(node_int_data(end_node))).value;
            ir_emit_copy(ir, new_len, ev - sv2);
        } else {
            let mut end64 = end_v;
            if end_v.qbe_type != QBE_L() {
                end64 = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8); ir_emit_int(ir, "%d" as *u8, end64.id);
                ir_emit_str(ir, " =l extsw %t" as *u8); ir_emit_int(ir, "%d" as *u8, end_v.id);
                ir_emit_str(ir, "\n" as *u8);
            }
            let mut start64b = start_v;
            if start_v.qbe_type != QBE_L() {
                start64b = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8); ir_emit_int(ir, "%d" as *u8, start64b.id);
                ir_emit_str(ir, " =l extsw %t" as *u8); ir_emit_int(ir, "%d" as *u8, start_v.id);
                ir_emit_str(ir, "\n" as *u8);
            }
            ir_emit_binary(ir, new_len, "sub" as *u8, end64, start64b);
        }

        // alloc 16-byte slice slot, store ptr + len
        let slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slot, 16 as i32);
        let _sp = cg_emit_store_primitive(cg_raw, 0 as *u8, new_ptr, slot);
        let off8 = *ir_new_tmp(ir, QBE_L());
        ir_emit_binary(ir, off8, "add" as *u8, slot, ir_new_int(8 as i64));
        let _sl = cg_emit_store_primitive(cg_raw, 0 as *u8, new_len, off8);
        return irval_box(ir, (slot).kind, (slot).id, (slot).ival, (slot).name, (slot).qbe_type);
    }

    // ── NODE_ENUM_VARIANT (v0.9 wip commit 2.12b) ──
    // 对齐 v0 codegen.c:874-912:
    //   - alloc stack slot (size = et.size, min 4)
    //   - 找 variant 的 tag (按 name 匹配 → 循环索引 = tag)
    //   - store tag at offset 0
    //   - 如果有 payload, store at payload_off
    // AUDIT (v0.9 wip commit 2.16): VARIANT_DESC_SIZE = 24, VariantDesc 加 payload 字段。
    //   codegen 端不读 VariantDesc.tag, 直接用循环索引 i 作为 tag (跟 sema 写 tag = j 一致)。
    //   payload 字段在 offset 8 跟 v0 端一致, 可以读。
    //   (之前是 16, sema 写 tag 在 offset 16 = 下一项的 name 字段, 是 heap overflow; 现已修)
    if kind == NODE_ENUM_VARIANT() {
        let nev = node_enum_variant_data(n);
        if (*n).type_ptr == (0 as *u8) {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let et = (*n).type_ptr as *Type;
        if (*et).kind != KIND_ENUM() {
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        let mut size2 = (*et).size as i32;
        if size2 < (4 as i32) { size2 = 4; }
        let slot = *ir_new_tmp(ir, QBE_L());
        ir_emit_alloc(ir, slot, size2);

        // 找 variant: 按 name 比较 (strcmp 字符串, 跟 v0 端 sema.c:851 / codegen.c:889 一致)
        let variants_buf = (*et).variants;
        let nvariants = (*et).nvariants;
        let d_variant_sym = (*nev).variant_sym as *Sym;
        let mut tag: i32 = 0 as i32;
        let mut found: i32 = 0 as i32;
        let mut payload_type_raw: *u8 = 0 as *u8;
        let mut i: i64 = 0 as i64;
        while i < nvariants {
            let v_off = ptr_add_u8(variants_buf, i * VARIANT_DESC_SIZE());
            let v_name_ptr = *(v_off as **Sym);
            if v_name_ptr != (0 as *Sym) {
                if d_variant_sym != (0 as *Sym) {
                    if strcmp((*v_name_ptr).name, (*d_variant_sym).name) == (0 as i32) {
                        tag = i as i32;
                        payload_type_raw = *((v_off as i64 + (8 as i64)) as **Type) as *u8;
                        found = 1 as i32;
                    }
                }
            }
            if found != (0 as i32) { break; }
            i = i + (1 as i64);
        }
        // 没找到: tag 保持 0 (跟 v0 端 codegen.c:900 silent 行为一致)

        // store tag at offset 0
        let tag_addr = *ir_new_tmp(ir, QBE_L());
        let off_zero = ir_new_int(0 as i64);
        ir_emit_binary(ir, tag_addr, "add" as *u8, slot, off_zero);
        let tag_val = *ir_new_tmp(ir, QBE_W());
        ir_emit_copy(ir, tag_val, tag as i64);
        ir_emit_store(ir, QBE_W(), tag_val, tag_addr);

        // store payload if present
        if (*nev).payload != (0 as *u8) {
            if payload_type_raw != (0 as *u8) {
                let payload_addr = *ir_new_tmp(ir, QBE_L());
                let off_payload = ir_new_int((*et).payload_off);
                ir_emit_binary(ir, payload_addr, "add" as *u8, slot, off_payload);
                let pval = *cg_expr(cg_raw, (*nev).payload as *Node);
                cg_emit_store(cg_raw, payload_type_raw, pval, payload_addr);
            }
        }
        return irval_box(ir, (slot).kind, (slot).id, (slot).ival, (slot).name, (slot).qbe_type);
    }

    // ── NODE_ADDR_OF ──
    // &expr → 返回 expr 的地址。要求目标 var 已分配 stack slot。
    // codegen.jhyy 用 NODE_ADDR_OF 主要用于 `&buf` 模式（StringBuilder addr）。
    if kind == NODE_ADDR_OF() {
        let nad = node_addr_of_data(n);
        let inner_node = (*nad).expr as *Node;
        let inner_kind = (*inner_node).kind;
        if inner_kind == NODE_IDENT() {
            let id = node_ident_data(inner_node);
            // [Status: 真修 W-005 #2 in C-side (commit 2.81); src0/ workaround kept for历史读者了解历史.]
            // v0 codegen bug 16 workaround (W-005): 同 NODE_ASSIGN — arena_alloc + field-level read
            let loc_buf_u8 = arena_alloc((*ir).arena, IRVAL_SIZE());
            let _found4 = cg_find_local(cg_raw, (*id).sym, loc_buf_u8);
            let loc = IRVal {
                kind:     *(loc_buf_u8 as *i32),
                id:       *(ptr_add_u8(loc_buf_u8, 4 as i64) as *i32),
                ival:     *(ptr_add_u8(loc_buf_u8, 8 as i64) as *i64),
                name:     *(ptr_add_u8(loc_buf_u8, 16 as i64) as **u8),
                qbe_type: *(ptr_add_u8(loc_buf_u8, 24 as i64) as *i32),
            };
            let is_stack = cg_find_local_is_stack(cg_raw, (*id).sym);
            if is_stack != 0 {
                return irval_box(ir, (loc).kind, (loc).id, (loc).ival, (loc).name, (loc).qbe_type);  // already address
            }
            // W-114:enum 的**值本身就是「指向 image 的地址」**→ `&e` == `e`。
            // 走通用 SSA 路径会「alloc 一个 temp 把地址存进去,再取 temp 的地址」
            // → 得到的是「指向一个装着地址的槽的地址」→ 解引用后读到的是
            // 地址的字节,不是 image 的 tag(实测 read_color(&c) 读出垃圾)。
            let mut _inner_is_enum: i32 = 0;
            if (*inner_node).type_ptr != (0 as *u8) {
                let it = (*inner_node).type_ptr as *Type;
                if (*it).kind == KIND_ENUM() { _inner_is_enum = 1 as i32; }
            }
            if _inner_is_enum != (0 as i32) {
                let v_enum = *cg_expr(cg_raw, inner_node);
                return irval_box(ir, (v_enum).kind, (v_enum).id, (v_enum).ival, (v_enum).name, (v_enum).qbe_type);
            }
            // SSA value → alloc temp slot, store, return slot
            // W-144:槽大小按 type_size 分配(不再固定 8 字节)——
            // 被取引用的值是 array(12 字节)时,固定 8 字节的槽会被 store 写穿 4 字节。
            let v = *cg_expr(cg_raw, inner_node);
            let slot = *ir_new_tmp(ir, QBE_L());
            let mut slot_size: i32 = 8 as i32;
            if (*inner_node).type_ptr != (0 as *u8) {
                let its = type_size((*inner_node).type_ptr as *Type) as i32;
                if its > slot_size { slot_size = its; }
            }
            ir_emit_alloc(ir, slot, slot_size);
            let _store = cg_emit_store(cg_raw, (*inner_node).type_ptr, v, slot);
            return irval_box(ir, (slot).kind, (slot).id, (slot).ival, (slot).name, (slot).qbe_type);
        }
        // v1.7.0 Stage 2: &arr[i] 应返回元素地址,不是元素值.
        // 之前 fall-through 到 `return zero` 让 caller 拿到 IRVAL_INT 0 → p[j] 走 `add 0, off` segfault.
        // Mirror of C-side codegen.c NODE_ADDR_OF NODE_INDEX branch.
        if inner_kind == NODE_INDEX() {
            let nd = node_index_data(inner_node);
            let base_node = (*nd).expr as *Node;
            let idx_node = (*nd).index as *Node;
            let arr_type_raw = (*base_node).type_ptr;
            if arr_type_raw != (0 as *u8) {
                let arr_t = arr_type_raw as *Type;
                if (*arr_t).kind == KIND_ARRAY() {
                    let elem_t = (*arr_t).elem;
                    let elem_sz = type_size(elem_t as *Type);
                    // compute base address (mirror C-side logic)
                    let mut base: IRVal = zero;
                    if (*base_node).kind == NODE_IDENT() {
                        let id = node_ident_data(base_node);
                        let sym_raw = (*id).sym;
                        if sym_raw != (0 as *u8) {
                            let sym = sym_raw as *Sym;
                            if (*sym).kind == SYM_CONST() {
                                base = *cg_expr(cg_raw, base_node);
                            } else {
                                let loc_buf = arena_alloc((*ir).arena, IRVAL_SIZE());
                                let _fnd = cg_find_local(cg_raw, (*id).sym, loc_buf);
                                base = IRVal {
                                    kind:     *(loc_buf as *i32),
                                    id:       *(ptr_add_u8(loc_buf, 4 as i64) as *i32),
                                    ival:     *(ptr_add_u8(loc_buf, 8 as i64) as *i64),
                                    name:     *(ptr_add_u8(loc_buf, 16 as i64) as **u8),
                                    qbe_type: *(ptr_add_u8(loc_buf, 24 as i64) as *i32),
                                };
                            }
                        }
                    } else {
                        base = *cg_expr(cg_raw, base_node);
                    }
                    // compute index
                    let idx_val = *cg_expr(cg_raw, idx_node);
                    let byte_off = *ir_new_tmp(ir, QBE_L());
                    if (*idx_node).kind == NODE_INT() {
                        let nd_int = node_int_data(idx_node);
                        let const_off = (*nd_int).value * elem_sz;
                        ir_emit_copy(ir, byte_off, const_off);
                    } else {
                        if idx_val.qbe_type == QBE_L() {
                            ir_emit_binary(ir, byte_off, "mul" as *u8, idx_val, ir_new_int(elem_sz));
                        } else {
                            let idx64 = *ir_new_tmp(ir, QBE_L());
                            ir_emit_str(ir, "    %t" as *u8);
                            ir_emit_int(ir, "%d" as *u8, idx64.id);
                            ir_emit_str(ir, " =l extsw %t" as *u8);
                            ir_emit_int(ir, "%d" as *u8, idx_val.id);
                            ir_emit_str(ir, "\n" as *u8);
                            ir_emit_binary(ir, byte_off, "mul" as *u8, idx64, ir_new_int(elem_sz));
                        }
                    }
                    let addr = *ir_new_tmp(ir, QBE_L());
                    ir_emit_binary(ir, addr, "add" as *u8, base, byte_off);
                    return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
                }
            }
        }
        // Bug 1 真修 (v0.9 wip commit 2.84): &EXPR.field should return the FIELD ADDRESS,
        // not the field value (fall-through to `return zero` was emitting `loadw 0`).
        // Mirror of C-side codegen.c NODE_ADDR_OF NODE_FIELD branch.
        if inner_kind == NODE_FIELD() {
            let fd = node_field_data(inner_node);
            let fd_expr_node = (*fd).expr as *Node;
            let expr_type = (*fd_expr_node).type_ptr;
            if expr_type != (0 as *u8) {
                let et = expr_type as *Type;
                // pointer-to-struct: base = ptr, offset = field offset
                if (*et).kind == KIND_POINTER() && (*et).elem != (0 as *u8) {
                    let elem_t = (*et).elem;
                    let et2 = elem_t as *Type;
                    if (*et2).kind == KIND_STRUCT() {
                        let base = *cg_expr(cg_raw, fd_expr_node);
                        let foff_buf = arena_alloc((*ir).arena, 16 as i64);
                        cg_find_field_offset(elem_t, (*fd).field, foff_buf);
                        let offset: i64 = *(foff_buf as *i64);
                        if offset > (0 as i64) {
                            let addr = *ir_new_tmp(ir, QBE_L());
                            ir_emit_binary(ir, addr, "add" as *u8, base, ir_new_int(offset));
                            return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
                        }
                        return irval_box(ir, (base).kind, (base).id, (base).ival, (base).name, (base).qbe_type);  // offset 0: addr is the pointer
                    }
                }
                // struct value field: base = stack slot of value
                if (*et).kind == KIND_STRUCT() {
                    let base = *cg_expr(cg_raw, fd_expr_node);
                    let foff_buf = arena_alloc((*ir).arena, 16 as i64);
                    cg_find_field_offset(expr_type, (*fd).field, foff_buf);
                    let offset: i64 = *(foff_buf as *i64);
                    if offset > (0 as i64) {
                        let addr = *ir_new_tmp(ir, QBE_L());
                        ir_emit_binary(ir, addr, "add" as *u8, base, ir_new_int(offset));
                        return irval_box(ir, (addr).kind, (addr).id, (addr).ival, (addr).name, (addr).qbe_type);
                    }
                    return irval_box(ir, (base).kind, (base).id, (base).ival, (base).name, (base).qbe_type);  // offset 0
                }
            }
            return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_CAST ──
    // `x as T` → emit cast instruction. 走 cg_convert_arg（跟 C 端 codegen.c:721 一致）
    // float→int 走 stosi/dtosi 等。Phase-2 sprint 5 commit 4 补全（之前是 noop 漏 emit dtosi）。
    if kind == NODE_CAST() {
        let ncd = node_cast_data(n);
        let inner_node = (*ncd).expr as *Node;
        let inner_v = *cg_expr(cg_raw, inner_node);
        let src_t = (*inner_node).type_ptr;
        let dst_t = (*n).type_ptr;
        // Sprint 4.2 mirror: array→slice cast — alloc 16-byte slot, store ptr at offset 0, len at offset 8
        if src_t != (0 as *u8) && dst_t != (0 as *u8) {
            let src_arr = src_t as *Type;
            let dst_arr = dst_t as *Type;
            if (*src_arr).kind == KIND_ARRAY() && (*dst_arr).kind == KIND_SLICE() {
                if (*src_arr).elem == (*dst_arr).elem {
                    let arr_count = (*src_arr).arr_count;
                    let slice_slot = *ir_new_tmp(ir, QBE_L());
                    ir_emit_alloc(ir, slice_slot, 16 as i32);
                    let ptr_addr_c = *ir_new_tmp(ir, QBE_L());
                    ir_emit_binary(ir, ptr_addr_c, "add" as *u8, slice_slot, ir_new_int(0 as i64));
                    let _sc1 = cg_emit_store_primitive(cg_raw, 0 as *u8, inner_v, ptr_addr_c);
                    let len_addr_c = *ir_new_tmp(ir, QBE_L());
                    ir_emit_binary(ir, len_addr_c, "add" as *u8, slice_slot, ir_new_int(8 as i64));
                    let len_val_c = *ir_new_tmp(ir, QBE_L());
                    ir_emit_copy(ir, len_val_c, arr_count);
                    let _sc2 = cg_emit_store_primitive(cg_raw, 0 as *u8, len_val_c, len_addr_c);
                    return irval_box(ir, (slice_slot).kind, (slice_slot).id, (slice_slot).ival, (slice_slot).name, (slice_slot).qbe_type);
                }
            }
        }
        // W-009 fix: src_t==0（literal 没 type info）也走 coerce，cg_convert_arg 用
        //   arg.qbe_type 兜底。否则 `0 as *u8` no-op 成 `w copy 0`，比较 l 字段
        //   时 ceql 报 operand type 不匹配
        if dst_t == (0 as *u8) {
            return irval_box(ir, (inner_v).kind, (inner_v).id, (inner_v).ival, (inner_v).name, (inner_v).qbe_type);
        }
        let _cv = cg_convert_arg(cg_raw, inner_v, src_t, dst_t);
        return irval_box(ir, _cv.kind, _cv.id, _cv.ival, _cv.name, _cv.qbe_type);
    }

    // ── NODE_MATCH（v0.9 wip commit 2.9 B-match fix）──
    // 对齐 v0 codegen.c:909-997 逻辑:
    //   - 链式 jnz + arm body block
    //   - 收集 body_blocks / body_values for phi
    //   - 末尾 dangling next_check (sema 7A 验穷尽,但 codegen 仍 emit label 兜底)
    //   - merge + phi 收尾
    // 已知限制(对齐 v0): enum pattern 走 default case → cmp = 1 (accept-all)。
    // 这跟 v0 行为 byte-equal,但语义上不正确(应该按 tag dispatch)。
    // match_exhaustive.jhyy 用 Some(_) / None enum pattern,v0 路径也是 cmp=1
    // (永远走第一个 arm = Some → 1) → 跟 match_exhaustive EXPECT: 2 一致。
    if kind == NODE_MATCH() {
        let nmd = node_match_data(n);
        let matched_node = (*nmd).subject as *Node;
        let matched = *cg_expr(cg_raw, matched_node);
        let arms_arr = (*nmd).arms;
        let narms = (*nmd).narms;

        // 决定返回类型 (void match 不 emit phi)
        let mut qt: i32 = 0;
        if (*n).type_ptr != (0 as *u8) {
            let nt = (*n).type_ptr as *Type;
            if (*nt).kind != KIND_VOID() {
                // W-114:同调用结果 —— enum 的值是地址
                qt = cg_value_type_of((*n).type_ptr);
            }
        }

        let merge_block = *ir_new_block(ir, "merge" as *u8);

        // v2.11.18 phi 修复: hoist result temp (move-pair lowering), 删 phi_buf / nphi_var
        //   copies 已在各 arm body 末尾 emit (gate by qt != 0), merge 直接 return result.
        let mut result: IRVal = zero;
        if qt != (0 as i32) {
            let mut real_qt: i32 = qt;
            if real_qt == (0 as i32) { real_qt = QBE_W(); }
            result = *ir_new_tmp(ir, real_qt);
        }

        let mut next_check: IRVal = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
        let mut next_check_id: i64 = 0 as i64;  // 用 id 字段当 "is set" 标志

        let mut i: i64 = 0 as i64;
        while i < narms {
            // v0.9 wip commit 2.9 (B-match fix): arms_arr is *Node array (8 bytes per elem),
            // each elem is a Node with NodeMatchArm data after Node header.
            // Per parser.jhyy:1170, arms[*] = arm_node (just *Node pointer).
            // NOT a NodeMatchArm array (that was wrong assumption — would read garbage).
            let arm_node_slot = ptr_add_u8(arms_arr, i * (8 as i64)) as **Node;
            let arm_node = *arm_node_slot;
            let arm_slot = node_match_arm_data(arm_node);
            let arm_pattern = (*arm_slot).pattern as *Node;
            let arm_body = (*arm_slot).body as *Node;
            let body_block = *ir_new_block(ir, "arm" as *u8);

            if (*arm_pattern).kind == NODE_PATTERN_WILD() {
                // wildcard: always match, jump to body
                if next_check_id != (0 as i64) {
                    ir_emit_label(ir, next_check);
                    next_check_id = 0 as i64;
                }
                ir_emit_jmp(ir, body_block);
            } else {
                // literal/range/enum pattern: emit comparison
                if next_check_id != (0 as i64) {
                    ir_emit_label(ir, next_check);
                    next_check_id = 0 as i64;
                }
                next_check = *ir_new_block(ir, "next" as *u8);
                next_check_id = 1 as i64;
                // v1.8.3.2 (W-063 真修): pass subject type, not match result type. Short-name enum
// pattern (`Some(v)` without `Option::` qualifier) falls back to match_type when
// pe->type_sym is NULL — match result type (e.g., i32 for `match o { Some(v) => v, ...}`)
// is not KIND_ENUM, so enum_type resolution silently fails and the binding branch is
// skipped → @arm2 emits no loadw → phi references undefined %t0 → QBE reject.
// Long-name form (`Option::Some(v)`) unaffected since pe->type_sym is set.
let cmp = cg_match_pattern(cg_raw, matched, arm_pattern, (*matched_node).type_ptr);
                ir_emit_jnz(ir, cmp, body_block, next_check);
            }

            // body
            ir_emit_label(ir, body_block);
            let body_val = *cg_expr(cg_raw, arm_body);
            // body_returns check
            let arm_returns: i32 = cg_body_returns(arm_body);
            if arm_returns == 0 {
                // v2.11.18 phi 修复: move-pair. 在前驱块末尾 emit copy (gate by qt != 0 防 result 未 alloc)
                if qt != (0 as i32) {
                    ir_emit_copy_tmp(ir, result, body_val);
                }
                ir_emit_jmp(ir, merge_block);
            }
            i = i + (1 as i64);
        }

        // dangling next_check (sema 7A 验穷尽但 codegen 仍 emit label 兜底,见 v0 codegen.c:961-980)
        // v2.11.18: unreachable pred 也需要 move-pair copy 防 QBE 静默插 phi
        if next_check_id != (0 as i64) {
            ir_emit_label(ir, next_check);
            if qt != (0 as i32) {
                let mut undef_qt: i32 = qt;
                if undef_qt == (0 as i32) { undef_qt = QBE_W(); }
                let undef = *ir_new_tmp(ir, undef_qt);
                ir_emit_copy(ir, undef, 0);
                ir_emit_copy_tmp(ir, result, undef);
                ir_emit_jmp(ir, merge_block);
            }
        }

        // v2.11.18 phi 修复: merge 直接 return (result 已 hoist, copies 已在各前驱块 emit)
        ir_emit_label(ir, merge_block);
        if qt != (0 as i32) {
            return irval_box(ir, (result).kind, (result).id, (result).ival, (result).name, (result).qbe_type);
        }
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_DEFER ──
    // v1.3.6: defer body 在 cg_emit_defers (cg_stmt NODE_RETURN 前) 已
    //   emit. 这里只是 stmt position 访问,no-op → zero.
    if kind == NODE_DEFER() {
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── NODE_ASM_BLOCK ──
    // V3-B v3.0.1: asm!(...) inline asm macro per D42 (docs/plans/v2/v2.0.0-os-prep.md).
    //   codegen does NOT emit QBE IL — instead appends raw asm string to a
    //   side-file (compiler/build/obj/_inline_asm.buf, fopen "ab" per
    //   feedback_qbe_crlf_root_cause). main.jhyy concatenates that file to
    //   the .s file before gcc link. v3.0.1 only supports a single string
    //   literal — operands array always NULL.
    if kind == NODE_ASM_BLOCK() {
        let ad = node_asm_block_data(n);
        // W-113:asm 文本走 IL(`dbgasm <hex>`)⇒ 后端把它**内联**进函数体 ✓
        // (之前是 append 到 .s 末的死字节 —— 见 cg_emit_raw_asm_inline 的注释)。
        let _ra = cg_emit_raw_asm_inline(ir, (*ad).text);
        // Return zero IRVal (asm is stmt-position; never used as expr value).
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }
    // v3.0.5 (3f memory barrier): fence_* builtin → emit raw mnem to
    // _fence.buf side-file (separate from _inline_asm.buf for clarity).
    //   kind 0 = seq_cst → "mfence\n"
    //   kind 1 = acquire → "lfence\n"
    //   kind 2 = release → "sfence\n"
    // main.jhyy reads _fence.buf + concats to temp_asm before gcc link.
    if kind == NODE_BUILTIN_FENCE() {
        let fd = node_builtin_fence_data(n);
        let mut mnem: *u8 = "sfence" as *u8;  // default fallback
        if (*fd).kind == (0 as i64) {
            mnem = "mfence" as *u8;
        }
        if (*fd).kind == (1 as i64) {
            mnem = "lfence" as *u8;
        }
        if (*fd).kind == (2 as i64) {
            mnem = "sfence" as *u8;
        }
        // W-113:跟 asm! 一样走 IL(`dbgasm <hex>`)⇒ 内联进函数体 ✓
        // (之前是 append 到 .s 末 —— 同样落在所有函数之外 = 死字节)。
        let _rf = cg_emit_raw_asm_inline(ir, mnem);
        return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
    }

    // ── 未实现 case：返回 zero IRVal（commit 4 补全）──
    return irval_box(ir, (zero).kind, (zero).id, (zero).ival, (zero).name, (zero).qbe_type);
}

// ════════════════════════════════════════════════════
// cg_stmt — 薄包装（cg_expr 内部已合并所有 stmt cases：LET/ASSIGN/RETURN/
// BREAK/CONTINUE/EXPR_STMT。jhyy 无 forward decl → 必须单一定义 cg_expr
// 不能互相递归。cg_func 等外部调用方继续走 cg_stmt 接口，IRVal 自动丢弃。）
// ════════════════════════════════════════════════════

fn cg_stmt(cg_raw: *u8, n: *Node) -> i32 {
    if n == (0 as *Node) {
        return 0;
    }
    cg_expr(cg_raw, n);
    return 1;
}

// ════════════════════════════════════════════════════
// cg_emit_const_prim_data — emit a single primitive const data item
// ════════════════════════════════════════════════════

fn cg_emit_const_prim_data(ir: *IRBuf, e: *Node, t: *Type) -> i32 {
    let qt = qbe_type_of(t as *u8);
    let mut val: i64 = 0 as i64;
    let ek = (*e).kind;
    if ek == NODE_INT() {
        let nd = node_int_data(e);
        val = (*nd).value;
    } else if ek == NODE_BOOL() {
        let bd = node_bool_data(e);
        if (*bd).value != 0 {
            val = 1 as i64;
        } else {
            val = 0 as i64;
        }
    } else if ek == NODE_FLOAT() {
        val = 0 as i64;
    } else {
        val = 0 as i64;
    }
    ir_emit_data_int(ir, "%c " as *u8, qt);
    ir_emit_data_lld(ir, "%lld" as *u8, val);
    return 1;
}

// ════════════════════════════════════════════════════
// cg_const_data_prim_val — extract int/bool value from a const-data literal node.
//   v0.9 wip commit 2.20: cg_module Pass A 内联 helper, 取 NODE_INT/BOOL value
//   (KIND_PRIMITIVE const 数组元素)。返回 i64 (默认 0 if 非 literal)。
fn cg_const_data_prim_val(e: *Node) -> i64 {
    let ek = (*e).kind;
    if ek == NODE_INT() {
        let nd = node_int_data(e);
        return (*nd).value;
    }
    if ek == NODE_BOOL() {
        let bd = node_bool_data(e);
        return (*bd).value as i64;
    }
    return 0 as i64;
}

// cg_emit_const_data_elem — recursive helper for Pass A
// ════════════════════════════════════════════════════

fn cg_emit_const_data_elem(ir: *IRBuf, e: *Node, t: *Type, first_ptr: *u8) -> i32 {
    let first_slot = first_ptr as *i32;
    if (*first_slot) == 0 {
        ir_emit_data_str(ir, ", " as *u8);
    }
    if (*t).kind == KIND_STRUCT() {
        let sl = node_struct_lit_data(e);
        let mut si: i64 = 0 as i64;
        while si < (*t).nfields {
            if si > 0 {
                ir_emit_data_str(ir, ", " as *u8);
            }
            let fdesc = ptr_add_u8((*t).fields, si * FIELD_DESC_SIZE()) as *u8;
            let fdesc_t = fdesc as *FieldDesc;
            let fname_sym = (*fdesc_t).name;
            let mut fval: *Node = 0 as *Node;
            let mut fj: i64 = 0 as i64;
            while fj < (*sl).nfields {
                let sf_entry_slot = ptr_add_u8((*sl).fields, fj * NODE_FIELD_INIT_SIZE()) as *NodeFieldInit;
                let sf_name = (*sf_entry_slot).name;
                if strcmp(sf_name, fname_sym as *u8) == 0 {
                    fval = (*sf_entry_slot).value as *Node;
                    break;
                }
                fj = fj + (1 as i64);
            }
            let ft_raw = (*fdesc_t).type_;
            let ft = ft_raw as *Type;
            if fval != (0 as *Node) {
                cg_emit_const_prim_data(ir, fval, ft);
            } else {
                let ft_qt = qbe_type_of(ft_raw);
                ir_emit_data_int(ir, "%c " as *u8, ft_qt);
                ir_emit_data_lld(ir, "0" as *u8, 0 as i64);
            }
            si = si + (1 as i64);
        }
        (*first_slot) = 0 as i32;
        return 1;
    } else {
        cg_emit_const_prim_data(ir, e, t);
        (*first_slot) = 0 as i32;
        return 1;
    }
}
// ════════════════════════════════════════════════════
// cg_func — emit 一整个函数定义（含 header / locals / body / ret）
// ════════════════════════════════════════════════════

// v1.0.0 阶段简化：sret 重置 cg.sret_slot（保持 jhyy 多遍编译稳定）；
// 每个函数 arena_alloc 一组 loop label arrays（jhyy 不支持 fixed-size struct field）。
// cg_body_returns 定义移到 cg_expr 之前（v1.0.0 sprint 5：NODE_IF 也用）

// cg_func — emit 一整个函数定义（含 header / locals / body / ret）
// v1.3.5: 加 inline_fns + n_inline_fns 参数 — cg_module pass A 构建的 #[inline] fn 表;
//   call site 用 cg_find_inline_decl 查表决定是否 in-place 展开 fn body。
// v2.8.2 W-070: 加 target_tag 参数 — 驱动 cg_func 内 4 dispatch sites
//   (header emit + 3 return emit sites) 调 abi_win_* vs abi_sysv_*。
fn cg_func(cg_raw: *u8, n: *Node, inline_fns: *u8, n_inline_fns: i64, target_tag: i32) -> i32 {
    if n == (0 as *Node) { return 0; }
    let cg = cg_raw as *CGContext;
    let ir = (*cg).ir as *IRBuf;
    let fd = node_func_decl_data(n);
    if fd == (0 as *u8) { return 0; }
    if (*fd).is_extern != (0 as i32) {
        // W-070 v2.8.2: target_tag passed-through, also threaded via CGContext.
        return 0;
    }
    // W-070 v2.8.2: cg_func 内统一 dispatch helper. Win path (0/1) → else branch
    //   走 abi_win_* (跟 v2.8.0 ship 行为字节相同, byte-equal hold)。SysV (2/3) →
    //   abi_sysv_* emit。
    let is_sysv = (target_tag == TARGET_AMD64_SYSV() || target_tag == TARGET_AMD64_SYSV_FREESTANDING()) as i32;

    // v3.2.0c (3i fn path): skip generic fn body (ntype_params > 0); cloned
    //   instances (ntype_params == 0) walk the normal emit path.
    //   offset access (per v3.2.0b mitigation): ntype_params @ NodeFuncDecl offset 88.
    let fd_off2 = fd as i64;
    let ntp_off2 = (fd_off2 + (88 as i64)) as *i64;
    if *ntp_off2 > (0 as i64) {
        return 1;
    }
    let fd_sym_raw = (*fd).sym;
    if fd_sym_raw == (0 as *u8) {
        return 0;
    }
    let fd_sym = fd_sym_raw as *Sym;
    let mut ret_type: *u8 = 0 as *u8;
    if (*fd_sym).type_ptr != (0 as *u8) {
        let fst = (*fd_sym).type_ptr as *Type;
        if (*fst).kind == KIND_FUNC() {
            ret_type = (*fst).ret;
        }
    }
    let mut is_sret: i32 = 0;
    let mut ret_qt: i32 = 0 as i32;
    if ret_type != (0 as *u8) {
        let rt = ret_type as *Type;
        // W-114:enum 的返回也走 sret(ABI § 3.3)—— 与调用侧必须一致。
        if (*rt).kind == KIND_STRUCT() || (*rt).kind == KIND_ENUM() {
            is_sret = 1;
        } else {
            // v2.1.0 Stage 1c.1: abi_win_classify_arg centralises type-letter
            // selection (struct → l, large enum → l, primitive via qbe_type_of).
            // Replaces the prior qbe_type_of inline call.
            ret_qt = abi_win_classify_arg(ret_type);
        }
    }

    // emit function header
    // v2.1.0 Stage 1c.2: abi_win_emit_function_header owns the QBE signature
    // line + @start label. Replaces the prior inline 50-line header block.
    let nparams = (*fd).nparams;
    // W-070 v2.8.2: dispatch header emit Win vs SysV. Win path (is_sysv=0) 走
    //   abi_win_emit_function_header (跟 v2.8.0 ship 行为字节相同);SysV (is_sysv=1)
    //   走 abi_sysv_emit_function_header (v2.7.0 ship ABI module 真 emit)。
    // v3.0.2 (3b naked): naked fns skip QBE export entirely (用 emit_naked_func_header
    //   emit `.globl + label`, body 走 cg_expr NODE_ASM_BLOCK 进 D42 side-file)。
    let mut _hdr: i32 = 0 as i32;
    if is_sysv == 1 {
        _hdr = abi_sysv_emit_function_header(ir, fd_sym, ret_qt, is_sret, (*fd).params, nparams);
    } else if (*fd).is_naked != (0 as i32) {
        // v3.0.2 (3b naked): naked fns skip QBE export entirely. The asm body
        // is emitted to the D42 side-file (_inline_asm.buf) via cg_expr NODE_ASM_BLOCK.
        // QBE sees no declaration for the naked fn → no generated .s symbol →
        // linker resolves `call naked_fn` (from QBE-emitted code in callers) to
        // the `.globl naked_fn` + `naked_fn:` declared in the raw asm side-file.
        _hdr = emit_naked_func_header(ir, fd_sym);
    } else {
        _hdr = abi_win_emit_function_header(ir, fd_sym, ret_qt, is_sret, (*fd).params, nparams);
    }

    // reset cg (per-function)
    (*cg).current_ret_type = ret_type;
    (*cg).has_sret = is_sret;
    (*cg).loop_depth = 0;
    (*cg).nlocals = 0;
    (*cg).current_fn = fd as *u8;  /* v1.3.6: cg_emit_defers reads fd->defers in cg_stmt NODE_RETURN */
    // v1.3.5: #[inline] table + recursion guard. Set current_inline_sym to fd->sym
    //   so calls to fd from within its own body fall back to `call $fn` instead of
    //   recursing inline (would infinite-expand).
    (*cg).inline_fns = inline_fns;
    (*cg).n_inline_fns = n_inline_fns;
    (*cg).current_inline_sym = fd_sym_raw;

    // v1.4.2: reset last_dbg_line for the new function. The first cg_expr call
    //   will emit the appropriate dbgloc based on the first stmt/expr's source
    //   line. (Don't emit from cg_func — it would be redundant with cg_expr's
    //   first emit if the body starts on the same line as the decl, AND wasteful
    //   if it starts on a later line.)
    (*cg).last_dbg_line = 0;

    // arena alloc loop label arrays
    (*cg).loop_starts = arena_alloc((*ir).arena, 32 as i64 * IRVAL_SIZE());
    (*cg).loop_ends = arena_alloc((*ir).arena, 32 as i64 * IRVAL_SIZE());
    (*cg).loop_continues = arena_alloc((*ir).arena, 32 as i64 * IRVAL_SIZE());

    // register sret slot if needed
    if is_sret != 0 {
        let sr = *ir_new_tmp(ir, QBE_L());
        (*cg).sret_slot_id = sr.id as i64;
        ir_emit_str(ir, "    %t" as *u8);
        ir_emit_int(ir, "%d" as *u8, sr.id);
        ir_emit_str(ir, " =l copy %ret\n" as *u8);
    }

    // register params as locals
    let mut pi: i64 = 0 as i64;
    while pi < nparams {
        let param_slot2 = ptr_add_u8((*fd).params, pi * NODE_FUNC_DECL_PARAM_SIZE()) as *NodeFuncDeclParam;
        let p2_sym_raw = (*param_slot2).sym;
        let p2_sym = p2_sym_raw as *Sym;
        let mut pt2: *u8 = 0 as *u8;
        if (*p2_sym).type_ptr != (0 as *u8) {
            pt2 = (*p2_sym).type_ptr;
        }
        let mut pq: i32 = QBE_W();
        if pt2 != (0 as *u8) {
            // v2.1.0 Stage 1c.1: abi_win_classify_arg centralises the
            // type-letter selection (struct → l, large enum → l, primitive
            // via qbe_type_of). Replaces the prior inline ternary.
            pq = abi_win_classify_arg(pt2);
        }
        let pv = *ir_new_tmp(ir, pq);
        // W-104 (2026-10-19):struct 参数在 SysV 下按 eightbyte 拆成多个 IL
        // 参数(签名见 abi_sysv_emit_function_header)。这里要把它们**重建**
        // 回一个连续的 struct 槽,并让 param 的局部指向该槽 —— body 里
        // `loadw %pv` / `add %pv, 8` 就能照常按偏移取字段。
        //
        // 重建方式与 gcc 一致(gcc 的 callee 也是把八个byte存回栈槽):
        //   %pv =l alloc16 <size>       ← struct 槽
        //   store<qt> %<name>__e<k>, %pv (+ k*8)
        // ⚠️ 只有 **SysV** 才做 eightbyte 重建 —— Win x64 的 struct 传参规则
        // 完全不同(>8B 走间接:传指针;≤8B 走寄存器),不能套用 SysV 的切分。
        let mut n_eb2: i64 = 0 as i64;
        if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
            n_eb2 = abi_sysv_struct_n_eightbytes(pt2);
        }
        let mut is_mem2: i32 = 0 as i32;
        if (*cg).target_tag == TARGET_AMD64_SYSV() || (*cg).target_tag == TARGET_AMD64_SYSV_FREESTANDING() {
            is_mem2 = abi_sysv_struct_is_memory(pt2);
        }
        if is_mem2 != (0 as i32) {
            let msize = type_size(pt2 as *Type);
            let mv = *ir_new_tmp(ir, QBE_L());
            ir_emit_alloc(ir, mv, msize as i32);
            let mut mem_k2: i64 = 0 as i64;
            while mem_k2 < abi_sysv_struct_mem_slots(pt2) {
                let maddr = *ir_new_tmp(ir, QBE_L());
                let moff = mem_k2 * (8 as i64);
                if moff > (0 as i64) {
                    ir_emit_binary(ir, maddr, "add" as *u8, mv, ir_new_int(moff));
                } else {
                    ir_emit_str(ir, "    %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, maddr.id);
                    ir_emit_str(ir, " =l copy %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, mv.id);
                    ir_emit_str(ir, "
" as *u8);
                }
                let msrc = *ir_new_tmp(ir, QBE_L());
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, msrc.id);
                ir_emit_str(ir, " =l copy %" as *u8);
                ir_emit_str(ir, (*p2_sym).name);
                ir_emit_str(ir, "__m" as *u8);
                ir_emit_int(ir, "%d" as *u8, mem_k2);
                ir_emit_str(ir, "
" as *u8);
                ir_emit_store(ir, QBE_L(), msrc, maddr);
                mem_k2 = mem_k2 + (1 as i64);
            }
            cg_add_local(cg_raw, p2_sym_raw, mv, 0);
        } else if n_eb2 > (0 as i64) {
            let ssize = type_size(pt2 as *Type);
            let pv2 = *ir_new_tmp(ir, QBE_L());
            // ⚠️ 必须用 ir_emit_alloc:它输出 `alloc<align> <size>` —— 手工拼
            // "alloc" + "%d" 会把 size 拼成**类型标记**(`alloc16` 而不是
            // `alloc16 16`),槽只有 8 字节却被写入 16 字节 → 踩坏栈 → SEGV。
            ir_emit_alloc(ir, pv2, ssize as i32);
            let mut k2: i64 = 0 as i64;
            while k2 < n_eb2 {
                let eoff = k2 * (8 as i64);
                let eaddr = *ir_new_tmp(ir, QBE_L());
                if eoff > (0 as i64) {
                    ir_emit_binary(ir, eaddr, "add" as *u8, pv2, ir_new_int(eoff));
                } else {
                    ir_emit_str(ir, "    %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, eaddr.id);
                    ir_emit_str(ir, " =l copy %t" as *u8);
                    ir_emit_int(ir, "%d" as *u8, pv2.id);
                    ir_emit_str(ir, "
" as *u8);
                }
                // 源:IL 参数 %<name>__e<k>(self-backend 把它从参数寄存器搬进栈槽)
                // temp 的 qt 必须与该 eightbyte 的字母一致 —— SSE 的 temp 是
                // XMM-backed,用 l 会把 f64 的位模式当整数搬。
                let eqt = abi_sysv_eightbyte_letter(pt2, k2);
                let esrc = *ir_new_tmp(ir, eqt);
                ir_emit_str(ir, "    %t" as *u8);
                ir_emit_int(ir, "%d" as *u8, esrc.id);
                ir_emit_str(ir, " =" as *u8);
                ir_emit_int(ir, "%c" as *u8, eqt);
                ir_emit_str(ir, " copy %" as *u8);
                ir_emit_str(ir, (*p2_sym).name);
                ir_emit_str(ir, "__e" as *u8);
                ir_emit_int(ir, "%d" as *u8, k2);
                ir_emit_str(ir, "
" as *u8);
                ir_emit_store(ir, eqt, esrc, eaddr);
                k2 = k2 + (1 as i64);
            }
            cg_add_local(cg_raw, p2_sym_raw, pv2, 0);
        } else {
            ir_emit_str(ir, "    %t" as *u8);
            ir_emit_int(ir, "%d" as *u8, pv.id);
            ir_emit_str(ir, " =" as *u8);
            ir_emit_int(ir, "%c" as *u8, pq);
            ir_emit_str(ir, " copy %" as *u8);
            ir_emit_str(ir, (*p2_sym).name);
            ir_emit_str(ir, "
" as *u8);
            cg_add_local(cg_raw, p2_sym_raw, pv, 0);
        }
        pi = pi + (1 as i64);
    }

    // body
    // v3.0.2 (3b naked): body still goes through cg_expr so asm!() stmts get
    // their text appended to the side-file via NODE_ASM_BLOCK handler.
    // But the standard QBE epilogue (cg_body_returns check + abi_win_emit_return
    // + closing brace) is skipped — naked fn has no QBE IR, just side-file.
    let body_val = *cg_expr(cg_raw, (*fd).body as *Node);

    if (*fd).is_naked == (0 as i32) {
        // body_returns check
        let body_returns: i32 = cg_body_returns((*fd).body as *Node);

        if body_returns == 0 {
            if is_sret != 0 {
                // 用 IRVal literal (struct 构造) 包 sret_slot_id, 避免读
                // (*cg).sret_slot 触发 bug 8 struct-to-buffer copy
                let sret_addr = IRVal { kind: 0, id: (*cg).sret_slot_id as i32, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
                // Sprint 4.25 W-005 #2 真修: body_val is sentinel IRVal{id=0} when
                // `cg_body_returns()` is syntactic-only (e.g. body is `if c { return A }
                // else { return B }` — both arms terminate, but the if-expression
                // still produces a value, and codegen returns the pre-return then_val
                // which was never overwritten). Without this guard, cg_copy_agg
                // emits `copy %t0` and QBE rejects the whole function.
                if irval_is_undef(body_val) == 0 {
                    // W-114:enum 的 sret 拷的是**内存映像**,不是地址
                    let mut _is_enum_ret2: i32 = 0;
                    if ret_type != (0 as *u8) {
                        let rt2 = ret_type as *Type;
                        if (*rt2).kind == KIND_ENUM() { _is_enum_ret2 = 1 as i32; }
                    }
                    if _is_enum_ret2 != (0 as i32) {
                        let _ce = cg_copy_enum(cg_raw, ret_type, sret_addr, body_val);
                    } else {
                        let _copy = cg_copy_agg(cg_raw, ret_type, sret_addr, body_val);
                    }
                }
            }
            // v3.1.4 W-068 真修 v2 (codegen merge artifact): emit ONE fallback ret
            //   (sentinel), already dispatching Win vs SysV. OLD logic emitted
            //   sret/value/void branch ABOVE then a second sentinel ret BELOW,
            //   causing QBE "label or } expected" error (double ret).
            // W-070 v2.8.2: dispatch Win vs SysV.
            let v = IRVal { kind: 0, id: 0, ival: 0 as i64, name: 0 as *u8, qbe_type: 0 };
            let mut _r: i32 = 0 as i32;
            if is_sysv == 1 {
                if is_sret != 0 {
                    _r = abi_sysv_emit_return(ir, v, 1);
                } else if ret_qt != (0 as i32) {
                    _r = abi_sysv_emit_return(ir, body_val, 0);
                } else {
                    _r = abi_sysv_emit_return(ir, v, 0);
                }
            } else {
                if is_sret != 0 {
                    _r = abi_win_emit_return(ir, v, 1);
                } else if ret_qt != (0 as i32) {
                    _r = abi_win_emit_return(ir, body_val, 0);
                } else {
                    _r = abi_win_emit_return(ir, v, 0);
                }
            }
        } else if ret_qt != (0 as i32) {
            // v3.1.4 W-068 真修 v2 (codegen merge artifact): body already returned,
            //   so the actual `ret %val` was emitted by cg_expr NODE_RETURN.
            //   Do NOT emit another sentinel ret here — that produces duplicate `ret`
            //   and QBE rejects with "label or } expected".
            //   Original pre-W-070 logic: just close the function. Kept empty.
        } else {
            // v3.1.4 W-068 真修 v2: same — body already returned (void).
            //   Original pre-W-070 logic: just close the function. Kept empty.
        }

        ir_emit_str(ir, "}\n\n" as *u8);
    }
    // Naked fn: no QBE epilogue. The side-file raw asm body (appended by
    // cg_expr NODE_ASM_BLOCK) ends with the asm!() statements — caller is
    // responsible for emitting `ret` / `iret` / etc. as needed (validated by
    // sema check_naked_body that body has asm!() stmts).
    return 1;
}

// ════════════════════════════════════════════════════
// cg_module — Pass A const data + Pass B function emit
// ════════════════════════════════════════════════════

fn cg_module(ir: *IRBuf, module: *Node, t: i32) -> i32 {
    if module == (0 as *Node) {
        return 0;
    }
    // v2.0.0 target dispatch (Sprint A Stage 1). Amd64Win keeps full v1.x
    // path (fall through to the unchanged body below); other targets fatal
    // at entry pointing at the version where they ship. ABI 抽离 = v2.1.0;
    // amd64_sysv = v2.7.0 Phase 2b. Return 0 on fatal (jhyy convention: 1=success,
    // 0=error) so build_il's if-cascade check propagates without QBE/gcc.
    if t == TARGET_AMD64_WIN_FREESTANDING() {
        // v2.1.0 Stage 2: abi_fs_emit_entry_point + abi_fs_no_crt_init are
        // no-ops (real UEFI EFIAPI wrapper + lld-link /subsystem:efi land in
        // v2.3.0). We still need to call them somewhere so the dispatch site
        // has a single chokepoint — call here at module top, fall through
        // to default body which uses abi_win_* (D-GUI-12: hosted vs
        // freestanding MS x64 signature is byte-identical for v2.1.0).
        let _e = abi_fs_emit_entry_point(ir, "main_jhyy" as *u8);
        let _n = abi_fs_no_crt_init();
    }
    // W-070 v2.8.2: SYSV_FREESTANDING prefix calls (mirror WIN_FREESTANDING
    //   pattern above). abi_fs_sysv_emit_entry_point + abi_fs_sysv_no_crt_init
    //   当前 no-op stub (real QBE IL _start block emit 留 v2.x 末 N 代 fixed point)。
    //   然后 fall through 到 default body (cg_func/cg_expr 内 is_sysv dispatch
    //   自动走 abi_sysv_* path)。
    if t == TARGET_AMD64_SYSV_FREESTANDING() {
        let _e2 = abi_fs_sysv_emit_entry_point(ir, "main_jhyy" as *u8);
        let _n2 = abi_fs_sysv_no_crt_init();
    }
    // W-070 v2.8.2: SYSV (hosted) 无 prefix,直接 fall through to default body。
    //   旧 stub-fatal 已删除: cg_func/cg_expr 内 is_sysv dispatch 现在能调
    //   abi_sysv_emit_function_header / abi_sysv_emit_return /
    //   abi_sysv_emit_call_prelude / abi_sysv_emit_struct_arg_slot。
    // (no if for TARGET_AMD64_SYSV — directly fall through)
    let md = node_module_data(module);
    let ndeccls = (*md).ndeccls;
    // v3.0.0 (3d no_std): flag indicates `#[no_std]` module attr was set.
    // When 1, we emit `.note.GNU-stack noalloc` and write a side-file flag
    // so main.jhyy's link step switches to `-nostartfiles -nodefaultlibs`.
    // The default path (is_no_std==0) is byte-identical to the v2.4.0 IL.
    let is_no_std: i32 = (*md).is_no_std;

    // alloc CGContext + locals arena block（一次性；每 func 进 cg_func reset nlocals）
    let cg_buf = arena_alloc((*ir).arena, CGCONTEXT_SIZE());
    let cg_ptr = cg_buf as *CGContext;
    (*cg_ptr).ir = ir as *u8;
    let locals_buf = arena_alloc((*ir).arena, (MAX_LOCALS() as i64) * LOCALENTRY_SIZE());
    (*cg_ptr).locals = locals_buf;
    let cg_raw: *u8 = cg_ptr as *u8;

    // v1.4.2: emit `dbgfile "<source>"` for DWARF line info.
    //   QBE: dbgfile → .file N "<name>" in .s. jhyy 端: codegen 知道 module.loc_filename
    //   (parser 透传 lexer 的 filename),所以直接 emit. C-side mirror 同步 (per W-018).
    (*cg_ptr).last_dbg_line = 0;
    (*cg_ptr).dbg_file_emitted = 0;
    // W-070 v2.8.2: target_tag write-through to CGContext for cg_func/cg_expr
    //   dispatch (cg_func reads (*cg).target_tag internally too for return sites
    //   not taking target_tag param).
    (*cg_ptr).target_tag = t;
    // v1.4.6 W-017: initialize mod_globals dict to empty (NULL ptr + 0 count/cap)
    (*cg_ptr).mod_globals = 0 as *u8;
    (*cg_ptr).n_mod_globals = 0;
    (*cg_ptr).cap_mod_globals = 0;
    if (*module).loc_filename != (0 as *u8) {
        if cg_dbg_emit_file(ir, (*module).loc_filename) != 0 {
            (*cg_ptr).dbg_file_emitted = 1;
        }
    }

    // Pass A: emit all const decls as .data section
    //   v0.9 wip commit 2.20 / Task #52 + #42 合并 (const_array.jhyy 测试依赖此路径)
    //   对齐 C 端 codegen.c:1733-1750 (cg_module Pass A)
    //   inline emit: const_array.jhyy 用纯 int 数组,只走 prim_data 路径
    //   (cg_emit_const_data_elem 递归 helper 在 jhyy 端有 first_slot 栈共享问题)
    //   loop bound = max(count, (*arr).nelems) 防御:防止 arr_count 或 nelems 任一为 0
    let mut di_a: i64 = 0 as i64;
    while di_a < ndeccls {
        let d_slot_a = ptr_add_u8((*md).decls, di_a * (8 as i64)) as **Node;
        let d_node_a = *d_slot_a;
        if d_node_a == (0 as *Node) { di_a = di_a + (1 as i64); } else {
        if (*d_node_a).kind == NODE_CONST_DECL() {
            let d_a = node_const_decl_data(d_node_a);
            let arr_t_raw = (*((*d_a).sym as *Sym)).type_ptr;
            if arr_t_raw != (0 as *u8) {
                let arr_t = arr_t_raw as *Type;
                if (*arr_t).kind == KIND_ARRAY() {
                    let elem_t = (*arr_t).elem as *Type;
                    let count = (*arr_t).arr_count;
                    let init_raw = (*d_a).init;
                    if init_raw != (0 as *u8) {
                        // BUG 真修: 必须走 node_array_lit_data 加 NODE_SIZE 偏移, 跟 C 端 cg_module 一致
                        //   (对齐 v0 codegen.c:1742 — 不能直接 cast init_raw as *NodeArrayLit)
                        let arr = node_array_lit_data(init_raw as *Node);
                        let arr_elems = (*arr).elems;
                        let arr_n = (*arr).nelems;
                        // 取 max(count, arr_n) 作为 loop bound
                        let mut bound: i64 = count;
                        if arr_n > bound {
                            bound = arr_n;
                        }
                        ir_emit_data_str(ir, "data $" as *u8);
                        ir_emit_data_str(ir, (*((*d_a).sym as *Sym)).name);
                        ir_emit_data_str(ir, " = { " as *u8);
                        let mut first_d: i32 = 1 as i32;
                        let mut j: i64 = 0 as i64;
                        while j < bound {
                            if j < arr_n {
                                let e_slot = ptr_add_u8((*arr).elems, j * (8 as i64)) as **Node;
                                let e_node = *e_slot;
                                if (*elem_t).kind == KIND_STRUCT() {
                                    // struct elem: emit each field value (QBE data 是 flat 平铺)
                                    // 对齐 v0 codegen.c:1702-1724 cg_emit_const_data_elem。
                                    // 用 first_d 控逗号而不是逐 elem 跳，避免 nested field 与 next elem 之间漏逗号。
                                    let sl = node_struct_lit_data(e_node);
                                    let mut si: i64 = 0 as i64;
                                    while si < (*elem_t).nfields {
                                        let fdesc = ptr_add_u8((*elem_t).fields, si * FIELD_DESC_SIZE()) as *u8;
                                        let fdesc_t = fdesc as *FieldDesc;
                                        // FieldDesc.name 是 *Sym（W-008 fix 注释: deref 拿 name *u8）
                                        let fdesc_name_sym = (*fdesc_t).name as *Sym;
                                        let fdesc_name_str = (*fdesc_name_sym).name;
                                        let mut fval: *Node = 0 as *Node;
                                        let mut fj: i64 = 0 as i64;
                                        while fj < (*sl).nfields {
                                            let sf_entry = ptr_add_u8((*sl).fields, fj * NODE_FIELD_INIT_SIZE()) as *NodeFieldInit;
                                            let sf_name = (*sf_entry).name;
                                            if strcmp(sf_name, fdesc_name_str) == 0 {
                                                fval = (*sf_entry).value as *Node;
                                                break;
                                            }
                                            fj = fj + (1 as i64);
                                        }
                                        let ft_raw = (*fdesc_t).type_;
                                        let ft = ft_raw as *Type;
                                        if first_d == 0 {
                                            ir_emit_data_str(ir, ", " as *u8);
                                        }
                                        if fval != (0 as *Node) {
                                            cg_emit_const_prim_data(ir, fval, ft);
                                        } else {
                                            let ft_qt = qbe_type_of(ft_raw);
                                            ir_emit_data_int(ir, "%c " as *u8, ft_qt);
                                            ir_emit_data_lld(ir, "0" as *u8, 0 as i64);
                                        }
                                        first_d = 0 as i32;
                                        si = si + (1 as i64);
                                    }
                                } else {
                                    let val: i64 = cg_const_data_prim_val(e_node);
                                    if first_d == 0 {
                                        ir_emit_data_str(ir, ", " as *u8);
                                    }
                                    let qt = data_qt_of(elem_t as *u8);
                                    ir_emit_data_int(ir, "%c " as *u8, qt);
                                    ir_emit_data_lld(ir, "%lld" as *u8, val);
                                    first_d = 0 as i32;
                                }
                            }
                            j = j + (1 as i64);
                        }
                        ir_emit_data_str(ir, " }\n" as *u8);
                    }
                }
            }
        }
        // v1.4.6 W-017: module-level `let mut g_x: T = expr;` → emit QBE data
        //   section + register in mod_globals dict. Init expr folded into data
        //   section when NODE_INT literal; otherwise zero-init (TODO future sprint).
        else if (*d_node_a).kind == NODE_LET() {
            let d_l = node_let_data(d_node_a);
            let d_l_sym_raw = (*d_l).sym;
            if d_l_sym_raw != (0 as *u8) {
                let d_l_t_raw = (*(d_l_sym_raw as *Sym)).type_ptr;
                if d_l_t_raw != (0 as *u8) {
                    let d_l_t = d_l_t_raw as *Type;
                    if (*d_l_t).kind == KIND_PRIMITIVE() {
                        let qt = qbe_type_of(d_l_t_raw);
                        if qt != (0 as i32) {
                            ir_emit_data_str(ir, "data $" as *u8);
                            ir_emit_data_str(ir, (*(d_l_sym_raw as *Sym)).name);
                            ir_emit_data_str(ir, " = { " as *u8);
                            ir_emit_data_int(ir, "%c" as *u8, qt);
                            ir_emit_data_str(ir, " " as *u8);
                            let d_l_init_raw = (*d_l).init;
                            if d_l_init_raw != (0 as *u8) {
                                let d_l_init = d_l_init_raw as *Node;
                                if (*d_l_init).kind == NODE_INT() {
                                    let d_l_int_val = (*(node_int_data(d_l_init))).value;
                                    ir_emit_data_lld(ir, "%lld" as *u8, d_l_int_val);
                                } else {
                                    ir_emit_data_str(ir, "0" as *u8);
                                }
                            } else {
                                ir_emit_data_str(ir, "0" as *u8);
                            }
                            ir_emit_data_str(ir, " }\n" as *u8);
                            // build qbe_name = "$g_x" via arena sprintf + register
                            let name_str = (*(d_l_sym_raw as *Sym)).name;
                            let name_len = strlen(name_str);
                            let qbe_name = arena_alloc((*ir).arena, (name_len + (2 as i64)) as i64);
                            *(qbe_name as *i32) = 36; // '$'
                            let mut ci: i64 = 0 as i64;
                            while ci < name_len {
                                *(ptr_add_u8(qbe_name, (1 as i64) + ci) as *i32) =
                                    *(ptr_add_u8(name_str, ci) as *i32);
                                ci = ci + (1 as i64);
                            }
                            *(ptr_add_u8(qbe_name, (1 as i64) + name_len) as *i32) = 0; // NUL
                            let _reg = cg_mod_global_register(cg_raw, d_l_sym_raw, qbe_name, qt);
                        }
                    }
                }
            }
        }
        }  // close else from NULL guard
        di_a = di_a + (1 as i64);
    }

    // v1.3.5: build #[inline] fn table. Pass A pass — collect all
    //   NODE_FUNC_DECL with is_inline=1. Used by cg_expr NODE_CALL / NODE_QUALIFIED_CALL.
    let mut n_inline: i64 = 0 as i64;
    let mut di_a2: i64 = 0 as i64;
    while di_a2 < ndeccls {
        let ds = ptr_add_u8((*md).decls, di_a2 * (8 as i64)) as **Node;
        let dn = *ds;
        if dn != (0 as *Node) {
            if (*dn).kind == NODE_FUNC_DECL() {
                let fd_p = node_func_decl_data(dn);
                if (*fd_p).is_inline != (0 as i32) {
                    n_inline = n_inline + (1 as i64);
                }
            }
        }
        di_a2 = di_a2 + (1 as i64);
    }
    let mut inline_fns_raw: *u8 = 0 as *u8;
    if n_inline > (0 as i64) {
        inline_fns_raw = arena_alloc((*ir).arena, n_inline * NODE_FUNC_DECL_SIZE() as i64);
        let mut k: i64 = 0 as i64;
        let mut di_a3: i64 = 0 as i64;
        while di_a3 < ndeccls {
            let ds2 = ptr_add_u8((*md).decls, di_a3 * (8 as i64)) as **Node;
            let dn2 = *ds2;
            if dn2 != (0 as *Node) {
                if (*dn2).kind == NODE_FUNC_DECL() {
                    let fd_p2 = node_func_decl_data(dn2);
                    if (*fd_p2).is_inline != (0 as i32) {
                        let slot = ptr_add_u8(inline_fns_raw, k * NODE_FUNC_DECL_SIZE() as i64) as *NodeFuncDecl;
                        *slot = *fd_p2;
                        k = k + (1 as i64);
                    }
                }
            }
            di_a3 = di_a3 + (1 as i64);
        }
    }

    // W-069 v2.6.6: build fn name → pre-mangled qbe name table. Mirrors C-side
    //   cg_module Pass A.5 (codegen.c:2576-2593). All NODE_FUNC_DECL with
    //   is_extern=0 register (name, "<mod>__<name>") so NODE_CALL is_extern
    //   branch can fall back to mangle when caller module mis-declared a .jhyy
    //   fn as `extern fn`. cg_fn_defs_clear first to support multiple cg_module
    //   invocations per process (Stage 2 chain: jhyy_v1→v2→v3→v4 each compile
    //   different modules). Upper bound = ndeccls (some decls may be non-fns).
    cg_fn_defs_clear(cg_raw);
    if ndeccls > (0 as i64) {
        (*cg_ptr).fn_defs = arena_alloc((*ir).arena, ndeccls * FNDEF_SIZE());
        let mut di_a5: i64 = 0 as i64;
        while di_a5 < ndeccls {
            let ds5 = ptr_add_u8((*md).decls, di_a5 * (8 as i64)) as **Node;
            let dn5 = *ds5;
            if dn5 != (0 as *Node) {
                if (*dn5).kind == NODE_FUNC_DECL() {
                    let fd_p5 = node_func_decl_data(dn5);
                    if (*fd_p5).is_extern == (0 as i32) {
                        let fd_sym5 = (*fd_p5).sym;
                        if fd_sym5 != (0 as *u8) {
                            let sym5 = fd_sym5 as *Sym;
                            let name5 = (*sym5).name;
                            let mod5 = (*sym5).module;
                            // Build "<mod>__<name>" via StringBuilder in arena
                            let mut sb5: StringBuilder = StringBuilder {
                                buf: 0 as *u8, len: 0 as i64, cap: 0 as i64
                            };
                            sb_init((*ir).arena, &sb5);
                            if mod5 != (0 as *u8) {
                                sb_append_cstr((*ir).arena, &sb5, mod5);
                                sb_append_cstr((*ir).arena, &sb5, "__" as *u8);
                            }
                            sb_append_cstr((*ir).arena, &sb5, name5);
                            let qbe5 = sb_cstr((*ir).arena, &sb5);
                            cg_fn_defs_register(cg_raw, name5, qbe5);
                        }
                    }
                }
            }
            di_a5 = di_a5 + (1 as i64);
        }
    }

    // Pass B: 逐个 func decl dispatch → cg_func
    let mut di: i64 = 0 as i64;
    // v3.0.4 (3e link_section): open side-file `_section_directive.buf` for
    // writing per-function section directives. main.jhyy reads this after QBE
    // generates the .s and walks the file to insert `.section <name>` lines
    // before each function's label. Format: `<mangled_name>|<section_name>\n`.
    // Skipped for naked fns (they go through `_inline_asm.buf`, not QBE).
    let mut section_fp: *u8 = 0 as *u8;
    // W-136:路径带 pid 后缀 ⇒ 并发编译互不干扰(以前是固定路径 ⇒ 互相截断)
    let section_path = jh_sidefile_path("_section_directive.buf" as *u8);
    let section_open_fp = fopen(section_path, "wb" as *u8);
    if section_open_fp != (0 as *u8) {
        section_fp = section_open_fp;
    }
    while di < ndeccls {
        let d_slot = ptr_add_u8((*md).decls, di * (8 as i64)) as **Node;
        let d_node = *d_slot;
        if d_node == (0 as *Node) { di = di + (1 as i64); } else {
        if (*d_node).kind == NODE_FUNC_DECL() {
            // v3.0.4 (3e link_section): if non-naked fn has link_section,
            // write `<mangled>|<section_name>\n` to side-file BEFORE cg_func.
            // Naked fns skip this — they emit their own .globl + label via
            // _inline_asm.buf and don't appear in QBE .s output.
            let fd_node = node_func_decl_data(d_node);
            if (*fd_node).is_naked == (0 as i32) {
                if (*fd_node).link_section != (0 as *u8) {
                    if section_fp != (0 as *u8) {
                        let fn_sym = (*fd_node).sym as *Sym;
                        let _w1 = fwrite((*fn_sym).name, 1 as i64, strlen((*fn_sym).name), section_fp);
                        let _w2 = fwrite("|" as *u8, 1 as i64, 1 as i64, section_fp);
                        let _w3 = fwrite((*fd_node).link_section, 1 as i64, strlen((*fd_node).link_section), section_fp);
                        let _w4 = fwrite("\n" as *u8, 1 as i64, 1 as i64, section_fp);
                    }
                }
            }
            cg_func(cg_raw, d_node, inline_fns_raw, n_inline, t);
        }
        }  // close else from NULL guard
        di = di + (1 as i64);
    }
    // Close section_directive side-file. main.jhyy unlinks after reading.
    if section_fp != (0 as *u8) {
        let _sc = fclose(section_fp);
    }

    // v3.0.0 (3d no_std): if is_no_std=1, write a side-file marker that
    // main.jhyy reads to switch the link line to
    // `-nostartfiles -nodefaultlibs -Wl,--entry=main`. QBE itself already
    // emits the `.section .note.GNU-stack,"",@progbits` directive in
    // qbe/emit.c:208 for ELF, so we don't need a custom one in the IL.
    // The default path (is_no_std==0) skips this block entirely → IL is
    // byte-identical to v2.4.0 (verified by manual diff; integration test
    // re-checks).
    if is_no_std != (0 as i32) {
        // Side-file flag at compiler/build/obj/_no_std.flag. Use direct
        // fopen "wb" (per feedback_qbe_crlf_root_cause: IL/derived files
        // must use binary mode to avoid Windows \n → \r\n mangling).
        // W-136:同 section_directive —— per-compilation 唯一路径
        let flag_path = jh_sidefile_path("_no_std.flag" as *u8);
        let flag_fp = fopen(flag_path, "wb" as *u8);
        if flag_fp != (0 as *u8) {
            let payload = "no_std\n" as *u8;
            let _w = fwrite(payload, 1 as i64, 7 as i64, flag_fp);
            let _c = fclose(flag_fp);
        }
    }

    return 1;
}
