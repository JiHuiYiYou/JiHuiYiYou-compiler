// mono.jhyy — v3.2.0 (V3-C 3i generics) monomorphize pipeline
//
// 在 sema Pass 1 (decl 注册) 之后,Pass 2 (layout resolve) 之前运行。
// 输入:(*md).generic_insts (parser 累积的 {base_name, mangled_name, [args]})
//      + (*md).decls 里的 generic struct/enum defs (ntype_params > 0)
// 输出:克隆 + substitute 后的 NON-generic decls (ntype_params == 0),
//      append 回 (*md).decls。Pass 2 走现有 layout 路径把它们当普通 struct 处理。
//
// 关键设计(per docs/plans/v3/v3.2.0-plan.md § 3.1 + § Implementation order):
//   1. **Type struct 不动**:monomorphize 用 name-based source cloning,
//      不走 Type.args(type_args → TYPE_SIZE 变 → ABI 全 touch)。
//   2. **AST 扩展已经做完**:NodeTypeDecl / NodeModule 已经加 type_params /
//      ntype_params / generic_insts / ngeneric_insts 字段(在 ast.jhyy)。
//   3. **Sym 不动**:type-param 走 SYM_TYPE + type_ptr=0 哨兵,scope chain
//      让 parser 在 body parse 时能找到。
//   4. **substituter** (`mono_subst_node`):深克隆 AST 子树,NODE_IDENT.sym
//      命中 type-param → 换 arg node (来自 parser 的 arg_types 数组)。
//      非 type-param 节点走结构拷贝。
//   5. **确定性**(D43 closure 要求):
//      - mangled_name 由 parser 用 type_to_string(source-order 拼),已确定
//      - inst 数组 source-discovery-order 由 parser 累积,Pass 1.5 按此顺序处理
//      - dedupe by mangled_name
//   6. **v1.x-subset**:只能用 arena_alloc + offset + let mut。
//      **不能**用 generics/Cap/&mut/PhantomData/v3.1+ feature(C 端 stage-0 不认)。
//      src0/*.jhyy 必须 stage-0 编得过 → bootstrap chain 不能断。
//
// **jhyy 限制**:no forward-refs。函数必须按依赖顺序定义:helpers 在前,
//   public API (mono_expand_module) 在最后 — 否则报 undefined variable。

import arena;
import util;
import ast;
import symtab;

// ════════════════════════════════════════════════════
// Internal — module.decls append (doubling array, no size cap)
// ════════════════════════════════════════════════════

// mono_decls_append — append one decl 到 (*mdd).decls。Doubling array 模式;
//   起始 cap = 16。
//   mdd 参数实际是 *u8(NodeModule 在 arena 的地址),通过 offset 访问字段:
//     decls @ offset 0, ndeccls @ offset 8
fn mono_decls_append(arena: *Arena, mdd: *u8, decl: *Node) {
    let mdd_ndeccls_off = ptr_add_u8(mdd, (8 as i64)) as *i64;
    let mdd_decls_off = mdd as **u8;
    let ndeccls = *mdd_ndeccls_off;
    let decls_ptr = *mdd_decls_off;
    let mut cap = if ndeccls < (16 as i64) {
        (16 as i64)
    } else {
        ndeccls * (2 as i64)
    };
    while cap < ndeccls + (1 as i64) {
        cap = cap * (2 as i64);
    }
    if cap > (65536 as i64) {
        cap = 65536 as i64;
    }
    if cap < ndeccls + (1 as i64) {
        cap = ndeccls + (1 as i64);
    }
    let mut new_decls_ptr: *u8 = decls_ptr;
    if decls_ptr == (0 as *u8) || cap < ndeccls + (1 as i64) {
        let ng = arena_alloc(arena, cap * (8 as i64));
        if decls_ptr != (0 as *u8) {
            if ndeccls > (0 as i64) {
                memcpy(ng, decls_ptr, ndeccls * (8 as i64));
            }
        }
        *mdd_decls_off = ng;
        new_decls_ptr = ng;
    }
    let slot = (new_decls_ptr as i64 +
                ndeccls * (8 as i64)) as **Node;
    *slot = decl;
    *mdd_ndeccls_off = ndeccls + (1 as i64);
    return;
}

// ════════════════════════════════════════════════════
// Internal — generic def lookup by base_name
// ════════════════════════════════════════════════════

// mono_find_generic_def — 遍历 (*md).decls 找 ntype_params > 0 且 sym.name
//   == base_name 的 NODE_TYPE_DECL。
// md is *NodeModule already (caller does `node_module_data(module)` first).
fn mono_find_generic_def(md: *Node, base_name: *u8) -> *Node {
    let mdd = md as *u8;
    let mdd_ndeccls_off = ptr_add_u8(mdd, (8 as i64)) as *i64;
    let mdd_decls_off = mdd as **u8;
    let ndeccls = *mdd_ndeccls_off;
    let decls_ptr = *mdd_decls_off;
    let mut i: i64 = 0 as i64;
    while i < ndeccls {
        let d = *((decls_ptr as i64 + i * (8 as i64)) as **Node);
        if d != (0 as *Node) {
            if (*d).kind == NODE_TYPE_DECL() {
                let td = node_type_decl_data(d);
                // ntype_params @ offset 16 in NodeTypeDecl (sym @ 0 + body @ 8 + ...)
                let td_ntype_params_off = ptr_add_u8(td as *u8, (24 as i64)) as *i64;
                if *td_ntype_params_off > (0 as i64) {
                    // v3.2.0b (3i root cause fix per changelog-v3.2 §6):
                    //   避免 `(*s).name` 跨 fn deref — stage-0 jhyy codegen
                    //   对 56B Sym struct deref 在 deep nested context 触发
                    //   stack-spill 不全(DEFERRED 到 v2.x 末 QBE 自写)。
                    //   改 offset read: Sym.name @ offset 0。
                    let td_sym_off = td as **Sym;
                    let s = *td_sym_off;
                    let s_name = *((s as i64 + (0 as i64)) as **u8);
                    if strcmp(s_name, base_name) == (0 as i32) {
                        return d;
                    }
                }
            }
        }
        i = i + (1 as i64);
    }
    return 0 as *Node;
}

// ════════════════════════════════════════════════════
// Internal — substituter (深 clone + replace NODE_IDENT type-params)
// ════════════════════════════════════════════════════

// mono_subst_node — 深克隆 type AST subtree,把 NODE_IDENT.sym 命中
//   type_params[i] 的节点换成 arg_nodes[i]。非 type-param 节点按结构
//   克隆。
//
// 支持的 node kinds (v3.2.0 scope):
//   NODE_IDENT — 主要目标
//   NODE_UNARY — `*T` 指针包装,inner 递归
//   NODE_ARRAY_TYPE — `[N]T`,elem_type 递归
//   NODE_SLICE_TYPE — `[*]T`,elem_type 递归
//   NODE_REF_TYPE — `&T` / `&mut T`,inner 递归
//   其他 type kinds → 浅 clone (rare)
//
// 字段偏移访问 (避免 struct deref):
//   NodeUnary:    op @0(8), expr @8(8)
//   NodeArray:   elem_type @0(8), count_expr @8(8)
//   NodeSliceT:  elem_type @0(8)
//   NodeRefType: inner @0(8), is_mut @8(4), pad @12(4), lifetime @16(8) → total 24
//   NodeIdent:   sym @0(8)
fn mono_subst_node(arena: *Arena, node: *Node,
                   type_params: *u8, arg_nodes: *u8,
                   nargs: i64) -> *Node {
    if node == (0 as *Node) {
        return 0 as *Node;
    }
    let nk_off = node as *i32;
    let nk = *nk_off;
    if nk == NODE_IDENT() {
        let id_data = (node as i64 + NODE_SIZE()) as *u8;
        let id_sym_off = id_data as **Sym;
        let sym = *id_sym_off;
        // Sym layout: name @0 (8), kind @8 (4), pad @12 (4), type_ptr @16 (8)...
        let sym_name = *((sym as i64 + (0 as i64)) as **u8);
        let name = sym_name;
        let mut found: i64 = -1 as i64;
        let mut k: i64 = 0 as i64;
        while k < nargs {
            let tp = *((type_params as i64 + k * (8 as i64)) as **Sym);
            let tp_name = *((tp as i64 + (0 as i64)) as **u8);
            if strcmp(tp_name, name) == (0 as i32) {
                found = k;
                break;
            }
            k = k + (1 as i64);
        }
        if found >= (0 as i64) {
            let arg = *((arg_nodes as i64 + found * (8 as i64)) as **Node);
            return arg;
        }
        let new_n = ast_new_ident(arena, (*node).loc_filename, (*node).loc_line,
                                  (*node).loc_col, sym);
        return new_n;
    }
    if nk == NODE_UNARY() {
        let un_data = (node as i64 + NODE_SIZE()) as *u8;
        let un_op_off = un_data as *i64;
        let un_expr_off = ptr_add_u8(un_data, (8 as i64)) as **Node;
        let op_val = *un_op_off;
        let new_inner = mono_subst_node(arena, *un_expr_off,
                                        type_params, arg_nodes, nargs);
        return ast_new_unary(arena, (*node).loc_filename, (*node).loc_line,
                             (*node).loc_col, op_val as i32, new_inner);
    }
    if nk == NODE_ARRAY_TYPE() {
        let at_data = (node as i64 + NODE_SIZE()) as *u8;
        let at_elem_off = at_data as **Node;
        let at_count_off = ptr_add_u8(at_data, (8 as i64)) as **Node;
        let new_elem = mono_subst_node(arena, *at_elem_off,
                                       type_params, arg_nodes, nargs);
        return ast_new_array_type(arena, (*node).loc_filename, (*node).loc_line,
                                  (*node).loc_col, new_elem, *at_count_off);
    }
    if nk == NODE_SLICE_TYPE() {
        let st_data = (node as i64 + NODE_SIZE()) as *u8;
        let st_elem_off = st_data as **Node;
        let new_elem = mono_subst_node(arena, *st_elem_off,
                                       type_params, arg_nodes, nargs);
        return ast_new_slice_type(arena, (*node).loc_filename, (*node).loc_line,
                                  (*node).loc_col, new_elem);
    }
    if nk == NODE_REF_TYPE() {
        let rt_data = (node as i64 + NODE_SIZE()) as *u8;
        let rt_inner_off = rt_data as **Node;
        let rt_ismut_off = ptr_add_u8(rt_data, (8 as i64)) as *i32;
        let rt_lifetime_off = ptr_add_u8(rt_data, (16 as i64)) as **Node;
        let new_inner = mono_subst_node(arena, *rt_inner_off,
                                        type_params, arg_nodes, nargs);
        let lt = *rt_lifetime_off;
        return ast_new_ref_type(arena, (*node).loc_filename, (*node).loc_line,
                                (*node).loc_col, new_inner, *rt_ismut_off, lt);
    }
    // 其他:浅 clone,只保留 kind + loc,不复制 variant data
    let buf = arena_alloc(arena, NODE_SIZE());
    let n = ast_init_node(buf, nk,
                          (*node).loc_filename, (*node).loc_line, (*node).loc_col);
    return n;
}

// ════════════════════════════════════════════════════
// Internal — clone struct/enum body + apply subst_node per field/variant
// ════════════════════════════════════════════════════

// mono_clone_struct_def — 深克隆 NODE_STRUCT_DEF,each field's type_annot
//   走 mono_subst_node
//   NodeStructDef layout: fields @0 (8), nfields @8 (8)
//   StructFieldDecl layout: name @0 (8), type_annot @8 (8) = 16
fn mono_clone_struct_def(arena: *Arena, body: *Node,
                         type_params: *u8, arg_nodes: *u8,
                         nargs: i64) -> *Node {
    let sd = node_struct_def_data(body);
    let sd_u8 = sd as *u8;
    let sd_fields_off = sd_u8 as **u8;
    let sd_nfields_off = ptr_add_u8(sd_u8, (8 as i64)) as *i64;
    let nfields = *sd_nfields_off;
    let fields_ptr = *sd_fields_off;
    let new_fields_buf = arena_alloc(arena, nfields * STRUCT_FIELD_DECL_SIZE());
    let mut j: i64 = 0 as i64;
    while j < nfields {
        let fld_off = ptr_add_u8(fields_ptr, j * STRUCT_FIELD_DECL_SIZE());
        // Read fld fields via offset access (avoid struct deref):
        let fld_name = *((fld_off as i64 + (0 as i64)) as **u8);
        let fld_annot = *((fld_off as i64 + (8 as i64)) as **Node);
        let new_annot = mono_subst_node(arena, fld_annot,
                                        type_params, arg_nodes, nargs);
        let nf_off = ptr_add_u8(new_fields_buf,
                                j * STRUCT_FIELD_DECL_SIZE());
        *((nf_off as i64 + (0 as i64)) as **u8) = fld_name;
        *((nf_off as i64 + (8 as i64)) as **u8) = new_annot as *u8;
        j = j + (1 as i64);
    }
    let buf = arena_alloc(arena, NODE_SIZE() + NODE_STRUCT_DEF_SIZE());
    let n = ast_init_node(buf, NODE_STRUCT_DEF(),
                          (*body).loc_filename, (*body).loc_line, (*body).loc_col);
    let nsd = (buf as i64 + NODE_SIZE()) as *u8;
    *((nsd as i64 + (0 as i64)) as **u8) = new_fields_buf;
    *((nsd as i64 + (8 as i64)) as *i64) = nfields;
    return n;
}

// mono_clone_enum_def — 深克隆 NODE_ENUM_DEF,each variant's payload_type
//   走 mono_subst_node
//   NodeEnumDef layout: variants @0 (8), nvariants @8 (8)
//   EnumVariantDecl layout: name @0 (8), payload_type @8 (8) = 16
fn mono_clone_enum_def(arena: *Arena, body: *Node,
                       type_params: *u8, arg_nodes: *u8,
                       nargs: i64) -> *Node {
    let ed = node_enum_def_data(body);
    let ed_u8 = ed as *u8;
    let ed_variants_off = ed_u8 as **u8;
    let ed_nvariants_off = ptr_add_u8(ed_u8, (8 as i64)) as *i64;
    let nvariants = *ed_nvariants_off;
    let variants_ptr = *ed_variants_off;
    let new_variants_buf = arena_alloc(arena, nvariants * ENUM_VARIANT_DECL_SIZE());
    let mut j: i64 = 0 as i64;
    while j < nvariants {
        let vd_off = ptr_add_u8(variants_ptr, j * ENUM_VARIANT_DECL_SIZE());
        let vd_name = *((vd_off as i64 + (0 as i64)) as **u8);
        let vd_payload = *((vd_off as i64 + (8 as i64)) as **u8);
        let mut new_payload: *u8 = 0 as *u8;
        if vd_payload != (0 as *u8) {
            let np = mono_subst_node(arena,
                                     vd_payload as *Node,
                                     type_params, arg_nodes, nargs);
            new_payload = np as *u8;
        }
        let nv_off = ptr_add_u8(new_variants_buf,
                                j * ENUM_VARIANT_DECL_SIZE());
        *((nv_off as i64 + (0 as i64)) as **u8) = vd_name;
        *((nv_off as i64 + (8 as i64)) as **u8) = new_payload;
        j = j + (1 as i64);
    }
    let buf = arena_alloc(arena, NODE_SIZE() + NODE_ENUM_DEF_SIZE());
    let n = ast_init_node(buf, NODE_ENUM_DEF(),
                          (*body).loc_filename, (*body).loc_line, (*body).loc_col);
    let ned = (buf as i64 + NODE_SIZE()) as *u8;
    *((ned as i64 + (0 as i64)) as **u8) = new_variants_buf;
    *((ned as i64 + (8 as i64)) as *i64) = nvariants;
    return n;
}

// mono_clone_and_subst — 深克隆 generic def,把 type_params[i] 替换成
//   arg_nodes[i]。返回一个 NON-generic NODE_TYPE_DECL (ntype_params=0)。
fn mono_clone_and_subst(arena: *Arena, td: *Node,
                        arg_nodes: *u8, nargs: i64) -> *Node {
    let td_data = node_type_decl_data(td);
    // NodeTypeDecl layout: sym @0 (8), body @8 (8), type_params @16 (8), ntype_params @24 (8)
    let td_sym_off = td_data as **u8;
    let td_body_off = ptr_add_u8(td_data as *u8, (8 as i64)) as **u8;
    let td_type_params_off = ptr_add_u8(td_data as *u8, (16 as i64)) as **u8;
    let td_ntype_params_off = ptr_add_u8(td_data as *u8, (24 as i64)) as *i64;
    let type_params = *td_type_params_off;
    let ntype_params = *td_ntype_params_off;

    if nargs != ntype_params {
        let _x = jh_fputs_stderr(
            "[mono] arg count mismatch in clone_and_subst\n" as *u8);
        return 0 as *Node;
    }

    let body = *td_body_off as *Node;
    let mut new_body: *Node = 0 as *Node;
    if (*body).kind == NODE_STRUCT_DEF() {
        new_body = mono_clone_struct_def(arena, body,
                                         type_params, arg_nodes, nargs);
    } else {
        if (*body).kind == NODE_ENUM_DEF() {
            new_body = mono_clone_enum_def(arena, body,
                                           type_params, arg_nodes, nargs);
        } else {
            new_body = body;
        }
    }
    if new_body == (0 as *Node) {
        return 0 as *Node;
    }

    let buf = arena_alloc(arena, NODE_SIZE() + NODE_TYPE_DECL_SIZE());
    let new_n = ast_init_node(buf, NODE_TYPE_DECL(),
                              (*td).loc_filename, (*td).loc_line, (*td).loc_col);
    let new_td = (buf as i64 + NODE_SIZE()) as *NodeTypeDecl;
    // copy sym ptr (caller overwrites with mangled sym).
    // NOTE: avoid `*((*new_td) as **u8) = ...` deref-write-via-cast — triggers
    //   stage-0 jhyy codegen stack-spill bug in deep nested context (verified
    //   segfault 2026-09-08 v3.2.0b diagnosis). Use temp-var pattern instead.
    let new_td_sym_off = new_td as **u8;
    *new_td_sym_off = *td_sym_off as *u8;
    let new_td_body_off = ptr_add_u8(new_td as *u8, (8 as i64)) as **u8;
    *new_td_body_off = new_body as *u8;
    let new_td_tp_off = ptr_add_u8(new_td as *u8, (16 as i64)) as **u8;
    *new_td_tp_off = 0 as *u8;
    let new_td_ntp_off = ptr_add_u8(new_td as *u8, (24 as i64)) as *i64;
    *new_td_ntp_off = 0 as i64;
    return new_n;
}

// ════════════════════════════════════════════════════
// Public API — Pass 1.5 hook
// (放在最后因为它调用上面所有 helpers;jhyy 不支持 forward refs)
// ════════════════════════════════════════════════════

// mono_expand_module — Pass 1.5 hook。遍历 (*md).generic_insts,对每条 inst:
//   1. dedupe by mangled_name → skip if already inserted in global_scope
//   2. 用 base_name 在 (*md).decls 里找到 generic def (ntype_params > 0)
//   3. 克隆 struct/enum body,把 type-param sym 替换成 arg nodes
//   4. 注册 fresh SYM_TYPE for mangled_name,克隆 decl,append 到 (*md).decls
//
// 返回 i32 = 0 成功,非 0 错误数。
// global: 直接传 sema 的 global_scope (*SymTable pointer as *u8)
// md is already a *NodeModule (caller does `let md = node_module_data(module)`).
// Don't call node_module_data again — that would add NODE_SIZE on top of an
// already-offset pointer and read random memory.
//
// v3.2.0b SHIP STATUS: ACTIVE。helpers above (`mono_find_generic_def` L102-104
//   root-cause-fixed in this sprint; `mono_subst_node` already offset; helpers
//   `mono_decls_append` / `mono_clone_*` already offset) — body is full impl
//   using offset access throughout. No `(*mdd).*` / `(*sym).*` / `(*sd).*` /
//   `(*fld).*` / `(*vd).*` patterns (those trigger stage-0 jhyy codegen
//   stack-spill bug, DEFERRED to v2.x 末 QBE 自写).
fn mono_expand_module(global: *u8, arena: *Arena, md: *Node) -> i32 {
    // md is *NodeModule — caller pre-computes via node_module_data(module)
    let mdd = md as *u8;
    // NodeModule: decls @0, ndeccls @8, generic_insts @20, ngeneric_insts @28
    let ndeccls_off = ptr_add_u8(mdd, (8 as i64)) as *i64;
    let ndeccls = *ndeccls_off;
    let decls_off = mdd as **u8;
    let decls_ptr = *decls_off;
    // generic_insts @ offset 20, ngeneric_insts @ offset 28
    let ngi_off = ptr_add_u8(mdd, (28 as i64)) as *i64;
    let ngi = *ngi_off;
    if ngi == (0 as i64) {
        return 0 as i32;
    }
    let gi_off = (mdd as i64 + (20 as i64)) as **u8;
    let gi = *gi_off;
    let mut errs: i32 = 0 as i32;
    let mut i: i64 = 0 as i64;
    while i < ngi {
        // GenericInstRecord: mangled_name@0, arg_types@8, nargs@16, base_name@24
        let rec = ptr_add_u8(gi, i * GENERIC_INST_RECORD_SIZE());
        let rec_mangled = *((rec as i64 + (0 as i64)) as **u8);
        let rec_args = *((rec as i64 + (8 as i64)) as **u8);
        let rec_nargs = *(ptr_add_u8(rec, (16 as i64)) as *i64);
        let rec_base = *((rec as i64 + (24 as i64)) as **u8);

        // v3.2.0b dedupe strategy: parser records generic_inst once per
        //   `<...>` usage site (e.g. `Pair<i32>` as type annot + as struct
        //   lit = 2 entries). We dedupe by walking (*md).decls and looking
        //   for an existing NODE_TYPE_DECL with sym == ms (parser_sym).
        //   This is reliable since Pass 2 hasn't run yet at this point —
        //   type_ptr check would be unreliable.
        let mut ms = symtab_lookup(global, rec_mangled);
        if ms == (0 as *Sym) {
            ms = symtab_insert(global, rec_mangled, SYM_TYPE(),
                               0 as *u8, 0 as i32, 0 as i32);
        }
        let mut already_done: i32 = 0 as i32;
        let cur_ndeccls = *ndeccls_off;
        let mut j2: i64 = 0 as i64;
        while j2 < cur_ndeccls {
            let ed = *((decls_ptr as i64 + j2 * (8 as i64)) as **Node);
            if ed != (0 as *Node) {
                if (*ed).kind == NODE_TYPE_DECL() {
                    let etd = node_type_decl_data(ed);
                    let etd_sym_off = etd as **u8;
                    let es = *etd_sym_off as *Sym;
                    if es == ms {
                        already_done = 1 as i32;
                        break;
                    }
                }
            }
            j2 = j2 + (1 as i64);
        }
        if already_done != (0 as i32) {
            i = i + (1 as i64);
        } else {
            // find generic def by base_name
            let gd = mono_find_generic_def(md, rec_base);
            if gd == (0 as *Node) {
                errs = errs + (1 as i32);
                i = i + (1 as i64);
            } else {
                // clone + substitute
                let cloned = mono_clone_and_subst(arena, gd, rec_args, rec_nargs);
                if cloned == (0 as *Node) {
                    errs = errs + (1 as i32);
                    i = i + (1 as i64);
                } else {
                    // overwrite cloned decl's sym with parser_sym (ms) —
                    // IDENT nodes in body / annotations already point to ms,
                    // so this keeps IDENT ↔ decl linkage coherent.
                    let cloned_td = node_type_decl_data(cloned);
                    let cloned_td_sym_off = cloned_td as **u8;
                    *cloned_td_sym_off = ms as *u8;
                    // append cloned decl to (*mdd).decls
                    mono_decls_append(arena, mdd, cloned);
                    i = i + (1 as i64);
                }
            }
        }
    }
    return errs;
}