{
    "name": "jhyy-lang",
    "displayName": "JHYY Language Support",
    "description": "JHYY (机会翼游) language syntax highlighting",
    "version": "0.1.0",
    "publisher": "jhyy",
    "repository": {
        "type": "git",
        "url": "https://github.com/JiHuiYiYou/JiHuiYiYou-compiler.git"
    },
    "license": "MIT",
    "engines": { "vscode": "^1.80.0" },
    "icon": "./icon.png",
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:jhyy",
        "onCommand:jhyy.runFile",
        "onCommand:jhyy.compileOnly"
    ],
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.4.5"
    },
    "categories": ["Programming Languages"],
    "contributes": {
        "commands": [
            { "command": "jhyy.runFile",     "title": "Run JHYY File",              "icon": "$(play)" },
            { "command": "jhyy.compileOnly", "title": "Compile JHYY File (no run)", "icon": "$(tools)" }
        ],
        "menus": {
            "editor/title/run": [
                { "command": "jhyy.runFile", "when": "resourceExtname == .jhyy", "group": "navigation" }
            ],
            "editor/title": [
                { "command": "jhyy.compileOnly", "when": "resourceExtname == .jhyy", "group": "navigation" }
            ]
        },
        "keybindings": [
            { "command": "jhyy.runFile", "key": "ctrl+f5", "when": "editorLangId == jhyy" }
        ],
        "configuration": {
            "title": "JHYY",
            "properties": {
                "jhyy.run.executor":      { "type": "string",  "default": "jhyy run", "description": "Command template. Use {file} for absolute path." },
                "jhyy.run.executorPath":  { "type": "string",  "default": "",        "description": "Absolute path to jhyy.exe. Empty = use PATH (recommended)." },
                "jhyy.run.terminalName":  { "type": "string",  "default": "JHYY",    "description": "Reusable terminal name." },
                "jhyy.run.saveBeforeRun": { "type": "boolean", "default": true,      "description": "Save dirty document before run." }
            }
        },
        "languages": [{
            "id": "jhyy",
            "aliases": ["JHYY", "jhyy"],
            "extensions": [".jhyy"],
            "configuration": "./language-configuration.json",
            "icon": {
                "light": "./icon.svg",
                "dark": "./icon.svg"
            }
        }],
        "grammars": [{
            "language": "jhyy",
            "scopeName": "source.jhyy",
            "path": "./syntaxes/jhyy.tmLanguage.json"
        }]
    }
}
