{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "JHYY: Build Compiler",
            "type": "shell",
            "command": "C:/msys64/usr/bin/bash.exe",
            "args": [
                "-lc",
                "make -C \"${workspaceFolder}\" all"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Self-host build: make → compiler/build/bin/jhyy.exe. The C compiler is gone (compiler/src/*.c was deleted in v4.0.21) — the compiler builds itself now."
        },
        {
            "label": "JHYY: Run",
            "type": "shell",
            "command": "compiler/build/bin/jhyy.exe",
            "args": [
                "run",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Compile and run the current .jhyy file (default Ctrl+Shift+B)"
        },
        {
            "label": "JHYY: Compile",
            "type": "shell",
            "command": "compiler/build/bin/jhyy.exe",
            "args": [
                "compile",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "detail": "Compile .jhyy to .exe (same directory)"
        },
        {
            "label": "JHYY: Build IR",
            "type": "shell",
            "command": "compiler/build/bin/jhyy.exe",
            "args": [
                "build",
                "${file}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "detail": "Compile .jhyy to .s only (no linking). NOTE: `jhyy build` does not apply #[link_section] — use `jhyy compile --no-link` for tooling (W-170)"
        }
    ]
}