CLAUDE.md
skills-lock.json
!mcp-jhyy/CLAUDE.md
# codegraph 索引（daemon.pid mtime 抖动会污染 git status）
.codegraph/

# src0/ v1.0.0 自举翻译稿目录：只跟踪 .jhyy 源文件，.il/.exe/.s 构建产物全部忽略
compiler/src0/*.il
compiler/src0/*.s
compiler/src0/*.exe

# Phantom binary 备份 — 防止 Sprint 4.4 cleanup crash bisect 期间
# 误覆盖唯一能跑 codegen 的 jhyy_v1.exe (sha e2064a6b per Sprint 4.4 D finding)
*.phantom.bak
*_phantom.bak
*_baseline.exe

# tmp/ — 工作目录临时调试 artifact（do_w*.py / tm_*.jhyy / test_*.jhyy / r1.* 等 200+ 文件）
# 用 `tmp/` 目录而不是 repo 根散落文件，避免 git status 噪音
tmp/

# 关键编译器二进制例外 — 上方 *.exe 通配会清掉这些，git clean -fdX 前必须保留
# v1.0.0 self-host 闭环依赖此 5 个 binary (v1.3.7 commit 0f32977 删 jhyy_v1.exe,canonical 统一到 .exe.exe)
# v1.4.4 新增 jhyy_stage0.exe: C 端 stage-0 bootstrap binary (per v1.4.0 umbrella plan § Sprint v1.4.4)
!compiler/build/bin/jhyy.exe
!compiler/build/bin/jhyy_stage0.exe
!compiler/build/bin/jhyy_v1.exe.exe
!compiler/build/bin/jhyy_v2.exe
!compiler/build/bin/jhyy_v3.exe
!compiler/build/bin/jhyy_v4.exe

# pytest 测试发现需要 __init__.py — _*.py 通配会清掉
!mcp-jhyy/tests/__init__.py

